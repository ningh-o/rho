// exit: 6
// adapted: golden regenerated (the archive kept no .out; the exit header is the arbiter); associated-fn calls Type.name(args)
struct Rect {
  w: i32,
  h: i32,
}

fn Rect.area(self: *Rect) -> i32 {
  return self.w * self.h;
}

fn Rect.grow(mut self: *Rect, by: i32) {
  self.w += by;
  self.h += by;
}

fn Rect.square(n: i32) -> *Rect {
  return new Rect { w: n, h: n };
}

fn main() -> i32 {
  let mut r = Rect.square(3);
  r.grow(1);
  let a: i32 = r.area();
  return a - 10;
}
