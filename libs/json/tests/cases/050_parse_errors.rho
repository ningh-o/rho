// parse: the error catalog. Every malformed input below must be rejected,
// and the golden pins the exact message with its "line:col (offset N)"
// position — so a regression in position tracking or wording shows up.
use json/json;

fn err_of(src: string) -> string {
  let out = json.new_out();
  let r = json.parse(src, out);
  if r.is_ok() {
    return cat("ACCEPTED (bug): ", json.err_text(json.encode(out.root)));
  }
  return json.err_msg(r);
}

fn main() -> i32 {
  // empty and whitespace-only documents
  printf("{}\n", err_of(""));
  printf("{}\n", err_of(" \t\r\n"));
  // broken literals
  printf("{}\n", err_of("nul"));
  printf("{}\n", err_of("tru"));
  printf("{}\n", err_of("fals"));
  printf("{}\n", err_of("nulx"));
  printf("{}\n", err_of("None"));
  // number grammar
  printf("{}\n", err_of("01"));
  printf("{}\n", err_of("-01"));
  printf("{}\n", err_of("1."));
  printf("{}\n", err_of("1.e5"));
  printf("{}\n", err_of(".5"));
  printf("{}\n", err_of("+1"));
  printf("{}\n", err_of("-"));
  printf("{}\n", err_of("1e"));
  printf("{}\n", err_of("1e+"));
  printf("{}\n", err_of("1e-"));
  printf("{}\n", err_of("1ex"));
  printf("{}\n", err_of("--1"));
  printf("{}\n", err_of("1..2"));
  printf("{}\n", err_of("0x10"));
  printf("{}\n", err_of("Infinity"));
  printf("{}\n", err_of("NaN"));
  // strings
  printf("{}\n", err_of("\"unterminated"));
  printf("{}\n", err_of("abc"));
  printf("{}\n", err_of("\"bad\\q\""));
  printf("{}\n", err_of("\"dangling\\"));
  printf("{}\n", err_of("\"short\\u00\""));
  printf("{}\n", err_of("\"hex\\uZZZZ\""));
  printf("{}\n", err_of("\"high\\ud800\""));
  printf("{}\n", err_of("\"low\\udc00\""));
  printf("{}\n", err_of("\"pair\\ud800\\u0041\""));
  printf("{}\n", err_of("\"raw\x01control\""));
  printf("{}\n", err_of("\"newline-in-string\n\""));
  // invalid UTF-8 inside strings (raw bytes, escaped here)
  printf("{}\n", err_of(cat(cat("\"", "\xa0"), "\"")));          // stray continuation
  printf("{}\n", err_of(cat(cat("\"", "\xc3"), "\"")));          // truncated 2-byte
  printf("{}\n", err_of(cat(cat("\"", "\xc0\xaf"), "\"")));      // overlong 2-byte
  printf("{}\n", err_of(cat(cat("\"", "\xe0\x80\xaf"), "\"")));  // overlong 3-byte
  printf("{}\n", err_of(cat(cat("\"", "\xed\xa0\x80"), "\"")));  // UTF-16 surrogate
  printf("{}\n", err_of(cat(cat("\"", "\xf4\x90\x80\x80"), "\""))); // past U+10FFFF
  printf("{}\n", err_of(cat(cat("\"", "\xf0\x9f"), "\"")));      // truncated 4-byte
  printf("{}\n", err_of(cat(cat("\"", "\xff"), "\"")));          // never valid
  // containers
  printf("{}\n", err_of("["));
  printf("{}\n", err_of("[1,2"));
  printf("{}\n", err_of("[1,2,"));
  printf("{}\n", err_of("[,1]"));
  printf("{}\n", err_of("[1 2]"));
  printf("{}\n", err_of("]"));
  printf("{}\n", err_of("{"));
  printf("{}\n", err_of("}"));
  printf("{}\n", err_of("{:1}"));
  printf("{}\n", err_of("{1:2}"));
  printf("{}\n", err_of("{\"a\" 1}"));
  printf("{}\n", err_of("{\"a\":}"));
  printf("{}\n", err_of("{\"a\":1,}"));
  printf("{}\n", err_of("{\"a\"}"));
  // trailing garbage after a complete document
  printf("{}\n", err_of("1 2"));
  printf("{}\n", err_of("{} {}"));
  printf("{}\n", err_of("null null"));
  printf("{}\n", err_of("[1]x"));
  printf("{}\n", err_of("\"a\"."));
  // position tracking across lines: the error is on line 3
  printf("{}\n", err_of(cat(cat(cat(cat(cat("[1,", "\n"), " 2,"), "\n"), " x]"), "")));
  printf("{}\n", err_of(cat(cat(cat(cat(cat("{\"a\":", "\n"), "\"b\":"), "\n"), "\"bad\\q\"}"), "")));
  return 0;
}
