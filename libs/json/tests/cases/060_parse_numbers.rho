// parse: numbers against a precomputed oracle. Each row pins a JSON
// number literal to the exact f64 bit pattern a correctly rounded (ties
// to even) conversion must produce — computed once with an IEEE strtod
// (python3 float()) and frozen here, so the test does not depend on the
// platform, the clock, or this library's own idea of correctness.
// Coverage: zeros and signs, 2^53 rounding edges, 17-digit literals,
// scientific forms, the max-double boundary, subnormals down to the
// deep-underflow window, overflow to the infinities, and huge exponents.
use json/json;

struct Row {
  text: string,
  bits: u64,
}

fn main() -> i32 {
  let rows: []Row = make([]Row, 64);
  let mut n: usize = 0;

  // zeros and their signs — "-0" is a distinct f64
  rows[n].text = "0"; rows[n].bits = 0; n += 1;
  rows[n].text = "-0"; rows[n].bits = 9223372036854775808; n += 1;
  rows[n].text = "0.0"; rows[n].bits = 0; n += 1;
  rows[n].text = "-0.0"; rows[n].bits = 9223372036854775808; n += 1;
  rows[n].text = "-0e5"; rows[n].bits = 9223372036854775808; n += 1;
  rows[n].text = "0e-0"; rows[n].bits = 0; n += 1;
  // integers small and large
  rows[n].text = "1"; rows[n].bits = 4607182418800017408; n += 1;
  rows[n].text = "-1"; rows[n].bits = 13830554455654793216; n += 1;
  rows[n].text = "123456789"; rows[n].bits = 4728057454347157504; n += 1;
  rows[n].text = "18446744073709551616"; rows[n].bits = 4895412794951729152; n += 1;
  rows[n].text = "123456789012345678901234567890"; rows[n].bits = 5042042089369253694; n += 1;
  // the 2^53 edge: 2^53+1 rounds down (half to even), 2^53+2 is exact
  rows[n].text = "9007199254740992"; rows[n].bits = 4845873199050653696; n += 1;
  rows[n].text = "9007199254740993"; rows[n].bits = 4845873199050653696; n += 1;
  rows[n].text = "9007199254740994"; rows[n].bits = 4845873199050653697; n += 1;
  // decimal fractions and the classic 17-digit literals
  rows[n].text = "0.1"; rows[n].bits = 4591870180066957722; n += 1;
  rows[n].text = "0.2"; rows[n].bits = 4596373779694328218; n += 1;
  rows[n].text = "0.3"; rows[n].bits = 4599075939470750515; n += 1;
  rows[n].text = "0.30"; rows[n].bits = 4599075939470750515; n += 1;
  rows[n].text = "1.5"; rows[n].bits = 4609434218613702656; n += 1;
  rows[n].text = "2.5"; rows[n].bits = 4612811918334230528; n += 1;
  rows[n].text = "3.5"; rows[n].bits = 4615063718147915776; n += 1;
  rows[n].text = "1.0000000000000002"; rows[n].bits = 4607182418800017409; n += 1;
  rows[n].text = "1.0000000000000003"; rows[n].bits = 4607182418800017409; n += 1;
  rows[n].text = "0.5000000000000001665334536937734810635447502136230468750"; rows[n].bits = 4602678819172646914; n += 1;
  // scientific forms, E and e, explicit plus sign
  rows[n].text = "1e1"; rows[n].bits = 4621819117588971520; n += 1;
  rows[n].text = "1E2"; rows[n].bits = 4636737291354636288; n += 1;
  rows[n].text = "1e+2"; rows[n].bits = 4636737291354636288; n += 1;
  rows[n].text = "1e-6"; rows[n].bits = 4517329193108106637; n += 1;
  rows[n].text = "0.000001"; rows[n].bits = 4517329193108106637; n += 1;
  rows[n].text = "1e16"; rows[n].bits = 4846369599423283200; n += 1;
  rows[n].text = "1e17"; rows[n].bits = 4861130398305394688; n += 1;
  rows[n].text = "100000000000000000000"; rows[n].bits = 4906019910204099648; n += 1;
  // the famous rounding edge: 1e23 is NOT representable; the 17-digit
  // spelling of its neighbor rounds back up to it
  rows[n].text = "1e23"; rows[n].bits = 4950912855330343670; n += 1;
  rows[n].text = "9.999999999999999e22"; rows[n].bits = 4950912855330343670; n += 1;
  // the max-double boundary: the 17-digit max, one ulp up (still max),
  // then overflow to +inf
  rows[n].text = "1.7976931348623157e308"; rows[n].bits = 9218868437227405311; n += 1;
  rows[n].text = "1.7976931348623158e308"; rows[n].bits = 9218868437227405311; n += 1;
  rows[n].text = "1e308"; rows[n].bits = 9214871658872686752; n += 1;
  rows[n].text = "1e309"; rows[n].bits = 9218868437227405312; n += 1;
  rows[n].text = "1e400"; rows[n].bits = 9218868437227405312; n += 1;
  rows[n].text = "-1e400"; rows[n].bits = 18442240474082181120; n += 1;
  // the min-normal boundary (the case that famously hung a PHP release):
  // 2.2250738585072011e-308 rounds down to the max subnormal, and the
  // exact min normal two digits later
  rows[n].text = "2.2250738585072011e-308"; rows[n].bits = 4503599627370495; n += 1;
  rows[n].text = "2.2250738585072014e-308"; rows[n].bits = 4503599627370496; n += 1;
  // subnormals: the min subnormal and its neighbors, including the exact
  // half tie that rounds to even (to zero)
  rows[n].text = "4.9406564584124654e-324"; rows[n].bits = 1; n += 1;
  rows[n].text = "5e-324"; rows[n].bits = 1; n += 1;
  rows[n].text = "2.5e-324"; rows[n].bits = 1; n += 1;
  rows[n].text = "-2.5e-324"; rows[n].bits = 9223372036854775809; n += 1;
  rows[n].text = "2.4703282292062327e-324"; rows[n].bits = 0; n += 1;
  rows[n].text = "2.4703282292062326e-324"; rows[n].bits = 0; n += 1;
  // the deep-underflow window (below 2^-1074): everything flushes to
  // signed zero
  rows[n].text = "3e-324"; rows[n].bits = 1; n += 1;
  rows[n].text = "7e-324"; rows[n].bits = 1; n += 1;
  rows[n].text = "3e-325"; rows[n].bits = 0; n += 1;
  rows[n].text = "1e-330"; rows[n].bits = 0; n += 1;
  rows[n].text = "1e-331"; rows[n].bits = 0; n += 1;
  rows[n].text = "-1e-330"; rows[n].bits = 9223372036854775808; n += 1;
  rows[n].text = "-3e-325"; rows[n].bits = 9223372036854775808; n += 1;
  rows[n].text = "1e-400"; rows[n].bits = 0; n += 1;
  // absurd exponent magnitudes: the accumulate clamps and the value
  // still decides inf/zero correctly
  rows[n].text = "1e99999999999999999999"; rows[n].bits = 9218868437227405312; n += 1;
  rows[n].text = "1e-99999999999999999999"; rows[n].bits = 0; n += 1;
  // a long digit run well under the 800-significant-digit cap keeps its
  // exact value
  rows[n].text = "1234567890123456789012345678901234567890123456789012345678901234567890e-60"; rows[n].bits = 4742964961033578167; n += 1;
  rows[n].text = "-12.5e-2"; rows[n].bits = 13817043656772681728; n += 1;
  // exact ties must survive intact: the 50-digit normal-range tie between
  // 1.0 and its neighbor rounds to even (down), and this is the row that
  // pins it — a short digit cap truncates below the tie and rounds wrong
  rows[n].text = "1.00000000000000011102230246251565404236316680908203125"; rows[n].bits = 4607182418800017408; n += 1;
  // fully spelled subnormals: leading fraction zeros carry position only,
  // never the digit budget, so these keep their value
  rows[n].text = "0."; rows[n].bits = 1; n += 1;
  // exact ties deep in the subnormal window (where the quotient's integer
  // part is zero), decided by the half-comparison path, ties to even
  rows[n].text = "0."; rows[n].bits = 0; n += 1;
  rows[n].text = "0."; rows[n].bits = 2; n += 1;

  let out = json.new_out();
  let mut fails: i32 = 0;
  let mut i: usize = 0;
  while i < n {
    let r = json.parse(rows[i].text, out);
    if r.is_err() {
      printf("FAIL {} : {}\n", rows[i].text, json.err_msg(r));
      fails += 1;
    } else {
      let got: u64 = intrinsics.f64_bits(json.as_num(out.root));
      if got == rows[i].bits {
        printf("ok   {} -> {}\n", rows[i].text, got);
      } else {
        printf("FAIL {} -> {} want {}\n", rows[i].text, got, rows[i].bits);
        fails += 1;
      }
    }
    i += 1;
  }
  printf("{} rows, {} failures\n", n, fails);
  if fails > 0 {
    return 1;
  }
  return 0;
}
