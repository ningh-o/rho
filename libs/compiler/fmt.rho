// fmt.rho — the self-hosted compiler's canonical formatter (T2.2
// growth). Byte-identical to boot's fmt on the subset grammar: every
// binary node parenthesized, unary ops as op(operand), conditions
// spelled by the same expression rule (binaries carry their own
// parens, atoms ride bare), compound assignments keep their operator,
// consts/statics each close with a blank line, fns stack back to
// back, verbatim strings re-emit as escaped single-line text with
// printable bytes raw.
use lex;
use parse;

// the byte-at-position table: BYTES[b..b+1] is the one-char string
// holding exactly byte b (escapes decode at emission, so the literal
// spells all 256 positions)
const BYTES: string =
  "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f" +
  "\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f" +
  "\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f" +
  "\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f" +
  "\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f" +
  "\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f" +
  "\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f" +
  "\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f" +
  "\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f" +
  "\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f" +
  "\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf" +
  "\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf" +
  "\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf" +
  "\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf" +
  "\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef" +
  "\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff";

fn byte_char(b: u8) -> string {
  let i: usize = b as usize;
  return BYTES[i..(i + 1)];
}

fn lower_hex(v: u8) -> string {
  let h: string = "0123456789abcdef";
  let hi: usize = ((v >> 4) as usize) & 15;
  let lo: usize = (v as usize) & 15;
  return h[hi..(hi + 1)] + h[lo..(lo + 1)];
}

// the canonical spelling of one decoded byte inside a string literal
fn canon_byte(b: u8) -> string {
  if b == 34 {
    return "\\\"";
  }
  if b == 92 {
    return "\\\\";
  }
  if b == 10 {
    return "\\n";
  }
  if b == 13 {
    return "\\r";
  }
  if b == 9 {
    return "\\t";
  }
  if b == 0 {
    return "\\x00";
  }
  if b < 32 {
    return "\\x" + lower_hex(b);
  }
  return byte_char(b);
}

fn hex_v(b: u8) -> i64 {
  if b >= 48 && b <= 57 {
    return (b as i64) - 48;
  }
  if b >= 97 && b <= 102 {
    return (b as i64) - 87;
  }
  if b >= 65 && b <= 70 {
    return (b as i64) - 55;
  }
  return 0;
}

// decode a raw span into its bytes, then spell each canonically
fn canon_string(raw: string) -> string {
  let mut out: string = "\"";
  let mut i: usize = 0;
  while i < len(raw) {
    let mut b: u8 = raw[i];
    if b == 92 && i + 1 < len(raw) {
      let e: u8 = raw[i + 1];
      if e == 110 {
        out = out + canon_byte(10);
        i = i + 2;
        continue;
      }
      if e == 114 {
        out = out + canon_byte(13);
        i = i + 2;
        continue;
      }
      if e == 116 {
        out = out + canon_byte(9);
        i = i + 2;
        continue;
      }
      if e == 48 {
        out = out + canon_byte(0);
        i = i + 2;
        continue;
      }
      if e == 92 {
        out = out + canon_byte(92);
        i = i + 2;
        continue;
      }
      if e == 34 {
        out = out + canon_byte(34);
        i = i + 2;
        continue;
      }
      if e == 120 && i + 3 < len(raw) {
        let v: i64 = hex_v(raw[i + 2]) * 16 + hex_v(raw[i + 3]);
        out = out + canon_byte((v as u8));
        i = i + 4;
        continue;
      }
      if e == 117 {
        let mut j: usize = i + 3;
        let mut cp: i64 = 0;
        while j < len(raw) && raw[j] != 125 {
          let h: i64 = hex_v(raw[j]);
          cp = cp * 16 + h;
          j = j + 1;
        }
        // the code point's utf-8 bytes, each canonically spelled
        if cp < 128 {
          out = out + canon_byte((cp as u8));
        } else {
          if cp < 2048 {
            out = out + canon_byte((((cp >> 6) as u8)) | 192);
            out = out + canon_byte((((cp & 63) as u8)) | 128);
          } else {
            if cp < 65536 {
              out = out + canon_byte((((cp >> 12) as u8)) | 224);
              out = out + canon_byte(((((cp >> 6) & 63) as u8)) | 128);
              out = out + canon_byte((((cp & 63) as u8)) | 128);
            } else {
              out = out + canon_byte((((cp >> 18) as u8)) | 240);
              out = out + canon_byte(((((cp >> 12) & 63) as u8)) | 128);
              out = out + canon_byte(((((cp >> 6) & 63) as u8)) | 128);
              out = out + canon_byte((((cp & 63) as u8)) | 128);
            }
          }
        }
        i = j + 1;
        continue;
      }
      // an unknown escape rides as its letter (the checker's turf)
      out = out + canon_byte(e);
      i = i + 2;
      continue;
    }
    out = out + canon_byte(b);
    i = i + 1;
  }
  return out + "\"";
}

fn op_spell(op: i64) -> string {
  if op == 0 { return "+"; }
  if op == 1 { return "-"; }
  if op == 2 { return "*"; }
  if op == 3 { return "/"; }
  if op == 4 { return "%"; }
  if op == 5 { return "<"; }
  if op == 6 { return ">"; }
  if op == 7 { return "<="; }
  if op == 8 { return ">="; }
  if op == 9 { return "=="; }
  if op == 10 { return "!="; }
  if op == 13 { return "&&"; }
  if op == 14 { return "||"; }
  if op == 15 { return "&"; }
  if op == 16 { return "|"; }
  if op == 17 { return "^"; }
  if op == 18 { return "<<"; }
  return ">>";
}

// a literal is a bare positive, a negative folds as -(abs)
fn fmt_lit(v: i64) -> string {
  if v >= 0 {
    return v.to_str();
  }
  return "-(" + (0 - v).to_str() + ")";
}

pub fn fmt_expr(e: *Expr) -> string {
  if e.tag == parse.EX_LIT {
    if len(e.name) > 0 {
      return e.name; // the true/false spelling the parser kept
    }
    return fmt_lit(e.lit);
  }
  if e.tag == parse.EX_VAR {
    return e.name;
  }
  if e.tag == parse.EX_STR {
    return canon_string(e.name);
  }
  if e.tag == parse.EX_CALL {
    let mut out: string = e.name + "(";
    let mut k: usize = 0;
    while k < len(e.args) {
      if k > 0 {
        out = out + ", ";
      }
      out = out + fmt_expr(e.args[k]);
      k = k + 1;
    }
    return out + ")";
  }
  if e.tag == parse.EX_MAKE {
    let mut cnt: *Expr = parse.lit(0);
    if len(e.args) > 0 {
      cnt = e.args[0];
    }
    return "make([]" + e.name + ", " + fmt_expr(cnt) + ")";
  }
  if e.tag == parse.EX_IDX {
    let mut out: string = "";
    match e.lhs {
      Option.Some(b) => {
        out = out + fmt_expr(b);
      },
      Option.None => {},
    }
    out = out + "[";
    match e.rhs {
      Option.Some(i) => {
        out = out + fmt_expr(i);
      },
      Option.None => {},
    }
    return out + "]";
  }
  if e.tag == parse.EX_SLICE2 {
    let mut out: string = "";
    match e.lhs {
      Option.Some(b) => {
        out = out + fmt_expr(b);
      },
      Option.None => {},
    }
    out = out + "[";
    if e.op % 2 == 1 && len(e.args) > 0 {
      out = out + fmt_expr(e.args[0]);
    }
    out = out + "..";
    if (e.op / 2) % 2 == 1 && len(e.args) > 1 {
      out = out + fmt_expr(e.args[1]);
    }
    return out + "]";
  }
  // EX_BIN
  if e.op == 11 {
    let mut out: string = "(";
    match e.lhs {
      Option.Some(l) => {
        out = out + fmt_expr(l);
      },
      Option.None => {},
    }
    return out + " as " + e.name + ")";
  }
  if e.op == 12 {
    let mut out: string = "!(";
    match e.rhs {
      Option.Some(r) => {
        out = out + fmt_expr(r);
      },
      Option.None => {},
    }
    return out + ")";
  }
  // 0 - x spells -(x); -1 ^ x spells ~(x)
  let mut lhs_zero: bool = false;
  match e.lhs {
    Option.Some(l) => {
      if l.tag == parse.EX_LIT && l.lit == 0 && e.op == 1 {
        lhs_zero = true;
      }
    },
    Option.None => {},
  }
  if lhs_zero {
    let mut out: string = "-(";
    match e.rhs {
      Option.Some(r) => {
        out = out + fmt_expr(r);
      },
      Option.None => {},
    }
    return out + ")";
  }
  let mut lhs_neg1: bool = false;
  match e.lhs {
    Option.Some(l) => {
      if l.tag == parse.EX_LIT && l.lit == 0 - 1 && e.op == 17 {
        lhs_neg1 = true;
      }
    },
    Option.None => {},
  }
  if lhs_neg1 {
    let mut out: string = "~(";
    match e.rhs {
      Option.Some(r) => {
        out = out + fmt_expr(r);
      },
      Option.None => {},
    }
    return out + ")";
  }
  let mut out: string = "(";
  match e.lhs {
    Option.Some(l) => {
      out = out + fmt_expr(l);
    },
    Option.None => {},
  }
  out = out + " " + op_spell(e.op) + " ";
  match e.rhs {
    Option.Some(r) => {
      out = out + fmt_expr(r);
    },
    Option.None => {},
  }
  return out + ")";
}

fn ind_of(depth: usize) -> string {
  let mut out: string = "";
  let mut k: usize = 0;
  while k < depth {
    out = out + "  ";
    k = k + 1;
  }
  return out;
}

pub fn fmt_line(st: *Stmt, depth: usize) -> string {
  let ind: string = ind_of(depth);
  if st.tag == parse.ST_LET {
    let mut out: string = ind + "let ";
    if st.ret == 1 {
      out = out + "mut ";
    }
    out = out + st.name;
    if len(st.fmt) > 0 {
      out = out + ": " + st.fmt;
    }
    out = out + " = ";
    match st.val {
      Option.Some(e) => {
        out = out + fmt_expr(e);
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_PF {
    let mut out: string = ind + "printf(" + canon_string(st.fmt);
    let mut k: usize = 0;
    while k < len(st.args) {
      out = out + ", " + fmt_expr(st.args[k]);
      k = k + 1;
    }
    return out + ");\n";
  }
  if st.tag == parse.ST_RET {
    let mut out: string = ind + "return";
    match st.val {
      Option.Some(e) => {
        out = out + " " + fmt_expr(e);
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_SET {
    if len(st.fmt) > 1 {
      // a compound: name OP= rhs (the desugar's inner rhs is the text)
      let mut rhs: *Expr = parse.lit(0);
      match st.val {
        Option.Some(b) => {
          match b.rhs {
            Option.Some(r) => {
              rhs = r;
            },
            Option.None => {},
          }
        },
        Option.None => {},
      }
      return ind + st.name + " " + st.fmt + " " + fmt_expr(rhs) + ";\n";
    }
    let mut out: string = ind + st.name + " = ";
    match st.val {
      Option.Some(e) => {
        out = out + fmt_expr(e);
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_ISTORE {
    let mut out: string = ind + st.name + "[";
    if len(st.args) > 0 {
      out = out + fmt_expr(st.args[0]);
    }
    out = out + "] = ";
    match st.val {
      Option.Some(e) => {
        out = out + fmt_expr(e);
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_CALL {
    let mut out: string = ind;
    match st.val {
      Option.Some(e) => {
        out = out + fmt_expr(e);
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_BLOCK {
    let mut out: string = ind + "{\n";
    out = out + fmt_block(st.body, depth + 1);
    return out + ind + "}\n";
  }
  if st.tag == parse.ST_IF {
    let mut out: string = ind + "if ";
    match st.val {
      Option.Some(c) => {
        out = out + fmt_expr(c);
      },
      Option.None => {},
    }
    out = out + " {\n";
    out = out + fmt_block(st.body, depth + 1);
    out = out + ind + "}";
    // else-if chains ride inline; a plain else takes two spaces
    let mut tail: []*Stmt = st.body2;
    let mut d: usize = depth;
    while len(tail) == 1 && tail[0].tag == parse.ST_IF {
      let nx = tail[0];
      out = out + " else if ";
      match nx.val {
        Option.Some(c) => {
          out = out + fmt_expr(c);
        },
        Option.None => {},
      }
      out = out + " {\n";
      out = out + fmt_block(nx.body, d + 1);
      out = out + ind_of(d) + "}";
      tail = nx.body2;
    }
    if len(tail) > 0 {
      out = out + " else  {\n";
      out = out + fmt_block(tail, depth + 1);
      out = out + ind + "}";
    }
    return out + "\n";
  }
  if st.tag == parse.ST_WHILE {
    let mut out: string = ind;
    if len(st.name) > 0 {
      out = out + st.name + ": ";
    }
    out = out + "while ";
    match st.val {
      Option.Some(c) => {
        out = out + fmt_expr(c);
      },
      Option.None => {},
    }
    out = out + " {\n";
    out = out + fmt_block(st.body, depth + 1);
    return out + ind + "}\n";
  }
  if st.tag == parse.ST_LOOP {
    let mut out: string = ind;
    if len(st.name) > 0 {
      out = out + st.name + ": ";
    }
    out = out + "loop {\n";
    out = out + fmt_block(st.body, depth + 1);
    return out + ind + "}\n";
  }
  if st.tag == parse.ST_BREAK {
    if len(st.name) > 0 {
      return ind + "break " + st.name + ";\n";
    }
    return ind + "break;\n";
  }
  if st.tag == parse.ST_CONT {
    if len(st.name) > 0 {
      return ind + "continue " + st.name + ";\n";
    }
    return ind + "continue;\n";
  }
  if st.tag == parse.ST_DEFER {
    match st.sub {
      Option.Some(inner) => {
        let inner_text: string = fmt_line(inner, 0);
        // the inner carries its own newline; swap its indent for the
        // defer prefix on the first line
        let mut body: string = inner_text;
        let mut k: usize = 0;
        while k < len(body) && body[k] == 32 {
          k = k + 1;
        }
        return ind + "defer " + body[k..len(body)];
      },
      Option.None => {},
    }
    return ind + "defer;\n";
  }
  return ind + "\n";
}

pub fn fmt_block(nodes: []*Stmt, depth: usize) -> string {
  let mut out: string = "";
  let mut i: usize = 0;
  while i < len(nodes) {
    out = out + fmt_line(nodes[i], depth);
    i = i + 1;
  }
  return out;
}

fn fmt_fn(fd: *FnDef) -> string {
  let mut out: string = "fn " + fd.name + "(";
  let mut k: usize = 0;
  while k < len(fd.params) {
    if k > 0 {
      out = out + ", ";
    }
    out = out + fd.params[k];
    if k < len(fd.ptypes) && len(fd.ptypes[k]) > 0 {
      out = out + ": " + fd.ptypes[k];
    }
    k = k + 1;
  }
  out = out + ")";
  if len(fd.rtype) > 0 {
    out = out + " -> " + fd.rtype;
  }
  out = out + " {\n";
  out = out + fmt_block(fd.body, 1);
  return out + "}\n";
}

pub fn fmt_prog(prog: *Prog) -> string {
  let mut out: string = "";
  let mut c: usize = 0;
  while c < prog.nconsts {
    if prog.cstatic[c] {
      out = out + "static ";
      if prog.cmuts[c] {
        out = out + "mut ";
      }
      out = out + prog.consts[c];
    } else {
      out = out + "const " + prog.consts[c];
    }
    if len(prog.ctypes[c]) > 0 {
      out = out + ": " + prog.ctypes[c];
    }
    out = out + " = " + fmt_expr(prog.cexprs[c]) + ";\n\n";
    c = c + 1;
  }
  let mut f: usize = 0;
  while f < len(prog.fns) {
    out = out + fmt_fn(prog.fns[f]);
    f = f + 1;
  }
  return out + "fn main() -> i32 {\n" + fmt_block(prog.main, 1) +
         "}\n";
}
