// the formatter: AST to canonical source (the fmt roundtrip law)
use cli;
use lex;
use parse;
use check;



// ---------------------------------------------------------------- fmt -----
//
// Canonical formatter (port of boot's fmt.c): one style, no configuration.
// `fmt` output is idempotent and reparses to the same AST — both pinned by
// the fmt battery (boot fmt file == stage0 fmt file == stage1 fmt file).

pub static mut g_sb: *cli.Vec[u8] = 0 as *cli.Vec[u8];
static mut f_indent: i32 = 0;

pub fn sb_c(c: u8) {
  g_sb.push(c);
}
pub fn sb_s(s: string) {
  let mut i: usize = 0;
  while i < len(s) {
    g_sb.push(s[i]);
    i += 1;
  }
}
// newline + the current indent (two spaces per level)
fn f_line() {
  sb_c(10);
  let mut i: i32 = 0;
  while i < f_indent {
    sb_s("  ");
    i += 1;
  }
}

// operator spelling for bin/un/assign ops (boot: tok_spell)
pub fn spell_op(t: lex.Tok) -> string {
  if t == lex.Tok.PPlus { return "+"; }
  if t == lex.Tok.PPluseq { return "+="; }
  if t == lex.Tok.PMinus { return "-"; }
  if t == lex.Tok.PMinuseq { return "-="; }
  if t == lex.Tok.PStar { return "*"; }
  if t == lex.Tok.PStareq { return "*="; }
  if t == lex.Tok.PSlash { return "/"; }
  if t == lex.Tok.PSlasheq { return "/="; }
  if t == lex.Tok.PPercent { return "%"; }
  if t == lex.Tok.PPercenteq { return "%="; }
  if t == lex.Tok.PBang { return "!"; }
  if t == lex.Tok.PTilde { return "~"; }
  if t == lex.Tok.PAmp { return "&"; }
  if t == lex.Tok.PAmpeq { return "&="; }
  if t == lex.Tok.PPipe { return "|"; }
  if t == lex.Tok.PPipeeq { return "|="; }
  if t == lex.Tok.PCaret { return "^"; }
  if t == lex.Tok.PCareteq { return "^="; }
  if t == lex.Tok.PShl { return "<<"; }
  if t == lex.Tok.PShleq { return "<<="; }
  if t == lex.Tok.PShr { return ">>"; }
  if t == lex.Tok.PShreq { return ">>="; }
  if t == lex.Tok.PAndand { return "&&"; }
  if t == lex.Tok.POror { return "||"; }
  if t == lex.Tok.PEq { return "=="; }
  if t == lex.Tok.PNe { return "!="; }
  if t == lex.Tok.PLt { return "<"; }
  if t == lex.Tok.PGt { return ">"; }
  if t == lex.Tok.PLe { return "<="; }
  if t == lex.Tok.PGe { return ">="; }
  if t == lex.Tok.PAssign { return "="; }
  return lex.tok_name(t);
}

pub fn f_strlit(s: string) {
  sb_c(34); // "
  let mut i: usize = 0;
  while i < len(s) {
    let c: u8 = s[i];
    if c == 10 {
      sb_s("\\n");
    } else if c == 9 {
      sb_s("\\t");
    } else if c == 13 {
      sb_s("\\r");
    } else if c == 92 {
      sb_s("\\\\");
    } else if c == 34 {
      sb_s("\\\"");
    } else if c == 0 {
      sb_s("\\0");
    } else if c < 32 {
      // \x%02x, lowercase hex
      sb_s("\\x");
      let hi: u8 = c >> 4;
      let lo: u8 = c & 15;
      if hi < 10 { sb_c(48 + hi); } else { sb_c(87 + hi); }
      if lo < 10 { sb_c(48 + lo); } else { sb_c(87 + lo); }
    } else {
      sb_c(c);
    }
    i += 1;
  }
  sb_c(34);
}

// can the value take the canonical multiline form without changing a
// byte? The form prints the value's own bytes between the delimiters, so
// the value itself must carry the block's shape: it opens with the
// newline that follows the opener, every interior line is indented at
// least `col` columns, and the last line is exactly `col` spaces — the
// line the closing """ rides. Anything else stays single-line escaped.
fn ml_representable(s: string, col: i32) -> bool {
  let ind: usize = col as usize;
  if len(s) < ind + 1 || s[0] != 10 {
    return false;
  }
  let mut last_nl: usize = 0;
  let mut i: usize = 1;
  while i < len(s) {
    if s[i] == 10 {
      last_nl = i;
    }
    i += 1;
  }
  if len(s) - last_nl - 1 != ind {
    return false;
  }
  let mut k: usize = last_nl + 1;
  while k < len(s) {
    if s[k] != 32 {
      return false;
    }
    k += 1;
  }
  let mut a: usize = 1;
  while a < last_nl {
    let mut e: usize = a;
    while s[e] != 10 {
      e += 1;
    }
    let mut ws: usize = 0;
    while ws < ind && a + ws < e && s[a + ws] == 32 {
      ws += 1;
    }
    if ws < ind {
      return false;
    }
    a = e + 1;
  }
  return true;
}

// emit the value's bytes for the multiline form: newlines are printed
// raw (they draw the block's lines), everything else escapes as in
// f_strlit. Quotes: a run of three or more must keep any three RAW
// quotes from appearing in the output — an unescaped """ closes the
// literal — so every third quote of a run is written escaped: \"""
// decodes to """ and no raw run exceeds two.
fn f_ml_bytes(s: string, from: usize, to: usize) {
  let mut i: usize = from;
  let mut run: usize = 0;
  while i < to {
    let c: u8 = s[i];
    if c == 34 {
      run += 1;
      if run % 3 == 0 {
        sb_s("\\\"");
      } else {
        sb_c(34);
      }
      i += 1;
      continue;
    }
    run = 0;
    if c == 10 {
      sb_c(10);
    } else if c == 9 {
      sb_s("\\t");
    } else if c == 13 {
      sb_s("\\r");
    } else if c == 92 {
      sb_s("\\\\");
    } else if c == 0 {
      sb_s("\\0");
    } else if c < 32 {
      sb_s("\\x");
      let hi: u8 = c >> 4;
      let lo: u8 = c & 15;
      if hi < 10 { sb_c(48 + hi); } else { sb_c(87 + hi); }
      if lo < 10 { sb_c(48 + lo); } else { sb_c(87 + lo); }
    } else {
      sb_c(c);
    }
    i += 1;
  }
}

// the fmt form of a string literal: values without newlines (and values
// the multiline form cannot carry byte-exactly) stay single-line escaped;
// everything else becomes a canonical triple-quoted block — opener where
// the literal sits, then the value's own bytes: its newlines draw the
// block's lines, its indentation is the block's indent, and its final
// line of spaces carries the closing delimiter. Nothing is added and
// nothing is stripped — anything fmt added would be content — so the
// block reparses to the same value byte for byte.
fn f_strlit_fmt(s: string) {
  if !ml_representable(s, (f_indent + 1) * 2) {
    f_strlit(s);
    return;
  }
  sb_s("\"\"\"");
  f_ml_bytes(s, 0, len(s));
  sb_s("\"\"\"");
}

fn f_type(t: *parse.TypeAst) {
  if t == null {
    return;
  }
  if t.kind == parse.TypeAstKind.TaPrim {
    sb_s(check.prim_name(t.prim));
    return;
  }
  if t.kind == parse.TypeAstKind.TaArray {
    if t.size != null {
      sb_c(91); // [
      f_expr(t.size);
      sb_c(93); // ]
    } else {
      sb_s("[]");
    }
    f_type(t.elem);
    return;
  }
  if t.kind == parse.TypeAstKind.TaPtr {
    sb_c(42); // *
    f_type(t.elem);
    return;
  }
  if t.kind == parse.TypeAstKind.TaWeak {
    sb_s("weak[");
    f_type(t.elem);
    sb_c(93);
    return;
  }
  if t.kind == parse.TypeAstKind.TaNamed {
    let mut i: usize = 0;
    while i < t.path.n {
      if i > 0 {
        sb_c(46); // .
      }
      sb_s(t.path.items[i]);
      i += 1;
    }
    if t.targs.n > 0 {
      sb_c(91);
      let mut j: usize = 0;
      while j < t.targs.n {
        if j > 0 {
          sb_s(", ");
        }
        f_type(t.targs.items[j]);
        j += 1;
      }
      sb_c(93);
    }
    return;
  }
  // TaFn
  sb_s("fn(");
  let mut i: usize = 0;
  while i < t.params.n {
    if i > 0 {
      sb_s(", ");
    }
    f_type(t.params.items[i]);
    i += 1;
  }
  sb_c(41); // )
  if t.ret != null {
    sb_s(" -> ");
    f_type(t.ret);
  }
}

// expressions print without precedence machinery: binary/unary ops always
// get parens (boot relies on the same shape — its parent_bp is dead too)
fn f_expr(e: *parse.Expr) {
  if e.kind == parse.ExprKind.ExInt {
    sb_s(cli.utoa(e.iv));
    return;
  }
  if e.kind == parse.ExprKind.ExFloat {
    fmt_float(e.fv);
    return;
  }
  if e.kind == parse.ExprKind.ExStr {
    f_strlit_fmt(e.sv);
    return;
  }
  if e.kind == parse.ExprKind.ExBool {
    if e.bv { sb_s("true"); } else { sb_s("false"); }
    return;
  }
  if e.kind == parse.ExprKind.ExNull {
    sb_s("null");
    return;
  }
  if e.kind == parse.ExprKind.ExName {
    sb_s(e.sv);
    return;
  }
  if e.kind == parse.ExprKind.ExType {
    f_type(e.ty);
    return;
  }
  if e.kind == parse.ExprKind.ExBin {
    sb_c(40); // (
    f_expr(e.a);
    sb_c(32);
    sb_s(spell_op(e.binop));
    sb_c(32);
    f_expr(e.b);
    sb_c(41); // )
    return;
  }
  if e.kind == parse.ExprKind.ExUn {
    sb_c(40);
    sb_s(spell_op(e.unop));
    f_expr(e.a);
    sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExCall {
    f_expr(e.a);
    sb_c(40);
    let mut i: usize = 0;
    while i < e.args.n {
      if i > 0 {
        sb_s(", ");
      }
      if e.arg_names != null && i < e.arg_names.n && e.arg_names.items[i] != "" {
        sb_s(e.arg_names.items[i]);
        sb_s(": ");
      }
      f_expr(e.args.items[i]);
      i += 1;
    }
    sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExIndex {
    f_expr(e.a);
    sb_c(91);
    f_expr(e.b);
    sb_c(93);
    return;
  }
  if e.kind == parse.ExprKind.ExSlice {
    f_expr(e.a);
    sb_c(91);
    f_expr(e.b);
    sb_s("..");
    f_expr(e.c);
    sb_c(93);
    return;
  }
  if e.kind == parse.ExprKind.ExField {
    f_expr(e.a);
    sb_c(46);
    sb_s(e.sv);
    return;
  }
  if e.kind == parse.ExprKind.ExCast {
    f_expr(e.a);
    sb_s(" as ");
    f_type(e.ty);
    return;
  }
  if e.kind == parse.ExprKind.ExNew {
    sb_s("new ");
    f_type(e.ty);
    sb_s(" { ");
    let mut i: usize = 0;
    while i < e.args.n {
      if i > 0 {
        sb_s(", ");
      }
      sb_s(e.items.items[i].name);
      sb_s(": ");
      f_expr(e.args.items[i]);
      i += 1;
    }
    sb_s(" }");
    return;
  }
  if e.kind == parse.ExprKind.ExMake {
    sb_s("make(");
    f_type(e.ty);
    sb_s(", ");
    f_expr(e.c);
    sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExClosure {
    sb_s("fn(");
    let mut i: usize = 0;
    while i < e.params.n {
      if i > 0 {
        sb_s(", ");
      }
      sb_s(e.params.items[i].name);
      sb_s(": ");
      f_type(e.params.items[i].ty);
      i += 1;
    }
    sb_c(41);
    if e.ret != null {
      sb_s(" -> ");
      f_type(e.ret);
    }
    sb_s(" {");
    f_indent += 1;
    f_stmts(e.items);
    f_indent -= 1;
    f_line();
    sb_c(125); // }
    return;
  }
  if e.kind == parse.ExprKind.ExMatch {
    f_match_full(e);
    return;
  }
  if e.kind == parse.ExprKind.ExQmark {
    f_expr(e.a);
    sb_c(63); // ?
    return;
  }
  if e.kind == parse.ExprKind.ExIf {
    f_if_full(e);
    return;
  }
  // ExEnumCtor / ExMethod / ExBlock: post-parse placeholders, same as boot
  sb_s("...");
}

// full expression printing — if/match get real block bodies
fn f_expr_full(e: *parse.Expr) {
  if e.kind == parse.ExprKind.ExIf {
    f_if_full(e);
    return;
  }
  if e.kind == parse.ExprKind.ExMatch {
    f_match_full(e);
    return;
  }
  f_expr(e);
}

fn f_if_full(e: *parse.Expr) {
  sb_s("if ");
  f_expr_full(e.a);
  sb_s(" {");
  f_indent += 1;
  f_stmts(e.items.items[0].stmts);
  f_indent -= 1;
  f_line();
  if e.else_if != null {
    sb_s("} else ");
    f_if_full(e.else_if);
    return;
  }
  if e.items.n > 1 {
    sb_s("} else ");
    sb_c(123); // {
    f_indent += 1;
    f_stmts(e.items.items[1].stmts);
    f_indent -= 1;
    f_line();
  }
  sb_c(125); // }
}

fn f_pat_path(arm: *parse.MatchArm) {
  let mut j: usize = 0;
  while j < arm.pat_path.n {
    if j > 0 {
      sb_c(46); // .
    }
    sb_s(arm.pat_path.items[j]);
    j += 1;
  }
}

fn f_match_full(e: *parse.Expr) {
  sb_s("match ");
  f_expr_full(e.a);
  sb_s(" {");
  f_indent += 1;
  let mut i: usize = 0;
  while i < e.arms.n {
    let arm: *parse.MatchArm = e.arms.items[i];
    f_line();
    if arm.pk == parse.PatKind.PatWildcard {
      sb_s("_");
    } else if arm.pk == parse.PatKind.PatInt {
      sb_s(cli.utoa(arm.pat_int));
    } else if arm.pk == parse.PatKind.PatStr {
      f_strlit_fmt(arm.pat_str);
    } else if arm.pk == parse.PatKind.PatTuple {
      f_pat_path(arm);
      sb_c(40);
      let mut j: usize = 0;
      while j < arm.pat_names.n {
        if j > 0 {
          sb_s(", ");
        }
        sb_s(arm.pat_names.items[j]);
        j += 1;
      }
      sb_c(41);
    } else if arm.pk == parse.PatKind.PatStruct {
      f_pat_path(arm);
      sb_s(" { ");
      let mut j: usize = 0;
      while j < arm.pat_fields.n {
        if j > 0 {
          sb_s(", ");
        }
        sb_s(arm.pat_fields.items[j].name);
        sb_s(": ");
        sb_s(arm.pat_names.items[j]);
        j += 1;
      }
      sb_s(" }");
    } else {
      f_pat_path(arm);
    }
    sb_s(" => ");
    if arm.body.kind == parse.ExprKind.ExBlock {
      sb_c(123);
      f_indent += 1;
      f_stmts(arm.body.items);
      f_indent -= 1;
      f_line();
      sb_c(125);
    } else {
      f_expr_full(arm.body);
    }
    sb_c(44); // ,
    i += 1;
  }
  f_indent -= 1;
  f_line();
  sb_c(125);
}

fn f_stmt(s: *parse.Stmt) {
  f_pre(s.pre);
  if s.kind == parse.StmtKind.StLet {
    sb_s("let ");
    if s.mut_ {
      sb_s("mut ");
    }
    sb_s(s.name);
    if s.ty != null {
      sb_s(": ");
      f_type(s.ty);
    }
    sb_s(" = ");
    f_expr_full(s.a);
    if !s.tail {
      sb_c(59); // ;
    }
    return;
  }
  if s.kind == parse.StmtKind.StAssign {
    f_expr_full(s.a);
    sb_c(32);
    sb_s(spell_op(s.assign_op));
    sb_c(32);
    f_expr_full(s.b);
    sb_c(59);
    return;
  }
  if s.kind == parse.StmtKind.StExpr {
    f_expr_full(s.a);
    if !s.tail && s.a.kind != parse.ExprKind.ExIf && s.a.kind != parse.ExprKind.ExMatch &&
       s.a.kind != parse.ExprKind.ExBlock {
      sb_c(59);
    }
    return;
  }
  if s.kind == parse.StmtKind.StReturn {
    sb_s("return");
    if s.a != null {
      sb_c(32);
      f_expr_full(s.a);
    }
    sb_c(59);
    return;
  }
  if s.kind == parse.StmtKind.StBreak {
    sb_s("break;");
    return;
  }
  if s.kind == parse.StmtKind.StContinue {
    sb_s("continue;");
    return;
  }
  if s.kind == parse.StmtKind.StDefer {
    sb_s("defer ");
    if s.stmts.n == 1 && s.stmts.items[0].kind == parse.StmtKind.StBlock {
      let blk: *parse.Stmt = s.stmts.items[0];
      sb_c(123);
      f_indent += 1;
      f_stmts(blk.stmts);
      f_indent -= 1;
      f_line();
      sb_c(125);
    } else {
      let mut i: usize = 0;
      while i < s.stmts.n {
        f_stmt(s.stmts.items[i]);
        i += 1;
      }
    }
    return;
  }
  if s.kind == parse.StmtKind.StWhile {
    sb_s("while ");
    f_expr_full(s.cond);
    sb_s(" {");
    f_indent += 1;
    f_stmts(s.body);
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  if s.kind == parse.StmtKind.StLoop {
    sb_s("loop {");
    f_indent += 1;
    f_stmts(s.body);
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  // StBlock
  sb_c(123);
  f_indent += 1;
  f_stmts(s.stmts);
  f_indent -= 1;
  f_line();
  sb_c(125);
}

fn f_stmts(stmts: *cli.Vec[*parse.Stmt]) {
  let mut i: usize = 0;
  while i < stmts.n {
    f_line();
    f_stmt(stmts.items[i]);
    i += 1;
  }
}

// leading line comments, re-emitted at the current indent
fn f_pre(pre: *cli.Vec[string]) {
  if pre == null {
    return;
  }
  let mut i: usize = 0;
  while i < pre.n {
    sb_s("//");
    sb_s(pre.items[i]);
    f_line();
    i += 1;
  }
}

fn f_tparams(tparams: *cli.Vec[string]) {
  if tparams == null || tparams.n == 0 {
    return;
  }
  sb_c(91); // [
  let mut i: usize = 0;
  while i < tparams.n {
    if i > 0 {
      sb_s(", ");
    }
    sb_s(tparams.items[i]);
    i += 1;
  }
  sb_c(93); // ]
}

fn f_params(params: *cli.Vec[*parse.Param]) {
  sb_c(40); // (
  let mut i: usize = 0;
  while i < params.n {
    if i > 0 {
      sb_s(", ");
    }
    sb_s(params.items[i].name);
    sb_s(": ");
    f_type(params.items[i].ty);
    i += 1;
  }
  sb_c(41); // )
}

fn f_decl(d: *parse.Decl) {
  f_pre(d.pre);
  if d.kind == parse.DeclKind.DkUse {
    if d.pub_ {
      sb_s("pub ");
    }
    sb_s("use ");
    let mut i: usize = 0;
    while i < d.path.n {
      if i > 0 {
        sb_c(46); // .
      }
      sb_s(d.path.items[i]);
      i += 1;
    }
    if len(d.name) > 0 {
      sb_s(" as ");
      sb_s(d.name);
    }
    sb_c(59);
    return;
  }
  if d.kind == parse.DeclKind.DkExtern {
    sb_s("extern fn ");
    sb_s(d.name);
    f_params(d.params);
    if d.ret != null {
      sb_s(" -> ");
      f_type(d.ret);
    }
    sb_c(59);
    return;
  }
  if d.kind == parse.DeclKind.DkFn {
    if d.pub_ {
      sb_s("pub ");
    }
    sb_s("fn ");
    if len(d.recv) > 0 {
      sb_s(d.recv);
      sb_c(46);
    }
    sb_s(d.name);
    f_tparams(d.tparams);
    f_params(d.params);
    if d.ret != null {
      sb_s(" -> ");
      f_type(d.ret);
    }
    sb_s(" {");
    f_indent += 1;
    f_stmts(d.body);
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  if d.kind == parse.DeclKind.DkStruct {
    if d.pub_ {
      sb_s("pub ");
    }
    sb_s("struct ");
    sb_s(d.name);
    f_tparams(d.tparams);
    if d.fields.n == 0 {
      sb_s(" {}");
      return;
    }
    sb_s(" {");
    f_indent += 1;
    let mut i: usize = 0;
    while i < d.fields.n {
      f_line();
      sb_s(d.fields.items[i].name);
      sb_s(": ");
      f_type(d.fields.items[i].ty);
      sb_c(44);
      i += 1;
    }
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  if d.kind == parse.DeclKind.DkEnum {
    if d.pub_ {
      sb_s("pub ");
    }
    sb_s("enum ");
    sb_s(d.name);
    f_tparams(d.tparams);
    sb_s(" {");
    f_indent += 1;
    let mut i: usize = 0;
    while i < d.variants.n {
      let v: *parse.VariantAst = d.variants.items[i];
      f_line();
      sb_s(v.name);
      if v.vkind == parse.VarKind.VarTuple {
        sb_c(40);
        let mut j: usize = 0;
        while j < v.types.n {
          if j > 0 {
            sb_s(", ");
          }
          f_type(v.types.items[j]);
          j += 1;
        }
        sb_c(41);
      } else if v.vkind == parse.VarKind.VarStruct {
        sb_s(" { ");
        let mut j: usize = 0;
        while j < v.fields.n {
          if j > 0 {
            sb_s(", ");
          }
          sb_s(v.fields.items[j].name);
          sb_s(": ");
          f_type(v.fields.items[j].ty);
          j += 1;
        }
        sb_s(" }");
      }
      if v.has_disc {
        sb_s(" = ");
        sb_s(cli.utoa(v.disc));
      }
      sb_c(44);
      i += 1;
    }
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  if d.kind == parse.DeclKind.DkStatic {
    sb_s("static ");
    if d.is_mut {
      sb_s("mut ");
    }
    sb_s(d.name);
    sb_s(": ");
    f_type(d.ret);
    sb_s(" = ");
    f_expr_full(d.init);
    sb_c(59);
    return;
  }
  // DkConst
  sb_s("const ");
  sb_s(d.name);
  sb_s(": ");
  f_type(d.ret);
  sb_s(" = ");
  f_expr_full(d.init);
  sb_c(59);
}

pub fn fmt_module(module: *parse.Decl) -> string {
  g_sb = new cli.Vec[u8] { items: make([]u8, 65536), n: 0 };
  f_indent = 0;
  let mut first: bool = true;
  let mut i: usize = 0;
  while i < module.decls.n {
    let d: *parse.Decl = module.decls.items[i];
    if !first {
      sb_c(10);
    }
    f_decl(d);
    sb_c(10);
    first = false;
    i += 1;
  }
  if module.pre != null && module.pre.n > 0 {
    f_pre(module.pre);
    // f_pre leaves the cursor on a fresh line; close it
    sb_c(10);
  }
  return intrinsics.slice_string(g_sb.items[0..g_sb.n]);
}


// ------------------------------------------------------ %g, six digits ----
//
// The EX_FLOAT canonical form: C printf("%g") of the literal's value.
// Implemented exactly — the double's bit pattern is decomposed and rounded
// as a big decimal integer, so the 6-significant-digit rounding matches
// libc for every finite input (no float arithmetic on the value itself).

// decimal big-int, base 1e9, little-endian limbs; 160 limbs (1440 digits)
// covers 5^1074 * 2^53 with room to spare
pub struct Big {
  w: []u32,
  n: usize,
}

pub fn big_new() -> *Big {
  return new Big { w: make([]u32, 160), n: 1 };
}

fn big_trim(b: *Big) {
  while b.n > 1 && b.w[b.n - 1] == 0 {
    b.n -= 1;
  }
}

fn big_set_u64(b: *Big, v: u64) {
  b.w[0] = (v % 1000000000) as u32;
  b.w[1] = ((v / 1000000000) % 1000000000) as u32;
  b.w[2] = (v / 1000000000000000000) as u32;
  b.n = 3;
  big_trim(b);
}

// schoolbook multiply by a factor < 1e9; products stay under 2^63
pub fn big_mul_u32(b: *Big, m: u32) {
  let mut carry: u64 = 0;
  let mut i: usize = 0;
  while i < b.n {
    let cur: u64 = b.w[i] as u64 * m as u64 + carry;
    b.w[i] = (cur % 1000000000) as u32;
    carry = cur / 1000000000;
    i += 1;
  }
  while carry > 0 {
    b.w[b.n] = (carry % 1000000000) as u32;
    carry = carry / 1000000000;
    b.n += 1;
  }
}

fn big_get_u64(b: *Big) -> u64 {
  let mut v: u64 = 0;
  let mut i: usize = b.n;
  while i > 0 {
    i -= 1;
    v = v * 1000000000 + b.w[i] as u64;
  }
  return v;
}

// add a single-digit value (< 10) to the low limb
pub fn big_add_u32(b: *Big, v: u32) {
  b.w[0] = b.w[0] + v;
  let mut i: usize = 0;
  while b.w[i] >= 1000000000 {
    b.w[i] = b.w[i] - 1000000000;
    i += 1;
    b.w[i] = b.w[i] + 1;
  }
  if i >= b.n {
    b.n = i + 1;
  }
}

// floor(a * 2^bits / b) rounded half-even on the exact remainder; `a` is
// consumed, `b` must exceed the remainder at every step (b > 0, a < b)
pub fn big_div_bits(a: *Big, b: *Big, bits: i64) -> u64 {
  let mut q: u64 = 0;
  let mut j: i64 = 0;
  while j < bits {
    big_mul_u32(a, 2);
    q = q * 2;
    if big_cmp(a, b) >= 0 {
      big_sub(a, b);
      q += 1;
    }
    j += 1;
  }
  big_mul_u32(a, 2);
  let c: i32 = big_cmp(a, b);
  if c > 0 || (c == 0 && (q & 1) == 1) {
    q += 1;
  }
  return q;
}

// a -= b in place; caller guarantees a >= b
fn big_sub(a: *Big, b: *Big) {  let mut borrow: i64 = 0;
  let mut i: usize = 0;
  while i < a.n {
    let sub: i64 = borrow;
    let mut cur: i64 = a.w[i] as i64 - sub;
    if i < b.n {
      cur = a.w[i] as i64 - b.w[i] as i64 - borrow;
    }
    if cur < 0 {
      cur += 1000000000;
      borrow = 1;
    } else {
      borrow = 0;
    }
    a.w[i] = cur as u32;
    i += 1;
  }
  big_trim(a);
}

fn big_add_one(b: *Big) {
  let mut i: usize = 0;
  loop {
    if i >= b.n {
      b.w[i] = 1;
      b.n += 1;
      return;
    }
    b.w[i] = b.w[i] + 1;
    if b.w[i] < 1000000000 {
      return;
    }
    b.w[i] = 0;
    i += 1;
  }
}

pub fn big_clone(a: *Big) -> *Big {
  let b: *Big = big_new();
  let mut i: usize = 0;
  while i < a.n {
    b.w[i] = a.w[i];
    i += 1;
  }
  b.n = a.n;
  return b;
}

pub fn big_cmp(a: *Big, b: *Big) -> i32 {
  if a.n != b.n {
    if a.n < b.n {
      return 0 - 1;
    }
    return 1;
  }
  let mut i: usize = a.n;
  while i > 0 {
    i -= 1;
    if a.w[i] != b.w[i] {
      if a.w[i] < b.w[i] {
        return 0 - 1;
      }
      return 1;
    }
  }
  return 0;
}

pub fn p10_u64(r: usize) -> u64 {
  let mut v: u64 = 1;
  let mut i: usize = 0;
  while (i as i64) < r as i64 {
    v = v * 10;
    i += 1;
  }
  return v;
}

fn pow2_u32(k: i64) -> u32 {
  let mut v: u32 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 2;
    i += 1;
  }
  return v;
}

fn pow5_u32(k: i64) -> u32 {
  let mut v: u32 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 5;
    i += 1;
  }
  return v;
}

// 5 * 10^(cut-1): half of the divisor 10^cut
fn big_half(cut: usize) -> *Big {
  let h: *Big = big_new();
  let pos: usize = cut - 1;
  let l: usize = pos / 9;
  let r: usize = pos % 9;
  h.w[l] = (5 * p10_u64(r)) as u32;
  h.n = l + 1;
  return h;
}

// Q = N div 10^cut (returned); N becomes N mod 10^cut
fn big_divmod_pow10(b: *Big, cut: usize) -> *Big {
  let l: usize = cut / 9;
  let r: usize = cut % 9;
  let q: *Big = big_new();
  if b.n <= l {
    return q;
  }
  let qn: usize = b.n - l;
  let p: u64 = p10_u64(r);
  let mut rem: u64 = 0;
  let mut i: usize = qn;
  while i > 0 {
    i -= 1;
    let cur: u64 = rem * 1000000000 + b.w[l + i] as u64;
    q.w[i] = (cur / p) as u32;
    rem = cur % p;
  }
  q.n = qn;
  big_trim(q);
  if r > 0 {
    b.w[l] = rem as u32;
    b.n = l + 1;
  } else {
    b.n = l;
  }
  if b.n == 0 {
    b.w[0] = 0;
    b.n = 1;
  }
  big_trim(b);
  return q;
}

pub fn u32_digits(v: u32) -> i64 {
  let mut d: i64 = 1;
  let mut x: u32 = v;
  while x >= 10 {
    x = x / 10;
    d += 1;
  }
  return d;
}

pub fn substr(s: string, a: usize, b: usize) -> string {
  let buf: []u8 = make([]u8, b - a);
  let mut i: usize = a;
  while i < b {
    buf[i - a] = s[i];
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

// strip trailing '0's ("1000" -> "1", "000" -> "")
fn g6_strip(fr: string) -> string {
  let mut k: usize = len(fr);
  while k > 0 && fr[k - 1] == 48 {
    k -= 1;
  }
  return substr(fr, 0, k);
}

fn rep0(cnt: usize) -> string {
  let buf: []u8 = make([]u8, cnt);
  let mut i: usize = 0;
  while i < cnt {
    buf[i] = 48;
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

pub fn g_digits(x: f64, prec: i64) -> string {
  let bits: u64 = intrinsics.f64_bits(x);
  let be: u64 = (bits >> 52) & 2047;
  if be == 2047 {
    if (bits & 4503599627370495) == 0 {
      return "inf";
    }
    return "nan";
  }
  if (bits << 1) == 0 {
    return "0";
  }
  let mut m2: u64 = 0;
  let mut e2: i64 = 0;
  if be == 0 {
    m2 = bits & 4503599627370495;
    e2 = (0 - 1074) as i64;
  } else {
    m2 = (bits & 4503599627370495) | 4503599627370496;
    e2 = be as i64 - 1075;
  }
  // exact integer N with x == N / 10^s
  let b: *Big = big_new();
  big_set_u64(b, m2);
  let mut s: i64 = 0;
  if e2 >= 0 {
    let mut k: i64 = e2;
    while k >= 29 {
      big_mul_u32(b, 536870912);
      k -= 29;
    }
    if k > 0 {
      big_mul_u32(b, pow2_u32(k));
    }
  } else {
    // x = m2 * 2^-k = (m2 * 5^k) / 10^k — powers of FIVE: multiplying by
    // powers of ten here would smuggle extra factors of two into N
    let mut k: i64 = 0 - e2;
    while k >= 9 {
      big_mul_u32(b, 1953125);
      s += 9;
      k -= 9;
    }
    if k > 0 {
      big_mul_u32(b, pow5_u32(k));
      s += k;
    }
  }
  // n: x = 0.<digits> * 10^n; cut at `prec` significant digits
  let topd: i64 = u32_digits(b.w[b.n - 1]);
  let mut n: i64 = (b.n as i64 - 1) * 9 + topd - s;
  let cut: i64 = s + n - prec;
  let mut qv: u64 = 0;
  if cut > 0 {
    let q: *Big = big_divmod_pow10(b, cut as usize);
    // round half to even on the exact remainder
    let c: i32 = big_cmp(b, big_half(cut as usize));
    if c > 0 || (c == 0 && (q.w[0] & 1) == 1) {
      big_add_one(q);
    }
    qv = big_get_u64(q);
  } else if cut == 0 {
    qv = big_get_u64(b);
  } else {
    let mut k: i64 = 0 - cut;
    while k >= 9 {
      big_mul_u32(b, 1000000000);
      k -= 9;
    }
    if k > 0 {
      big_mul_u32(b, p10_u64(k as usize) as u32);
    }
    qv = big_get_u64(b);
  }
  // round-up carry: 999...9.7 -> 10^prec -> re-exponent
  if qv >= p10_u64(prec as usize) {
    qv = qv / 10;
    n += 1;
  }
  let e10: i64 = n - 1;
  let ds: string = cli.utoa(qv);
  if e10 >= (0 - 4) as i64 && e10 < prec {
    if e10 >= 0 {
      let ip: usize = e10 as usize + 1;
      let frac: string = g6_strip(substr(ds, ip, prec as usize));
      if len(frac) == 0 {
        return substr(ds, 0, ip);
      }
      return substr(ds, 0, ip) + "." + frac + "" + "";
    }
    let all: string = g6_strip(rep0((0 - e10 - 1) as usize) + ds + "");
    if len(all) == 0 {
      return "0";
    }
    return "0." + all + "";
  }
  let mut out: string = substr(ds, 0, 1);
  let frac: string = g6_strip(substr(ds, 1, prec as usize));
  if len(frac) > 0 {
    out = out + "." + frac + "" + "";
  }
  let mut ae: i64 = e10;
  if ae < 0 {
    ae = 0 - ae;
  }
  let mut es: string = cli.itoa(ae);
  if ae < 10 {
    es = "0" + es + "";
  }
  if e10 < 0 {
    return out + "e-" + es + "" + "";
  }
  return out + "e+" + es + "" + "";
}

fn g6(x: f64) -> string {
  return g_digits(x, 6);
}

fn fmt_float(x: f64) {
  let s: string = g6(x);
  sb_s(s);
  // keep it a float literal: no '.' or 'e' in the %g form means append ".0"
  let mut i: usize = 0;
  while i < len(s) {
    if s[i] == 46 || s[i] == 101 {
      return;
    }
    i += 1;
  }
  sb_s(".0");
}
