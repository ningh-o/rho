// fmt.rho — the self-hosted compiler's canonical formatter (T2.2
// growth; the T6.3 full-layer boot-parity round). Boot's fmt.c is the
// judge: one true spelling per construct, 2-space indent, trailing
// commas on multiline lists, braces on every block, fmt output a
// parse fixed point. The mirror rides the same spelling on the whole
// grammar the parser keeps: expressions (floats re-spelled at %.17g
// through f64.to_str, calls/fields/methods/new/closures/if/match),
// statements (match, compound and indexed field stores), and the
// declaration cascade in the parser's own table order — uses, traits,
// consts/statics, structs, enums, fns, main. The comment replay
// follows boot's law: a comment on a construct's own last line rides
// as its trailing note, every other comment leads the next construct
// at the current indent, the cursor monotonic.
//
// Three spellings the parser's tables cannot carry ride their
// documented fallbacks (byte-exact on the corpus, best-effort off it):
// a struct-form enum variant prints in the tuple spelling (the
// variant's field names are not in the tables), a struct-form pattern
// prints its binders parenthesized, and a bool pattern prints its
// 0/1 literal.
use lex;
use parse;

// the byte-at-position table: BYTES[b..b+1] is the one-char string
// holding exactly byte b (escapes decode at emission, so the literal
// spells all 256 positions)
const BYTES: string =
  "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f" +
  "\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f" +
  "\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f" +
  "\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f" +
  "\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f" +
  "\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f" +
  "\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f" +
  "\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f" +
  "\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f" +
  "\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f" +
  "\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf" +
  "\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf" +
  "\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf" +
  "\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf" +
  "\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef" +
  "\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff";

fn byte_char(b: u8) -> string {
  let i: usize = b as usize;
  return BYTES[i..(i + 1)];
}

fn lower_hex(v: u8) -> string {
  let h: string = "0123456789abcdef";
  let hi: usize = ((v >> 4) as usize) & 15;
  let lo: usize = (v as usize) & 15;
  return h[hi..(hi + 1)] + h[lo..(lo + 1)];
}

// the canonical spelling of one decoded byte inside a string literal
fn canon_byte(b: u8) -> string {
  if b == 34 {
    return "\\\"";
  }
  if b == 92 {
    return "\\\\";
  }
  if b == 10 {
    return "\\n";
  }
  if b == 13 {
    return "\\r";
  }
  if b == 9 {
    return "\\t";
  }
  if b == 0 {
    return "\\x00";
  }
  // boot's strlit: C0 controls and DEL ride hex, everything else raw
  if b < 32 {
    return "\\x" + lower_hex(b);
  }
  if b == 127 {
    return "\\x7f";
  }
  return byte_char(b);
}

fn hex_v(b: u8) -> i64 {
  if b >= 48 && b <= 57 {
    return (b as i64) - 48;
  }
  if b >= 97 && b <= 102 {
    return (b as i64) - 87;
  }
  if b >= 65 && b <= 70 {
    return (b as i64) - 55;
  }
  return 0;
}

// decode a raw span into its bytes, then spell each canonically
fn canon_string(raw: string) -> string {
  let mut out: string = "\"";
  let mut i: usize = 0;
  while i < len(raw) {
    let mut b: u8 = raw[i];
    if b == 92 && i + 1 < len(raw) {
      let e: u8 = raw[i + 1];
      if e == 110 {
        out = out + canon_byte(10);
        i = i + 2;
        continue;
      }
      if e == 114 {
        out = out + canon_byte(13);
        i = i + 2;
        continue;
      }
      if e == 116 {
        out = out + canon_byte(9);
        i = i + 2;
        continue;
      }
      if e == 48 {
        out = out + canon_byte(0);
        i = i + 2;
        continue;
      }
      if e == 92 {
        out = out + canon_byte(92);
        i = i + 2;
        continue;
      }
      if e == 34 {
        out = out + canon_byte(34);
        i = i + 2;
        continue;
      }
      if e == 120 && i + 3 < len(raw) {
        let v: i64 = hex_v(raw[i + 2]) * 16 + hex_v(raw[i + 3]);
        out = out + canon_byte((v as u8));
        i = i + 4;
        continue;
      }
      if e == 117 {
        let mut j: usize = i + 3;
        let mut cp: i64 = 0;
        while j < len(raw) && raw[j] != 125 {
          let h: i64 = hex_v(raw[j]);
          cp = cp * 16 + h;
          j = j + 1;
        }
        // the code point's utf-8 bytes, each canonically spelled
        if cp < 128 {
          out = out + canon_byte((cp as u8));
        } else {
          if cp < 2048 {
            out = out + canon_byte((((cp >> 6) as u8)) | 192);
            out = out + canon_byte((((cp & 63) as u8)) | 128);
          } else {
            if cp < 65536 {
              out = out + canon_byte((((cp >> 12) as u8)) | 224);
              out = out + canon_byte(((((cp >> 6) & 63) as u8)) | 128);
              out = out + canon_byte((((cp & 63) as u8)) | 128);
            } else {
              out = out + canon_byte((((cp >> 18) as u8)) | 240);
              out = out + canon_byte(((((cp >> 12) & 63) as u8)) | 128);
              out = out + canon_byte(((((cp >> 6) & 63) as u8)) | 128);
              out = out + canon_byte((((cp & 63) as u8)) | 128);
            }
          }
        }
        i = j + 1;
        continue;
      }
      // an unknown escape rides as its letter (the checker's turf)
      out = out + canon_byte(e);
      i = i + 2;
      continue;
    }
    out = out + canon_byte(b);
    i = i + 1;
  }
  return out + "\"";
}

fn op_spell(op: i64) -> string {
  if op == 0 { return "+"; }
  if op == 1 { return "-"; }
  if op == 2 { return "*"; }
  if op == 3 { return "/"; }
  if op == 4 { return "%"; }
  if op == 5 { return "<"; }
  if op == 6 { return ">"; }
  if op == 7 { return "<="; }
  if op == 8 { return ">="; }
  if op == 9 { return "=="; }
  if op == 10 { return "!="; }
  if op == 13 { return "&&"; }
  if op == 14 { return "||"; }
  if op == 15 { return "&"; }
  if op == 16 { return "|"; }
  if op == 17 { return "^"; }
  if op == 18 { return "<<"; }
  return ">>";
}

// ---- integer literals ----

// a negative literal folds at parse (the unary minus on a literal);
// the canonical spelling is the parenthesized negation. The i64 floor
// has no positive twin — its fold wrapped in place — so it spells the
// magnitude the source token carried. The floor is detected by its
// self-negation (0 - v == v holds for the floor alone), not by a
// const comparison — the const's value rode the wrong lane once.
fn fmt_lit(v: i64) -> string {
  if v >= 0 {
    return v.to_str();
  }
  if 0 - v == v {
    return "-(9223372036854775808)";
  }
  return "-(" + (0 - v).to_str() + ")";
}

// a literal under an unsigned declared type: the lexer wrapped the
// u64-range token into i64, and a signed negative cannot sit under an
// unsigned let legally — the bits are the u64 value, spelled unsigned
fn fmt_ulit(v: i64) -> string {
  if v >= 0 {
    return v.to_str();
  }
  return (v as u64).to_str();
}

fn is_unsigned_type(t: string) -> bool {
  if len(t) == 0 {
    return false;
  }
  if t[0] != 117 {
    return false;
  }
  // u8 u16 u32 u64 usize — and guard against a user type named U..
  if len(t) >= 2 && t[1] == 56 {
    return true;
  }
  if len(t) == 3 && t[1] == 49 && t[2] == 54 {
    return true;
  }
  if len(t) == 3 && t[1] == 51 && t[2] == 50 {
    return true;
  }
  if len(t) == 3 && t[1] == 54 && t[2] == 52 {
    return true;
  }
  if t == "usize" {
    return true;
  }
  return false;
}

// ---- float literals: the token's exact decimal → the nearest f64
// (C strtod's law) → the %.17g spelling (the runtime's dec_text
// through f64.to_str, minus its with_frac wrapper). The parse runs on
// exact u32-limb bignums: the kept digit string times 5^k (10^k =
// 5^k × 2^k), then a 54-bit (mantissa + guard) normalize with a
// sticky for everything below — round-to-nearest-even lands the
// strtod bit pattern; denormals renormalize onto the 2^-1074 grid.
// The dd experiment this replaces was blind past its exact window
// (5e-324 came out e-22). ----

// little-endian u32-limb bignum with a sticky bit for lost low data
struct BN {
  l: []i64,
  n: usize,
  s: bool,
}

fn bn_new() -> *BN {
  return new BN { l: make([]i64, 200), n: 1, s: false };
}

fn bn_mul_small(mut a: *BN, m: i64) {
  let mut carry: i64 = 0;
  let mut i: usize = 0;
  while i < a.n {
    let t: i64 = a.l[i] * m + carry;
    a.l[i] = t - ((t >> 32) << 32);
    carry = t >> 32;
    i = i + 1;
  }
  while carry > 0 {
    a.l[a.n] = carry - ((carry >> 32) << 32);
    carry = carry >> 32;
    a.n = a.n + 1;
  }
}

fn bn_add_small(mut a: *BN, v: i64) {
  a.l[0] = a.l[0] + v;
  let mut i: usize = 0;
  while a.l[i] > 4294967295 {
    a.l[i] = a.l[i] - 4294967296;
    i = i + 1;
    if i == a.n {
      a.l[a.n] = 1;
      a.n = a.n + 1;
      return;
    }
    a.l[i] = a.l[i] + 1;
  }
}

fn bn_is_zero(a: *BN) -> bool {
  let mut i: usize = 0;
  while i < a.n {
    if a.l[i] != 0 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

fn bn_bitlen(a: *BN) -> i64 {
  let mut i: usize = a.n;
  while i > 0 {
    i = i - 1;
    if a.l[i] != 0 {
      let mut v: i64 = a.l[i];
      let mut b: i64 = (i as i64) * 32;
      while v > 0 {
        b = b + 1;
        v = v >> 1;
      }
      return b;
    }
  }
  return 0;
}

// one bit right; reports the bit left behind (the caller ORs sticky)
fn bn_shr1(mut a: *BN) -> bool {
  let lost: bool = (a.l[0] - ((a.l[0] >> 1) << 1)) == 1;
  let mut i: usize = 0;
  while i < a.n - 1 {
    a.l[i] = (a.l[i] >> 1) | ((a.l[i + 1] - ((a.l[i + 1] >> 1) << 1)) << 31);
    i = i + 1;
  }
  a.l[a.n - 1] = a.l[a.n - 1] >> 1;
  if a.n > 1 && a.l[a.n - 1] == 0 {
    a.n = a.n - 1;
  }
  return lost;
}

fn bn_shr(mut a: *BN, sh: i64) {
  let mut k: i64 = 0;
  while k < sh {
    let lost = bn_shr1(mut a);
    if lost {
      a.s = true;
    }
    k = k + 1;
  }
}

fn bn_shl(mut a: *BN, sh: i64) {
  let mut k: i64 = 0;
  while k < sh {
    let mut carry: i64 = 0;
    let mut i: usize = 0;
    while i < a.n {
      let t: i64 = (a.l[i] << 1) | carry;
      a.l[i] = t - ((t >> 32) << 32);
      carry = t >> 32;
      i = i + 1;
    }
    if carry > 0 {
      a.l[a.n] = carry;
      a.n = a.n + 1;
    }
    k = k + 1;
  }
}

fn bn_cmp(a: *BN, b: *BN) -> i64 {
  if a.n != b.n {
    if a.n < b.n {
      return 0 - 1;
    }
    return 1;
  }
  let mut i: usize = a.n;
  while i > 0 {
    i = i - 1;
    if a.l[i] != b.l[i] {
      if a.l[i] < b.l[i] {
        return 0 - 1;
      }
      return 1;
    }
  }
  return 0;
}

// a -= b (the caller keeps a >= b)
fn bn_sub(mut a: *BN, b: *BN) {
  let mut borrow: i64 = 0;
  let mut i: usize = 0;
  while i < a.n {
    let bi: i64 = if i < b.n { b.l[i] } else { 0 };
    let t: i64 = a.l[i] - bi - borrow;
    if t < 0 {
      a.l[i] = t + 4294967296;
      borrow = 1;
    } else {
      a.l[i] = t;
      borrow = 0;
    }
    i = i + 1;
  }
  while a.n > 1 && a.l[a.n - 1] == 0 {
    a.n = a.n - 1;
  }
}

struct FLR {
  v: f64,
  inf: bool,
  neg: bool,
}

fn fl_pow2(e: i64) -> f64 {
  let mut p: f64 = 1.0;
  let mut k: i64 = 0;
  while k < e {
    p = p * 2.0;
    k = k + 1;
  }
  return p;
}

// value = m × 2^e, both exact — rebuild by power-of-two steps (each
// step exact: the significand never changes, only the exponent)
fn fl_rebuild(m: i64, e: i64) -> f64 {
  let mut v: f64 = m as f64;
  let mut ee: i64 = e;
  while ee >= 30 {
    v = v * 1073741824.0;
    ee = ee - 30;
  }
  while ee <= -30 {
    v = v / 1073741824.0;
    ee = ee + 30;
  }
  if ee > 0 {
    v = v * fl_pow2(ee);
  }
  if ee < 0 {
    v = v / fl_pow2(0 - ee);
  }
  return v;
}

// the token's digits → (mantissa bignum, significant count, frac
// digits, decimal exponent, negative flag)
// the token's digits: mantissa bignum, significant count, fraction
// digits, decimal exponent, sign
struct FLNUM {
  mant: *BN,
  seen: i64,
  frac: i64,
  exp10: i64,
  neg: bool,
}

fn fl_scan(text: string) -> *FLNUM {
  let mut neg: bool = false;
  let mut i: usize = 0;
  if i < len(text) && text[i] == 45 {
    neg = true;
    i = i + 1;
  }
  let mut mant = bn_new();
  let mut seen: i64 = 0;
  let mut frac: i64 = 0;
  let mut exp10: i64 = 0;
  let mut infrac: bool = false;
  while i < len(text) {
    let c: u8 = text[i];
    if c == 46 {
      infrac = true;
      i = i + 1;
      continue;
    }
    if c == 101 || c == 69 {
      break;
    }
    if c < 48 || c > 57 {
      break;
    }
    let d: i64 = (c as i64) - 48;
    if infrac {
      frac = frac + 1;
    }
    if d == 0 && seen == 0 {
      // a leading zero carries no significance (its fraction slot
      // already counted through frac)
      i = i + 1;
      continue;
    }
    if seen < 1200 {
      bn_mul_small(mut mant, 10);
      bn_add_small(mut mant, d);
      seen = seen + 1;
    } else {
      if d != 0 {
        mant.s = true;
      }
    }
    i = i + 1;
  }
  let mut have_exp: bool = false;
  if i < len(text) && (text[i] == 101 || text[i] == 69) {
    i = i + 1;
    have_exp = len(text) > i && (text[i] == 43 || text[i] == 45 ||
                                 (text[i] >= 48 && text[i] <= 57));
  }
  if have_exp {
    let mut eneg: bool = false;
    if i < len(text) && (text[i] == 43 || text[i] == 45) {
      eneg = text[i] == 45;
      i = i + 1;
    }
    let mut v: i64 = 0;
    while i < len(text) {
      let c2: u8 = text[i];
      if c2 < 48 || c2 > 57 {
        break;
      }
      if v < 100000000 {
        v = v * 10 + ((c2 as i64) - 48);
      }
      i = i + 1;
    }
    if eneg {
      exp10 = 0 - v;
    } else {
      exp10 = v;
    }
  }
  return new FLNUM { mant: mant, seen: seen, frac: frac, exp10: exp10,
                     neg: neg };
}

// G (54 bits: 53 mantissa + guard) out of a bignum normalized to
// exactly 54 bits (two limbs: bit 53 rides limb 1)
fn bn_top54(a: *BN) -> i64 {
  return (a.l[a.n - 1] << 32) | a.l[a.n - 2];
}

// the double the token spells (strtod's nearest-even law)
fn flit_parse(text: string) -> *FLR {
  let f = fl_scan(text);
  if f.seen == 0 {
    return new FLR { v: 0.0, inf: false, neg: f.neg };
  }
  let k: i64 = f.exp10 - f.frac;
  // value ∈ [10^(seen+k-1), 10^(seen+k)) — the shortcuts only fire
  // where the full path could not change the verdict
  if f.seen + k - 1 >= 309 {
    return new FLR { v: 0.0, inf: true, neg: f.neg };
  }
  if f.seen + k <= 0 - 324 {
    return new FLR { v: 0.0, inf: false, neg: f.neg };
  }
  let mut g: i64 = 0; // 54 bits: 53 mantissa + guard at bit 0
  let mut e2: i64 = 0; // value ≈ g × 2^e2 (± the sticky fraction)
  let mut sticky: bool = false;
  if k >= 0 {
    // value = mant × 5^k × 2^k — the product is exact, normalize
    let mut n: *BN = f.mant;
    let mut j: i64 = 0;
    while j < k {
      bn_mul_small(mut n, 5);
      j = j + 1;
    }
    sticky = n.s;
    let bl: i64 = bn_bitlen(n);
    if bl > 54 {
      bn_shr(mut n, bl - 54);
      sticky = sticky || n.s;
    } else {
      bn_shl(mut n, 54 - bl);
    }
    e2 = k + (bl - 54);
    g = bn_top54(n);
  } else {
    // value = mant / 5^m × 2^-m — divide at 54-bit precision, the
    // remainder joins the sticky
    let m: i64 = 0 - k;
    let mut den: *BN = bn_new();
    den.l[0] = 1;
    let mut j: i64 = 0;
    while j < m {
      bn_mul_small(mut den, 5);
      j = j + 1;
    }
    sticky = f.mant.s;
    // t: the left shift that lands floor(mant × 2^t / den) near 2^54
    let t: i64 = 54 - bn_bitlen(f.mant) + bn_bitlen(den);
    let mut x: *BN = f.mant;
    if t > 0 {
      bn_shl(mut x, t);
    } else {
      if t < 0 {
        bn_shr(mut x, 0 - t);
        sticky = sticky || x.s;
      }
    }
    // binary long division: q = floor(x / den), x rides out the rest
    // (the t shift pins bitlen(x) at 54 + bitlen(den): d == 54)
    let d: i64 = bn_bitlen(x) - bn_bitlen(den);
    let mut q: *BN = bn_new();
    let mut den2 = bn_new();
    let mut w: usize = 0;
    while w < den.n {
      den2.l[w] = den.l[w];
      w = w + 1;
    }
    den2.n = den.n;
    bn_shl(mut den2, d);
    let mut i4: i64 = 0;
    while i4 <= d {
      bn_shl(mut q, 1);
      if bn_cmp(x, den2) >= 0 {
        bn_sub(mut x, den2);
        q.l[0] = q.l[0] | 1;
      }
      if i4 < d {
        bn_shr1(mut den2);
      }
      i4 = i4 + 1;
    }
    e2 = 0 - m - t;
    if !bn_is_zero(x) {
      sticky = true;
    }
    // normalize the quotient to exactly 54 bits
    let bq: i64 = bn_bitlen(q);
    if bq > 54 {
      bn_shr(mut q, bq - 54);
      e2 = e2 + (bq - 54);
    } else {
      if bq < 54 {
        bn_shl(mut q, 54 - bq);
        e2 = e2 - (54 - bq);
      }
    }
    g = bn_top54(q);
  }
  // one nearest-even rounding from the exact decimal: guard at bit 0,
  // sticky everything below. Normal targets round at 53 bits;
  // subnormals (e < -1074) re-anchor on the 2^-1074 grid first.
  let mut e: i64 = e2 + 1;
  if e >= 972 {
    return new FLR { v: 0.0, inf: true, neg: f.neg };
  }
  let mut m53: i64 = g >> 1;
  if e >= -1074 {
    let guard: i64 = g - ((g >> 1) << 1);
    if guard == 1 && (sticky || (m53 - ((m53 >> 1) << 1)) == 1) {
      m53 = m53 + 1;
    }
    if m53 == 9007199254740992 {
      m53 = 4503599627370496;
      e = e + 1;
      if e >= 972 {
        return new FLR { v: 0.0, inf: true, neg: f.neg };
      }
    }
    return new FLR { v: fl_rebuild(m53, e), inf: false, neg: f.neg };
  }
  // subnormal: shift onto the 2^-1074 grid, one nearest-even round
  let sh2: i64 = (0 - 1074) as i64 - e;
  let mut k2: i64 = 0;
  let mut round_up: bool = false;
  if sh2 > 54 {
    // the whole mantissa sits below half the grid unit: no round-up
    k2 = 0;
  } else {
    k2 = m53 >> sh2;
    let guard2: i64 = (m53 >> (sh2 - 1)) -
                      ((m53 >> sh2) << 1);
    let lowmask: i64 = (1 << (sh2 - 1)) - 1;
    let st2: bool = sticky || ((m53 & lowmask) != 0);
    round_up = guard2 == 1 && (st2 || (k2 - ((k2 >> 1) << 1)) == 1);
  }
  if round_up {
    k2 = k2 + 1;
  }
  return new FLR { v: fl_rebuild(k2, -1074), inf: false, neg: f.neg };
}

// the %.17g spelling of a float token: strtod's nearest double, then
// the runtime's dec_text(bits, 17) — through f64.to_str, whose
// with_frac wrapper (integral floats keep a visible ".0") is undone:
// boot's %.17g spells them bare
fn fmt_flit(text: string) -> string {
  let r = flit_parse(text);
  if r.inf {
    if r.neg {
      return "-inf";
    }
    return "inf";
  }
  if r.v == 0.0 {
    if r.neg {
      return "-0";
    }
    return "0";
  }
  let mut v: f64 = r.v;
  if r.neg {
    v = 0.0 - v;
  }
  let s: string = v.to_str();
  // with_frac keeps a visible fraction on integral values; dec_text's
  // drop_zeros never leaves a genuine ".0" tail — so a dotless-exponent
  // string ending in ".0" is exactly the wrapper's artifact, and boot's
  // %.17g spells the integer bare
  if len(s) >= 2 && s[len(s) - 1] == 48 && s[len(s) - 2] == 46 {
    return s[0..(len(s) - 2)];
  }
  return s;
}

// ---- expressions ----

fn ind_of(depth: usize) -> string {
  let mut out: string = "";
  let mut k: usize = 0;
  while k < depth {
    out = out + "  ";
    k = k + 1;
  }
  return out;
}

fn fmt_call_args(prog: *Prog, mut cur: *CmtCur, args: []*Expr,
                 fnames: []string, depth: usize) -> string {
  let mut out: string = "(";
  let mut k: usize = 0;
  while k < len(args) {
    if k > 0 {
      out = out + ", ";
    }
    if k < len(fnames) && len(fnames[k]) > 0 {
      out = out + fnames[k] + ": ";
    }
    if args[k].amut {
      out = out + "mut ";
    }
    out = out + fmt_expr(prog, mut cur, args[k], depth);
    if args[k].lit == (0 - 99) {
      out = out + "...";
    }
    k = k + 1;
  }
  return out + ")";
}

// one match arm's right-hand side: a block arm prints its statements
// (the tail expression rides as the block's final `expr;` line), an
// expression arm prints bare — then the trailing comma
fn fmt_arm_rhs(prog: *Prog, mut cur: *CmtCur, arm: *MatchArm,
               depth: usize) -> string {
  let mut out: string = "";
  if len(arm.body) > 0 {
    out = out + " {";
    out = out + "\n";
    out = out + fmt_block(prog, mut cur, arm.body, depth + 1);
    // comments above the block's closing brace print at the block's
    // OUTER depth (boot's fmt_block flushes after its depth drop)
    if arm.bend > 0 {
      out = out + cmt_flush(prog, mut cur, arm.bend as i64, depth);
    }
    // a block arm can carry a tail expression beside its statements —
    // it rides as the block's final line; an if-chain tail is boot's
    // statement form (no trailing semicolon), any other expression
    // spells one
    match arm.val {
      Option.Some(v) => {
        out = out + ind_of(depth + 1);
        out = out + fmt_expr(prog, mut cur, v, depth + 1);
        if v.tag != parse.EX_IF {
          out = out + ";";
        }
        out = out + "\n";
      },
      Option.None => {},
    }
    out = out + ind_of(depth);
    out = out + "}";
  } else {
    match arm.val {
      Option.Some(v) => {
        out = out + fmt_expr(prog, mut cur, v, depth);
      },
      Option.None => {
        out = out + " {";
        out = out + "\n";
        out = out + ind_of(depth);
        out = out + "}";
      },
    }
  }
  return out + ",";
}

pub fn fmt_pattern(prog: *Prog, p: *Pat) -> string {
  if p.kind == 0 {
    return "_";
  }
  if p.kind == 1 {
    // the literal lanes: int/float/bool/string — the bool words ride
    // their own lane (boot's NT_PLIT op-2), floats re-spell at %.17g
    if p.lop == 1 {
      return fmt_flit(p.ftext);
    }
    if p.lop == 2 {
      if p.lit == 1 {
        return "true";
      }
      return "false";
    }
    if p.lop == 3 {
      return "\"" + p.sval + "\"";
    }
    return fmt_lit(p.lit);
  }
  if p.kind == 3 {
    return p.name;
  }
  if p.kind == 4 {
    // the or-pattern: the alternatives join on " | "
    let mut out: string = "";
    let mut a: usize = 0;
    while a < len(p.alts) {
      if a > 0 {
        out = out + " | ";
      }
      out = out + fmt_pattern(prog, p.alts[a]);
      a = a + 1;
    }
    return out;
  }
  // a variant: the source's own payload form — Var(...) tuple,
  // Var { f, g: sub } struct, or bare Var (the unit spell); the bare
  // candidate prints unqualified (§19's resolution rides emission,
  // not the source text)
  let mut out: string = "";
  if len(p.ename) > 0 {
    out = p.ename + ".";
  }
  out = out + p.vname;
  if p.vop == 1 {
    out = out + "(";
    let mut k: usize = 0;
    while k < len(p.subs) {
      if k > 0 {
        out = out + ", ";
      }
      out = out + fmt_pattern(prog, p.subs[k]);
      k = k + 1;
    }
    out = out + ")";
  } else {
    if p.vop == 2 {
      out = out + " {";
      let mut k: usize = 0;
      while k < len(p.subs) {
        if k > 0 {
          out = out + ", ";
        }
        if k < len(p.fnames) {
          // a bare field binder spells just its name (the field's
          // own); anything else rides 'field: sub'
          let sub = p.subs[k];
          if sub.kind == 3 && sub.name == p.fnames[k] {
            out = out + p.fnames[k];
          } else {
            out = out + p.fnames[k] + ": " + fmt_pattern(prog, p.subs[k]);
          }
        } else {
          out = out + fmt_pattern(prog, p.subs[k]);
        }
        k = k + 1;
      }
      out = out + "}";
    }
  }
  return out;
}

// the match's arm list at depth: indented patterns, arms one per line
fn fmt_arms(prog: *Prog, mut cur: *CmtCur, arms: []*MatchArm,
            depth: usize) -> string {
  let mut out: string = "";
  let mut k: usize = 0;
  while k < len(arms) {
    let arm: *MatchArm = arms[k];
    out = out + ind_of(depth);
    out = out + fmt_pattern(prog, arm.pat);
    match arm.guard {
      Option.Some(g) => {
        // the §19 guard rides between the pattern and the arrow
        out = out + " if " + fmt_expr(prog, mut cur, g, depth);
      },
      Option.None => {},
    }
    out = out + " => ";
    out = out + fmt_arm_rhs(prog, mut cur, arm, depth);
    out = out + "\n";
    k = k + 1;
  }
  return out;
}

// a match construct: scrutinee, brace, arms, closing indent
fn fmt_match(prog: *Prog, mut cur: *CmtCur, scrut: *Expr,
             arms: []*MatchArm, depth: usize) -> string {
  let mut out: string = "match ";
  out = out + fmt_expr(prog, mut cur, scrut, depth);
  out = out + " {\n";
  out = out + fmt_arms(prog, mut cur, arms, depth + 1);
  out = out + ind_of(depth);
  return out + "}";
}

pub fn fmt_expr(prog: *Prog, mut cur: *CmtCur, e: *Expr,
                depth: usize) -> string {
  if e.tag == parse.EX_LIT {
    if len(e.name) > 0 {
      return e.name; // the true/false spelling the parser kept
    }
    return fmt_lit(e.lit);
  }
  if e.tag == parse.EX_VAR {
    return e.name;
  }
  if e.tag == parse.EX_STR {
    return canon_string(e.name);
  }
  if e.tag == parse.EX_FLIT {
    return fmt_flit(e.name);
  }
  if e.tag == parse.EX_MAKE {
    let mut cnt: *Expr = parse.lit(0);
    if len(e.args) > 0 {
      cnt = e.args[0];
    }
    return "make([]" + e.name + ", " +
      fmt_expr(prog, mut cur, cnt, depth) + ")";
  }
  if e.tag == parse.EX_CALL {
    let mut out: string = "";
    if len(e.name) > 0 {
      out = out + e.name;
    } else {
      // call-on-call: the callee rides the lhs (mk()(7))
      match e.lhs {
        Option.Some(b) => {
          out = out + fmt_expr(prog, mut cur, b, depth);
        },
        Option.None => {},
      }
    }
    return out + fmt_call_args(prog, mut cur, e.args, e.fnames, depth);
  }
  if e.tag == parse.EX_MCALL {
    let mut out: string = "";
    match e.lhs {
      Option.Some(b) => {
        out = out + fmt_expr(prog, mut cur, b, depth);
      },
      Option.None => {},
    }
    // explicit type arguments ride the call's name text; boot's
    // method-call spelling omits them (they are inferred)
    let mut nm: string = e.name;
    {
      let mut bi: usize = 0;
      let mut cut: i64 = 0 - 1;
      while bi < len(nm) {
        if nm[bi] == 91 {
          cut = bi as i64;
        }
        bi = bi + 1;
      }
      if cut >= 0 {
        nm = nm[0..(cut as usize)];
      }
    }
    out = out + "." + nm;
    return out + fmt_call_args(prog, mut cur, e.args, e.fnames, depth);
  }
  if e.tag == parse.EX_FIELD {
    let mut out: string = "";
    match e.lhs {
      Option.Some(b) => {
        out = out + fmt_expr(prog, mut cur, b, depth);
      },
      Option.None => {},
    }
    return out + "." + e.name;
  }
  if e.tag == parse.EX_IDX {
    let mut out: string = "";
    match e.lhs {
      Option.Some(b) => {
        out = out + fmt_expr(prog, mut cur, b, depth);
      },
      Option.None => {},
    }
    out = out + "[";
    match e.rhs {
      Option.Some(i) => {
        out = out + fmt_expr(prog, mut cur, i, depth);
      },
      Option.None => {},
    }
    return out + "]";
  }
  if e.tag == parse.EX_SLICE2 {
    let mut out: string = "";
    match e.lhs {
      Option.Some(b) => {
        out = out + fmt_expr(prog, mut cur, b, depth);
      },
      Option.None => {},
    }
    out = out + "[";
    if e.op % 2 == 1 && len(e.args) > 0 {
      out = out + fmt_expr(prog, mut cur, e.args[0], depth);
    }
    out = out + "..";
    if (e.op / 2) % 2 == 1 && len(e.args) > 1 {
      out = out + fmt_expr(prog, mut cur, e.args[1], depth);
    }
    return out + "]";
  }
  if e.tag == parse.EX_ARR {
    let mut out: string = "[";
    let mut k: usize = 0;
    while k < len(e.args) {
      if k > 0 {
        out = out + ", ";
      }
      out = out + fmt_expr(prog, mut cur, e.args[k], depth);
      k = k + 1;
    }
    return out + "]";
  }
  if e.tag == parse.EX_NEW {
    // new T { f: e, ... } — one line, boot's spacing (no padding
    // inside the braces)
    let mut out: string = "new " + e.name + " {";
    let mut k: usize = 0;
    while k < len(e.args) {
      if k > 0 {
        out = out + ", ";
      }
      if k < len(e.fnames) {
        out = out + e.fnames[k] + ": ";
      }
      out = out + fmt_expr(prog, mut cur, e.args[k], depth);
      k = k + 1;
    }
    return out + "}";
  }
  if e.tag == parse.EX_DEREF {
    let mut out: string = "*(";
    match e.lhs {
      Option.Some(b) => {
        out = out + fmt_expr(prog, mut cur, b, depth);
      },
      Option.None => {},
    }
    return out + ")";
  }
  if e.tag == parse.EX_Q {
    let mut out: string = "";
    match e.lhs {
      Option.Some(b) => {
        out = out + fmt_expr(prog, mut cur, b, depth);
      },
      Option.None => {},
    }
    return out + "?";
  }
  if e.tag == parse.EX_CLO {
    // fn(params) -> T { body } — the block rides at this depth
    let mut out: string = "fn(";
    let mut k: usize = 0;
    while k < len(e.fnames) {
      if k > 0 {
        out = out + ", ";
      }
      out = out + e.fnames[k];
      if k < len(e.args) && len(e.args[k].name) > 0 {
        out = out + ": " + e.args[k].name;
      }
      k = k + 1;
    }
    out = out + ")";
    if len(e.name) > 0 {
      out = out + " -> " + e.name;
    }
    out = out + " {";
    out = out + "\n";
    let mut body: []*Stmt = make([]*Stmt, 0);
    if len(e.marms) > 0 {
      body = e.marms[0].body;
    }
    out = out + fmt_block(prog, mut cur, body, depth + 1);
    // comments above the closure's closing brace ride at the block's
    // OUTER depth (boot's fmt_block law), anchored on the brace line
    if len(e.marms) > 0 && e.marms[0].bend > 0 {
      out = out + cmt_flush(prog, mut cur, e.marms[0].bend as i64,
                            depth);
    }
    out = out + ind_of(depth);
    return out + "}";
  }
  if e.tag == parse.EX_IF {
    // if c { arm } else { arm } — the arms are single expressions
    // riding as one-statement blocks (boot's block spelling)
    let mut out: string = "if ";
    match e.lhs {
      Option.Some(c) => {
        out = out + fmt_expr(prog, mut cur, c, depth);
      },
      Option.None => {},
    }
    out = out + " {\n";
    if len(e.args) > 0 {
      out = out + ind_of(depth + 1);
      out = out + fmt_expr(prog, mut cur, e.args[0], depth + 1);
      out = out + ";\n";
    }
    // the else arm: a nested if-expr rides inline (" else " + the
    // nested if), a plain arm rides boot's block spelling — both
    // close the then-block first (boot's fmt_block ends with its own
    // "}" before the " else" text)
    if len(e.args) > 1 {
      let els: *Expr = e.args[1];
      out = out + ind_of(depth);
      out = out + "}";
      if els.tag == parse.EX_IF {
        out = out + " else " + fmt_expr(prog, mut cur, els, depth);
        return out;
      }
      out = out + " else {\n";
      out = out + ind_of(depth + 1);
      out = out + fmt_expr(prog, mut cur, els, depth + 1);
      out = out + ";\n";
    }
    out = out + ind_of(depth);
    return out + "}";
  }
  if e.tag == parse.EX_MATCH {
    let mut scrut: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(s) => {
        scrut = s;
      },
      Option.None => {},
    }
    return fmt_match(prog, mut cur, scrut, e.marms, depth);
  }
  // EX_BIN
  if e.op == 11 {
    let mut out: string = "(";
    match e.lhs {
      Option.Some(l) => {
        out = out + fmt_expr(prog, mut cur, l, depth);
      },
      Option.None => {},
    }
    return out + " as " + e.name + ")";
  }
  if e.op == 12 {
    let mut out: string = "!(";
    match e.rhs {
      Option.Some(r) => {
        out = out + fmt_expr(prog, mut cur, r, depth);
      },
      Option.None => {},
    }
    return out + ")";
  }
  // a desugared unary minus (the parse leaves its marker in the
  // binop's lit slot) spells -(x), boot's form; a source `0 - x`
  // binop carries no marker and spells plainly
  if e.op == 1 && e.lit == 1 {
    let mut out: string = "-(";
    match e.rhs {
      Option.Some(r) => {
        out = out + fmt_expr(prog, mut cur, r, depth);
      },
      Option.None => {},
    }
    return out + ")";
  }
  if e.op == 17 {
    let mut neg1_lhs: bool = false;
    match e.lhs {
      Option.Some(l) => {
        if l.tag == parse.EX_LIT && l.lit == (0 - 1) {
          neg1_lhs = true;
        }
      },
      Option.None => {},
    }
    if neg1_lhs {
      let mut out: string = "~(";
      match e.rhs {
        Option.Some(r) => {
          out = out + fmt_expr(prog, mut cur, r, depth);
        },
        Option.None => {},
      }
      return out + ")";
    }
  }
  let mut out: string = "(";
  match e.lhs {
    Option.Some(l) => {
      out = out + fmt_expr(prog, mut cur, l, depth);
    },
    Option.None => {},
  }
  out = out + " ";
  out = out + op_spell(e.op);
  out = out + " ";
  match e.rhs {
    Option.Some(r) => {
      out = out + fmt_expr(prog, mut cur, r, depth);
    },
    Option.None => {},
  }
  return out + ")";
}

// ---- the comment replay (boot's fmt.c law: fmt may not drop a
// comment) ---- the cursor walks the Prog's comment table in source
// order; flush prints everything above a line at the current indent,
// and a comment on a construct's own last line rides as its trailing
// note. The monotonic cursor mirrors boot's g_ci.
pub struct CmtCur {
  i: usize,
}

fn cmt_flush(prog: *Prog, mut cur: *CmtCur, before_line: i64,
             depth: usize) -> string {
  let mut out: string = "";
  let ind: string = ind_of(depth);
  while cur.i < prog.ncmts && prog.clines[cur.i] < before_line {
    out = out + ind + prog.ctexts[cur.i] + "\n";
    cur.i = cur.i + 1;
  }
  return out;
}

// the block's last replay line: its final statement's end (an empty
// block has nothing riding above its closer) — kept for callers that
// have no stamped brace line
fn block_end(nodes: []*Stmt) -> i64 {
  if len(nodes) == 0 {
    return 0 - 1;
  }
  return nodes[len(nodes) - 1].end_line as i64;
}

pub fn fmt_line(prog: *Prog, mut cur: *CmtCur, st: *Stmt,
                depth: usize) -> string {
  let ind: string = ind_of(depth);
  if st.tag == parse.ST_LET {
    let mut out: string = ind + "let ";
    if st.ret == 1 {
      out = out + "mut ";
    }
    out = out + st.name;
    if len(st.fmt) > 0 {
      out = out + ": ";
      out = out + st.fmt;
    }
    out = out + " = ";
    match st.val {
      Option.Some(e) => {
        // a literal under an unsigned declared type spells its u64
        // bits (the lexer wrapped the token in place)
        if e.tag == parse.EX_LIT && len(e.name) == 0 && e.lit < 0 &&
            is_unsigned_type(st.fmt) {
          out = out + fmt_ulit(e.lit);
        } else {
          out = out + fmt_expr(prog, mut cur, e, depth);
        }
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_PF {
    let mut out: string = ind + "printf(" + canon_string(st.fmt);
    let mut k: usize = 0;
    while k < len(st.args) {
      out = out + ", ";
      out = out + fmt_expr(prog, mut cur, st.args[k], depth);
      k = k + 1;
    }
    return out + ");\n";
  }
  if st.tag == parse.ST_RET {
    let mut out: string = ind + "return";
    match st.val {
      Option.Some(e) => {
        out = out + " ";
        out = out + fmt_expr(prog, mut cur, e, depth);
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_SET {
    if len(st.fmt) > 1 {
      // a compound: name OP= rhs (the desugar's inner rhs is the text)
      let mut rhs: *Expr = parse.lit(0);
      match st.val {
        Option.Some(b) => {
          match b.rhs {
            Option.Some(r) => {
              rhs = r;
            },
            Option.None => {},
          }
        },
        Option.None => {},
      }
      return ind + st.name + " " + st.fmt + " " +
        fmt_expr(prog, mut cur, rhs, depth) + ";\n";
    }
    let mut out: string = ind + st.name + " = ";
    match st.val {
      Option.Some(e) => {
        out = out + fmt_expr(prog, mut cur, e, depth);
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_ISTORE {
    let mut out: string = ind + st.name + "[";
    if len(st.args) > 0 {
      out = out + fmt_expr(prog, mut cur, st.args[0], depth);
    }
    out = out + "] = ";
    match st.val {
      Option.Some(e) => {
        out = out + fmt_expr(prog, mut cur, e, depth);
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_FSTORE {
    // base.f... / base.f[i] / base[i].f — the lvalue rebuilds from
    // the store's path (and its index; ret == 1 marks index-first)
    let mut lval: string = st.name;
    if st.ret == 1 {
      if len(st.args) > 0 {
        lval = lval + "[" + fmt_expr(prog, mut cur, st.args[0], depth) +
          "]";
      }
      let mut j: usize = 0;
      while j < len(st.path) {
        lval = lval + "." + st.path[j];
        j = j + 1;
      }
    } else {
      let mut j: usize = 0;
      while j < len(st.path) {
        lval = lval + "." + st.path[j];
        j = j + 1;
      }
      if len(st.args) > 0 {
        lval = lval + "[" + fmt_expr(prog, mut cur, st.args[0], depth) +
          "]";
      }
    }
    if len(st.fmt) > 1 {
      let mut rhs: *Expr = parse.lit(0);
      match st.val {
        Option.Some(b) => {
          match b.rhs {
            Option.Some(r) => {
              rhs = r;
            },
            Option.None => {},
          }
        },
        Option.None => {},
      }
      return ind + lval + " " + st.fmt + " " +
        fmt_expr(prog, mut cur, rhs, depth) + ";\n";
    }
    let mut out: string = ind + lval + " = ";
    match st.val {
      Option.Some(e) => {
        out = out + fmt_expr(prog, mut cur, e, depth);
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_CALL {
    let mut out: string = ind;
    match st.val {
      Option.Some(e) => {
        out = out + fmt_expr(prog, mut cur, e, depth);
      },
      Option.None => {},
    }
    // an if-chain wrapped as a statement keeps boot's bare brace (the
    // statement match's law: no trailing semicolon on a construct)
    match st.val {
      Option.Some(e) => {
        if e.tag == parse.EX_IF {
          return out + "\n";
        }
      },
      Option.None => {},
    }
    return out + ";\n";
  }
  if st.tag == parse.ST_MATCH {
    // the statement match shares the expression form's spelling and
    // takes no trailing semicolon (boot's law)
    let mut out: string = ind;
    match st.val {
      Option.Some(s) => {
        out = out + fmt_match(prog, mut cur, s, st.marms, depth);
      },
      Option.None => {},
    }
    return out + "\n";
  }
  if st.tag == parse.ST_BLOCK {
    // a bare block statement rides fmt_block's own " {" opener —
    // boot's spelling carries the space (n12: "   {" at depth 1)
    let mut out: string = ind + " {\n";
    out = out + fmt_block(prog, mut cur, st.body, depth + 1);
    if st.bend > 0 {
      out = out + cmt_flush(prog, mut cur, st.bend as i64, depth);
    }
    return out + ind + "}\n";
  }
  if st.tag == parse.ST_IF {
    let mut out: string = ind;
    if len(st.name) > 0 {
      out = out + st.name;
      out = out + ": ";
    }
    out = out + "if ";
    match st.val {
      Option.Some(c) => {
        out = out + fmt_expr(prog, mut cur, c, depth);
      },
      Option.None => {},
    }
    out = out + " {\n";
    out = out + fmt_block(prog, mut cur, st.body, depth + 1);
    if st.bend > 0 {
      out = out + cmt_flush(prog, mut cur, st.bend as i64, depth);
    }
    out = out + ind;
    out = out + "}";
    // else-if chains ride inline; a plain else takes one space
    let mut tail: []*Stmt = st.body2;
    let mut d: usize = depth;
    let mut bend2: i64 = st.bend2 as i64;
    while len(tail) == 1 && tail[0].tag == parse.ST_IF {
      let nx = tail[0];
      out = out + " else ";
      if len(nx.name) > 0 {
        out = out + nx.name;
        out = out + ": ";
      }
      out = out + "if ";
      match nx.val {
        Option.Some(c) => {
          out = out + fmt_expr(prog, mut cur, c, d);
        },
        Option.None => {},
      }
      out = out + " {\n";
      out = out + fmt_block(prog, mut cur, nx.body, d + 1);
      if nx.bend > 0 {
        out = out + cmt_flush(prog, mut cur, nx.bend as i64, d);
      }
      out = out + ind_of(d);
      out = out + "}";
      tail = nx.body2;
      bend2 = nx.bend2 as i64;
    }
    if len(tail) > 0 {
      out = out + " else {\n";
      out = out + fmt_block(prog, mut cur, tail, depth + 1);
      if bend2 > 0 {
        out = out + cmt_flush(prog, mut cur, bend2, depth);
      }
      out = out + ind;
      out = out + "}";
    }
    return out + "\n";
  }
  if st.tag == parse.ST_WHILE {
    let mut out: string = ind;
    if len(st.name) > 0 {
      out = out + st.name;
      out = out + ": ";
    }
    out = out + "while ";
    match st.val {
      Option.Some(c) => {
        out = out + fmt_expr(prog, mut cur, c, depth);
      },
      Option.None => {},
    }
    out = out + " {\n";
    out = out + fmt_block(prog, mut cur, st.body, depth + 1);
    if st.bend > 0 {
      out = out + cmt_flush(prog, mut cur, st.bend as i64, depth);
    }
    return out + ind + "}\n";
  }
  if st.tag == parse.ST_LOOP {
    let mut out: string = ind;
    if len(st.name) > 0 {
      out = out + st.name;
      out = out + ": ";
    }
    out = out + "loop {\n";
    out = out + fmt_block(prog, mut cur, st.body, depth + 1);
    if st.bend > 0 {
      out = out + cmt_flush(prog, mut cur, st.bend as i64, depth);
    }
    return out + ind + "}\n";
  }
  if st.tag == parse.ST_BREAK {
    if len(st.name) > 0 {
      return ind + "break " + st.name + ";\n";
    }
    return ind + "break;\n";
  }
  if st.tag == parse.ST_CONT {
    if len(st.name) > 0 {
      return ind + "continue " + st.name + ";\n";
    }
    return ind + "continue;\n";
  }
  if st.tag == parse.ST_DEFER {
    match st.sub {
      Option.Some(inner) => {
        let inner_text: string = fmt_line(prog, mut cur, inner, 0);
        // the inner carries its own newline; swap its indent for the
        // defer prefix on the first line
        let mut body: string = inner_text;
        let mut k: usize = 0;
        while k < len(body) && body[k] == 32 {
          k = k + 1;
        }
        return ind + "defer " + body[k..len(body)];
      },
      Option.None => {},
    }
    return ind + "defer;\n";
  }
  return ind + "\n";
}

pub fn fmt_block(prog: *Prog, mut cur: *CmtCur, nodes: []*Stmt,
                 depth: usize) -> string {
  let mut out: string = "";
  let mut i: usize = 0;
  while i < len(nodes) {
    let st: *Stmt = nodes[i];
    // comments above the statement print at this depth
    out = out + cmt_flush(prog, mut cur, st.line as i64, depth);
    let mut line: string = fmt_line(prog, mut cur, st, depth);
    // a comment on the statement's own last line rides as a
    // trailing note: back over the newline, append, restore
    if st.end_line > 0 && cur.i < prog.ncmts &&
        prog.clines[cur.i] == (st.end_line as i64) {
      let cut: usize = len(line) - 1;
      line = line[0..cut] + "  " + prog.ctexts[cur.i] + "\n";
      cur.i = cur.i + 1;
    }
    out = out + line;
    i = i + 1;
  }
  return out;
}

// ---- declarations ----

// one fn's parameter list: mut views, the receiver's derived
// annotation dropped on a dotted method (recv = the receiver type),
// variadic rest — shared by the plain-fn and impl-member spellings
fn fn_params_text(fd: *FnDef, recv: string) -> string {
  let mut out: string = "(";
  let mut k: usize = 0;
  while k < len(fd.params) {
    if k > 0 {
      out = out + ", ";
    }
    if k < len(fd.pmut) && fd.pmut[k] {
      out = out + "mut ";
    }
    let mut annotated: bool = k < len(fd.ptypes) && len(fd.ptypes[k]) > 0;
    if k == 0 && fd.params[k] == "self" && len(recv) > 0 && annotated {
      // the pointer receiver rides bare; the value receiver keeps
      // its annotation (boot's derivation law)
      let pt: string = fd.ptypes[0];
      if pt == ("*" + recv) {
        annotated = false;
      }
    }
    if annotated {
      let mut st: string = fd.ptypes[k];
      if k < len(fd.pvar) && fd.pvar[k] && len(st) >= 2 &&
          st[0..2] == "[]" {
        // the variadic's slice spelling desugars — boot spells the
        // element form: ns: i64...
        st = st[2..];
      }
      out = out + fd.params[k] + ": " + st;
    } else {
      out = out + fd.params[k];
    }
    if k < len(fd.pvar) && fd.pvar[k] {
      out = out + "...";
    }
    k = k + 1;
  }
  return out + ")";
}

// one impl member: boot's NT_IMPL arm prints the BARE method name
// (the receiver derivation homes on the impl target) and the body
// block at the impl's depth
fn fmt_impl_member(prog: *Prog, mut cur: *CmtCur, fd: *FnDef,
                   irecv: string) -> string {
  let mut nm: string = fd.name;
  {
    let mut di: usize = 0;
    let mut dot: i64 = 0 - 1;
    while di < len(nm) {
      if nm[di] == 46 {
        dot = di as i64;
      }
      di = di + 1;
    }
    if dot >= 0 {
      nm = nm[(dot as usize + 1)..len(nm)];
    }
  }
  let mut out: string = "fn " + nm;
  out = out + fn_params_text(fd, irecv);
  if len(fd.rtype) > 0 {
    out = out + " -> ";
    out = out + fd.rtype;
  }
  out = out + " {\n";
  out = out + fmt_block(prog, mut cur, fd.body, 2);
  if fd.end_line > 0 {
    // the body block's outer depth is the impl's member depth
    out = out + cmt_flush(prog, mut cur, fd.end_line as i64, 1);
  }
  out = out + "  }";
  // a same-line note rides the member's closing brace (boot's
  // cmt_tail: the newline follows after)
  if fd.end_line > 0 && cur.i < prog.ncmts &&
      prog.clines[cur.i] == (fd.end_line as i64) {
    out = out + "  " + prog.ctexts[cur.i];
    cur.i = cur.i + 1;
  }
  return out + "\n";
}

// one fn: pub, generics, params (mut views, the receiver's derived
// annotation dropped on a dotted method, variadic rest), arrow, body
fn fmt_fn(prog: *Prog, mut cur: *CmtCur, fd: *FnDef) -> string {
  let mut out: string = "";
  if fd.ispub {
    out = out + "pub ";
  }
  out = out + "fn " + fd.name;
  if len(fd.tparams) > 0 {
    out = out + "[";
    let mut g: usize = 0;
    while g < len(fd.tparams) {
      if g > 0 {
        out = out + ", ";
      }
      out = out + fd.tparams[g];
      g = g + 1;
    }
    out = out + "]";
  }
  out = out + "(";
  // a dotted method's receiver annotation is redundant when it spells
  // the derived form: *Recv or Recv itself (boot's derivation law)
  let mut recv: string = "";
  let mut dot: i64 = 0 - 1;
  let mut di: usize = 0;
  while di < len(fd.name) {
    if fd.name[di] == 46 {
      dot = di as i64;
    }
    di = di + 1;
  }
  if dot >= 0 {
    recv = fd.name[0..(dot as usize)];
  }
  let mut k: usize = 0;
  while k < len(fd.params) {
    if k > 0 {
      out = out + ", ";
    }
    if k < len(fd.pmut) && fd.pmut[k] {
      out = out + "mut ";
    }
    let mut annotated: bool = k < len(fd.ptypes) && len(fd.ptypes[k]) > 0;
    if k == 0 && fd.params[k] == "self" && len(recv) > 0 && annotated {
      // the pointer receiver rides bare; the value receiver keeps
      // its annotation (boot's derivation law)
      let pt: string = fd.ptypes[0];
      if pt == ("*" + recv) {
        annotated = false;
      }
    }
    if annotated {
      let mut st: string = fd.ptypes[k];
      if k < len(fd.pvar) && fd.pvar[k] && len(st) >= 2 &&
          st[0..2] == "[]" {
        // the variadic's slice spelling desugars — boot spells the
        // element form: ns: i64...
        st = st[2..];
      }
      out = out + fd.params[k] + ": " + st;
    } else {
      out = out + fd.params[k];
    }
    if k < len(fd.pvar) && fd.pvar[k] {
      out = out + "...";
    }
    k = k + 1;
  }
  out = out + ")";
  if len(fd.rtype) > 0 {
    out = out + " -> ";
    out = out + fd.rtype;
  }
  out = out + " {\n";
  out = out + fmt_block(prog, mut cur, fd.body, 1);
  // comments above the body's closing brace print at the block's
  // OUTER depth (boot's fmt_block flushes after its depth drop)
  if fd.end_line > 0 {
    out = out + cmt_flush(prog, mut cur, fd.end_line as i64, 0);
  }
  out = out + "}\n";
  // a same-line note rides the closing brace (boot's tail_back:
  // back over the newline, append, restore)
  if fd.end_line > 0 && cur.i < prog.ncmts &&
      prog.clines[cur.i] == (fd.end_line as i64) {
    let cut: usize = len(out) - 1;
    out = out[0..cut] + "  " + prog.ctexts[cur.i] + "\n";
    cur.i = cur.i + 1;
  }
  return out;
}

fn fmt_use(u: usize, prog: *Prog) -> string {
  let mut out: string = "";
  if u < prog.nuses && prog.usepub[u] {
    out = out + "pub ";
  }
  out = out + "use " + prog.usepath[u];
  if u < prog.nuses && len(prog.usealias[u]) > 0 {
    out = out + " as " + prog.usealias[u];
  }
  return out + ";\n\n";
}

fn fmt_trait(td: *TraitDef) -> string {
  let mut out: string = "trait " + td.name + " {\n";
  let mut k: usize = 0;
  while k < len(td.methods) {
    out = out + "  fn " + td.methods[k] + "(self)";
    if k < len(td.rtypes) && len(td.rtypes[k]) > 0 {
      out = out + " -> " + td.rtypes[k];
    }
    out = out + ",\n";
    k = k + 1;
  }
  return out + "}\n\n";
}

fn fmt_struct(sd: *StructDef) -> string {
  let mut out: string = "struct " + sd.name;
  if len(sd.tparams) > 0 {
    out = out + "[";
    let mut g: usize = 0;
    while g < len(sd.tparams) {
      if g > 0 {
        out = out + ", ";
      }
      out = out + sd.tparams[g];
      g = g + 1;
    }
    out = out + "]";
  }
  out = out + " {\n";
  let mut k: usize = 0;
  while k < len(sd.fields) {
    out = out + "  " + sd.fields[k] + ": " + sd.types[k] + ",\n";
    k = k + 1;
  }
  return out + "}\n\n";
}

fn fmt_enum(ed: *EnumDef) -> string {
  let mut out: string = "enum " + ed.name;
  if len(ed.tparams) > 0 {
    out = out + "[";
    let mut g: usize = 0;
    while g < len(ed.tparams) {
      if g > 0 {
        out = out + ", ";
      }
      out = out + ed.tparams[g];
      g = g + 1;
    }
    out = out + "]";
  }
  out = out + " {\n";
  let mut v: usize = 0;
  while v < ed.nv {
    out = out + "  " + ed.vnames[v];
    let nsl: usize = ed.vslots[v] as usize;
    // the form rides the field-name pool: a struct-form payload
    // spells its names one per line, a tuple payload keeps the
    // parenthesized type list
    let mut struct_form: bool = false;
    {
      let mut p: usize = 0;
      while p < nsl {
        if len(ed.vnpool[v * 8 + p]) > 0 {
          struct_form = true;
        }
        p = p + 1;
      }
    }
    if struct_form {
      out = out + " {\n";
      let mut p: usize = 0;
      while p < nsl {
        out = out + "    " + ed.vnpool[v * 8 + p] + ": " +
            ed.vtpool[v * 8 + p] + ",\n";
        p = p + 1;
      }
      out = out + "  }";
    } else {
      if nsl > 0 {
        out = out + "(";
        let mut p: usize = 0;
        while p < nsl {
          if p > 0 {
            out = out + ", ";
          }
          let t: string = ed.vtpool[v * 8 + p];
          if len(t) > 0 {
            out = out + t;
          } else {
            out = out + "i64";
          }
          p = p + 1;
        }
        out = out + ")";
      }
    }
    out = out + ",\n";
    v = v + 1;
  }
  return out + "}\n\n";
}

// the first lined declaration's line — the replay anchor for the
// header comments above a lineless first declaration (uses, structs,
// enums, traits carry no lines of their own)
fn first_lined_line(prog: *Prog) -> i64 {
  let mut best: i64 = 2147483647;
  let mut c: usize = 0;
  while c < prog.nconsts {
    if prog.cline[c] > 0 && prog.cline[c] < best {
      best = prog.cline[c];
    }
    c = c + 1;
  }
  let mut f: usize = 0;
  while f < len(prog.fns) {
    if prog.fns[f].line > 0 && (prog.fns[f].line as i64) < best {
      best = prog.fns[f].line as i64;
    }
    f = f + 1;
  }
  if len(prog.main) > 0 && prog.main[0].line > 0 &&
      (prog.main[0].line as i64) < best {
    best = prog.main[0].line as i64;
  }
  return best;
}

pub fn fmt_prog(prog: *Prog) -> string {
  let mut cur = new CmtCur { i: 0 };
  let mut out: string = "";
  // the earliest declaration's line anchors the file header (every
  // decl table carries its keyword's line; uses ride the top block)
  let mut firstd: i64 = 2147483647;
  {
    let mut c0: usize = 0;
    while c0 < prog.nconsts {
      if prog.cline[c0] < firstd {
        firstd = prog.cline[c0];
      }
      c0 = c0 + 1;
    }
    let mut s0: usize = 0;
    while s0 < len(prog.structs) {
      if (prog.structs[s0].line as i64) < firstd {
        firstd = prog.structs[s0].line as i64;
      }
      s0 = s0 + 1;
    }
    let mut e0: usize = 0;
    while e0 < len(prog.enums) {
      if (prog.enums[e0].line as i64) < firstd {
        firstd = prog.enums[e0].line as i64;
      }
      e0 = e0 + 1;
    }
    let mut t0: usize = 0;
    while t0 < len(prog.traits) {
      if (prog.traits[t0].line as i64) < firstd {
        firstd = prog.traits[t0].line as i64;
      }
      t0 = t0 + 1;
    }
    let mut f0: usize = 0;
    while f0 < len(prog.fns) {
      if (prog.fns[f0].line as i64) < firstd {
        firstd = prog.fns[f0].line as i64;
      }
      f0 = f0 + 1;
    }
    // main is a decl in boot's table — on a main-only program it is
    // the ONLY anchor: without it the header flush runs at INT_MAX
    // and swallows every comment in the file in one gulp
    if prog.mainline > 0 {
      if (prog.mainline as i64) < firstd {
        firstd = prog.mainline as i64;
      }
    } else {
      if len(prog.main) > 0 && prog.main[0].line > 0 &&
          (prog.main[0].line as i64) < firstd {
        firstd = prog.main[0].line as i64;
      }
    }
    let mut i0: usize = 0;
    while i0 < prog.nimpls {
      if prog.ilines[i0] < firstd {
        firstd = prog.ilines[i0];
      }
      i0 = i0 + 1;
    }
  }
  out = out + cmt_flush(prog, mut cur, firstd, 0);
  let mut u: usize = 0;
  while u < prog.nuses {
    out = out + fmt_use(u, prog);
    u = u + 1;
  }
  // main is a decl in boot's table: it merges by its keyword's line
  // like everything else (fns AFTER main must print AFTER it), and
  // the file tail's comments flush after its closing brace
  let mut mainline: i64 = 2147483647;
  if prog.mainline > 0 {
    // the fn main keyword's line — comments above it are main's own
    // leading comments; body comments ride their statements inside
    mainline = prog.mainline as i64;
  } else if len(prog.main) > 0 {
    mainline = prog.main[0].line as i64;
  }
  let mainend: i64 = prog.mainend as i64;
  let mut maindone: bool = len(prog.main) == 0;
  // every declaration after the uses renders in source order: at each
  // step the earliest-line unrendered decl wins
  let mut cc: usize = 0;
  let mut sc: usize = 0;
  let mut ec: usize = 0;
  let mut tc: usize = 0;
  let mut ic: usize = 0;
  let mut fc: usize = 0;
  while cc < prog.nconsts || sc < len(prog.structs) ||
        ec < len(prog.enums) || tc < len(prog.traits) ||
        ic < prog.nimpls || fc < len(prog.fns) || !maindone {
    let mut best: i64 = 2147483647;
    if cc < prog.nconsts && prog.cline[cc] < best {
      best = prog.cline[cc];
    }
    if sc < len(prog.structs) && (prog.structs[sc].line as i64) < best {
      best = prog.structs[sc].line as i64;
    }
    if ec < len(prog.enums) && (prog.enums[ec].line as i64) < best {
      best = prog.enums[ec].line as i64;
    }
    if tc < len(prog.traits) && (prog.traits[tc].line as i64) < best {
      best = prog.traits[tc].line as i64;
    }
    if ic < prog.nimpls && prog.ilines[ic] < best {
      best = prog.ilines[ic];
    }
    if fc < len(prog.fns) && (prog.fimpl[fc] < 0) &&
        (prog.fns[fc].line as i64) < best {
      best = prog.fns[fc].line as i64;
    }
    if !maindone && mainline < best {
      best = mainline;
    }
    if cc < prog.nconsts && prog.cline[cc] == best {
      // comments above this const print at file depth
      out = out + cmt_flush(prog, mut cur, best, 0);
      let mut ct: string = "";
      if prog.cstatic[cc] {
        ct = ct + "static ";
        if prog.cmuts[cc] {
          ct = ct + "mut ";
        }
        ct = ct + prog.consts[cc];
      } else {
        ct = ct + "const ";
        ct = ct + prog.consts[cc];
      }
      if len(prog.ctypes[cc]) > 0 {
        ct = ct + ": ";
        ct = ct + prog.ctypes[cc];
      }
      // a literal init under an unsigned declared type spells its u64
      // bits (the lexer wrapped the token in place)
      let ie: *Expr = prog.cexprs[cc];
      if ie.tag == parse.EX_LIT && len(ie.name) == 0 && ie.lit < 0 &&
          is_unsigned_type(prog.ctypes[cc]) {
        ct = ct + " = " + fmt_ulit(ie.lit) + ";\n\n";
      } else {
        ct = ct + " = " + fmt_expr(prog, mut cur, ie, 0) + ";\n\n";
      }
      // a same-line note rides on the NEXT line, indented, and takes
      // the blank separator's place (boot's decl tail: the comment
      // leads the next construct's air)
      if prog.clend[cc] > 0 && cur.i < prog.ncmts &&
          prog.clines[cur.i] == prog.clend[cc] {
        let cut: usize = len(ct) - 1;
        ct = ct[0..cut] + "  " + prog.ctexts[cur.i] + "\n";
        cur.i = cur.i + 1;
      }
      out = out + ct;
      cc = cc + 1;
    }
    if sc < len(prog.structs) && (prog.structs[sc].line as i64) == best {
      out = out + cmt_flush(prog, mut cur, best, 0);
      out = out + fmt_struct(prog.structs[sc]);
      sc = sc + 1;
    }
    if ec < len(prog.enums) && (prog.enums[ec].line as i64) == best {
      out = out + cmt_flush(prog, mut cur, best, 0);
      out = out + fmt_enum(prog.enums[ec]);
      ec = ec + 1;
    }
    if tc < len(prog.traits) && (prog.traits[tc].line as i64) == best {
      out = out + cmt_flush(prog, mut cur, best, 0);
      out = out + fmt_trait(prog.traits[tc]);
      tc = tc + 1;
    }
    if ic < prog.nimpls && prog.ilines[ic] == best {
      // the impl decl: header, then its member fns at depth 1 (boot's
      // NT_IMPL arm; the receiver derivation homes on the impl target)
      out = out + cmt_flush(prog, mut cur, best, 0);
      out = out + "impl " + prog.itraits[ic] + " for " +
        prog.itypes[ic] + " {\n";
      let mut m: usize = 0;
      while m < len(prog.fns) {
        if prog.fimpl[m] == (ic as i64) {
          out = out + "  " +
            fmt_impl_member(prog, mut cur, prog.fns[m],
                            prog.itypes[ic]);
        }
        m = m + 1;
      }
      // the members never take the fn branch (their fimpl >= 0):
      // walk fc past them or the merge loop spins forever
      while fc < len(prog.fns) && prog.fimpl[fc] == (ic as i64) {
        fc = fc + 1;
      }
      out = out + "}\n\n";
      ic = ic + 1;
    }
    if fc < len(prog.fns) && (prog.fimpl[fc] < 0) &&
        (prog.fns[fc].line as i64) == best {
      // comments above this fn print at file depth
      out = out + cmt_flush(prog, mut cur, best, 0);
      out = out + fmt_fn(prog, mut cur, prog.fns[fc]);
      fc = fc + 1;
    }
    if !maindone && mainline == best {
      out = out + cmt_flush(prog, mut cur, mainline, 0);
      out = out + "fn main() -> i32 {\n" +
            fmt_block(prog, mut cur, prog.main, 1);
      // comments above main's closing brace ride at the block's outer
      // depth (boot's block-close law), anchored on the brace line
      if mainend > 0 {
        out = out + cmt_flush(prog, mut cur, mainend, 0);
      }
      out = out + "}\n";
      // a same-line note rides main's closing brace (boot's
      // tail_back: back over the newline, append, restore)
      if mainend > 0 && cur.i < prog.ncmts &&
          prog.clines[cur.i] == mainend {
        let cut: usize = len(out) - 1;
        out = out[0..cut] + "  " + prog.ctexts[cur.i] + "\n";
        cur.i = cur.i + 1;
      }
      maindone = true;
    }
  }
  return out + cmt_flush(prog, mut cur, 2147483647, 0);
}
