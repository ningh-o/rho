// main.rho — the self-hosted compiler's root (T2.1 skeleton, growing).
// Source arrives as the SRC build parameter (§7: root consts are
// ordinary consts; --set overrides any text-formed type); the WAT
// goes to stdout:
//   rho build libs/compiler/main.rho -o rho.wasm --set SRC='…'
//   wasmtime rho.wasm | wat2wasm -o out.wasm -
// Subset today: fn main + user fns (i64 params/returns — string
// parameters need a pair-passing ABI, next), printf over folded
// strings and integer expressions, let/assignment (i64 + folded
// strings), while/if/else-if, comparisons, len() over strings.
use lex;
use parse;
use check;
use emit;
use fmt;
use std.io;

const SRC: string = "fn main() -> i32 { printf(\"hello, self\\n\"); return 0; }";
const MODS: string = ""; // the module tree: "@MOD@ <path>\n<text>" blocks
const FMT: i64 = 0; // 1 = print the canonical formatting instead
// the app face's module tree (the site's artifact bakes the std tree
// here; the chain's own build leaves it empty)
const MODS_APP: string = "";

// the app face (the site's playground and corpus): the host writes
// the source to /main.rho and the verb to /mode ("build" default,
// "check", "fmt"); the module tree rides MODS_APP. Absent files →
// the baked self-compile path (§7's chain law stays untouched).
fn app_compile(src: string) -> i32 {
  let mut mode: string = "build";
  match io.read_file("/mode") {
    Result.Ok(m) => {
      mode = m;
    },
    Result.Err(_) => {},
  }
  let lx = lex.scan(src);
  let mut prog: *Prog = parse.parse_full(lx.toks, src, lx.ctexts,
                                         lx.clines);
  if prog.perrs > 0 {
    eprintf("parse: {} unresolved form(s)\n", prog.perrs);
    return 1;
  }
  // fmt is syntax-level law: it formats whatever parses, no semantic
  // checks, and it renders before any module load touches the tables
  // (the file alone — the module tree is not the file's text). build
  // and check run the checker.
  if mode == "fmt" {
    let text: string = fmt.fmt_prog(prog);
    let mut off0: usize = 0;
    while off0 < len(text) {
      let mut end0: usize = off0 + 512;
      if end0 > len(text) {
        end0 = len(text);
      }
      printf("{}", text[off0..end0]);
      off0 = end0;
    }
    return 0;
  }
  if len(MODS_APP) > 0 && !parse.load_mods(mut prog, MODS_APP) {
    eprintf("mods: unresolved module path(s)\n");
    return 1;
  }
  if prog.perrs > 0 {
    eprintf("parse: {} unresolved form(s)\n", prog.perrs);
    return 1;
  }
  let mut errs: i64 = check.check(prog);
  if errs > 0 {
    eprintf("check: {} error(s)\n", errs);
    return 1;
  }
  if mode == "check" {
    return 0;
  }
  let mut text: string = emit.emit(mut prog);
  let mut off: usize = 0;
  while off < len(text) {
    let mut end: usize = off + 512;
    if end > len(text) {
      end = len(text);
    }
    printf("{}", text[off..end]);
    off = end;
  }
  return 0;
}

fn main() -> i32 {
  // the app face: the host's /main.rho wins; absent → the baked
  // self-compile
  match io.read_file("/main.rho") {
    Result.Ok(src) => {
      return app_compile(src);
    },
    Result.Err(_) => {},
  }
  // the FMT face lexes through scan(): the formatter replays the
  // file's comments, so the Prog must carry the comment tables
  let lx = lex.scan(SRC);
  let mut prog: *Prog = parse.parse_full(lx.toks, SRC, lx.ctexts,
                                         lx.clines);
  if prog.perrs > 0 {
    eprintf("parse: {} unresolved form(s)\n", prog.perrs);
    return 1;
  }
  // the chain law: our own root consts ride the same parameters into
  // the compiled program — the child's SRC/MODS are ours (§7)
  parse.override_root_str(mut prog, "SRC", SRC);
  parse.override_root_str(mut prog, "MODS", MODS);
  // fmt is syntax-level law here too (boot's fmt checks nothing), and
  // it renders before any module load touches the tables — the file
  // alone, module tree or not
  if FMT == 1 {
    let text: string = fmt.fmt_prog(prog);
    let mut off0: usize = 0;
    while off0 < len(text) {
      let mut end0: usize = off0 + 512;
      if end0 > len(text) {
        end0 = len(text);
      }
      printf("{}", text[off0..end0]);
      off0 = end0;
    }
    return 0;
  }
  if !parse.load_mods(mut prog, MODS) {
    eprintf("mods: unresolved module path(s)\n");
    return 1;
  }
  if prog.perrs > 0 {
    eprintf("parse: {} unresolved form(s)\n", prog.perrs);
    return 1;
  }
  let mut errs: i64 = check.check(prog);
  if errs > 0 {
    eprintf("check: {} error(s)\n", errs);
    return 1;
  }
  let wat: string = emit.emit(mut prog);
  // stream in slices: the format scratch is bounded, programs are not
  let mut off: usize = 0;
  while off < len(wat) {
    let mut end: usize = off + 512;
    if end > len(wat) {
      end = len(wat);
    }
    printf("{}", wat[off..end]);
    off = end;
  }
  return 0;
}
