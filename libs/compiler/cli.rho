// cli.rho — the compiler package's root: host helpers, diagnostics, the
// CLI driver, and (since the roots merged) `main` itself. One root for
// every configuration: the root const `native` (true by default — the
// full toolchain is the default build) gates the native pipe and its six
// backend modules behind a comptime fold. `--set native=false` compiles
// the web configuration: reachability drops the backends from the
// artifact and a native target refuses with the same clear error boot
// gives (exit 2). The former web.rho/full.rho pair is retired.
use parse;
use prelude_src;
use check;
use ir;
use lower;
use opt;
use emit_wasm;
use fmt;
use native.pipe;

// build parameters (spec §7.2): root consts ARE build parameters, and
// `--set` overrides them. Full capability is the default.
const native: bool = true;

// rho — the self-hosted compiler (0.3.0 era; see docs/todo.md for the mirror).
//
// One file, one module: the whole compiler, written in the frozen 0.0.5
// language surface. Bootstrap invariant (spec §13): boot(self) == self(self)
// byte for byte, and boot(corpus) == self(corpus).
//
// Host IO rides the prelude's per-target hooks (__open/__read/__write/
// __close/__program_args/__can_spawn): over wasi_snapshot_preview1 on wasm,
// over the RT blob's syscall shims in freestanding images — the mirror's
// own externs moved off libSystem with the 0.3.2 image layer.

fn main() -> i32 {
  let rc: i32 = run();
  if native {
    if rc == RC_NATIVE {
      return pipe.pipe_emit(g_req_target, g_req_out);
    }
    return rc;
  }
  // the web configuration's native refusal — the else side of the fold,
  // the same clear-error law boot uses
  if rc == RC_NATIVE {
    eprintf("{}", "rho: native backends are not linked in this build (the web compiler emits wasm32-wasi only)\n");
    return 2;
  }
  return rc;
}

fn program_args() -> []string {
  return __program_args();
}

// read a NUL-terminated C string out of foreign memory
fn str_from_c(p: *u8) -> string {
  let mut n: usize = 0;
  loop {
    if intrinsics.load_u8((p as usize + n) as *u8) == 0 {
      break;
    }
    n += 1;
  }
  let buf: []u8 = make([]u8, n);
  let mut i: usize = 0;
  while i < n {
    buf[i] = intrinsics.load_u8((p as usize + i) as *u8);
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

// ---------------------------------------------------------------- bytes ---

// NUL-terminated copy for extern calls; returns the owning slice so the
// buffer outlives the call — a raw *u8 would dangle the moment this returns
fn cstr(s: string) -> []u8 {
  let buf: []u8 = make([]u8, len(s) + 1);
  let mut i: usize = 0;
  while i < len(s) {
    buf[i] = s[i];
    i += 1;
  }
  buf[len(s)] = 0;
  return buf;
}

pub fn itoa(v: i64) -> string {
  let buf: []u8 = make([]u8, 24);
  let mut n: usize = 24;
  // the magnitude as u64: `0 - v` wraps for i64 MIN (the only value whose
  // negation overflows), which the u64 lane absorbs — the old i64 lane
  // negated MIN back into itself and emitted garbage bytes (a comma among
  // them, which split a movabsq immediate mid-number in the asm86 feed)
  let neg: bool = v < 0;
  let mut x: u64 = if neg { (0 - v) as u64 } else { v as u64 };
  loop {
    n -= 1;
    buf[n] = (48 + (x % 10) as i64) as u8;
    x /= 10;
    if x == 0 {
      break;
    }
  }
  if neg {
    n -= 1;
    buf[n] = 45;
  }
  return intrinsics.slice_string(buf[n..24]);
}

// ---------------------------------------------------------------- vec ---

pub struct Vec[T] {
  items: []T,
  n: usize,
}

fn Vec.init(self: *Vec) {
  self.items = make([]T, 8);
  self.n = 0;
}

// growth through a helper: ownership transfers at the call boundary, which
// the rc machinery accounts cleanly
fn grow_to[T](items: []T) -> []T {
  let grown: []T = make([]T, len(items) * 2);
  let mut i: usize = 0;
  while i < len(items) {
    grown[i] = items[i];
    i += 1;
  }
  return grown;
}

fn Vec.push(self: *Vec, v: T) {
  if self.n == len(self.items) {
    self.items = grow_to(self.items);
  }
  self.items[self.n] = v;
  self.n += 1;
}

fn Vec.last(self: *Vec) -> T {
  return self.items[self.n - 1];
}

fn Vec.pop(self: *Vec) -> T {
  self.n -= 1;
  return self.items[self.n];
}

// ---------------------------------------------------------------- map ---

// Open-addressing string map, FNV-1a with a fixed seed: iteration follows
// insertion order via the keys vector, so compile output never depends on
// hash placement (spec §11.4).
struct Map[V] {
  slots: []*MapEnt[V],
  cap: usize,
  n: usize,
  keys: Vec[string],
}

struct MapEnt[V] {
  key: string,
  val: V,
  used: bool,
}

pub fn map_hash(s: string) -> usize {
  let mut h: u64 = 1469598103934665603;
  let mut i: usize = 0;
  while i < len(s) {
    h ^= s[i] as u64;
    h *= 1099511628211;
    i += 1;
  }
  return h as usize;
}

// get() is only valid after has(); there is no zero value of V
fn Map.get(self: *Map, key: string) -> V {
  assert(self.has(key));
  let mut i: usize = map_hash(key) & (self.cap - 1);
  while self.slots[i] != null {
    if streq(self.slots[i].key, key) {
      return self.slots[i].val;
    }
    i = (i + 1) & (self.cap - 1);
  }
  panic("map.get: missing key");
}

fn Map.has(self: *Map, key: string) -> bool {
  if self.cap == 0 {
    return false;
  }
  let mut i: usize = map_hash(key) & (self.cap - 1);
  while self.slots[i] != null {
    if streq(self.slots[i].key, key) {
      return true;
    }
    i = (i + 1) & (self.cap - 1);
  }
  return false;
}

fn Map.put(self: *Map, key: string, val: V) {
  if self.n * 10 >= self.cap * 7 {
    let ncap: usize = if self.cap == 0 { 16 } else { self.cap * 2 };
    let slots: []*MapEnt[V] = make([]*MapEnt[V], ncap);
    let old: []*MapEnt[V] = self.slots;
    let oldn: usize = self.cap;
    self.slots = slots;
    self.cap = ncap;
    self.n = 0;
    let mut i: usize = 0;
    while i < oldn {
      if old[i] != null {
        self.put(old[i].key, old[i].val);
      }
      i += 1;
    }
  }
  let mut i: usize = map_hash(key) & (self.cap - 1);
  while self.slots[i] != null {
    if streq(self.slots[i].key, key) {
      self.slots[i].val = val;
      return;
    }
    i = (i + 1) & (self.cap - 1);
  }
  let ent: *MapEnt[V] = new MapEnt[V] { key: key, val: val, used: true };
  self.slots[i] = ent;
  self.n += 1;
  self.keys.push(key);
}

pub fn streq(a: string, b: string) -> bool {
  if len(a) != len(b) {
    return false;
  }
  let mut i: usize = 0;
  while i < len(a) {
    if a[i] != b[i] {
      return false;
    }
    i += 1;
  }
  return true;
}



// ---------------------------------------------------------------- file io --

// grow in a helper: ownership transfers at the call boundary, which the
// rc machinery accounts cleanly (an in-loop let + reassignment does not)
fn grow(buf: []u8, cap: usize) -> []u8 {
  let grown: []u8 = make([]u8, cap * 2);
  let mut i: usize = 0;
  while i < cap {
    grown[i] = buf[i];
    i += 1;
  }
  return grown;
}

pub fn read_file(path: string) -> Result[string, string] {
  let pathz: []u8 = cstr(path);
  let fd: i32 = __open(pathz.ptr, 0, 0); // O_RDONLY
  if fd < 0 {
    return Result.Err("cannot open " + path + "");
  }
  let mut cap: usize = 1 << 16;
  let mut buf: []u8 = make([]u8, cap);
  let mut n: usize = 0;
  loop {
    if n == cap {
      buf = grow(buf, cap);
      cap *= 2;
    }
    let got: isize = __read(fd, (buf.ptr as usize + n) as *u8, cap - n);
    if got <= 0 {
      break;
    }
    n += got as usize;
  }
  __close(fd);
  return Result.Ok(intrinsics.slice_string(buf[0..n]));
}

pub fn write_file(path: string, data: string) -> bool {
  // O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 on linux; 1|0x0200|0x0400 on mac.
  // The bootstrap targets arm64-mac first; keep the mac constants and let
  // the linux port adjust.
  // Every write lands on a fresh vnode via tmp+__rename: an in-place rewrite
  // of an ad-hoc-signed executable leaves the kernel's cached page-hash
  // validation stale, and the next exec of that path wedges uninterruptibly
  // in kernel space (2026-09-21 poison — bytes identical, inode dead).
  let tmp_path: string = path + ".rho-tmp" + "";
  let pathz: []u8 = cstr(tmp_path);
  let fd: i32 = __open(pathz.ptr, 1 | 0x0200 | 0x0400, 420);
  if fd < 0 {
    return false;
  }
  let mut off: usize = 0;
  while off < len(data) {
    let put: isize = __write(fd, (data.ptr as usize + off) as *u8, len(data) - off);
    if put <= 0 {
      __close(fd);
      return false;
    }
    off += put as usize;
  }
  __close(fd);
  if __rename(cstr(tmp_path).ptr, cstr(path).ptr) != 0 {
    return false;
  }
  return true;
}

fn flush_out(s: string) {
  // assemble-then-write: the driver collects output in an SB and writes once
  printf("{}", s);
}


fn Result.get_ok(self: Result) -> T {
  return match self {
    Result.Ok(v) => v,
    Result.Err(_) => panic("get_ok on Err"),
  };
}

fn Result.get_err(self: Result) -> E {
  return match self {
    Result.Err(e) => e,
    Result.Ok(_) => panic("get_err on Ok"),
  };
}


// ---------------------------------------------------------------- driver ---

struct Diag {
  file: string,
  line: i32,
  col: i32,
  msg: string,
}

static mut diags: *Vec[*Diag] = 0 as *Vec[*Diag];

pub fn err_at(file: string, line: i32, col: i32, msg: string) {
  if diags == null {
    diags = new Vec[*Diag] { items: make([*Diag], 8), n: 0 };
  }
  diags.push(new Diag { file: file, line: line, col: col, msg: msg });
}

pub fn diag_count() -> i32 {
  if diags == null {
    return 0;
  }
  return diags.n as i32;
}

fn usage() -> i32 {
  eprintf("{}", "rho 0.4.0\n");
  eprintf("{}", "usage: rho <command> [args]\n");
  eprintf("{}", "  check  <file>              parse + typecheck\n");
  eprintf("{}", "  fmt    [-w] <file>         print canonical formatting\n");
  eprintf("{}", "  build  <file> [-o out] [--set name=value ...] [-g]\n");
  eprintf("{}", "                             compile; override a root build parameter;\n");
  eprintf("{}", "                             -g keeps full internal symbol names\n");
  eprintf("{}", "  run    <file> [-- args]    build and run\n");
  eprintf("{}", "  test   [dir] [--target t]  run corpus-style tests\n");
  eprintf("{}", "  selftest [--update-goldens] [--fmt]\n");
  eprintf("{}", "  --version                  print version\n");
  return 2;
}

// ------------------------------------------------------------- dump ------
//
// Canonical s-expression dump of a parsed module (port of boot's dump.c).
// This is the AST's fingerprint: golden-pinned in tests and compared
// byte-for-byte against boot's dumper by the selftest.

fn d_str_lit(s: string) {
  fmt.f_strlit(s);
}

fn d_type(t: *parse.TypeAst) {
  if t == null {
    fmt.sb_s("void");
    return;
  }
  if t.kind == parse.TypeAstKind.TaPrim {
    fmt.sb_s(check.prim_name(t.prim));
    return;
  }
  if t.kind == parse.TypeAstKind.TaArray {
    if t.size != null {
      fmt.sb_c(91);
      d_expr(t.size);
      fmt.sb_c(93);
    } else {
      fmt.sb_s("[]");
    }
    d_type(t.elem);
    return;
  }
  if t.kind == parse.TypeAstKind.TaPtr {
    fmt.sb_c(42);
    d_type(t.elem);
    return;
  }
  if t.kind == parse.TypeAstKind.TaWeak {
    fmt.sb_s("weak[");
    d_type(t.elem);
    fmt.sb_c(93);
    return;
  }
  if t.kind == parse.TypeAstKind.TaNamed {
    let mut i: usize = 0;
    while i < t.path.n {
      if i > 0 {
        fmt.sb_c(46);
      }
      fmt.sb_s(t.path.items[i]);
      i += 1;
    }
    if t.targs.n > 0 {
      fmt.sb_c(91);
      let mut j: usize = 0;
      while j < t.targs.n {
        if j > 0 {
          fmt.sb_s(", ");
        }
        d_type(t.targs.items[j]);
        j += 1;
      }
      fmt.sb_c(93);
    }
    return;
  }
  // TaFn
  fmt.sb_s("fn(");
  let mut i: usize = 0;
  while i < t.params.n {
    if i > 0 {
      fmt.sb_s(", ");
    }
    d_type(t.params.items[i]);
    i += 1;
  }
  fmt.sb_s(") -> ");
  d_type(t.ret);
}

fn d_expr(e: *parse.Expr) {
  if e == null {
    fmt.sb_s("(void)");
    return;
  }
  if e.kind == parse.ExprKind.ExInt {
    fmt.sb_s("(int " + utoa(e.iv) + ")");
    return;
  }
  if e.kind == parse.ExprKind.ExFloat {
    // canonical float printing: exact for the golden file
    fmt.sb_s("(float " + fmt.g_digits(e.fv, 17) + ")");
    return;
  }
  if e.kind == parse.ExprKind.ExStr {
    fmt.sb_s("(str ");
    d_str_lit(e.sv);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExBool {
    if e.bv { fmt.sb_s("(bool true)"); } else { fmt.sb_s("(bool false)"); }
    return;
  }
  if e.kind == parse.ExprKind.ExNull {
    fmt.sb_s("(null)");
    return;
  }
  if e.kind == parse.ExprKind.ExName {
    fmt.sb_s("(name ");
    fmt.sb_s(e.sv);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExType {
    fmt.sb_s("(ty ");
    d_type(e.ty);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExBin {
    fmt.sb_s("(bin " + fmt.spell_op(e.binop) + " ");
    d_expr(e.a);
    fmt.sb_c(32);
    d_expr(e.b);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExUn {
    fmt.sb_s("(un " + fmt.spell_op(e.unop) + " ");
    d_expr(e.a);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExCall {
    fmt.sb_s("(call ");
    d_expr(e.a);
    let mut i: usize = 0;
    while i < e.args.n {
      fmt.sb_c(32);
      if e.arg_names != null && i < e.arg_names.n && e.arg_names.items[i] != "" {
        fmt.sb_s(e.arg_names.items[i]);
        fmt.sb_s(": ");
      }
      d_expr(e.args.items[i]);
      i += 1;
    }
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExIndex {
    fmt.sb_s("(index ");
    d_expr(e.a);
    fmt.sb_c(32);
    d_expr(e.b);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExSlice {
    fmt.sb_s("(slice ");
    d_expr(e.a);
    fmt.sb_c(32);
    d_expr(e.b);
    fmt.sb_c(32);
    d_expr(e.c);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExField {
    fmt.sb_s("(field ");
    d_expr(e.a);
    fmt.sb_c(32);
    fmt.sb_s(e.sv);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExCast {
    fmt.sb_s("(cast ");
    d_type(e.ty);
    fmt.sb_c(32);
    d_expr(e.a);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExNew {
    fmt.sb_s("(new ");
    d_type(e.ty);
    let mut i: usize = 0;
    while i < e.args.n {
      fmt.sb_c(32);
      fmt.sb_c(40);
      fmt.sb_s(e.items.items[i].name);
      fmt.sb_c(32);
      d_expr(e.args.items[i]);
      fmt.sb_c(41);
      i += 1;
    }
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExMake {
    fmt.sb_s("(make ");
    d_type(e.ty);
    fmt.sb_c(32);
    d_expr(e.c);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExClosure {
    fmt.sb_s("(closure (params");
    let mut i: usize = 0;
    while i < e.params.n {
      fmt.sb_c(32);
      fmt.sb_c(40);
      fmt.sb_s(e.params.items[i].name);
      fmt.sb_c(32);
      d_type(e.params.items[i].ty);
      fmt.sb_c(41);
      i += 1;
    }
    fmt.sb_s(") -> ");
    d_type(e.ret);
    let mut j: usize = 0;
    while j < e.items.n {
      d_stmt(e.items.items[j]);
      j += 1;
    }
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExMatch {
    fmt.sb_s("(match ");
    d_expr(e.a);
    let mut i: usize = 0;
    while i < e.arms.n {
      let arm: *parse.MatchArm = e.arms.items[i];
      fmt.sb_s(" (arm ");
      if arm.pk == parse.PatKind.PatWildcard {
        fmt.sb_s("_");
      } else if arm.pk == parse.PatKind.PatInt {
        fmt.sb_s(utoa(arm.pat_int));
      } else if arm.pk == parse.PatKind.PatStr {
        d_str_lit(arm.pat_str);
      } else {
        let mut j: usize = 0;
        while j < arm.pat_path.n {
          if j > 0 {
            fmt.sb_c(46);
          }
          fmt.sb_s(arm.pat_path.items[j]);
          j += 1;
        }
        if arm.pk == parse.PatKind.PatTuple {
          fmt.sb_c(40);
          let mut k: usize = 0;
          while k < arm.pat_names.n {
            if k > 0 {
              fmt.sb_c(32);
            }
            fmt.sb_s(arm.pat_names.items[k]);
            k += 1;
          }
          fmt.sb_c(41);
        } else if arm.pk == parse.PatKind.PatStruct {
          fmt.sb_c(123);
          let mut k: usize = 0;
          while k < arm.pat_fields.n {
            if k > 0 {
              fmt.sb_c(32);
            }
            fmt.sb_s(arm.pat_fields.items[k].name);
            fmt.sb_c(32);
            fmt.sb_s(arm.pat_names.items[k]);
            k += 1;
          }
          fmt.sb_c(125);
        }
      }
      fmt.sb_c(32);
      d_expr(arm.body);
      fmt.sb_c(41);
      i += 1;
    }
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExQmark {
    fmt.sb_s("(qmark ");
    d_expr(e.a);
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExIf {
    fmt.sb_s("(if ");
    d_expr(e.a);
    fmt.sb_s(" (block");
    if e.items.n > 0 {
      let then: *parse.Stmt = e.items.items[0];
      let mut i: usize = 0;
      while i < then.stmts.n {
        d_stmt(then.stmts.items[i]);
        i += 1;
      }
    }
    fmt.sb_c(41);
    if e.else_if != null {
      fmt.sb_c(32);
      d_expr(e.else_if);
    } else if e.items.n > 1 {
      fmt.sb_s(" (block");
      let else_blk: *parse.Stmt = e.items.items[1];
      let mut i: usize = 0;
      while i < else_blk.stmts.n {
        d_stmt(else_blk.stmts.items[i]);
        i += 1;
      }
      fmt.sb_c(41);
    }
    fmt.sb_c(41);
    return;
  }
  if e.kind == parse.ExprKind.ExBlock {
    fmt.sb_s("(block");
    let mut i: usize = 0;
    while i < e.items.n {
      d_stmt(e.items.items[i]);
      i += 1;
    }
    fmt.sb_c(41);
    return;
  }
}

fn d_stmt(s: *parse.Stmt) {
  if s.kind == parse.StmtKind.StLet {
    fmt.sb_s(" (let");
    if s.mut_ {
      fmt.sb_s(" mut");
    }
    fmt.sb_c(32);
    fmt.sb_s(s.name);
    fmt.sb_c(32);
    d_type(s.ty);
    fmt.sb_c(32);
    d_expr(s.a);
    fmt.sb_c(41);
    return;
  }
  if s.kind == parse.StmtKind.StAssign {
    fmt.sb_s(" (assign " + fmt.spell_op(s.assign_op) + " ");
    d_expr(s.a);
    fmt.sb_c(32);
    d_expr(s.b);
    fmt.sb_c(41);
    return;
  }
  if s.kind == parse.StmtKind.StExpr {
    if s.tail {
      fmt.sb_s(" (tail ");
    } else {
      fmt.sb_s(" (expr ");
    }
    d_expr(s.a);
    fmt.sb_c(41);
    return;
  }
  if s.kind == parse.StmtKind.StReturn {
    fmt.sb_s(" (return");
    if s.a != null {
      fmt.sb_c(32);
      d_expr(s.a);
    }
    fmt.sb_c(41);
    return;
  }
  if s.kind == parse.StmtKind.StBreak {
    fmt.sb_s(" (break)");
    return;
  }
  if s.kind == parse.StmtKind.StContinue {
    fmt.sb_s(" (continue)");
    return;
  }
  if s.kind == parse.StmtKind.StDefer {
    fmt.sb_s(" (defer");
    let mut i: usize = 0;
    while i < s.stmts.n {
      d_stmt(s.stmts.items[i]);
      i += 1;
    }
    fmt.sb_c(41);
    return;
  }
  if s.kind == parse.StmtKind.StWhile {
    fmt.sb_s(" (while ");
    d_expr(s.cond);
    fmt.sb_s(" (block");
    let mut i: usize = 0;
    while i < s.body.n {
      d_stmt(s.body.items[i]);
      i += 1;
    }
    fmt.sb_s("))");
    return;
  }
  if s.kind == parse.StmtKind.StLoop {
    fmt.sb_s(" (loop (block");
    let mut i: usize = 0;
    while i < s.body.n {
      d_stmt(s.body.items[i]);
      i += 1;
    }
    fmt.sb_s("))");
    return;
  }
  // StBlock
  fmt.sb_s(" (block");
  let mut i: usize = 0;
  while i < s.stmts.n {
    d_stmt(s.stmts.items[i]);
    i += 1;
  }
  fmt.sb_c(41);
}

fn d_decl(d: *parse.Decl) {
  if d.kind == parse.DeclKind.DkFn {
    fmt.sb_s(" (fn");
    if d.pub_ {
      fmt.sb_s(" pub");
    }
    fmt.sb_c(32);
    fmt.sb_s(d.name);
    fmt.sb_s(" (params");
    let mut i: usize = 0;
    while i < d.params.n {
      fmt.sb_c(32);
      fmt.sb_c(40);
      fmt.sb_s(d.params.items[i].name);
      fmt.sb_c(32);
      d_type(d.params.items[i].ty);
      fmt.sb_c(41);
      i += 1;
    }
    fmt.sb_c(41);
    if d.ret != null {
      fmt.sb_s(" (ret ");
      d_type(d.ret);
      fmt.sb_c(41);
    }
    let mut j: usize = 0;
    while j < d.body.n {
      d_stmt(d.body.items[j]);
      j += 1;
    }
    fmt.sb_c(41);
    return;
  }
  if d.kind == parse.DeclKind.DkExtern {
    fmt.sb_s(" (extern ");
    fmt.sb_s(d.name);
    fmt.sb_s(" (params");
    let mut i: usize = 0;
    while i < d.params.n {
      fmt.sb_c(32);
      fmt.sb_c(40);
      fmt.sb_s(d.params.items[i].name);
      fmt.sb_c(32);
      d_type(d.params.items[i].ty);
      fmt.sb_c(41);
      i += 1;
    }
    fmt.sb_c(41);
    if d.ret != null {
      fmt.sb_s(" (ret ");
      d_type(d.ret);
      fmt.sb_c(41);
    }
    fmt.sb_c(41);
    return;
  }
  if d.kind == parse.DeclKind.DkStruct {
    fmt.sb_s(" (struct");
    if d.pub_ {
      fmt.sb_s(" pub");
    }
    fmt.sb_c(32);
    fmt.sb_s(d.name);
    let mut i: usize = 0;
    while i < d.fields.n {
      fmt.sb_c(32);
      fmt.sb_c(40);
      fmt.sb_s(d.fields.items[i].name);
      fmt.sb_c(32);
      d_type(d.fields.items[i].ty);
      fmt.sb_c(41);
      i += 1;
    }
    fmt.sb_c(41);
    return;
  }
  if d.kind == parse.DeclKind.DkEnum {
    fmt.sb_s(" (enum");
    if d.pub_ {
      fmt.sb_s(" pub");
    }
    fmt.sb_c(32);
    fmt.sb_s(d.name);
    let mut i: usize = 0;
    while i < d.variants.n {
      let v: *parse.VariantAst = d.variants.items[i];
      fmt.sb_c(32);
      fmt.sb_c(40);
      fmt.sb_s(v.name);
      fmt.sb_c(32);
      fmt.sb_s(utoa(v.disc));
      if v.vkind == parse.VarKind.VarTuple {
        let mut j: usize = 0;
        while j < v.types.n {
          fmt.sb_c(32);
          d_type(v.types.items[j]);
          j += 1;
        }
      } else if v.vkind == parse.VarKind.VarStruct {
        let mut j: usize = 0;
        while j < v.fields.n {
          fmt.sb_c(32);
          fmt.sb_c(40);
          fmt.sb_s(v.fields.items[j].name);
          fmt.sb_c(32);
          d_type(v.fields.items[j].ty);
          fmt.sb_c(41);
          j += 1;
        }
      }
      fmt.sb_c(41);
      i += 1;
    }
    fmt.sb_c(41);
    return;
  }
  if d.kind == parse.DeclKind.DkStatic || d.kind == parse.DeclKind.DkConst {
    if d.kind == parse.DeclKind.DkConst {
      fmt.sb_s(" (const");
    } else {
      fmt.sb_s(" (static");
    }
    if d.is_mut {
      fmt.sb_s(" mut");
    }
    fmt.sb_c(32);
    fmt.sb_s(d.name);
    fmt.sb_c(32);
    d_type(d.ret);
    fmt.sb_c(32);
    d_expr(d.init);
    fmt.sb_c(41);
    return;
  }
  // DkUse — boot's frozen dump prints `(use a b c)`; the mirror extends the
  // shape only for what boot never parses (pub re-exports, aliases), so the
  // shared golden subset stays byte-identical
  if d.pub_ {
    fmt.sb_s(" (pub use");
  } else {
    fmt.sb_s(" (use");
  }
  let mut i: usize = 0;
  while i < d.path.n {
    fmt.sb_c(32);
    fmt.sb_s(d.path.items[i]);
    i += 1;
  }
  if len(d.name) > 0 {
    fmt.sb_s(" as ");
    fmt.sb_s(d.name);
  }
  fmt.sb_c(41);
}

fn dump_module(module: *parse.Decl) -> string {
  fmt.g_sb = new Vec[u8] { items: make([]u8, 65536), n: 0 };
  fmt.sb_s("(module");
  let mut i: usize = 0;
  while i < module.decls.n {
    d_decl(module.decls.items[i]);
    i += 1;
  }
  fmt.sb_s(")\n");
  return intrinsics.slice_string(fmt.g_sb.items[0..fmt.g_sb.n]);
}

// ---------------------------------------------------------- selftest -----
//
// Port of boot's selftest: AST goldens for tests/frontend, fmt roundtrip +
// idempotence + AST preservation, and diagnostic goldens for tests/diag.
// All goldens are files under tests/golden/ — nothing embedded.

static mut g_st_failures: i32 = 0;

fn st_fail(name: string, msg: string) {
  printf("{}", "FAIL " + name + ": " + msg + "\n");
  g_st_failures += 1;
}

// the diagnostics vec rendered exactly as print_diags would print it
fn render_diags_str() -> string {
  if diags == null {
    return "";
  }
  fmt.g_sb = new Vec[u8] { items: make([]u8, 4096), n: 0 };
  let mut i: usize = 0;
  while i < diags.n {
    let d: *Diag = diags.items[i];
    fmt.sb_s(d.file);
    fmt.sb_c(58);
    fmt.sb_s(itoa(d.line as i64));
    fmt.sb_c(58);
    fmt.sb_s(itoa(d.col as i64));
    fmt.sb_s(": error: ");
    fmt.sb_s(d.msg);
    fmt.sb_c(10);
    i += 1;
  }
  return intrinsics.slice_string(fmt.g_sb.items[0..fmt.g_sb.n]);
}

fn golden_check(got: string, golden_path: string, name: string, update: bool) {
  if update {
    if !write_file(golden_path, got) {
      st_fail(name, "cannot write golden " + golden_path);
    }
    return;
  }
  let r: Result[string, string] = read_file(golden_path);
  if r.is_err() {
    st_fail(name, "missing golden " + golden_path);
    return;
  }
  if !streq(got, r.get_ok()) {
    let tmp: string = "build/" + name + ".got";
    write_file(tmp, got);
    st_fail(name, "output differs from " + golden_path + " (wrote " + tmp + ")");
  }
}

fn st_reset_with_prelude() {
  reset_compiler_state();
  let pr: Result[string, string] = prelude_src.read_prelude("hosted.rho");
  if pr.is_err() {
    return;
  }
  let pparse: *parse.Decl = parse.parse_file("<prelude>", pr.get_ok());
  let pmod: *check.Module = new check.Module {
    path: "<prelude>", ns: "", root: pparse,
    syms: check.sm_new(), is_prelude: true, checked: false,
  };
  check.check_all(pmod);
  check.prelude_module = pmod;
}

fn cmd_selftest(args: []string) -> i32 {
  let mut update: bool = false;
  let mut fmt_only: bool = false;
  let mut ai: usize = 2;
  while ai < len(args) {
    if streq(args[ai], "--update-goldens") {
      update = true;
    } else if streq(args[ai], "--fmt") {
      fmt_only = true;
    }
    ai += 1;
  }
  g_st_failures = 0;
  // 1. AST goldens + 2. fmt roundtrip: tests/frontend/*.rho
  let fe: *Vec[string] = list_dir_rho("tests/frontend");
  let mut fi: usize = 0;
  while fi < fe.n {
    let path: string = fe.items[fi];
    let name: string = basename_no_ext(path);
    if !fmt_only {
      st_reset_with_prelude();
      let src_r: Result[string, string] = read_file(path);
      if src_r.is_err() {
        st_fail(name, "cannot read " + path);
        fi += 1;
        continue;
      }
      let root: *parse.Decl = parse.parse_file(path, src_r.get_ok());
      golden_check(dump_module(root), "tests/golden/ast/" + name + ".dump", name, update);
      if diag_count() > 0 {
        golden_check(render_diags_str(), "tests/golden/diag/" + name + "_parse.err", name + " parse", update);
      }
      let m: *check.Module = new check.Module {
        path: path, ns: "", root: root, syms: check.sm_new(),
        is_prelude: false, checked: false,
      };
      check.check_all(m);
      if diag_count() > 0 {
        golden_check(render_diags_str(), "tests/golden/diag/" + name + "_check.err", name + " check", update);
      }
    }
    // fmt roundtrip + idempotence (parse errors naturally skip via check)
    st_reset_with_prelude();
    let src2: Result[string, string] = read_file(path);
    if src2.is_err() {
      fi += 1;
      continue;
    }
    let root2: *parse.Decl = parse.parse_file(path, src2.get_ok());
    if diag_count() == 0 {
      let once: string = fmt.fmt_module(root2);
      let reparsed: *parse.Decl = parse.parse_file(path, once);
      if diag_count() > 0 {
        st_fail(name + " fmt", "fmt output does not reparse:\n" + render_diags_str());
      } else {
        let twice: string = fmt.fmt_module(reparsed);
        if !streq(once, twice) {
          st_fail(name + " fmt", "fmt is not idempotent");
        }
        // strongest pin: reformatting must preserve the AST exactly
        if !streq(dump_module(root2), dump_module(reparsed)) {
          st_fail(name + " fmt", "fmt changed the AST");
        }
        // and the reformatted source must still typecheck the same
        st_reset_with_prelude();
        let m2: *check.Module = new check.Module {
          path: path, ns: "", root: reparsed, syms: check.sm_new(),
          is_prelude: false, checked: false,
        };
        check.check_module(m2);
        if diag_count() > 0 {
          st_fail(name + " fmt", "fmt output fails check:\n" + render_diags_str());
        }
      }
    }
    fi += 1;
  }
  // 3. diagnostic goldens: tests/diag/*.rho -> tests/golden/diag/<name>.err
  if !fmt_only {
    let dg: *Vec[string] = list_dir_rho("tests/diag");
    let mut di: usize = 0;
    while di < dg.n {
      let path: string = dg.items[di];
      let name: string = basename_no_ext(path);
      st_reset_with_prelude();
      let src_r: Result[string, string] = read_file(path);
      if src_r.is_err() {
        st_fail(name, "cannot read " + path);
        di += 1;
        continue;
      }
      let root: *parse.Decl = parse.parse_file(path, src_r.get_ok());
      let m: *check.Module = new check.Module {
        path: path, ns: "", root: root, syms: check.sm_new(),
        is_prelude: false, checked: false,
      };
      check.check_all(m);
      golden_check(render_diags_str(), "tests/golden/diag/" + name + ".err", name, update);
      di += 1;
    }
  }
  if g_st_failures == 0 {
    printf("{}", "selftest ok\n");
  } else {
    printf("{}", "selftest: " + itoa(g_st_failures as i64) + " failure(s)\n");
  }
  if g_st_failures > 0 {
    return 1;
  }
  return 0;
}

// list *.rho files under dir (boot: `find <dir> -name '*.rho' | sort`)
fn list_dir_rho(dir: string) -> *Vec[string] {
  // directory listing needs a spawn-capable host (boot's wasm build lists
  // nothing); freestanding images have no popen, so this stays empty there
  let out: *Vec[string] = new Vec[string] { items: make([]string, 64), n: 0 };
  if !__can_spawn() {
    return out;
  }
  return list_dir_rho_hosted(dir, out);
}

// the hosted listing: `find | sort` one line at a time over the prelude's
// spawn hook when the target provides one, else empty
fn list_dir_rho_hosted(dir: string, out: *Vec[string]) -> *Vec[string] {
  if !__can_spawn() {
    return out;
  }
  eprintf("{}", "rho: directory listing of `" + dir + "` is unavailable on this target\n");
  return out;
}

fn basename_no_ext(path: string) -> string {
  let mut start: usize = 0;
  let mut i: usize = 0;
  while i < len(path) {
    if path[i] == 47 {
      start = i + 1;
    }
    i += 1;
  }
  let mut end: usize = len(path);
  let mut j: usize = len(path);
  while j > start {
    if path[j - 1] == 46 {
      end = j - 1;
      break;
    }
    j -= 1;
  }
  return fmt.substr(path, start, end);
}

// `// exit: N` on the source's first line pins the expected exit code
fn expected_exit(src: string) -> i32 {
  let mut n: usize = 0;
  while n < len(src) && src[n] != 10 {
    n += 1;
  }
  let mut i: usize = 0;
  while i + 5 <= n {
    if src[i] == 101 && src[i + 1] == 120 && src[i + 2] == 105 && src[i + 3] == 116 && src[i + 4] == 58 {
      let mut k: usize = i + 5;
      let mut neg: bool = false;
      while k < n && (src[k] == 32 || src[k] == 9) {
        k += 1;
      }
      if k < n && src[k] == 45 {
        neg = true;
        k += 1;
      }
      let mut v: i32 = 0;
      while k < n && src[k] >= 48 && src[k] <= 57 {
        v = v * 10 + (src[k] - 48) as i32;
        k += 1;
      }
      if neg {
        return 0 - v;
      }
      return v;
    }
    i += 1;
  }
  return 0;
}

fn read_file_or_empty(path: string) -> string {
  let r: Result[string, string] = read_file(path);
  if r.is_err() {
    return "";
  }
  return r.get_ok();
}

fn parse_target_name(s: string) -> i32 {
  // 0 = amd64-linux, 1 = amd64-mac, 2 = arm64-mac (default), 3 = wasm32-wasi,
  // 4 = arm64-linux
  if streq(s, "wasm32-wasi") {
    return 3;
  }
  if streq(s, "amd64-linux") {
    return 0;
  }
  if streq(s, "amd64-mac") {
    return 1;
  }
  if streq(s, "arm64-linux") {
    return 4;
  }
  return 2;
}

// boot runs one compile per check_reset(): every compile starts from the
// zero state, so `test` driving many builds in one process cannot leak
// interned types, scopes, or IR between files
fn reset_compiler_state() {
  diags = null;
  lower.reset_naming();
  check.g_types = null;
  check.g_recs = null;
  check.g_module_type = null;
  check.cur_scope = null;
  check.cur_ret = null;
  check.cur_fn_sym = null;
  check.next_local_id = 0;
  check.g_cap_list = null;
  check.g_cap_boundary = 0;
  check.cur_module = null;
  check.prelude_module = null;
  check.g_aux_modules = null;
  check.g_entry_path = "";
  check.g_use_reqs = null;
  check.g_flat_stack = null;
  check.g_ret_memo = null;
  check.g_ret_judging = null;
  check.g_prim_methods = null;
  check.g_tenv = null;
  check.in_defer = false;
  check.loop_depth = 0;
  ir.g_ir_fns = null;
  ir.g_ir_uid = 0;
  ir.g_ir_globals = null;
  lower.g_reach_all = null;
  lower.g_reach_keep = null;
  lower.g_reach_work = null;
  lower.g_mod_idx_paths = null;
  ir.g_main_cell = null;
  ir.g_root_module = null;
  ir.g_panic_site = 0;
  ir.g_lit_counter = 0;
  ir.g_closure_counter = 0;
  ir.g_eq_fns = null;
  lower.g_rel_fns = null;
  lower.g_ret_fns = null;
  lower.g_shims = null;
  emit_wasm.W = null;
  emit_wasm.fb_ctx = null;
  // the native emitters' counters reset inside pipe_emit (the web build
  // links no native backend, so their reset cannot live here)
  check.g_instantiations = null;
  check.g_instantiated_names = null;
  check.g_instantiated_syms = null;
  check.g_instantiation_depth = 0;
  check.g_use_root = "";
  check.reset_build_params();
}

// the directory part of a path, with the trailing slash kept
fn dir_of_str(path: string) -> string {
  let mut last: usize = 0;
  let mut i: usize = 0;
  while i < len(path) {
    if path[i] == 47 {
      last = i + 1;
    }
    i += 1;
  }
  return path[0..last];
}

// the native-pipe sentinel: build_to cannot name the backends (the
// wasm-only web build links none of them), so a native target returns
// RC_NATIVE with the request parked here and the package root's fn main
// finishes the job through its own pipe (or refuses, on the web build)
pub static RC_NATIVE: i32 = 100;
pub static mut g_req_target: i32 = 0;
pub static mut g_req_out: string = "";

// compile one file end to end; silent on success (the caller prints)
pub static mut g_target_wasm: bool = false;

// the `--set name=value` build-parameter overrides captured by the CLI
// (parallel arrays; consumed once per build_to, at param-install time)
static mut g_set_names: *Vec[string] = 0 as *Vec[string];
static mut g_set_vals: *Vec[string] = 0 as *Vec[string];
// the `-g` keep-full-internal-names flag, captured at parse time and
// consumed once per build_to (after reset_compiler_state)
static mut g_flag_g: bool = false;
// the last integer parsed by parse_param_int (rho has no out-parameters)
static mut g_int_parsed: u64 = 0;

fn parse_param_int(s: string) -> bool {
  g_int_parsed = 0;
  if len(s) == 0 {
    return false;
  }
  let mut i: usize = 0;
  let mut neg: bool = false;
  if s[0] == 45 {
    neg = true;
    i = 1;
  }
  if i >= len(s) {
    return false;
  }
  let mut v: u64 = 0;
  while i < len(s) {
    let c: u8 = s[i];
    if c < 48 || c > 57 {
      return false;
    }
    v = v * 10 + (c - 48) as u64;
    i += 1;
  }
  if neg {
    v = (0 - (v as i64)) as u64;
  }
  g_int_parsed = v;
  return true;
}

// `--set name=value` — split at the first `=`, record both halves
fn record_set(spec: string) -> bool {
  let mut eq: usize = 0;
  let mut found: bool = false;
  let mut i: usize = 0;
  while i < len(spec) {
    if spec[i] == 61 {
      eq = i;
      found = true;
      break;
    }
    i += 1;
  }
  if !found || eq == 0 {
    eprintf("{}", "rho: --set needs name=value, found `" + spec + "`\n");
    return false;
  }
  if g_set_names == null {
    g_set_names = new Vec[string] { items: make([]string, 8), n: 0 };
    g_set_vals = new Vec[string] { items: make([]string, 8), n: 0 };
  }
  g_set_names.push(spec[0..eq]);
  g_set_vals.push(spec[eq + 1..len(spec)]);
  return true;
}

// apply one override to the root's const decl: the declared annotation
// decides the value grammar (bool: true/false; i32: [-]digits; string: raw)
fn apply_one_set(name: string, val: string, declared: *Vec[string]) -> bool {
  let pd: *Vec[*parse.Decl] = check.g_param_decls;
  let mut d: *parse.Decl = null;
  let mut i: usize = 0;
  while pd != null && i < pd.n {
    if streq(pd.items[i].name, name) {
      d = pd.items[i];
      break;
    }
    i += 1;
  }
  if d == null {
    let mut msg: string = "rho: unknown build parameter `" + name + "`";
    if declared.n > 0 {
      msg = msg + " (this root declares: ";
      let mut k: usize = 0;
      while k < declared.n {
        if k > 0 {
          msg = msg + ", ";
        }
        msg = msg + declared.items[k];
        k += 1;
      }
      msg = msg + ")";
    } else {
      msg = msg + " (the root file declares no build parameters)";
    }
    eprintf("{}", msg + "\n");
    return false;
  }
  if d.ret == null || d.ret.kind != parse.TypeAstKind.TaPrim {
    eprintf("{}", "rho: build parameter `" + name + "` must be declared bool, i32, or string\n");
    return false;
  }
  let prim: i32 = d.ret.prim;
  if prim == 0 {
    let mut bv: bool = false;
    let mut ok: bool = true;
    if streq(val, "true") {
      bv = true;
    } else if streq(val, "false") {
      bv = false;
    } else {
      ok = false;
    }
    if !ok {
      eprintf("{}", "rho: build parameter `" + name + "` expects bool, got `" + val + "`\n");
      return false;
    }
    d.init = parse.mkexpr(parse.ExprKind.ExBool, d.file, d.line, d.col);
    d.init.bv = bv;
    return true;
  }
  if prim == 3 {
    if !parse_param_int(val) {
      eprintf("{}", "rho: build parameter `" + name + "` expects i32, got `" + val + "`\n");
      return false;
    }
    d.init = parse.mkexpr(parse.ExprKind.ExInt, d.file, d.line, d.col);
    d.init.iv = g_int_parsed;
    return true;
  }
  if prim == 11 {
    d.init = parse.mkexpr(parse.ExprKind.ExStr, d.file, d.line, d.col);
    d.init.sv = val;
    return true;
  }
  eprintf("{}", "rho: build parameter `" + name + "` must be declared bool, i32, or string\n");
  return false;
}

// apply every recorded --set; false = a clear CLI-level refusal (exit 2)
fn apply_build_params() -> bool {
  if g_set_names == null || g_set_names.n == 0 {
    return true;
  }
  // the declared names, for the unknown-parameter message
  let declared: *Vec[string] = new Vec[string] { items: make([]string, 8), n: 0 };
  let pd: *Vec[*parse.Decl] = check.g_param_decls;
  let mut i: usize = 0;
  while pd != null && i < pd.n {
    declared.push(pd.items[i].name);
    i += 1;
  }
  let mut ok: bool = true;
  i = 0;
  while i < g_set_names.n {
    if !apply_one_set(g_set_names.items[i], g_set_vals.items[i], declared) {
      ok = false;
    }
    i += 1;
  }
  // consumed: a second compilation in this process starts clean
  g_set_names = null;
  g_set_vals = null;
  return ok;
}

fn build_to(path: string, target: i32, out_path: string, check_only: bool) -> i32 {
  reset_compiler_state();
  // the -g flag rides a cli-level static: reset_compiler_state runs inside
  // build_to, after argument parsing, so the parse-time assignment must be
  // re-applied here (consumed: one build per flag)
  lower.g_full_names = g_flag_g;
  g_flag_g = false;
  g_target_wasm = target == 3;
  check.g_use_root = dir_of_str(path);
  // the entry file: `main` is reserved as a module binding in it
  check.g_entry_path = path;
  let src_result: Result[string, string] = read_file(path);
  if src_result.is_err() {
    eprintf("{}", "rho: " + src_result.get_err() + "\n");
    return 2;
  }
  let module: *parse.Decl = parse.parse_file(path, src_result.get_ok());
  if diag_count() > 0 {
    print_diags();
    return 1;
  }
  let m: *check.Module = new check.Module {
    path: path, ns: "", root: module, syms: check.sm_new(),
    is_prelude: false, checked: false,
  };
  // the root file's consts are build parameters (spec §7.2): record them
  // before anything registers, then apply the --set overrides
  check.install_build_params(m);
  if diag_count() > 0 {
    print_diags();
    return 1;
  }
  if !apply_build_params() {
    return 2;
  }
  // per-target tail: wasi for wasm32-wasi, the mac tail for every native
  // image (boot: g_prelude_wasm / g_prelude_native)
  let mut prelude_tail: string = "mac.rho";
  if target == 3 {
    prelude_tail = "wasi.rho";
  }
  let prelude_r: Result[string, string] = prelude_src.read_prelude(prelude_tail);
  if !prelude_r.is_err() {
    let pparse: *parse.Decl = parse.parse_file("<prelude>", prelude_r.get_ok());
    let pmod: *check.Module = new check.Module {
      path: "<prelude>", ns: "", root: pparse,
      syms: check.sm_new(), is_prelude: true, checked: false,
    };
    check.check_all(pmod);
    check.prelude_module = pmod;
    // registration happens once, inside check_all's own check_module call
  }
  let diags_before: i32 = diag_count();
  let nd: i32 = check.check_all(m);
  if nd > diags_before {
    print_diags();
    return 1;
  }
  if check_only {
    // check stops here: parse + typecheck ok (boot prints "ok <file>")
    printf("{}", "ok " + path + "\n" + "");
    return 0;
  }
  ir.g_root_module = m;
  lower.lower_program();
  opt.run();
  if emit_wasm.g_dump_ir {
    emit_wasm.lower_dump_ir();
  }
  if target == 3 {
    let bytes: []u8 = emit_wasm.emit_wasm();
    if !write_file(out_path, bytes_as_string(bytes)) {
      eprintf("{}", "rho: cannot write " + out_path + "\n");
      return 1;
    }
    return 0;
  }
  // native: the backends live behind the package root's pipe (the
  // wasm-only web build links none of them) — surface the request and
  // let the root finish it
  g_req_target = target;
  g_req_out = out_path;
  return RC_NATIVE;
}

// rho test [dir] [--target t]: corpus-style expected-exit/stdout runner
fn cmd_test(args: []string) -> i32 {
  let mut dir: string = "corpus";
  let mut target: i32 = 3; // boot's test defaults to wasm32-wasi
  let mut i: usize = 2;
  while i < len(args) {
    if streq(args[i], "--target") && i + 1 < len(args) {
      target = parse_target_name(args[i + 1]);
      i += 2;
    } else {
      dir = args[i];
      i += 1;
    }
  }
  if !__can_spawn() {
    // driving a corpus spawns wasmtime (wasm) or the built image (native);
    // a compiler image can do neither — boot's wasm build lists nothing
    // and reports an empty run for the same reason
    eprintf("{}", "rho: test needs a spawn-capable host\n");
    return 2;
  }
  let files: *Vec[string] = list_dir_rho(dir);
  let mut failures: i32 = 0;
  let mut ran: i32 = 0;
  // the mirror carries no spawn primitive, so the per-file build+run loop
  // of a hosted toolchain cannot execute here; on a spawn-capable host the
  // listing is what bounds the run
  ran = files.n as i32;
  let mut fi: usize = 0;
  while fi < files.n {
    printf("{}", "SKIP " + basename_no_ext(files.items[fi]) + " (no spawn on this target)\n" + "");
    fi += 1;
  }
  let mut verdict: string = "corpus ok";
  if failures > 0 {
    verdict = "corpus FAIL";
  }
  printf("{}", verdict + ": " + itoa(ran as i64) + " ran, " + itoa(failures as i64) + " failed\n");
  if failures > 0 {
    return 1;
  }
  return 0;
}

// the CLI driver, shared verbatim by both package roots; the roots
// call this and finish the RC_NATIVE request through their own pipe
pub fn run() -> i32 {
  let args: []string = program_args();
  if len(args) < 2 {
    return usage();
  }
  let cmd: string = args[1];
  if streq(cmd, "--version") || streq(cmd, "version") {
    printf("{}", "rho 0.4.0\n");
    return 0;
  }
  if streq(cmd, "selftest") {
    return cmd_selftest(args);
  }
  if streq(cmd, "fmt") {
    // rho fmt [-w] <file>: parse + canonical print; no check, no prelude
    let mut inplace: bool = false;
    let mut file: string = "";
    let mut fi: usize = 2;
    while fi < len(args) {
      if streq(args[fi], "-w") {
        inplace = true;
      } else {
        file = args[fi];
      }
      fi += 1;
    }
    if streq(file, "") {
      return usage();
    }
    let r: Result[string, string] = read_file(file);
    if r.is_err() {
      eprintf("{}", "rho: " + r.get_err() + "\n");
      return 2;
    }
    let root: *parse.Decl = parse.parse_file(file, r.get_ok());
    if diag_count() > 0 {
      print_diags();
      return 1;
    }
    let out: string = fmt.fmt_module(root);
    if inplace {
      if !write_file(file, out) {
        eprintf("{}", "rho: cannot write " + file + "\n");
        return 2;
      }
    } else {
      printf("{}", out);
    }
    return 0;
  }
  if streq(cmd, "test") {
    return cmd_test(args);
  }
  if streq(cmd, "run") {
    let mut file: string = "";
    let mut target: i32 = 3;
    let mut ri: usize = 2;
    while ri < len(args) {
      if streq(args[ri], "--target") && ri + 1 < len(args) {
        target = parse_target_name(args[ri + 1]);
        ri += 2;
      } else if streq(args[ri], "--set") && ri + 1 < len(args) {
        if !record_set(args[ri + 1]) {
          return 2;
        }
        ri += 2;
      } else if streq(args[ri], "--set") {
        eprintf("{}", "rho: --set needs name=value\n");
        return 2;
      } else {
        file = args[ri];
        ri += 1;
      }
    }
    if streq(file, "") {
      return usage();
    }
    let brc: i32 = build_to(file, target, "/tmp/rho_run", false);
    if brc != 0 {
      return brc;
    }
    // a compiler image cannot spawn processes: wasmtime (wasm) and the
    // native image itself must be invoked by the caller
    eprintf("{}", "rho: built /tmp/rho_run" + "; invoke it directly (run needs a spawn-capable host)\n" + "");
    return 2;
  }
  if !streq(cmd, "build") && !streq(cmd, "check") {
    return usage();
  }
  let path: string = args[2];
  let mut out_path: string = "a.out";
  // 0 = amd64-linux, 1 = amd64-mac, 2 = arm64-mac, 3 = wasm32-wasi (default)
  let mut target: i32 = 3;
  let mut ai: usize = 3;
  while ai < len(args) {
    if streq(args[ai], "-o") && ai + 1 < len(args) {
      out_path = args[ai + 1];
      ai += 2;
    } else if streq(args[ai], "--target") && ai + 1 < len(args) {
      target = parse_target_name(args[ai + 1]);
      ai += 2;
    } else if streq(args[ai], "--set") && ai + 1 < len(args) {
      if !record_set(args[ai + 1]) {
        return 2;
      }
      ai += 2;
    } else if streq(args[ai], "--set") {
      eprintf("{}", "rho: --set needs name=value\n");
      return 2;
    } else if streq(args[ai], "--dump-ir") {
      emit_wasm.g_dump_ir = true;
      ai += 1;
    } else if streq(args[ai], "--no-opt") {
      opt.g_opt_off = true;
      ai += 1;
    } else if streq(args[ai], "-g") {
      g_flag_g = true;
      ai += 1;
    } else {
      ai += 1;
    }
  }
  let rc: i32 = build_to(path, target, out_path, streq(cmd, "check"));
  if rc != 0 {
    return rc;
  }
  if streq(cmd, "build") {
    printf("{}", "built " + out_path + "\n" + "" + "");
  }
  return 0;
}

fn print_diags() {
  let mut i: usize = 0;
  while i < diags.n {
    let d: *Diag = diags.items[i];
    eprintf("{}", d.file);
    eprintf("{}", ":");
    eprintf("{}", itoa(d.line as i64));
    eprintf("{}", ":");
    eprintf("{}", itoa(d.col as i64));
    eprintf("{}", ": error: ");
    eprintf("{}", d.msg);
    eprintf("{}", "\n");
    i += 1;
  }
}



// decimal u64 (bit patterns exceed i64 range; itoa would print them signed)
pub fn utoa(v: u64) -> string {
  if v == 0 {
    return "0";
  }
  let buf: []u8 = make([]u8, 24);
  let mut n: usize = 24;
  let mut x: u64 = v;
  while x > 0 {
    n -= 1;
    buf[n] = 48 + (x % 10) as u8;
    x /= 10;
  }
  return intrinsics.slice_string(buf[n..24]);
}

pub fn bytes_as_string(b: []u8) -> string {
  return intrinsics.slice_string(b);
}
