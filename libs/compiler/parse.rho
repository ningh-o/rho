// parse.rho — the self-hosted compiler's parser (T2.2 growth).
// Grammar: fn main ( ) (-> i32)? { stmt* } where a statement is a
// printf call, a let binding, or a return; expressions are integer
// literals, variables, and + - * / % with parentheses. The AST is a
// tagged struct per node — boxes make the tree recursive.
use lex;

pub const EX_LIT: i32 = 0;
pub const EX_VAR: i32 = 1;
pub const EX_BIN: i32 = 2;
pub const EX_STR: i32 = 3;

pub struct Expr {
  tag: i32,      // EX_*
  lit: i64,      // literal value
  name: string,  // variable name
  op: u8,        // binary operator byte
  lhs: ?*Expr,
  rhs: ?*Expr,
}

pub const ST_PF: i32 = 0;
pub const ST_LET: i32 = 1;
pub const ST_RET: i32 = 2;

pub struct Stmt {
  tag: i32,      // ST_*
  fmt: string,   // printf: the format text
  args: []*Expr, // printf: one expr per hole
  name: string,  // let: the bound name
  val: ?*Expr,   // let: the bound expr
  ret: i64,      // return: the value
}

pub fn lit(v: i64) -> *Expr {
  return new Expr { tag: EX_LIT, lit: v, name: "", op: 0,
                     lhs: Option.None, rhs: Option.None };
}

pub fn var(name: string) -> *Expr {
  return new Expr { tag: EX_VAR, lit: 0, name: name, op: 0,
                     lhs: Option.None, rhs: Option.None };
}

pub fn strlit(text: string) -> *Expr {
  return new Expr { tag: EX_STR, lit: 0, name: text, op: 0,
                     lhs: Option.None, rhs: Option.None };
}

pub fn bin(op: u8, lhs: *Expr, rhs: *Expr) -> *Expr {
  return new Expr { tag: EX_BIN, lit: 0, name: "", op: op,
                     lhs: Option.Some(lhs), rhs: Option.Some(rhs) };
}

struct PCur {
  toks: []*Tok,
  pos: usize,
}

fn tk(c: *PCur) -> *Tok {
  return c.toks[c.pos];
}

fn tkadv(c: *PCur) {
  c.pos = c.pos + 1;
}

fn eat_punct(c: *PCur, ch: u8) -> bool {
  let t = tk(c);
  if t.kind == lex.TK_PUNCT && len(t.text) == 1 && t.text[0] == ch {
    tkadv(c);
    return true;
  }
  return false;
}

fn is_punct(t: *Tok, ch: u8) -> bool {
  return t.kind == lex.TK_PUNCT && len(t.text) == 1 && t.text[0] == ch;
}

// precedence: 1 = + -, 2 = * / %
fn prec(op: u8) -> i32 {
  if op == 43 || op == 45 {
    return 1;
  }
  return 2;
}

fn is_binop(t: *Tok) -> bool {
  if t.kind != lex.TK_PUNCT || len(t.text) != 1 {
    return false;
  }
  let b: u8 = t.text[0];
  return b == 43 || b == 45 || b == 42 || b == 47 || b == 37;
}

// split a format literal into its text pieces around {} holes
fn split_fmt(s: string) -> []string {
  let parts: []string = make([]string, len(s) + 2);
  let mut n: usize = 0;
  let mut start: usize = 0;
  let mut i: usize = 0;
  while i + 1 < len(s) {
    if s[i] == 123 && s[i + 1] == 125 {
      parts[n] = s[start..i];
      n = n + 1;
      start = i + 2;
      i = i + 2;
      continue;
    }
    i = i + 1;
  }
  parts[n] = s[start..len(s)];
  n = n + 1;
  return parts[0..n];
}

pub fn fmt_pieces(s: string) -> []string {
  return split_fmt(s);
}

// primary: INT | STRING | IDENT | ( expr )
fn parse_primary(c: *PCur) -> *Expr {
  let t = tk(c);
  if t.kind == lex.TK_INT {
    tkadv(c);
    return lit(t.ival);
  }
  if t.kind == lex.TK_STR {
    tkadv(c);
    return strlit(t.text);
  }
  if t.kind == lex.TK_IDENT {
    tkadv(c);
    return var(t.text);
  }
  if is_punct(t, 40) {
    tkadv(c);
    let inner = parse_bin(c, 1);
    eat_punct(c, 41);
    return inner;
  }
  // unusable primary: a zero literal keeps the walk alive
  tkadv(c);
  return lit(0);
}

// binary expressions by precedence climbing
fn parse_bin(c: *PCur, min_prec: i32) -> *Expr {
  let mut lhs: *Expr = parse_primary(c);
  while true {
    let t = tk(c);
    if !is_binop(t) {
      break;
    }
    let p: i32 = prec(t.text[0]);
    if p < min_prec {
      break;
    }
    let op: u8 = t.text[0];
    tkadv(c);
    let rhs: *Expr = parse_bin(c, p + 1);
    lhs = bin(op, lhs, rhs);
  }
  return lhs;
}

// one statement: printf(..); | let name = expr; | return expr?;
fn parse_stmt(c: *PCur) -> *Stmt {
  let t = tk(c);
  if t.kind == lex.TK_KEYWORD && t.text == "return" {
    tkadv(c);
    let mut v: i64 = 0;
    let t2 = tk(c);
    if t2.kind == lex.TK_INT {
      v = t2.ival;
      tkadv(c);
    }
    eat_punct(c, 59);
    return new Stmt { tag: ST_RET, fmt: "", args: make([]*Expr, 0),
                      name: "", val: Option.None, ret: v };
  }
  if t.kind == lex.TK_KEYWORD && t.text == "let" {
    tkadv(c);
    let nt = tk(c);
    let mut nm: string = "_";
    if nt.kind == lex.TK_IDENT || nt.kind == lex.TK_KEYWORD {
      nm = nt.text;
      tkadv(c);
    }
    // optional : type
    if is_punct(tk(c), 58) {
      tkadv(c);
      tkadv(c);
    }
    if !eat_punct(c, 61) {
      return new Stmt { tag: ST_RET, fmt: "", args: make([]*Expr, 0),
                        name: "", val: Option.None, ret: 0 - 21 };
    }
    let e = parse_bin(c, 1);
    eat_punct(c, 59);
    return new Stmt { tag: ST_LET, fmt: "", args: make([]*Expr, 0),
                      name: nm, val: Option.Some(e), ret: 0 };
  }
  if (t.kind == lex.TK_IDENT || t.kind == lex.TK_KEYWORD) &&
      t.text == "printf" {
    tkadv(c);
    if !eat_punct(c, 40) {
      return new Stmt { tag: ST_RET, fmt: "", args: make([]*Expr, 0),
                        name: "", val: Option.None, ret: 0 - 22 };
    }
    let ft = tk(c);
    if ft.kind != lex.TK_STR {
      return new Stmt { tag: ST_RET, fmt: "", args: make([]*Expr, 0),
                        name: "", val: Option.None, ret: 0 - 23 };
    }
    tkadv(c);
    let args: []*Expr = make([]*Expr, 8);
    let mut na: usize = 0;
    while eat_punct(c, 44) {
      args[na] = parse_bin(c, 1);
      na = na + 1;
    }
    eat_punct(c, 41);
    eat_punct(c, 59);
    return new Stmt { tag: ST_PF, fmt: ft.text, args: args[0..na],
                      name: "", val: Option.None, ret: 0 };
  }
  // unknown statement: skip a token so the walk makes progress
  tkadv(c);
  return new Stmt { tag: ST_RET, fmt: "", args: make([]*Expr, 0),
                    name: "", val: Option.None, ret: 0 - 100 };
}

pub fn parse(toks: []*Tok, src: string) -> []*Stmt {
  let nodes: []*Stmt = make([]*Stmt, len(src) + 4);
  let mut n: usize = 0;
  let c = new PCur { toks: toks, pos: 0 };
  while tk(c).kind != lex.TK_EOF {
    let t = tk(c);
    if t.kind == lex.TK_KEYWORD && t.text == "fn" {
      tkadv(c);
      let nm = tk(c);
      if nm.kind == lex.TK_KEYWORD || nm.kind == lex.TK_IDENT {
        tkadv(c);
      }
      if nm.text == "main" {
        eat_punct(c, 40);
        eat_punct(c, 41);
        // optional -> i32 (three tokens: '-', '>', the type word)
        if is_punct(tk(c), 45) {
          tkadv(c);
          tkadv(c);
          tkadv(c);
        }
        if eat_punct(c, 123) {
          while tk(c).kind != lex.TK_EOF {
            if is_punct(tk(c), 125) {
              tkadv(c);
              break;
            }
            nodes[n] = parse_stmt(c);
            n = n + 1;
          }
        }
        continue;
      }
      // a non-main fn: skip to its closing brace (skeleton: no calls)
      let mut depth: i32 = 0;
      while tk(c).kind != lex.TK_EOF {
        let t4 = tk(c);
        if is_punct(t4, 123) {
          depth = depth + 1;
        }
        if is_punct(t4, 125) {
          depth = depth - 1;
          tkadv(c);
          if depth <= 0 {
            break;
          }
          continue;
        }
        tkadv(c);
      }
      continue;
    }
    tkadv(c);
  }
  return nodes[0..n];
}
