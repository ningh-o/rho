// full.rho — the complete toolchain's package root: every target, wasm
// and native, through the native pipe. `main` must live in the root file,
// and this is it; the driver itself is cli.rho's run(). The gate builds
// THIS root as build/gate/m.wasm, and the self-chain legs build it again.
use cli;
use native/pipe;

fn main() -> i32 {
  let rc: i32 = cli.run();
  if rc == cli.RC_NATIVE {
    return pipe.pipe_emit(cli.g_req_target, cli.g_req_out);
  }
  return rc;
}
