// emit.rho — the self-hosted compiler's wasm emitter (T2.2 growth).
// Statements: printf pieces ride a string pool, integer expressions
// compile to i64 stack code into _start locals (let bindings get one
// local each), and the generated module carries the decimal runtime.
use parse;
use lex;

pub struct Pool {
  segs: []string, // raw spans (escapes still encoded)
  lens: []i64,    // decoded byte lengths
  addrs: []i64,
  n: usize,
  next: i64,
  gi: *GenInsts, // the generic-instantiation worklist (set by emit)
  rel_names: []string, // release-thunk registry (per managed type)
  rel_texts: []string, // their emitted WAT
  rel_n: usize,
}

// generic instantiation registry: each distinct (fn, type key) pair
// clones the fn with its type parameters bound; the worklist drains
// after the user's fns (an instantiation may call more generics).
// Closure entries ride here too: bases "clo:<wat>" with the body,
// captures, and params in the parallel arrays, emitted by
// emit_closure_fn instead of emit_fn
struct GenInsts {
  bases: []string, // the generic fn's name (or "clo:<wat name>")
  keys: []string,  // the mangled type key
  sufs: []string,  // the wasm suffix riding the fn name
  fds: []*FnDef,   // the substituted clones (closure entries: none)
  clo_fds: []*FnDef, // closure carriers: .body holds the literal's
                     // statements (a field assign, not an index)
  clo_caps: []string,  // closure capture names (8 per entry, base idx*8)
  clo_params: []string, // closure param names (8 per entry)
  ids: []i64,        // per entry: the closure's table idx (0 generic)
  n: usize,
  cfn: usize,      // closure table entries (names in clo_wasms)
  clo_wasms: []string,
  clo_ty: []i64,   // indirect-call arity flags: +1 scalar result,
                   // +2 pair result — [1]=fn(), [2]=fn(x), [3]=fn(x,y)
}

fn clo_ty_need(gi: *GenInsts, ari: i64, kind: i64) {
  if ari < 1 || ari > 3 {
    return;
  }
  let old: i64 = gi.clo_ty[ari as usize];
  if kind == 1 {
    if old == 0 || old == 2 {
      gi.clo_ty[ari as usize] = old + 1;
    }
  } else {
    if old == 0 || old == 1 {
      gi.clo_ty[ari as usize] = old + 2;
    }
  }
}

fn ginsts_new() -> *GenInsts {
  return new GenInsts { bases: make([]string, 512), keys: make([]string, 512),
                        sufs: make([]string, 512), fds: make([]*FnDef, 512),
                        clo_fds: make([]*FnDef, 512),
                        clo_caps: make([]string, 4096),
                        clo_params: make([]string, 4096),
                        ids: make([]i64, 512),
                        n: 0, cfn: 0,
                        clo_wasms: make([]string, 512),
                        clo_ty: make([]i64, 4) };
}

pub fn new_pool() -> *Pool {
  return new Pool { segs: make([]string, 2048), lens: make([]i64, 2048),
                    addrs: make([]i64, 2048), n: 0, next: 4104,
                    gi: ginsts_new(),
                    rel_names: make([]string, 2048),
                    rel_texts: make([]string, 2048), rel_n: 0 };
}

// a hex digit's value, -1 when not hex
fn hex_val(b: u8) -> i64 {
  if b >= 48 && b <= 57 {
    return (b as i64) - 48;
  }
  if b >= 97 && b <= 102 {
    return (b as i64) - 87;
  }
  if b >= 65 && b <= 70 {
    return (b as i64) - 55;
  }
  return 0 - 1;
}

// the utf-8 byte length of a code point
fn utf8_len(cp: i64) -> i64 {
  if cp < 128 {
    return 1;
  }
  if cp < 2048 {
    return 2;
  }
  if cp < 65536 {
    return 3;
  }
  return 4;
}

// decoded byte count of a raw span (the full escape law: \n \r \t
// \\ \" \0 \xHH \u{…})
fn decoded_len(raw: string) -> i64 {
  let mut n: i64 = 0;
  let mut i: usize = 0;
  while i < len(raw) {
    if raw[i] == 92 && i + 1 < len(raw) {
      let e: u8 = raw[i + 1];
      if e == 120 && i + 3 < len(raw) {
        i = i + 4; // \xHH
      } else {
        if e == 117 {
          // \u{hex…}
          let mut j: usize = i + 3;
          let mut cp: i64 = 0;
          while j < len(raw) && raw[j] != 125 {
            let h: i64 = hex_val(raw[j]);
            if h < 0 {
              break;
            }
            cp = cp * 16 + h;
            j = j + 1;
          }
          n = n + utf8_len(cp) - 1;
          i = j + 1;
          n = n + 1;
          continue;
        } else {
          i = i + 2;
        }
      }
    } else {
      i = i + 1;
    }
    n = n + 1;
  }
  return n;
}

pub fn pool_intern(p: *Pool, raw: string) -> i64 {
  let mut i: usize = 0;
  while i < p.n {
    if p.segs[i] == raw {
      return p.addrs[i];
    }
    i = i + 1;
  }
  p.segs[p.n] = raw;
  p.lens[p.n] = decoded_len(raw);
  p.addrs[p.n] = p.next;
  p.n = p.n + 1;
  p.next = p.next + p.lens[p.n - 1] + 1;
  return p.addrs[p.n - 1];
}

pub fn pool_len(p: *Pool, raw: string) -> i64 {
  let mut i: usize = 0;
  while i < p.n {
    if p.segs[i] == raw {
      return p.lens[i];
    }
    i = i + 1;
  }
  return 0;
}

// the WAT data-segment body for a raw span: escapes decoded, every
// byte spelled \xx (wasm data escapes)
fn hex_digit(v: u8) -> string {
  let s: string = "0123456789abcdef";
  return s[(v as usize)..((v as usize) + 1)];
}

fn byte_escape(b: u8) -> string {
  return "\\" + hex_digit(b >> 4) + hex_digit(b & 15);
}

// one code point's utf-8 bytes as \\xx escapes
fn utf8_escape(cp: i64) -> string {
  let out: string = "";
  if cp < 128 {
    return byte_escape((cp as u8));
  }
  if cp < 2048 {
    return byte_escape(((((cp >> 6) as u64) as u8)) | 192) +
           byte_escape(((cp & 63) as u8) | 128);
  }
  if cp < 65536 {
    return byte_escape(((cp >> 12) as u8) | 224) +
           byte_escape((((cp >> 6) & 63) as u8) | 128) +
           byte_escape(((cp & 63) as u8) | 128);
  }
  return byte_escape(((cp >> 18) as u8) | 240) +
         byte_escape((((cp >> 12) & 63) as u8) | 128) +
         byte_escape((((cp >> 6) & 63) as u8) | 128) +
         byte_escape(((cp & 63) as u8) | 128);
}

pub fn wat_data_body(raw: string) -> string {
  let mut out: string = "";
  let mut i: usize = 0;
  while i < len(raw) {
    let b: u8 = raw[i];
    if b == 92 && i + 1 < len(raw) {
      let e: u8 = raw[i + 1];
      if e == 114 {
        out = out + byte_escape(13); // \r
        i = i + 2;
        continue;
      }
      if e == 48 {
        out = out + byte_escape(0); // \0
        i = i + 2;
        continue;
      }
      if e == 120 && i + 3 < len(raw) {
        let hi: i64 = hex_val(raw[i + 2]);
        let lo: i64 = hex_val(raw[i + 3]);
        let v: i64 = hi * 16 + lo;
        out = out + byte_escape((v as u8)); // \xHH
        i = i + 4;
        continue;
      }
      if e == 117 {
        let mut j: usize = i + 3;
        let mut cp: i64 = 0;
        while j < len(raw) && raw[j] != 125 {
          let h: i64 = hex_val(raw[j]);
          if h < 0 {
            break;
          }
          cp = cp * 16 + h;
          j = j + 1;
        }
        out = out + utf8_escape(cp); // \u{…}
        i = j + 1;
        continue;
      }
      let v: u8 = match e {
        110 => 10,
        116 => 9,
        92 => 92,
        34 => 34,
        _ => e,
      };
      out = out + byte_escape(v);
      i = i + 2;
      continue;
    }
    out = out + byte_escape(b);
    i = i + 1;
  }
  return out;
}

// the decimal runtime the generated module carries: $w_i64 writes
// |v|'s digits backward into [2048, 4096) and returns {addr, len}
const BOOLTEXT: string = """
  (func $w_bool (param $v i64) (result i32) (result i32)
    (if (result i32) (i64.ne (local.get $v) (i64.const 0))
      (then (i32.const 4030))
      (else (i32.const 4034)))
    (if (result i32) (i64.ne (local.get $v) (i64.const 0))
      (then (i32.const 4))
      (else (i32.const 5)))
  )
""";

const UINT: string = """
  (func $w_u64 (param $v i64) (result i32) (result i32)
    (local $p i32) (local $u i64)
    (local.set $p (i32.const 4096))
    (local.set $u (local.get $v))
    (loop $d
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p)
        (i32.wrap_i64 (i64.add (i64.rem_u (local.get $u)
                             (i64.const 10)) (i64.const 48))))
      (local.set $u (i64.div_u (local.get $u) (i64.const 10)))
      (br_if $d (i64.ne (local.get $u) (i64.const 0)))
    )
    (local.get $p)
    (i32.sub (global.get $w_top) (local.get $p))
  )
""";

const CAT: string = """
  (func $w_cat (param $ap i64) (param $al i64) (param $bp i64)
                (param $bl i64) (result i64) (result i64)
    (local $p i32) (local $i i64) (local $n i64)
    (local.set $n (i64.add (local.get $al) (local.get $bl)))
    (local.set $p
      (call $w_alloc
        (i32.wrap_i64 (i64.div_u (i64.add (local.get $n)
                                          (i64.const 7))
                                  (i64.const 8)))))
    (local.set $i (i64.const 0))
    (loop $c1
      (if (i64.lt_u (local.get $i) (local.get $al))
        (then
          (i32.store8
            (i32.add (local.get $p)
                     (i32.wrap_i64 (local.get $i)))
            (i32.load8_u (i32.wrap_i64 (i64.add (local.get $ap)
                                                (local.get $i)))))
          (local.set $i (i64.add (local.get $i) (i64.const 1)))
          (br $c1))))
    (local.set $i (i64.const 0))
    (loop $c2
      (if (i64.lt_u (local.get $i) (local.get $bl))
        (then
          (i32.store8
            (i32.add (local.get $p)
                     (i32.wrap_i64 (i64.add (local.get $al)
                                            (local.get $i))))
            (i32.load8_u (i32.wrap_i64 (i64.add (local.get $bp)
                                                (local.get $i)))))
          (local.set $i (i64.add (local.get $i) (i64.const 1)))
          (br $c2))))
    (i64.extend_i32_u (local.get $p))
    (local.get $n)
  )
""";

// $w_itoa: an integer rendered into a fresh allocation {ptr,len};
// digits write backward from the buffer's end (32 bytes: 20 digits
// plus sign is the i64 worst case)
const ITOA: string = """
  (func $w_itoa (param $v i64) (result i64) (result i64)
    (local $b i32) (local $p i32) (local $neg i32) (local $u i64)
    (local.set $neg (i64.lt_s (local.get $v) (i64.const 0)))
    (local.set $u
      (if (result i64) (local.get $neg)
        (then (i64.sub (i64.const 0) (local.get $v)))
        (else (local.get $v))))
    (local.set $b (call $w_alloc (i32.const 4)))
    (local.set $p (i32.add (local.get $b) (i32.const 32)))
    (loop $d
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p)
        (i32.wrap_i64 (i64.add (i64.rem_u (local.get $u)
                             (i64.const 10)) (i64.const 48))))
      (local.set $u (i64.div_u (local.get $u) (i64.const 10)))
      (br_if $d (i64.ne (local.get $u) (i64.const 0))))
    (if (local.get $neg)
      (then
        (local.set $p (i32.sub (local.get $p) (i32.const 1)))
        (i32.store8 (local.get $p) (i32.const 45))))
    (i64.extend_i32_u (local.get $p))
    (i64.extend_i32_u
      (i32.sub (i32.add (local.get $b) (i32.const 32)) (local.get $p)))
  )
""";

const STREQ: string = """
  (func $w_streq (param $ap i64) (param $al i64) (param $bp i64) (param $bl i64) (result i64)
    (local $i i64)
    (if (i64.ne (local.get $al) (local.get $bl))
      (then (return (i64.const 0))))
    (loop $c
      (if (i64.ge_u (local.get $i) (local.get $al))
        (then (return (i64.const 1))))
      (if (i32.ne (i32.load8_u (i32.wrap_i64 (i64.add (local.get $ap) (local.get $i))))
                (i32.load8_u (i32.wrap_i64 (i64.add (local.get $bp) (local.get $i)))))
        (then (return (i64.const 0))))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br $c)
    )
    (i64.const 1)
  )
""";

// element-wise enum equality: tag and payload slots as plain i64s
// (string-payload enums grow a content-compare when they appear)
const ENUQ: string = """
  (func $w_enuq (param $ap i64) (param $bp i64) (param $n i64) (result i64)
    (local $i i64)
    (loop $c
      (if (i64.ge_u (local.get $i) (local.get $n))
        (then (return (i64.const 1))))
      (if (i64.ne (i64.load (i32.add (i32.wrap_i64 (local.get $ap))
                               (i32.mul (i32.wrap_i64 (local.get $i))
                                        (i32.const 8))))
                  (i64.load (i32.add (i32.wrap_i64 (local.get $bp))
                               (i32.mul (i32.wrap_i64 (local.get $i))
                                        (i32.const 8)))))
        (then (return (i64.const 0))))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br $c)
    )
    (i64.const 1)
  )
""";

const RUNTIME: string = """
  (global $w_top (mut i32) (i32.const 4096))
  (func $w_i64 (param $v i64) (result i32) (result i32)
    (local $p i32) (local $neg i32) (local $u i64)
    (local.set $p (i32.const 4096))
    (local.set $neg (i64.lt_s (local.get $v) (i64.const 0)))
    (local.set $u
      (if (result i64) (local.get $neg)
        (then (i64.sub (i64.const 0) (local.get $v)))
        (else (local.get $v))))
    (loop $d
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p)
        (i32.wrap_i64 (i64.add (i64.rem_u (local.get $u)
                             (i64.const 10)) (i64.const 48))))
      (local.set $u (i64.div_u (local.get $u) (i64.const 10)))
      (br_if $d (i64.ne (local.get $u) (i64.const 0)))
    )
    (if (local.get $neg)
      (then (local.set $p (i32.sub (local.get $p) (i32.const 1)))
            (i32.store8 (local.get $p) (i32.const 45))))
    (local.get $p)
    (i32.sub (global.get $w_top) (local.get $p))
  )
""";

// the zeroed bump allocator and the panic exit (allocations grow
// down from 65528; the digit scratch owns [~4076, 4096) and the
// string pool grows up from 1024 — corpus scale never crosses)
// the shared zeroed None box: every fresh Option slot points at it
// (immutable payloads make sharing safe)
const NONEBOX: string = """
  (global $w_none_box (mut i64) (i64.const 0))
""";

const ALLOC: string = """
  (global $w_alloc_top (mut i32) (i32.const 65528))
  (global $w_floor (mut i32) (i32.const 4096))
  (func $w_alloc (param $n i32) (result i32)
    (local $p i32) (local $k i32) (local $old i32)
    (global.set $w_alloc_top
      (i32.sub (global.get $w_alloc_top)
               (i32.mul (i32.add (local.get $n) (i32.const 1))
                        (i32.const 8))))
    (if (i32.lt_u (global.get $w_alloc_top) (global.get $w_floor))
      (then
        ;; the bump would cross the floor: grow, then carve ONLY the
        ;; fresh pages (the floor rises to the old end — a downward
        ;; march from the new top must never reenter lived-in pages)
        (local.set $old (memory.size))
        (local.set $k
          (i32.add
            (i32.div_u
              (i32.add (i32.mul (i32.add (local.get $n) (i32.const 1))
                                (i32.const 8))
                       (i32.const 65536))
              (i32.const 65536))
            (i32.const 1)))
        (drop (memory.grow (local.get $k)))
        (global.set $w_floor
          (i32.mul (local.get $old) (i32.const 65536)))
        (global.set $w_alloc_top
          (i32.sub (i32.mul (memory.size) (i32.const 65536))
                   (i32.mul (i32.add (local.get $n) (i32.const 1))
                            (i32.const 8))))))
    (local.set $p (global.get $w_alloc_top))
    ;; the header slot sits before the returned pointer: rc = 1
    (i64.store (local.get $p) (i64.const 1))
    (local.set $k (i32.const 0))
    (loop $z
      (if (i32.lt_u (local.get $k) (local.get $n))
        (then
          (i64.store
            (i32.add (local.get $p)
                     (i32.mul (i32.add (local.get $k) (i32.const 1))
                              (i32.const 8)))
            (i64.const 0))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $z))))
    (i32.add (local.get $p) (i32.const 8))
  )
  (func $w_retain (param $p i64)
    (if (i64.ne (local.get $p) (i64.const 0))
      (then
        (i64.store (i32.sub (i32.wrap_i64 (local.get $p)) (i32.const 8))
                   (i64.add
                     (i64.load (i32.sub (i32.wrap_i64 (local.get $p))
                                        (i32.const 8)))
                     (i64.const 1)))))
  )
  (func $w_alive (param $p i64) (result i32)
    (if (i64.ne (local.get $p) (i64.const 0))
      (then
        (return (i32.wrap_i64
          (i64.load (i32.sub (i32.wrap_i64 (local.get $p))
                             (i32.const 8))))))
      (else (return (i32.const 0))))
    (i32.const 0)
  )
  (func $w_panic (param $m i32) (param $l i32)
    (i32.store (i32.const 64) (local.get $m))
    (i32.store (i32.const 68) (local.get $l))
    (drop (call $fd_write (i32.const 2) (i32.const 64)
                          (i32.const 1) (i32.const 96)))
    (call $proc_exit (i32.const 101))
  )
""";

// the OOB bounds check: the index rides $t, len_text is the length
// operand (a local.get or an i64.const). Indices are strict
// (i >= len panics); slice ends may equal len (an empty tail slice)
fn oob_check_at(pool: *Pool, len_text: string, strict: bool) -> string {
  let msg_addr: i64 = pool_intern(pool, "index out of bounds");
  let mut cmp: string = "i64.ge_u";
  if !strict {
    cmp = "i64.gt_u";
  }
  return "    (if (" + cmp + " (local.get $t) " + len_text + ")\n" +
         "      (then (call $w_panic (i32.const " + msg_addr.to_str() +
         ") (i32.const 19))))\n";
}

fn oob_check(pool: *Pool, len_text: string) -> string {
  return oob_check_at(pool, len_text, true);
}

// one fd_write of nbytes at addr: the iovec cell pair at 64/68
fn write_call(addr: i64, nbytes: i64) -> string {
  return write_fd(addr, nbytes, 1);
}

fn write_fd(addr: i64, nbytes: i64, fd: i64) -> string {
  let out: string = "    (i32.store (i32.const 64) (i32.const " +
                    addr.to_str() + "))\n" +
                    "    (i32.store (i32.const 68) (i32.const " +
                    nbytes.to_str() + "))\n" +
                    "    (drop (call $fd_write (i32.const " + fd.to_str() +
                    ") " +
                    "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
  return out;
}

// a 0/1 i64 rides the stack: route it through $w_bool and write the
// spelled word (true/false) — the same capture pair write_int uses
fn write_bool_top() -> string {
  return "    call $w_bool\n" +
         "    (local.set $l)\n" +
         "    (local.set $a)\n" +
         "    (i32.store (i32.const 64) (local.get $a))\n" +
         "    (i32.store (i32.const 68) (local.get $l))\n" +
         "    (drop (call $fd_write (i32.const 1) " +
         "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
}

// unsigned print: the value rides the stack into $w_u64
fn write_uint() -> string {
  return "    call $w_u64\n" +
         "    (local.set $l)\n" +
         "    (local.set $a)\n" +
         "    (i32.store (i32.const 64) (local.get $a))\n" +
         "    (i32.store (i32.const 68) (local.get $l))\n" +
         "    (drop (call $fd_write (i32.const 1) " +
         "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
}

// one fd_write of a runtime-formatted integer: $w_i64 leaves
// {addr, len} on the stack; the locals capture the pair
fn write_int() -> string {
  // flat call: the expression's i64 rides the stack below it
  let out: string = "    call $w_i64\n" +
                    "    (local.set $l)\n" +
                    "    (local.set $a)\n" +
                    "    (i32.store (i32.const 64) (local.get $a))\n" +
                    "    (i32.store (i32.const 68) (local.get $l))\n" +
                    "    (drop (call $fd_write (i32.const 1) " +
                    "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
  return out;
}

// the let environment: names to _start local slots, plus a string
// table (immutable strings pool; a binding remembers addr and len)
struct Env {
  names: []string,
  slots: []i64,
  vwidths: []i64, // per local: 0 lane-wide, else ±8/±16/±32 (neg = unsigned)
  sptr: []string, // the struct name where the binding holds a *T
  senum: []string, // the enum name where the binding holds a value
  sval: []string, // the struct name where the binding holds a VALUE
  vbases: []i64,  // the value frame's base local slot
  n: usize,
  snames: []string,
  saddrs: []i64,
  slens: []i64,
  sraws: []string,
  skinds: []i64, // 0 folded string, 1 runtime string pair, 2 slice pair
  sn: usize,
  fkind: []i64,     // per binding: 0 int, 1 f64, 2 f32
  selnames: []string, // slice bindings' element texts (a small stack)
  selvals: []string,  // the element's type text
  sel_n: usize,       // the slice-element stack depth
  // the enclosing fn context (an expression-position match emits
  // statement-bearing arm bodies through it)
  infn: bool,
  retslot: i64,
  loops: *Loops,
  dstack: *DStack,
  tfd: ?*FnDef,
}

fn env_bool_bind(e: *Env, name: string) {
  e.snames[e.sn] = name + "#b";
  e.saddrs[e.sn] = 0 - 1000; // bool marker
  e.slens[e.sn] = 0;
  e.sraws[e.sn] = "";
  e.skinds[e.sn] = 0 - 1;
  e.sn = e.sn + 1;
}

fn env_bool_is(e: *Env, name: string) -> bool {
  let want: string = name + "#b";
  let mut i: usize = 0;
  while i < e.sn {
    if e.snames[i] == want {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn env_new(cap: usize) -> *Env {
  return new Env { names: make([]string, cap), slots: make([]i64, cap),
                   vwidths: make([]i64, cap),
                   sptr: make([]string, cap),
                   senum: make([]string, cap),
                   sval: make([]string, cap),
                   vbases: make([]i64, cap),
                   n: 0, snames: make([]string, cap),
                   saddrs: make([]i64, cap), slens: make([]i64, cap),
                   sraws: make([]string, cap),
                   skinds: make([]i64, cap), sn: 0,
                   fkind: make([]i64, cap),
                   selnames: make([]string, 16),
                   selvals: make([]string, 16),
                   sel_n: 0,
                   infn: false, retslot: 0 - 1,
                   loops: loops_new(), dstack: dstack_new(),
                   tfd: Option.None };
}

fn env_str_look(e: *Env, name: string) -> i64 {
  let mut i: usize = e.sn;
  while i > 0 {
    if e.snames[i - 1] == name {
      return e.saddrs[i - 1];
    }
    i = i - 1;
  }
  return 0 - 1;
}

// a runtime pair binding (a string or a slice): addr/len ride a
// LOCAL PAIR (slots are negative markers: the pair starts at
// -1 - addr); kind tells strings from slices at index time
fn env_str_bind_runtime(e: *Env, name: string, addr_slot: i64,
                        len_slot: i64, kind: i64) {
  e.snames[e.sn] = name;
  e.saddrs[e.sn] = (0 - addr_slot) - 1; // negative: runtime pair
  e.slens[e.sn] = len_slot;
  e.sraws[e.sn] = "";
  e.skinds[e.sn] = kind;
  e.sn = e.sn + 1;
}

fn env_str_is_runtime(e: *Env, name: string) -> bool {
  let mut i: usize = e.sn;
  while i > 0 {
    if e.snames[i - 1] == name {
      return e.saddrs[i - 1] < 0; // negative marker = runtime pair
    }
    i = i - 1;
  }
  return false; // not a string at all
}

// one fd_write from a runtime {ptr, len} local pair
fn write_runtime(a_slot: i64, l_slot: i64) -> string {
  let out: string = "    (i32.store (i32.const 64) " +
                    "(i32.wrap_i64 (local.get " + a_slot.to_str() +
                    ")))\n" +
                    "    (i32.store (i32.const 68) " +
                    "(i32.wrap_i64 (local.get " + l_slot.to_str() +
                    ")))\n" +
                    "    (drop (call $fd_write (i32.const 1) " +
                    "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
  return out;
}

// push a string expression's {addr, len} pair onto the i64 stack:
// folded literals become constants; runtime vars local.get the pair
fn push_string(pool: *Pool, e: *Expr, env: *Env, prog: *Prog,
                nl: *NextLocal) -> string {
  // a string ELEMENT: the pair loads at the slice's 16-byte stride
  // (bounds-checked like every element read)
  if e.tag == parse.EX_IDX {
    let spx = build_string_pair(e, pool, env, prog, nl);
    if spx.ok {
      return spx.text + "    (local.get " + spx.a.to_str() +
             ")\n    (local.get " + spx.l.to_str() + ")\n";
    }
    return "    (i64.const 0)\n    (i64.const 0)\n";
  }
  // a string FIELD: the pair rides the value frame or the heap
  if e.tag == parse.EX_FIELD {
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    let bt: string = field_base_type(base, env, prog);
    if len(bt) > 0 {
      let si: i64 = st_index(prog, bt);
      let fi: i64 = st_field_index(prog, si, e.name);
      if fi >= 0 &&
          type_kind(prog.structs[si as usize].types[fi as usize]) == 1 {
        let off: i64 = st_field_off(prog, si, fi) * 8;
        if base.tag == parse.EX_VAR && len(env_val_of(env, base.name)) > 0 {
          let b0: i64 = env_val_base(env, base.name);
          return "    (local.get " + (b0 + off / 8).to_str() + ")\n" +
                 "    (local.get " + (b0 + off / 8 + 1).to_str() + ")\n";
        }
        let t0: i64 = nl.v;
        nl.v = nl.v + 1;
        let mut out: string = emit_expr(pool, base, env, prog, nl);
        out = out + "    (local.set " + t0.to_str() + ")\n";
        out = out + "    (i64.load (i32.add (i32.wrap_i64 (local.get " +
               t0.to_str() + ")) (i32.const " + off.to_str() + ")))\n";
        out = out + "    (i64.load (i32.add (i32.wrap_i64 (local.get " +
               t0.to_str() + ")) (i32.const " + (off + 8).to_str() +
               ")))\n";
        return out;
      }
    }
    return "    (i64.const 0)\n    (i64.const 0)\n";
  }
  match fold_string(e, env) {
    Option.Some(raw) => {
      let saddr: i64 = pool_intern(pool, raw);
      return "    (i64.const " + saddr.to_str() + ")\n" +
             "    (i64.const " + pool_len(pool, raw).to_str() + ")\n";
    },
    Option.None => {
      if e.tag == parse.EX_VAR && str_static_is(prog, e.name) {
        // a string static reads its global pair
        return "    (global.get $g_" + e.name + ")\n" +
               "    (global.get $g_" + e.name + "_l)\n";
      }
      let a: i64 = env_str_look(env, e.name);
      if a < 0 {
        let lslot: i64 = env_str_len_slot(env, e.name);
        return "    (local.get " + ((0 - a) - 1).to_str() + ")\n" +
               "    (local.get " + lslot.to_str() + ")\n";
      }
      return "    (i64.const 0)\n    (i64.const 0)\n";
    },
  }
}

// one call argument: a string/slice-valued expression takes the
// {addr,len} pair; everything else is the plain i64 expression (an
// integer variable or an int + must NOT ride the pair path — the
// old router sent every variable and every + through push_string,
// and its not-found fallback spelled a bogus local.get 0 pair)
fn emit_arg(pool: *Pool, e: *Expr, env: *Env, prog: *Prog,
            nl: *NextLocal) -> string {
  if e.tag == parse.EX_ARR {
    return emit_array(pool, e, env, prog, nl);
  }
  if e.tag == parse.EX_VAR && env_kind_of(env, e.name) < 0 &&
      env_look(env, e.name) < 0 && !name_is_const(prog, e.name) &&
      len(static_global(prog, e.name)) == 0 &&
      user_fn_exists(prog, e.name) && e.lit != 0 - 99 {
    // a plain fn referenced as a VALUE: a trampoline wraps the box
    // param around the call, the value is (idx, null box)
    let tfd: *FnDef = fn_def_of(prog, e.name);
    let tname: string = "__tr_" + e.name;
    let mut already: i64 = 0 - 1;
    let mut ti: usize = 0;
    while ti < pool.gi.n {
      if pool.gi.sufs[ti] == tname {
        already = pool.gi.ids[ti];
      }
      ti = ti + 1;
    }
    if already < 0 {
      let tparams: []string = make([]string, 9);
      let tptypes: []string = make([]string, 9);
      tparams[0] = "__b";
      tptypes[0] = "i64";
      let cargs: []*Expr = make([]*Expr, 8);
      let mut pk: usize = 0;
      while pk < len(tfd.params) && pk < 8 {
        tparams[pk + 1] = tfd.params[pk];
        if pk < len(tfd.ptypes) {
          tptypes[pk + 1] = tfd.ptypes[pk];
        } else {
          tptypes[pk + 1] = "";
        }
        cargs[pk] = parse.var(tfd.params[pk]);
        pk = pk + 1;
      }
      let callx = parse.call(e.name, cargs[0..len(tfd.params)]);
      let rstmt = parse.ret_stmt(callx);
      let tbd: []*Stmt = make([]*Stmt, 1);
      tbd[0] = rstmt;
      let tramp = parse.clone_fndef(tfd);
      tramp.name = tname;
      tramp.params = tparams[0..(len(tfd.params) + 1)];
      tramp.ptypes = tptypes[0..(len(tfd.params) + 1)];
      tramp.pstr = make([]bool, 0);
      tramp.pslc = make([]bool, 0);
      tramp.pvar = make([]bool, 0);
      tramp.tparams = make([]string, 0);
      tramp.body = tbd;
      let gi_t: usize = pool.gi.n;
      pool.gi.bases[gi_t] = e.name;
      pool.gi.keys[gi_t] = "";
      pool.gi.sufs[gi_t] = tname;
      pool.gi.fds[gi_t] = tramp;
      pool.gi.ids[gi_t] = pool.gi.cfn as i64;
      pool.gi.n = pool.gi.n + 1;
      pool.gi.clo_wasms[pool.gi.cfn] = "$u_" + tname;
      pool.gi.cfn = pool.gi.cfn + 1;
      let tari: i64 = 1 + (len(tfd.params) as i64);
      clo_ty_need(pool.gi, tari, 1);
      already = pool.gi.cfn as i64 - 1;
    }
    return "    (i64.const " + already.to_str() + ")\n" +
           "    (i64.const 0)\n";
  }
  if e.tag == parse.EX_STR {
    return push_string(pool, e, env, prog, nl);
  }
  if e.tag == parse.EX_VAR && env_kind_of(env, e.name) >= 0 {
    return push_string(pool, e, env, prog, nl);
  }
  // any other string-buildable expression — a slice view, a runtime
  // concat, a string-returning call — rides its built pair; ints and
  // pointers refuse the build cleanly and fall to the scalar lane
  let sps = build_string_pair(e, pool, env, prog, nl);
  if sps.ok {
    return sps.text + "    (local.get " + sps.a.to_str() +
           ")\n    (local.get " + sps.l.to_str() + ")\n";
  }
  if e.tag == parse.EX_BIN && e.op == 0 {
    match fold_string(e, env) {
      Option.Some(raw) => {
        let saddr: i64 = pool_intern(pool, raw);
        return "    (i64.const " + saddr.to_str() + ")\n" +
               "    (i64.const " + pool_len(pool, raw).to_str() + ")\n";
      },
      Option.None => {},
    }
  }
  return emit_expr(pool, e, env, prog, nl);
}

fn env_str_len_slot(e: *Env, name: string) -> i64 {
  let mut i: usize = e.sn;
  while i > 0 {
    if e.snames[i - 1] == name {
      return e.slens[i - 1];
    }
    i = i - 1;
  }
  return 0;
}

fn env_str_len(e: *Env, name: string) -> i64 {
  let mut i: usize = e.sn;
  while i > 0 {
    if e.snames[i - 1] == name {
      return e.slens[i - 1];
    }
    i = i - 1;
  }
  return 0;
}

fn env_str_raw(e: *Env, name: string) -> ?string {
  let mut i: usize = e.sn;
  while i > 0 {
    if e.snames[i - 1] == name {
      if e.saddrs[i - 1] < 0 {
        return Option.None; // runtime pair: no folded text exists
      }
      return Option.Some(e.sraws[i - 1]);
    }
    i = i - 1;
  }
  return Option.None;
}

fn env_str_bind(e: *Env, name: string, addr: i64, ln: i64, raw: string) {
  e.snames[e.sn] = name;
  e.saddrs[e.sn] = addr;
  e.slens[e.sn] = ln;
  e.sraws[e.sn] = raw;
  e.skinds[e.sn] = 0;
  e.sn = e.sn + 1;
}

// the kind of a name's string-table entry, -1 when absent
fn env_kind_of(e: *Env, name: string) -> i64 {
  let mut i: usize = e.sn;
  while i > 0 {
    if e.snames[i - 1] == name {
      return e.skinds[i - 1];
    }
    i = i - 1;
  }
  return 0 - 1;
}

// decoded text of a raw span (for folding literal concatenations)
fn decoded_text(raw: string) -> string {
  let buf: []u8 = make([]u8, len(raw));
  let mut o: usize = 0;
  let mut i: usize = 0;
  while i < len(raw) {
    if raw[i] == 92 && i + 1 < len(raw) {
      let e2: u8 = raw[i + 1];
      buf[o] = match e2 {
        110 => 10,
        116 => 9,
        92 => 92,
        34 => 34,
        _ => e2,
      };
      i = i + 2;
    } else {
      buf[o] = raw[i];
      i = i + 1;
    }
    o = o + 1;
  }
  // re-encode as a raw span (identities round-trip)
  return raw;
}

fn env_look(e: *Env, name: string) -> i64 {
  let mut i: usize = e.n;
  while i > 0 {
    if e.names[i - 1] == name {
      return e.slots[i - 1];
    }
    i = i - 1;
  }
  return 0 - 1;
}

fn env_bind(e: *Env, name: string, slot: i64) {
  e.names[e.n] = name;
  e.slots[e.n] = slot;
  e.vwidths[e.n] = 0;
  e.sptr[e.n] = "";
  e.senum[e.n] = "";
  e.sval[e.n] = "";
  e.vbases[e.n] = 0;
  e.fkind[e.n] = 0;
  e.n = e.n + 1;
}

// a float binding: kind 1 f64, 2 f32 (f32 rides f64 storage with
// demote-after-op rounding — the exact f32 semantics)
fn env_bind_f(e: *Env, name: string, slot: i64, kind: i64) {
  e.names[e.n] = name;
  e.slots[e.n] = slot;
  e.vwidths[e.n] = 0;
  e.sptr[e.n] = "";
  e.senum[e.n] = "";
  e.sval[e.n] = "";
  e.vbases[e.n] = 0;
  e.fkind[e.n] = kind;
  e.n = e.n + 1;
}

fn env_fkind_of(e: *Env, name: string) -> i64 {
  let mut i: usize = e.n;
  while i > 0 {
    if e.names[i - 1] == name {
      return e.fkind[i - 1];
    }
    i = i - 1;
  }
  return 0;
}

// a value binding: the fields live in a consecutive local frame
fn env_bind_val(e: *Env, name: string, base: i64, sname: string) {
  e.names[e.n] = name;
  e.slots[e.n] = base;
  e.vwidths[e.n] = 0;
  e.sptr[e.n] = "";
  e.senum[e.n] = "";
  e.sval[e.n] = sname;
  e.vbases[e.n] = base;
  e.n = e.n + 1;
}

fn env_bind_w(e: *Env, name: string, slot: i64, w: i64) {
  e.names[e.n] = name;
  e.slots[e.n] = slot;
  e.vwidths[e.n] = w;
  e.sptr[e.n] = "";
  e.senum[e.n] = "";
  e.sval[e.n] = "";
  e.vbases[e.n] = 0;
  e.n = e.n + 1;
}

// a pointer binding: the slot holds a *SName heap address
fn env_bind_ptr(e: *Env, name: string, slot: i64, sname: string) {
  e.names[e.n] = name;
  e.slots[e.n] = slot;
  e.vwidths[e.n] = 0;
  e.sptr[e.n] = sname;
  e.senum[e.n] = "";
  e.sval[e.n] = "";
  e.vbases[e.n] = 0;
  e.n = e.n + 1;
}

// an enum-value binding: the slot holds the box address
fn env_bind_enum(e: *Env, name: string, slot: i64, ename: string) {
  e.names[e.n] = name;
  e.slots[e.n] = slot;
  e.vwidths[e.n] = 0;
  e.sptr[e.n] = "";
  e.senum[e.n] = ename;
  e.sval[e.n] = "";
  e.vbases[e.n] = 0;
  e.n = e.n + 1;
}

fn env_enum_of(e: *Env, name: string) -> string {
  let mut i: usize = e.n;
  while i > 0 {
    if e.names[i - 1] == name {
      return e.senum[i - 1];
    }
    i = i - 1;
  }
  return "";
}

fn env_bind_sliceelem(e: *Env, name: string, etext: string) {
  // a small stack: later bindings shadow, but a second slice in the
  // same scope never clobbers the first's element text (selnames[0]
  // alone died the day two slices shared a fn)
  let mut i: usize = 0;
  while i < e.sel_n {
    if e.selnames[i] == name {
      e.selvals[i] = etext;
      return;
    }
    i = i + 1;
  }
  if e.sel_n < len(e.selnames) {
    e.selnames[e.sel_n] = name;
    e.selvals[e.sel_n] = etext;
    e.sel_n = e.sel_n + 1;
  }
}

// the element text's pointer target — Some/Ok binder type
fn env_slicept_of(e: *Env, name: string) -> string {
  let mut i: usize = e.sel_n;
  while i > 0 {
    if e.selnames[i - 1] == name {
      return type_ptr_target(e.selvals[i - 1]);
    }
    i = i - 1;
  }
  return "";
}

fn env_sliceelem_of(e: *Env, name: string, prog: *Prog) -> string {
  let mut i: usize = e.sel_n;
  while i > 0 {
    if e.selnames[i - 1] == name {
      let t: string = e.selvals[i - 1];
      if len(t) >= 1 && (t[0] == 63 || t[0] == 79) {
        return "Option";
      }
      if en_index(prog, t) >= 0 {
        return t;
      }
      return "";
    }
    i = i - 1;
  }
  return "";
}

// the element text of a slice binding, "" when unbound
fn env_slice_elemtext(e: *Env, name: string) -> string {
  let mut i: usize = e.sel_n;
  while i > 0 {
    if e.selnames[i - 1] == name {
      return e.selvals[i - 1];
    }
    i = i - 1;
  }
  return "";
}

fn env_val_of(e: *Env, name: string) -> string {
  let mut i: usize = e.n;
  while i > 0 {
    if e.names[i - 1] == name {
      return e.sval[i - 1];
    }
    i = i - 1;
  }
  return "";
}

fn env_val_base(e: *Env, name: string) -> i64 {
  let mut i: usize = e.n;
  while i > 0 {
    if e.names[i - 1] == name {
      return e.vbases[i - 1];
    }
    i = i - 1;
  }
  return 0 - 1;
}

fn env_ptr_of(e: *Env, name: string) -> string {
  let mut i: usize = e.n;
  while i > 0 {
    if e.names[i - 1] == name {
      return e.sptr[i - 1];
    }
    i = i - 1;
  }
  return "";
}

// an operand's width: a var by its binding, an as-cast by its target
// type, a bare literal by the fixed default i32 (§3.1) — and the
// width PROPAGATES through arithmetic (one64 << 63 is still i64)
fn expr_width(e: *Expr, env: *Env, prog: *Prog) -> i64 {
  if e.tag == parse.EX_VAR {
    return env_width_of(env, e.name);
  }
  if e.tag == parse.EX_BIN && e.op == 11 {
    return type_width(e.name);
  }
  if e.tag == parse.EX_FIELD {
    // the field's own written type declares the width
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    let bt: string = expr_ptr_type(base, env, prog);
    if len(bt) > 0 {
      let si: i64 = st_index(prog, bt);
      let fi: i64 = st_field_index(prog, si, e.name);
      if fi >= 0 {
        return type_width(prog.structs[si as usize].types[fi as usize]);
      }
    }
    return 0;
  }
  if e.tag == parse.EX_LIT {
    return 32;
  }
  if e.tag == parse.EX_BIN {
    return bin_width(e, env, prog);
  }
  return 0;
}

// a binary's width: the DECLARING operand wins (vars and casts), a
// literal adapts — so 0 - m8 takes m8's width, not the literal's
// default
fn bin_width(e: *Expr, env: *Env, prog: *Prog) -> i64 {
  let mut lhs_lit: bool = false;
  match e.lhs {
    Option.Some(l) => {
      lhs_lit = l.tag == parse.EX_LIT;
    },
    Option.None => {},
  }
  if !lhs_lit {
    match e.lhs {
      Option.Some(l) => {
        let w: i64 = expr_width(l, env, prog);
        if w != 0 {
          return w;
        }
      },
      Option.None => {},
    }
  }
  match e.rhs {
    Option.Some(r) => {
      let w: i64 = expr_width(r, env, prog);
      if w != 0 {
        return w;
      }
    },
    Option.None => {},
  }
  if lhs_lit {
    return 32; // both literals: the i32 default
  }
  return 0;
}

fn env_width_of(e: *Env, name: string) -> i64 {
  let mut i: usize = e.n;
  while i > 0 {
    if e.names[i - 1] == name {
      return e.vwidths[i - 1];
    }
    i = i - 1;
  }
  return 0;
}

// the annotation's width code: ±8/±16/±32 (negative = unsigned),
// 0 = the full lane
fn type_width(tyname: string) -> i64 {
  if tyname == "i8" { return 8; }
  if tyname == "i16" { return 16; }
  if tyname == "i32" { return 32; }
  if tyname == "i64" { return 64; }
  if tyname == "u8" { return 0 - 8; }
  if tyname == "u16" { return 0 - 16; }
  if tyname == "u32" { return 0 - 32; }
  if tyname == "u64" { return 0 - 64; }
  if tyname == "usize" { return 0 - 64; }
  return 0;
}

// ---- the struct table ----

// a field type's slot count: string and slice fields ride pairs; a
// by-value struct field inlines the nested struct's own slots (a
// depth cap keeps a self-referential declaration from looping — boot's
// checker rejects those, the corpus never carries one)
fn type_slots_d(prog: *Prog, ty: string, depth: i64) -> i64 {
  if len(ty) >= 2 && ty[0] == 91 && ty[1] == 93 {
    return 2;
  }
  if ty == "string" {
    return 2;
  }
  if is_dyn_type(ty) {
    return 2;
  }
  if depth < 8 {
    let si: i64 = st_index(prog, ty);
    if si >= 0 {
      return st_nslots_d(prog, si, depth + 1);
    }
  }
  return 1;
}

fn type_slots(prog: *Prog, ty: string) -> i64 {
  return type_slots_d(prog, ty, 0);
}

// a field type's kind: 0 scalar, 1 string, 2 slice, 3 pointer
fn type_kind(ty: string) -> i64 {
  if len(ty) >= 2 && ty[0] == 91 && ty[1] == 93 {
    return 2;
  }
  if ty == "string" {
    return 1;
  }
  if len(ty) >= 1 && ty[0] == 42 {
    return 3;
  }
  if len(ty) >= 2 && ty[0] == 63 && ty[1] == 42 {
    return 3;
  }
  return 0;
}

// the pointer target when a type text is *T or ?*T, "" otherwise
fn type_ptr_target(ty: string) -> string {
  if len(ty) >= 2 && ty[0] == 63 && ty[1] == 42 {
    return ty[2..len(ty)];
  }
  if len(ty) >= 2 && ty[0] == 42 {
    return ty[1..len(ty)];
  }
  return "";
}

// weak[T] — the handle type (rides the pointer lane, never counted)
fn is_weak_type(ty: string) -> bool {
  return len(ty) >= 6 && ty[0] == 119 && ty[1] == 101 &&
      ty[2] == 97 && ty[3] == 107 && ty[4] == 91;
}

// the T inside weak[T] (or a weak:-prefixed binding text), "" else
fn weak_target(ty: string) -> string {
  if is_weak_type(ty) {
    return ty[5..(len(ty) - 1)];
  }
  if len(ty) >= 6 && ty[0] == 119 && ty[1] == 101 && ty[2] == 97 &&
      ty[3] == 107 && ty[4] == 58 {
    return ty[5..len(ty)];
  }
  return "";
}

pub fn st_index(prog: *Prog, name: string) -> i64 {
  let mut i: usize = 0;
  while i < prog.nstructs {
    if prog.structs[i].name == name {
      return i as i64;
    }
    i = i + 1;
  }
  // Name[a1,a2] — instantiate the generic declaration under the full
  // text (idempotent: the scan above finds it on later calls)
  let ob: i64 = open_bracket(name);
  if ob >= 0 && name[(len(name) - 1)..len(name)] == "]" {
    let base: string = name[0..(ob as usize)];
    let inner: string = name[((ob as usize) + 1)..(len(name) - 1)];
    let bi: i64 = st_index(prog, base);
    if bi >= 0 && len(prog.structs[bi as usize].tparams) > 0 {
      let sd = prog.structs[bi as usize];
      let tys: []string = split_type_args(inner);
      let nf: usize = len(sd.types);
      let ntypes: []string = make([]string, nf);
      let mut j: usize = 0;
      while j < nf {
        ntypes[j] = tsub_type(sd.types[j], sd.tparams, tys);
        j = j + 1;
      }
      let inst = parse.mk_structdef(name, sd.fields, ntypes,
                                    make([]string, 0));
      return parse.reg_struct_inst(prog, inst);
    }
  }
  return 0 - 1;
}

fn st_field_index(prog: *Prog, si: i64, fname: string) -> i64 {
  let mut k: usize = 0;
  while k < len(prog.structs[si as usize].fields) {
    if prog.structs[si as usize].fields[k] == fname {
      return k as i64;
    }
    k = k + 1;
  }
  return 0 - 1;
}

// a struct field's float kind by its written type, 0 when not float
fn st_field_fkind(prog: *Prog, si: i64, fname: string) -> i64 {
  let k: i64 = st_field_index(prog, si, fname);
  if k >= 0 {
    let ft: string = prog.structs[si as usize].types[k as usize];
    if ft == "f64" {
      return 1;
    }
    if ft == "f32" {
      return 2;
    }
  }
  return 0;
}

// the slot offset of field k (a pair field takes two, an inlined
// struct as many as it owns)
fn st_field_off(prog: *Prog, si: i64, k: i64) -> i64 {
  let mut off: i64 = 0;
  let mut j: i64 = 0;
  while j < k {
    off = off + type_slots(prog,
                           prog.structs[si as usize].types[j as usize]);
    j = j + 1;
  }
  return off;
}

fn st_nslots_d(prog: *Prog, si: i64, depth: i64) -> i64 {
  let mut off: i64 = 0;
  let mut j: usize = 0;
  while j < len(prog.structs[si as usize].types) {
    off = off + type_slots_d(prog,
                             prog.structs[si as usize].types[j as usize],
                             depth);
    j = j + 1;
  }
  return off;
}

fn st_nslots(prog: *Prog, si: i64) -> i64 {
  return st_nslots_d(prog, si, 0);
}

pub fn en_index(prog: *Prog, name: string) -> i64 {
  let mut i: usize = 0;
  while i < prog.nenums {
    if prog.enums[i].name == name {
      return i as i64;
    }
    i = i + 1;
  }
  // Enum[T1,T2] — instantiate the generic declaration (payload types
  // substitute; the box slots recompute over them)
  let ob: i64 = open_bracket(name);
  if ob >= 0 && name[(len(name) - 1)..len(name)] == "]" {
    let base: string = name[0..(ob as usize)];
    let inner: string = name[((ob as usize) + 1)..(len(name) - 1)];
    let bi: i64 = en_index(prog, base);
    if bi >= 0 && len(prog.enums[bi as usize].tparams) > 0 {
      let ed = prog.enums[bi as usize];
      let tys: []string = split_type_args(inner);
      let pooln: usize = len(ed.vtpool);
      let npool: []string = make([]string, pooln);
      let mut j: usize = 0;
      while j < pooln {
        npool[j] = tsub_type(ed.vtpool[j], ed.tparams, tys);
        j = j + 1;
      }
      // recompute each variant's slot count over substituted payloads
      let nv: usize = ed.nv;
      let nslots: []i64 = make([]i64, nv);
      let mut v: usize = 0;
      while v < nv {
        let mut sl: i64 = 0;
        let mut p: usize = 0;
        while p < (ed.vslots[v] as usize) &&
            (v * 8 + p) < pooln {
          sl = sl + type_slots(prog, npool[v * 8 + p]);
          p = p + 1;
        }
        nslots[v] = sl;
        v = v + 1;
      }
      let inst = parse.mk_enumdef(name, ed.vnames, nslots, npool, nv,
                                  make([]string, 0));
      return parse.reg_enum_inst(prog, inst);
    }
  }
  return 0 - 1;
}

fn en_vtag(prog: *Prog, ei: i64, vname: string) -> i64 {
  let mut k: usize = 0;
  while k < prog.enums[ei as usize].nv {
    if prog.enums[ei as usize].vnames[k] == vname {
      return k as i64;
    }
    k = k + 1;
  }
  return 0 - 1;
}

// a variant's declared payload types, empty for the builtins and
// unknown variants
fn enum_variant_ptys(prog: *Prog, ename: string,
                     vname: string) -> []string {
  let ei: i64 = en_index(prog, ename);
  if ei < 0 {
    return make([]string, 0);
  }
  let vi: i64 = en_vtag(prog, ei, vname);
  if vi < 0 {
    return make([]string, 0);
  }
  let vb: usize = (vi as usize) * 8;
  let mut vend: usize = vb;
  while vend < len(prog.enums[ei as usize].vtpool) &&
      vend < vb + 8 {
    if len(prog.enums[ei as usize].vtpool[vend]) == 0 {
      break;
    }
    vend = vend + 1;
  }
  return prog.enums[ei as usize].vtpool[vb..vend];
}

// an enum box: [tag][payload slots...] sized by the widest variant —
// a string payload rides a pair, two slots
fn en_nslots(prog: *Prog, ei: i64) -> i64 {
  let mut mx: i64 = 0;
  let mut k: usize = 0;
  while k < prog.enums[ei as usize].nv {
    let ptys: []string = enum_variant_ptys(prog,
        prog.enums[ei as usize].name,
        prog.enums[ei as usize].vnames[k]);
    let mut ns: i64 = 0;
    let mut j: usize = 0;
    while j < len(ptys) {
      if ptys[j] == "string" {
        ns = ns + 2;
      } else {
        ns = ns + 1;
      }
      j = j + 1;
    }
    if ns > mx {
      mx = ns;
    }
    k = k + 1;
  }
  return mx + 1;
}

fn en_vslots(prog: *Prog, ei: i64, vname: string) -> i64 {
  let mut k: usize = 0;
  while k < prog.enums[ei as usize].nv {
    if prog.enums[ei as usize].vnames[k] == vname {
      return prog.enums[ei as usize].vslots[k];
    }
    k = k + 1;
  }
  return 0;
}

// Option[..]/Result[..] collapse to the builtin name — the EXACT
// builtin or its bracketed form; a user enum (Opt[i32]) never
fn norm_enum(rt: string) -> string {
  if rt == "Option" || starts_open(rt, "Option") {
    return "Option";
  }
  if rt == "Result" || starts_open(rt, "Result") {
    return "Result";
  }
  return rt;
}

// text == prefix, or text = prefix + "[" + args (and nothing between)
fn starts_open(t: string, prefix: string) -> bool {
  if len(t) < len(prefix) + 2 {
    return false;
  }
  let mut i: usize = 0;
  while i < len(prefix) {
    if t[i] != prefix[i] {
      return false;
    }
    i = i + 1;
  }
  return t[len(prefix)] == 91 && t[len(t) - 1] == 93;
}

// the float kind of an expression: 0 int, 1 f64, 2 f32
fn expr_fkind(e: *Expr, env: *Env, prog: *Prog) -> i64 {
  if e.tag == parse.EX_FLIT {
    return 1;
  }
  if e.tag == parse.EX_VAR {
    let k: i64 = env_fkind_of(env, e.name);
    if k > 0 {
      return k;
    }
    // consts and statics carry their written type
    let mut i: usize = 0;
    while i < prog.nconsts {
      if prog.consts[i] == e.name {
        if prog.ctypes[i] == "f64" {
          return 1;
        }
        if prog.ctypes[i] == "f32" {
          return 2;
        }
        return 0;
      }
      i = i + 1;
    }
    return 0;
  }
  if e.tag == parse.EX_FIELD {
    // a struct field's own width decides (Pair.a: f64 …)
    match e.lhs {
      Option.Some(b) => {
        let bt: string = field_base_type(b, env, prog);
        if len(bt) > 0 {
          let si: i64 = st_index(prog, bt);
          if si >= 0 {
            let fk: i64 = st_field_fkind(prog, si, e.name);
            if fk > 0 {
              return fk;
            }
          }
        }
      },
      Option.None => {},
    }
    return 0;
  }
  if e.tag == parse.EX_BIN && e.op == 11 {
    if e.name == "f64" {
      return 1;
    }
    if e.name == "f32" {
      return 2;
    }
    return 0;
  }
  if e.tag == parse.EX_BIN {
    let mut lf: i64 = 0;
    let mut rf: i64 = 0;
    match e.lhs {
      Option.Some(l7) => {
        lf = expr_fkind(l7, env, prog);
      },
      Option.None => {},
    }
    match e.rhs {
      Option.Some(r7) => {
        rf = expr_fkind(r7, env, prog);
      },
      Option.None => {},
    }
    if lf > 0 {
      return lf;
    }
    if rf > 0 {
      return rf;
    }
  }
  if e.tag == parse.EX_CALL {
    let rt: string = call_fn_rtype(prog, e, env);
    if rt == "f64" {
      return 1;
    }
    if rt == "f32" {
      return 2;
    }
  }
  return 0;
}

// the enum an expression's value belongs to, "" when none
fn expr_enum_type(e: *Expr, env: *Env, prog: *Prog) -> string {
  if e.tag == parse.EX_VAR {
    return env_enum_of(env, e.name);
  }
  if e.tag == parse.EX_MCALL {
    let mut recv: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(r) => {
        recv = r;
      },
      Option.None => {},
    }
    if recv.tag == parse.EX_VAR && en_index(prog, recv.name) >= 0 {
      return recv.name;
    }
    if recv.tag == parse.EX_VAR && recv.name == "Option" {
      return "Option";
    }
    // w.get() — the absence probe yields an Option box
    if recv.tag == parse.EX_VAR && e.name == "get" &&
        len(weak_target(env_ptr_of(env, recv.name))) > 0 {
      return "Option";
    }
    let bt: string = expr_ptr_type(recv, env, prog);
    if len(bt) > 0 {
      let rt: string = fn_rtype_of(prog, bt + "." + e.name);
      if en_index(prog, rt) >= 0 {
        return rt;
      }
    }
    return "";
  }
  if e.tag == parse.EX_CALL {
    let rt: string = norm_enum(fn_rtype_of(prog, e.name));
    if len(rt) > 0 && (en_index(prog, rt) >= 0 || rt == "Option" ||
        rt == "Result") {
      return rt;
    }
    return "";
  }
  if e.tag == parse.EX_IDX {
    // an enum-element slice's indexing yields the element's enum —
    // through a binding or a struct-field slice (one field step)
    let mut b5: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(x5) => {
        b5 = x5;
      },
      Option.None => {},
    }
    if b5.tag == parse.EX_VAR {
      return env_sliceelem_of(env, b5.name, prog);
    }
    if b5.tag == parse.EX_FIELD {
      let mut ow5: *Expr = parse.lit(0);
      match b5.lhs {
        Option.Some(o5) => {
          ow5 = o5;
        },
        Option.None => {},
      }
      let bt5: string = field_base_type(ow5, env, prog);
      if len(bt5) > 0 {
        let si5: i64 = st_index(prog, bt5);
        let fi5: i64 = st_field_index(prog, si5, b5.name);
        if fi5 >= 0 {
          let fty5: string =
              prog.structs[si5 as usize].types[fi5 as usize];
          if len(fty5) >= 4 && fty5[0] == 91 && fty5[1] == 93 &&
              (fty5[2] == 63 || fty5[2] == 79) {
            return "Option";
          }
          if en_index(prog, fty5[2..len(fty5)]) >= 0 {
            return fty5[2..len(fty5)];
          }
        }
      }
    }
    return "";
  }
  if e.tag == parse.EX_FIELD {
    let mut b0: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(x) => {
        b0 = x;
      },
      Option.None => {},
    }
    if b0.tag == parse.EX_VAR &&
        (en_index(prog, b0.name) >= 0 || b0.name == "Option") {
      return b0.name;
    }
    return "";
  }
  if e.tag == parse.EX_MATCH {
    return "";
  }
  return "";
}

fn fn_rtype_of(prog: *Prog, name: string) -> string {
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name == name {
      return prog.fns[i].rtype;
    }
    i = i + 1;
  }
  return "";
}

// the struct owning a field access: a pointer receiver by its
// target, a value receiver by its frame
fn field_base_type(e: *Expr, env: *Env, prog: *Prog) -> string {
  if e.tag == parse.EX_VAR {
    let vt: string = env_val_of(env, e.name);
    if len(vt) > 0 {
      return vt;
    }
    return env_ptr_of(env, e.name);
  }
  return expr_ptr_type(e, env, prog);
}

// a by-value struct expression's own struct name, "" when the
// expression is not struct-typed
fn struct_type_of(e: *Expr, env: *Env, prog: *Prog) -> string {
  if e.tag == parse.EX_VAR {
    return env_val_of(env, e.name);
  }
  if e.tag == parse.EX_DEREF {
    let mut inner: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(x) => {
        inner = x;
      },
      Option.None => {},
    }
    let it: string = expr_ptr_type(inner, env, prog);
    if st_index(prog, it) >= 0 {
      return it;
    }
    return "";
  }
  if e.tag == parse.EX_NEW {
    return e.name;
  }
  if e.tag == parse.EX_FIELD {
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    let bt: string = field_base_type(base, env, prog);
    if len(bt) > 0 {
      let si: i64 = st_index(prog, bt);
      let fi: i64 = st_field_index(prog, si, e.name);
      if fi >= 0 {
        let fty: string = prog.structs[si as usize].types[fi as usize];
        if st_index(prog, fty) >= 0 {
          return fty;
        }
      }
    }
    return "";
  }
  if e.tag == parse.EX_IDX {
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    if base.tag == parse.EX_VAR {
      let et: string = env_slice_elemtext(env, base.name);
      if st_index(prog, et) >= 0 {
        return et;
      }
    }
    return "";
  }
  if e.tag == parse.EX_CALL {
    let rt: string = call_fn_rtype(prog, e, env);
    if st_index(prog, rt) >= 0 {
      return rt;
    }
  }
  return "";
}

// a struct-typed expression's frame base when the whole chain is
// frame-resident (a value binding root, struct-typed fields within);
// -1 when the value lives behind an address
fn val_chain_slot(e: *Expr, env: *Env, prog: *Prog) -> i64 {
  if e.tag == parse.EX_VAR {
    if len(env_val_of(env, e.name)) > 0 {
      return env_val_base(env, e.name);
    }
    return 0 - 1;
  }
  if e.tag == parse.EX_FIELD {
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    let root: i64 = val_chain_slot(base, env, prog);
    if root < 0 {
      return 0 - 1;
    }
    let bt: string = field_base_type(base, env, prog);
    if len(bt) == 0 {
      return 0 - 1;
    }
    let si: i64 = st_index(prog, bt);
    let fi: i64 = st_field_index(prog, si, e.name);
    if fi < 0 {
      return 0 - 1;
    }
    // only a by-value struct field continues the frame chain; a
    // pointer field holds an address — the chain leaves the frame
    // and the generic path loads through it
    let fty: string = prog.structs[si as usize].types[fi as usize];
    if st_index(prog, fty) < 0 {
      return 0 - 1;
    }
    return root + st_field_off(prog, si, fi);
  }
  if e.tag == parse.EX_IDX {
    // a slice's elements live in the slice's own storage — behind
    // its address, never in the frame
    return 0 - 1;
  }
  return 0 - 1;
}

// a by-value struct expression evaluates to an address: heap
// expressions already are one; a frame-resident chain copies into a
// fresh zeroed box first (a wasm local frame has no address to borrow)
fn struct_addr_of(pool: *Pool, e: *Expr, env: *Env, prog: *Prog,
                  nl: *NextLocal) -> string {
  let sname: string = struct_type_of(e, env, prog);
  if len(sname) == 0 {
    return emit_expr(pool, e, env, prog, nl);
  }
  let si: i64 = st_index(prog, sname);
  let vn: i64 = st_nslots(prog, si);
  let fb: i64 = val_chain_slot(e, env, prog);
  if fb >= 0 {
    let b: i64 = nl.v;
    nl.v = nl.v + 1;
    let mut out: string = "    (i64.extend_i32_u (call $w_alloc (i32.const " +
           vn.to_str() + ")))\n" +
           "    (local.set " + b.to_str() + ")\n";
    let mut j: i64 = 0;
    while j < vn {
      out = out + "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
             b.to_str() + ")) (i32.const " + (j * 8).to_str() +
             ")) (local.get " + (fb + j).to_str() + "))\n";
      j = j + 1;
    }
    return out + "    (local.get " + b.to_str() + ")\n";
  }
  return emit_expr(pool, e, env, prog, nl);
}

// the struct a pointer-valued expression references, "" when none:
// vars by their binding, new by its name, calls and methods by the
// written return type, fields by the field's own type
fn expr_ptr_type(e: *Expr, env: *Env, prog: *Prog) -> string {
  if e.tag == parse.EX_VAR {
    return env_ptr_of(env, e.name);
  }
  if e.tag == parse.EX_NEW {
    return e.name;
  }
  if e.tag == parse.EX_IDX {
    // a struct-element slice's indexing: the element's struct — a
    // pointer element's target when the elements are pointers
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b12) => {
        base = b12;
      },
      Option.None => {},
    }
    if base.tag == parse.EX_VAR {
      let mut et: string = env_slice_elemtext(env, base.name);
      if len(et) >= 1 && et[0] == 42 {
        et = type_ptr_target(et);
      }
      if st_index(prog, et) >= 0 {
        return et;
      }
    }
    return "";
  }
  if e.tag == parse.EX_CALL {
    // the CALL's own type: a generic's return rides its
    // instantiation's bind (the declared *Pair[T,T] never substitutes)
    return type_ptr_target(call_fn_rtype(prog, e, env));
  }
  if e.tag == parse.EX_MCALL {
    let mut recv: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(r) => {
        recv = r;
      },
      Option.None => {},
    }
    if recv.tag == parse.EX_VAR && st_index(prog, recv.name) >= 0 {
      return type_ptr_target(fn_rtype_of(prog, recv.name + "." + e.name));
    }
    // an enum-typed receiver: the method's return substitutes the
    // enum's own type parameters from the receiver's instantiation
    let et15: string = expr_enum_type(recv, env, prog);
    if len(et15) > 0 {
      let eb: i64 = open_bracket(et15);
      if eb >= 0 {
        let ei15: i64 = en_index(prog, et15[0..(eb as usize)]);
        if ei15 >= 0 &&
            len(prog.enums[ei15 as usize].tparams) > 0 {
          let rt15: string = fn_rtype_of(prog,
              et15[0..(eb as usize)] + "." + e.name);
          let tys15: []string = split_type_args(
              et15[((eb as usize) + 1)..(len(et15) - 1)]);
          return type_ptr_target(tsub_type(rt15,
              prog.enums[ei15 as usize].tparams, tys15));
        }
      }
      return type_ptr_target(fn_rtype_of(prog,
          type_base(et15) + "." + e.name));
    }
    let bt: string = expr_ptr_type(recv, env, prog);
    if len(bt) > 0 {
      return type_ptr_target(fn_rtype_of(prog, bt + "." + e.name));
    }
    return "";
  }
  if e.tag == parse.EX_Q {
    // e? unwraps — the payload's type is the raw value
    return "";
  }
  if e.tag == parse.EX_FIELD {
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    let bt: string = field_base_type(base, env, prog);
    if len(bt) > 0 {
      let si: i64 = st_index(prog, bt);
      let fi: i64 = st_field_index(prog, si, e.name);
      if fi >= 0 {
        let fty: string = prog.structs[si as usize].types[fi as usize];
        // a by-value struct field continues the chain under its own
        // name; everything else resolves through its pointer target
        if st_index(prog, fty) >= 0 {
          return fty;
        }
        return type_ptr_target(fty);
      }
    }
    return "";
  }
  return "";
}

// ---- the rc law's release thunks (one per managed type) ----
// Every box carries its rc in the slot before the payload pointer.
// A release decrements; at zero the type's thunk walks the owned
// payloads (struct fields, enum payloads by tag, slice elements).
// Weaks never count; strings and scalars release nothing (their
// deaths are unobservable in the corpus's lifetime probes).

// the release callee for a written type, "" when nothing is counted
fn rel_callee(pool: *Pool, prog: *Prog, ty: string) -> string {
  if len(ty) == 0 || is_weak_type(ty) || ty == "string" {
    return "";
  }
  if len(weak_target(ty)) > 0 {
    return "";
  }
  // *S — the struct-box thunk
  if len(ty) >= 1 && ty[0] == 42 {
    let s: string = ty[1..len(ty)];
    if st_index(prog, s) >= 0 {
      return rel_struct_thunk(pool, prog, s);
    }
    return "";
  }
  // ?X — the option-box thunk walking the payload
  if len(ty) >= 1 && ty[0] == 63 {
    return rel_opt_thunk(pool, prog, ty[1..len(ty)]);
  }
  if ty == "Option" || ty == "Result" {
    // a binding's option without a recorded payload: the box counts,
    // nothing inside walks (the payload text rides the binding)
    return rel_opt_thunk(pool, prog, "");
  }
  // []T — the slice thunk over managed elements
  if len(ty) >= 2 && ty[0] == 91 && ty[1] == 93 {
    return rel_slice_thunk(pool, prog, ty[2..len(ty)]);
  }
  // a user enum value — the enum thunk
  if en_index(prog, ty) >= 0 {
    return rel_enum_thunk(pool, prog, ty);
  }
  return "";
}

fn rel_register(pool: *Pool, name: string, text: string) -> string {
  let mut i: usize = 0;
  while i < pool.rel_n {
    if pool.rel_names[i] == name {
      return name;
    }
    i = i + 1;
  }
  if pool.rel_n >= len(pool.rel_names) {
    return name; // registry full: the release degrades to none
  }
  pool.rel_names[pool.rel_n] = name;
  pool.rel_texts[pool.rel_n] = text;
  pool.rel_n = pool.rel_n + 1;
  return name;
}

// the rc-decrement preamble every thunk shares; the walk lands inside
// the (then) — walk_text may be empty
fn rel_body(p: string, walk_text: string) -> string {
  let mut out: string = "";
  out = out + "  (func " + p + " (param $p i64)\n";
  out = out + "    (local $c i64)\n";
  out = out + "    (if (i64.ne (local.get $p) (i64.const 0))\n";
  out = out + "      (then\n";
  out = out + "        (local.set $c (i64.sub (i64.load (i32.sub " +
         "(i32.wrap_i64 (local.get $p)) (i32.const 8))) (i64.const 1)))\n";
  out = out + "        (i64.store (i32.sub (i32.wrap_i64 (local.get $p))" +
         " (i32.const 8)) (local.get $c))\n";
  out = out + "        (if (i64.eq (local.get $c) (i64.const 0))\n";
  out = out + "          (then\n" + walk_text + "          )\n";
  out = out + "        )\n";
  out = out + "      )\n";
  out = out + "    )\n";
  out = out + "  )\n";
  return out;
}

// the field-walk text of a struct's managed fields (the death walk:
// each owned field releases through its own thunk)
fn rel_field_walk(pool: *Pool, prog: *Prog, si: i64) -> string {
  let mut walk: string = "";
  let nf: usize = len(prog.structs[si as usize].types);
  let mut j: usize = 0;
  while j < nf {
    let fty: string = prog.structs[si as usize].types[j as usize];
    let off: i64 = st_field_off(prog, si, j as i64) * 8;
    if is_dyn_type(fty) {
      // a dyn field releases its obj through the field's own vtable
      // slot (nmethods = the release thunk's index)
      let dtr: string = dyn_trait(fty);
      let dnm: i64 = trait_method_count(prog, dtr);
      walk = walk +
             "            (i64.load (i32.add (i32.wrap_i64 " +
             "(local.get $p)) (i32.const " + (off + 8).to_str() +
             ")))\n" +
             "            (i64.load (i32.add (i32.wrap_i64 " +
             "(i64.load (i32.add (i32.wrap_i64 (local.get $p)) " +
             "(i32.const " + off.to_str() + ")))) (i32.const " +
             (dnm * 8).to_str() + ")))\n" +
             "            (i32.wrap_i64)\n" +
             "            call_indirect (type $clv1)\n";
      j = j + 1;
      continue;
    }
    let fc: string = rel_callee(pool, prog, fty);
    if len(fc) > 0 {
      walk = walk + "            (i64.load (i32.add (i32.wrap_i64 " +
             "(local.get $p)) (i32.const " + off.to_str() + ")))\n";
      if len(fty) >= 2 && fty[0] == 91 && fty[1] == 93 {
        // a slice field: the walker takes the pair (addr, len)
        walk = walk + "            (i64.load (i32.add (i32.wrap_i64 " +
               "(local.get $p)) (i32.const " + (off + 8).to_str() +
               ")))\n";
      }
      walk = walk + "            call " + fc + "\n";
    }
    j = j + 1;
  }
  return walk;
}

fn rel_struct_thunk(pool: *Pool, prog: *Prog, sname: string) -> string {
  let nm: string = "$w_rel_" + sym_name(mangle_type(sname));
  // register first (empty) so recursive types stop here, then fill
  let si: i64 = st_index(prog, sname);
  if si < 0 {
    return "";
  }
  let mut i: usize = 0;
  let mut known: bool = false;
  while i < pool.rel_n {
    if pool.rel_names[i] == nm {
      known = true;
    }
    i = i + 1;
  }
  if known {
    return nm;
  }
  rel_register(pool, nm, "");
  let walk: string = rel_field_walk(pool, prog, si);
  // overwrite the placeholder with the real body
  let mut k: usize = 0;
  while k < pool.rel_n {
    if pool.rel_names[k] == nm {
      pool.rel_texts[k] = rel_body(nm, walk);
    }
    k = k + 1;
  }
  return nm;
}

// an option/result box: at tag 1 (Some/Ok) the payload releases
fn rel_opt_thunk(pool: *Pool, prog: *Prog, payload: string) -> string {
  let nm: string = "$w_relopt_" + sym_name(mangle_type(payload));
  let mut i: usize = 0;
  while i < pool.rel_n {
    if pool.rel_names[i] == nm {
      return nm;
    }
    i = i + 1;
  }
  let pc: string = rel_callee(pool, prog, payload);
  let mut walk: string = "";
  if len(pc) > 0 {
    walk = "            (if (i64.eq (i64.load (i32.wrap_i64 " +
           "(local.get $p))) (i64.const 1))\n" +
           "              (then\n" +
           "                (i64.load (i32.add (i32.wrap_i64 " +
           "(local.get $p)) (i32.const 8)))\n" +
           "                call " + pc + "\n" +
           "              )\n" +
           "            )\n";
  }
  rel_register(pool, nm, rel_body(nm, walk));
  return nm;
}

// a user enum box: the variant's payload slots walk by tag
fn rel_enum_thunk(pool: *Pool, prog: *Prog, ename: string) -> string {
  let nm: string = "$w_relenum_" + sym_name(mangle_type(ename));
  let mut i: usize = 0;
  while i < pool.rel_n {
    if pool.rel_names[i] == nm {
      return nm;
    }
    i = i + 1;
  }
  let ei: i64 = en_index(prog, ename);
  if ei < 0 {
    return "";
  }
  let mut walk: string = "";
  let nv: usize = prog.enums[ei as usize].nv;
  let mut v: usize = 0;
  while v < nv {
    let nsl: i64 = prog.enums[ei as usize].vslots[v];
    let mut p: usize = 0;
    let mut slot: i64 = 1;
    while p < (nsl as usize) &&
        (v * 8 + p) < len(prog.enums[ei as usize].vtpool) {
      let pty: string =
          prog.enums[ei as usize].vtpool[v * 8 + p];
      let pc2: string = rel_callee(pool, prog, pty);
      if len(pc2) > 0 {
        walk = walk + "            (if (i64.eq (i64.load (i32.wrap_i64 " +
               "(local.get $p))) (i64.const " + (v as i64).to_str() +
               "))\n" +
               "              (then\n" +
               "                (i64.load (i32.add (i32.wrap_i64 " +
               "(local.get $p)) (i32.const " + (slot * 8).to_str() +
               ")))\n" +
               "                call " + pc2 + "\n" +
               "              )\n" +
               "            )\n";
      }
      slot = slot + type_slots(prog, pty);
      p = p + 1;
    }
    v = v + 1;
  }
  rel_register(pool, nm, rel_body(nm, walk));
  return nm;
}

// a slice: each element releases (the elements' storage, not the
// slice's own box — the pair rides two params)
fn rel_slice_thunk(pool: *Pool, prog: *Prog, elem: string) -> string {
  let nm: string = "$w_relsl_" + sym_name(mangle_type(elem));
  let ec: string = rel_callee(pool, prog, elem);
  if len(ec) == 0 {
    return "";
  }
  let mut i: usize = 0;
  while i < pool.rel_n {
    if pool.rel_names[i] == nm {
      return nm;
    }
    i = i + 1;
  }
  let mut esz: i64 = 1;
  if elem == "string" {
    esz = 2;
  } else {
    let ei2: i64 = st_index(prog, elem);
    if ei2 >= 0 {
      esz = st_nslots(prog, ei2);
    }
  }
  let mut out: string = "";
  out = out + "  (func " + nm + " (param $a i64) (param $l i64)\n";
  out = out + "    (local $i i64)\n";
  out = out + "    (loop $w\n";
  out = out + "      (if (i64.lt_u (local.get $i) (local.get $l))\n";
  out = out + "        (then\n";
  out = out + "          (i64.load (i32.add (i32.wrap_i64 (local.get $a))" +
         " (i32.mul (i32.wrap_i64 (local.get $i)) (i32.const " +
         (esz * 8).to_str() + "))))\n";
  out = out + "          call " + ec + "\n";
  out = out + "          (local.set $i (i64.add (local.get $i) " +
         "(i64.const 1)))\n";
  out = out + "          (br $w)\n";
  out = out + "        )\n";
  out = out + "      )\n";
  out = out + "    )\n";
  out = out + "  )\n";
  rel_register(pool, nm, out);
  return nm;
}

// a fresh expression transfers ownership (no retain): new, enum
// constructors, make, slice literals, calls (returns move), format,
// get()'s box, weak.from's identity
fn expr_is_fresh(e: *Expr) -> bool {
  if e.tag == parse.EX_NEW || e.tag == parse.EX_MAKE ||
      e.tag == parse.EX_ARR || e.tag == parse.EX_CALL {
    return true;
  }
  if e.tag == parse.EX_MCALL {
    return true;
  }
  if e.tag == parse.EX_FIELD {
    // Enum.Var without parens — the unit-variant constructor
    return true;
  }
  return false;
}

// retain a slot's value when the init was not fresh
fn retain_if_shared(e: *Expr, slot: i64) -> string {
  if expr_is_fresh(e) {
    return "";
  }
  return "    (local.get " + slot.to_str() + ")\n" +
         "    call $w_retain\n";
}

// retain the named $t temp when the init was not fresh
fn retain_t(e: *Expr) -> string {
  if expr_is_fresh(e) {
    return "";
  }
  return "    (local.get $t)\n" +
         "    call $w_retain\n";
}

// a binding's managed type text (what its scope-exit releases), ""
// when nothing is counted: pointers by target, enums by name (the
// option payload rides the slice-elem table), slices by element
fn managed_type_of_binding(env: *Env, name: string) -> string {
  let pt: string = env_ptr_of(env, name);
  if len(pt) > 0 {
    if len(weak_target(pt)) > 0 {
      return "";
    }
    return "*" + pt;
  }
  let en: string = env_enum_of(env, name);
  if len(en) > 0 {
    if en == "Option" || en == "Result" {
      let pay: string = env_slice_elemtext(env, name);
      if len(pay) > 0 {
        return "?" + pay;
      }
      return en;
    }
    return en;
  }
  if env_kind_of(env, name) == 2 {
    let et: string = env_slice_elemtext(env, name);
    if len(et) > 0 {
      return "[]" + et;
    }
  }
  return "";
}

// the dyn hole's dispatch text and parked pair (a dyn value's
// to_str rides its vtable slot at the trait's declared ordinal)
static mut DYN_TEXT: string = "";
static mut DYN_A: i64 = 0;
static mut DYN_L: i64 = 0;

// a struct field's or slice element's dyn pair loads into fresh
// (vtable, obj) slots; "" text when the location is not one. The
// struct base rides $r; the element read is bounds-checked
fn dyn_pair_load(arg: *Expr, pool: *Pool, env: *Env, prog: *Prog,
                 nl: *NextLocal) -> string {
  let vbox: i64 = nl.v;
  let obj: i64 = nl.v + 1;
  nl.v = nl.v + 2;
  if arg.tag == parse.EX_FIELD {
    let mut base: *Expr = parse.lit(0);
    match arg.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    let bt: string = field_base_type(base, env, prog);
    if len(bt) > 0 {
      let si: i64 = st_index(prog, bt);
      let fi: i64 = st_field_index(prog, si, arg.name);
      if fi >= 0 &&
          is_dyn_type(prog.structs[si as usize].types[fi as usize]) {
        let off: i64 = st_field_off(prog, si, fi) * 8;
        let mut out: string = emit_expr(pool, base, env, prog, nl) +
               "    (local.set $r)\n" +
               "    (i64.load (i32.add (i32.wrap_i64 (local.get $r))" +
               " (i32.const " + off.to_str() + ")))\n" +
               "    (local.set " + vbox.to_str() + ")\n" +
               "    (i64.load (i32.add (i32.wrap_i64 (local.get $r))" +
               " (i32.const " + (off + 8).to_str() + ")))\n" +
               "    (local.set " + obj.to_str() + ")\n";
        return out;
      }
    }
    return "";
  }
  if arg.tag == parse.EX_IDX {
    let mut base: *Expr = parse.lit(0);
    match arg.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    if base.tag == parse.EX_VAR && env_kind_of(env, base.name) == 2 &&
        is_dyn_type(env_slice_elemtext(env, base.name)) {
      let a: i64 = env_str_look(env, base.name);
      let addr_slot: i64 = (0 - a) - 1;
      let len_slot: i64 = env_str_len_slot(env, base.name);
      let mut idx: *Expr = parse.lit(0);
      match arg.rhs {
        Option.Some(i2) => {
          idx = i2;
        },
        Option.None => {},
      }
      let mut out: string = emit_expr(pool, idx, env, prog, nl) +
             "    (local.set $t)\n" +
             oob_check(pool, "(local.get " + len_slot.to_str() + ")") +
             "    (i64.load (i32.add (i32.add (i32.wrap_i64 " +
             "(local.get " + addr_slot.to_str() + ")) (i32.mul " +
             "(i32.wrap_i64 (local.get $t)) (i32.const 16)))" +
             " (i32.const 0)))\n" +
             "    (local.set " + vbox.to_str() + ")\n" +
             "    (i64.load (i32.add (i32.add (i32.wrap_i64 " +
             "(local.get " + addr_slot.to_str() + ")) (i32.mul " +
             "(i32.wrap_i64 (local.get $t)) (i32.const 16)))" +
             " (i32.const 8)))\n" +
             "    (local.set " + obj.to_str() + ")\n";
      return out;
    }
    return "";
  }
  return "";
}

// when an arg is a dyn value (a fat-pair binding, a dyn-element read,
// a dyn field, or a method call on a dyn receiver), emit its to_str
// dispatch and park the pair; true when done
fn dyn_hole_dispatch(arg: *Expr, pool: *Pool, env: *Env,
                     prog: *Prog, nl: *NextLocal) -> bool {
  let mut trt: string = "";
  let mut vbox: i64 = 0;
  let mut obj: i64 = 0;
  let mut pre: string = "";
  let mut loaded: bool = false;
  if arg.tag == parse.EX_VAR &&
      is_dyn_type(env_slice_elemtext(env, arg.name)) {
    trt = dyn_trait(env_slice_elemtext(env, arg.name));
    let a0: i64 = env_str_look(env, arg.name);
    vbox = (0 - a0) - 1;
    obj = env_str_len_slot(env, arg.name);
  } else {
    if arg.tag == parse.EX_MCALL {
      // a method call on a dyn receiver: the dispatch's own result
      // is the hole's value (string rides its parked pair; a scalar
      // renders through the int/bool text)
      let mut rv9: *Expr = parse.lit(0);
      match arg.lhs {
        Option.Some(r9b) => {
          rv9 = r9b;
        },
        Option.None => {},
      }
      let mut recv_dyn: bool = false;
      if rv9.tag == parse.EX_VAR &&
          is_dyn_type(env_slice_elemtext(env, rv9.name)) {
        recv_dyn = true;
        trt = dyn_trait(env_slice_elemtext(env, rv9.name));
      }
      if !recv_dyn &&
          (rv9.tag == parse.EX_FIELD || rv9.tag == parse.EX_IDX) {
        // the receiver itself is a dyn field read or element read:
        // load the fat pair, then dispatch through it
        let vt9: string = dyn_recv_trait(rv9, env, prog);
        if len(vt9) > 0 {
          let ld9: string = dyn_pair_load(rv9, pool, env, prog, nl);
          if len(ld9) > 0 {
            trt = vt9;
            vbox = nl.v - 2;
            obj = nl.v - 1;
            pre = pre + ld9;
            loaded = true;
          }
        }
      }
      if len(trt) > 0 {
        // the declared return picks the rendering shape
        let mut rtype9: string = "i64";
        let mut t9: usize = 0;
        while t9 < prog.ntraits {
          if prog.traits[t9].name == trt {
            let mut m9: usize = 0;
            while m9 < prog.traits[t9].nmethods {
              if prog.traits[t9].methods[m9] == arg.name &&
                  m9 < len(prog.traits[t9].rtypes) {
                rtype9 = prog.traits[t9].rtypes[m9];
              }
              m9 = m9 + 1;
            }
          }
          t9 = t9 + 1;
        }
        if loaded {
          // dispatch arg.name through the loaded fat pair, rendering
          // by the declared return shape
          let ord9: i64 = trait_ordinal(prog, trt, arg.name);
          if ord9 < 0 {
            return false;
          }
          if rtype9 == "string" {
            let ta9: i64 = nl.v;
            let tl9: i64 = nl.v + 1;
            nl.v = nl.v + 2;
            pre = pre + "    (local.get " + obj.to_str() + ")\n" +
                   "    (i64.load (i32.add (i32.wrap_i64 " +
                   "(local.get " + vbox.to_str() + ")) (i32.const " +
                   (ord9 * 8).to_str() + ")))\n" +
                   "    (i32.wrap_i64)\n" +
                   "    call_indirect (type $clp1)\n" +
                   "    (local.set " + tl9.to_str() + ")\n" +
                   "    (local.set " + ta9.to_str() + ")\n";
            DYN_TEXT = pre;
            DYN_A = ta9;
            DYN_L = tl9;
            return true;
          }
          let tb9: i64 = nl.v;
          nl.v = nl.v + 1;
          let ta9: i64 = nl.v;
          let tl9: i64 = nl.v + 1;
          nl.v = nl.v + 2;
          pre = pre + "    (local.get " + obj.to_str() + ")\n" +
                 "    (i64.load (i32.add (i32.wrap_i64 " +
                 "(local.get " + vbox.to_str() + ")) (i32.const " +
                 (ord9 * 8).to_str() + ")))\n" +
                 "    (i32.wrap_i64)\n" +
                 "    call_indirect (type $cl1)\n" +
                 "    (local.set " + tb9.to_str() + ")\n" +
                 "    (local.get " + tb9.to_str() + ")\n";
          if rtype9 == "bool" {
            pre = pre + "    call $w_bool\n" +
                   "    (local.set $l)\n" +
                   "    (i64.extend_i32_u)\n" +
                   "    (local.set " + ta9.to_str() + ")\n" +
                   "    (i64.extend_i32_u (local.get $l))\n" +
                   "    (local.set " + tl9.to_str() + ")\n";
          } else {
            pre = pre + "    call $w_itoa\n" +
                   "    (local.set " + tl9.to_str() + ")\n" +
                   "    (local.set " + ta9.to_str() + ")\n";
          }
          DYN_TEXT = pre;
          DYN_A = ta9;
          DYN_L = tl9;
          return true;
        }
        if rtype9 == "string" {
            // the dispatch reserves its pair first — base9 holds it
            let base9: i64 = nl.v;
            let t9s: string = emit_expr(pool, arg, env, prog, nl);
            DYN_TEXT = t9s + "    drop\n";
            DYN_A = base9;
            DYN_L = base9 + 1;
            return true;
          }
          // a scalar result: dispatch, then render through the
          // value's own text (ints the decimal printer, bools the
          // word, floats the exact-decimal cluster)
          let tb9: i64 = nl.v;
          nl.v = nl.v + 1;
          let ta9: i64 = nl.v;
          let tl9: i64 = nl.v + 1;
          nl.v = nl.v + 2;
          let mut t9b: string = emit_expr(pool, arg, env, prog, nl);
          t9b = t9b + "    (local.set " + tb9.to_str() + ")\n" +
                "    (local.get " + tb9.to_str() + ")\n";
          if rtype9 == "bool" {
            t9b = t9b + "    call $w_bool\n" +
                   "    (local.set $l)\n" +
                   "    (i64.extend_i32_u)\n" +
                   "    (local.set " + ta9.to_str() + ")\n" +
                   "    (i64.extend_i32_u (local.get $l))\n" +
                   "    (local.set " + tl9.to_str() + ")\n";
          } else {
            if rtype9 == "f64" || rtype9 == "f32" {
              FLOAT_WANTED = 1;
              if rtype9 == "f32" {
                t9b = t9b + "    (f64.reinterpret_i64)\n" +
                       "    (f32.demote_f64)\n" +
                       "    (f64.promote_f32)\n" +
                       "    (i64.reinterpret_f64)\n" +
                       "    call $u___f32_text\n";
              } else {
                t9b = t9b + "    call $u___f64_text\n";
              }
            } else {
              t9b = t9b + "    call $w_itoa\n" +
                     "    (local.set " + tl9.to_str() + ")\n" +
                     "    (local.set " + ta9.to_str() + ")\n";
            }
          }
          if rtype9 == "f64" || rtype9 == "f32" {
            t9b = t9b + "    (local.set " + tl9.to_str() +
                   ")\n" +
                   "    (local.set " + ta9.to_str() + ")\n";
          }
          DYN_TEXT = t9b;
          DYN_A = ta9;
          DYN_L = tl9;
          return true;
        }
        return false;
    } else {
      if arg.tag == parse.EX_FIELD || arg.tag == parse.EX_IDX {
        // a dyn field read or element read: load the fat pair, then
        // dispatch to_str through it
        let vt2: string = dyn_recv_trait(arg, env, prog);
        if len(vt2) == 0 {
          return false;
        }
        let ld2: string = dyn_pair_load(arg, pool, env, prog, nl);
        if len(ld2) == 0 {
          return false;
        }
        trt = vt2;
        vbox = nl.v - 2;
        obj = nl.v - 1;
        pre = pre + ld2;
        loaded = true;
      } else {
        return false;
      }
    }
  }
  let ord: i64 = trait_ordinal(prog, trt, "to_str");
  if ord < 0 {
    return false;
  }
  let ta: i64 = nl.v;
  let tl: i64 = nl.v + 1;
  nl.v = nl.v + 2;
  pre = pre + "    (local.get " + obj.to_str() + ")\n" +
         "    (i64.load (i32.add (i32.wrap_i64 (local.get " +
         vbox.to_str() + ")) (i32.const " + (ord * 8).to_str() +
         ")))\n" +
         "    (i32.wrap_i64)\n" +
         "    call_indirect (type $clp1)\n" +
         "    (local.set " + tl.to_str() + ")\n" +
         "    (local.set " + ta.to_str() + ")\n";
  DYN_TEXT = pre;
  DYN_A = ta;
  DYN_L = tl;
  return true;
}

// the trait of a dyn-valued FIELD or ELEMENT read (the written type
// at the location), "" when the location is not dyn-typed
fn dyn_recv_trait(e: *Expr, env: *Env, prog: *Prog) -> string {
  if e.tag == parse.EX_FIELD {
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    let bt: string = field_base_type(base, env, prog);
    if len(bt) > 0 {
      let si: i64 = st_index(prog, bt);
      let fi: i64 = st_field_index(prog, si, e.name);
      if fi >= 0 {
        let fty: string =
            prog.structs[si as usize].types[fi as usize];
        if is_dyn_type(fty) {
          return dyn_trait(fty);
        }
      }
    }
    return "";
  }
  if e.tag == parse.EX_IDX {
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    if base.tag == parse.EX_VAR &&
        is_dyn_type(env_slice_elemtext(env, base.name)) {
      return dyn_trait(env_slice_elemtext(env, base.name));
    }
  }
  return "";
}

// ---- dyn: fat {vtable, obj} pairs, dispatch through the fn table ----

// is a type text the fat-dispatch type?
fn is_dyn_type(ty: string) -> bool {
  return len(ty) >= 4 && ty[0] == 100 && ty[1] == 121 &&
      ty[2] == 110 && ty[3] == 32;
}

// the trait name inside "dyn Trait"
fn dyn_trait(ty: string) -> string {
  if is_dyn_type(ty) {
    return ty[4..len(ty)];
  }
  return "";
}

// a trait's method count (the vtable's release slot sits at
// nmethods — the +1 the box allocates)
fn trait_method_count(prog: *Prog, trt: string) -> i64 {
  let mut i: usize = 0;
  while i < prog.ntraits {
    if prog.traits[i].name == trt {
      return prog.traits[i].nmethods as i64;
    }
    i = i + 1;
  }
  return 0;
}

// a trait method's ordinal (the vtable slot), -1 when absent
fn trait_ordinal(prog: *Prog, trt: string,
                 method: string) -> i64 {
  let mut i: usize = 0;
  while i < prog.ntraits {
    if prog.traits[i].name == trt {
      let mut k: usize = 0;
      while k < prog.traits[i].nmethods {
        if prog.traits[i].methods[k] == method {
          return k as i64;
        }
        k = k + 1;
      }
      return 0 - 1;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// the table index of a plain method (registering it once); -1 when
// the method does not exist
fn method_table_idx(pool: *Pool, prog: *Prog, tname: string,
                    mname: string) -> i64 {
  if !user_fn_exists(prog, tname + "." + mname) {
    return 0 - 1;
  }
  let full: string = "$u_" + sym_name(tname + "_" + mname);
  let mut i: usize = 0;
  while i < pool.gi.cfn {
    if pool.gi.clo_wasms[i] == full {
      return i as i64;
    }
    i = i + 1;
  }
  if pool.gi.cfn >= len(pool.gi.clo_wasms) {
    return 0 - 1;
  }
  pool.gi.clo_wasms[pool.gi.cfn] = full;
  // the arity the dispatch will use: receiver + args (bounded 3)
  let fdm2: *FnDef = fn_def_of(prog, tname + "." + mname);
  let ari: i64 = 1 + (len(fdm2.params) as i64) - 1;
  clo_ty_need(pool.gi, ari, 1);
  pool.gi.cfn = pool.gi.cfn + 1;
  return (pool.gi.cfn as i64) - 1;
}

// the table index of a type's release walker (registering it once);
// -1 when the type owns nothing
fn rel_table_idx(pool: *Pool, prog: *Prog, tname: string) -> i64 {
  let relnm: string = rel_callee(pool, prog, "*" + tname);
  if len(relnm) == 0 {
    return 0 - 1;
  }
  let mut i: usize = 0;
  while i < pool.gi.cfn {
    if pool.gi.clo_wasms[i] == relnm {
      return i as i64;
    }
    i = i + 1;
  }
  if pool.gi.cfn >= len(pool.gi.clo_wasms) {
    return 0 - 1;
  }
  pool.gi.clo_wasms[pool.gi.cfn] = relnm;
  clo_ty_need(pool.gi, 1, 1);
  pool.gi.cfn = pool.gi.cfn + 1;
  return (pool.gi.cfn as i64) - 1;
}

// the vtable box for (trait, type): slot k holds the table index of
// the type's method k (built once per pair, cached by name)
fn dyn_vtable(pool: *Pool, prog: *Prog, trt: string,
              tname: string) -> string {
  // the emitted text leaves the box address on the stack
  let vtkey: string = "vt:" + trt + ":" + tname;
  let mut i: usize = 0;
  while i < pool.gi.n {
    if pool.gi.bases[i] == vtkey {
      return pool.gi.keys[i];
    }
    i = i + 1;
  }
  let mut td_i: i64 = 0 - 1;
  let mut ti: usize = 0;
  while ti < prog.ntraits {
    if prog.traits[ti].name == trt {
      td_i = ti as i64;
    }
    ti = ti + 1;
  }
  if td_i < 0 {
    return "";
  }
  let td = prog.traits[td_i as usize];
  let mut text: string =
      "    (i64.extend_i32_u (call $w_alloc (i32.const " +
      (td.nmethods + 1).to_str() + ")))\n" +
      "    (local.set $r)\n";
  let mut k: usize = 0;
  while k < td.nmethods {
    let midx: i64 = method_table_idx(pool, prog, tname,
                                     td.methods[k]);
    if midx < 0 {
      return "";
    }
    text = text + "    (i64.store (i32.add (i32.wrap_i64 " +
           "(local.get $r)) (i32.const " + (k * 8).to_str() +
           ")) (i64.const " + midx.to_str() + "))\n";
    k = k + 1;
  }
  // slot nmethods: the release walker — a dyn's death dispatches
  // through the vtable (the mirror of boot's header drop slot)
  let ridx: i64 = rel_table_idx(pool, prog, tname);
  if ridx >= 0 {
    text = text + "    (i64.store (i32.add (i32.wrap_i64 " +
           "(local.get $r)) (i32.const " +
           ((td.nmethods as i64) * 8).to_str() +
           ")) (i64.const " + ridx.to_str() + "))\n";
  }
  text = text + "    (local.get $r)\n";
  // cache: bases carries the key, keys carries the emitted text
  if pool.gi.n >= len(pool.gi.bases) {
    return text;
  }
  pool.gi.bases[pool.gi.n] = vtkey;
  pool.gi.keys[pool.gi.n] = text;
  pool.gi.sufs[pool.gi.n] = "";
  pool.gi.fds[pool.gi.n] = prog.fns[0];
  pool.gi.n = pool.gi.n + 1;
  return text;
}

// a wasm-safe symbol: '.' can't ride an id (Type.method → Type_method)
fn sym_name(name: string) -> string {
  let mut out: string = "";
  let mut i: usize = 0;
  while i < len(name) {
    if name[i] == 46 {
      out = out + "_";
    } else {
      out = out + name[i..(i + 1)];
    }
    i = i + 1;
  }
  return out;
}

// wrap the stack's i64 to the width: two's complement makes
// wrap-after-op equal the width-native op on the sign-/zero-extended
// representation
fn wrap_snippet(w: i64) -> string {
  if w == 0 {
    return "";
  }
  let mut bits: i64 = w;
  if bits < 0 {
    bits = 0 - bits;
  }
  if bits >= 64 {
    return ""; // the full lane already
  }
  if bits >= 32 {
    if w < 0 {
      return "    (i32.wrap_i64)\n    (i64.extend_i32_u)\n";
    }
    return "    (i32.wrap_i64)\n    (i64.extend_i32_s)\n";
  }
  let sh: i64 = 32 - bits;
  let mask: i64 = (1 << bits) - 1;
  if w < 0 {
    return "    (i32.wrap_i64)\n    (i32.and (i32.const " +
           mask.to_str() + "))\n    (i64.extend_i32_u)\n";
  }
  return "    (i32.wrap_i64)\n    (i32.shl (i32.const " + sh.to_str() +
         "))\n    (i32.shr_s (i32.const " + sh.to_str() +
         "))\n    (i64.extend_i32_s)\n";
}

// a module-level name's global form, "" when absent
fn static_global(prog: *Prog, name: string) -> string {
  let mut i: usize = 0;
  while i < prog.nconsts {
    if prog.consts[i] == name && prog.cstatic[i] {
      return "$g_" + name;
    }
    i = i + 1;
  }
  return "";
}

// a static of string type: its pair rides the two globals
// $g_NAME / $g_NAME_l
fn str_static_is(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < prog.nconsts {
    if prog.consts[i] == name && prog.cstatic[i] &&
        prog.ctypes[i] == "string" {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn const_value(prog: *Prog, name: string) -> i64 {
  let mut i: usize = 0;
  while i < prog.nconsts {
    if prog.consts[i] == name && !prog.cstatic[i] {
      return prog.cvals[i];
    }
    i = i + 1;
  }
  return 0;
}

fn name_is_const(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < prog.nconsts {
    if prog.consts[i] == name && !prog.cstatic[i] {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// a const/static's float kind by its written type, 0 when not float
fn const_fkind(prog: *Prog, name: string) -> i64 {
  let mut i: usize = 0;
  while i < prog.nconsts {
    if prog.consts[i] == name {
      if prog.ctypes[i] == "f64" {
        return 1;
      }
      if prog.ctypes[i] == "f32" {
        return 2;
      }
      return 0;
    }
    i = i + 1;
  }
  return 0;
}

// a const/static's initializer expression (every const has one; a
// missing name yields the harmless 0 literal)
fn const_init_expr(prog: *Prog, name: string) -> *Expr {
  let mut i: usize = 0;
  while i < prog.nconsts {
    if prog.consts[i] == name {
      return prog.cexprs[i];
    }
    i = i + 1;
  }
  return parse.lit(0);
}

// the wat operator for an op code
fn wat_op(op: i64) -> string {
  if op == 0 {
    return "i64.add";
  }
  if op == 1 {
    return "i64.sub";
  }
  if op == 2 {
    return "i64.mul";
  }
  if op == 3 {
    return "i64.div_s";
  }
  if op == 4 {
    return "i64.rem_s";
  }
  if op == 5 {
    return "i64.lt_s";
  }
  if op == 6 {
    return "i64.gt_s";
  }
  if op == 7 {
    return "i64.le_s";
  }
  if op == 8 {
    return "i64.ge_s";
  }
  if op == 9 {
    return "i64.eq";
  }
  if op == 11 {
    return "i32.wrap_i64";
  }
  if op == 12 {
    return "i64.eq";
  }
  if op == 15 {
    return "i64.and";
  }
  if op == 16 {
    return "i64.or";
  }
  if op == 17 {
    return "i64.xor";
  }
  if op == 18 {
    return "i64.shl";
  }
  if op == 19 {
    return "i64.shr_s";
  }
  return "i64.ne";
}

// the raw text when an expr is a string literal, a string variable,
// or a + concatenation of those; absent otherwise
fn fold_string(e: *Expr, env: *Env) -> ?string {
  if e.tag == parse.EX_STR {
    return Option.Some(e.name);
  }
  if e.tag == parse.EX_VAR {
    return env_str_raw(env, e.name);
  }
  if e.tag == parse.EX_BIN && e.op == 0 {
    let mut lraw: string = "";
    let mut have: bool = false;
    match e.lhs {
      Option.Some(l) => {
        match fold_string(l, env) {
          Option.Some(ls) => {
            lraw = ls;
            have = true;
          },
          Option.None => {},
        }
      },
      Option.None => {},
    }
    if !have {
      return Option.None;
    }
    let mut rraw: string = "";
    match e.rhs {
      Option.Some(r) => {
        match fold_string(r, env) {
          Option.Some(rs) => {
            rraw = rs;
          },
          Option.None => {
            return Option.None;
          },
        }
      },
      Option.None => {
        return Option.None;
      },
    }
    return Option.Some(lraw + rraw);
  }
  return Option.None;
}

fn is_stringy(e: *Expr, env: *Env, prog: *Prog) -> bool {
  if e.tag == parse.EX_STR {
    return true;
  }
  if e.tag == parse.EX_CALL {
    // format builds a string; so does any call with a string return
    if e.name == "format" {
      return true;
    }
    return call_fn_rtype(prog, e, env) == "string";
  }
  if e.tag == parse.EX_VAR {
    if str_static_is(prog, e.name) {
      return true;
    }
    return env_str_is_runtime(env, e.name) &&
           env_kind_of(env, e.name) == 1;
  }
  if e.tag == parse.EX_IDX {
    // a string element's pair loads at the 16-byte stride
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    if base.tag == parse.EX_VAR {
      return env_kind_of(env, base.name) == 2 &&
             env_slice_elemtext(env, base.name) == "string";
    }
    return false;
  }
  if e.tag == parse.EX_FIELD {
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    let bt: string = field_base_type(base, env, prog);
    if len(bt) > 0 {
      let si: i64 = st_index(prog, bt);
      let fi: i64 = st_field_index(prog, si, e.name);
      if fi >= 0 {
        return type_kind(prog.structs[si as usize].types[fi as usize]) == 1;
      }
    }
    return false;
  }
  return false;
}

// an Option scrutinee's payload pointer target: a binding's recorded
// text, a slice element's, or a struct-field slice's (one field step)
fn optpt_of_scrutinee(sc: *Expr, env: *Env, prog: *Prog) -> string {
  if sc.tag == parse.EX_VAR {
    // the pointer target; a string payload rides its raw text (the
    // binder walk keys on "string")
    let pt: string = env_slicept_of(env, sc.name);
    if len(pt) > 0 {
      return pt;
    }
    return env_slice_elemtext(env, sc.name);
  }
  if sc.tag == parse.EX_IDX {
    let mut b: *Expr = parse.lit(0);
    match sc.lhs {
      Option.Some(bb) => {
        b = bb;
      },
      Option.None => {},
    }
    if b.tag == parse.EX_VAR {
      return env_slicept_of(env, b.name);
    }
    if b.tag == parse.EX_FIELD {
      let mut owner: *Expr = parse.lit(0);
      match b.lhs {
        Option.Some(oo) => {
          owner = oo;
        },
        Option.None => {},
      }
      let bt: string = field_base_type(owner, env, prog);
      if len(bt) > 0 {
        let si: i64 = st_index(prog, bt);
        let fi: i64 = st_field_index(prog, si, b.name);
        if fi >= 0 {
          let fty: string =
              prog.structs[si as usize].types[fi as usize];
          if len(fty) >= 2 && fty[0] == 91 && fty[1] == 93 {
            return type_ptr_target(fty[2..len(fty)]);
          }
        }
      }
    }
    return "";
  }
  return "";
}

fn both_stringy(e: *Expr, env: *Env, prog: *Prog) -> bool {
  let mut l: bool = false;
  match e.lhs {
    Option.Some(x) => {
      l = is_stringy(x, env, prog);
    },
    Option.None => {},
  }
  if !l {
    return false;
  }
  match e.rhs {
    Option.Some(y) => {
      return is_stringy(y, env, prog);
    },
    Option.None => {
      return false;
    },
  }
}

// compile an expression: lines that leave one i64 on the stack
fn emit_expr(pool: *Pool, e: *Expr, env: *Env, prog: *Prog,
             nl: *NextLocal) -> string {
  if e.tag == parse.EX_LIT {
    return "    (i64.const " + e.lit.to_str() + ")\n";
  }
  if e.tag == parse.EX_VAR {
    let slot: i64 = env_look(env, e.name);
    if slot < 0 {
      if name_is_const(prog, e.name) {
        // a float-typed const's bits come from its literal's raw text
        // (wat2wasm does the strtod, exactly like an EX_FLIT)
        let ck: i64 = const_fkind(prog, e.name);
        let ie: *Expr = const_init_expr(prog, e.name);
        if ck == 2 && ie.tag == parse.EX_FLIT {
          return "    (i64.reinterpret_f64 (f64.promote_f32 " +
                 "(f32.demote_f64 (f64.const " + ie.name + "))))\n";
        }
        if ck == 1 && ie.tag == parse.EX_FLIT {
          return "    (i64.reinterpret_f64 (f64.const " + ie.name +
                 "))\n";
        }
        return "    (i64.const " + const_value(prog, e.name).to_str() +
               ")\n";
      }
      if len(static_global(prog, e.name)) > 0 {
        return "    (global.get " + static_global(prog, e.name) + ")\n";
      }
      return "    (i64.const 0)\n";
    }
    return "    (local.get " + slot.to_str() + ")\n";
  }
  if e.tag == parse.EX_CALL && e.name == "len" && len(e.args) == 1 {
    let a0 = e.args[0];
    if a0.tag == parse.EX_VAR && env_str_is_runtime(env, a0.name) {
      return "    (local.get " +
             env_str_len_slot(env, a0.name).to_str() + ")\n";
    }
    if a0.tag == parse.EX_VAR && str_static_is(prog, a0.name) {
      return "    (global.get $g_" + a0.name + "_l)\n";
    }
    match fold_string(a0, env) {
      Option.Some(raw) => {
        return "    (i64.const " + decoded_len(raw).to_str() + ")\n";
      },
      Option.None => {},
    }
    // len(base[a..b]): the view's length without building it — both
    // ends bounds-check against the base's length (the same panics
    // the view would raise), then the difference
    if a0.tag == parse.EX_SLICE2 && a0.lhs != Option.None {
      let mut base: *Expr = parse.lit(0);
      match a0.lhs {
        Option.Some(bb) => {
          base = bb;
        },
        Option.None => {},
      }
      if base.tag == parse.EX_VAR {
        let bk: i64 = env_kind_of(env, base.name);
        if bk == 0 || bk == 1 {
          let mut blen: string = "";
          if bk == 0 {
            blen = "(i64.const " + env_str_len(env, base.name).to_str() +
                   ")";
          } else {
            blen = "(local.get " +
                   env_str_len_slot(env, base.name).to_str() + ")";
          }
          let mut out: string = "";
          // lo parks in $r through its check
          if a0.op % 2 == 1 && len(a0.args) > 0 {
            out = out + emit_expr(pool, a0.args[0], env, prog, nl);
          } else {
            out = out + "    (i64.const 0)\n";
          }
          out = out + "    (local.set $r)\n";
          out = out + "    (local.set $t (local.get $r))\n";
          out = out + oob_check_at(pool, blen, false);
          // hi rides $t through its check
          if (a0.op / 2) % 2 == 1 && len(a0.args) > 1 {
            out = out + emit_expr(pool, a0.args[1], env, prog, nl);
          } else {
            out = out + "    " + blen + "\n";
          }
          out = out + "    (local.set $t)\n";
          out = out + oob_check_at(pool, blen, false);
          // hi - lo
          out = out + "    (local.get $t)\n    (local.get $r)\n" +
                 "    (i64.sub)\n";
          return out;
        }
      }
    }
  }
  if e.tag == parse.EX_IDX {
    // base[i] — byte loads for strings, i64 loads for slices; the
    // index rides $t under a bounds check
    let mut out: string = "";
    let mut idx: *Expr = parse.lit(0);
    match e.rhs {
      Option.Some(i) => {
        idx = i;
      },
      Option.None => {},
    }
    out = out + emit_expr(pool, idx, env, prog, nl);
    out = out + "    (local.set $t)\n";
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    if base.tag == parse.EX_VAR {
      let a: i64 = env_str_look(env, base.name);
      if a < 0 {
        // runtime pair: slice or string
        let addr_slot: i64 = (0 - a) - 1;
        let len_slot: i64 = env_str_len_slot(env, base.name);
        out = out + oob_check(pool, "(local.get " + len_slot.to_str() +
                              ")");
        if env_kind_of(env, base.name) == 2 {
          let et0: string = env_slice_elemtext(env, base.name);
          if st_index(prog, et0) >= 0 {
            // a struct element: the element's ADDRESS rides (a slot
            // block of the struct's own width; leaf fields and whole
            // copies load above it)
            let esz0: i64 =
                st_nslots(prog, st_index(prog, et0));
            out = out + "    (i64.add (local.get " + addr_slot.to_str() +
                   ") (i64.mul (local.get $t) (i64.const " +
                   (esz0 * 8).to_str() + ")))\n";
            return out;
          }
          out = out + "    (i64.load (i32.add (i32.wrap_i64 (local.get " +
                 addr_slot.to_str() + "))\n" +
                 "                     (i32.mul (i32.wrap_i64 " +
                 "(local.get $t)) (i32.const 8))))\n";
        } else {
          out = out + "    (i64.extend_i32_u (i32.load8_u " +
                 "(i32.add (i32.wrap_i64 (local.get " +
                 addr_slot.to_str() + "))\n" +
                 "                     (i32.wrap_i64 (local.get $t)))))\n";
        }
        return out;
      }
      if env_kind_of(env, base.name) == 0 {
        // a folded string: const addr, const len
        let ln: i64 = env_str_len(env, base.name);
        out = out + oob_check(pool, "(i64.const " + ln.to_str() + ")");
        out = out + "    (i64.extend_i32_u (i32.load8_u (i32.add " +
               "(i32.const " + a.to_str() + ")\n" +
               "                     (i32.wrap_i64 (local.get $t)))))\n";
        return out;
      }
    }
    if base.tag == parse.EX_STR {
      let saddr: i64 = pool_intern(pool, base.name);
      let ln: i64 = pool_len(pool, base.name);
      out = out + oob_check(pool, "(i64.const " + ln.to_str() + ")");
      out = out + "    (i64.extend_i32_u (i32.load8_u (i32.add " +
             "(i32.const " + saddr.to_str() + ")\n" +
             "                     (i32.wrap_i64 (local.get $t)))))\n";
      return out;
    }
    if base.tag == parse.EX_FIELD {
      // a slice field: the pair rides the value frame or the heap
      // (the OWNER's type resolves the field, not the field's own
      // pointer target)
      let mut owner: *Expr = parse.lit(0);
      match base.lhs {
        Option.Some(o) => {
          owner = o;
        },
        Option.None => {},
      }
      let bt: string = field_base_type(owner, env, prog);
      if len(bt) > 0 {
        let si: i64 = st_index(prog, bt);
        let fi: i64 = st_field_index(prog, si, base.name);
        if fi >= 0 &&
            type_kind(prog.structs[si as usize].types[fi as usize]) == 2 {
          let off: i64 = st_field_off(prog, si, fi) * 8;
          let mut vb: *Expr = owner;
          if vb.tag == parse.EX_VAR &&
              len(env_val_of(env, vb.name)) > 0 {
            let b0: i64 = env_val_base(env, vb.name);
            out = out + oob_check(pool, "(local.get " +
                   (b0 + off / 8 + 1).to_str() + ")");
            out = out + "    (i64.load (i32.add (i32.wrap_i64 (local.get " +
                   (b0 + off / 8).to_str() + "))\n" +
                   "                     (i32.mul (i32.wrap_i64 " +
                   "(local.get $t)) (i32.const 8))))\n";
            return out;
          }
          // the heap pair: the owner's address parks in a temp
          let t0: i64 = nl.v;
          nl.v = nl.v + 1;
          out = out + emit_expr(pool, vb, env, prog, nl);
          out = out + "    (local.set " + t0.to_str() + ")\n";
          out = out + oob_check(pool, "(i64.load (i32.add (i32.wrap_i64 " +
                 "(local.get " + t0.to_str() + ")) (i32.const " +
                 (off + 8).to_str() + ")))");
          // the element rides INSIDE the pair's storage: load the
          // stored address first, then index
          out = out + "    (i64.load (i32.add (i32.wrap_i64 (i64.load " +
                 "(i32.add (i32.wrap_i64 " +
                 "(local.get " + t0.to_str() + ")) (i32.const " +
                 off.to_str() + ")))\n" +
                 "                     )\n" +
                 "                     (i32.mul (i32.wrap_i64 " +
                 "(local.get $t)) (i32.const 8))))\n";
          return out;
        }
      }
    }
    return "    (i64.const 0)\n";
  }
  if e.tag == parse.EX_FIELD {
    // base.f — the receiver's address loads the field's slot; the
    // load re-wraps at the field's width (an i32 field's stored wrap
    // left a sign-extended i64, but a fresh wrap keeps the invariant)
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    // Enum.Var / Option.None without call parens — a unit-variant
    // constructor box
    if base.tag == parse.EX_VAR &&
        (en_index(prog, base.name) >= 0 || base.name == "Option") {
      let mut tag0: i64 = 0 - 1;
      let mut nbox0: i64 = 1;
      if base.name == "Option" {
        if e.name == "Some" {
          tag0 = 1;
        } else {
          tag0 = 0;
        }
        nbox0 = 2;
      } else {
        let ei0: i64 = en_index(prog, base.name);
        tag0 = en_vtag(prog, ei0, e.name);
        nbox0 = en_nslots(prog, ei0);
      }
      let b_slot: i64 = nl.v;
      nl.v = nl.v + 1;
      return "    (i64.extend_i32_u (call $w_alloc (i32.const " +
             nbox0.to_str() + ")))\n" +
             "    (local.set " + b_slot.to_str() + ")\n" +
             "    (i64.store (i32.wrap_i64 (local.get " + b_slot.to_str() +
             ")) (i64.const " + tag0.to_str() + "))\n" +
             "    (local.get " + b_slot.to_str() + ")\n";
    }
    let bt: string = field_base_type(base, env, prog);
    if len(bt) == 0 {
      return "    (i64.const 0)\n";
    }
    let si: i64 = st_index(prog, bt);
    let fi: i64 = st_field_index(prog, si, e.name);
    if fi < 0 {
      return "    (i64.const 0)\n";
    }
    let fty: string = prog.structs[si as usize].types[fi as usize];
    let off: i64 = st_field_off(prog, si, fi);
    // a chain rooted in the frame flattens: every link resolves to
    // frame slots, so the read is one local.get however deep
    let fb2: i64 = val_chain_slot(base, env, prog);
    if fb2 >= 0 {
      if st_index(prog, fty) >= 0 {
        // a by-value struct field: the chain continues from here
        return "    (local.get " + (fb2 + off).to_str() + ")\n";
      }
      return "    (local.get " + (fb2 + off).to_str() + ")\n" +
             wrap_snippet(type_width(fty));
    }
    if st_index(prog, fty) >= 0 {
      // a by-value struct field over an address base: expose the
      // sub-struct's ADDRESS (leaf fields load above it)
      let mut out: string = emit_expr(pool, base, env, prog, nl);
      out = out + "    (i32.wrap_i64)\n" +
             "    (i32.add (i32.const " + (off * 8).to_str() + "))\n" +
             "    (i64.extend_i32_u)\n";
      return out;
    }
    let mut out: string = emit_expr(pool, base, env, prog, nl);
    out = out + "    (i32.add (i32.wrap_i64) (i32.const " + (off * 8).to_str() +
           "))\n";
    out = out + "    (i64.load)\n";
    out = out + wrap_snippet(type_width(fty));
    return out;
  }
  if e.tag == parse.EX_MCALL {
    // recv.name(args) — the receiver rides as the first parameter; a
    // receiver that names a struct type is the associated-fn call
    let mut recv: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(r) => {
        recv = r;
      },
      Option.None => {},
    }
    // weak.from(p) — the handle is the pointer itself
    if recv.tag == parse.EX_VAR && recv.name == "weak" &&
        e.name == "from" && len(e.args) >= 1 {
      return emit_expr(pool, e.args[0], env, prog, nl);
    }
    // DISABLED with the dyn emit (084's crash); re-lands with the
    // coercion above
    if recv.tag == parse.EX_VAR &&
        is_dyn_type(env_slice_elemtext(env, recv.name)) {
      let trt8: string =
          dyn_trait(env_slice_elemtext(env, recv.name));
      let ord8: i64 = trait_ordinal(prog, trt8, e.name);

      if ord8 >= 0 {        let a0r: i64 = env_str_look(env, recv.name);
        let vbox8: i64 = (0 - a0r) - 1;
        let obj8: i64 = env_str_len_slot(env, recv.name);
        // the declared return rides the trait table (the dispatch
        // picks its calling type by it)
        let mut rtype8: string = "i64";
        let mut t8: usize = 0;
        while t8 < prog.ntraits {
          if prog.traits[t8].name == trt8 {
            let mut m8: usize = 0;
            while m8 < prog.traits[t8].nmethods {
              if prog.traits[t8].methods[m8] == e.name &&
                  m8 < len(prog.traits[t8].rtypes) {
                rtype8 = prog.traits[t8].rtypes[m8];
              }
              m8 = m8 + 1;
            }
          }
          t8 = t8 + 1;
        }
        let mut out8: string = "";
        // a string result's pair slots reserve FIRST — args may take
        // temps between here and the park, and callers (the hole
        // dispatch) key on the reserved pair's position
        let mut pa8: i64 = 0 - 1;
        if rtype8 == "string" {
          pa8 = nl.v;
          nl.v = nl.v + 2;
        }
        let mut ai8: usize = 0;
        while ai8 < len(e.args) && ai8 < 2 {
          out8 = out8 + emit_arg(pool, e.args[ai8], env, prog, nl);
          ai8 = ai8 + 1;
        }
        out8 = out8 + "    (local.get " + obj8.to_str() + ")\n" +
               "    (i64.load (i32.add (i32.wrap_i64 (local.get " +
               vbox8.to_str() + ")) (i32.const " +
               (ord8 * 8).to_str() + ")))\n" +
               "    (i32.wrap_i64)\n";
        if rtype8 == "string" {
          // a pair result parks into the reserved slots; the address
          // rides the scalar lane (the stringy pattern). The calling
          // type keys on the arity: receiver + args ($clp1..$clp3)
          let mut ari8: i64 = 1 + (len(e.args) as i64);
          if ari8 > 3 {
            ari8 = 3;
          }
          clo_ty_need(pool.gi, ari8, 2);
          out8 = out8 + "    call_indirect (type $clp" +
                 ari8.to_str() + ")\n" +
                 "    (local.set " + (pa8 + 1).to_str() + ")\n" +
                 "    (local.set " + pa8.to_str() + ")\n" +
                 "    (local.get " + pa8.to_str() + ")\n";
        } else {
          let mut ari9: i64 = 1 + (len(e.args) as i64);
          if ari9 > 3 {
            ari9 = 3;
          }
          clo_ty_need(pool.gi, ari9, 1);
          out8 = out8 + "    call_indirect (type $cl" +
                 ari9.to_str() + ")\n";
        }
        return out8;
      }
    }
    // a dyn FIELD or ELEMENT receiver: its fat pair loads first,
    // then the dispatch rides the loaded vtable/obj slots
    if recv.tag == parse.EX_FIELD || recv.tag == parse.EX_IDX {
      let vt10: string = dyn_recv_trait(recv, env, prog);
      if len(vt10) > 0 {
        let ord10: i64 = trait_ordinal(prog, vt10, e.name);
        let ld10: string = dyn_pair_load(recv, pool, env, prog, nl);
        if ord10 >= 0 && len(ld10) > 0 {
          let vbox10: i64 = nl.v - 2;
          let obj10: i64 = nl.v - 1;
          // the declared return rides the trait table
          let mut rtype10: string = "i64";
          let mut t10: usize = 0;
          while t10 < prog.ntraits {
            if prog.traits[t10].name == vt10 {
              let mut m10: usize = 0;
              while m10 < prog.traits[t10].nmethods {
                if prog.traits[t10].methods[m10] == e.name &&
                    m10 < len(prog.traits[t10].rtypes) {
                  rtype10 = prog.traits[t10].rtypes[m10];
                }
                m10 = m10 + 1;
              }
            }
            t10 = t10 + 1;
          }
          let mut out10: string = ld10;
          let mut pa10: i64 = 0 - 1;
          if rtype10 == "string" {
            pa10 = nl.v;
            nl.v = nl.v + 2;
          }
          let mut ai10: usize = 0;
          while ai10 < len(e.args) && ai10 < 2 {
            out10 = out10 + emit_arg(pool, e.args[ai10], env,
                                     prog, nl);
            ai10 = ai10 + 1;
          }
          out10 = out10 + "    (local.get " + obj10.to_str() +
                  ")\n" +
                  "    (i64.load (i32.add (i32.wrap_i64 " +
                  "(local.get " + vbox10.to_str() + ")) (i32.const " +
                  (ord10 * 8).to_str() + ")))\n" +
                  "    (i32.wrap_i64)\n";
          if rtype10 == "string" {
            let mut ari10: i64 = 1 + (len(e.args) as i64);
            if ari10 > 3 {
              ari10 = 3;
            }
            clo_ty_need(pool.gi, ari10, 2);
            out10 = out10 + "    call_indirect (type $clp" +
                    ari10.to_str() + ")\n" +
                    "    (local.set " + (pa10 + 1).to_str() +
                    ")\n" +
                    "    (local.set " + pa10.to_str() + ")\n" +
                    "    (local.get " + pa10.to_str() + ")\n";
          } else {
            let mut ari11: i64 = 1 + (len(e.args) as i64);
            if ari11 > 3 {
              ari11 = 3;
            }
            clo_ty_need(pool.gi, ari11, 1);
            out10 = out10 + "    call_indirect (type $cl" +
                    ari11.to_str() + ")\n";
          }
          return out10;
        }
      }
    }
    // w.get() — the absence probe: the header's rc decides
    if recv.tag == parse.EX_VAR &&
        len(env_ptr_of(env, recv.name)) >= 6 &&
        env_ptr_of(env, recv.name)[0] == 119 &&
        env_ptr_of(env, recv.name)[1] == 101 &&
        env_ptr_of(env, recv.name)[2] == 97 &&
        env_ptr_of(env, recv.name)[3] == 107 &&
        env_ptr_of(env, recv.name)[4] == 58 &&
        e.name == "get" {
      let wg: i64 = nl.v;
      nl.v = nl.v + 1;
      let wb: i64 = nl.v;
      nl.v = nl.v + 1;
      let mut out: string = emit_expr(pool, recv, env, prog, nl);
      out = out + "    (local.set " + wg.to_str() + ")\n";
      out = out + "    (i64.extend_i32_u (call $w_alloc (i32.const 2)))\n" +
             "    (local.set " + wb.to_str() + ")\n";
      let wtg3: string = weak_target(env_ptr_of(env, recv.name));
      out = out + "    (if (i64.ne (local.get " + wg.to_str() +
             ") (i64.const 0))\n" +
             "      (then (if (i64.gt_s (i64.load (i32.sub " +
             "(i32.wrap_i64 (local.get " + wg.to_str() +
             ")) (i32.const 8))) (i64.const 0))\n" +
             "        (then\n" +
             "          (i64.store (i32.wrap_i64 (local.get " +
             wb.to_str() + ")) (i64.const 1))\n" +
             "          (i64.store (i32.add (i32.wrap_i64 (local.get " +
             wb.to_str() + ")) (i32.const 8)) (local.get " +
             wg.to_str() + "))\n";
      if st_index(prog, wtg3) >= 0 {
        // the fresh box owns its payload: the count pairs with the
        // box's own death walk — INSIDE the live branch (a dead
        // probe must never resurrect)
        out = out + "          (local.get " + wg.to_str() + ")\n" +
               "          call $w_retain\n";
      }
      out = out + "        ))))\n";
      out = out + "    (local.get " + wb.to_str() + ")\n";
      return out;
    }
    // an enum constructor: Enum.Var / Enum.Var(args) / Option.* /
    // Result.* (Ok rides tag 1, Err tag 2); a string payload rides
    // its pair — TWO box slots (addr, len), by the declared payload
    // type for user enums, by the argument's own stringiness for the
    // builtins (Result.Err's string is the corpus idiom)
    if recv.tag == parse.EX_VAR &&
        (en_index(prog, recv.name) >= 0 || recv.name == "Option" ||
         recv.name == "Result") {
      let mut tag: i64 = 0 - 1;
      let mut nsl: i64 = 0;
      let mut nbox: i64 = 1;
      // the variant's declared payload types, when static
      let ptys2: []string = enum_variant_ptys(prog, recv.name,
                                              e.name);
      if recv.name == "Option" || recv.name == "Result" {
        if e.name == "Some" || e.name == "Ok" {
          tag = 1;
        } else {
          if recv.name == "Result" {
            tag = 2;
          } else {
            tag = 0;
          }
        }
        nsl = len(e.args) as i64;
      } else {
        let ei: i64 = en_index(prog, recv.name);
        tag = en_vtag(prog, ei, e.name);
        nsl = en_vslots(prog, ei, e.name);
      }
      // pass A: which payloads ride pairs (the box sizes by it)
      let sflag: []bool = make([]bool, 8);
      let mut ka: usize = 0;
      while (ka as i64) < nsl && ka < len(e.args) && ka < 8 {
        let mut sish: bool = false;
        if ka < len(ptys2) && ptys2[ka] == "string" {
          sish = true;
        } else {
          if len(ptys2) == 0 {
            let spk = build_string_pair(e.args[ka], pool, env,
                                        prog, nl);
            sish = spk.ok;
          }
        }
        sflag[ka] = sish;
        ka = ka + 1;
      }
      nbox = 1;
      let mut kb: usize = 0;
      while (kb as i64) < nsl && kb < 8 {
        if sflag[kb] {
          nbox = nbox + 2;
        } else {
          nbox = nbox + 1;
        }
        kb = kb + 1;
      }
      if recv.name != "Option" && recv.name != "Result" {
        // a user enum's box is the WIDEST variant's — equality and
        // cross-variant reads size by it, so every construction
        // allocates the full box
        let eix: i64 = en_index(prog, recv.name);
        if eix >= 0 {
          nbox = en_nslots(prog, eix);
        }
      }
      let a_slot: i64 = nl.v;
      nl.v = nl.v + 1;
      let mut out: string = "    (i64.extend_i32_u (call $w_alloc (i32.const " +
             nbox.to_str() + ")))\n" +
             "    (local.set " + a_slot.to_str() + ")\n" +
             "    (i64.store (i32.wrap_i64 (local.get " + a_slot.to_str() +
             ")) (i64.const " + tag.to_str() + "))\n";
      // pass B: store, pair payloads taking two consecutive slots
      let mut sl: i64 = 1;
      let mut k: usize = 0;
      while (k as i64) < nsl && k < len(e.args) {
        if k < 8 && sflag[k] {
          let spv = build_string_pair(e.args[k], pool, env, prog,
                                      nl);
          out = out + spv.text +
                 "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
                 a_slot.to_str() + ")) (i32.const " +
                 (sl * 8).to_str() + ")) (local.get " +
                 spv.a.to_str() + "))\n" +
                 "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
                 a_slot.to_str() + ")) (i32.const " +
                 ((sl + 1) * 8).to_str() + ")) (local.get " +
                 spv.l.to_str() + "))\n";
          sl = sl + 2;
        } else {
          let tv: i64 = nl.v;
          nl.v = nl.v + 1;
          out = out + emit_expr(pool, e.args[k], env, prog, nl);
          out = out + "    (local.set " + tv.to_str() + ")\n";
          // a pointer payload the box owns: the count pairs with the
          // box's death walk
          let argt: string = expr_ptr_type(e.args[k], env, prog);
          if len(argt) > 0 && st_index(prog, argt) >= 0 {
            out = out + retain_if_shared(e.args[k], tv);
          }
          out = out + "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
                 a_slot.to_str() + ")) (i32.const " +
                 (sl * 8).to_str() + ")) (local.get " + tv.to_str() +
                 "))\n";
          sl = sl + 1;
        }
        k = k + 1;
      }
      out = out + "    (local.get " + a_slot.to_str() + ")\n";
      return out;
    }
    let mut target: string = "";
    let mut out: string = "";
    let ret: string = expr_enum_type(recv, env, prog);
    let mut rtype_full: string = "";
    if recv.tag == parse.EX_VAR && st_index(prog, recv.name) >= 0 {
      target = recv.name + "_" + e.name;
    } else {
      if len(ret) > 0 {
        // an enum-typed receiver: its methods ride the same ABI
        rtype_full = ret;
        target = ret + "_" + e.name;
        out = out + emit_expr(pool, recv, env, prog, nl);
      } else {
        let bt: string = expr_ptr_type(recv, env, prog);
        if len(bt) == 0 {
          return "    (i64.const 0)\n";
        }
        rtype_full = bt;
        target = bt + "_" + e.name;
        out = out + emit_expr(pool, recv, env, prog, nl);
      }
    }
    if len(rtype_full) > 0 &&
        open_bracket(rtype_full) >= 0 {
      // a generic instantiation receiver: the method clones per bind
      let gi_m: string = ginst_method_target(pool, prog,
                                             rtype_full, e.name);
      if len(gi_m) > 0 {
        target = gi_m[3..len(gi_m)];
      }
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      out = out + emit_arg(pool, e.args[k], env, prog, nl);
      k = k + 1;
    }
    out = out + "    call $u_" + target + "\n";
    return out;
  }
  if e.tag == parse.EX_NEW {
    // new T { f: e, ... } — the zeroed block, then each written field
    // stores into its slot (pair fields take addr+len)
    let si: i64 = st_index(prog, e.name);
    if si < 0 {
      return "    (i64.const 0)\n";
    }
    let a_slot: i64 = nl.v;
    nl.v = nl.v + 1;
    let mut out: string = "    (i64.extend_i32_u (call $w_alloc (i32.const " +
           st_nslots(prog, si).to_str() + ")))\n" +
           "    (local.set " + a_slot.to_str() + ")\n";
    let mut k: usize = 0;
    while k < len(e.args) {
      let fi: i64 = st_field_index(prog, si, e.fnames[k]);
      if fi >= 0 {
        let fty: string = prog.structs[si as usize].types[fi as usize];
        let off: i64 = st_field_off(prog, si, fi) * 8;
        let kind: i64 = type_kind(fty);
        if st_index(prog, fty) >= 0 {
          // a by-value struct field: the init's slots copy in through
          // one source address (a frame-resident chain materializes
          // a box first — struct_addr_of)
          let nsn: i64 = st_nslots(prog, st_index(prog, fty));
          let tsrc: i64 = nl.v;
          nl.v = nl.v + 1;
          let tv0: i64 = nl.v;
          nl.v = nl.v + 1;
          out = out + struct_addr_of(pool, e.args[k], env, prog, nl);
          out = out + "    (local.set " + tsrc.to_str() + ")\n";
          let mut vj: i64 = 0;
          while vj < nsn {
            out = out + "    (i64.load (i32.add (i32.wrap_i64 (local.get " +
                   tsrc.to_str() + ")) (i32.const " + (vj * 8).to_str() +
                   ")))\n" +
                   "    (local.set " + tv0.to_str() + ")\n" +
                   "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
                   a_slot.to_str() + ")) (i32.const " + (off + vj * 8).to_str() +
                   ")) (local.get " + tv0.to_str() + "))\n";
            vj = vj + 1;
          }
        } else if is_dyn_type(fty) {
          // a dyn field: the init coerces — the fat pair (vtable,
          // obj) with the obj retained (the field owns a reference)
          let ftr: string = dyn_trait(fty);
          let fot: string = expr_ptr_type(e.args[k], env, prog);
          let fvt: string = dyn_vtable(pool, prog, ftr, fot);
          if len(fvt) > 0 {
            let fvb: i64 = nl.v;
            let fob: i64 = nl.v + 1;
            nl.v = nl.v + 2;
            out = out + fvt;
            out = out + "    (local.set " + fvb.to_str() + ")\n";
            out = out + emit_expr(pool, e.args[k], env, prog, nl);
            out = out + "    (local.set " + fob.to_str() + ")\n";
            out = out + retain_if_shared(e.args[k], fob);
            out = out + "    (i64.store (i32.add (i32.wrap_i64 " +
                   "(local.get " + a_slot.to_str() + ")) (i32.const " +
                   off.to_str() + ")) (local.get " + fvb.to_str() +
                   "))\n";
            out = out + "    (i64.store (i32.add (i32.wrap_i64 " +
                   "(local.get " + a_slot.to_str() + ")) (i32.const " +
                   (off + 8).to_str() + ")) (local.get " +
                   fob.to_str() + "))\n";
          }
        } else if kind == 1 || kind == 2 {
          let ta: i64 = nl.v;
          let tl: i64 = nl.v + 1;
          nl.v = nl.v + 2;
          if e.args[k].tag == parse.EX_MAKE {
            // a fresh slice rides straight into the field's pair
            let mut cnt0: *Expr = parse.lit(0);
            if len(e.args[k].args) > 0 {
              cnt0 = e.args[k].args[0];
            }
            out = out + emit_expr(pool, cnt0, env, prog, nl);
            out = out + "    (local.set $t)\n";
            out = out + "    (i64.extend_i32_u (call $w_alloc " +
                   "(i32.wrap_i64 (local.get $t))))\n";
            out = out + "    (local.get $t)\n";
          } else {
            out = out + push_string(pool, e.args[k], env, prog, nl);
          }
          out = out + "    (local.set " + tl.to_str() + ")\n" +
                 "    (local.set " + ta.to_str() + ")\n" +
                 "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
                 a_slot.to_str() + ")) (i32.const " + off.to_str() +
                 ")) (local.get " + ta.to_str() + "))\n" +
                 "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
                 a_slot.to_str() + ")) (i32.const " + (off + 8).to_str() +
                 ")) (local.get " + tl.to_str() + "))\n";
        } else {
          let tv: i64 = nl.v;
          nl.v = nl.v + 1;
          out = out + emit_expr(pool, e.args[k], env, prog, nl);
          out = out + wrap_snippet(type_width(fty));
          out = out + "    (local.set " + tv.to_str() + ")\n";
          // a counted field (pointer, option, enum): the box owns it
          if len(rel_callee(pool, prog, fty)) > 0 {
            out = out + retain_if_shared(e.args[k], tv);
          }
          out = out + "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
                 a_slot.to_str() + ")) (i32.const " + off.to_str() +
                 ")) (local.get " + tv.to_str() + "))\n";
        }
      }
      k = k + 1;
    }
    out = out + "    (local.get " + a_slot.to_str() + ")\n";
    return out;
  }
  if e.tag == parse.EX_DEREF {
    // (*e) — the pointed value; in scalar contexts the address itself
    // rides (the aggregate copy lands with the value-binding growth)
    match e.lhs {
      Option.Some(inner) => {
        return emit_expr(pool, inner, env, prog, nl);
      },
      Option.None => {
        return "    (i64.const 0)\n";
      },
    }
  }
  if e.tag == parse.EX_Q {
    // e? — the box parks in a temp; Ok/Some unwraps the payload,
    // anything else returns the box through the enclosing fn (the
    // open defers unwind first, like every return)
    let mut inner: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(x) => {
        inner = x;
      },
      Option.None => {},
    }
    let bx: i64 = nl.v;
    nl.v = nl.v + 1;
    let mut out: string = emit_expr(pool, inner, env, prog, nl);
    out = out + "    (local.set " + bx.to_str() + ")\n" +
           "    (if (result i64) (i64.eq (i64.load (i32.wrap_i64 " +
           "(local.get " + bx.to_str() + "))) (i64.const 1))\n" +
           "      (then (i64.load (i32.add (i32.wrap_i64 (local.get " +
           bx.to_str() + ")) (i32.const 8))))\n" +
           "      (else\n" +
           dunwind_emit(env.dstack) +
           "        (local.get " + bx.to_str() + ")\n" +
           "        return\n" +
           "      ))\n";
    return out;
  }
  if e.tag == parse.EX_MATCH {
    // the scrutinee parks in a temp (the box for enums, the value
    // for scalars); the discriminator rides $d; arms chain as
    // (result i64) ifs, the wildcard arm closes the chain
    let mut sc: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(x) => {
        sc = x;
      },
      Option.None => {},
    }
    let bx: i64 = nl.v;
    nl.v = nl.v + 1;
    let mut out: string = emit_expr(pool, sc, env, prog, nl);
    out = out + "    (local.set " + bx.to_str() + ")\n";
    let et: string = expr_enum_type(sc, env, prog);
    if len(et) > 0 {
      out = out + "    (i64.load (i32.wrap_i64 (local.get " + bx.to_str() +
             ")))\n";
    } else {
      out = out + "    (local.get " + bx.to_str() + ")\n";
    }
    out = out + "    (local.set $d)\n";
    let mut optpt: string = optpt_of_scrutinee(sc, env, prog);
    if sc.tag == parse.EX_MCALL && sc.name == "get" {
      // w.get() — the payload is the weak's target
      let mut rw: *Expr = parse.lit(0);
      match sc.lhs {
        Option.Some(x7) => {
          rw = x7;
        },
        Option.None => {},
      }
      if rw.tag == parse.EX_VAR {
        let wtg: string = weak_target(env_ptr_of(env, rw.name));
        if len(wtg) > 0 {
          optpt = wtg;
        }
      }
    }
    out = out + match_chain_m(pool, e.marms, 0, bx, env, prog, nl,
                              true, false, optpt);
    // a fresh scrutinee box dies with the match (its payload walks)
    if expr_is_fresh(sc) {
      let scet: string = expr_enum_type(sc, env, prog);
      if len(scet) > 0 {
        let mut srel: string = "";
        if sc.tag == parse.EX_MCALL && sc.name == "get" {
          let mut rw3: *Expr = parse.lit(0);
          match sc.lhs {
            Option.Some(x9) => {
              rw3 = x9;
            },
            Option.None => {},
          }
          if rw3.tag == parse.EX_VAR {
            let wtg4: string =
                weak_target(env_ptr_of(env, rw3.name));
            if len(wtg4) > 0 {
              srel = rel_callee(pool, prog, "?*" + wtg4);
            }
          }
        }
        if len(srel) == 0 {
          srel = rel_callee(pool, prog, scet);
        }
        if len(srel) > 0 {
          out = out + "    (local.get " + bx.to_str() + ")\n" +
                 "    call " + srel + "\n";
        }
      }
    }
    return out;
  }
  if e.tag == parse.EX_ARR {
    // a slice literal in a scalar lane parks its pair, rides the addr
    let a_slot2: i64 = nl.v;
    let l_slot2: i64 = nl.v + 1;
    nl.v = nl.v + 2;
    return emit_array(pool, e, env, prog, nl) +
           "    (local.set " + l_slot2.to_str() + ")\n" +
           "    (local.set " + a_slot2.to_str() + ")\n" +
           "    (local.get " + a_slot2.to_str() + ")\n";
  }
  if e.tag == parse.EX_IF {
    // if c { a } else { b } as an expression: the arms ride one i64
    // (float arms ride bits — the lanes agree within one expression)
    let mut out: string = "";
    match e.lhs {
      Option.Some(cond) => {
        out = out + emit_expr(pool, cond, env, prog, nl);
      },
      Option.None => {
        out = out + "    (i64.const 0)\n";
      },
    }
    out = out + "    (i32.wrap_i64)\n    (if (result i64)\n" +
           "      (then\n";
    if len(e.args) > 0 {
      out = out + emit_expr(pool, e.args[0], env, prog, nl);
    } else {
      out = out + "    (i64.const 0)\n";
    }
    out = out + "      )\n      (else\n";
    if len(e.args) > 1 {
      out = out + emit_expr(pool, e.args[1], env, prog, nl);
    } else {
      out = out + "    (i64.const 0)\n";
    }
    out = out + "      ))\n";
    return out;
  }
  if e.tag == parse.EX_FLIT {
    // the raw text rides into f64.const (wat2wasm does strtod); f32
    // literals round through demote for exact f32 values
    return "    (i64.reinterpret_f64 (f64.const " + e.name + "))\n";
  }
  if e.tag == parse.EX_BIN && e.op >= 0 && e.op <= 10 &&
      expr_fkind(e, env, prog) > 0 {
    // float arithmetic and comparison: operands floatify (reinterpret
    // for float lanes, convert for int operands), the op runs in
    // f64, f32 results demote-and-promote back (exact f32 rounding)
    let fk: i64 = expr_fkind(e, env, prog);
    let mut out: string = "";
    match e.lhs {
      Option.Some(l8) => {
        out = out + emit_expr(pool, l8, env, prog, nl);
        if expr_fkind(l8, env, prog) > 0 {
          out = out + "    (f64.reinterpret_i64)\n";
        } else {
          if expr_width(l8, env, prog) < 0 {
            out = out + "    (f64.convert_i64_u)\n";
          } else {
            out = out + "    (f64.convert_i64_s)\n";
          }
        }
      },
      Option.None => {},
    }
    match e.rhs {
      Option.Some(r8) => {
        out = out + emit_expr(pool, r8, env, prog, nl);
        if expr_fkind(r8, env, prog) > 0 {
          out = out + "    (f64.reinterpret_i64)\n";
        } else {
          if expr_width(r8, env, prog) < 0 {
            out = out + "    (f64.convert_i64_u)\n";
          } else {
            out = out + "    (f64.convert_i64_s)\n";
          }
        }
      },
      Option.None => {},
    }
    if e.op >= 5 && e.op <= 10 {
      // comparisons land as i32, extended back to the i64 lane
      let cops: []string = make([]string, 11);
      cops[5] = "f64.lt";
      cops[6] = "f64.gt";
      cops[7] = "f64.le";
      cops[8] = "f64.ge";
      cops[9] = "f64.eq";
      cops[10] = "f64.ne";
      out = out + "    (" + cops[e.op as usize] + ")\n" +
             "    (i64.extend_i32_s)\n";
      return out;
    }
    let fops: []string = make([]string, 5);
    fops[0] = "f64.add";
    fops[1] = "f64.sub";
    fops[2] = "f64.mul";
    fops[3] = "f64.div";
    out = out + "    (" + fops[e.op as usize] + ")\n";
    if fk == 2 {
      out = out + "    (f64.promote_f32 (f32.demote_f64))\n";
    }
    out = out + "    (i64.reinterpret_f64)\n";
    return out;
  }
  if e.tag == parse.EX_STR {
    // a literal in a scalar lane rides its pooled ADDRESS
    let saddr0: i64 = pool_intern(pool, e.name);
    return "    (i64.const " + saddr0.to_str() + ")\n";
  }
  if e.tag == parse.EX_SLICE2 {
    // a slice expression in a scalar lane parks its pair and rides
    // the address
    let sps = build_string_pair(e, pool, env, prog, nl);
    if sps.ok {
      return sps.text + "    (local.get " + sps.a.to_str() + ")\n";
    }
  }
  if e.tag == parse.EX_BIN && e.op == 0 && both_stringy(e, env, prog) {
    // a string concat in a scalar lane parks its pair and rides the
    // ADDRESS (ctor payloads and cross-lane consumers want one i64)
    let sp = build_string_pair(e, pool, env, prog, nl);
    if sp.ok {
      return sp.text + "    (local.get " + sp.a.to_str() + ")\n";
    }
  }
  if e.tag == parse.EX_CALL && e.name == "format" &&
      len(e.args) >= 1 && e.args[0].tag == parse.EX_STR {
    let sp2 = build_string_pair(e, pool, env, prog, nl);
    if sp2.ok {
      return sp2.text + "    (local.get " + sp2.a.to_str() + ")\n";
    }
  }
  if e.tag == parse.EX_CALL && e.name == "len" && len(e.args) == 1 {
    // len over any string-buildable operand reads its pair's length
    let sp3 = build_string_pair(e.args[0], pool, env, prog, nl);
    if sp3.ok {
      return sp3.text + "    (local.get " + sp3.l.to_str() + ")\n";
    }
  }
  if (e.tag == parse.EX_CALL &&
       rtype_is_pair(call_fn_rtype(prog, e, env)) &&
       !is_fn_type(call_fn_rtype(prog, e, env))) ||
     (e.tag == parse.EX_MCALL) {
    let mut sret: bool = false;
    if e.tag == parse.EX_CALL {
      sret = true;
    } else {
      let mut recv0: *Expr = parse.lit(0);
      match e.lhs {
        Option.Some(r5) => {
          recv0 = r5;
        },
        Option.None => {},
      }
      if recv0.tag == parse.EX_VAR &&
          (st_index(prog, recv0.name) >= 0 ||
           en_index(prog, recv0.name) >= 0) {
        sret = fn_rtype_of(prog, recv0.name + "." + e.name) == "string";
      } else {
        let bt0: string = expr_ptr_type(recv0, env, prog);
        if len(bt0) > 0 {
          sret = fn_rtype_of(prog, bt0 + "." + e.name) == "string";
        }
      }
    }
    if sret {
      // a string-returning call parks its pair and rides the address
      let sp4 = build_string_pair(e, pool, env, prog, nl);
      if sp4.ok {
        return sp4.text + "    (local.get " + sp4.a.to_str() + ")\n";
      }
    }
  }
  if (e.tag == parse.EX_CALL && e.name == "printf" ||
       e.tag == parse.EX_CALL && e.name == "eprintf") &&
      len(e.args) >= 1 && e.args[0].tag == parse.EX_STR {
    // printf/eprintf riding an expression (an arm value): the writes
    // happen, a zero rides the lane
    let rest: []*Expr = e.args[1..len(e.args)];
    let mut wtext: string = "";
    if e.name == "printf" {
      wtext = emit_printf(pool, e.args[0].name, rest, env, prog, nl);
    } else {
      wtext = emit_eprintf(pool, e.args[0].name, rest, env, prog, nl);
    }
    return wtext + "    (i64.const 0)\n";
  }
  if e.tag == parse.EX_CLO {
    // the closure value: (table idx, capture box) on the lane
    return emit_closure_value(e, pool, env, prog, nl);
  }
  if e.tag == parse.EX_CALL {
    // a closure-typed binding calls through the table
    if e.tag == parse.EX_CALL && env_kind_of(env, e.name) == 3 {
      let ca: i64 = env_str_look(env, e.name);
      let idx_slot: i64 = (0 - ca) - 1;
      let box_slot: i64 = env_str_len_slot(env, e.name);
      let mut out2: string = "    (local.get " + box_slot.to_str() +
             ")\n";
      let mut k2: usize = 0;
      while k2 < len(e.args) {
        out2 = out2 + emit_arg(pool, e.args[k2], env, prog, nl);
        k2 = k2 + 1;
      }
      out2 = out2 + "    (i32.wrap_i64 (local.get " +
             idx_slot.to_str() + "))\n" +
             "    call_indirect (type $cl" +
             ((len(e.args) as i64) + 1).to_str() + ")\n";
      return out2;
    }
    if e.name == "panic" && !user_fn_exists(prog, "panic") {
      // the fatal builtin rides anywhere an expression can
      let mut pout: string = emit_panic(pool, e);
      pout = pout + "    (i64.const 0)\n";
      return pout;
    }
    let fd7: *FnDef = resolve_call_fd(prog, e, env);
    let mut out: string = "";
    out = out + emit_call_args(pool, prog, fd7, e, env, nl);
    out = out + "    call " + ginst_call_name(pool, prog, e, env) +
           "\n";
    return out;
  }
  // enum equality: tag then payload, element-wise over the boxes
  if e.op == 9 || e.op == 10 {
    let mut le: string = "";
    let mut re: string = "";
    match e.lhs {
      Option.Some(l3) => {
        le = expr_enum_type(l3, env, prog);
      },
      Option.None => {},
    }
    match e.rhs {
      Option.Some(r3) => {
        re = expr_enum_type(r3, env, prog);
      },
      Option.None => {},
    }
    if len(le) > 0 && len(re) > 0 {
      let mut out: string = "";
      match e.lhs {
        Option.Some(l3) => {
          out = out + emit_expr(pool, l3, env, prog, nl);
        },
        Option.None => {},
      }
      match e.rhs {
        Option.Some(r3) => {
          out = out + emit_expr(pool, r3, env, prog, nl);
        },
        Option.None => {},
      }
      let mut nbox2: i64 = 2;
      let ei2: i64 = en_index(prog, le);
      if ei2 >= 0 {
        nbox2 = en_nslots(prog, ei2);
      }
      out = out + "    (i64.const " + nbox2.to_str() + ")\n" +
             "    call $w_enuq\n";
      if e.op == 10 {
        out = out + "    (i64.eqz)\n    (i64.extend_i32_s)\n";
      }
      return out;
    }
  }
  // string equality routes through $w_streq over the pairs
  if (e.op == 9 || e.op == 10) && both_stringy(e, env, prog) {
    let mut out: string = "";
    match e.lhs {
      Option.Some(l) => {
        out = out + push_string(pool, l, env, prog, nl);
      },
      Option.None => {},
    }
    match e.rhs {
      Option.Some(r) => {
        out = out + push_string(pool, r, env, prog, nl);
      },
      Option.None => {},
    }
    out = out + "    call $w_streq\n";
    if e.op == 10 {
      out = out + "    (i64.eqz)\n    (i64.extend_i32_s)\n";
    }
    return out;
  }
  // short-circuit && / ||: the lhs gates whether the rhs runs at all
  // (an if with an i64 result — both operators yield 0/1)
  if e.op == 13 || e.op == 14 {
    let mut out: string = "";
    match e.lhs {
      Option.Some(l) => {
        out = out + emit_expr(pool, l, env, prog, nl);
      },
      Option.None => {},
    }
    out = out + "    (i32.wrap_i64)\n    if (result i64)\n";
    if e.op == 14 {
      out = out + "      (i64.const 1)\n    else\n";
    }
    match e.rhs {
      Option.Some(r) => {
        out = out + emit_expr(pool, r, env, prog, nl);
      },
      Option.None => {},
    }
    if e.op == 13 {
      out = out + "    else\n      (i64.const 0)\n";
    }
    out = out + "    end\n";
    return out;
  }
  // binary: operand code, then the operator
  let mut out: string = "";
  if e.op == 12 {
    // '!expr' is unary: the inner value, eqz, extended back
    match e.rhs {
      Option.Some(r) => {
        out = out + emit_expr(pool, r, env, prog, nl);
      },
      Option.None => {},
    }
    out = out + "    (i64.eqz)\n    (i64.extend_i32_s)\n";
    return out;
  }
  match e.lhs {
    Option.Some(l) => {
      out = out + emit_expr(pool, l, env, prog, nl);
    },
    Option.None => {},
  }
  if e.op == 11 {
    // 'as T': an enum operand takes the tag (§3.3); a float operand
    // converts through the f64 lane (trunc-toward-zero, saturating);
    // an int operand into f64/f32 converts and reinterprets
    let mut srcf: i64 = 0;
    match e.lhs {
      Option.Some(l2) => {
        srcf = expr_fkind(l2, env, prog);
        if len(expr_enum_type(l2, env, prog)) > 0 {
          out = out + "    (i64.load (i32.wrap_i64))\n";
        }
      },
      Option.None => {},
    }
    if srcf > 0 {
      if e.name == "f64" {
        return out + "    (f64.reinterpret_i64)\n" +
               "    (i64.reinterpret_f64)\n";
      }
      if e.name == "f32" {
        return out + "    (f64.reinterpret_i64)\n" +
               "    (f64.promote_f32 (f32.demote_f64))\n" +
               "    (i64.reinterpret_f64)\n";
      }
      // float -> int: trunc toward zero, saturating AT THE TARGET
      // WIDTH (§3.3) — narrow widths clamp through boundary compares
      // in f64 (HI = max+1, LO = min-1, both exact), the lane-wide
      // widths ride i64.trunc_sat directly
      let w0: i64 = type_width(e.name);
      let mut bits0: i64 = w0;
      if bits0 < 0 {
        bits0 = 0 - bits0;
      }
      out = out + "    (local.set $t)\n";
      if bits0 >= 64 {
        if w0 < 0 {
          out = out + "    (i64.trunc_sat_f64_u (f64.reinterpret_i64 " +
                 "(local.get $t)))\n";
        } else {
          out = out + "    (i64.trunc_sat_f64_s (f64.reinterpret_i64 " +
                 "(local.get $t)))\n";
        }
        return out;
      }
      let mut mx: i64 = (1 << bits0) - 1;
      let mut mn: i64 = 0;
      let mut hi: string = "";
      let mut lo: string = "";
      if w0 < 0 {
        mn = 0;
        hi = (mx + 1).to_str();
        lo = "-0.5";
      } else {
        mx = mx / 2;
        mn = 0 - (1 << (bits0 - 1));
        hi = (mx + 1).to_str();
        lo = (mn - 1).to_str();
      }
      out = out + "    (if (result i64) (f64.ge (f64.reinterpret_i64 " +
             "(local.get $t)) (f64.const " + hi + "))\n" +
             "      (then (i64.const " + mx.to_str() + "))\n" +
             "      (else (if (result i64) (f64.le " +
             "(f64.reinterpret_i64 (local.get $t)) (f64.const " + lo +
             "))\n" +
             "        (then (i64.const " + mn.to_str() + "))\n" +
             "        (else (i64.extend_i32_s (i32.trunc_sat_f64_s " +
             "(f64.reinterpret_i64 (local.get $t))))))))\n";
      return out;
    }
    if e.name == "f64" || e.name == "f32" {
      // an unsigned source converts unsigned (u64 max rides 1.8e19,
      // not the signed -1 bits)
      let mut sw: i64 = 0;
      match e.lhs {
        Option.Some(sr) => {
          sw = expr_width(sr, env, prog);
        },
        Option.None => {},
      }
      if sw < 0 {
        out = out + "    (f64.convert_i64_u)\n";
      } else {
        out = out + "    (f64.convert_i64_s)\n";
      }
      if e.name == "f32" {
        out = out + "    (f64.promote_f32 (f32.demote_f64))\n";
      }
      out = out + "    (i64.reinterpret_f64)\n";
      return out;
    }
    out = out + wrap_snippet(type_width(e.name));
    return out;
  }
  let divish: bool = e.op == 3 || e.op == 4;
  if divish {
    // the dividend parks in $r (each operand evaluates exactly once)
    out = out + "    (local.set $r)\n";
  }
  match e.rhs {
    Option.Some(r) => {
      out = out + emit_expr(pool, r, env, prog, nl);
    },
    Option.None => {},
  }
  if divish {
    // /0 %0 panics (§11); MIN / -1 wraps back to MIN and MIN % -1
    // reads 0 — wasm's div_s traps on that pair, so the -1 case
    // rides the if-select instead of the native op
    let msg_addr: i64 = pool_intern(pool, "division by zero");
    out = out + "    (local.set $t)\n";
    out = out + "    (if (i64.eqz (local.get $t))\n" +
           "      (then (call $w_panic (i32.const " +
           msg_addr.to_str() + ") (i32.const 16))))\n";
    out = out + "    (if (result i64) (i64.eq (local.get $t)" +
           " (i64.const -1))\n";
    if e.op == 3 {
      out = out + "      (then (i64.sub (i64.const 0) " +
             "(local.get $r)))\n";
    } else {
      out = out + "      (then (i64.const 0))\n";
    }
    out = out + "      (else (" + wat_op(e.op) + " (local.get $r)" +
           " (local.get $t))))\n";
    // the width wrap still applies below
    let mut w0: i64 = 0;
    match e.lhs {
      Option.Some(l) => {
        if l.tag == parse.EX_VAR {
          w0 = env_width_of(env, l.name);
        }
      },
      Option.None => {},
    }
    if w0 != 0 {
      out = out + wrap_snippet(w0);
    }
    return out;
  }
  // the operand width: the declaring operand wins (§3.1 — literals
  // adapt to their consumer)
  let mut w: i64 = bin_width(e, env, prog);
  if e.op == 18 || e.op == 19 {
    // shifts mask the count by the left width (§11); sub-32 widths
    // live in the 32-bit lane so their mask is 31 (boot's iron), and
    // unsigned widths shift logically (shr_u)
    let mw: i64 = w;
    let mut mbits: i64 = mw;
    if mbits < 0 {
      mbits = 0 - mbits;
    }
    if mbits >= 64 {
      mbits = 64;
    } else {
      if mbits == 0 {
        mbits = 32;
      } else {
        mbits = 32; // sub-32 ints ride the 32-bit lane
      }
    }
    out = out + "    (local.set $t)\n";
    out = out + "    (i64.and (local.get $t) (i64.const " +
           (mbits - 1).to_str() + "))\n";
    out = out + "    (local.set $t)\n";
    out = out + "    (local.get $t)\n";
    let mut sop: string = "i64.shl";
    if e.op == 19 {
      if w < 0 {
        sop = "i64.shr_u";
      } else {
        sop = "i64.shr_s";
      }
    }
    out = out + "    (" + sop + ")\n";
    if w != 0 && w != 64 && w != 0 - 64 {
      out = out + wrap_snippet(w);
    }
    return out;
  }
  out = out + "    (" + wat_op(e.op) + ")\n";
  // comparisons yield i32 in wasm: extend back to the i64 lane
  if e.op >= 5 && e.op <= 10 {
    out = out + "    (i64.extend_i32_s)\n";
    return out;
  }
  // arithmetic/bitwise at a narrow width wraps after the op
  if w != 0 && w != 64 && e.op != 11 && e.op != 12 {
    out = out + wrap_snippet(w);
  }
  return out;
}

// the arm chain from arm i on: (result i64) ifs for the expression
// form, plain ifs for the statement form; the wildcard arm (or the
// chain's end) closes with a zero value
fn match_chain(pool: *Pool, arms: []*MatchArm, i: usize, bx: i64,
               env: *Env, prog: *Prog, nl: *NextLocal,
               as_expr: bool) -> string {
  return match_chain_m(pool, arms, i, bx, env, prog, nl, as_expr,
                       false, "");
}

// the Option/Result binder payload target (from the scrutinee's
// element text) — "" leaves the plain lane

// pair mode: every arm's tail rides a {addr,len} pair and the chain
// results are two i64s (a string-valued match)
fn match_chain_m(pool: *Pool, arms: []*MatchArm, i: usize, bx: i64,
                 env: *Env, prog: *Prog, nl: *NextLocal,
                 as_expr: bool, as_pair: bool,
                 optpt: string) -> string {
  if i >= len(arms) {
    if as_expr {
      if as_pair {
        return "    (i64.const 0)\n    (i64.const 0)\n";
      }
      return "    (i64.const 0)\n";
    }
    return "";
  }
  let a: *MatchArm = arms[i];
  let cond: string = arm_cond(a, prog, 0);
  // the arm's code: binders load from the box (a *T payload binds
  // as a struct pointer — its fields stay reachable), then the
  // statements, then the tail expression
  let mut armcode: string = "";
  let mut vi: i64 = 0 - 1;
  let mut ptys: []string = make([]string, 0);
  if a.pat.kind == 2 && a.pat.ename != "Option" &&
      a.pat.ename != "Result" {
    ptys = enum_variant_ptys(prog, a.pat.ename, a.pat.vname);
    vi = en_vtag(prog, en_index(prog, a.pat.ename), a.pat.vname);
  }
  let mut k: usize = 0;
  let mut sl: i64 = 1; // the box slot cursor (slot 0 = the tag)
  while k < len(a.pat.binders) {
    let mut pty: string = "";
    if k < len(ptys) {
      pty = ptys[k];
    }
    // a string payload binder reads the pair (two slots) and binds a
    // runtime string; Result.Err's binder does too — the string error
    // is the idiom its boxes carry
    let sbind: bool = pty == "string" ||
        (a.pat.ename == "Result" && a.pat.vname == "Err") ||
        ((a.pat.ename == "Option" || a.pat.ename == "Result") &&
         optpt == "string");
    if sbind {
      let ba: i64 = nl.v;
      let bl: i64 = nl.v + 1;
      nl.v = nl.v + 2;
      armcode = armcode + "    (i64.load (i32.add (i32.wrap_i64 " +
                "(local.get " + bx.to_str() + ")) (i32.const " +
                (sl * 8).to_str() + ")))\n" +
                "    (local.set " + ba.to_str() + ")\n" +
                "    (i64.load (i32.add (i32.wrap_i64 " +
                "(local.get " + bx.to_str() + ")) (i32.const " +
                ((sl + 1) * 8).to_str() + ")))\n" +
                "    (local.set " + bl.to_str() + ")\n";
      env_str_bind_runtime(env, a.pat.binders[k], ba, bl, 1);
      sl = sl + 2;
      k = k + 1;
      continue;
    }
    let bslot: i64 = nl.v;
    nl.v = nl.v + 1;
    armcode = armcode + "    (i64.load (i32.add (i32.wrap_i64 " +
              "(local.get " + bx.to_str() + ")) (i32.const " +
              (sl * 8).to_str() + ")))\n" +
              "    (local.set " + bslot.to_str() + ")\n";
    sl = sl + 1;
    let ptgt: string = type_ptr_target(pty);
    if len(ptgt) > 0 && st_index(prog, ptgt) >= 0 {
      env_bind_ptr(env, a.pat.binders[k], bslot, ptgt);
    } else {
      if pty == "f64" || pty == "f32" {
        let mut fk2: i64 = 1;
        if pty == "f32" {
          fk2 = 2;
        }
        env_bind_f(env, a.pat.binders[k], bslot, fk2);
      } else {
        if (a.pat.ename == "Option" || a.pat.ename == "Result") &&
            len(optpt) > 0 && st_index(prog, optpt) >= 0 {
          // a Some/Ok binder over a *T element: the pointer lane keeps
          // its fields reachable
          env_bind_ptr(env, a.pat.binders[k], bslot, optpt);
        } else {
          env_bind(env, a.pat.binders[k], bslot);
        }
      }
    }
    k = k + 1;
  }
  armcode = armcode + emit_stmts(a.body, pool, env, nl, env.infn,
                                 env.retslot, prog, env.loops,
                                 env.dstack, env.tfd);
  let mut tail: string = "    (i64.const 0)\n";
  if as_pair {
    tail = "    (i64.const 0)\n    (i64.const 0)\n";
  }
  match a.val {
    Option.Some(v) => {
      if as_pair {
        // a pair tail builds through the full pair machinery — a
        // format call or a concat is as arm-worthy as a literal
        let spt2 = build_string_pair(v, pool, env, prog, nl);
        if spt2.ok {
          tail = spt2.text +
                 "    (local.get " + spt2.a.to_str() + ")\n" +
                 "    (local.get " + spt2.l.to_str() + ")\n";
        } else {
          tail = push_string(pool, v, env, prog, nl);
        }
      } else {
        tail = emit_expr(pool, v, env, prog, nl);
      }
    },
    Option.None => {},
  }
  if len(cond) == 0 {
    // the wildcard arm closes the chain (the statement form keeps
    // the tail's effects and drops its value)
    if as_expr {
      return armcode + tail;
    }
    return armcode + tail + "    drop\n";
  }
  let rest: string = match_chain_m(pool, arms, i + 1, bx, env, prog,
                                   nl, as_expr, as_pair, optpt);
  if as_expr {
    if as_pair {
      return "    (if (result i64) (result i64) " + cond + "\n" +
             "      (then\n" + armcode + tail + "      )\n" +
             "      (else\n" + rest + "      ))\n";
    }
    return "    (if (result i64) " + cond + "\n" +
           "      (then\n" + armcode + tail + "      )\n" +
           "      (else\n" + rest + "      ))\n";
  }
  return "    (if " + cond + "\n" +
         "      (then\n" + armcode + tail + "    drop\n" +
         "      )\n" +
         "      (else\n" + rest + "      ))\n";
}

// one arm's discriminator condition text ("" for the wildcard): the
// tag local rides $d for enum scrutinees, the value itself for
// scalars
fn arm_cond(a: *MatchArm, prog: *Prog, dslot: i64) -> string {
  if a.pat.kind == 0 {
    return "";
  }
  if a.pat.kind == 1 {
    return "(i64.eq (local.get $d) (i64.const " + a.pat.lit.to_str() +
           "))";
  }
  let mut tag: i64 = 0;
  if a.pat.ename == "Option" || a.pat.ename == "Result" {
    if a.pat.vname == "Some" || a.pat.vname == "Ok" {
      tag = 1;
    } else {
      if a.pat.ename == "Result" {
        tag = 2;
      } else {
        tag = 0;
      }
    }
  } else {
    let ei: i64 = en_index(prog, a.pat.ename);
    tag = en_vtag(prog, ei, a.pat.vname);
  }
  return "(i64.eq (local.get $d) (i64.const " + tag.to_str() + "))";
}

// the scrutinee's discriminator parks in $d; enum scrutinees load the
// box's tag first
fn emit_scrut(pool: *Pool, sc: *Expr, env: *Env, prog: *Prog,
              nl: *NextLocal) -> string {
  let et: string = expr_enum_type(sc, env, prog);
  let mut out: string = emit_expr(pool, sc, env, prog, nl);
  if len(et) > 0 {
    out = out + "    (i64.load (i32.wrap_i64))\n";
  }
  out = out + "    (local.set $d)\n";
  return out;
}

// a fresh slice literal: n zeroed slots, each element stored in
// order — leaves the {addr, len} pair on the stack
fn emit_array(pool: *Pool, e: *Expr, env: *Env, prog: *Prog,
              nl: *NextLocal) -> string {
  let a_slot: i64 = nl.v;
  let l_slot: i64 = nl.v + 1;
  nl.v = nl.v + 2;
  let mut out: string = "    (i64.extend_i32_u (call $w_alloc (i32.const " +
         (len(e.args) as i64).to_str() + ")))\n" +
         "    (local.set " + a_slot.to_str() + ")\n" +
         "    (i64.const " + (len(e.args) as i64).to_str() + ")\n" +
         "    (local.set " + l_slot.to_str() + ")\n";
  let mut k: usize = 0;
  while k < len(e.args) {
    let tv: i64 = nl.v;
    nl.v = nl.v + 1;
    out = out + emit_expr(pool, e.args[k], env, prog, nl);
    out = out + "    (local.set " + tv.to_str() + ")\n" +
           "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
           a_slot.to_str() + ")) (i32.const " + (k * 8).to_str() +
           ")) (local.get " + tv.to_str() + "))\n";
    k = k + 1;
  }
  out = out + "    (local.get " + a_slot.to_str() + ")\n" +
         "    (local.get " + l_slot.to_str() + ")\n";
  return out;
}

// the defer context: one frame per open scope, texts collected as
// the walk meets them; exits run them innermost-first (LIFO)
struct DStack {
  texts: []string, // the flat pool
  starts: []usize, // frame boundaries
  n: usize,        // open frames
  cursor: usize,   // texts used
  rtexts: []string, // scope-exit release texts (parallel pool)
  rnames: []string, // the binding each release owns (a return skips it)
  rstart: usize,    // the release pool's cursor
  rframe: []usize,  // release-pool frame boundaries
}

fn dstack_new() -> *DStack {
  return new DStack { texts: make([]string, 256), starts: make([]usize, 64),
                      n: 0, cursor: 0,
                      rtexts: make([]string, 128),
                      rnames: make([]string, 128), rstart: 0,
                      rframe: make([]usize, 64) };
}

fn dpush(d: *DStack) {
  d.starts[d.n] = d.cursor;
  d.rframe[d.n] = d.rstart;
  d.n = d.n + 1;
}

// register a scope-owned binding's release (emitted at scope exit in
// registration order — inner lets die after outer materializations)
fn drel_push(d: *DStack, name: string, text: string) {
  if d.rstart < len(d.rtexts) {
    d.rtexts[d.rstart] = text;
    d.rnames[d.rstart] = name;
    d.rstart = d.rstart + 1;
  }
}

// the scope's releases, then its defers LIFO, then the frame closes
fn dpop_emit(d: *DStack) -> string {
  let mut out: string = "";
  if d.n == 0 {
    return out; // a return already unwound every frame
  }
  let rbase: usize = d.rframe[d.n - 1];
  while d.rstart > rbase {
    d.rstart = d.rstart - 1;
    out = out + d.rtexts[d.rstart];
  }
  let base: usize = d.starts[d.n - 1];
  while d.cursor > base {
    d.cursor = d.cursor - 1;
    out = out + d.texts[d.cursor];
  }
  d.n = d.n - 1;
  return out;
}

// a break/continue exits every frame down to (and including) the
// loop's body frame: emit those texts WITHOUT consuming — the normal
// exit path still runs the frame-end copies
fn dpeek_emit_to(d: *DStack, n_from: usize) -> string {
  let mut out: string = "";
  if n_from >= d.n {
    return out;
  }
  // the releases ride with the defers: each frame's releases then its
  // defer texts, all WITHOUT consuming (the normal exit path still
  // runs them)
  let mut f: usize = d.n;
  while f > n_from {
    let rbase: usize = d.rframe[f - 1];
    let mut r: usize = d.rstart;
    while r > rbase {
      r = r - 1;
      out = out + d.rtexts[r];
    }
    let base: usize = d.starts[f - 1];
    let mut c: usize = d.cursor;
    if f == d.n {
      c = d.cursor;
    } else {
      c = d.starts[f];
    }
    while c > base {
      c = c - 1;
      out = out + d.texts[c];
    }
    f = f - 1;
  }
  return out;
}

// a return unwinds every open frame of the function, LIFO across
// all; the returned binding's own release is skipped (the value
// moves out with its count intact)
fn dunwind_emit_skip(d: *DStack, skip: string) -> string {
  let mut out: string = "";
  while d.n > 0 {
    let rbase: usize = d.rframe[d.n - 1];
    while d.rstart > rbase {
      d.rstart = d.rstart - 1;
      if d.rnames[d.rstart] != skip {
        out = out + d.rtexts[d.rstart];
      }
    }
    let base: usize = d.starts[d.n - 1];
    while d.cursor > base {
      d.cursor = d.cursor - 1;
      out = out + d.texts[d.cursor];
    }
    d.n = d.n - 1;
  }
  return out;
}

fn dunwind_emit(d: *DStack) -> string {
  return dunwind_emit_skip(d, " ");
}

// the loop-label context: every loop gets unique wasm labels; the
// stack holds the enclosing loops so plain jumps hit the innermost
// and named jumps resolve to their labeled loop
struct Loops {
  names: []string,
  bks: []string,
  ws: []string,
  ddepths: []usize, // the dstack depth at each loop statement
  n: usize,
  next_id: i64,
}

fn loops_new() -> *Loops {
  return new Loops { names: make([]string, 32), bks: make([]string, 32),
                     ws: make([]string, 32), ddepths: make([]usize, 32),
                     n: 0, next_id: 0 };
}

fn loops_push_with(l: *Loops, name: string, bk: string, w: string,
                   d: *DStack) {
  l.names[l.n] = name;
  l.bks[l.n] = bk;
  l.ws[l.n] = w;
  l.ddepths[l.n] = d.n; // frames above this base exit at a jump
  l.n = l.n + 1;
}

fn loops_pop(l: *Loops) {
  if l.n > 0 {
    l.n = l.n - 1;
  }
}

// the loop-stack index a jump targets (innermost when unnamed)
fn loops_index(l: *Loops, name: string) -> usize {
  if len(name) == 0 {
    if l.n == 0 {
      return 32; // out of range: no enclosing loop
    }
    return l.n - 1;
  }
  let mut i: usize = l.n;
  while i > 0 {
    if l.names[i - 1] == name {
      return i - 1;
    }
    i = i - 1;
  }
  return 32;
}

// the break (block) label for a jump: named resolves to the labeled
// loop, plain to the innermost
fn loops_break(l: *Loops, name: string) -> string {
  if len(name) == 0 {
    return l.bks[l.n - 1];
  }
  let mut i: usize = l.n;
  while i > 0 {
    if l.names[i - 1] == name {
      return l.bks[i - 1];
    }
    i = i - 1;
  }
  return "$b?";
}

fn loops_cont(l: *Loops, name: string) -> string {
  if len(name) == 0 {
    return l.ws[l.n - 1];
  }
  let mut i: usize = l.n;
  while i > 0 {
    if l.names[i - 1] == name {
      return l.ws[i - 1];
    }
    i = i - 1;
  }
  return "$w?";
}

// a built string pair: code text plus the two fresh locals holding
// {addr, len}; ok=false when the expression is not string-buildable
struct SPair {
  ok: bool,
  text: string,
  a: i64,
  l: i64,
}

fn user_fn_exists(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name == name {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn rtype_is_pair(rt: string) -> bool {
  if rt == "string" || (len(rt) >= 2 && rt[0] == 91 && rt[1] == 93) {
    return true;
  }
  // a fn-typed return rides its (idx, box) pair
  return len(rt) >= 2 && rt[0] == 102 && rt[1] == 110;
}

fn fn_returns_string(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name == name {
      return rtype_is_pair(prog.fns[i].rtype);
    }
    i = i + 1;
  }
  return false;
}

fn build_string_pair(e: *Expr, pool: *Pool, env: *Env, prog: *Prog,
                     nl: *NextLocal) -> *SPair {
  let bad = new SPair { ok: false, text: "", a: 0, l: 0 };
  // a string FIELD through a pointer or value frame: the pair rides
  // the field's slots
  if e.tag == parse.EX_FIELD && is_stringy(e, env, prog) {
    let spf = new SPair { ok: false, text: "", a: 0, l: 0 };
    spf.text = push_string(pool, e, env, prog, nl);
    let fa: i64 = nl.v;
    let fl: i64 = nl.v + 1;
    nl.v = nl.v + 2;
    spf.text = spf.text + "    (local.set " + fl.to_str() + ")\n" +
               "    (local.set " + fa.to_str() + ")\n";
    spf.ok = true;
    spf.a = fa;
    spf.l = fl;
    return spf;
  }
  // a folded literal
  match fold_string(e, env) {
    Option.Some(raw) => {
      let addr: i64 = pool_intern(pool, raw);
      let sp = new SPair { ok: true, text:
        "    (i64.const " + addr.to_str() + ")\n" +
        "    (local.set " + nl.v.to_str() + ")\n" +
        "    (i64.const " + pool_len(pool, raw).to_str() + ")\n" +
        "    (local.set " + (nl.v + 1).to_str() + ")\n",
        a: nl.v, l: nl.v + 1 };
      nl.v = nl.v + 2;
      return sp;
    },
    Option.None => {},
  }
  if e.tag == parse.EX_VAR {
    if str_static_is(prog, e.name) {
      // a string static reads its global pair into fresh slots
      let sa: i64 = nl.v;
      nl.v = nl.v + 1;
      let sl: i64 = nl.v;
      nl.v = nl.v + 1;
      let sps = new SPair { ok: true, text:
        "    (global.get $g_" + e.name + ")\n" +
        "    (local.set " + sa.to_str() + ")\n" +
        "    (global.get $g_" + e.name + "_l)\n" +
        "    (local.set " + sl.to_str() + ")\n",
        a: sa, l: sl };
      return sps;
    }
    let kind: i64 = env_kind_of(env, e.name);
    if kind == 0 {
      let addr: i64 = env_str_look(env, e.name);
      let sp0 = new SPair { ok: true, text:
        "    (i64.const " + addr.to_str() + ")\n" +
        "    (local.set " + nl.v.to_str() + ")\n" +
        "    (i64.const " + env_str_len(env, e.name).to_str() +
        ")\n" +
        "    (local.set " + (nl.v + 1).to_str() + ")\n",
        a: nl.v, l: nl.v + 1 };
      nl.v = nl.v + 2;
      return sp0;
    }
    if kind == 1 {
      let ba: i64 = env_str_look(env, e.name);
      let addr_slot: i64 = (0 - ba) - 1;
      let sp = new SPair { ok: true, text:
        "    (local.get " + addr_slot.to_str() + ")\n" +
        "    (local.set " + nl.v.to_str() + ")\n" +
        "    (local.get " + env_str_len_slot(env, e.name).to_str() +
        ")\n" +
        "    (local.set " + (nl.v + 1).to_str() + ")\n",
        a: nl.v, l: nl.v + 1 };
      nl.v = nl.v + 2;
      return sp;
    }
    return bad;
  }
  // format("...", args): the pieces intern, the holes render — ints
  // through $w_itoa, bools through $w_bool's words, strings as their
  // pairs — then one $w_cat chain left to right
  if e.tag == parse.EX_CALL && e.name == "format" &&
      len(e.args) >= 1 && e.args[0].tag == parse.EX_STR {
    let pieces: []string = parse.fmt_pieces(e.args[0].name);
    if len(pieces) == 1 && len(e.args) == 1 {
      let addr0: i64 = pool_intern(pool, pieces[0]);
      let sp0 = new SPair { ok: true, text:
        "    (i64.const " + addr0.to_str() + ")\n" +
        "    (local.set " + nl.v.to_str() + ")\n" +
        "    (i64.const " + decoded_len(pieces[0]).to_str() +
        ")\n" +
        "    (local.set " + (nl.v + 1).to_str() + ")\n",
        a: nl.v, l: nl.v + 1 };
      nl.v = nl.v + 2;
      return sp0;
    }
    // collect the chain's pairs: piece0, arg0, piece1, arg1, ...
    let mut text: string = "";
    let mut na: usize = 0;
    let mut chain_a: []i64 = make([]i64, 24);
    let mut chain_l: []i64 = make([]i64, 24);
    let mut ok: bool = true;
    let mut pi: usize = 0;
    while pi < len(pieces) {
      if len(pieces[pi]) > 0 {
        let pa: i64 = pool_intern(pool, pieces[pi]);
        text = text + "    (i64.const " + pa.to_str() + ")\n" +
               "    (local.set " + nl.v.to_str() + ")\n" +
               "    (i64.const " + decoded_len(pieces[pi]).to_str() +
               ")\n" +
               "    (local.set " + (nl.v + 1).to_str() +
               ")\n";
        chain_a[na] = nl.v;
        chain_l[na] = nl.v + 1;
        na = na + 1;
        nl.v = nl.v + 2;
      }
      if pi + 1 < len(pieces) && pi < len(e.args) - 1 {
        // hole pi's argument
        let arg = e.args[pi + 1];
        match fold_string(arg, env) {
          Option.Some(raw) => {
            let ha: i64 = pool_intern(pool, raw);
            text = text + "    (i64.const " + ha.to_str() + ")\n" +
                   "    (local.set " + nl.v.to_str() +
                   ")\n" +
                   "    (i64.const " + pool_len(pool, raw).to_str() +
                   ")\n" +
                   "    (local.set " + (nl.v + 1).to_str() +
                   ")\n";
            chain_a[na] = nl.v;
            chain_l[na] = nl.v + 1;
            na = na + 1;
            nl.v = nl.v + 2;
          },
          Option.None => {
            if dyn_hole_dispatch(arg, pool, env, prog, nl) {
              // a dyn value renders through its vtable's to_str slot
              text = text + DYN_TEXT;
              chain_a[na] = DYN_A;
              chain_l[na] = DYN_L;
              DYN_TEXT = "";
              na = na + 1;
            } else {
            let mut akind: i64 = 0 - 2;
            if arg.tag == parse.EX_VAR {
              akind = env_kind_of(env, arg.name);
            }
            if akind == 1 {
              let ba: i64 = env_str_look(env, arg.name);
              text = text + "    (local.get " +
                     ((0 - ba) - 1).to_str() + ")\n" +
                     "    (local.set " + nl.v.to_str() +
                     ")\n" +
                     "    (local.get " +
                     env_str_len_slot(env, arg.name).to_str() +
                     ")\n" +
                     "    (local.set " + (nl.v + 1).to_str() +
                     ")\n";
              chain_a[na] = nl.v;
              chain_l[na] = nl.v + 1;
              na = na + 1;
              nl.v = nl.v + 2;
            } else {
              let spt3 = to_str_pair(arg, pool, env, prog, nl);
              if spt3.ok {
                // a value whose type owns to_str renders through it;
                // the pair parks in the builder's own slots
                text = text + spt3.text;
                chain_a[na] = spt3.a;
                chain_l[na] = spt3.l;
                na = na + 1;
              } else {
              if expr_fkind(arg, env, prog) > 0 {
                // a float hole rides the exact-decimal text
                FLOAT_WANTED = 1;
                let fk: i64 = expr_fkind(arg, env, prog);
                text = text + emit_expr(pool, arg, env, prog, nl) +
                       "    (local.set " + nl.v.to_str() + ")\n" +
                       "    (local.get " + nl.v.to_str() + ")\n";
                if fk == 2 {
                  text = text + "    (f64.reinterpret_i64)\n" +
                         "    (f32.demote_f64)\n" +
                         "    (f64.promote_f32)\n" +
                         "    (i64.reinterpret_f64)\n" +
                         "    call $u___f32_text\n";
                } else {
                  text = text + "    call $u___f64_text\n";
                }
                text = text + "    (local.set " + (nl.v + 1).to_str() +
                       ")\n" +
                       "    (local.set " + nl.v.to_str() + ")\n";
                chain_a[na] = nl.v;
                chain_l[na] = nl.v + 1;
                na = na + 1;
                nl.v = nl.v + 2;
              } else {
              if hole_boolish(arg, env, prog) {
                text = text + emit_expr(pool, arg, env, prog, nl) +
                       "    call $w_bool\n" +
                       "    (local.set $l)\n" +
                       "    (i64.extend_i32_u)\n" +
                       "    (local.set " + nl.v.to_str() +
                       ")\n" +
                       "    (i64.extend_i32_u (local.get $l))\n" +
                       "    (local.set " + (nl.v + 1).to_str() +
                       ")\n";
                chain_a[na] = nl.v;
                chain_l[na] = nl.v + 1;
                na = na + 1;
                nl.v = nl.v + 2;
              } else {
                // any other string-buildable argument (a nested
                // format, a concat, a string-returning call) rides
                // its built pair
                let sph = build_string_pair(arg, pool, env, prog,
                                            nl);
                if sph.ok {
                  text = text + sph.text;
                  chain_a[na] = sph.a;
                  chain_l[na] = sph.l;
                  na = na + 1;
                } else {
                // an integer expression renders via $w_itoa
                text = text + emit_expr(pool, arg, env, prog, nl) +
                       "    call $w_itoa\n" +
                       "    (local.set " + (nl.v + 1).to_str() +
                       ")\n" +
                       "    (local.set " + nl.v.to_str() +
                       ")\n";
                chain_a[na] = nl.v;
                chain_l[na] = nl.v + 1;
                na = na + 1;
                nl.v = nl.v + 2;
                }
              }
              }
              }
            }
            }
          },
        }
      }
      pi = pi + 1;
    }
    if ok {
      // cat the chain left to right, reusing two accumulator slots
      let mut acc_a: i64 = chain_a[0];
      let mut acc_l: i64 = chain_l[0];
      let mut ci: usize = 1;
      while ci < na {
        let nxa: i64 = nl.v;
        let nxl: i64 = nl.v + 1;
        nl.v = nl.v + 2;
        text = text + "    (local.get " + acc_a.to_str() + ")\n" +
               "    (local.get " + acc_l.to_str() + ")\n" +
               "    (local.get " + chain_a[ci].to_str() + ")\n" +
               "    (local.get " + chain_l[ci].to_str() + ")\n" +
               "    call $w_cat\n" +
               "    (local.set " + nxl.to_str() + ")\n" +
               "    (local.set " + nxa.to_str() + ")\n";
        acc_a = nxa;
        acc_l = nxl;
        ci = ci + 1;
      }
      let spf = new SPair { ok: true, text: text, a: acc_a, l: acc_l };
      return spf;
    }
    return bad;
  }
  if e.tag == parse.EX_IF {
    // a string-valued if: both arms string-buildable, the chain rides
    // pair results
    let mut allstr2: bool = true;
    if len(e.args) > 0 {
      match fold_string(e.args[0], env) {
        Option.Some(raw) => {},
        Option.None => {
          if !is_stringy(e.args[0], env, prog) {
            if e.args[0].tag != parse.EX_VAR {
              allstr2 = false;
            }
          }
        },
      }
    } else {
      allstr2 = false;
    }
    if len(e.args) > 1 {
      match fold_string(e.args[1], env) {
        Option.Some(raw) => {},
        Option.None => {
          if !is_stringy(e.args[1], env, prog) {
            if e.args[1].tag != parse.EX_VAR {
              allstr2 = false;
            }
          }
        },
      }
    } else {
      allstr2 = false;
    }
    if allstr2 {
      let t_a2: i64 = nl.v;
      let t_l2: i64 = nl.v + 1;
      nl.v = nl.v + 2;
      let mut text2: string = "";
      match e.lhs {
        Option.Some(cond2) => {
          text2 = text2 + emit_expr(pool, cond2, env, prog, nl);
        },
        Option.None => {},
      }
      text2 = text2 + "    (i32.wrap_i64)\n" +
              "    (if (result i64) (result i64)\n" +
              "      (then\n";
      if len(e.args) > 0 {
        text2 = text2 + push_string(pool, e.args[0], env, prog, nl);
      } else {
        text2 = text2 + "    (i64.const 0)\n    (i64.const 0)\n";
      }
      text2 = text2 + "      )\n      (else\n";
      if len(e.args) > 1 {
        text2 = text2 + push_string(pool, e.args[1], env, prog, nl);
      } else {
        text2 = text2 + "    (i64.const 0)\n    (i64.const 0)\n";
      }
      text2 = text2 + "      ))\n" +
              "    (local.set " + t_l2.to_str() + ")\n" +
              "    (local.set " + t_a2.to_str() + ")\n";
      let spi = new SPair { ok: true, text: text2, a: t_a2, l: t_l2 };
      return spi;
    }
    return bad;
  }
  if e.tag == parse.EX_MATCH {
    // a string-valued match: every arm's tail must be string-buildable
    let mut allstr: bool = len(e.marms) > 0;
    let mut k0: usize = 0;
    while k0 < len(e.marms) {
      match e.marms[k0].val {
        Option.Some(v) => {
          // a block arm's tail var binds only during the chain's own
          // emission — take bare vars on trust (the checker already
          // refused unknown names)
          let vartrust: bool = v.tag == parse.EX_VAR;
          match fold_string(v, env) {
            Option.Some(raw) => {},
            Option.None => {
              if !vartrust && !is_stringy(v, env, prog) {
                allstr = false;
              }
            },
          }
        },
        Option.None => {
          allstr = false;
        },
      }
      k0 = k0 + 1;
    }
    if allstr {
      let mut sc: *Expr = parse.lit(0);
      match e.lhs {
        Option.Some(x) => {
          sc = x;
        },
        Option.None => {},
      }
      let bx: i64 = nl.v;
      nl.v = nl.v + 1;
      let mut text: string = emit_expr(pool, sc, env, prog, nl);
      text = text + "    (local.set " + bx.to_str() + ")\n";
      let et: string = expr_enum_type(sc, env, prog);
      if len(et) > 0 {
        text = text + "    (i64.load (i32.wrap_i64 (local.get " +
               bx.to_str() + ")))\n";
      } else {
        text = text + "    (local.get " + bx.to_str() + ")\n";
      }
      text = text + "    (local.set $d)\n";
      let t_a: i64 = nl.v;
      let t_l: i64 = nl.v + 1;
      nl.v = nl.v + 2;
      let mut optpt5: string = optpt_of_scrutinee(sc, env, prog);
      if sc.tag == parse.EX_MCALL && sc.name == "get" {
        let mut rw5: *Expr = parse.lit(0);
        match sc.lhs {
          Option.Some(x11) => {
            rw5 = x11;
          },
          Option.None => {},
        }
        if rw5.tag == parse.EX_VAR {
          let wtg6: string = weak_target(env_ptr_of(env, rw5.name));
          if len(wtg6) > 0 {
            optpt5 = wtg6;
          }
        }
      }
      text = text + match_chain_m(pool, e.marms, 0, bx, env, prog,
                                  nl, true, true, optpt5);
      text = text + "    (local.set " + t_l.to_str() + ")\n" +
             "    (local.set " + t_a.to_str() + ")\n";
      let spm = new SPair { ok: true, text: text, a: t_a, l: t_l };
      return spm;
    }
    return bad;
  }
  if e.tag == parse.EX_SLICE2 {
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    // the base may itself be a slice: its pair computes first and
    // the outer view reads those slots (strings only — a slice of a
    // slice of a string is still a string view)
    let mut base_a: i64 = 0;
    let mut base_l: i64 = 0;
    let mut pre: string = "";
    let mut bkind: i64 = 0;
    if base.tag == parse.EX_SLICE2 {
      let inner = build_string_pair(base, pool, env, prog, nl);
      if !inner.ok {
        return bad;
      }
      pre = inner.text;
      base_a = inner.a;
      base_l = inner.l;
      bkind = 1;
    } else {
      if base.tag != parse.EX_VAR {
        return bad;
      }
      let bname0: string = base.name;
      bkind = env_kind_of(env, bname0);
      if bkind == 2 {
        return bad; // slicing a slice-of-ints inside a concat: later
      }
      if bkind == 1 {
        let ba: i64 = env_str_look(env, bname0);
        base_a = (0 - ba) - 1;
        base_l = env_str_len_slot(env, bname0);
      }
    }
    let kind: i64 = 1;
    let esz: i64 = 1;
    let a_slot: i64 = nl.v;
    nl.v = nl.v + 1;
    let l_slot: i64 = nl.v;
    nl.v = nl.v + 1;
    let mut text: string = pre;
    if e.op % 2 == 1 && len(e.args) > 0 {
      text = text + emit_expr(pool, e.args[0], env, prog, nl);
    } else {
      text = text + "    (i64.const 0)\n";
    }
    text = text + "    (local.set " + a_slot.to_str() + ")\n";
    if (e.op / 2) % 2 == 1 && len(e.args) > 1 {
      text = text + emit_expr(pool, e.args[1], env, prog, nl);
    } else {
      if bkind == 0 {
        text = text + "    (i64.const " +
               env_str_len(env, base.name).to_str() + ")\n";
      } else {
        text = text + "    (local.get " + base_l.to_str() + ")\n";
      }
    }
    text = text + "    (local.set " + l_slot.to_str() + ")\n";
    let mut blen: string = "";
    if bkind == 0 {
      blen = "(i64.const " + env_str_len(env, base.name).to_str() + ")";
    } else {
      blen = "(local.get " + base_l.to_str() + ")";
    }
    text = text + "    (local.set $t (local.get " + a_slot.to_str() +
           "))\n";
    text = text + oob_check_at(pool, blen, false);
    text = text + "    (local.set $t (local.get " + l_slot.to_str() +
           "))\n";
    text = text + oob_check_at(pool, blen, false);
    text = text + "    (i64.sub (local.get " + l_slot.to_str() +
           ") (local.get " + a_slot.to_str() + "))\n";
    text = text + "    (local.set " + l_slot.to_str() + ")\n";
    if bkind == 0 {
      text = text + "    (i64.add (i64.const " +
             env_str_look(env, base.name).to_str() +
             ") (i64.mul (local.get " + a_slot.to_str() +
             ") (i64.const " + esz.to_str() + ")))\n";
    } else {
      text = text + "    (i64.add (local.get " + base_a.to_str() +
             ") (i64.mul (local.get " + a_slot.to_str() +
             ") (i64.const " + esz.to_str() + ")))\n";
    }
    text = text + "    (local.set " + a_slot.to_str() + ")\n";
    let sps = new SPair { ok: true, text: text, a: a_slot, l: l_slot };
    return sps;
  }
  if e.tag == parse.EX_CALL &&
      rtype_is_pair(call_fn_rtype(prog, e, env)) {
    let mut text: string = "";
    let fd8: *FnDef = resolve_call_fd(prog, e, env);
    text = text + emit_call_args(pool, prog, fd8, e, env, nl);
    text = text + "    call " + ginst_call_name(pool, prog, e, env) +
           "\n" +
           "    (local.set " + (nl.v + 1).to_str() + ")\n" +
           "    (local.set " + nl.v.to_str() + ")\n";
    let sp = new SPair { ok: true, text: text, a: nl.v,
                         l: nl.v + 1 };
    nl.v = nl.v + 2;
    return sp;
  }
  if e.tag == parse.EX_BIN && e.op == 0 {
    let mut lhs: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(x) => {
        lhs = x;
      },
      Option.None => {},
    }
    let mut rhs: *Expr = parse.lit(0);
    match e.rhs {
      Option.Some(y) => {
        rhs = y;
      },
      Option.None => {},
    }
    let lres = build_string_pair(lhs, pool, env, prog, nl);
    if !lres.ok {
      return bad;
    }
    let rres = build_string_pair(rhs, pool, env, prog, nl);
    if !rres.ok {
      return bad;
    }
    let text: string = lres.text + rres.text +
      "    (local.get " + lres.a.to_str() + ")\n" +
      "    (local.get " + lres.l.to_str() + ")\n" +
      "    (local.get " + rres.a.to_str() + ")\n" +
      "    (local.get " + rres.l.to_str() + ")\n" +
      "    call $w_cat\n" +
      "    (local.set " + (nl.v + 1).to_str() + ")\n" +
      "    (local.set " + nl.v.to_str() + ")\n";
    let sp = new SPair { ok: true, text: text, a: nl.v,
                         l: nl.v + 1 };
    nl.v = nl.v + 2;
    return sp;
  }
  if e.tag == parse.EX_IDX {
    // a string-element slice's indexing yields the element's pair
    // (two loads at a 16-byte stride)
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b6) => {
        base = b6;
      },
      Option.None => {},
    }
    if base.tag == parse.EX_VAR &&
        env_kind_of(env, base.name) == 2 &&
        env_slice_elemtext(env, base.name) == "string" {
      let a: i64 = env_str_look(env, base.name);
      let addr_slot: i64 = (0 - a) - 1;
      let len_slot: i64 = env_str_len_slot(env, base.name);
      let mut idx: *Expr = parse.lit(0);
      match e.rhs {
        Option.Some(i6) => {
          idx = i6;
        },
        Option.None => {},
      }
      let ta: i64 = nl.v;
      let tl: i64 = nl.v + 1;
      nl.v = nl.v + 2;
      let text: string = emit_expr(pool, idx, env, prog, nl) +
             "    (local.set $t)\n" +
             oob_check(pool, "(local.get " + len_slot.to_str() + ")") +
             "    (i64.load (i32.add (i32.add (i32.wrap_i64 " +
             "(local.get " + addr_slot.to_str() + ")) (i32.mul " +
             "(i32.wrap_i64 (local.get $t)) (i32.const 16))) " +
             "(i32.const 0)))\n" +
             "    (local.set " + ta.to_str() + ")\n" +
             "    (i64.load (i32.add (i32.add (i32.wrap_i64 " +
             "(local.get " + addr_slot.to_str() + ")) (i32.mul " +
             "(i32.wrap_i64 (local.get $t)) (i32.const 16))) " +
             "(i32.const 8)))\n" +
             "    (local.set " + tl.to_str() + ")\n";
      let spi2 = new SPair { ok: true, text: text, a: ta, l: tl };
      return spi2;
    }
    return bad;
  }
  if e.tag == parse.EX_CLO {
    // a closure value parks its (idx, box) pair into fresh slots
    let ta: i64 = nl.v;
    let tl: i64 = nl.v + 1;
    nl.v = nl.v + 2;
    let text: string = emit_expr(pool, e, env, prog, nl) +
           "    (local.set " + tl.to_str() + ")\n" +
           "    (local.set " + ta.to_str() + ")\n";
    let spc = new SPair { ok: true, text: text, a: ta, l: tl };
    return spc;
  }
  // does this receiver's own type carry a to_str method? (the
  // primitive branch below must yield to it)
  let mut own_tostr: bool = false;
  if e.tag == parse.EX_MCALL && e.name == "to_str" {
    let mut ro: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(r10b) => {
        ro = r10b;
      },
      Option.None => {},
    }
    if ro.tag == parse.EX_VAR {
      let mut tn0: string = env_ptr_of(env, ro.name);
      if len(tn0) == 0 {
        tn0 = env_val_of(env, ro.name);
      }
      if len(tn0) == 0 {
        tn0 = env_enum_of(env, ro.name);
      }
      if len(tn0) > 0 && user_fn_exists(prog, tn0 + ".to_str") {
        own_tostr = true;
      }
    }
  }
  if e.tag == parse.EX_MCALL && e.name == "to_str" && !own_tostr {
    // the prelude's to_str on a primitive: ints through $w_itoa,
    // floats through the exact-decimal text, bools their words,
    // strings themselves
    let mut recv9: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(r9) => {
        recv9 = r9;
      },
      Option.None => {},
    }
    let isstr9: bool = is_stringy(recv9, env, prog);
    let fk9: i64 = expr_fkind(recv9, env, prog);
    let bl9: bool = hole_boolish(recv9, env, prog);
    if !isstr9 || fk9 > 0 || bl9 {
      let ta9: i64 = nl.v;
      let tl9: i64 = nl.v + 1;
      nl.v = nl.v + 2;
      let mut t9: string = emit_expr(pool, recv9, env, prog, nl) +
             "    (local.set " + ta9.to_str() + ")\n" +
             "    (local.get " + ta9.to_str() + ")\n";
      if fk9 == 1 {
        FLOAT_WANTED = 1;
        t9 = t9 + "    call $u___f64_text\n" +
               "    (local.set " + tl9.to_str() + ")\n" +
               "    (local.set " + ta9.to_str() + ")\n";
      } else {
        if fk9 == 2 {
          FLOAT_WANTED = 1;
          t9 = t9 + "    (f64.reinterpret_i64)\n" +
                 "    (f32.demote_f64)\n    (f64.promote_f32)\n" +
                 "    (i64.reinterpret_f64)\n" +
                 "    call $u___f32_text\n" +
                 "    (local.set " + tl9.to_str() + ")\n" +
                 "    (local.set " + ta9.to_str() + ")\n";
        } else {
          if bl9 {
            t9 = t9 + "    call $w_bool\n" +
                   "    (local.set $l)\n" +
                   "    (i64.extend_i32_u)\n" +
                   "    (local.set " + ta9.to_str() + ")\n" +
                   "    (i64.extend_i32_u (local.get $l))\n" +
                   "    (local.set " + tl9.to_str() + ")\n";
            let spb9 = new SPair { ok: true, text: t9, a: ta9,
                                   l: tl9 };
            return spb9;
          }
          if expr_width(recv9, env, prog) < 0 {
            t9 = t9 + "    call $w_u64\n" +
                   "    (local.set $l)\n" +
                   "    (i64.extend_i32_u)\n" +
                   "    (local.set " + ta9.to_str() + ")\n" +
                   "    (i64.extend_i32_u (local.get $l))\n" +
                   "    (local.set " + tl9.to_str() + ")\n";
            let spu9 = new SPair { ok: true, text: t9, a: ta9,
                                   l: tl9 };
            return spu9;
          }
          t9 = t9 + "    call $w_i64\n" +
                 "    (local.set $l)\n" +
                 "    (i64.extend_i32_u)\n" +
                 "    (local.set " + ta9.to_str() + ")\n" +
                 "    (i64.extend_i32_u (local.get $l))\n" +
                 "    (local.set " + tl9.to_str() + ")\n";
        }
      }
      let sp9 = new SPair { ok: true, text: t9, a: ta9, l: tl9 };
      return sp9;
    }
  }
  if e.tag == parse.EX_MCALL {
    // a string-returning method call: the receiver and args ride the
    // call, the result pair parks in fresh slots
    let mut recv: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(r14) => {
        recv = r14;
      },
      Option.None => {},
    }
    let en3: string = expr_enum_type(recv, env, prog);
    let mut tname: string = "";
    let mut text: string = "";
    if recv.tag == parse.EX_VAR && st_index(prog, recv.name) >= 0 {
      tname = recv.name;
    } else {
      if len(en3) > 0 {
        tname = en3;
        text = text + emit_expr(pool, recv, env, prog, nl);
      } else {
        let bt3: string = expr_ptr_type(recv, env, prog);
        if len(bt3) == 0 {
          return bad;
        }
        tname = bt3;
        text = text + emit_expr(pool, recv, env, prog, nl);
      }
    }
    if !rtype_is_pair(fn_rtype_of(prog, tname + "." + e.name)) {
      return bad;
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      text = text + emit_arg(pool, e.args[k], env, prog, nl);
      k = k + 1;
    }
    text = text + "    call $u_" + tname + "_" + e.name + "\n" +
           "    (local.set " + (nl.v + 1).to_str() + ")\n" +
           "    (local.set " + nl.v.to_str() + ")\n";
    let spm2 = new SPair { ok: true, text: text, a: nl.v,
                           l: nl.v + 1 };
    nl.v = nl.v + 2;
    return spm2;
  }
  return bad;
}

// assert_eq(a, b): same-type equality, refusal panics — strings
// compare content, ints/bools compare values
fn emit_assert_eq(pool: *Pool, call: *Expr, env: *Env,
                  prog: *Prog, nl: *NextLocal) -> string {
  let mut a: *Expr = parse.lit(0);
  let mut b: *Expr = parse.lit(0);
  if len(call.args) > 0 {
    a = call.args[0];
  }
  if len(call.args) > 1 {
    b = call.args[1];
  }
  let mut out: string = "";
  // any string-buildable operands (literals, vars, slices, concats,
  // format calls) compare content-wise
  let pa = build_string_pair(a, pool, env, prog, nl);
  let pb = build_string_pair(b, pool, env, prog, nl);
  if pa.ok && pb.ok {
    out = out + pa.text;
    out = out + "    (local.get " + pa.a.to_str() + ")\n" +
           "    (local.get " + pa.l.to_str() + ")\n";
    out = out + pb.text;
    out = out + "    (local.get " + pb.a.to_str() + ")\n" +
           "    (local.get " + pb.l.to_str() + ")\n";
    out = out + "    call $w_streq\n";
    out = out + "    (i32.wrap_i64)\n";
  } else {
    out = out + emit_expr(pool, a, env, prog, nl);
    out = out + emit_expr(pool, b, env, prog, nl);
    out = out + "    (i64.eq)\n";
  }
  let msg_addr: i64 = pool_intern(pool, "assert_eq failed");
  out = out + "    (i32.eqz)\n    if\n" +
         "      (call $w_panic (i32.const " + msg_addr.to_str() +
         ") (i32.const 16))\n" +
         "    end\n";
  return out;
}

// panic(msg): the message rides its pool pair straight into the
// fatal exit (process-fatal, no recover — §4)
fn emit_panic(pool: *Pool, call: *Expr) -> string {
  let mut msg: string = "panic";
  if len(call.args) >= 1 && call.args[0].tag == parse.EX_STR {
    msg = call.args[0].name;
  }
  let ma: i64 = pool_intern(pool, msg);
  return "    (call $w_panic (i32.const " + ma.to_str() +
         ") (i32.const " + pool_len(pool, msg).to_str() + "))\n";
}

// the assert builtin: a false condition panics with the message
fn emit_assert(pool: *Pool, call: *Expr, env: *Env,
               prog: *Prog, nl: *NextLocal) -> string {
  let mut cond: *Expr = parse.lit(1);
  let mut msg: *Expr = parse.strlit("assert failed");
  if len(call.args) > 0 {
    cond = call.args[0];
  }
  if len(call.args) > 1 {
    msg = call.args[1];
  }
  let mut out: string = emit_expr(pool, cond, env, prog, nl);
  // panic when the condition is FALSE
  out = out + "    (i32.wrap_i64)\n    (i32.eqz)\n    if\n";
  match fold_string(msg, env) {
    Option.Some(raw) => {
      let addr: i64 = pool_intern(pool, raw);
      out = out + "      (call $w_panic (i32.const " + addr.to_str() +
             ") (i32.const " + pool_len(pool, raw).to_str() + "))\n";
    },
    Option.None => {
      out = out + "      (call $w_panic (i32.const 0) (i32.const 0))\n";
    },
  }
  out = out + "    end\n";
  return out;
}

// printf's hole emission (the statement form and the expression
// form share it): EVERY argument evaluates before the first byte
// writes (an oob in a later hole must not leave a half line), then
// the pieces intern and the holes render by kind
fn emit_printf(pool: *Pool, fmt: string, args: []*Expr, env: *Env,
               prog: *Prog, nl: *NextLocal) -> string {
  return emit_print_fd(pool, fmt, args, env, prog, nl, 1);
}

// the stderr twin (eprintf): the same walk, fd 2
fn emit_eprintf(pool: *Pool, fmt: string, args: []*Expr, env: *Env,
                prog: *Prog, nl: *NextLocal) -> string {
  return emit_print_fd(pool, fmt, args, env, prog, nl, 2);
}

// a print/format hole holding a bool prints its word: comparisons and
// logicals (incl. the ! desugar's eq-0, op 12), vars bound from one,
// bool consts/statics by their written type, and the literals
fn hole_boolish(arg: *Expr, env: *Env, prog: *Prog) -> bool {
  if arg.tag == parse.EX_BIN &&
      ((arg.op >= 5 && arg.op <= 10) || arg.op == 12 ||
       arg.op == 13 || arg.op == 14) {
    return true;
  }
  if arg.tag == parse.EX_VAR {
    if env_bool_is(env, arg.name) {
      return true;
    }
    let mut i: usize = 0;
    while i < prog.nconsts {
      if prog.consts[i] == arg.name && prog.ctypes[i] == "bool" {
        return true;
      }
      i = i + 1;
    }
    return false;
  }
  if arg.tag == parse.EX_LIT &&
      (arg.name == "true" || arg.name == "false") {
    return true;
  }
  if arg.tag == parse.EX_MATCH {
    // a match whose every arm spells a bool word prints its word
    let mut allb: bool = len(arg.marms) > 0;
    let mut k3: usize = 0;
    while k3 < len(arg.marms) {
      match arg.marms[k3].val {
        Option.Some(av3) => {
          if !hole_boolish(av3, env, prog) {
            allb = false;
          }
        },
        Option.None => {
          allb = false;
        },
      }
      k3 = k3 + 1;
    }
    return allb;
  }
  return false;
}

// ---- generic instantiation: bind T, clone the body ----

// a width value's type name (type_width's inverse for the scalars)
fn width_name(w: i64) -> string {
  if w == 8 {
    return "i8";
  }
  if w == 16 {
    return "i16";
  }
  if w == 32 {
    return "i32";
  }
  if w == 64 {
    return "i64";
  }
  if w == 0 - 8 {
    return "u8";
  }
  if w == 0 - 16 {
    return "u16";
  }
  if w == 0 - 32 {
    return "u32";
  }
  if w == 0 - 64 {
    return "u64";
  }
  return "i64";
}

// a type text's identifier-safe spelling for wasm names
fn mangle_type(t: string) -> string {
  if len(t) >= 1 && t[0] == 42 {
    return "p" + mangle_type(t[1..len(t)]);
  }
  if len(t) >= 2 && t[0] == 91 && t[1] == 93 {
    return "s" + mangle_type(t[2..len(t)]);
  }
  if len(t) >= 1 && t[0] == 63 {
    return "o" + mangle_type(t[1..len(t)]);
  }
  // Name[a,b] — the instantiation's args ride in the mangle too
  let ob: i64 = open_bracket(t);
  if ob >= 0 && t[len(t) - 1..len(t)] == "]" {
    let base: string = t[0..(ob as usize)];
    let parts: []string = split_type_args(
        t[((ob as usize) + 1)..(len(t) - 1)]);
    let mut out: string = mangle_type(base) + "x";
    let mut k: usize = 0;
    while k < len(parts) {
      if k > 0 {
        out = out + "y";
      }
      out = out + mangle_type(parts[k]);
      k = k + 1;
    }
    return out + "z";
  }
  return t;
}

fn is_tparam(t: string, tps: []string) -> bool {
  let mut k: usize = 0;
  while k < len(tps) {
    if tps[k] == t {
      return true;
    }
    k = k + 1;
  }
  return false;
}

fn tsub_type(t: string, tps: []string, tys: []string) -> string {
  if is_tparam(t, tps) {
    let mut k: usize = 0;
    while k < len(tps) {
      if tps[k] == t {
        if k < len(tys) {
          return tys[k];
        }
      }
      k = k + 1;
    }
  }
  // the substitution rides inside prefixes (*T, ?T, []T) and bracket
  // args (Name[a,b]) alike
  if len(t) >= 2 && t[0] == 91 && t[1] == 93 {
    return "[]" + tsub_type(t[2..len(t)], tps, tys);
  }
  if len(t) >= 1 && (t[0] == 42 || t[0] == 63) {
    return t[0..1] + tsub_type(t[1..len(t)], tps, tys);
  }
  // Name[a1,a2] — the substitution rides inside the brackets
  let ob: i64 = open_bracket(t);
  if ob >= 0 && len(t) > 0 && t[len(t) - 1] == 93 {
    let base: string = t[0..(ob as usize)];
    let inner: string = t[((ob as usize) + 1)..(len(t) - 1)];
    let parts: []string = split_type_args(inner);
    let mut outp: string = "";
    let mut k2: usize = 0;
    while k2 < len(parts) {
      if k2 > 0 {
        outp = outp + ",";
      }
      outp = outp + tsub_type(parts[k2], tps, tys);
      k2 = k2 + 1;
    }
    return tsub_type(base, tps, tys) + "[" + outp + "]";
  }
  return t;
}

// the index of the FIRST '[' in a type text, -1 when none
fn open_bracket(t: string) -> i64 {
  let mut i: usize = 0;
  while i < len(t) {
    if t[i] == 91 {
      return i as i64;
    }
    if t[i] == 93 {
      return 0 - 1;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// split "a,b,c" at depth-0 commas (bracketed args nest)
fn split_type_args(s: string) -> []string {
  let parts: []string = make([]string, 8);
  let mut n: usize = 0;
  let mut depth: i64 = 0;
  let mut cur: string = "";
  let mut i: usize = 0;
  while i < len(s) {
    let b: u8 = s[i];
    if b == 91 {
      depth = depth + 1;
    }
    if b == 93 {
      depth = depth - 1;
    }
    if b == 44 && depth == 0 && n < 7 {
      parts[n] = cur;
      n = n + 1;
      cur = "";
      i = i + 1;
      continue;
    }
    cur = cur + s[i..(i + 1)];
    i = i + 1;
  }
  if len(cur) > 0 || n > 0 {
    if n < 8 {
      parts[n] = cur;
      n = n + 1;
    }
  }
  return parts[0..n];
}

// the base name of a type text (everything before the first '[')
fn type_base(t: string) -> string {
  let ob: i64 = open_bracket(t);
  if ob >= 0 {
    return t[0..(ob as usize)];
  }
  return t;
}

// unify a written param type with an argument's type, recording each
// type-parameter binding ("*Pair[A,B]" against "*Pair[i32,i64]" binds
// A=i32 B=i64; "?*T" against "?*Node" binds T=Node)
fn unify_type_bind(want: string, got: string, tps: []string,
                   tys: []string) {
  if is_tparam(want, tps) {
    let mut k: usize = 0;
    while k < len(tps) {
      if tps[k] == want && k < len(tys) {
        tys[k] = got;
      }
      k = k + 1;
    }
    return;
  }
  let ow: i64 = open_bracket(want);
  let og: i64 = open_bracket(got);
  if ow >= 0 && og >= 0 && want[len(want) - 1..len(want)] == "]" &&
      got[len(got) - 1..len(got)] == "]" {
    let bw: string = want[0..(ow as usize)];
    let bg: string = got[0..(og as usize)];
    if bw == bg {
      let pw: []string = split_type_args(
          want[((ow as usize) + 1)..(len(want) - 1)]);
      let pg: []string = split_type_args(
          got[((og as usize) + 1)..(len(got) - 1)]);
      let mut k2: usize = 0;
      while k2 < len(pw) && k2 < len(pg) {
        unify_type_bind(pw[k2], pg[k2], tps, tys);
        k2 = k2 + 1;
      }
      return;
    }
  }
  // prefix peeling: *T/?T one char, []T two
  if len(want) >= 2 && len(got) >= 2 && want[0] == 91 &&
      want[1] == 93 && got[0] == 91 && got[1] == 93 {
    unify_type_bind(want[2..len(want)], got[2..len(got)], tps, tys);
    return;
  }
  if len(want) >= 1 && len(got) >= 1 && want[0] == got[0] &&
      (want[0] == 42 || want[0] == 63) {
    unify_type_bind(want[1..len(want)], got[1..len(got)], tps, tys);
  }
}

// an expression's canonical type (best effort, exactly what binding
// T needs): the scalar names, string, bool, the float kinds, pointers
// as *T, enums by name, calls by their written return
fn expr_type(e: *Expr, env: *Env, prog: *Prog) -> string {
  if e.tag == parse.EX_STR {
    return "string";
  }
  if e.tag == parse.EX_FLIT {
    return "f64";
  }
  if e.tag == parse.EX_LIT {
    if e.name == "true" || e.name == "false" {
      return "bool";
    }
    return "i32";
  }
  if e.tag == parse.EX_VAR {
    if str_static_is(prog, e.name) {
      return "string";
    }
    let vt: string = env_val_of(env, e.name);
    if len(vt) > 0 {
      return vt;
    }
    let pt: string = env_ptr_of(env, e.name);
    if len(pt) > 0 {
      return "*" + pt;
    }
    let en2: string = env_enum_of(env, e.name);
    if len(en2) > 0 {
      return en2;
    }
    let sk: i64 = env_kind_of(env, e.name);
    if sk == 1 {
      return "string";
    }
    if sk == 2 {
      // a slice binding types by its element text ([]*Pt and the
      // string/slice pairs alike)
      let et2: string = env_slice_elemtext(env, e.name);
      if len(et2) > 0 {
        return "[]" + et2;
      }
      return "[]i64";
    }
    if env_fkind_of(env, e.name) == 1 {
      return "f64";
    }
    if env_fkind_of(env, e.name) == 2 {
      return "f32";
    }
    let mut g: usize = 0;
    while g < prog.nconsts {
      if prog.consts[g] == e.name {
        return prog.ctypes[g];
      }
      g = g + 1;
    }
    return width_name(env_width_of(env, e.name));
  }
  if e.tag == parse.EX_BIN && e.op == 11 {
    return e.name;
  }
  if e.tag == parse.EX_NEW {
    return "*" + e.name;
  }
  if e.tag == parse.EX_CALL {
    return call_fn_rtype(prog, e, env);
  }
  if e.tag == parse.EX_BIN {
    if e.op >= 5 && e.op <= 14 {
      return "bool";
    }
    let mut lt: string = "";
    match e.lhs {
      Option.Some(l10) => {
        lt = expr_type(l10, env, prog);
      },
      Option.None => {},
    }
    if len(lt) > 0 {
      return lt;
    }
    match e.rhs {
      Option.Some(r10) => {
        return expr_type(r10, env, prog);
      },
      Option.None => {},
    }
  }
  return "";
}

// substitute type texts over a verbatim deep clone (the walkers
// mutate in place; parse owns the constructors)
fn subst_expr(e: *Expr, tps: []string, tys: []string) -> *Expr {
  let out = parse.clone_expr(e);
  subst_in_expr(out, tps, tys);
  return out;
}

fn subst_in_expr(e: *Expr, tps: []string, tys: []string) {
  if e.tag == parse.EX_BIN && e.op == 11 {
    e.name = tsub_type(e.name, tps, tys);
  }
  if e.tag == parse.EX_NEW {
    // new Pair[T,T] — the instantiation's args substitute
    e.name = tsub_type(e.name, tps, tys);
  }
  match e.lhs {
    Option.Some(l11) => {
      subst_in_expr(l11, tps, tys);
    },
    Option.None => {},
  }
  match e.rhs {
    Option.Some(r11) => {
      subst_in_expr(r11, tps, tys);
    },
    Option.None => {},
  }
  let mut k: usize = 0;
  while k < len(e.args) {
    subst_in_expr(e.args[k], tps, tys);
    k = k + 1;
  }
  let mut m: usize = 0;
  while m < len(e.marms) {
    let arm = e.marms[m];
    let mut q: usize = 0;
    while q < len(arm.body) {
      subst_in_stmt(arm.body[q], tps, tys);
      q = q + 1;
    }
    match arm.val {
      Option.Some(av) => {
        subst_in_expr(av, tps, tys);
      },
      Option.None => {},
    }
    m = m + 1;
  }
}

fn subst_stmt(st: *Stmt, tps: []string, tys: []string) -> *Stmt {
  let out = parse.clone_stmt(st);
  out.fmt = tsub_type(st.fmt, tps, tys);
  subst_in_stmt(out, tps, tys);
  return out;
}

fn subst_in_stmt(st: *Stmt, tps: []string, tys: []string) {
  st.fmt = tsub_type(st.fmt, tps, tys);
  let mut k: usize = 0;
  while k < len(st.args) {
    subst_in_expr(st.args[k], tps, tys);
    k = k + 1;
  }
  match st.val {
    Option.Some(v11) => {
      subst_in_expr(v11, tps, tys);
    },
    Option.None => {},
  }
  match st.sub {
    Option.Some(s11) => {
      subst_in_stmt(s11, tps, tys);
    },
    Option.None => {},
  }
  let mut b: usize = 0;
  while b < len(st.body) {
    subst_in_stmt(st.body[b], tps, tys);
    b = b + 1;
  }
  let mut b2: usize = 0;
  while b2 < len(st.body2) {
    subst_in_stmt(st.body2[b2], tps, tys);
    b2 = b2 + 1;
  }
}

fn fn_def_of(prog: *Prog, name: string) -> *FnDef {
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name == name {
      return prog.fns[i];
    }
    i = i + 1;
  }
  return prog.fns[0];
}

// ---- overloads: one name, many signatures; exact-match-unique ----

fn fn_overload_count(prog: *Prog, name: string) -> i64 {
  let mut n: i64 = 0;
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name == name {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

// a fn's wasm name: alone under its own name; beside its siblings
// under the signature key when overloads share the name
fn wasm_fn_name(prog: *Prog, fd: *FnDef) -> string {
  if fn_overload_count(prog, fd.name) <= 1 {
    return "$u_" + sym_name(fd.name);
  }
  let mut key: string = "";
  let mut k: usize = 0;
  while k < len(fd.ptypes) {
    if k > 0 {
      key = key + "_";
    }
    let mut pt: string = fd.ptypes[k];
    if len(pt) == 0 {
      pt = "i64";
    }
    key = key + mangle_type(pt);
    k = k + 1;
  }
  return "$u_" + sym_name(fd.name) + "__" + key;
}

// does an unadapted literal ride into this parameter kind (int lit →
// int param of any width, float lit → float param)?
fn lit_adapts_into(arg: *Expr, ptype: string) -> bool {
  let mut pt: string = ptype;
  if len(pt) == 0 {
    pt = "i64";
  }
  if arg.tag == parse.EX_LIT &&
      (arg.name == "true" || arg.name == "false") {
    return pt == "bool";
  }
  if arg.tag == parse.EX_LIT {
    return type_width(pt) != 0;
  }
  if arg.tag == parse.EX_FLIT {
    return pt == "f64" || pt == "f32";
  }
  return false;
}

// resolve a call against the candidate chain: exact param types win,
// a literal adapts into any width of its own class; the unique
// survivor is the callee (zero or many would be the checker's error —
// boot refused nothing here, so the corpus never asks)
fn resolve_call_fd(prog: *Prog, e: *Expr, env: *Env) -> *FnDef {
  if fn_overload_count(prog, e.name) <= 1 {
    return fn_def_of(prog, e.name);
  }
  let mut best: i64 = 0 - 1;
  let mut best_exact: bool = false;
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name != e.name ||
        len(prog.fns[i].params) != len(e.args) {
      i = i + 1;
      continue;
    }
    let fd2: *FnDef = prog.fns[i];
    let mut allok: bool = true;
    let mut alexact: bool = true;
    let mut k: usize = 0;
    while k < len(e.args) {
      let at: string = expr_type(e.args[k], env, prog);
      let mut pt: string = "";
      if k < len(fd2.ptypes) {
        pt = fd2.ptypes[k];
      }
      if len(at) > 0 && at == pt {
        k = k + 1;
        continue;
      }
      if lit_adapts_into(e.args[k], pt) {
        alexact = false;
      } else {
        allok = false;
      }
      k = k + 1;
    }
    if !allok {
      i = i + 1;
      continue;
    }
    if best < 0 || (alexact && !best_exact) {
      best = i as i64;
      best_exact = alexact;
    }
    i = i + 1;
  }
  if best < 0 {
    return fn_def_of(prog, e.name);
  }
  return prog.fns[best as usize];
}

// a generic fn's type bindings from its call's arguments: directly
// when a param IS the parameter, structurally when the param mentions
// it (*Pair[A,B] against *Pair[i32,i64])
fn ginst_bind_tys(fd: *FnDef, e: *Expr, env: *Env,
                  prog: *Prog) -> []string {
  let nt: usize = len(fd.tparams);
  let tys: []string = make([]string, nt);
  let mut ti: usize = 0;
  while ti < nt {
    tys[ti] = "i64";
    ti = ti + 1;
  }
  let mut pk: usize = 0;
  while pk < len(fd.params) {
    if pk < len(fd.ptypes) && pk < len(e.args) {
      let pt3: string = fd.ptypes[pk];
      let at2: string = expr_type(e.args[pk], env, prog);
      if len(at2) > 0 {
        if is_tparam(pt3, fd.tparams) {
          let mut wi: usize = 0;
          while wi < nt {
            if fd.tparams[wi] == pt3 {
              tys[wi] = at2;
            }
            wi = wi + 1;
          }
        } else {
          unify_type_bind(pt3, at2, fd.tparams, tys);
        }
      }
    }
    pk = pk + 1;
  }
  return tys;
}

// a call's return type, overload-aware
fn call_fn_rtype(prog: *Prog, e: *Expr, env: *Env) -> string {
  if fn_overload_count(prog, e.name) > 1 {
    let fd3: *FnDef = resolve_call_fd(prog, e, env);
    if len(fd3.rtype) > 0 {
      return fd3.rtype;
    }
  }
  if user_fn_exists(prog, e.name) {
    // a user fn; a generic's return rides its instantiation's bind
    let fd0: *FnDef = fn_def_of(prog, e.name);
    if len(fd0.tparams) > 0 {
      let tys: []string = ginst_bind_tys(fd0, e, env, prog);
      return tsub_type(fd0.rtype, fd0.tparams, tys);
    }
  }
  return fn_rtype_of(prog, e.name);
}

// the wasm callee for a call: a plain user fn emits under its own
// name; a generic fn instantiates per distinct type binding (the
// argument types bind T in declaration order) and emits the clone
fn ginst_call_name(pool: *Pool, prog: *Prog, e: *Expr,
                   env: *Env) -> string {
  if !user_fn_exists(prog, e.name) {
    return "$u_" + sym_name(e.name);
  }
  let fd: *FnDef = resolve_call_fd(prog, e, env);
  let nt: usize = len(fd.tparams);
  if nt == 0 {
    return wasm_fn_name(prog, fd);
  }
  // bind each T from the call's arguments
  let tys: []string = ginst_bind_tys(fd, e, env, prog);
  let mut key: string = "";
  let mut ki: usize = 0;
  while ki < nt {
    key = key + "_" + mangle_type(tys[ki]);
    ki = ki + 1;
  }
  let mut i: usize = 0;
  while i < pool.gi.n {
    if pool.gi.bases[i] == e.name && pool.gi.keys[i] == key {
      return "$u_" + sym_name(e.name) + pool.gi.sufs[i];
    }
    i = i + 1;
  }
  // clone with the binding and enqueue
  let clone = parse.clone_fndef(fd);
  clone.name = e.name + key;
  let npt: usize = len(fd.ptypes);
  let ntypes: []string = make([]string, npt);
  let npstr: []bool = make([]bool, npt);
  let npslc: []bool = make([]bool, npt);
  let mut pi: usize = 0;
  while pi < npt {
    let subbed: string = tsub_type(fd.ptypes[pi], fd.tparams, tys);
    ntypes[pi] = subbed;
    // the substituted kind rewrites the ABI flags: a T bound to
    // string rides its pair, a []T as a slice pair
    npstr[pi] = subbed == "string" ||
        (len(subbed) >= 2 && subbed[0] == 91 && subbed[1] == 93);
    npslc[pi] = len(subbed) >= 2 && subbed[0] == 91 &&
        subbed[1] == 93;
    pi = pi + 1;
  }
  clone.ptypes = ntypes;
  clone.pstr = npstr;
  clone.pslc = npslc;
  clone.rtype = tsub_type(fd.rtype, fd.tparams, tys);
  clone.tparams = fd.tparams[0..0];
  let nb2: usize = len(clone.body);
  let mut ci: usize = 0;
  while ci < nb2 {
    subst_in_stmt(clone.body[ci], fd.tparams, tys);
    ci = ci + 1;
  }
  pool.gi.bases[pool.gi.n] = e.name;
  pool.gi.keys[pool.gi.n] = key;
  pool.gi.sufs[pool.gi.n] = key;
  pool.gi.fds[pool.gi.n] = clone;
  pool.gi.n = pool.gi.n + 1;
  return "$u_" + sym_name(e.name) + key;
}

// a method on a generic type instantiates per receiver binding: the
// type's declared params ride implicitly, bound from the receiver's
// bracket args (boot's law); the receiver param's written type takes
// the full instantiated text so field reads key on true layouts
fn ginst_method_target(pool: *Pool, prog: *Prog, rtype: string,
                       mname: string) -> string {
  let base: string = type_base(rtype);
  let ob: i64 = open_bracket(rtype);
  if ob < 0 {
    return "";
  }
  let mut gtps: []string = make([]string, 0);
  let si: i64 = st_index(prog, base);
  if si >= 0 && len(prog.structs[si as usize].tparams) > 0 {
    gtps = prog.structs[si as usize].tparams;
  } else {
    let ei: i64 = en_index(prog, base);
    if ei >= 0 && len(prog.enums[ei as usize].tparams) > 0 {
      gtps = prog.enums[ei as usize].tparams;
    }
  }
  if len(gtps) == 0 {
    return "";
  }
  let mfull: string = base + "." + mname;
  if !user_fn_exists(prog, mfull) {
    return "";
  }
  let tys: []string = split_type_args(
      rtype[((ob as usize) + 1)..(len(rtype) - 1)]);
  let mut key: string = "";
  let mut ki: usize = 0;
  while ki < len(gtps) {
    key = key + "_" + mangle_type(tys[ki]);
    ki = ki + 1;
  }
  let mut i: usize = 0;
  while i < pool.gi.n {
    if pool.gi.bases[i] == mfull && pool.gi.keys[i] == key {
      return "$u_" + sym_name(mfull) + pool.gi.sufs[i];
    }
    i = i + 1;
  }
  let fdm: *FnDef = fn_def_of(prog, mfull);
  let clone = parse.clone_fndef(fdm);
  clone.name = mfull + key;
  let npt: usize = len(fdm.ptypes);
  let ntypes: []string = make([]string, npt);
  let npstr: []bool = make([]bool, npt);
  let npslc: []bool = make([]bool, npt);
  let mut pi: usize = 0;
  while pi < npt {
    let mut pt4: string = tsub_type(fdm.ptypes[pi], gtps, tys);
    if len(pt4) > 0 {
      // the receiver's bare base becomes the full instantiation
      let pb: string = type_base(pt4);
      if pb == base && pt4 == pb {
        pt4 = rtype;
      } else {
        if pb == base && pt4 == "*" + pb {
          pt4 = "*" + rtype;
        } else {
          if pb == base && pt4 == "?" + pb {
            pt4 = "?" + rtype;
          }
        }
      }
    }
    ntypes[pi] = pt4;
    npstr[pi] = pt4 == "string" ||
        (len(pt4) >= 2 && pt4[0] == 91 && pt4[1] == 93);
    npslc[pi] = len(pt4) >= 2 && pt4[0] == 91 && pt4[1] == 93;
    pi = pi + 1;
  }
  clone.ptypes = ntypes;
  clone.pstr = npstr;
  clone.pslc = npslc;
  clone.rtype = tsub_type(fdm.rtype, gtps, tys);
  clone.tparams = fdm.tparams[0..0];
  let nb3: usize = len(clone.body);
  let mut ci: usize = 0;
  while ci < nb3 {
    subst_in_stmt(clone.body[ci], gtps, tys);
    ci = ci + 1;
  }
  pool.gi.bases[pool.gi.n] = mfull;
  pool.gi.keys[pool.gi.n] = key;
  pool.gi.sufs[pool.gi.n] = key;
  pool.gi.fds[pool.gi.n] = clone;
  pool.gi.n = pool.gi.n + 1;
  return "$u_" + sym_name(mfull) + key;
}

// a value whose type owns a to_str method prints through it (the
// Show surface: struct pointers, struct values, enum boxes); the
// pair parks in fresh slots, "" when no method exists
fn to_str_pair(e: *Expr, pool: *Pool, env: *Env, prog: *Prog,
               nl: *NextLocal) -> *SPair {
  let bad = new SPair { ok: false, text: "", a: 0, l: 0 };
  let mut tname: string = "";
  if e.tag == parse.EX_VAR {
    let vt: string = env_val_of(env, e.name);
    if len(vt) > 0 {
      tname = vt;
    } else {
      let pt4: string = env_ptr_of(env, e.name);
      if len(pt4) > 0 {
        tname = pt4;
      } else {
        tname = env_enum_of(env, e.name);
      }
    }
  } else {
    let et4: string = expr_enum_type(e, env, prog);
    if len(et4) > 0 {
      tname = et4;
    } else {
      tname = expr_ptr_type(e, env, prog);
    }
  }
  if len(tname) == 0 {
    return bad;
  }
  if !user_fn_exists(prog, tname + ".to_str") {
    return bad;
  }
  if !rtype_is_pair(fn_rtype_of(prog, tname + ".to_str")) {
    return bad;
  }
  let text: string = emit_expr(pool, e, env, prog, nl) +
         "    call $u_" + tname + "_to_str\n" +
         "    (local.set " + (nl.v + 1).to_str() + ")\n" +
         "    (local.set " + nl.v.to_str() + ")\n";
  let spt = new SPair { ok: true, text: text, a: nl.v,
                        l: nl.v + 1 };
  nl.v = nl.v + 2;
  return spt;
}

// ---- variadics: rest: T... materializes at the call ----

// the rest parameter's index, -1 when the fn is not variadic
fn fn_variadic_at(fd: *FnDef) -> i64 {
  let mut k: usize = 0;
  while k < len(fd.pvar) {
    if fd.pvar[k] {
      return k as i64;
    }
    k = k + 1;
  }
  return 0 - 1;
}

// a call's arguments: fixed params in order, then the rest tail — a
// lone spread rides its pair whole, anything else materializes a
// fresh zeroed slice (string elements take two slots each)
fn emit_call_args(pool: *Pool, prog: *Prog, fd: *FnDef, e: *Expr,
                  env: *Env, nl: *NextLocal) -> string {
  let vp: i64 = fn_variadic_at(fd);
  let mut out: string = "";
  if vp < 0 {
    let mut k: usize = 0;
    while k < len(e.args) {
      if k < len(fd.ptypes) &&
          st_index(prog, fd.ptypes[k]) >= 0 {
        // a by-value struct param: the argument rides its address
        out = out + struct_addr_of(pool, e.args[k], env, prog, nl);
      } else {
        out = out + emit_arg(pool, e.args[k], env, prog, nl);
      }
      k = k + 1;
    }
    return out;
  }
  let mut elem: string = "";
  if (vp as usize) < len(fd.ptypes) {
    elem = fd.ptypes[vp as usize];
  }
  let et: string = elem[2..len(elem)];
  let sstr: bool = et == "string";
  let mut esz: i64 = 1;
  if sstr {
    esz = 2;
  }
  let mut k: usize = 0;
  while (k as i64) < vp && k < len(e.args) {
    if k < len(fd.ptypes) &&
        st_index(prog, fd.ptypes[k]) >= 0 {
      // a by-value struct param: the argument rides its address
      out = out + struct_addr_of(pool, e.args[k], env, prog, nl);
    } else {
      out = out + emit_arg(pool, e.args[k], env, prog, nl);
    }
    k = k + 1;
  }
  let rest: i64 = (len(e.args) as i64) - vp;
  if rest <= 0 {
    // an empty rest: a zero-count allocation still lands the pair
    out = out + "    (i64.extend_i32_u (call $w_alloc (i32.const 0)))" +
           "\n    (local.set " + nl.v.to_str() + ")\n" +
           "    (i64.const 0)\n    (local.set " +
           (nl.v + 1).to_str() + ")\n" +
           "    (local.get " + nl.v.to_str() + ")\n" +
           "    (local.get " + (nl.v + 1).to_str() + ")\n";
    nl.v = nl.v + 2;
    return out;
  }
  let lasti: usize = len(e.args) - 1;
  let lastarg: *Expr = e.args[lasti];
  if lastarg.lit == 0 - 99 && (lasti as i64) == vp {
    // a lone spread rides its pair whole
    out = out + emit_arg(pool, lastarg, env, prog, nl);
    return out;
  }
  // a fresh slice of the rest values
  let a_slot: i64 = nl.v;
  let l_slot: i64 = nl.v + 1;
  nl.v = nl.v + 2;
  out = out + "    (i64.extend_i32_u (call $w_alloc (i32.const " +
         (rest * esz).to_str() + ")))\n" +
         "    (local.set " + a_slot.to_str() + ")\n" +
         "    (i64.const " + rest.to_str() + ")\n" +
         "    (local.set " + l_slot.to_str() + ")\n";
  let mut j: usize = vp as usize;
  let mut sl: i64 = 0;
  while j < len(e.args) {
    let av: *Expr = e.args[j];
    if sstr {
      let spv2 = build_string_pair(av, pool, env, prog, nl);
      out = out + spv2.text +
             "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
             a_slot.to_str() + ")) (i32.mul (i32.const " +
             sl.to_str() + ") (i32.const 8))) (local.get " +
             spv2.a.to_str() + "))\n" +
             "    (i64.store (i32.add (i32.add (i32.wrap_i64 (local.get " +
             a_slot.to_str() + ")) (i32.mul (i32.const " +
             sl.to_str() + ") (i32.const 8))) (i32.const 8)) " +
             "(local.get " + spv2.l.to_str() + "))\n";
      sl = sl + 2;
    } else {
      let tv2: i64 = nl.v;
      nl.v = nl.v + 1;
      out = out + emit_expr(pool, av, env, prog, nl);
      out = out + "    (local.set " + tv2.to_str() + ")\n" +
             "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
             a_slot.to_str() + ")) (i32.mul (i32.const " +
             sl.to_str() + ") (i32.const 8))) (local.get " +
             tv2.to_str() + "))\n";
      sl = sl + 1;
    }
    j = j + 1;
  }
  out = out + "    (local.get " + a_slot.to_str() + ")\n" +
         "    (local.get " + l_slot.to_str() + ")\n";
  return out;
}

// ---- closures: capture boxes + an indirect-call table ----

fn is_fn_type(t: string) -> bool {
  return len(t) >= 2 && t[0] == 102 && t[1] == 110;
}

// the capture-name accumulator
struct CapList {
  names: []string,
  n: usize,
}

fn cap_add(caps: *CapList, name: string) {
  let mut i: usize = 0;
  while i < caps.n {
    if caps.names[i] == name {
      return;
    }
    i = i + 1;
  }
  if caps.n < len(caps.names) {
    caps.names[caps.n] = name;
    caps.n = caps.n + 1;
  }
}

fn cap_expr(e: *Expr, env: *Env, prog: *Prog, skip: []string,
            nskip: usize, caps: *CapList) {
  if e.tag == parse.EX_CLO {
    // a nested literal: its own params are its own
    let mut b: usize = 0;
    while b < nskip {
      b = b + 1;
    }
    let mut m: usize = 0;
    while m < len(e.marms) {
      cap_stmts(e.marms[m].body, env, prog, e.fnames, caps);
      m = m + 1;
    }
    return;
  }
  if e.tag == parse.EX_VAR {
    if env_look(env, e.name) >= 0 && !name_is_const(prog, e.name) &&
        len(static_global(prog, e.name)) == 0 {
      let mut hit: bool = false;
      let mut k: usize = 0;
      while k < nskip {
        if skip[k] == e.name {
          hit = true;
        }
        k = k + 1;
      }
      if !hit {
        cap_add(caps, e.name);
      }
    }
  }
  match e.lhs {
    Option.Some(l15) => {
      cap_expr(l15, env, prog, skip, nskip, caps);
    },
    Option.None => {},
  }
  match e.rhs {
    Option.Some(r15) => {
      cap_expr(r15, env, prog, skip, nskip, caps);
    },
    Option.None => {},
  }
  let mut k: usize = 0;
  while k < len(e.args) {
    cap_expr(e.args[k], env, prog, skip, nskip, caps);
    k = k + 1;
  }
}

fn cap_stmts(nodes: []*Stmt, env: *Env, prog: *Prog,
             skip: []string, caps: *CapList) {
  let nskip: usize = len(skip);
  let mut i: usize = 0;
  while i < len(nodes) {
    let st = nodes[i];
    match st.val {
      Option.Some(v15) => {
        cap_expr(v15, env, prog, skip, nskip, caps);
      },
      Option.None => {},
    }
    let mut a: usize = 0;
    while a < len(st.args) {
      cap_expr(st.args[a], env, prog, skip, nskip, caps);
      a = a + 1;
    }
    cap_stmts(st.body, env, prog, skip, caps);
    cap_stmts(st.body2, env, prog, skip, caps);
    i = i + 1;
  }
}

// a closure literal's value: the capture box (a copy of each free
// local), plus the (table idx, box) pair on the lane
fn emit_closure_value(e: *Expr, pool: *Pool, env: *Env,
                      prog: *Prog, nl: *NextLocal) -> string {
  let caps = new CapList { names: make([]string, 32), n: 0 };
  let mut m: usize = 0;
  while m < len(e.marms) {
    cap_stmts(e.marms[m].body, env, prog, e.fnames, caps);
    m = m + 1;
  }
  // the box: [pad][cap0][cap1]...
  let b_slot: i64 = nl.v;
  nl.v = nl.v + 1;
  let mut out: string = "    (i64.extend_i32_u (call $w_alloc (i32.const " +
         ((caps.n + 1) as i64).to_str() + ")))\n" +
         "    (local.set " + b_slot.to_str() + ")\n";
  let mut ci: usize = 0;
  while ci < caps.n {
    let cslot: i64 = env_look(env, caps.names[ci]);
    out = out + "    (i64.store (i32.add (i32.wrap_i64 (local.get " +
           b_slot.to_str() + ")) (i32.const " +
           ((ci + 1) * 8).to_str() + ")) (local.get " +
           cslot.to_str() + "))\n";
    ci = ci + 1;
  }
  // register the body + its table slot
  let wat: string = "$u___clo" + pool.gi.cfn.to_str();
  let gi_n: usize = pool.gi.n;
  pool.gi.bases[gi_n] = "clo:" + wat;
  pool.gi.keys[gi_n] = "";
  pool.gi.sufs[gi_n] = "";
  pool.gi.fds[gi_n] = prog.fns[0];
  let carrier = parse.clone_fndef(prog.fns[0]);
  carrier.body = e.marms[0].body;
  pool.gi.clo_fds[gi_n] = carrier;
  let idx: i64 = pool.gi.cfn as i64;
  pool.gi.ids[gi_n] = idx;
  let capbase: usize = (idx as usize) * 8;
  let mut pi2: usize = 0;
  while pi2 < len(e.fnames) && pi2 < 8 {
    pool.gi.clo_params[capbase + pi2] = e.fnames[pi2];
    pi2 = pi2 + 1;
  }
  let mut cj: usize = 0;
  while cj < caps.n && cj < 8 {
    let cname: string = caps.names[cj];
    let cty: string = env_ptr_of(env, cname);
    if len(cty) > 0 {
      pool.gi.clo_caps[capbase + cj] = cname + ":" + cty;
    } else {
      pool.gi.clo_caps[capbase + cj] = cname;
    }
    cj = cj + 1;
  }
  pool.gi.n = pool.gi.n + 1;
  pool.gi.clo_wasms[pool.gi.cfn] = wat;
  pool.gi.cfn = pool.gi.cfn + 1;
  // the arity the body's calls will use (box + params)
  let ari: i64 = 1 + (len(e.fnames) as i64);
  clo_ty_need(pool.gi, ari, 1);
  out = out + "    (i64.const " + idx.to_str() + ")\n" +
         "    (local.get " + b_slot.to_str() + ")\n";
  return out;
}

// one closure's fn: param 0 the capture box, captures load from its
// slots, the literal's params follow — the body emits as statements
fn emit_closure_fn(wat: string, caps: []string,
                   captypes: []string, ncaps: usize,
                   params: []string, body: []*Stmt, pool: *Pool,
                   prog: *Prog) -> string {
  let env = env_new(1024);
  env_bind_consts(env, prog, pool);
  let nparams: i64 = 1 + (len(params) as i64);
  let nl = new NextLocal { v: nparams + 5 };
  let loops = loops_new();
  let dstack = dstack_new();
  let mut text: string = "";
  let mut ci: usize = 0;
  while ci < ncaps {
    let cslot: i64 = nl.v;
    nl.v = nl.v + 1;
    text = text + "    (i64.load (i32.add (i32.wrap_i64 " +
           "(local.get 0)) (i32.const " + ((ci + 1) * 8).to_str() +
           ")))\n" +
           "    (local.set " + cslot.to_str() + ")\n";
    let mut cty2: string = "";
    if ci < len(captypes) {
      cty2 = captypes[ci];
    }
    if len(cty2) > 0 && st_index(prog, cty2) >= 0 {
      env_bind_ptr(env, caps[ci], cslot, cty2);
    } else {
      env_bind(env, caps[ci], cslot);
    }
    ci = ci + 1;
  }
  let mut pi: usize = 0;
  while pi < len(params) {
    env_bind(env, params[pi], (pi as i64) + 1);
    pi = pi + 1;
  }
  text = text + emit_stmts(body, pool, env, nl, true, 0 - 1, prog,
                           loops, dstack, Option.None);
  let mut out: string = "  (func " + wat;
  let mut q: i64 = 0;
  while q < nparams {
    out = out + " (param i64)";
    q = q + 1;
  }
  out = out + " (result i64)\n";
  out = out + "    (local $a i32) (local $l i32) (local $t i64)" +
         " (local $r i64) (local $d i64)\n";
  q = nparams + 5;
  while q < nl.v {
    out = out + "    (local i64)\n";
    q = q + 1;
  }
  out = out + text;
  out = out + "    (i64.const 0)\n  )\n";
  return out;
}

// the first ':' in a name:type capture record, 0 when bare
fn find_colon(s: string) -> usize {
  let mut i: usize = 0;
  while i < len(s) {
    if s[i] == 58 {
      return i;
    }
    i = i + 1;
  }
  return 0;
}

// an Option-typed annotation's payload text ('?*Node' -> '*Node'),
// "" when the annotation names none
fn opt_payload(fmt: string) -> string {
  if len(fmt) >= 1 && fmt[0] == 63 {
    return fmt[1..len(fmt)];
  }
  if len(fmt) >= 7 && fmt[0] == 79 && fmt[7] == 91 {
    // Option[..]: find the matching close bracket
    let mut i: usize = 8;
    while i < len(fmt) {
      if fmt[i] == 93 {
        return fmt[8..i];
      }
      i = i + 1;
    }
  }
  return "";
}

fn emit_print_fd(pool: *Pool, fmt: string, args: []*Expr, env: *Env,
                 prog: *Prog, nl: *NextLocal, fd: i64) -> string {
  let pieces: []string = parse.fmt_pieces(fmt);
  // pass 1: evaluate each hole into temps (folded strings skip the
  // temps — their pool consts are side-effect free)
  let mut nhol: usize = len(pieces) - 1;
  if nhol > len(args) {
    nhol = len(args);
  }
  let t_a: []i64 = make([]i64, len(args) + 1);
  let t_l: []i64 = make([]i64, len(args) + 1);
  let kinds: []i64 = make([]i64, len(args) + 1); // 0 int 1 uint 2 bool
                                             // 3 folded str 4 live pair
  let mut pre: string = "";
  let mut q: usize = 0;
  while q < nhol {
    let arg: *Expr = args[q];
    match fold_string(arg, env) {
      Option.Some(raw) => {
        let saddr: i64 = pool_intern(pool, raw);
        t_a[q] = saddr;
        t_l[q] = pool_len(pool, raw);
        kinds[q] = 3;
      },
      Option.None => {
        let fk: i64 = expr_fkind(arg, env, prog);
        if fk > 0 {
          // a float hole prints through the exact-decimal text: the
          // lane's bits ride the printer (f32 rounds through demote
          // first, so a non-f32 literal narrows honestly)
          FLOAT_WANTED = 1;
          pre = pre + emit_expr(pool, arg, env, prog, nl);
          let tb: i64 = nl.v;
          nl.v = nl.v + 1;
          pre = pre + "    (local.set " + tb.to_str() + ")\n" +
                "    (local.get " + tb.to_str() + ")\n";
          if fk == 2 {
            pre = pre + "    (f64.reinterpret_i64)\n" +
                  "    (f32.demote_f64)\n    (f64.promote_f32)\n" +
                  "    (i64.reinterpret_f64)\n" +
                  "    call $u___f32_text\n";
          } else {
            pre = pre + "    call $u___f64_text\n";
          }
          t_a[q] = nl.v;
          t_l[q] = nl.v + 1;
          nl.v = nl.v + 2;
          pre = pre + "    (local.set " + t_l[q].to_str() + ")\n" +
                "    (local.set " + t_a[q].to_str() + ")\n";
          kinds[q] = 4;
        } else {
        let dyn_pair: bool =
            dyn_hole_dispatch(arg, pool, env, prog, nl);
        if dyn_pair {
          // a dyn value renders through its vtable's to_str slot
          t_a[q] = DYN_A;
          t_l[q] = DYN_L;
          kinds[q] = 4;
          pre = pre + DYN_TEXT;
          DYN_TEXT = "";
        } else {
        let spt = to_str_pair(arg, pool, env, prog, nl);
        if spt.ok {
          // a value whose type owns to_str prints through it
          pre = pre + spt.text;
          t_a[q] = spt.a;
          t_l[q] = spt.l;
          kinds[q] = 4;
        } else {
        let sp = build_string_pair(arg, pool, env, prog, nl);
        if sp.ok {
          pre = pre + sp.text;
          t_a[q] = sp.a;
          t_l[q] = sp.l;
          kinds[q] = 4;
        } else {
          if hole_boolish(arg, env, prog) {
            // a comparison or logical — or a var bound from one —
            // prints its spelled word
            pre = pre + emit_expr(pool, arg, env, prog, nl);
            t_a[q] = nl.v;
            nl.v = nl.v + 1;
            pre = pre + "    (local.set " + t_a[q].to_str() + ")\n";
            kinds[q] = 2;
          } else {
            let mut boolish: bool = false;
            if arg.tag == parse.EX_CALL {
              boolish = call_fn_rtype(prog, arg, env) == "bool";
            }
            if arg.tag == parse.EX_MCALL {
              let mut recv0: *Expr = parse.lit(0);
              match arg.lhs {
                Option.Some(r4) => {
                  recv0 = r4;
                },
                Option.None => {},
              }
              if recv0.tag == parse.EX_VAR {
                boolish = fn_rtype_of(prog, recv0.name + "." +
                                      arg.name) == "bool";
              }
            }
            pre = pre + emit_expr(pool, arg, env, prog, nl);
            t_a[q] = nl.v;
            nl.v = nl.v + 1;
            pre = pre + "    (local.set " + t_a[q].to_str() + ")\n";
            if boolish {
              kinds[q] = 2;
            } else {
              if expr_width(arg, env, prog) < 0 {
                kinds[q] = 1;
              } else {
                kinds[q] = 0;
              }
            }
          }
        }
        }
        }
        }
      },
    }
    q = q + 1;
  }
  // pass 2: the writes, left to right, reading the temps
  let mut out: string = pre;
  let mut pi: usize = 0;
  while pi < len(pieces) {
    if len(pieces[pi]) > 0 {
      let addr: i64 = pool_intern(pool, pieces[pi]);
      out = out + write_fd(addr, pool_len(pool, pieces[pi]), fd);
    }
    if pi + 1 < len(pieces) && pi < nhol {
      let h: usize = pi;
      if kinds[h] == 3 {
        out = out + write_fd(t_a[h], t_l[h], fd);
      } else {
        if kinds[h] == 4 {
          out = out + "    (local.get " + t_a[h].to_str() +
                 ")\n    (i32.wrap_i64)\n    (local.set $a)\n" +
                 "    (local.get " + t_l[h].to_str() +
                 ")\n    (i32.wrap_i64)\n    (local.set $l)\n" +
                 "    (i32.store (i32.const 64) (local.get $a))\n" +
                 "    (i32.store (i32.const 68) (local.get $l))\n" +
                 "    (drop (call $fd_write (i32.const " + fd.to_str() +
                 ") " +
                 "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
        } else {
          if kinds[h] == 2 {
            out = out + "    (local.get " + t_a[h].to_str() +
                   ")\n    call $w_bool\n" +
                   "    (local.set $l)\n    (local.set $a)\n" +
                   "    (i32.store (i32.const 64) (local.get $a))\n" +
                   "    (i32.store (i32.const 68) (local.get $l))\n" +
                   "    (drop (call $fd_write (i32.const " +
                   fd.to_str() + ") " +
                   "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
          } else {
            out = out + "    (local.get " + t_a[h].to_str() + ")\n";
            if kinds[h] == 1 {
              out = out + "    call $w_u64\n";
            } else {
              out = out + "    call $w_i64\n";
            }
            out = out + "    (local.set $l)\n    (local.set $a)\n" +
                   "    (i32.store (i32.const 64) (local.get $a))\n" +
                   "    (i32.store (i32.const 68) (local.get $l))\n" +
                   "    (drop (call $fd_write (i32.const " +
                   fd.to_str() + ") " +
                   "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
          }
        }
      }
    }
    pi = pi + 1;
  }
  return out;
}

fn emit_stmts(nodes: []*Stmt, pool: *Pool, env: *Env,
               nl: *NextLocal, in_fn: bool, ret_slot: i64,
               prog: *Prog, loops: *Loops, dstack: *DStack,
               tfd: ?*FnDef) -> string {
  env.infn = in_fn;
  env.retslot = ret_slot;
  env.loops = loops;
  env.dstack = dstack;
  env.tfd = tfd;
  dpush(dstack);
  let mut body: string = "";
  let mut i: usize = 0;
  while i < len(nodes) {
    let st = nodes[i];
    if st.tag == parse.ST_RET && in_fn {
      // a fn's return: the value parks in $r while the open scopes'
      // defers unwind (LIFO), then rides home — unless the value is a
      // direct self tail call, which becomes the loop rewrite (args
      // land in the param slots, br re-enters the fn-top loop)
      let mut is_tail: bool = false;
      match tfd {
        Option.Some(fdef) => {
          match st.val {
            Option.Some(rv) => {
              if rv.tag == parse.EX_CALL && rv.name == fdef.name {
                is_tail = true;
              }
            },
            Option.None => {},
          }
        },
        Option.None => {},
      }
      // a string fn's return rides its pair (else-chained, never a
      // match-arm continue — boot's match continue does not skip the
      // enclosing loop's tail and the old path would append junk)
      let mut sret: bool = false;
      if !is_tail {
        match tfd {
          Option.Some(fdef) => {
            if rtype_is_pair(fdef.rtype) {
              sret = true;
            }
          },
          Option.None => {},
        }
      }
      let mut sret_done: bool = false;
      if sret {
        match st.val {
          Option.Some(rv) => {
            let sp = build_string_pair(rv, pool, env, prog,
                                       nl);
            if sp.ok {
              body = body + sp.text;
              body = body + dunwind_emit(dstack);
              body = body + "    (local.get " + sp.a.to_str() +
                     ")\n    (local.get " + sp.l.to_str() +
                     ")\n    return\n";
              sret_done = true;
            }
          },
          Option.None => {},
        }
      }
      if !sret_done {
      if is_tail {
        match st.val {
          Option.Some(rv) => {
            let mut k: usize = 0;
            while k < len(rv.args) {
              body = body + emit_arg(pool, rv.args[k], env, prog, nl);
              k = k + 1;
            }
            // pop into the param slots, last arg first (a pair param
            // takes two consecutive sets)
            match tfd {
              Option.Some(fdef) => {
                let mut j: usize = len(fdef.params);
                while j > 0 {
                  let q: i64 = (j as i64) - 1;
                  if j - 1 < len(fdef.pstr) && fdef.pstr[j - 1] {
                    body = body + "    (local.set " + (q + 1).to_str() +
                           ")\n";
                    body = body + "    (local.set " + q.to_str() + ")\n";
                  } else {
                    body = body + "    (local.set " + q.to_str() + ")\n";
                  }
                  j = j - 1;
                }
              },
              Option.None => {},
            }
            body = body + "    (br $t)\n";
          },
          Option.None => {},
        }
      } else {
        match st.val {
          Option.Some(rv) => {
            // a returned binding moves out: its own scope release
            // must not run (the count travels with the value)
            let mut skipn: string = " ";
            if rv.tag == parse.EX_VAR {
              skipn = rv.name;
            }
            body = body + emit_expr(pool, rv, env, prog, nl);
            body = body + "    (local.set $r)\n";
            body = body + dunwind_emit_skip(dstack, skipn);
            body = body + "    (local.get $r)\n";
            body = body + "    return\n";
          },
          Option.None => {
            body = body + dunwind_emit(dstack);
            body = body + "    (i64.const 0)\n    return\n";
          },
        }
      }
      }
    }
    if st.tag == parse.ST_RET && !in_fn {
      // main's return: the value lands in the exit slot (i32)
      match st.val {
        Option.Some(rv) => {
          body = body + emit_expr(pool, rv, env, prog, nl);
          body = body + "    (i32.wrap_i64)\n";
          body = body + "    (local.set " + ret_slot.to_str() + ")\n";
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_PF {
      body = body + emit_printf(pool, st.fmt, st.args, env, prog, nl);
    }
    if st.tag == parse.ST_LET {
      match st.val {
        Option.Some(e) => {
          if is_dyn_type(st.fmt) {
            // DISABLED: the dyn coercion emit crashes indirect calls
            // (084); the static accident handles homogeneous dyn.
            // Next growth re-lands this with the crash fixed.
            // a dyn coercion: the fat pair (vtable box, obj) — the
            // vtable caches per (trait, type); the obj retains (the
            // dyn owns a reference)
            let trt7: string = dyn_trait(st.fmt);
            let objt: string = expr_ptr_type(e, env, prog);
            let vt_text: string = dyn_vtable(pool, prog, trt7,
                                             objt);
            if len(vt_text) > 0 {
              let vb7: i64 = nl.v;
              let ob7: i64 = nl.v + 1;
              nl.v = nl.v + 2;
              body = body + vt_text;
              body = body + "    (local.set " + vb7.to_str() +
                     ")\n";
              body = body + emit_expr(pool, e, env, prog, nl);
              body = body + "    (local.set " + ob7.to_str() +
                     ")\n";
              body = body + retain_if_shared(e, ob7);
              env_str_bind_runtime(env, st.name, vb7, ob7, 3);
              env_bind_sliceelem(env, st.name, st.fmt);
              // the scope-exit release dispatches through the
              // vtable's release slot (a rebind updates the pair
              // slots in place, so the exit sees the live value)
              let nm7: i64 = trait_method_count(prog, trt7);
              drel_push(dstack, st.name,
                        "    (local.get " + ob7.to_str() + ")\n" +
                        "    (i64.load (i32.add (i32.wrap_i64 " +
                        "(local.get " + vb7.to_str() + ")) (i32.const " +
                        (nm7 * 8).to_str() + ")))\n" +
                        "    (i32.wrap_i64)\n" +
                        "    call_indirect (type $clv1)\n");
            } else {
              body = body + emit_expr(pool, e, env, prog, nl);
              body = body + "    (local.set " + nl.v.to_str() +
                     ")\n";
              env_bind(env, st.name, nl.v);
              nl.v = nl.v + 1;
            }
          } else
          if is_weak_type(st.fmt) ||
              (e.tag == parse.EX_VAR && is_weak_type(
                  env_ptr_of(env, e.name))) {
            // a weak handle rides the pointer lane (never counted:
            // weak.get() probes the header's rc, equality is identity)
            body = body + emit_expr(pool, e, env, prog, nl);
            body = body + "    (local.set " + nl.v.to_str() + ")\n";
            let mut wt: string = weak_target(st.fmt);
            if len(wt) == 0 && e.tag == parse.EX_VAR {
              wt = weak_target(env_ptr_of(env, e.name));
            }
            env_bind_ptr(env, st.name, nl.v, "weak:" + wt);
            nl.v = nl.v + 1;
          } else
          if e.tag == parse.EX_CLO ||
              (len(st.fmt) >= 2 && st.fmt[0] == 102 && st.fmt[1] == 110) {
            // a closure literal (or any fn-typed init) rides its
            // (idx, box) pair into two slots — kind 3
            let fi_slot: i64 = nl.v;
            let fb_slot: i64 = nl.v + 1;
            nl.v = nl.v + 2;
            body = body + emit_expr(pool, e, env, prog, nl);
            body = body + "    (local.set " + fb_slot.to_str() +
                   ")\n" +
                   "    (local.set " + fi_slot.to_str() + ")\n";
            env_str_bind_runtime(env, st.name, fi_slot, fb_slot, 3);
          } else if e.tag == parse.EX_MAKE {
            // make([]T, n): the count rides $t once, the allocation
            // and the len slot both read it; an Option-element slice
            // fills with the shared None box (the zeroed form); a
            // struct-element slice allocates n*slots (an element is
            // the struct's whole slot block)
            let mut cnt: *Expr = parse.lit(0);
            if len(e.args) > 0 {
              cnt = e.args[0];
            }
            let optelem: bool = len(e.name) >= 1 &&
                (e.name[0] == 63 || e.name[0] == 79);
            let stelem: i64 = st_index(prog, e.name);
            let elesz: i64 = 1;
            let mut esz: i64 = elesz;
            if stelem >= 0 {
              esz = st_nslots(prog, stelem);
            } else {
              if e.name == "string" || is_dyn_type(e.name) {
                // a string element rides its pair and a dyn element
                // its fat pair: 16 bytes each
                esz = 2;
              }
            }
            body = body + emit_expr(pool, cnt, env, prog, nl);
            body = body + "    (local.set $t)\n";
            if esz != 1 {
              body = body + "    (i64.extend_i32_u (call $w_alloc " +
                     "(i32.wrap_i64 (i64.mul (local.get $t) (i64.const " +
                     esz.to_str() + ")))))\n";
            } else {
              body = body + "    (i64.extend_i32_u (call $w_alloc " +
                     "(i32.wrap_i64 (local.get $t))))\n";
            }
            body = body + "    (local.set " + nl.v.to_str() +
                   ")\n";
            let a_slot: i64 = nl.v;
            nl.v = nl.v + 1;
            body = body + "    (local.get $t)\n";
            body = body + "    (local.set " + nl.v.to_str() +
                   ")\n";
            let l_slot: i64 = nl.v;
            nl.v = nl.v + 1;
            if optelem {
              let fi: i64 = nl.v;
              nl.v = nl.v + 1;
              body = body + "    (i64.const 0)\n" +
                     "    (local.set " + fi.to_str() + ")\n" +
                     "    (loop $mo" + fi.to_str() + "\n" +
                     "    (if (i64.lt_u (local.get " + fi.to_str() +
                     ") (local.get $t))\n" +
                     "      (then (i64.store (i32.add (i32.wrap_i64 " +
                     "(local.get " + a_slot.to_str() + "))\n" +
                     "                     (i32.mul (i32.wrap_i64 " +
                     "(local.get " + fi.to_str() + ")) (i32.const 8)))\n" +
                     "                     (global.get $w_none_box))\n" +
                     "            (local.set " + fi.to_str() +
                     " (i64.add (local.get " + fi.to_str() +
                     ") (i64.const 1)))\n" +
                     "            (br $mo" + fi.to_str() + "))))\n";
            }
            env_str_bind_runtime(env, st.name, a_slot, l_slot, 2);
            env_bind_sliceelem(env, st.name, e.name);
            let relm: string = rel_callee(pool, prog,
                                          "[]" + e.name);
            if len(relm) > 0 {
              drel_push(dstack, st.name,
                        "    (local.get " +
                        a_slot.to_str() + ")\n" +
                        "    (local.get " + l_slot.to_str() +
                        ")\n" + "    call " + relm + "\n");
            }
          } else {
            if e.tag == parse.EX_SLICE2 {
              // base[a..b]: a view — addr' = addr + lo*esz, len' =
              // hi-lo (writes alias the base storage, the fat view)
              let mut base: *Expr = parse.lit(0);
              match e.lhs {
                Option.Some(b) => {
                  base = b;
                },
                Option.None => {},
              }
              let bname: string = base.name;
              let bkind: i64 = env_kind_of(env, bname);
              // a slice of a string is a RUNTIME string pair (kind 1)
              // even when the base was folded (kind 0); slices stay 2
              let mut kind: i64 = 2;
              if bkind == 0 || bkind == 1 {
                kind = 1;
              }
              let mut esz: i64 = 8;
              if kind == 1 {
                esz = 1;
              }
              // a slice base's element stride: strings and dyn pairs
              // ride 16 bytes, a struct element its slot block
              let bet: string = env_slice_elemtext(env, bname);
              if bkind == 2 && len(bet) > 0 {
                if bet == "string" || is_dyn_type(bet) {
                  esz = 16;
                } else {
                  let bsi: i64 = st_index(prog, bet);
                  if bsi >= 0 {
                    esz = st_nslots(prog, bsi) * 8;
                  }
                }
              }
              let a_slot: i64 = nl.v;
              nl.v = nl.v + 1;
              let l_slot: i64 = nl.v;
              nl.v = nl.v + 1;
              // lo
              if e.op % 2 == 1 && len(e.args) > 0 {
                body = body + emit_expr(pool, e.args[0], env, prog, nl);
              } else {
                body = body + "    (i64.const 0)\n";
              }
              body = body + "    (local.set " + a_slot.to_str() + ")\n";
              // hi: explicit or the base's len
              if (e.op / 2) % 2 == 1 && len(e.args) > 1 {
                body = body + emit_expr(pool, e.args[1], env, prog, nl);
              } else {
                if bkind == 0 {
                  body = body + "    (i64.const " +
                         env_str_len(env, bname).to_str() + ")\n";
                } else {
                  body = body + "    (local.get " +
                         env_str_len_slot(env, bname).to_str() + ")\n";
                }
              }
              body = body + "    (local.set " + l_slot.to_str() + ")\n";
              // bounds both ends against the base's len (lo first,
              // then hi — each rides $t for the check)
              let mut blen: string = "";
              if bkind == 0 {
                blen = "(i64.const " +
                       env_str_len(env, bname).to_str() + ")";
              } else {
                blen = "(local.get " +
                       env_str_len_slot(env, bname).to_str() + ")";
              }
              body = body + "    (local.set $t (local.get " +
                     a_slot.to_str() + "))\n";
              body = body + oob_check_at(pool, blen, false);
              body = body + "    (local.set $t (local.get " +
                     l_slot.to_str() + "))\n";
              body = body + oob_check_at(pool, blen, false);
              // len' = hi - lo
              body = body + "    (i64.sub (local.get " +
                     l_slot.to_str() + ") (local.get " +
                     a_slot.to_str() + "))\n";
              body = body + "    (local.set " + l_slot.to_str() +
                     ")\n";
              // addr' = base + lo*esz
              if bkind == 0 {
                body = body + "    (i64.add (i64.const " +
                       env_str_look(env, bname).to_str() +
                       ") (i64.mul (local.get " + a_slot.to_str() +
                       ") (i64.const " + esz.to_str() + ")))\n";
              } else {
                let ba: i64 = env_str_look(env, bname);
                body = body + "    (i64.add (local.get " +
                       ((0 - ba) - 1).to_str() + ") (i64.mul " +
                       "(local.get " + a_slot.to_str() +
                       ") (i64.const " + esz.to_str() + ")))\n";
              }
              body = body + "    (local.set " + a_slot.to_str() +
                     ")\n";
              env_str_bind_runtime(env, st.name, a_slot, l_slot, kind);
              // the view carries the base's element text (element
              // reads and stores key on it)
              if bkind == 2 && len(bet) > 0 {
                env_bind_sliceelem(env, st.name, bet);
              }
            } else {
              match fold_string(e, env) {
                Option.Some(raw) => {
                  let saddr: i64 = pool_intern(pool, raw);
                  if st.ret == 1 {
                    // a MUT string let materializes its pair into
                    // slots (kind 1): a later rebind writes them in
                    // place, and readers after a never-entered loop
                    // still see the initializer — the folded binding
                    // would be clobbered by the rebind's fresh slots
                    let a1: i64 = nl.v;
                    nl.v = nl.v + 1;
                    let l1: i64 = nl.v;
                    nl.v = nl.v + 1;
                    body = body + "    (i64.const " + saddr.to_str() +
                           ")\n    (local.set " + a1.to_str() +
                           ")\n" +
                           "    (i64.const " +
                           pool_len(pool, raw).to_str() +
                           ")\n    (local.set " + l1.to_str() +
                           ")\n";
                    env_str_bind_runtime(env, st.name, a1, l1, 1);
                  } else {
                    env_str_bind(env, st.name, saddr,
                                 pool_len(pool, raw), raw);
                  }
                },
                Option.None => {
                  if e.tag == parse.EX_VAR &&
                      env_kind_of(env, e.name) >= 0 {
                    // a let over another string/slice name SHARES its
                    // binding — a slice copy is the same fat view, and
                    // a string copy the same live pair
                    env_str_bind_runtime(env, st.name,
                        (0 - env_str_look(env, e.name)) - 1,
                        env_str_len_slot(env, e.name),
                        env_kind_of(env, e.name));
                  } else {
                  if e.tag == parse.EX_ARR {
                    let aa: i64 = nl.v;
                    let al: i64 = nl.v + 1;
                    nl.v = nl.v + 2;
                    body = body + emit_array(pool, e, env, prog, nl);
                    body = body + "    (local.set " + al.to_str() +
                           ")\n" +
                           "    (local.set " + aa.to_str() + ")\n";
                    env_str_bind_runtime(env, st.name, aa, al, 2);
                    env_bind_sliceelem(env, st.name, "i64");
                  } else {
                  if len(st.fmt) > 0 &&
                      st_index(prog, st.fmt) >= 0 &&
                      len(struct_type_of(e, env, prog)) > 0 {
                    // a by-value struct binding (annotation naming a
                    // struct, init struct-typed — (*p), a call's
                    // returned box, a field chain, a slice element):
                    // the source's slots copy into a fresh local frame
                    // (shallow — pair fields copy their slots, so
                    // writes through the copy's slices alias the same
                    // storage)
                    let vsi: i64 = st_index(prog, st.fmt);
                    let vn: i64 = st_nslots(prog, vsi);
                    let vbase: i64 = nl.v;
                    nl.v = nl.v + vn;
                    let tsrc: i64 = nl.v;
                    nl.v = nl.v + 1;
                    body = body + struct_addr_of(pool, e, env, prog, nl);
                    body = body + "    (local.set " + tsrc.to_str() + ")\n";
                    let mut vj: i64 = 0;
                    while vj < vn {
                      body = body + "    (i64.load (i32.add (i32.wrap_i64 " +
                             "(local.get " + tsrc.to_str() +
                             ")) (i32.const " + (vj * 8).to_str() + ")))\n" +
                             "    (local.set " + (vbase + vj).to_str() +
                             ")\n";
                      vj = vj + 1;
                    }
                    env_bind_val(env, st.name, vbase, st.fmt);
                  } else {
                  // an enum-typed value (the annotation names an
                  // enum, or the init constructs one) binds the box
                  if st.fmt == "f64" || st.fmt == "f32" ||
                      expr_fkind(e, env, prog) > 0 {
                    let mut fk0: i64 = 1;
                    if st.fmt == "f32" {
                      fk0 = 2;
                    } else {
                      if expr_fkind(e, env, prog) == 2 {
                        fk0 = 2;
                      }
                    }
                    body = body + emit_expr(pool, e, env, prog, nl);
                    if expr_fkind(e, env, prog) == 0 {
                      if expr_width(e, env, prog) < 0 {
                        body = body + "    (i64.reinterpret_f64 " +
                               "(f64.convert_i64_u))\n";
                      } else {
                        body = body + "    (i64.reinterpret_f64 " +
                               "(f64.convert_i64_s))\n";
                      }
                    }
                    if fk0 == 2 {
                      body = body + "    (i64.reinterpret_f64 " +
                             "(f64.promote_f32 (f32.demote_f64 " +
                             "(f64.reinterpret_i64))))\n";
                    }
                    body = body + "    (local.set " + nl.v.to_str() +
                           ")\n";
                    env_bind_f(env, st.name, nl.v, fk0);
                    nl.v = nl.v + 1;
                  } else {
                  let mut es: string = norm_enum(st.fmt);
                  if len(es) == 0 || (en_index(prog, es) < 0 &&
                      es != "Option" && es != "Result") {
                    es = expr_enum_type(e, env, prog);
                  }
                  if len(es) > 0 && (en_index(prog, es) >= 0 ||
                      es == "Option" || es == "Result") {
                    body = body + emit_expr(pool, e, env, prog, nl);
                    body = body + "    (local.set " + nl.v.to_str() +
                           ")\n";
                    body = body + retain_if_shared(e, nl.v);
                    // the scope-exit release walks the box (an
                    // option's payload by its recorded text)
                    let mut relty: string = es;
                    if es == "Option" || es == "Result" {
                      let opay2: string = opt_payload(st.fmt);
                      if len(opay2) > 0 {
                        relty = "?" + opay2;
                      }
                    }
                    let rele: string = rel_callee(pool, prog, relty);
                    if len(rele) > 0 {
                      drel_push(dstack, st.name,
                                "    (local.get " +
                                nl.v.to_str() + ")\n" +
                                "    call " + rele + "\n");
                    }
                    env_bind_enum(env, st.name, nl.v, es);
                    // an Option binding records its payload text so
                    // Some binders keep the pointer lane
                    let opay: string = opt_payload(st.fmt);
                    if len(opay) > 0 {
                      env_bind_sliceelem(env, st.name, opay);
                    }
                    nl.v = nl.v + 1;
                  } else {
                  // a pair field read (b.xs, st.name) binds its live
                  // pair from the frame or the heap — resolved first so
                  // every other shape still reaches the lanes below
                  let mut fbase: *Expr = parse.lit(0);
                  let mut fki: i64 = 0 - 1;
                  let mut fsi: i64 = 0 - 1;
                  let mut ffi: i64 = 0 - 1;
                  if e.tag == parse.EX_FIELD {
                    match e.lhs {
                      Option.Some(fb) => {
                        fbase = fb;
                      },
                      Option.None => {},
                    }
                    let fbt: string = field_base_type(fbase, env, prog);
                    if len(fbt) > 0 {
                      fsi = st_index(prog, fbt);
                      ffi = st_field_index(prog, fsi, e.name);
                      if ffi >= 0 {
                        fki = type_kind(
                          prog.structs[fsi as usize].types[ffi as usize]);
                      }
                    }
                  }
                  if ffi >= 0 && (fki == 1 || fki == 2) {
                      let foff: i64 = st_field_off(prog, fsi, ffi);
                      let pa: i64 = nl.v;
                      let pl: i64 = nl.v + 1;
                      nl.v = nl.v + 2;
                      if fbase.tag == parse.EX_VAR &&
                          len(env_val_of(env, fbase.name)) > 0 {
                        let fb0: i64 = env_val_base(env, fbase.name);
                        body = body + "    (local.get " +
                               (fb0 + foff).to_str() + ")\n" +
                               "    (local.set " + pa.to_str() + ")\n" +
                               "    (local.get " +
                               (fb0 + foff + 1).to_str() + ")\n" +
                               "    (local.set " + pl.to_str() + ")\n";
                      } else {
                        let ft0: i64 = nl.v;
                        nl.v = nl.v + 1;
                        body = body + emit_expr(pool, fbase, env, prog, nl);
                        body = body + "    (local.set " + ft0.to_str() +
                               ")\n";
                        body = body + "    (i64.load (i32.add " +
                               "(i32.wrap_i64 (local.get " + ft0.to_str() +
                               ")) (i32.const " + (foff * 8).to_str() +
                               ")))\n";
                        body = body + "    (local.set " + pa.to_str() +
                               ")\n";
                        body = body + "    (i64.load (i32.add " +
                               "(i32.wrap_i64 (local.get " + ft0.to_str() +
                               ")) (i32.const " + (foff * 8 + 8).to_str() +
                               ")))\n";
                        body = body + "    (local.set " + pl.to_str() +
                               ")\n";
                      }
                      env_str_bind_runtime(env, st.name, pa, pl, fki);
                      if len(st.fmt) >= 2 && st.fmt[0] == 91 &&
                          st.fmt[1] == 93 {
                        env_bind_sliceelem(env, st.name,
                                           st.fmt[2..len(st.fmt)]);
                      }
                    } else {
                  // a pointer-typed init binds as a *T (the written
                  // annotation wins, else the init's own type)
                  let mut ps: string = type_ptr_target(st.fmt);
                  if len(ps) == 0 {
                    ps = expr_ptr_type(e, env, prog);
                  }
                  if len(ps) > 0 && st_index(prog, ps) >= 0 {
                    body = body + emit_expr(pool, e, env, prog, nl);
                    body = body + "    (local.set " + nl.v.to_str() +
                           ")\n";
                    body = body + retain_if_shared(e, nl.v);
                    let relp: string = rel_callee(pool, prog,
                                                  "*" + ps);
                    if len(relp) > 0 {
                      drel_push(dstack, st.name,
                                "    (local.get " +
                                nl.v.to_str() + ")\n" +
                                "    call " + relp + "\n");
                    }
                    env_bind_ptr(env, st.name, nl.v, ps);
                    nl.v = nl.v + 1;
                  } else {
                  // a runtime string build (concat over vars/slices,
                  // a string-returning call) lands as a live pair
                  let sp = build_string_pair(e, pool, env, prog,
                                             nl);
                  if sp.ok {
                    body = body + sp.text;
                    env_str_bind_runtime(env, st.name, sp.a, sp.l, 1);
                  } else {
                    body = body + emit_expr(pool, e, env, prog, nl);
                    body = body + wrap_snippet(type_width(st.fmt));
                    body = body + "    (local.set " +
                           nl.v.to_str() + ")\n";
                    env_bind_w(env, st.name, nl.v,
                               type_width(st.fmt));
                    if st.fmt == "bool" ||
                       (e.tag == parse.EX_BIN &&
                        ((e.op >= 5 && e.op <= 10) || e.op == 12 ||
                         e.op == 13 || e.op == 14)) ||
                       (e.tag == parse.EX_LIT &&
                        (e.name == "true" || e.name == "false")) {
                      env_bool_bind(env, st.name);
                    }
                    nl.v = nl.v + 1;
                  }
                  }
                  }
                  }
                  }
                  }
                  }
                  }
                },
              }
            }
          }
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_ISTORE {
      let a: i64 = env_str_look(env, st.name);
      if a < 0 {
        let addr_slot: i64 = (0 - a) - 1;
        let len_slot: i64 = env_str_len_slot(env, st.name);
        let mut idx: *Expr = parse.lit(0);
        if len(st.args) > 0 {
          idx = st.args[0];
        }
        body = body + emit_expr(pool, idx, env, prog, nl);
        body = body + "    (local.set $t)\n";
        body = body + oob_check(pool, "(local.get " + len_slot.to_str() +
                               ")");
        if env_slice_elemtext(env, st.name) == "string" {
          // a string element writes its pair at a 16-byte stride
          match st.val {
            Option.Some(sv) => {
              let spsv = build_string_pair(sv, pool, env, prog, nl);
              if spsv.ok {
                body = body + spsv.text +
                       "    (i64.store (i32.add (i32.wrap_i64 " +
                       "(local.get " + addr_slot.to_str() +
                       ")) (i32.mul (i32.wrap_i64 (local.get $t)) " +
                       "(i32.const 16))) (local.get " +
                       spsv.a.to_str() + "))\n" +
                       "    (i64.store (i32.add (i32.add " +
                       "(i32.wrap_i64 (local.get " +
                       addr_slot.to_str() + ")) (i32.mul " +
                       "(i32.wrap_i64 (local.get $t)) (i32.const 16))) " +
                       "(i32.const 8)) (local.get " +
                       spsv.l.to_str() + "))\n";
              }
            },
            Option.None => {},
          }
        } else {
        let stelem2: i64 = st_index(prog,
                                    env_slice_elemtext(env, st.name));
        if is_dyn_type(env_slice_elemtext(env, st.name)) {
          // a dyn element: the fat pair stores at the 16-byte
          // stride; the new obj retains, the old element's obj
          // releases through ITS vtable's release slot
          let dtr5: string =
              dyn_trait(env_slice_elemtext(env, st.name));
          let dnm5: i64 = trait_method_count(prog, dtr5);
          let mut e5: *Expr = parse.lit(0);
          match st.val {
            Option.Some(ev5) => {
              e5 = ev5;
            },
            Option.None => {},
          }
          let objt5: string = expr_ptr_type(e5, env, prog);
          let vt5: string = dyn_vtable(pool, prog, dtr5, objt5);
          if len(vt5) > 0 {
            let vb5: i64 = nl.v;
            let ob5: i64 = nl.v + 1;
            nl.v = nl.v + 2;
            body = body + "    (i32.add (i32.wrap_i64 (local.get " +
                   addr_slot.to_str() + ")) (i32.mul (i32.wrap_i64 " +
                   "(local.get $t)) (i32.const 16)))\n" +
                   "    (local.set $a)\n";
            body = body + vt5;
            body = body + "    (local.set " + vb5.to_str() + ")\n";
            body = body + emit_expr(pool, e5, env, prog, nl);
            body = body + "    (local.set " + ob5.to_str() + ")\n";
            body = body + retain_if_shared(e5, ob5);
            // the old element's obj releases through ITS vtable's
            // release slot — guarded: a fresh zeroed element carries
            // no vtable (a null obj must not dispatch)
            let oe5: i64 = nl.v;
            nl.v = nl.v + 1;
            body = body + "    (i64.load (i32.add (local.get $a)" +
                   " (i32.const 8)))\n" +
                   "    (local.set " + oe5.to_str() + ")\n" +
                   "    (if (i64.ne (local.get " + oe5.to_str() +
                   ") (i64.const 0))\n" +
                   "      (then\n" +
                   "    (local.get " + oe5.to_str() + ")\n" +
                   "    (i64.load (i32.add\n" +
                   "      (i32.wrap_i64 (i64.load (i32.add " +
                   "(local.get $a) (i32.const 0))))\n" +
                   "      (i32.const " + (dnm5 * 8).to_str() +
                   ")))\n" +
                   "    (i32.wrap_i64)\n" +
                   "    call_indirect (type $clv1)\n" +
                   "      ))\n";
            body = body + "    (i64.store (local.get $a) " +
                   "(local.get " + vb5.to_str() + "))\n" +
                   "    (i64.store (i32.add (local.get $a) " +
                   "(i32.const 8)) (local.get " + ob5.to_str() +
                   "))\n";
          }
        } else {
        if stelem2 >= 0 {
          // a struct element: the whole slot block copies from the
          // value's address (a frame-resident chain materializes a
          // box first — struct_addr_of)
          let ssn: i64 = st_nslots(prog, stelem2);
          body = body + "    (i32.add (i32.wrap_i64 (local.get " +
                 addr_slot.to_str() + ")) (i32.mul (i32.wrap_i64 " +
                 "(local.get $t)) (i32.const " + (ssn * 8).to_str() +
                 ")))\n";
          body = body + "    (local.set $a)\n";
          match st.val {
            Option.Some(e13) => {
              body = body + struct_addr_of(pool, e13, env, prog, nl);
            },
            Option.None => {},
          }
          body = body + "    (local.set $t)\n";
          let mut sj: i64 = 0;
          while sj < ssn {
            body = body + "    (i64.load (i32.add (i32.wrap_i64 " +
                   "(local.get $t)) (i32.const " + (sj * 8).to_str() +
                   ")))\n" +
                   "    (local.set $r)\n" +
                   "    (i64.store (i32.add (local.get $a) (i32.const " +
                   (sj * 8).to_str() + ")) (local.get $r))\n";
            sj = sj + 1;
          }
        } else {
        let iety: string = env_slice_elemtext(env, st.name);
        let irel: string = rel_callee(pool, prog, iety);
        let mut ivr: *Expr = parse.lit(0);
        match st.val {
          Option.Some(e16) => {
            ivr = e16;
          },
          Option.None => {},
        }
        if len(irel) > 0 {
          // a managed element: the new value retains first, the old
          // element releases, the store lands last
          body = body + "    (i32.add (i32.wrap_i64 (local.get " +
                 addr_slot.to_str() + "))\n" +
                 "                     (i32.mul (i32.wrap_i64 " +
                 "(local.get $t)) (i32.const 8)))\n";
          body = body + "    (local.set $a)\n";
          match st.val {
            Option.Some(e) => {
              body = body + emit_expr(pool, e, env, prog, nl);
            },
            Option.None => {},
          }
          body = body + "    (local.set $t)\n";
          body = body + retain_t(ivr);
          body = body + "    (i64.load (local.get $a))\n";
          body = body + "    call " + irel + "\n";
          body = body + "    (i64.store (local.get $a) (local.get $t))\n";
        } else {
        body = body + "    (i32.add (i32.wrap_i64 (local.get " +
               addr_slot.to_str() + "))\n" +
               "                     (i32.mul (i32.wrap_i64 " +
               "(local.get $t)) (i32.const 8)))\n";
        body = body + "    (local.set $a)\n";
        match st.val {
          Option.Some(e) => {
            body = body + emit_expr(pool, e, env, prog, nl);
          },
          Option.None => {},
        }
        body = body + "    (local.set $t)\n";
        body = body + "    (i64.store (local.get $a) (local.get $t))\n";
        }
        }
        }
        }
      }
    }
    if st.tag == parse.ST_FSTORE {
      // base.f... = e — walk the field path to the slot, then store
      // (an indexed final field stores through the slice's pair)
      let vbt: string = env_val_of(env, st.name);
      if len(vbt) > 0 && len(st.path) > 0 {
        // a value base: the walk starts in the local frame and steps
        // onto the heap at the first pointer field
        let vsi: i64 = st_index(prog, vbt);
        if vsi >= 0 {
          let b0: i64 = env_val_base(env, st.name);
          let a_slot: i64 = nl.v;
          nl.v = nl.v + 1;
          let mut inframe: bool = true;
          let mut csi: i64 = vsi;
          let mut j: usize = 0;
          while j + 1 < len(st.path) {
            let fi: i64 = st_field_index(prog, csi, st.path[j]);
            if fi < 0 {
              break;
            }
            let off: i64 = st_field_off(prog, csi, fi) * 8;
            if inframe {
              body = body + "    (local.get " +
                     (b0 + off / 8).to_str() + ")\n" +
                     "    (local.set " + a_slot.to_str() + ")\n";
              inframe = false;
            } else {
              body = body + "    (i32.add (i32.wrap_i64 (local.get " +
                     a_slot.to_str() + ")) (i32.const " + off.to_str() +
                     "))\n";
              body = body + "    (i64.load)\n    (local.set " +
                     a_slot.to_str() + ")\n";
            }
            csi = st_index(prog, type_ptr_target(
                   prog.structs[csi as usize].types[fi as usize]));
            j = j + 1;
          }
          let fi: i64 = st_field_index(prog, csi, st.path[j]);
          if fi >= 0 {
            let fty: string = prog.structs[csi as usize].types[fi as usize];
            let foff: i64 = st_field_off(prog, csi, fi);
            if inframe && len(st.args) == 0 {
              // a direct frame write
              match st.val {
                Option.Some(e) => {
                  body = body + emit_expr(pool, e, env, prog, nl);
                  body = body + wrap_snippet(type_width(fty));
                },
                Option.None => {},
              }
              body = body + "    (local.set " + (b0 + foff).to_str() +
                     ")\n";
            } else {
              if inframe {
                // indexed through a frame pair
                let idx0: *Expr = st.args[0];
                body = body + emit_expr(pool, idx0, env, prog, nl);
                body = body + "    (local.set $t)\n";
                body = body + oob_check(pool, "(local.get " +
                       (b0 + foff + 1).to_str() + ")");
                body = body + "    (i32.add (i32.wrap_i64 (local.get " +
                       (b0 + foff).to_str() + "))\n" +
                       "                     (i32.mul (i32.wrap_i64 " +
                       "(local.get $t)) (i32.const 8)))\n";
                body = body + "    (local.set $a)\n";
              } else {
                let off: i64 = foff * 8;
                if len(st.args) > 0 {
                  // indexed through a heap pair
                  let idx0: *Expr = st.args[0];
                  body = body + emit_expr(pool, idx0, env, prog, nl);
                  body = body + "    (local.set $t)\n";
                  body = body + "    (i64.load (i32.add (i32.wrap_i64 " +
                         "(local.get " + a_slot.to_str() + ")) (i32.const " +
                         (off + 8).to_str() + ")))\n";
                  body = body + "    (local.set $r)\n";
                  body = body + oob_check(pool, "(local.get $r)");
                  body = body + "    (i64.load (i32.add (i32.wrap_i64 " +
                         "(local.get " + a_slot.to_str() + ")) (i32.const " +
                         off.to_str() + ")))\n";
                  body = body + "    (i32.add (i32.wrap_i64) (i32.mul " +
                         "(i32.wrap_i64 (local.get $t)) (i32.const 8)))\n";
                  body = body + "    (local.set $a)\n";
                } else {
                  body = body + "    (i32.add (i32.wrap_i64 (local.get " +
                         a_slot.to_str() + ")) (i32.const " + off.to_str() +
                         "))\n";
                  body = body + "    (local.set $a)\n";
                }
              }
              match st.val {
                Option.Some(e) => {
                  body = body + emit_expr(pool, e, env, prog, nl);
                  body = body + wrap_snippet(type_width(fty));
                },
                Option.None => {},
              }
              body = body + "    (local.set $t)\n";
              let frel: string = rel_callee(pool, prog, fty);
              if len(frel) > 0 {
                // the field's rc law: the new value retains first,
                // the old field value releases, the store lands last
                match st.val {
                  Option.Some(e17) => {
                    body = body + retain_t(e17);
                  },
                  Option.None => {},
                }
                body = body + "    (i64.load (local.get $a))\n";
                body = body + "    call " + frel + "\n";
              }
              body = body + "    (i64.store (local.get $a) (local.get $t))\n";
            }
          }
        }
      } else {
      let bt: string = env_ptr_of(env, st.name);
      if len(bt) > 0 {
        let mut si: i64 = st_index(prog, bt);
        if si >= 0 && len(st.path) > 0 {
          let a_slot: i64 = nl.v;
          nl.v = nl.v + 1;
          body = body + "    (local.get " + env_look(env, st.name).to_str() +
                 ")\n";
          body = body + "    (local.set " + a_slot.to_str() + ")\n";
          let mut j: usize = 0;
          // every intermediate field is itself a pointer: load it
          while j + 1 < len(st.path) {
            let fi: i64 = st_field_index(prog, si, st.path[j]);
            if fi < 0 {
              break;
            }
            let off: i64 = st_field_off(prog, si, fi) * 8;
            body = body + "    (i32.add (i32.wrap_i64 (local.get " +
                   a_slot.to_str() + ")) (i32.const " + off.to_str() +
                   "))\n";
            body = body + "    (i64.load)\n    (local.set " +
                   a_slot.to_str() + ")\n";
            si = st_index(prog, type_ptr_target(
                   prog.structs[si as usize].types[fi as usize]));
            j = j + 1;
          }
          let fi: i64 = st_field_index(prog, si, st.path[j]);
          if fi >= 0 {
            let fty: string = prog.structs[si as usize].types[fi as usize];
            let off: i64 = st_field_off(prog, si, fi) * 8;
            if len(st.args) > 0 {
              // base.f[i] = e: the field is a slice — load its pair,
              // park the len in $r, bounds-check $t against it, then
              // store the element at base.f.addr + i*8
              let idx: *Expr = st.args[0];
              body = body + emit_expr(pool, idx, env, prog, nl);
              body = body + "    (local.set $t)\n";
              body = body + "    (i64.load (i32.add (i32.wrap_i64 " +
                     "(local.get " + a_slot.to_str() + ")) (i32.const " +
                     (off + 8).to_str() + ")))\n";
              body = body + "    (local.set $r)\n";
              body = body + oob_check(pool, "(local.get $r)");
              body = body + "    (i64.load (i32.add (i32.wrap_i64 " +
                     "(local.get " + a_slot.to_str() + ")) (i32.const " +
                     off.to_str() + ")))\n";
              body = body + "    (i32.add (i32.wrap_i64) (i32.mul " +
                     "(i32.wrap_i64 (local.get $t)) (i32.const 8)))\n";
              body = body + "    (local.set $a)\n";
              match st.val {
                Option.Some(e) => {
                  body = body + emit_expr(pool, e, env, prog, nl);
                },
                Option.None => {},
              }
              body = body + "    (local.set $t)\n";
              body = body + "    (i64.store (local.get $a) (local.get $t))\n";
            } else {
              body = body + "    (i32.add (i32.wrap_i64 (local.get " +
                     a_slot.to_str() + ")) (i32.const " + off.to_str() +
                     "))\n";
              body = body + "    (local.set $a)\n";
              if type_kind(fty) == 2 || fty == "string" {
                // a pair field stores BOTH words: the rhs's own pair
                // (a binding's slots, or a built pair) copies in
                let mut rhv: *Expr = parse.lit(0);
                match st.val {
                  Option.Some(e18) => {
                    rhv = e18;
                  },
                  Option.None => {},
                }
                let rha: i64 = 0 - 1;
                let rhl: i64 = 0 - 1;
                if rhv.tag == parse.EX_VAR &&
                    env_kind_of(env, rhv.name) >= 0 {
                  let ra0: i64 = env_str_look(env, rhv.name);
                  let ral: i64 = env_str_len_slot(env, rhv.name);
                  if ra0 < 0 {
                    body = body + "    (local.get " +
                           ((0 - ra0) - 1).to_str() +
                           ")\n    (local.set $t)\n" +
                           "    (local.get " + ral.to_str() +
                           ")\n    (local.set $r)\n";
                    body = body + "    (i64.store (local.get $a)" +
                           " (local.get $t))\n" +
                           "    (i64.store (i32.add (local.get $a)" +
                           " (i32.const 8)) (local.get $r))\n";
                  } else {
                    body = body + "    (i64.const " + ra0.to_str() +
                           ")\n    (local.set $t)\n" +
                           "    (i64.const " + ral.to_str() +
                           ")\n    (local.set $r)\n";
                    body = body + "    (i64.store (local.get $a)" +
                           " (local.get $t))\n" +
                           "    (i64.store (i32.add (local.get $a)" +
                           " (i32.const 8)) (local.get $r))\n";
                  }
                } else {
                  match st.val {
                    Option.Some(e19) => {
                      body = body + emit_expr(pool, e19, env,
