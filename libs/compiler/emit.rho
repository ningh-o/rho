// emit.rho — the self-hosted compiler's wasm emitter (T2.2 growth).
// Statements: printf pieces ride a string pool, integer expressions
// compile to i64 stack code into _start locals (let bindings get one
// local each), and the generated module carries the decimal runtime.
use parse;

pub struct Pool {
  segs: []string, // raw spans (escapes still encoded)
  lens: []i64,    // decoded byte lengths
  addrs: []i64,
  n: usize,
  next: i64,
}

pub fn new_pool() -> *Pool {
  return new Pool { segs: make([]string, 64), lens: make([]i64, 64),
                    addrs: make([]i64, 64), n: 0, next: 1024 };
}

// a hex digit's value, -1 when not hex
fn hex_val(b: u8) -> i64 {
  if b >= 48 && b <= 57 {
    return (b as i64) - 48;
  }
  if b >= 97 && b <= 102 {
    return (b as i64) - 87;
  }
  if b >= 65 && b <= 70 {
    return (b as i64) - 55;
  }
  return 0 - 1;
}

// the utf-8 byte length of a code point
fn utf8_len(cp: i64) -> i64 {
  if cp < 128 {
    return 1;
  }
  if cp < 2048 {
    return 2;
  }
  if cp < 65536 {
    return 3;
  }
  return 4;
}

// decoded byte count of a raw span (the full escape law: \n \r \t
// \\ \" \0 \xHH \u{…})
fn decoded_len(raw: string) -> i64 {
  let mut n: i64 = 0;
  let mut i: usize = 0;
  while i < len(raw) {
    if raw[i] == 92 && i + 1 < len(raw) {
      let e: u8 = raw[i + 1];
      if e == 120 && i + 3 < len(raw) {
        i = i + 4; // \xHH
      } else {
        if e == 117 {
          // \u{hex…}
          let mut j: usize = i + 3;
          let mut cp: i64 = 0;
          while j < len(raw) && raw[j] != 125 {
            let h: i64 = hex_val(raw[j]);
            if h < 0 {
              break;
            }
            cp = cp * 16 + h;
            j = j + 1;
          }
          n = n + utf8_len(cp) - 1;
          i = j + 1;
          n = n + 1;
          continue;
        } else {
          i = i + 2;
        }
      }
    } else {
      i = i + 1;
    }
    n = n + 1;
  }
  return n;
}

pub fn pool_intern(p: *Pool, raw: string) -> i64 {
  let mut i: usize = 0;
  while i < p.n {
    if p.segs[i] == raw {
      return p.addrs[i];
    }
    i = i + 1;
  }
  p.segs[p.n] = raw;
  p.lens[p.n] = decoded_len(raw);
  p.addrs[p.n] = p.next;
  p.n = p.n + 1;
  p.next = p.next + p.lens[p.n - 1] + 1;
  return p.addrs[p.n - 1];
}

pub fn pool_len(p: *Pool, raw: string) -> i64 {
  let mut i: usize = 0;
  while i < p.n {
    if p.segs[i] == raw {
      return p.lens[i];
    }
    i = i + 1;
  }
  return 0;
}

// the WAT data-segment body for a raw span: escapes decoded, every
// byte spelled \xx (wasm data escapes)
fn hex_digit(v: u8) -> string {
  let s: string = "0123456789abcdef";
  return s[(v as usize)..((v as usize) + 1)];
}

fn byte_escape(b: u8) -> string {
  return "\\" + hex_digit(b >> 4) + hex_digit(b & 15);
}

// one code point's utf-8 bytes as \\xx escapes
fn utf8_escape(cp: i64) -> string {
  let out: string = "";
  if cp < 128 {
    return byte_escape((cp as u8));
  }
  if cp < 2048 {
    return byte_escape(((((cp >> 6) as u64) as u8)) | 192) +
           byte_escape(((cp & 63) as u8) | 128);
  }
  if cp < 65536 {
    return byte_escape(((cp >> 12) as u8) | 224) +
           byte_escape((((cp >> 6) & 63) as u8) | 128) +
           byte_escape(((cp & 63) as u8) | 128);
  }
  return byte_escape(((cp >> 18) as u8) | 240) +
         byte_escape((((cp >> 12) & 63) as u8) | 128) +
         byte_escape((((cp >> 6) & 63) as u8) | 128) +
         byte_escape(((cp & 63) as u8) | 128);
}

pub fn wat_data_body(raw: string) -> string {
  let mut out: string = "";
  let mut i: usize = 0;
  while i < len(raw) {
    let b: u8 = raw[i];
    if b == 92 && i + 1 < len(raw) {
      let e: u8 = raw[i + 1];
      if e == 114 {
        out = out + byte_escape(13); // \r
        i = i + 2;
        continue;
      }
      if e == 48 {
        out = out + byte_escape(0); // \0
        i = i + 2;
        continue;
      }
      if e == 120 && i + 3 < len(raw) {
        let hi: i64 = hex_val(raw[i + 2]);
        let lo: i64 = hex_val(raw[i + 3]);
        let v: i64 = hi * 16 + lo;
        out = out + byte_escape((v as u8)); // \xHH
        i = i + 4;
        continue;
      }
      if e == 117 {
        let mut j: usize = i + 3;
        let mut cp: i64 = 0;
        while j < len(raw) && raw[j] != 125 {
          let h: i64 = hex_val(raw[j]);
          if h < 0 {
            break;
          }
          cp = cp * 16 + h;
          j = j + 1;
        }
        out = out + utf8_escape(cp); // \u{…}
        i = j + 1;
        continue;
      }
      let v: u8 = match e {
        110 => 10,
        116 => 9,
        92 => 92,
        34 => 34,
        _ => e,
      };
      out = out + byte_escape(v);
      i = i + 2;
      continue;
    }
    out = out + byte_escape(b);
    i = i + 1;
  }
  return out;
}

// the decimal runtime the generated module carries: $w_i64 writes
// |v|'s digits backward into [2048, 4096) and returns {addr, len}
const BOOLTEXT: string = """
  (func $w_bool (param $v i64) (result i32) (result i32)
    (if (result i32) (i64.ne (local.get $v) (i64.const 0))
      (then (i32.const 4030))
      (else (i32.const 4034)))
    (if (result i32) (i64.ne (local.get $v) (i64.const 0))
      (then (i32.const 4))
      (else (i32.const 5)))
  )
""";

const STREQ: string = """
  (func $w_streq (param $ap i64) (param $al i64) (param $bp i64) (param $bl i64) (result i64)
    (local $i i64)
    (if (i64.ne (local.get $al) (local.get $bl))
      (then (return (i64.const 0))))
    (loop $c
      (if (i64.ge_u (local.get $i) (local.get $al))
        (then (return (i64.const 1))))
      (if (i32.ne (i32.load8_u (i32.wrap_i64 (i64.add (local.get $ap) (local.get $i))))
                (i32.load8_u (i32.wrap_i64 (i64.add (local.get $bp) (local.get $i)))))
        (then (return (i64.const 0))))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br $c)
    )
    (i64.const 1)
  )
""";

const RUNTIME: string = """
  (global $w_top (mut i32) (i32.const 4096))
  (func $w_i64 (param $v i64) (result i32) (result i32)
    (local $p i32) (local $neg i32) (local $u i64)
    (local.set $p (i32.const 4096))
    (local.set $neg (i64.lt_s (local.get $v) (i64.const 0)))
    (local.set $u
      (if (result i64) (local.get $neg)
        (then (i64.sub (i64.const 0) (local.get $v)))
        (else (local.get $v))))
    (loop $d
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p)
        (i32.wrap_i64 (i64.add (i64.rem_u (local.get $u)
                             (i64.const 10)) (i64.const 48))))
      (local.set $u (i64.div_u (local.get $u) (i64.const 10)))
      (br_if $d (i64.ne (local.get $u) (i64.const 0)))
    )
    (if (local.get $neg)
      (then (local.set $p (i32.sub (local.get $p) (i32.const 1)))
            (i32.store8 (local.get $p) (i32.const 45))))
    (local.get $p)
    (i32.sub (global.get $w_top) (local.get $p))
  )
""";

// the zeroed bump allocator and the panic exit (allocations grow
// down from 65528; the digit scratch owns [~4076, 4096) and the
// string pool grows up from 1024 — corpus scale never crosses)
const ALLOC: string = """
  (global $w_alloc_top (mut i32) (i32.const 65528))
  (func $w_alloc (param $n i32) (result i32)
    (local $p i32) (local $k i32)
    (global.set $w_alloc_top
      (i32.sub (global.get $w_alloc_top)
               (i32.mul (local.get $n) (i32.const 8))))
    (local.set $p (global.get $w_alloc_top))
    (local.set $k (i32.const 0))
    (loop $z
      (if (i32.lt_u (local.get $k) (local.get $n))
        (then
          (i64.store
            (i32.add (local.get $p)
                     (i32.mul (local.get $k) (i32.const 8)))
            (i64.const 0))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $z))))
    (local.get $p)
  )
  (func $w_panic (param $m i32) (param $l i32)
    (i32.store (i32.const 64) (local.get $m))
    (i32.store (i32.const 68) (local.get $l))
    (drop (call $fd_write (i32.const 2) (i32.const 64)
                          (i32.const 1) (i32.const 96)))
    (call $proc_exit (i32.const 101))
  )
""";

// the OOB bounds check: the index rides $t, len_text is the length
// operand (a local.get or an i64.const). Indices are strict
// (i >= len panics); slice ends may equal len (an empty tail slice)
fn oob_check_at(pool: *Pool, len_text: string, strict: bool) -> string {
  let msg_addr: i64 = pool_intern(pool, "index out of bounds");
  let mut cmp: string = "i64.ge_u";
  if !strict {
    cmp = "i64.gt_u";
  }
  return "    (if (" + cmp + " (local.get $t) " + len_text + ")\n" +
         "      (then (call $w_panic (i32.const " + msg_addr.to_str() +
         ") (i32.const 19))))\n";
}

fn oob_check(pool: *Pool, len_text: string) -> string {
  return oob_check_at(pool, len_text, true);
}

// one fd_write of nbytes at addr: the iovec cell pair at 64/68
fn write_call(addr: i64, nbytes: i64) -> string {
  let out: string = "    (i32.store (i32.const 64) (i32.const " +
                    addr.to_str() + "))\n" +
                    "    (i32.store (i32.const 68) (i32.const " +
                    nbytes.to_str() + "))\n" +
                    "    (drop (call $fd_write (i32.const 1) " +
                    "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
  return out;
}

// a 0/1 i64 rides the stack: route it through $w_bool and write the
// spelled word (true/false) — the same capture pair write_int uses
fn write_bool_top() -> string {
  return "    call $w_bool\n" +
         "    (local.set $l)\n" +
         "    (local.set $a)\n" +
         "    (i32.store (i32.const 64) (local.get $a))\n" +
         "    (i32.store (i32.const 68) (local.get $l))\n" +
         "    (drop (call $fd_write (i32.const 1) " +
         "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
}

// one fd_write of a runtime-formatted integer: $w_i64 leaves
// {addr, len} on the stack; the locals capture the pair
fn write_int() -> string {
  // flat call: the expression's i64 rides the stack below it
  let out: string = "    call $w_i64\n" +
                    "    (local.set $l)\n" +
                    "    (local.set $a)\n" +
                    "    (i32.store (i32.const 64) (local.get $a))\n" +
                    "    (i32.store (i32.const 68) (local.get $l))\n" +
                    "    (drop (call $fd_write (i32.const 1) " +
                    "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
  return out;
}

// the let environment: names to _start local slots, plus a string
// table (immutable strings pool; a binding remembers addr and len)
struct Env {
  names: []string,
  slots: []i64,
  vwidths: []i64, // per local: 0 lane-wide, else ±8/±16/±32 (neg = unsigned)
  n: usize,
  snames: []string,
  saddrs: []i64,
  slens: []i64,
  sraws: []string,
  skinds: []i64, // 0 folded string, 1 runtime string pair, 2 slice pair
  sn: usize,
}

fn env_bool_bind(e: *Env, name: string) {
  e.snames[e.sn] = name + "#b";
  e.saddrs[e.sn] = 0 - 1000; // bool marker
  e.slens[e.sn] = 0;
  e.sraws[e.sn] = "";
  e.skinds[e.sn] = 0 - 1;
  e.sn = e.sn + 1;
}

fn env_bool_is(e: *Env, name: string) -> bool {
  let want: string = name + "#b";
  let mut i: usize = 0;
  while i < e.sn {
    if e.snames[i] == want {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn env_new(cap: usize) -> *Env {
  return new Env { names: make([]string, cap), slots: make([]i64, cap),
                   vwidths: make([]i64, cap),
                   n: 0, snames: make([]string, cap),
                   saddrs: make([]i64, cap), slens: make([]i64, cap),
                   sraws: make([]string, cap),
                   skinds: make([]i64, cap), sn: 0 };
}

fn env_str_look(e: *Env, name: string) -> i64 {
  let mut i: usize = 0;
  while i < e.sn {
    if e.snames[i] == name {
      return e.saddrs[i];
    }
    i = i + 1;
  }
  return 0 - 1;
}

// a runtime pair binding (a string or a slice): addr/len ride a
// LOCAL PAIR (slots are negative markers: the pair starts at
// -1 - addr); kind tells strings from slices at index time
fn env_str_bind_runtime(e: *Env, name: string, addr_slot: i64,
                        len_slot: i64, kind: i64) {
  e.snames[e.sn] = name;
  e.saddrs[e.sn] = (0 - addr_slot) - 1; // negative: runtime pair
  e.slens[e.sn] = len_slot;
  e.sraws[e.sn] = "";
  e.skinds[e.sn] = kind;
  e.sn = e.sn + 1;
}

fn env_str_is_runtime(e: *Env, name: string) -> bool {
  let mut i: usize = 0;
  while i < e.sn {
    if e.snames[i] == name {
      return e.saddrs[i] < 0; // negative marker = runtime pair
    }
    i = i + 1;
  }
  return false; // not a string at all
}

// one fd_write from a runtime {ptr, len} local pair
fn write_runtime(a_slot: i64, l_slot: i64) -> string {
  let out: string = "    (i32.store (i32.const 64) " +
                    "(i32.wrap_i64 (local.get " + a_slot.to_str() +
                    ")))\n" +
                    "    (i32.store (i32.const 68) " +
                    "(i32.wrap_i64 (local.get " + l_slot.to_str() +
                    ")))\n" +
                    "    (drop (call $fd_write (i32.const 1) " +
                    "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
  return out;
}

// push a string expression's {addr, len} pair onto the i64 stack:
// folded literals become constants; runtime vars local.get the pair
fn push_string(pool: *Pool, e: *Expr, env: *Env) -> string {
  match fold_string(e, env) {
    Option.Some(raw) => {
      let saddr: i64 = pool_intern(pool, raw);
      return "    (i64.const " + saddr.to_str() + ")\n" +
             "    (i64.const " + pool_len(pool, raw).to_str() + ")\n";
    },
    Option.None => {
      let a: i64 = env_str_look(env, e.name);
      if a < 0 {
        let lslot: i64 = env_str_len_slot(env, e.name);
        return "    (local.get " + ((0 - a) - 1).to_str() + ")\n" +
               "    (local.get " + lslot.to_str() + ")\n";
      }
      return "    (i64.const 0)\n    (i64.const 0)\n";
    },
  }
}

// one call argument: a string/slice-valued expression takes the
// {addr,len} pair; everything else is the plain i64 expression (an
// integer variable or an int + must NOT ride the pair path — the
// old router sent every variable and every + through push_string,
// and its not-found fallback spelled a bogus local.get 0 pair)
fn emit_arg(pool: *Pool, e: *Expr, env: *Env, prog: *Prog) -> string {
  if e.tag == parse.EX_STR {
    return push_string(pool, e, env);
  }
  if e.tag == parse.EX_VAR && env_kind_of(env, e.name) >= 0 {
    return push_string(pool, e, env);
  }
  if e.tag == parse.EX_BIN && e.op == 0 {
    match fold_string(e, env) {
      Option.Some(raw) => {
        let saddr: i64 = pool_intern(pool, raw);
        return "    (i64.const " + saddr.to_str() + ")\n" +
               "    (i64.const " + pool_len(pool, raw).to_str() + ")\n";
      },
      Option.None => {},
    }
  }
  return emit_expr(pool, e, env, prog);
}

fn env_str_len_slot(e: *Env, name: string) -> i64 {
  let mut i: usize = 0;
  while i < e.sn {
    if e.snames[i] == name {
      return e.slens[i];
    }
    i = i + 1;
  }
  return 0;
}

fn env_str_len(e: *Env, name: string) -> i64 {
  let mut i: usize = 0;
  while i < e.sn {
    if e.snames[i] == name {
      return e.slens[i];
    }
    i = i + 1;
  }
  return 0;
}

fn env_str_raw(e: *Env, name: string) -> ?string {
  let mut i: usize = 0;
  while i < e.sn {
    if e.snames[i] == name {
      if e.saddrs[i] < 0 {
        return Option.None; // runtime pair: no folded text exists
      }
      return Option.Some(e.sraws[i]);
    }
    i = i + 1;
  }
  return Option.None;
}

fn env_str_bind(e: *Env, name: string, addr: i64, ln: i64, raw: string) {
  e.snames[e.sn] = name;
  e.saddrs[e.sn] = addr;
  e.slens[e.sn] = ln;
  e.sraws[e.sn] = raw;
  e.skinds[e.sn] = 0;
  e.sn = e.sn + 1;
}

// the kind of a name's string-table entry, -1 when absent
fn env_kind_of(e: *Env, name: string) -> i64 {
  let mut i: usize = 0;
  while i < e.sn {
    if e.snames[i] == name {
      return e.skinds[i];
    }
    i = i + 1;
  }
  return 0 - 1;
}

// decoded text of a raw span (for folding literal concatenations)
fn decoded_text(raw: string) -> string {
  let buf: []u8 = make([]u8, len(raw));
  let mut o: usize = 0;
  let mut i: usize = 0;
  while i < len(raw) {
    if raw[i] == 92 && i + 1 < len(raw) {
      let e2: u8 = raw[i + 1];
      buf[o] = match e2 {
        110 => 10,
        116 => 9,
        92 => 92,
        34 => 34,
        _ => e2,
      };
      i = i + 2;
    } else {
      buf[o] = raw[i];
      i = i + 1;
    }
    o = o + 1;
  }
  // re-encode as a raw span (identities round-trip)
  return raw;
}

fn env_look(e: *Env, name: string) -> i64 {
  let mut i: usize = 0;
  while i < e.n {
    if e.names[i] == name {
      return e.slots[i];
    }
    i = i + 1;
  }
  return 0 - 1;
}

fn env_bind(e: *Env, name: string, slot: i64) {
  e.names[e.n] = name;
  e.slots[e.n] = slot;
  e.vwidths[e.n] = 0;
  e.n = e.n + 1;
}

fn env_bind_w(e: *Env, name: string, slot: i64, w: i64) {
  e.names[e.n] = name;
  e.slots[e.n] = slot;
  e.vwidths[e.n] = w;
  e.n = e.n + 1;
}

fn env_width_of(e: *Env, name: string) -> i64 {
  let mut i: usize = 0;
  while i < e.n {
    if e.names[i] == name {
      return e.vwidths[i];
    }
    i = i + 1;
  }
  return 0;
}

// the annotation's width code: ±8/±16/±32 (negative = unsigned),
// 0 = the full lane
fn type_width(tyname: string) -> i64 {
  if tyname == "i8" { return 8; }
  if tyname == "i16" { return 16; }
  if tyname == "i32" { return 32; }
  if tyname == "u8" { return 0 - 8; }
  if tyname == "u16" { return 0 - 16; }
  if tyname == "u32" { return 0 - 32; }
  return 0;
}

// wrap the stack's i64 to the width: two's complement makes
// wrap-after-op equal the width-native op on the sign-/zero-extended
// representation
fn wrap_snippet(w: i64) -> string {
  if w == 0 {
    return "";
  }
  let mut bits: i64 = w;
  if bits < 0 {
    bits = 0 - bits;
  }
  if bits >= 32 {
    if w < 0 {
      return "    (i32.wrap_i64)\n    (i64.extend_i32_u)\n";
    }
    return "    (i32.wrap_i64)\n    (i64.extend_i32_s)\n";
  }
  let sh: i64 = 32 - bits;
  let mask: i64 = (1 << bits) - 1;
  if w < 0 {
    return "    (i32.wrap_i64)\n    (i32.and (i32.const " +
           mask.to_str() + "))\n    (i64.extend_i32_u)\n";
  }
  return "    (i32.wrap_i64)\n    (i32.shl (i32.const " + sh.to_str() +
         "))\n    (i32.shr_s (i32.const " + sh.to_str() +
         "))\n    (i64.extend_i32_s)\n";
}

// a module-level name's global form, "" when absent
fn static_global(prog: *Prog, name: string) -> string {
  let mut i: usize = 0;
  while i < prog.nconsts {
    if prog.consts[i] == name && prog.cstatic[i] {
      return "$g_" + name;
    }
    i = i + 1;
  }
  return "";
}

fn const_value(prog: *Prog, name: string) -> i64 {
  let mut i: usize = 0;
  while i < prog.nconsts {
    if prog.consts[i] == name && !prog.cstatic[i] {
      return prog.cvals[i];
    }
    i = i + 1;
  }
  return 0;
}

fn name_is_const(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < prog.nconsts {
    if prog.consts[i] == name && !prog.cstatic[i] {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// the wat operator for an op code
fn wat_op(op: i64) -> string {
  if op == 0 {
    return "i64.add";
  }
  if op == 1 {
    return "i64.sub";
  }
  if op == 2 {
    return "i64.mul";
  }
  if op == 3 {
    return "i64.div_s";
  }
  if op == 4 {
    return "i64.rem_s";
  }
  if op == 5 {
    return "i64.lt_s";
  }
  if op == 6 {
    return "i64.gt_s";
  }
  if op == 7 {
    return "i64.le_s";
  }
  if op == 8 {
    return "i64.ge_s";
  }
  if op == 9 {
    return "i64.eq";
  }
  if op == 11 {
    return "i32.wrap_i64";
  }
  if op == 12 {
    return "i64.eq";
  }
  if op == 15 {
    return "i64.and";
  }
  if op == 16 {
    return "i64.or";
  }
  if op == 17 {
    return "i64.xor";
  }
  if op == 18 {
    return "i64.shl";
  }
  if op == 19 {
    return "i64.shr_s";
  }
  return "i64.ne";
}

// the raw text when an expr is a string literal, a string variable,
// or a + concatenation of those; absent otherwise
fn fold_string(e: *Expr, env: *Env) -> ?string {
  if e.tag == parse.EX_STR {
    return Option.Some(e.name);
  }
  if e.tag == parse.EX_VAR {
    return env_str_raw(env, e.name);
  }
  if e.tag == parse.EX_BIN && e.op == 0 {
    let mut lraw: string = "";
    let mut have: bool = false;
    match e.lhs {
      Option.Some(l) => {
        match fold_string(l, env) {
          Option.Some(ls) => {
            lraw = ls;
            have = true;
          },
          Option.None => {},
        }
      },
      Option.None => {},
    }
    if !have {
      return Option.None;
    }
    let mut rraw: string = "";
    match e.rhs {
      Option.Some(r) => {
        match fold_string(r, env) {
          Option.Some(rs) => {
            rraw = rs;
          },
          Option.None => {
            return Option.None;
          },
        }
      },
      Option.None => {
        return Option.None;
      },
    }
    return Option.Some(lraw + rraw);
  }
  return Option.None;
}

fn is_stringy(e: *Expr, env: *Env) -> bool {
  if e.tag == parse.EX_STR {
    return true;
  }
  if e.tag == parse.EX_VAR {
    return env_str_is_runtime(env, e.name) &&
           env_kind_of(env, e.name) == 1;
  }
  return false;
}

fn both_stringy(e: *Expr, env: *Env) -> bool {
  let mut l: bool = false;
  match e.lhs {
    Option.Some(x) => {
      l = is_stringy(x, env);
    },
    Option.None => {},
  }
  if !l {
    return false;
  }
  match e.rhs {
    Option.Some(y) => {
      return is_stringy(y, env);
    },
    Option.None => {
      return false;
    },
  }
}

// compile an expression: lines that leave one i64 on the stack
fn emit_expr(pool: *Pool, e: *Expr, env: *Env, prog: *Prog) -> string {
  if e.tag == parse.EX_LIT {
    return "    (i64.const " + e.lit.to_str() + ")\n";
  }
  if e.tag == parse.EX_VAR {
    let slot: i64 = env_look(env, e.name);
    if slot < 0 {
      if name_is_const(prog, e.name) {
        return "    (i64.const " + const_value(prog, e.name).to_str() +
               ")\n";
      }
      if len(static_global(prog, e.name)) > 0 {
        return "    (global.get " + static_global(prog, e.name) + ")\n";
      }
      return "    (i64.const 0)\n";
    }
    return "    (local.get " + slot.to_str() + ")\n";
  }
  if e.tag == parse.EX_CALL && e.name == "len" && len(e.args) == 1 {
    let a0 = e.args[0];
    if a0.tag == parse.EX_VAR && env_str_is_runtime(env, a0.name) {
      return "    (local.get " +
             env_str_len_slot(env, a0.name).to_str() + ")\n";
    }
    match fold_string(a0, env) {
      Option.Some(raw) => {
        return "    (i64.const " + decoded_len(raw).to_str() + ")\n";
      },
      Option.None => {},
    }
  }
  if e.tag == parse.EX_IDX {
    // base[i] — byte loads for strings, i64 loads for slices; the
    // index rides $t under a bounds check
    let mut out: string = "";
    let mut idx: *Expr = parse.lit(0);
    match e.rhs {
      Option.Some(i) => {
        idx = i;
      },
      Option.None => {},
    }
    out = out + emit_expr(pool, idx, env, prog);
    out = out + "    (local.set $t)\n";
    let mut base: *Expr = parse.lit(0);
    match e.lhs {
      Option.Some(b) => {
        base = b;
      },
      Option.None => {},
    }
    if base.tag == parse.EX_VAR {
      let a: i64 = env_str_look(env, base.name);
      if a < 0 {
        // runtime pair: slice or string
        let addr_slot: i64 = (0 - a) - 1;
        let len_slot: i64 = env_str_len_slot(env, base.name);
        out = out + oob_check(pool, "(local.get " + len_slot.to_str() +
                              ")");
        if env_kind_of(env, base.name) == 2 {
          out = out + "    (i64.load (i32.add (i32.wrap_i64 (local.get " +
                 addr_slot.to_str() + "))\n" +
                 "                     (i32.mul (i32.wrap_i64 " +
                 "(local.get $t)) (i32.const 8))))\n";
        } else {
          out = out + "    (i64.extend_i32_u (i32.load8_u " +
                 "(i32.add (i32.wrap_i64 (local.get " +
                 addr_slot.to_str() + "))\n" +
                 "                     (i32.wrap_i64 (local.get $t)))))\n";
        }
        return out;
      }
      if env_kind_of(env, base.name) == 0 {
        // a folded string: const addr, const len
        let ln: i64 = env_str_len(env, base.name);
        out = out + oob_check(pool, "(i64.const " + ln.to_str() + ")");
        out = out + "    (i64.extend_i32_u (i32.load8_u (i32.add " +
               "(i32.const " + a.to_str() + ")\n" +
               "                     (i32.wrap_i64 (local.get $t)))))\n";
        return out;
      }
    }
    if base.tag == parse.EX_STR {
      let saddr: i64 = pool_intern(pool, base.name);
      let ln: i64 = pool_len(pool, base.name);
      out = out + oob_check(pool, "(i64.const " + ln.to_str() + ")");
      out = out + "    (i64.extend_i32_u (i32.load8_u (i32.add " +
             "(i32.const " + saddr.to_str() + ")\n" +
             "                     (i32.wrap_i64 (local.get $t)))))\n";
      return out;
    }
    return "    (i64.const 0)\n";
  }
  if e.tag == parse.EX_CALL {
    let mut out: string = "";
    let mut k: usize = 0;
    while k < len(e.args) {
      out = out + emit_arg(pool, e.args[k], env, prog);
      k = k + 1;
    }
    out = out + "    call $u_" + e.name + "\n";
    return out;
  }
  // string equality routes through $w_streq over the pairs
  if (e.op == 9 || e.op == 10) && both_stringy(e, env) {
    let mut out: string = "";
    match e.lhs {
      Option.Some(l) => {
        out = out + push_string(pool, l, env);
      },
      Option.None => {},
    }
    match e.rhs {
      Option.Some(r) => {
        out = out + push_string(pool, r, env);
      },
      Option.None => {},
    }
    out = out + "    call $w_streq\n";
    if e.op == 10 {
      out = out + "    (i64.eqz)\n    (i64.extend_i32_s)\n";
    }
    return out;
  }
  // short-circuit && / ||: the lhs gates whether the rhs runs at all
  // (an if with an i64 result — both operators yield 0/1)
  if e.op == 13 || e.op == 14 {
    let mut out: string = "";
    match e.lhs {
      Option.Some(l) => {
        out = out + emit_expr(pool, l, env, prog);
      },
      Option.None => {},
    }
    out = out + "    (i32.wrap_i64)\n    if (result i64)\n";
    if e.op == 14 {
      out = out + "      (i64.const 1)\n    else\n";
    }
    match e.rhs {
      Option.Some(r) => {
        out = out + emit_expr(pool, r, env, prog);
      },
      Option.None => {},
    }
    if e.op == 13 {
      out = out + "    else\n      (i64.const 0)\n";
    }
    out = out + "    end\n";
    return out;
  }
  // binary: operand code, then the operator
  let mut out: string = "";
  if e.op == 12 {
    // '!expr' is unary: the inner value, eqz, extended back
    match e.rhs {
      Option.Some(r) => {
        out = out + emit_expr(pool, r, env, prog);
      },
      Option.None => {},
    }
    out = out + "    (i64.eqz)\n    (i64.extend_i32_s)\n";
    return out;
  }
  match e.lhs {
    Option.Some(l) => {
      out = out + emit_expr(pool, l, env, prog);
    },
    Option.None => {},
  }
  if e.op == 11 {
    // 'as i32': wrap for the truncation, extend back to the i64 lane
    out = out + "    i32.wrap_i64\n    i64.extend_i32_s\n";
    return out;
  }
  match e.rhs {
    Option.Some(r) => {
      out = out + emit_expr(pool, r, env, prog);
    },
    Option.None => {},
  }
  out = out + "    (" + wat_op(e.op) + ")\n";
  // comparisons yield i32 in wasm: extend back to the i64 lane
  if e.op >= 5 && e.op <= 10 {
    out = out + "    (i64.extend_i32_s)\n";
    return out;
  }
  // arithmetic/bitwise at a narrow operand's width wraps after the
  // op (either operand carries the width; literals adapt)
  let mut w: i64 = 0;
  match e.lhs {
    Option.Some(l) => {
      if l.tag == parse.EX_VAR {
        w = env_width_of(env, l.name);
      }
    },
    Option.None => {},
  }
  if w == 0 {
    match e.rhs {
      Option.Some(r) => {
        if r.tag == parse.EX_VAR {
          w = env_width_of(env, r.name);
        }
      },
      Option.None => {},
    }
  }
  if w != 0 && e.op != 11 && e.op != 12 {
    out = out + wrap_snippet(w);
  }
  return out;
}

// the defer context: one frame per open scope, texts collected as
// the walk meets them; exits run them innermost-first (LIFO)
struct DStack {
  texts: []string, // the flat pool
  starts: []usize, // frame boundaries
  n: usize,        // open frames
  cursor: usize,   // texts used
}

fn dstack_new() -> *DStack {
  return new DStack { texts: make([]string, 256), starts: make([]usize, 64),
                      n: 0, cursor: 0 };
}

fn dpush(d: *DStack) {
  d.starts[d.n] = d.cursor;
  d.n = d.n + 1;
}

// the scope's own texts, LIFO, then the frame closes
fn dpop_emit(d: *DStack) -> string {
  let mut out: string = "";
  if d.n == 0 {
    return out; // a return already unwound every frame
  }
  let base: usize = d.starts[d.n - 1];
  while d.cursor > base {
    d.cursor = d.cursor - 1;
    out = out + d.texts[d.cursor];
  }
  d.n = d.n - 1;
  return out;
}

// a return unwinds every open frame of the function, LIFO across all
fn dunwind_emit(d: *DStack) -> string {
  let mut out: string = "";
  while d.n > 0 {
    out = out + dpop_emit(d);
  }
  return out;
}

// the loop-label context: every loop gets unique wasm labels; the
// stack holds the enclosing loops so plain jumps hit the innermost
// and named jumps resolve to their labeled loop
struct Loops {
  names: []string,
  bks: []string,
  ws: []string,
  n: usize,
  next_id: i64,
}

fn loops_new() -> *Loops {
  return new Loops { names: make([]string, 32), bks: make([]string, 32),
                     ws: make([]string, 32), n: 0, next_id: 0 };
}

fn loops_push_with(l: *Loops, name: string, bk: string, w: string) {
  l.names[l.n] = name;
  l.bks[l.n] = bk;
  l.ws[l.n] = w;
  l.n = l.n + 1;
}

fn loops_pop(l: *Loops) {
  if l.n > 0 {
    l.n = l.n - 1;
  }
}

// the break (block) label for a jump: named resolves to the labeled
// loop, plain to the innermost
fn loops_break(l: *Loops, name: string) -> string {
  if len(name) == 0 {
    return l.bks[l.n - 1];
  }
  let mut i: usize = l.n;
  while i > 0 {
    if l.names[i - 1] == name {
      return l.bks[i - 1];
    }
    i = i - 1;
  }
  return "$b?";
}

fn loops_cont(l: *Loops, name: string) -> string {
  if len(name) == 0 {
    return l.ws[l.n - 1];
  }
  let mut i: usize = l.n;
  while i > 0 {
    if l.names[i - 1] == name {
      return l.ws[i - 1];
    }
    i = i - 1;
  }
  return "$w?";
}

fn emit_stmts(nodes: []*Stmt, pool: *Pool, env: *Env,
               next_local: *NextLocal, in_fn: bool, ret_slot: i64,
               prog: *Prog, loops: *Loops, dstack: *DStack,
               tfd: ?*FnDef) -> string {
  dpush(dstack);
  let mut body: string = "";
  let mut i: usize = 0;
  while i < len(nodes) {
    let st = nodes[i];
    if st.tag == parse.ST_RET && in_fn {
      // a fn's return: the value parks in $r while the open scopes'
      // defers unwind (LIFO), then rides home — unless the value is a
      // direct self tail call, which becomes the loop rewrite (args
      // land in the param slots, br re-enters the fn-top loop)
      let mut is_tail: bool = false;
      match tfd {
        Option.Some(fdef) => {
          match st.val {
            Option.Some(rv) => {
              if rv.tag == parse.EX_CALL && rv.name == fdef.name {
                is_tail = true;
              }
            },
            Option.None => {},
          }
        },
        Option.None => {},
      }
      if is_tail {
        match st.val {
          Option.Some(rv) => {
            let mut k: usize = 0;
            while k < len(rv.args) {
              body = body + emit_arg(pool, rv.args[k], env, prog);
              k = k + 1;
            }
            // pop into the param slots, last arg first (a pair param
            // takes two consecutive sets)
            match tfd {
              Option.Some(fdef) => {
                let mut j: usize = len(fdef.params);
                while j > 0 {
                  let q: i64 = (j as i64) - 1;
                  if j - 1 < len(fdef.pstr) && fdef.pstr[j - 1] {
                    body = body + "    (local.set " + (q + 1).to_str() +
                           ")\n";
                    body = body + "    (local.set " + q.to_str() + ")\n";
                  } else {
                    body = body + "    (local.set " + q.to_str() + ")\n";
                  }
                  j = j - 1;
                }
              },
              Option.None => {},
            }
            body = body + "    (br $t)\n";
          },
          Option.None => {},
        }
      } else {
        match st.val {
          Option.Some(rv) => {
            body = body + emit_expr(pool, rv, env, prog);
            body = body + "    (local.set $r)\n";
            body = body + dunwind_emit(dstack);
            body = body + "    (local.get $r)\n";
            body = body + "    return\n";
          },
          Option.None => {
            body = body + dunwind_emit(dstack);
            body = body + "    (i64.const 0)\n";
          },
        }
      }
    }
    if st.tag == parse.ST_RET && !in_fn {
      // main's return: the value lands in the exit slot (i32)
      match st.val {
        Option.Some(rv) => {
          body = body + emit_expr(pool, rv, env, prog);
          body = body + "    (i32.wrap_i64)\n";
          body = body + "    (local.set " + ret_slot.to_str() + ")\n";
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_PF {
      let pieces: []string = parse.fmt_pieces(st.fmt);
      let mut pi: usize = 0;
      let mut ai: usize = 0;
      while pi < len(pieces) {
        if len(pieces[pi]) > 0 {
          let addr: i64 = pool_intern(pool, pieces[pi]);
          body = body + write_call(addr, pool_len(pool, pieces[pi]));
        }
        if pi + 1 < len(pieces) {
          if ai < len(st.args) {
            let arg = st.args[ai];
            let mut folded: bool = false;
            if arg.tag == parse.EX_VAR &&
                env_str_is_runtime(env, arg.name) {
              let a: i64 = env_str_look(env, arg.name);
              body = body + write_runtime((0 - a) - 1,
                                          env_str_len_slot(env,
                                                           arg.name));
              folded = true;
            }
            if !folded && arg.tag == parse.EX_VAR &&
                env_bool_is(env, arg.name) {
              let bslot: i64 = env_look(env, arg.name);
              body = body + "    (local.get " + bslot.to_str() +
                     ")\n    call $w_bool\n" +
                     "    (local.set $l)\n    (local.set $a)\n" +
                     "    (i32.store (i32.const 64) (local.get $a))\n" +
                     "    (i32.store (i32.const 68) (local.get $l))\n" +
                     "    (drop (call $fd_write (i32.const 1) " +
                     "(i32.const 64) (i32.const 1) (i32.const 96)))\n";
              folded = true;
            }
            if !folded {
              match fold_string(arg, env) {
                Option.Some(raw) => {
                  let saddr: i64 = pool_intern(pool, raw);
                  body = body + write_call(saddr, pool_len(pool, raw));
                  folded = true;
                },
                Option.None => {},
              }
            }
            if !folded && arg.tag == parse.EX_BIN &&
                ((arg.op >= 5 && arg.op <= 10) || arg.op == 13 ||
                 arg.op == 14) && !both_stringy(arg, env) {
              // a comparison or logical in hole position prints as
              // true/false, not 0/1
              body = body + emit_expr(pool, arg, env, prog);
              body = body + write_bool_top();
              folded = true;
            }
            if !folded {
              body = body + emit_expr(pool, arg, env, prog);
              body = body + write_int();
            }
            ai = ai + 1;
          }
        }
        pi = pi + 1;
      }
    }
    if st.tag == parse.ST_LET {
      match st.val {
        Option.Some(e) => {
          if e.tag == parse.EX_MAKE {
            // make([]T, n): the count rides $t once, the allocation
            // and the len slot both read it
            let mut cnt: *Expr = parse.lit(0);
            if len(e.args) > 0 {
              cnt = e.args[0];
            }
            body = body + emit_expr(pool, cnt, env, prog);
            body = body + "    (local.set $t)\n";
            body = body + "    (i64.extend_i32_u (call $w_alloc " +
                   "(i32.wrap_i64 (local.get $t))))\n";
            body = body + "    (local.set " + next_local.v.to_str() +
                   ")\n";
            let a_slot: i64 = next_local.v;
            next_local.v = next_local.v + 1;
            body = body + "    (local.get $t)\n";
            body = body + "    (local.set " + next_local.v.to_str() +
                   ")\n";
            let l_slot: i64 = next_local.v;
            next_local.v = next_local.v + 1;
            env_str_bind_runtime(env, st.name, a_slot, l_slot, 2);
          } else {
            if e.tag == parse.EX_SLICE2 {
              // base[a..b]: a view — addr' = addr + lo*esz, len' =
              // hi-lo (writes alias the base storage, the fat view)
              let mut base: *Expr = parse.lit(0);
              match e.lhs {
                Option.Some(b) => {
                  base = b;
                },
                Option.None => {},
              }
              let bname: string = base.name;
              let kind: i64 = env_kind_of(env, bname);
              let mut esz: i64 = 8;
              if kind == 0 || kind == 1 {
                esz = 1;
              }
              let a_slot: i64 = next_local.v;
              next_local.v = next_local.v + 1;
              let l_slot: i64 = next_local.v;
              next_local.v = next_local.v + 1;
              // lo
              if e.op % 2 == 1 && len(e.args) > 0 {
                body = body + emit_expr(pool, e.args[0], env, prog);
              } else {
                body = body + "    (i64.const 0)\n";
              }
              body = body + "    (local.set " + a_slot.to_str() + ")\n";
              // hi: explicit or the base's len
              if (e.op / 2) % 2 == 1 && len(e.args) > 1 {
                body = body + emit_expr(pool, e.args[1], env, prog);
              } else {
                if kind == 0 {
                  body = body + "    (i64.const " +
                         env_str_len(env, bname).to_str() + ")\n";
                } else {
                  body = body + "    (local.get " +
                         env_str_len_slot(env, bname).to_str() + ")\n";
                }
              }
              body = body + "    (local.set " + l_slot.to_str() + ")\n";
              // bounds both ends against the base's len (lo first,
              // then hi — each rides $t for the check)
              let mut blen: string = "";
              if kind == 0 {
                blen = "(i64.const " +
                       env_str_len(env, bname).to_str() + ")";
              } else {
                blen = "(local.get " +
                       env_str_len_slot(env, bname).to_str() + ")";
              }
              body = body + "    (local.set $t (local.get " +
                     a_slot.to_str() + "))\n";
              body = body + oob_check_at(pool, blen, false);
              body = body + "    (local.set $t (local.get " +
                     l_slot.to_str() + "))\n";
              body = body + oob_check_at(pool, blen, false);
              // len' = hi - lo
              body = body + "    (i64.sub (local.get " +
                     l_slot.to_str() + ") (local.get " +
                     a_slot.to_str() + "))\n";
              body = body + "    (local.set " + l_slot.to_str() +
                     ")\n";
              // addr' = base + lo*esz
              if kind == 0 {
                body = body + "    (i64.add (i64.const " +
                       env_str_look(env, bname).to_str() +
                       ") (i64.mul (local.get " + a_slot.to_str() +
                       ") (i64.const " + esz.to_str() + ")))\n";
              } else {
                let ba: i64 = env_str_look(env, bname);
                body = body + "    (i64.add (local.get " +
                       ((0 - ba) - 1).to_str() + ") (i64.mul " +
                       "(local.get " + a_slot.to_str() +
                       ") (i64.const " + esz.to_str() + ")))\n";
              }
              body = body + "    (local.set " + a_slot.to_str() +
                     ")\n";
              env_str_bind_runtime(env, st.name, a_slot, l_slot, kind);
            } else {
              match fold_string(e, env) {
                Option.Some(raw) => {
                  let saddr: i64 = pool_intern(pool, raw);
                  env_str_bind(env, st.name, saddr,
                               pool_len(pool, raw), raw);
                },
                Option.None => {
                  let w: i64 = type_width(st.fmt);
                  body = body + emit_expr(pool, e, env, prog);
                  body = body + wrap_snippet(w);
                  body = body + "    (local.set " +
                         next_local.v.to_str() + ")\n";
                  env_bind_w(env, st.name, next_local.v, w);
                  if e.tag == parse.EX_BIN &&
                      ((e.op >= 5 && e.op <= 10) || e.op == 13 ||
                       e.op == 14) {
                    env_bool_bind(env, st.name);
                  }
                  next_local.v = next_local.v + 1;
                },
              }
            }
          }
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_ISTORE {
      let a: i64 = env_str_look(env, st.name);
      if a < 0 {
        let addr_slot: i64 = (0 - a) - 1;
        let len_slot: i64 = env_str_len_slot(env, st.name);
        let mut idx: *Expr = parse.lit(0);
        if len(st.args) > 0 {
          idx = st.args[0];
        }
        body = body + emit_expr(pool, idx, env, prog);
        body = body + "    (local.set $t)\n";
        body = body + oob_check(pool, "(local.get " + len_slot.to_str() +
                               ")");
        body = body + "    (i32.add (i32.wrap_i64 (local.get " +
               addr_slot.to_str() + "))\n" +
               "                     (i32.mul (i32.wrap_i64 " +
               "(local.get $t)) (i32.const 8)))\n";
        body = body + "    (local.set $a)\n";
        match st.val {
          Option.Some(e) => {
            body = body + emit_expr(pool, e, env, prog);
          },
          Option.None => {},
        }
        body = body + "    (local.set $t)\n";
        body = body + "    (i64.store (local.get $a) (local.get $t))\n";
      }
    }
    if st.tag == parse.ST_SET {
      let slot: i64 = env_look(env, st.name);
      match st.val {
        Option.Some(e) => {
          body = body + emit_expr(pool, e, env, prog);
          if slot >= 0 {
            body = body + wrap_snippet(env_width_of(env, st.name));
            body = body + "    (local.set " + slot.to_str() + ")\n";
          } else {
            let g: string = static_global(prog, st.name);
            if len(g) > 0 {
              body = body + "    (global.set " + g + ")\n";
            }
          }
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_CALL {
      match st.val {
        Option.Some(e) => {
          body = body + emit_expr(pool, e, env, prog);
          body = body + "    drop\n";
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_IF {
      match st.val {
        Option.Some(cond) => {
          // flat if: the condition's stack code precedes the keyword
          body = body + emit_expr(pool, cond, env, prog);
          body = body + "    (i32.wrap_i64)\n    if\n";
          body = body + emit_stmts(st.body, pool, env, next_local, in_fn, ret_slot, prog, loops, dstack, tfd);
          if len(st.body2) > 0 {
            body = body + "    else\n";
            body = body + emit_stmts(st.body2, pool, env, next_local,
 in_fn, ret_slot, prog, loops, dstack, tfd);
          }
          body = body + "    end\n";
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_DEFER {
      match st.sub {
        Option.Some(inner) => {
          let one: []*Stmt = make([]*Stmt, 1);
          one[0] = inner;
          dstack.texts[dstack.cursor] = emit_stmts(one, pool, env,
              next_local, in_fn, ret_slot, prog, loops, dstack, tfd);
          dstack.cursor = dstack.cursor + 1;
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_BREAK {
      // named resolves to the labeled loop, plain to the innermost
      body = body + "    (br " + loops_break(loops, st.name) + ")\n";
    }
    if st.tag == parse.ST_CONT {
      // re-enter at the target's head: a while re-checks its condition
      body = body + "    (br " + loops_cont(loops, st.name) + ")\n";
    }
    if st.tag == parse.ST_LOOP {
      let bk: string = "$b" + loops.next_id.to_str();
      let w: string = "$w" + loops.next_id.to_str();
      loops.next_id = loops.next_id + 1;
      loops_push_with(loops, st.name, bk, w);
      body = body + "    (block " + bk + "\n";
      body = body + "    (loop " + w + "\n";
      body = body + emit_stmts(st.body, pool, env, next_local, in_fn, ret_slot, prog, loops, dstack, tfd);
      body = body + "      (br " + w + ")\n";
      body = body + "    )\n";
      body = body + "    )\n";
      loops_pop(loops);
    }
    if st.tag == parse.ST_WHILE {
      match st.val {
        Option.Some(cond) => {
          let bk: string = "$b" + loops.next_id.to_str();
          let w: string = "$w" + loops.next_id.to_str();
          loops.next_id = loops.next_id + 1;
          loops_push_with(loops, st.name, bk, w);
          body = body + "    (block " + bk + "\n";
          body = body + "    (loop " + w + "\n";
          body = body + emit_expr(pool, cond, env, prog);
          body = body + "    (i32.wrap_i64)\n    if\n";
          body = body + emit_stmts(st.body, pool, env, next_local, in_fn, ret_slot, prog, loops, dstack, tfd);
          body = body + "      (br " + w + ")\n";
          body = body + "    end\n";
          body = body + "    )\n";
          body = body + "    )\n";
          loops_pop(loops);
        },
        Option.None => {},
      }
    }
    i = i + 1;
  }
  body = body + dpop_emit(dstack);
  return body;
}

// the next-local counter threads through the recursion
struct NextLocal {
  v: i64,
}

// one user fn: params as i64 locals, an i64 result
fn capture_at_after(fd: *FnDef) -> i64 {
  let mut n: i64 = 0;
  let mut k: usize = 0;
  while k < len(fd.params) {
    if k < len(fd.pstr) && fd.pstr[k] {
      n = n + 2;
    } else {
      n = n + 1;
    }
    k = k + 1;
  }
  return n;
}

fn emit_fn(fd: *FnDef, pool: *Pool, prog: *Prog) -> string {
  let env = env_new(64);
  let next_local = new NextLocal { v: 0 };
  let param_slots: i64 = capture_at_after(fd);
  let mut nparams: i64 = 0;
  let mut k0: usize = 0;
  while k0 < len(fd.params) {
    if k0 < len(fd.pstr) && fd.pstr[k0] {
      nparams = nparams + 2;
    } else {
      nparams = nparams + 1;
    }
    k0 = k0 + 1;
  }
  let mut k: usize = 0;
  while k < len(fd.params) {
    if k < len(fd.pstr) && fd.pstr[k] {
      let mut kind: i64 = 1;
      if k < len(fd.pslc) && fd.pslc[k] {
        kind = 2;
      }
      env_str_bind_runtime(env, fd.params[k], next_local.v,
                           next_local.v + 1, kind);
      next_local.v = next_local.v + 2;
    } else {
      env_bind(env, fd.params[k], next_local.v);
      next_local.v = next_local.v + 1;
    }
    k = k + 1;
  }
  // the capture pair follows the params; the named $a/$l/$t/$r
  // locals occupy that reservation's index space in the module
  next_local.v = next_local.v + 4;
  let loops = loops_new();
  let dstack = dstack_new();
  let body: string = emit_stmts(fd.body, pool, env, next_local, true,
                                0 - 1, prog, loops, dstack,
                                Option.Some(fd));
  let mut out: string = "  (func $u_" + fd.name;
  // signature: every param slot is an i64 (a string param is a pair)
  let np: i64 = capture_at_after(fd);
  let mut q: i64 = 0;
  while q < np {
    out = out + " (param i64)";
    q = q + 1;
  }
  out = out + " (result i64)\n";
  // locals: the capture pair and the expression temp, then the lets
  out = out + "\n    (local $a i32) (local $l i32) (local $t i64) (local $r i64)\n";
  q = param_slots;
  while q < next_local.v {
    out = out + "    (local i64)\n";
    q = q + 1;
  }
  out = out + "    (loop $t (result i64)\n";
  out = out + body;
  out = out + "    (i64.const 0)\n    )\n  )\n";
  return out;
}

pub fn emit(prog: *Prog) -> string {
  let pool = new_pool();
  let env = env_new(64);
  let next_local = new NextLocal { v: 4 }; // 0/1 capture, 2 exit, 3 = $t
  let loops = loops_new();
  let dstack = dstack_new();
  let body: string = emit_stmts(prog.main, pool, env, next_local, false,
                                2, prog, loops, dstack,
                                Option.None); // slot 2: exit
  let next_local_n: i64 = next_local.v;
  let mut fntext: string = "";
  let mut fi: usize = 0;
  while fi < len(prog.fns) {
    fntext = fntext + emit_fn(prog.fns[fi], pool, prog);
    fi = fi + 1;
  }
  // assemble: header, memory, runtime, _start with the let locals
  let mut out: string = "";
  out = out + "(module\n";
  out = out + "  (import \"wasi_snapshot_preview1\" \"fd_write\"\n";
  out = out + "    (func $fd_write (param i32 i32 i32 i32) " +
              "(result i32)))\n";
  out = out + "  (import \"wasi_snapshot_preview1\" \"proc_exit\"\n";
  out = out + "    (func $proc_exit (param i32)))\n";
  out = out + "  (memory 1)\n";
  out = out + "  (export \"memory\" (memory 0))\n";
  let mut gi: usize = 0;
  while gi < prog.nconsts {
    if prog.cstatic[gi] {
      out = out + "  (global $g_" + prog.consts[gi] +
             " (mut i64) (i64.const " + prog.cvals[gi].to_str() +
             "))\n";
    }
    gi = gi + 1;
  }
  out = out + RUNTIME;
  out = out + ALLOC;
  out = out + STREQ;
  out = out + BOOLTEXT;
  out = out + fntext;
  out = out + "  (export \"_start\" (func $_start))\n";
  out = out + "  (func $_start (local $a i32) (local $l i32) (local $rc i32) (local $t i64)\n";
  let mut li: i64 = 3;
  while li < next_local_n {
    out = out + "    (local $v" + li.to_str() + " i64)\n";
    li = li + 1;
  }
  out = out + body;
  out = out + "    (call $proc_exit (local.get 2))\n";
  out = out + "  )\n";
  out = out + "  (data (i32.const 4030) \"truefalse\")\n";
  let mut d: usize = 0;
  while d < pool.n {
    out = out + "  (data (i32.const " + pool.addrs[d].to_str() +
                ") \"" + wat_data_body(pool.segs[d]) + "\")\n";
    d = d + 1;
  }
  out = out + ")\n";
  return out;
}
