                    },
                    Option.None => {},
                  }
                  body = body + "    (local.set $t)\n";
                  body = body + "    (i64.store (local.get $a)" +
                         " (local.get $t))\n";
                }
              } else {
              match st.val {
                Option.Some(e) => {
                  body = body + emit_expr(pool, e, env, prog, nl);
                  body = body + wrap_snippet(type_width(fty));
                },
                Option.None => {},
              }
              body = body + "    (local.set $t)\n";
              body = body + "    (i64.store (local.get $a) (local.get $t))\n";
              }
            }
          }
        }
      }
      }
    }
    if st.tag == parse.ST_SET {
      let slot: i64 = env_look(env, st.name);
      match st.val {
        Option.Some(e) => {
          let skind: i64 = env_kind_of(env, st.name);
          if skind == 1 {
            // a runtime-string rebind writes the existing pair slots
            let sp = build_string_pair(e, pool, env, prog,
                                       nl);
            if sp.ok {
              body = body + sp.text;
              body = body + "    (local.get " + sp.a.to_str() +
                     ")\n    (local.set " +
                     ((0 - env_str_look(env, st.name)) - 1).to_str() +
                     ")\n";
              body = body + "    (local.get " + sp.l.to_str() +
                     ")\n    (local.set " +
                     env_str_len_slot(env, st.name).to_str() + ")\n";
            } else {
              body = body + emit_expr(pool, e, env, prog, nl);
            }
          } else {
          if skind == 3 &&
              is_dyn_type(env_slice_elemtext(env, st.name)) {
            // a dyn rebind re-coerces: build the new fat pair (the
            // new obj retains first), release the old obj through
            // the OLD vtable's release slot, then store the pair
            let trt6: string =
                dyn_trait(env_slice_elemtext(env, st.name));
            let dst_a: i64 = (0 - env_str_look(env, st.name)) - 1;
            let dst_l: i64 = env_str_len_slot(env, st.name);
            let objt6: string = expr_ptr_type(e, env, prog);
            let vt6: string = dyn_vtable(pool, prog, trt6, objt6);
            if len(vt6) > 0 {
              let vb6: i64 = nl.v;
              let ob6: i64 = nl.v + 1;
              nl.v = nl.v + 2;
              body = body + vt6;
              body = body + "    (local.set " + vb6.to_str() +
                     ")\n";
              body = body + emit_expr(pool, e, env, prog, nl);
              body = body + "    (local.set " + ob6.to_str() +
                     ")\n";
              body = body + retain_if_shared(e, ob6);
              // the old pair's release: slot nmethods of its vtable
              let nm6: i64 = trait_method_count(prog, trt6);
              body = body + "    (local.get " + dst_l.to_str() +
                     ")\n" +
                     "    (i64.load (i32.add (i32.wrap_i64 " +
                     "(local.get " + dst_a.to_str() + ")) (i32.const " +
                     (nm6 * 8).to_str() + ")))\n" +
                     "    (i32.wrap_i64)\n" +
                     "    call_indirect (type $clv1)\n";
              body = body + "    (local.get " + vb6.to_str() +
                     ")\n    (local.set " + dst_a.to_str() + ")\n";
              body = body + "    (local.get " + ob6.to_str() +
