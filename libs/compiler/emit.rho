            if sps2.ok {
              body = body + sps2.text;
              body = body + "    (local.get " + sps2.a.to_str() +
                     ")\n    (global.set $g_" + st.name + ")\n" +
                     "    (local.get " + sps2.l.to_str() +
                     ")\n    (global.set $g_" + st.name + "_l)\n";
            } else {
              body = body + emit_expr(pool, e, env, prog, nl);
              body = body + "    (global.set $g_" + st.name + ")\n";
            }
          } else {
          let bty: string = managed_type_of_binding(env, st.name);
          if len(bty) > 0 && slot >= 0 {
            let relc: string = rel_callee(pool, prog, bty);
            if len(relc) > 0 {
              // the rebind's rc law: the new value retains first
              // (self-assign stays alive), the old releases, the
              // store lands last
              let tslot: i64 = nl.v;
              nl.v = nl.v + 1;
              body = body + emit_expr(pool, e, env, prog, nl);
              body = body + "    (local.set " + tslot.to_str() + ")\n";
              body = body + retain_if_shared(e, tslot);
              body = body + "    (local.get " + slot.to_str() + ")\n";
              body = body + "    call " + relc + "\n";
              body = body + "    (local.set " + slot.to_str() +
                     " (local.get " + tslot.to_str() + "))\n";
            } else {
              body = body + emit_expr(pool, e, env, prog, nl);
              body = body + "    (local.set " + slot.to_str() + ")\n";
            }
          } else {
          body = body + emit_expr(pool, e, env, prog, nl);
          if slot >= 0 {
            body = body + wrap_snippet(env_width_of(env, st.name));
            body = body + "    (local.set " + slot.to_str() + ")\n";
          } else {
            let g: string = static_global(prog, st.name);
            if len(g) > 0 {
              body = body + "    (global.set " + g + ")\n";
            }
          }
          }
          }
          }
          }
          }
          },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_CALL {
      match st.val {
        Option.Some(e) => {
          if e.tag == parse.EX_CALL && e.name == "panic" {
            body = body + emit_panic(pool, e);
          } else {
          if e.tag == parse.EX_CALL && e.name == "assert" {
            body = body + emit_assert(pool, e, env, prog, nl);
          } else {
          if e.tag == parse.EX_CALL && e.name == "assert_eq" &&
              !user_fn_exists(prog, "assert_eq") {
            body = body + emit_assert_eq(pool, e, env, prog,
                                         nl);
          } else {
            body = body + emit_expr(pool, e, env, prog, nl);
            body = body + "    drop\n";
          }
          }
          }
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_MATCH {
      // the statement form: the same chain, arms without values
      match st.val {
        Option.Some(sc) => {
          let bx: i64 = nl.v;
          nl.v = nl.v + 1;
          body = body + emit_expr(pool, sc, env, prog, nl);
          body = body + "    (local.set " + bx.to_str() + ")\n";
          let et: string = expr_enum_type(sc, env, prog);
          if len(et) > 0 {
            body = body + "    (i64.load (i32.wrap_i64 (local.get " +
                   bx.to_str() + ")))\n";
          } else {
            body = body + "    (local.get " + bx.to_str() + ")\n";
          }
          body = body + "    (local.set $d)\n";
          let mut optpt: string = optpt_of_scrutinee(sc, env, prog);
          if sc.tag == parse.EX_MCALL && sc.name == "get" {
            // w.get() — the payload is the weak's target
            let mut rw2: *Expr = parse.lit(0);
            match sc.lhs {
              Option.Some(x8) => {
                rw2 = x8;
              },
              Option.None => {},
            }
            if rw2.tag == parse.EX_VAR {
              let wtg2: string = weak_target(env_ptr_of(env, rw2.name));
              if len(wtg2) > 0 {
                optpt = wtg2;
              }
            }
          }
          body = body + match_chain_m(pool, st.marms, 0, bx, env,
                                      prog, nl, false, false, optpt);
          // a fresh scrutinee box dies with the match
          if expr_is_fresh(sc) {
            let scet2: string = expr_enum_type(sc, env, prog);
            if len(scet2) > 0 {
              let mut srel2: string = "";
              if sc.tag == parse.EX_MCALL && sc.name == "get" {
                let mut rw4: *Expr = parse.lit(0);
                match sc.lhs {
                  Option.Some(x10) => {
                    rw4 = x10;
                  },
                  Option.None => {},
                }
                if rw4.tag == parse.EX_VAR {
                  let wtg5: string =
                      weak_target(env_ptr_of(env, rw4.name));
                  if len(wtg5) > 0 {
                    srel2 = rel_callee(pool, prog, "?*" + wtg5);
                  }
                }
              }
              if len(srel2) == 0 {
                srel2 = rel_callee(pool, prog, scet2);
              }
              if len(srel2) > 0 {
                body = body + "    (local.get " + bx.to_str() +
                       ")\n" + "    call " + srel2 + "\n";
              }
            }
          }
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_IF {
      match st.val {
        Option.Some(cond) => {
          // flat if: the condition's stack code precedes the keyword
          body = body + emit_expr(pool, cond, env, prog, nl);
          body = body + "    (i32.wrap_i64)\n    if\n";
          body = body + emit_stmts(st.body, pool, env, nl, in_fn, ret_slot, prog, loops, dstack, tfd);
          if len(st.body2) > 0 {
            body = body + "    else\n";
            body = body + emit_stmts(st.body2, pool, env, nl,
 in_fn, ret_slot, prog, loops, dstack, tfd);
          }
          body = body + "    end\n";
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_BLOCK {
      // a bare block: its statements inline; the nested emit_stmts
      // opens its own defer frame, so the block's defers unwind at
      // its end
      body = body + emit_stmts(st.body, pool, env, nl, in_fn,
                               ret_slot, prog, loops, dstack, tfd);
    }
    if st.tag == parse.ST_DEFER {
      match st.sub {
        Option.Some(inner) => {
          let one: []*Stmt = make([]*Stmt, 1);
          one[0] = inner;
          dstack.texts[dstack.cursor] = emit_stmts(one, pool, env,
              nl, in_fn, ret_slot, prog, loops, dstack, tfd);
          dstack.cursor = dstack.cursor + 1;
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_BREAK {
      // a break exits every frame down to the loop's body: those
      // defers run here (peeked, not consumed — the normal exit
      // path keeps its frame-end copies)
      let idx: usize = loops_index(loops, st.name);
      if idx < loops.n {
        body = body + dpeek_emit_to(dstack, loops.ddepths[idx]);
      }
      body = body + "    (br " + loops_break(loops, st.name) + ")\n";
    }
    if st.tag == parse.ST_CONT {
      // a continue exits the body frame: its defers run, then the
      // head re-checks
      let idx: usize = loops_index(loops, st.name);
      if idx < loops.n {
        body = body + dpeek_emit_to(dstack, loops.ddepths[idx]);
      }
      body = body + "    (br " + loops_cont(loops, st.name) + ")\n";
    }
    if st.tag == parse.ST_LOOP {
      let bk: string = "$b" + loops.next_id.to_str();
      let w: string = "$w" + loops.next_id.to_str();
      loops.next_id = loops.next_id + 1;
      loops_push_with(loops, st.name, bk, w, dstack);
      body = body + "    (block " + bk + "\n";
      body = body + "    (loop " + w + "\n";
      body = body + emit_stmts(st.body, pool, env, nl, in_fn, ret_slot, prog, loops, dstack, tfd);
      body = body + "      (br " + w + ")\n";
      body = body + "    )\n";
      body = body + "    )\n";
      loops_pop(loops);
    }
    if st.tag == parse.ST_WHILE {
      match st.val {
        Option.Some(cond) => {
          let bk: string = "$b" + loops.next_id.to_str();
          let w: string = "$w" + loops.next_id.to_str();
          loops.next_id = loops.next_id + 1;
          loops_push_with(loops, st.name, bk, w, dstack);
          body = body + "    (block " + bk + "\n";
          body = body + "    (loop " + w + "\n";
          body = body + emit_expr(pool, cond, env, prog, nl);
          body = body + "    (i32.wrap_i64)\n    if\n";
          body = body + emit_stmts(st.body, pool, env, nl, in_fn, ret_slot, prog, loops, dstack, tfd);
          body = body + "      (br " + w + ")\n";
          body = body + "    end\n";
          body = body + "    )\n";
          body = body + "    )\n";
          loops_pop(loops);
        },
        Option.None => {},
      }
    }
    i = i + 1;
  }
  body = body + dpop_emit(dstack);
  return body;
}

// the next-local counter threads through the recursion
struct NextLocal {
  v: i64,
}

// one user fn: params as i64 locals, an i64 result. wname overrides
// the wasm name (overloads ride their signature key); "" derives it
fn capture_at_after(fd: *FnDef) -> i64 {
  let mut n: i64 = 0;
  let mut k: usize = 0;
  while k < len(fd.params) {
    if k < len(fd.pstr) && fd.pstr[k] {
      n = n + 2;
    } else {
      if k < len(fd.ptypes) && is_fn_type(fd.ptypes[k]) {
        // a fn-typed param rides its (idx, box) pair
        n = n + 2;
      } else {
        n = n + 1;
      }
    }
    k = k + 1;
  }
  return n;
}

fn emit_fn(fd: *FnDef, pool: *Pool, prog: *Prog,
           wname: string) -> string {
  let env = env_new(1024);
  env_bind_consts(env, prog, pool);
  let nl = new NextLocal { v: 0 };
  let param_slots: i64 = capture_at_after(fd);
  let mut nparams: i64 = 0;
  let mut k0: usize = 0;
  while k0 < len(fd.params) {
    if k0 < len(fd.pstr) && fd.pstr[k0] {
      nparams = nparams + 2;
    } else {
      nparams = nparams + 1;
    }
    k0 = k0 + 1;
  }
  let mut k: usize = 0;
  let mut pre: string = "";
  // by-value struct params record here; their frames allocate after
  // the $a..$d reservation (fresh locals start past it)
  let svp_names: []string = make([]string, 8);
  let svp_types: []string = make([]string, 8);
  let svp_srcs: []i64 = make([]i64, 8);
  let mut svp_n: usize = 0;
  while k < len(fd.params) {
    if k < len(fd.ptypes) && is_fn_type(fd.ptypes[k]) {
      // a closure-typed param: (idx, box) slots, kind 3
      env_str_bind_runtime(env, fd.params[k], nl.v, nl.v + 1, 3);
      nl.v = nl.v + 2;
    } else {
    if k < len(fd.pstr) && fd.pstr[k] {
      let mut kind: i64 = 1;
      if k < len(fd.pslc) && fd.pslc[k] {
        kind = 2;
      }
      env_str_bind_runtime(env, fd.params[k], nl.v,
                           nl.v + 1, kind);
      // a slice param carries its element text ([]string and the
      // variadic rest alike — element reads key on it)
      if kind == 2 && k < len(fd.ptypes) {
        let pt2: string = fd.ptypes[k];
        if len(pt2) >= 2 && pt2[0] == 91 && pt2[1] == 93 {
          env_bind_sliceelem(env, fd.params[k], pt2[2..len(pt2)]);
        }
      }
      nl.v = nl.v + 2;
    } else {
      let mut pw: i64 = 0;
      if k < len(fd.ptypes) {
        pw = type_width(fd.ptypes[k]);
      }
      // a *T param binds as a struct pointer (methods' self rides it);
      // an enum-typed param (or ?T / Option[..]) binds the enum lane
      let mut pt: string = "";
      if k < len(fd.ptypes) {
        pt = fd.ptypes[k];
      }
      let target: string = type_ptr_target(pt);
      if is_weak_type(pt) {
        // a weak[T] param rides the pointer lane uncounted
        env_bind_ptr(env, fd.params[k], nl.v,
                     "weak:" + weak_target(pt));
      } else if len(pt) >= 1 && pt[0] == 63 {
        // a ?X param is the option lane (the payload text rides the
        // slice-elem table for Some binders)
        env_bind_enum(env, fd.params[k], nl.v, "Option");
        env_bind_sliceelem(env, fd.params[k],
                           type_ptr_target(pt));
      } else if len(pt) > 0 && st_index(prog, pt) >= 0 && svp_n < 8 {
        // a by-value struct param: the lane carries the source's
        // address; the prologue (emitted past the $a..$d reservation)
        // copies the slots into a fresh frame the binding reads
        // (the loop tail advances the lane)
        svp_names[svp_n] = fd.params[k];
        svp_types[svp_n] = pt;
        svp_srcs[svp_n] = nl.v;
        svp_n = svp_n + 1;
      } else if len(target) > 0 && st_index(prog, target) >= 0 {
        env_bind_ptr(env, fd.params[k], nl.v, target);
      } else {
        if pt == "f64" || pt == "f32" {
          let mut fk1: i64 = 1;
          if pt == "f32" {
            fk1 = 2;
          }
          env_bind_f(env, fd.params[k], nl.v, fk1);
        } else {
        let mut ename: string = pt;
        if len(ename) >= 2 && ename[0] == 63 {
          ename = "Option";
        } else {
          ename = norm_enum(ename);
        }
        if len(ename) > 0 && (en_index(prog, ename) >= 0 ||
            ename == "Option" || ename == "Result") {
          env_bind_enum(env, fd.params[k], nl.v, ename);
        } else {
          env_bind_w(env, fd.params[k], nl.v, pw);
          if pt == "bool" {
            // a bool-typed param prints its words in holes
            env_bool_bind(env, fd.params[k]);
          }
        }
        }
      }
      nl.v = nl.v + 1;
    }
    }
    k = k + 1;
  }
  // the capture pair follows the params; the named $a/$l/$t/$r/$d
  // locals occupy that reservation's index space in the module
  nl.v = nl.v + 5;
  // the struct-param frames copy in here — past the reservation
  let mut svp_i: usize = 0;
  while svp_i < svp_n {
    let psi: i64 = st_index(prog, svp_types[svp_i]);
    let pn: i64 = st_nslots(prog, psi);
    let psrc: i64 = svp_srcs[svp_i];
    let vbase: i64 = nl.v;
    nl.v = nl.v + pn;
    let mut pj: i64 = 0;
    while pj < pn {
      pre = pre + "    (i64.load (i32.add (i32.wrap_i64 (local.get " +
             psrc.to_str() + ")) (i32.const " + (pj * 8).to_str() +
             ")))\n" +
             "    (local.set " + (vbase + pj).to_str() + ")\n";
      pj = pj + 1;
    }
    env_bind_val(env, svp_names[svp_i], vbase, svp_types[svp_i]);
    svp_i = svp_i + 1;
  }
  let loops = loops_new();
  let dstack = dstack_new();
  let body: string = pre + emit_stmts(fd.body, pool, env, nl, true,
                                0 - 1, prog, loops, dstack,
                                Option.Some(fd));
  let mut out: string = "";
  if len(wname) > 0 {
    out = "  (func " + wname;
  } else {
    out = "  (func $u_" + sym_name(fd.name);
  }
  // signature: every param slot is an i64 (a string param is a pair)
  let np: i64 = capture_at_after(fd);
  let mut q: i64 = 0;
  while q < np {
    out = out + " (param i64)";
    q = q + 1;
  }
  if rtype_is_pair(fd.rtype) {
    out = out + " (result i64) (result i64)\n";
  } else {
    out = out + " (result i64)\n";
  }
  // locals: the capture pair and the expression temps, then the lets
  out = out + "\n    (local $a i32) (local $l i32) (local $t i64) (local $r i64) (local $d i64)\n";
  q = param_slots;
  while q < nl.v {
    out = out + "    (local i64)\n";
    q = q + 1;
  }
  if rtype_is_pair(fd.rtype) {
    out = out + "    (loop $t (result i64) (result i64)\n";
  } else {
    out = out + "    (loop $t (result i64)\n";
  }
  out = out + body;
  if rtype_is_pair(fd.rtype) {
    out = out + "    (i64.const 0)\n    (i64.const 0)\n    )\n  )\n";
  } else {
    out = out + "    (i64.const 0)\n    )\n  )\n";
  }
  return out;
}

// module consts join a fresh env before any body emits (locals may
// shadow them): string-typed consts bind their folded text — print
// holes, len(), and concat folds read them like literals — and bool
// consts/statics take the word-printing marker. Every env (main's and
// each fn's) starts with the same table.
fn env_bind_consts(env: *Env, prog: *Prog, pool: *Pool) {
  let mut ci: usize = 0;
  while ci < prog.nconsts {
    let cn: string = prog.consts[ci];
    if !prog.cstatic[ci] && prog.ctypes[ci] == "string" {
      match fold_string(prog.cexprs[ci], env) {
        Option.Some(raw) => {
          let ca: i64 = pool_intern(pool, raw);
          env_str_bind(env, cn, ca, pool_len(pool, raw), raw);
        },
        Option.None => {},
      }
    }
    if prog.ctypes[ci] == "bool" {
      env_bool_bind(env, cn);
    }
    ci = ci + 1;
  }
}

// the exact-decimal float text, as rho source the emitter compiles
// through itself and appends to every program (the same algorithm
// boot's prelude carries: m·2^e expanded exactly over base-1e9 limbs,
// rounded half-to-even to the round-trip digit count — 17 f64, 9 f32
// — then printed positionally or scientifically). The entry points
// take the f64 BITS on the i64 lane (the emitter owns the only
// reinterpret); limbs are i64 so the cluster rides the plain scalar
// slice path.
const FLOATSRC: string = """
struct Dec {
  limbs: []i64,
  used: i64,
}

fn __dec_new() -> *Dec {
  return new Dec { limbs: make([]i64, 96), used: 1 };
}

fn __dec_trim(d: *Dec) {
  while d.used > 1 && d.limbs[d.used - 1] == 0 {
    d.used = d.used - 1;
  }
  return;
}

fn __dec_set(d: *Dec, v: u64) {
  d.limbs[0] = (v % 1000000000) as i64;
  d.limbs[1] = ((v / 1000000000) % 1000000000) as i64;
  d.limbs[2] = (v / 1000000000000000000) as i64;
  d.used = 3;
  __dec_trim(d);
  return;
}

fn __dec_mul_small(d: *Dec, m: i64) {
  let mut carry: u64 = 0;
  let mut i: i64 = 0;
  while i < d.used {
    let cur: u64 = (d.limbs[i] as u64) * (m as u64) + carry;
    d.limbs[i] = (cur % 1000000000) as i64;
    carry = cur / 1000000000;
    i = i + 1;
  }
  while carry > 0 {
    d.limbs[d.used] = (carry % 1000000000) as i64;
    carry = carry / 1000000000;
    d.used = d.used + 1;
  }
  return;
}

fn __dec_to_u64(d: *Dec) -> u64 {
  let mut v: u64 = 0;
  let mut i: i64 = d.used;
  while i > 0 {
    i = i - 1;
    v = v * 1000000000 + (d.limbs[i] as u64);
  }
  return v;
}

fn __dec_bump(d: *Dec) {
  let mut i: i64 = 0;
  loop {
    if i >= d.used {
      d.limbs[i] = 1;
      d.used = d.used + 1;
      return;
    }
    if d.limbs[i] + 1 < 1000000000 {
      d.limbs[i] = d.limbs[i] + 1;
      return;
    }
    d.limbs[i] = 0;
    i = i + 1;
  }
}

fn __dec_cmp(a: *Dec, b: *Dec) -> i32 {
  if a.used != b.used {
    if a.used < b.used {
      return 0 - 1;
    }
    return 1;
  }
  let mut i: i64 = a.used;
  while i > 0 {
    i = i - 1;
    if a.limbs[i] != b.limbs[i] {
      if a.limbs[i] < b.limbs[i] {
        return 0 - 1;
      }
      return 1;
    }
  }
  return 0;
}

fn __pow10(k: i64) -> u64 {
  let mut v: u64 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 10;
    i = i + 1;
  }
  return v;
}

fn __pow2s(k: i64) -> i64 {
  let mut v: i64 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 2;
    i = i + 1;
  }
  return v;
}

fn __pow5s(k: i64) -> i64 {
  let mut v: i64 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 5;
    i = i + 1;
  }
  return v;
}

fn __dec_top_digits(d: *Dec) -> i64 {
  let mut x: i64 = d.limbs[d.used - 1];
  let mut n: i64 = 1;
  while x >= 10 {
    x = x / 10;
    n = n + 1;
  }
  return n;
}

// 5·10^(cut-1): half of the divisor 10^cut
fn __dec_half_of(cut: i64) -> *Dec {
  let h: *Dec = __dec_new();
  let pos: i64 = cut - 1;
  let l: i64 = pos / 9;
  let r: i64 = pos % 9;
  h.limbs[l] = (5 * __pow10(r)) as i64;
  h.used = l + 1;
  return h;
}

// q = d div 10^cut (returned); d keeps d mod 10^cut
fn __dec_split(d: *Dec, cut: i64) -> *Dec {
  let l: i64 = cut / 9;
  let r: i64 = cut % 9;
  let q: *Dec = __dec_new();
  if d.used <= l {
    return q;
  }
  let qn: i64 = d.used - l;
  let p: u64 = __pow10(r);
  let mut rem: u64 = 0;
  let mut i: i64 = qn;
  while i > 0 {
    i = i - 1;
    let cur: u64 = rem * 1000000000 + (d.limbs[l + i] as u64);
    q.limbs[i] = (cur / p) as i64;
    rem = cur % p;
  }
  q.used = qn;
  __dec_trim(q);
  if r > 0 {
    d.limbs[l] = rem as i64;
    d.used = l + 1;
  } else {
    d.used = l;
  }
  if d.used == 0 {
    d.limbs[0] = 0;
    d.used = 1;
  }
  __dec_trim(d);
  return q;
}

fn __drop_zeros(s: string) -> string {
  let mut k: i64 = len(s);
  while k > 0 && s[k - 1] == 48 {
    k = k - 1;
  }
  return s[0..k];
}

fn __sgn(neg: bool, body: string) -> string {
  if neg {
    return "-" + body;
  }
  return body;
}

fn __dec_text(bits: u64, prec: i64) -> string {
  let neg: bool = (bits >> 63) == 1;
  let mag: u64 = bits & 9223372036854775807;
  let biased: u64 = (mag >> 52) & 2047;
  if biased == 2047 {
    if (mag & 4503599627370495) == 0 {
      return __sgn(neg, "inf");
    }
    return "nan";
  }
  if (mag << 1) == 0 {
    return __sgn(neg, "0.0");
  }
  let mut m: u64 = 0;
  let mut e: i64 = 0;
  if biased == 0 {
    m = mag & 4503599627370495;
    e = 0 - 1074;
  } else {
    m = (mag & 4503599627370495) | 4503599627370496;
    e = (biased as i64) - 1075;
  }
  let d: *Dec = __dec_new();
  __dec_set(d, m);
  let mut sc: i64 = 0;
  if e >= 0 {
    let mut k: i64 = e;
    while k >= 29 {
      __dec_mul_small(d, 536870912);
      k = k - 29;
    }
    if k > 0 {
      __dec_mul_small(d, __pow2s(k));
    }
  } else {
    let mut k: i64 = 0 - e;
    while k >= 12 {
      __dec_mul_small(d, 244140625);
      sc = sc + 12;
      k = k - 12;
    }
    if k > 0 {
      __dec_mul_small(d, __pow5s(k));
      sc = sc + k;
    }
  }
  let topd: i64 = __dec_top_digits(d);
  let mut n: i64 = (d.used - 1) * 9 + topd - sc;
  let cut: i64 = sc + n - prec;
  let mut qv: u64 = 0;
  if cut > 0 {
    let q: *Dec = __dec_split(d, cut);
    let c: i64 = __dec_cmp(d, __dec_half_of(cut));
    if c > 0 || (c == 0 && (q.limbs[0] & 1) == 1) {
      __dec_bump(q);
    }
    qv = __dec_to_u64(q);
  } else {
    if cut == 0 {
      qv = __dec_to_u64(d);
    } else {
      let mut k: i64 = 0 - cut;
      while k >= 9 {
        __dec_mul_small(d, 1000000000);
        k = k - 9;
      }
      if k > 0 {
        __dec_mul_small(d, __pow10(k) as i64);
      }
      qv = __dec_to_u64(d);
    }
  }
  let mut ds: string = format("{}", qv);
  if qv >= __pow10(prec) {
    qv = qv / 10;
    n = n + 1;
    ds = format("{}", qv);
  }
  let e10: i64 = n - 1;
  if e10 >= 0 - 4 && e10 < prec {
    if e10 >= 0 {
      let ip: i64 = e10 + 1;
      let frac: string = __drop_zeros(ds[ip..prec]);
      if len(frac) == 0 {
        return __sgn(neg, ds[0..ip]);
      }
      return __sgn(neg, ds[0..ip] + "." + frac);
    }
    let all: string = __drop_zeros(ds);
    if len(all) == 0 {
      return __sgn(neg, "0");
    }
    let mut pre: string = "0.";
    let mut j: i64 = (0 - e10) - 1;
    while j > 0 {
      pre = pre + "0";
      j = j - 1;
    }
    return __sgn(neg, pre + all);
  }
  let mut out: string = ds[0..1];
  let frac: string = __drop_zeros(ds[1..prec]);
  if len(frac) > 0 {
    out = out + "." + frac;
  }
  let mut ae: i64 = e10;
  if ae < 0 {
    ae = 0 - ae;
  }
  let mut es: string = format("{}", ae);
  if ae < 10 {
    es = "0" + es;
  }
  if e10 < 0 {
    return __sgn(neg, out + "e-" + es);
  }
  return __sgn(neg, out + "e+" + es);
}

// integral floats keep a visible fraction ("4" reads as "4.0")
fn __with_frac(s: string) -> string {
  if s == "inf" || s == "nan" || s == "-inf" {
    return s;
  }
  let mut i: i64 = 0;
  while i < len(s) {
    if s[i] == 46 || s[i] == 101 {
      return s;
    }
    i = i + 1;
  }
  return s + ".0";
}

fn __f64_text(bits: u64) -> string {
  return __with_frac(__dec_text(bits, 17));
}

fn __f32_text(bits: u64) -> string {
  return __with_frac(__dec_text(bits, 9));
}
""";

// the float cluster rides a program only when a float actually
// prints (the flag is module state: body emission runs before the
// module assembles, so the decision is made by then — deterministic
// for the same source either way)
static mut FLOAT_WANTED: i64 = 0;

// the float cluster, compiled through the compiler's own front end and
// emitted beside the program (its pool strings ride the same data
// segment — one address space, one intern pass, deterministic)
fn float_runtime_wat(pool: *Pool) -> string {
  let toks: []*Tok = lex.lex(FLOATSRC);
  let fprog: *Prog = parse.parse(toks, FLOATSRC);
  let mut out: string = "";
  let mut fi: usize = 0;
  while fi < len(fprog.fns) {
    out = out + emit_fn(fprog.fns[fi], pool, fprog, "");
    fi = fi + 1;
  }
  return out;
}

pub fn emit(prog: *Prog) -> string {
  let pool = new_pool();
  let env = env_new(1024);
  env_bind_consts(env, prog, pool);
  let nl = new NextLocal { v: 6 }; // 0/1 capture, 2 exit, 3 $t, 4 $r, 5 $d
  let loops = loops_new();
  let dstack = dstack_new();
  let body: string = emit_stmts(prog.main, pool, env, nl, false,
                                2, prog, loops, dstack,
                                Option.None); // slot 2: exit
  let nl_n: i64 = nl.v;
  let mut fntext: string = "";
  let mut fi: usize = 0;
  while fi < len(prog.fns) {
    if len(prog.fns[fi].tparams) == 0 {
      fntext = fntext + emit_fn(prog.fns[fi], pool, prog,
                                wasm_fn_name(prog, prog.fns[fi]));
    }
    fi = fi + 1;
  }
  // the generic worklist drains until stable — an instantiation's
  // body may call more generics, appending as it emits; closure
  // entries emit their box-param form
  let mut gdone: usize = 0;
  while gdone < pool.gi.n {
    let gb: string = pool.gi.bases[gdone];
    if len(gb) >= 3 && gb[0] == 118 && gb[1] == 116 && gb[2] == 58 {
      // "vt:" — a vtable cache entry, not a fn
      gdone = gdone + 1;
      continue;
    }
    if len(gb) >= 5 && gb[0] == 99 && gb[1] == 108 && gb[2] == 111 &&
        gb[3] == 58 {
      // "clo:<wat>"
      let wat2: string = gb[4..len(gb)];
      let idx2: i64 = pool.gi.ids[gdone];
      let capbase2: usize = (idx2 as usize) * 8;
      let mut capnames: []string = make([]string, 8);
      let mut captypes: []string = make([]string, 8);
      let mut ncaps2: usize = 0;
      while ncaps2 < 8 {
        let raw0: string = pool.gi.clo_caps[capbase2 + ncaps2];
        if len(raw0) == 0 {
          break;
        }
        let colon: usize = find_colon(raw0);
        if colon > 0 {
          capnames[ncaps2] = raw0[0..colon];
          captypes[ncaps2] = raw0[(colon + 1)..len(raw0)];
        } else {
          capnames[ncaps2] = raw0;
          captypes[ncaps2] = "";
        }
        ncaps2 = ncaps2 + 1;
      }
      let mut cparams: []string = make([]string, 8);
      let mut np2: usize = 0;
      while np2 < 8 {
        if len(pool.gi.clo_params[capbase2 + np2]) == 0 {
          break;
        }
        cparams[np2] = pool.gi.clo_params[capbase2 + np2];
        np2 = np2 + 1;
      }
      let carrier2: *FnDef = pool.gi.clo_fds[gdone];
      fntext = fntext + emit_closure_fn(wat2, capnames, captypes,
                                        ncaps2,
                                        cparams[0..np2],
                                        carrier2.body,
                                        pool, prog);
    } else {
      fntext = fntext + emit_fn(pool.gi.fds[gdone], pool, prog, "");
    }
    gdone = gdone + 1;
  }
  // the release thunks (a thunk's walk may register more: drain to
  // the bottom)
  let mut rdone2: usize = 0;
  while rdone2 < pool.rel_n {
    fntext = fntext + pool.rel_texts[rdone2];
    rdone2 = rdone2 + 1;
  }
  let rdone2_done: usize = pool.rel_n;
  // assemble: header, memory, runtime, _start with the let locals
  let mut out: string = "";
  out = out + "(module\n";
  out = out + "  (import \"wasi_snapshot_preview1\" \"fd_write\"\n";
  out = out + "    (func $fd_write (param i32 i32 i32 i32) " +
              "(result i32)))\n";
  out = out + "  (import \"wasi_snapshot_preview1\" \"proc_exit\"\n";
  out = out + "    (func $proc_exit (param i32)))\n";
  // memory: enough pages for the data segments (the pool interned the
  // program's every string BEFORE this line — a program-sized source
  // rides the data pool and must fit at instantiation; the allocator
  // grows past it at runtime)
  let mut mpages: i64 = 1;
  let dtop: i64 = pool.next;
  mpages = (dtop + 65535) / 65536;
  if mpages < 1 {
    mpages = 1;
  }
  out = out + "  (memory " + mpages.to_str() + ")\n";
  out = out + "  (export \"memory\" (memory 0))\n";
  let mut gi: usize = 0;
  while gi < prog.nconsts {
    if prog.cstatic[gi] {
      let mut ginit: string = prog.cvals[gi].to_str();
      if prog.ctypes[gi] == "string" {
        // a string static's pair rides TWO globals — the address and
        // the length — with a literal initializer resolving to its
        // rodata pair at emit time
        let ie: *Expr = prog.cexprs[gi];
        ginit = "0";
        if ie.tag == parse.EX_STR {
          let sa: i64 = pool_intern(pool, ie.name);
          ginit = sa.to_str();
          out = out + "  (global $g_" + prog.consts[gi] +
                 " (mut i64) (i64.const " + ginit + "))\n";
          out = out + "  (global $g_" + prog.consts[gi] +
                 "_l (mut i64) (i64.const " +
                 pool_len(pool, ie.name).to_str() + "))\n";
          gi = gi + 1;
          continue;
        }
        out = out + "  (global $g_" + prog.consts[gi] +
               " (mut i64) (i64.const 0))\n";
        out = out + "  (global $g_" + prog.consts[gi] +
               "_l (mut i64) (i64.const 0))\n";
        gi = gi + 1;
        continue;
      }
      out = out + "  (global $g_" + prog.consts[gi] +
             " (mut i64) (i64.const " + ginit + "))\n";
    }
    gi = gi + 1;
  }
  out = out + RUNTIME;
  out = out + UINT;
  out = out + CAT;
  out = out + ITOA;
  out = out + ALLOC;
  out = out + STREQ;
  out = out + ENUQ;
  out = out + NONEBOX;
  out = out + BOOLTEXT;
  if pool.gi.cfn > 0 {
    // the closure table: one funcref per entry, the indirect-call
    // types for the arities the calls used (flag 1 = scalar result,
    // 2 = pair result; a slot needing both kinds declares both)
    let cty1: []i64 = pool.gi.clo_ty;
    out = out + "  (type $clp1 (func (param i64) (result i64)" +
                " (result i64)))\n";
    out = out + "  (type $clv1 (func (param i64)))\n";
    let mut ari: i64 = 1;
    while ari <= 3 {
      if cty1[ari as usize] == 1 || cty1[ari as usize] == 3 ||
          ari == 1 {
        out = out + "  (type $cl" + ari.to_str() + " (func";
        let mut pk: i64 = 0;
        while pk < ari {
          out = out + " (param i64)";
          pk = pk + 1;
        }
        out = out + " (result i64)))\n";
      }
      if cty1[ari as usize] >= 2 && ari > 1 {
        out = out + "  (type $clp" + ari.to_str() + " (func";
        let mut pk2: i64 = 0;
        while pk2 < ari {
          out = out + " (param i64)";
          pk2 = pk2 + 1;
        }
        out = out + " (result i64) (result i64)))\n";
      }
      ari = ari + 1;
    }
    out = out + "  (table " + pool.gi.cfn.to_str() + " funcref)\n";
    out = out + "  (elem (i32.const 0)";
    let mut ti: usize = 0;
    while ti < pool.gi.cfn {
      out = out + " " + pool.gi.clo_wasms[ti];
      ti = ti + 1;
    }
    out = out + ")\n";
  }
  if FLOAT_WANTED > 0 {
    out = out + float_runtime_wat(pool);
  }
  // _start's own emission registers thunks after the first drain:
  // drain again (idempotent — registry entries append)
  let mut rdone3: usize = 0;
  while rdone3 < pool.rel_n {
    if rdone3 >= rdone2_done {
      fntext = fntext + pool.rel_texts[rdone3];
    }
    rdone3 = rdone3 + 1;
  }
  out = out + fntext;
  out = out + "  (export \"_start\" (func $_start))\n";
  out = out + "  (func $_start (local $a i32) (local $l i32) (local $rc i32) (local $t i64) (local $r i64) (local $d i64)\n";
  let mut li: i64 = 6;
  while li < nl_n {
    out = out + "    (local $v" + li.to_str() + " i64)\n";
    li = li + 1;
  }
  out = out + "    (global.set $w_none_box (i64.extend_i32_u " +
              "(call $w_alloc (i32.const 2))))\n";
  // a float-typed static's bits cannot ride a wasm global initializer
  // (reinterpret is no const expr) — the value lands at _start
  let mut fsi: usize = 0;
  while fsi < prog.nconsts {
    if prog.cstatic[fsi] &&
        (prog.ctypes[fsi] == "f64" || prog.ctypes[fsi] == "f32") {
      let ie: *Expr = prog.cexprs[fsi];
      if ie.tag == parse.EX_FLIT {
        out = out + "    (global.set $g_" + prog.consts[fsi] +
               " (i64.reinterpret_f64 (f64.const " + ie.name +
               ")))\n";
      }
    }
    fsi = fsi + 1;
  }
  out = out + body;
  out = out + "    (call $proc_exit (i32.and (local.get 2) " +
              "(i32.const 255)))\n";
  out = out + "  )\n";
  out = out + "  (data (i32.const 4030) \"truefalse\")\n";
  let mut d: usize = 0;
  while d < pool.n {
    out = out + "  (data (i32.const " + pool.addrs[d].to_str() +
                ") \"" + wat_data_body(pool.segs[d]) + "\")\n";
    d = d + 1;
  }
  out = out + ")\n";
  return out;
}
