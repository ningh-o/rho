// the embedded prelude sources and their composition per target
use cli;


// ---- embedded prelude (generated by tools/embed-prelude.py) ------
fn prelude_core_src() -> string { return """// The rho prelude core — pure, target-independent, prepended to every
// target's tail (hosted / wasi) at embed time. The tails provide
// the four per-target hooks this core builds on:
//
//   __print_str(s: string)   stdout bytes
//   __eprint_str(s: string)  stderr bytes
//   __exit(code: i32)        terminal exit
//   __alloc / __free         allocator hooks
//
// Printing is the to_str protocol (spec §10.1): a type is printable when
// it has a method `to_str(self) -> string`; printf/eprintf fill each `{}`
// in a literal format with the next value's to_str. Every primitive gets
// to_str here; floats go through an exact bigint formatter (the same
// algorithm the self-hosted compiler uses for its canonical goldens) so
// the digits are identical on every target, soft-float included.

// The print protocol as a named trait (0.4.0): satisfaction is computed
// from the method tables, so every primitive's to_str below already
// implements it, and a user type joins by defining to_str — no impl
// block needed unless you want the eager check.
pub trait Show {
  fn to_str(self) -> string,
}

pub enum Option[T] {
  Some(T),
  None,
}

pub enum Result[T, E] {
  Ok(T),
  Err(E),
}

fn Option.is_some(self: Option) -> bool {
  return match self {
    Option.Some(_) => true,
    Option.None => false,
  };
}

fn Option.is_none(self: Option) -> bool {
  return match self {
    Option.Some(_) => false,
    Option.None => true,
  };
}

fn Result.is_ok(self: Result) -> bool {
  return match self {
    Result.Ok(_) => true,
    Result.Err(_) => false,
  };
}

fn Result.is_err(self: Result) -> bool {
  return match self {
    Result.Ok(_) => false,
    Result.Err(_) => true,
  };
}

// ------------------------------------------------------------ panics --

fn panic(msg: string) {
  eprintf("panic: {}\\n", msg);
  __exit(101);
}

fn assert(cond: bool) {
  if !cond {
    panic("assertion failed");
  }
}

fn assert_eq[T: Show](a: T, b: T) {
  if !(a == b) {
    panic(__cat2(__cat2("assert_eq failed: ", a.to_str()), __cat2(" != ", b.to_str())));
  }
}

fn __panic_div() {
  panic("division by zero");
}

fn __panic_oob() {
  panic("index out of bounds");
}

fn __panic_null() {
  panic("null dereference");
}

fn __streq(a: string, b: string) -> bool {
  if len(a) != len(b) {
    return false;
  }
  let mut i: usize = 0;
  while i < len(a) {
    if a[i] != b[i] {
      return false;
    }
    i += 1;
  }
  return true;
}

// --------------------------------------------------------- strings --
//
// String concatenation is `+` in the language surface; these double-
// underscore helpers are the runtime primitives underneath it (and the
// printf/__fmt_print formatting machine's own plumbing). No public
// `cat` — user code spells concatenation `a + b`.

fn __cat2(a: string, b: string) -> string {
  let buf: []u8 = make([]u8, len(a) + len(b));
  let mut i: usize = 0;
  while i < len(a) {
    buf[i] = a[i];
    i += 1;
  }
  let mut j: usize = 0;
  while j < len(b) {
    buf[i + j] = b[j];
    j += 1;
  }
  return intrinsics.slice_string(buf);
}

fn __cat3(a: string, b: string, c: string) -> string {
  return __cat2(a, __cat2(b, c));
}

fn __substr(s: string, a: usize, b: usize) -> string {
  let buf: []u8 = make([]u8, b - a);
  let mut i: usize = a;
  while i < b {
    buf[i - a] = s[i];
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

fn __rep0(cnt: usize) -> string {
  let buf: []u8 = make([]u8, cnt);
  let mut i: usize = 0;
  while i < cnt {
    buf[i] = 48;
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

// ------------------------------------------------------ integers --

fn u64.to_str(self: u64) -> string {
  return __fmt_u64(self);
}

fn i64.to_str(self: i64) -> string {
  return __fmt_i64(self);
}

fn __fmt_u64(v: u64) -> string {
  if v == 0 {
    return "0";
  }
  let buf: []u8 = make([]u8, 24);
  let mut n: usize = 24;
  let mut x: u64 = v;
  while x > 0 {
    n -= 1;
    buf[n] = 48 + (x % 10) as u8;
    x /= 10;
  }
  return intrinsics.slice_string(buf[n..24]);
}

fn __fmt_i64(v: i64) -> string {
  if v < 0 {
    // wrapping negation: 0 - MIN is MIN again, whose u64 pattern is exactly
    // the magnitude — correct at the edge where a plain negate would stay
    // negative and corrupt every digit (the 0.2 print_int bug)
    let mag: u64 = (0 - v) as u64;
    return __cat3("-", __fmt_u64(mag), "");
  }
  return __fmt_u64(v as u64);
}

fn u8.to_str(self: u8) -> string {
  return __fmt_u64(self as u64);
}

fn u16.to_str(self: u16) -> string {
  return __fmt_u64(self as u64);
}

fn u32.to_str(self: u32) -> string {
  return __fmt_u64(self as u64);
}

fn usize.to_str(self: usize) -> string {
  return __fmt_u64(self as u64);
}

fn i8.to_str(self: i8) -> string {
  return __fmt_i64(self as i64);
}

fn i16.to_str(self: i16) -> string {
  return __fmt_i64(self as i64);
}

fn i32.to_str(self: i32) -> string {
  return __fmt_i64(self as i64);
}

fn isize.to_str(self: isize) -> string {
  return __fmt_i64(self as i64);
}

fn bool.to_str(self: bool) -> string {
  if self {
    return "true";
  }
  return "false";
}

fn string.to_str(self: string) -> string {
  return self;
}

// --------------------------------------------------------- floats --
//
// Exact decimal formatting: the f64's exact value (m2 * 2^e2) is expanded
// as a base-10^9 bigint, then correctly rounded (half to even) to D
// significant digits — D = 17 for f64, 9 for f32, the counts that always
// round-trip. Pure integer arithmetic; only f64_bits inspects the value.

struct __Big {
  w: []u32,
  n: usize,
}

fn __big_new() -> *__Big {
  return new __Big { w: make([]u32, 160), n: 1 };
}

fn __big_trim(b: *__Big) {
  while b.n > 1 && b.w[b.n - 1] == 0 {
    b.n -= 1;
  }
}

fn __big_set_u64(b: *__Big, v: u64) {
  b.w[0] = (v % 1000000000) as u32;
  b.w[1] = ((v / 1000000000) % 1000000000) as u32;
  b.w[2] = (v / 1000000000000000000) as u32;
  b.n = 3;
  __big_trim(b);
}

// schoolbook multiply by a factor < 1e9; products stay under 2^63
fn __big_mul_u32(b: *__Big, m: u32) {
  let mut carry: u64 = 0;
  let mut i: usize = 0;
  while i < b.n {
    let cur: u64 = b.w[i] as u64 * m as u64 + carry;
    b.w[i] = (cur % 1000000000) as u32;
    carry = cur / 1000000000;
    i += 1;
  }
  while carry > 0 {
    b.w[b.n] = (carry % 1000000000) as u32;
    carry = carry / 1000000000;
    b.n += 1;
  }
}

fn __big_get_u64(b: *__Big) -> u64 {
  let mut v: u64 = 0;
  let mut i: usize = b.n;
  while i > 0 {
    i -= 1;
    v = v * 1000000000 + b.w[i] as u64;
  }
  return v;
}

fn __big_add_one(b: *__Big) {
  let mut i: usize = 0;
  loop {
    if i >= b.n {
      b.w[i] = 1;
      b.n += 1;
      return;
    }
    b.w[i] = b.w[i] + 1;
    if b.w[i] < 1000000000 {
      return;
    }
    b.w[i] = 0;
    i += 1;
  }
}

fn __big_cmp(a: *__Big, b: *__Big) -> i32 {
  if a.n != b.n {
    if a.n < b.n {
      return 0 - 1;
    }
    return 1;
  }
  let mut i: usize = a.n;
  while i > 0 {
    i -= 1;
    if a.w[i] != b.w[i] {
      if a.w[i] < b.w[i] {
        return 0 - 1;
      }
      return 1;
    }
  }
  return 0;
}

fn __p10_u64(r: usize) -> u64 {
  let mut v: u64 = 1;
  let mut i: usize = 0;
  while (i as i64) < r as i64 {
    v = v * 10;
    i += 1;
  }
  return v;
}

fn __pow2_u32(k: i64) -> u32 {
  let mut v: u32 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 2;
    i += 1;
  }
  return v;
}

fn __pow5_u32(k: i64) -> u32 {
  let mut v: u32 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 5;
    i += 1;
  }
  return v;
}

// strip trailing '0's ("1000" -> "1", "000" -> "")
fn __strip0(fr: string) -> string {
  let mut k: usize = len(fr);
  while k > 0 && fr[k - 1] == 48 {
    k -= 1;
  }
  return __substr(fr, 0, k);
}

fn __u32_digits(v: u32) -> i64 {
  let mut d: i64 = 1;
  let mut x: u32 = v;
  while x >= 10 {
    x = x / 10;
    d += 1;
  }
  return d;
}

// 5 * 10^(cut-1): half of the divisor 10^cut
fn __big_half(cut: usize) -> *__Big {
  let h: *__Big = __big_new();
  let pos: usize = cut - 1;
  let l: usize = pos / 9;
  let r: usize = pos % 9;
  h.w[l] = (5 * __p10_u64(r)) as u32;
  h.n = l + 1;
  return h;
}

// Q = N div 10^cut (returned); N becomes N mod 10^cut
fn __big_divmod_pow10(b: *__Big, cut: usize) -> *__Big {
  let l: usize = cut / 9;
  let r: usize = cut % 9;
  let q: *__Big = __big_new();
  if b.n <= l {
    return q;
  }
  let qn: usize = b.n - l;
  let p: u64 = __p10_u64(r);
  let mut rem: u64 = 0;
  let mut i: usize = qn;
  while i > 0 {
    i -= 1;
    let cur: u64 = rem * 1000000000 + b.w[l + i] as u64;
    q.w[i] = (cur / p) as u32;
    rem = cur % p;
  }
  q.n = qn;
  __big_trim(q);
  if r > 0 {
    b.w[l] = rem as u32;
    b.n = l + 1;
  } else {
    b.n = l;
  }
  if b.n == 0 {
    b.w[0] = 0;
    b.n = 1;
  }
  __big_trim(b);
  return q;
}

// sign prefix helper: the digits body works on the magnitude
fn __sfmt(neg: bool, s: string) -> string {
  if neg {
    return __cat3("-", s, "");
  }
  return s;
}

fn __fmt_digits(x: f64, prec: i64) -> string {
  let bits: u64 = intrinsics.f64_bits(x);
  // everything below works on the magnitude bits: the sign of a NaN is
  // hardware-defined (x86 invalid ops produce a negative "indefinite" NaN,
  // arm64 a positive default one), so it is stripped here, reattached as
  // text where it is meaningful, and NaN prints canonically unsigned
  let neg: bool = (bits >> 63) == 1;
  let m: u64 = bits & 9223372036854775807;
  let be: u64 = (m >> 52) & 2047;
  if be == 2047 {
    if (m & 4503599627370495) == 0 {
      if neg {
        return "-inf";
      }
      return "inf";
    }
    return "nan";
  }
  if (m << 1) == 0 {
    if neg {
      return "-0.0";
    }
    return "0.0";
  }
  let mut m2: u64 = 0;
  let mut e2: i64 = 0;
  if be == 0 {
    m2 = m & 4503599627370495;
    e2 = (0 - 1074) as i64;
  } else {
    m2 = (m & 4503599627370495) | 4503599627370496;
    e2 = be as i64 - 1075;
  }
  // exact integer N with x == N / 10^s
  let b: *__Big = __big_new();
  __big_set_u64(b, m2);
  let mut s: i64 = 0;
  if e2 >= 0 {
    let mut k: i64 = e2;
    while k >= 29 {
      __big_mul_u32(b, 536870912);
      k -= 29;
    }
    if k > 0 {
      __big_mul_u32(b, __pow2_u32(k));
    }
  } else {
    // x = m2 * 2^-k = (m2 * 5^k) / 10^k — powers of FIVE: multiplying by
    // powers of ten here would smuggle extra factors of two into N
    let mut k: i64 = 0 - e2;
    while k >= 9 {
      __big_mul_u32(b, 1953125);
      s += 9;
      k -= 9;
    }
    if k > 0 {
      __big_mul_u32(b, __pow5_u32(k));
      s += k;
    }
  }
  // n: x = 0.<digits> * 10^n; cut at `prec` significant digits
  let topd: i64 = __u32_digits(b.w[b.n - 1]);
  let mut n: i64 = (b.n as i64 - 1) * 9 + topd - s;
  let cut: i64 = s + n - prec;
  let mut qv: u64 = 0;
  if cut > 0 {
    let q: *__Big = __big_divmod_pow10(b, cut as usize);
    // round half to even on the exact remainder
    let c: i32 = __big_cmp(b, __big_half(cut as usize));
    if c > 0 || (c == 0 && (q.w[0] & 1) == 1) {
      __big_add_one(q);
    }
    qv = __big_get_u64(q);
  } else if cut == 0 {
    qv = __big_get_u64(b);
  } else {
    let mut k: i64 = 0 - cut;
    while k >= 9 {
      __big_mul_u32(b, 1000000000);
      k -= 9;
    }
    if k > 0 {
      __big_mul_u32(b, __p10_u64(k as usize) as u32);
    }
    qv = __big_get_u64(b);
  }
  // round-up carry: 999...9.7 -> 10^prec -> re-exponent
  if qv >= __p10_u64(prec as usize) {
    qv = qv / 10;
    n += 1;
  }
  let e10: i64 = n - 1;
  let ds: string = __fmt_u64(qv);
  if e10 >= (0 - 4) as i64 && e10 < prec {
    if e10 >= 0 {
      let ip: usize = e10 as usize + 1;
      let frac: string = __strip0(__substr(ds, ip, prec as usize));
      if len(frac) == 0 {
        return __sfmt(neg, __substr(ds, 0, ip));
      }
      return __sfmt(neg, __cat3(__substr(ds, 0, ip), __cat3(".", frac, ""), ""));
    }
    let all: string = __strip0(__cat3(__rep0((0 - e10 - 1) as usize), ds, ""));
    if len(all) == 0 {
      return __sfmt(neg, "0");
    }
    return __sfmt(neg, __cat3("0.", all, ""));
  }
  let mut out: string = __substr(ds, 0, 1);
  let frac: string = __strip0(__substr(ds, 1, prec as usize));
  if len(frac) > 0 {
    out = __cat3(out, __cat3(".", frac, ""), "");
  }
  let mut ae: i64 = e10;
  if ae < 0 {
    ae = 0 - ae;
  }
  let mut es: string = __fmt_i64(ae);
  if ae < 10 {
    es = __cat3("0", es, "");
  }
  if e10 < 0 {
    return __sfmt(neg, __cat3(out, __cat3("e-", es, ""), ""));
  }
  return __sfmt(neg, __cat3(out, __cat3("e+", es, ""), ""));
}

// integral float results keep a visible fraction ("4" -> "4.0") so a float
// never reads as an integer; inf/nan are complete as printed
fn __with_frac(s: string) -> string {
  if s == "inf" || s == "nan" || s == "-inf" || s == "-nan" {
    return s;
  }
  let mut i: usize = 0;
  while i < len(s) {
    if s[i] == 46 || s[i] == 101 {
      return s;
    }
    i += 1;
  }
  return __cat2(s, ".0");
}

fn f64.to_str(self: f64) -> string {
  return __with_frac(__fmt_digits(self, 17));
}

fn f32.to_str(self: f32) -> string {
  // f32 values are exact in f64; 9 significant digits round-trip f32
  return __with_frac(__fmt_digits(self as f64, 9));
}

// --------------------------------------------------------- print --
//
// printf/eprintf/format are compiler builtins: each `{}` in the literal
// format takes the next value's to_str (spec §10.1). A printing call
// desugars into the variadic sinks below — one string run per
// placeholder, one to_str call per value — so printing rides the same
// slice plumbing user variadics do; format desugars into __fmt_build and
// returns the joined string as a value.

fn __fmt_print(parts: string...) {
  let mut i: usize = 0;
  while i < len(parts) {
    __print_str(parts[i]);
    i += 1;
  }
}

fn __fmt_eprint(parts: string...) {
  let mut i: usize = 0;
  while i < len(parts) {
    __eprint_str(parts[i]);
    i += 1;
  }
}

fn __fmt_build(parts: string...) -> string {
  let mut n: usize = 0;
  let mut i: usize = 0;
  while i < len(parts) {
    n += len(parts[i]);
    i += 1;
  }
  let buf: []u8 = make([]u8, n);
  let mut o: usize = 0;
  i = 0;
  while i < len(parts) {
    let p: string = parts[i];
    let mut j: usize = 0;
    while j < len(p) {
      buf[o] = p[j];
      o += 1;
      j += 1;
    }
    i += 1;
  }
  return intrinsics.slice_string(buf);
}
"""; }
fn prelude_mac_src() -> string { return """// arm64-mac prelude tail: freestanding — the runtime stubs (_write, _exit)
// ride in the image (assembled by rho's own assembler), and __alloc is a
// bump allocator over the image heap (zero-filled __DATA tail, initialized
// by _rho_rt_start before main). No libc anywhere.

extern fn write(fd: i32, buf: *u8, n: usize) -> isize;

extern fn exit(code: i32) -> void;

// ---- allocator (0.4.2): size-bucket recycling over the bump heap --------
// six stride classes with a chunk registry (mirrors the wasi tail)

static mut HEAP: usize = 65536;

fn bump_big(n: usize) -> *u8 {
  let p: usize = HEAP;
  let mut end: usize = p + n;
  end = (end + 15) & 18446744073709551600;
  HEAP = end;
  return p as *u8;
}

fn zero_bytes(from: usize, count: usize) {
  let mut k: usize = 0;
  while k + 8 <= count {
    intrinsics.store_u64((from + k) as *u8, 0);
    k += 8;
  }
  while k < count {
    intrinsics.store_u8((from + k) as *u8, 0);
    k += 1;
  }
}

fn dead_mark() -> usize {
  return 6510615555426900570;
}

static mut FL0: usize = 0;
static mut FL1: usize = 0;
static mut FL2: usize = 0;
static mut FL3: usize = 0;
static mut FL4: usize = 0;
static mut FL5: usize = 0;
static mut C0: usize = 0;
static mut E0: usize = 0;
static mut C1: usize = 0;
static mut E1: usize = 0;
static mut C2: usize = 0;
static mut E2: usize = 0;
static mut C3: usize = 0;
static mut E3: usize = 0;
static mut C4: usize = 0;
static mut E4: usize = 0;
static mut C5: usize = 0;
static mut E5: usize = 0;
static mut LO0: usize = 0;
static mut HI0: usize = 0;
static mut LO1: usize = 0;
static mut HI1: usize = 0;
static mut LO2: usize = 0;
static mut HI2: usize = 0;
static mut LO3: usize = 0;
static mut HI3: usize = 0;
static mut LO4: usize = 0;
static mut HI4: usize = 0;
static mut LO5: usize = 0;
static mut HI5: usize = 0;

// chunk registry: every bucket chunk ever carved, as (base, end, class)
// triples in raw bump storage. The per-class LO/HI pair only covers the
// CURRENT chunk — without the registry, a block handed out from an older
// chunk fails the region test when it dies and leaks, the freelist
// starves, and a long compile grinds through chunks it never reuses (the
// emit-phase treadmill: freelists empty while the cursor climbs).
static mut CT: usize = 0;
static mut CTN: usize = 0;
static mut CTC: usize = 0;

fn as_class_stride(k: usize) -> usize {
  if k == 0 { return 64; }
  if k == 1 { return 128; }
  if k == 2 { return 256; }
  if k == 3 { return 512; }
  if k == 4 { return 1024; }
  return 4096;
}

fn as_note_chunk(base: usize, end_: usize, k: usize) {
  if CTN == CTC {
    let mut newcap: usize = 16;
    if CTC != 0 {
      newcap = CTC * 2;
    }
    let p: usize = bump_big(newcap * 24) as usize;
    let mut i: usize = 0;
    while i < CTN * 3 {
      intrinsics.store_u64((p + i * 8) as *u8,
                           intrinsics.load_u64((CT + i * 8) as *u8));
      i += 1;
    }
    CT = p;
    CTC = newcap;
  }
  intrinsics.store_u64((CT + CTN * 24) as *u8, base as u64);
  intrinsics.store_u64((CT + CTN * 24 + 8) as *u8, end_ as u64);
  intrinsics.store_u64((CT + CTN * 24 + 16) as *u8, k as u64);
  CTN += 1;
}

fn __alloc(n: usize) -> *u8 {
  if n <= 64 {
    if FL0 != 0 {
      let h: usize = FL0;
      FL0 = intrinsics.load_u64((h + 16) as *u8) as usize;
      zero_bytes(h + 24, 40);
      return h as *u8;
    }
    if C0 == E0 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 0);
      LO0 = chunk;
      HI0 = chunk + 16777216;
      C0 = chunk + 64;
      E0 = chunk + 16777216;
      zero_bytes(chunk + 24, 40);
      return chunk as *u8;
    }
    let h2: usize = C0;
    C0 = C0 + 64;
    zero_bytes(h2 + 24, 40);
    return h2 as *u8;
  }
  if n <= 128 {
    if FL1 != 0 {
      let h3: usize = FL1;
      FL1 = intrinsics.load_u64((h3 + 16) as *u8) as usize;
      zero_bytes(h3 + 24, 104);
      return h3 as *u8;
    }
    if C1 == E1 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 1);
      LO1 = chunk;
      HI1 = chunk + 16777216;
      C1 = chunk + 128;
      E1 = chunk + 16777216;
      zero_bytes(chunk + 24, 104);
      return chunk as *u8;
    }
    let h4: usize = C1;
    C1 = C1 + 128;
    zero_bytes(h4 + 24, 104);
    return h4 as *u8;
  }
  if n <= 256 {
    if FL2 != 0 {
      let h5: usize = FL2;
      FL2 = intrinsics.load_u64((h5 + 16) as *u8) as usize;
      zero_bytes(h5 + 24, 232);
      return h5 as *u8;
    }
    if C2 == E2 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 2);
      LO2 = chunk;
      HI2 = chunk + 16777216;
      C2 = chunk + 256;
      E2 = chunk + 16777216;
      zero_bytes(chunk + 24, 232);
      return chunk as *u8;
    }
    let h6: usize = C2;
    C2 = C2 + 256;
    zero_bytes(h6 + 24, 232);
    return h6 as *u8;
  }
  if n <= 512 {
    if FL3 != 0 {
      let h7: usize = FL3;
      FL3 = intrinsics.load_u64((h7 + 16) as *u8) as usize;
      zero_bytes(h7 + 24, 488);
      return h7 as *u8;
    }
    if C3 == E3 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 3);
      LO3 = chunk;
      HI3 = chunk + 16777216;
      C3 = chunk + 512;
      E3 = chunk + 16777216;
      zero_bytes(chunk + 24, 488);
      return chunk as *u8;
    }
    let h8: usize = C3;
    C3 = C3 + 512;
    zero_bytes(h8 + 24, 488);
    return h8 as *u8;
  }
  if n <= 1024 {
    if FL4 != 0 {
      let h9: usize = FL4;
      FL4 = intrinsics.load_u64((h9 + 16) as *u8) as usize;
      zero_bytes(h9 + 24, 1000);
      return h9 as *u8;
    }
    if C4 == E4 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 4);
      LO4 = chunk;
      HI4 = chunk + 16777216;
      C4 = chunk + 1024;
      E4 = chunk + 16777216;
      zero_bytes(chunk + 24, 1000);
      return chunk as *u8;
    }
    let h10: usize = C4;
    C4 = C4 + 1024;
    zero_bytes(h10 + 24, 1000);
    return h10 as *u8;
  }
  if n <= 4096 {
    if FL5 != 0 {
      let h11: usize = FL5;
      FL5 = intrinsics.load_u64((h11 + 16) as *u8) as usize;
      zero_bytes(h11 + 24, 4072);
      return h11 as *u8;
    }
    if C5 == E5 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 5);
      LO5 = chunk;
      HI5 = chunk + 16777216;
      C5 = chunk + 4096;
      E5 = chunk + 16777216;
      zero_bytes(chunk + 24, 4072);
      return chunk as *u8;
    }
    let h12: usize = C5;
    C5 = C5 + 4096;
    zero_bytes(h12 + 24, 4072);
    return h12 as *u8;
  }
  return bump_big(n);
}

static mut BADFREE: usize = 0;

fn __free(p: *u8) {
  let a: usize = p as usize;
  if intrinsics.load_u64(a as *u8) == dead_mark() {
    return;
  }
  // the release path frees only after its dec brought the count to zero;
  // a nonzero count here means a stale owner released a block that has
  // since been reused — refuse it (a leak, never a corruption) and say so
  if intrinsics.load_u64(a as *u8) != 0 {
    BADFREE += 1;
    if BADFREE < 8 {
      __eprint_str(__cat3("BADFREE a=", __fmt_u64(a as u64), " rc="));
      __eprint_str(__cat3("", __fmt_u64(intrinsics.load_u64(a as *u8)), "\\n"));
    }
    return;
  }
  if a >= LO0 && a < HI0 && (a - LO0) % 64 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL0 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL0 = a;
    return;
  }
  if a >= LO1 && a < HI1 && (a - LO1) % 128 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL1 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL1 = a;
    return;
  }
  if a >= LO2 && a < HI2 && (a - LO2) % 256 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL2 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL2 = a;
    return;
  }
  if a >= LO3 && a < HI3 && (a - LO3) % 512 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL3 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL3 = a;
    return;
  }
  if a >= LO4 && a < HI4 && (a - LO4) % 1024 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL4 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL4 = a;
    return;
  }
  if a >= LO5 && a < HI5 && (a - LO5) % 4096 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL5 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL5 = a;
    return;
  }
  // exhausted chunks: the block's chunk is in the registry, not in LO/HI
  let mut t: usize = 0;
  while t < CTN {
    let base: usize = intrinsics.load_u64((CT + t * 24) as *u8) as usize;
    let hi: usize = intrinsics.load_u64((CT + t * 24 + 8) as *u8) as usize;
    if a >= base && a < hi {
      let k: usize = intrinsics.load_u64((CT + t * 24 + 16) as *u8) as usize;
      let s: usize = as_class_stride(k);
      if (a - base) % s == 0 {
        if k == 0 {
          intrinsics.store_u64((a + 16) as *u8, FL0 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL0 = a;
          return;
        }
        if k == 1 {
          intrinsics.store_u64((a + 16) as *u8, FL1 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL1 = a;
          return;
        }
        if k == 2 {
          intrinsics.store_u64((a + 16) as *u8, FL2 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL2 = a;
          return;
        }
        if k == 3 {
          intrinsics.store_u64((a + 16) as *u8, FL3 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL3 = a;
          return;
        }
        if k == 4 {
          intrinsics.store_u64((a + 16) as *u8, FL4 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL4 = a;
          return;
        }
        intrinsics.store_u64((a + 16) as *u8, FL5 as u64);
        intrinsics.store_u64(a as *u8, dead_mark() as u64);
        FL5 = a;
        return;
      }
    }
    t += 1;
  }
}

fn __fl_count6(head: usize) -> usize {
  let mut n: usize = 0;
  let mut p: usize = head;
  while p != 0 {
    n += 1;
    p = intrinsics.load_u64((p + 16) as *u8) as usize;
  }
  return n;
}

fn __alloc_dbg() -> usize {
  return __fl_count6(FL0) * 64 + __fl_count6(FL1) * 128 + __fl_count6(FL2) * 256
       + __fl_count6(FL3) * 512 + __fl_count6(FL4) * 1024 + __fl_count6(FL5) * 4096;
}

fn __heap_ptr() -> usize {
  return HEAP;
}


fn __print_str(s: string) {
  write(1, s.ptr, s.len);
}

fn __eprint_str(s: string) {
  write(2, s.ptr, s.len);
}

fn __exit(code: i32) {
  exit(code);
}

// ---- toolchain host hooks (0.3.x): args + file io over the RT blob -------
// The externs below are bound by the runtime blob the image builder ships
// (raw BSD syscalls; argv captured from the LC_MAIN entry registers).
extern fn open(path: *u8, flags: i32, mode: i32) -> i32;
extern fn read(fd: i32, buf: *u8, n: usize) -> isize;
extern fn close(fd: i32) -> i32;
extern fn rename(old_path: *u8, new_path: *u8) -> i32;
extern fn _NSGetArgc() -> *i32;
extern fn _NSGetArgv() -> **u8;

fn __open(path: *u8, flags: i32, mode: i32) -> i32 {
  return open(path, flags, mode);
}

fn __read(fd: i32, buf: *u8, n: usize) -> isize {
  return read(fd, buf, n);
}

fn __write(fd: i32, buf: *u8, n: usize) -> isize {
  return write(fd, buf, n);
}

fn __close(fd: i32) -> i32 {
  return close(fd);
}

// images must land on a fresh vnode: an in-place rewrite of an ad-hoc-signed
// executable leaves the kernel's cached page-hash validation stale and the
// next exec wedges in kernel space. write-to-tmp + __rename is the law for
// every image-producing path on this target.
fn __rename(old_path: *u8, new_path: *u8) -> i32 {
  return rename(old_path, new_path);
}

fn __can_spawn() -> bool {
  return true;
}

fn __program_args() -> []string {
  let count: usize = (*_NSGetArgc()) as usize;
  let raw: *u8 = *_NSGetArgv(); // char**
  let args: []string = make([]string, count);
  let mut i: usize = 0;
  while i < count {
    let s: *u8 = (intrinsics.load_u64((raw as usize + i * 8) as *u8) as usize) as *u8;
    args[i] = __str_from_c(s);
    i += 1;
  }
  return args;
}

// read a NUL-terminated C string out of foreign memory
fn __str_from_c(p: *u8) -> string {
  let mut n: usize = 0;
  loop {
    if intrinsics.load_u8(((p as usize) + n) as *u8) == 0 {
      break;
    }
    n += 1;
  }
  let raw: []u8 = make([]u8, n);
  let mut i: usize = 0;
  while i < n {
    raw[i] = intrinsics.load_u8(((p as usize) + i) as *u8);
    i += 1;
  }
  return intrinsics.slice_string(raw);
}
"""; }
fn prelude_wasi_src() -> string { return """// wasm32-wasi prelude tail: fd_write/proc_write imports, a bump allocator
// over the linear-memory heap, and the per-target hooks the core builds on.

extern fn fd_write(fd: i32, iovs: i32, count: i32, nwritten: i32) -> i32;

extern fn proc_exit(code: i32);

extern fn system(cmd: *u8) -> i32;

extern fn chmod(path: *u8, mode: i32) -> i32;

struct Iov {
  p: i32,
  l: i32,
}

// ---- allocator (0.4.2): size-bucket recycling over the bump heap --------
// SIX-CLASS interim version (fixed convention; no big-class recycling)

static mut HEAP: usize = 65536;

fn bump_big(n: usize) -> *u8 {
  let p: usize = HEAP;
  let mut end: usize = p + n;
  end = (end + 7) & 4294967288;
  if end > 4278190080 {
    __eprint_str("rho: wasm32 heap exhausted\\n");
    __exit(101);
  }
  let cur: usize = intrinsics.mem_size() * 65536;
  if end > cur {
    let pages: usize = (end - cur + 65535) / 65536;
    if intrinsics.mem_grow(pages) == 4294967295 {
      __eprint_str("rho: out of linear memory\\n");
      __exit(101);
    }
  }
  HEAP = end;
  return p as *u8;
}

fn zero_bytes(from: usize, count: usize) {
  let mut k: usize = 0;
  while k + 8 <= count {
    intrinsics.store_u64((from + k) as *u8, 0);
    k += 8;
  }
  while k < count {
    intrinsics.store_u8((from + k) as *u8, 0);
    k += 1;
  }
}

fn dead_mark() -> usize {
  return 6510615555426900570;
}

static mut FL0: usize = 0;
static mut FL1: usize = 0;
static mut FL2: usize = 0;
static mut FL3: usize = 0;
static mut FL4: usize = 0;
static mut FL5: usize = 0;
static mut C0: usize = 0;
static mut E0: usize = 0;
static mut C1: usize = 0;
static mut E1: usize = 0;
static mut C2: usize = 0;
static mut E2: usize = 0;
static mut C3: usize = 0;
static mut E3: usize = 0;
static mut C4: usize = 0;
static mut E4: usize = 0;
static mut C5: usize = 0;
static mut E5: usize = 0;
static mut LO0: usize = 0;
static mut HI0: usize = 0;
static mut LO1: usize = 0;
static mut HI1: usize = 0;
static mut LO2: usize = 0;
static mut HI2: usize = 0;
static mut LO3: usize = 0;
static mut HI3: usize = 0;
static mut LO4: usize = 0;
static mut HI4: usize = 0;
static mut LO5: usize = 0;
static mut HI5: usize = 0;

// chunk registry: every bucket chunk ever carved, as (base, end, class)
// triples in raw bump storage. The per-class LO/HI pair only covers the
// CURRENT chunk — without the registry, a block handed out from an older
// chunk fails the region test when it dies and leaks, the freelist
// starves, and a long compile grinds through chunks it never reuses (the
// emit-phase treadmill: freelists empty while the cursor climbs).
static mut CT: usize = 0;
static mut CTN: usize = 0;
static mut CTC: usize = 0;

fn as_class_stride(k: usize) -> usize {
  if k == 0 { return 64; }
  if k == 1 { return 128; }
  if k == 2 { return 256; }
  if k == 3 { return 512; }
  if k == 4 { return 1024; }
  if k == 5 { return 4096; }
  if k < 16 {
    let mut s: usize = 8192;
    let mut j: usize = k - 6;
    while j > 0 {
      s = s * 2;
      j -= 1;
    }
    return s;
  }
  return 4096;
}

// big classes 6..15 (strides 8K..4M): the emit phase's doubling buffers —
// out-buffers, text slabs, offs tables — all ride sizes past the six small
// strides; without recycling every grown-away intermediate leaks into the
// bump and a self-compile climbs past the wasm32 ceiling. One context
// block holds, per class: freelist head, chunk cursor, chunk end, chunk
// lo, chunk hi (10 classes x 5 slots x 8 bytes).
static mut BCX: usize = 0;

fn bcx_ensure() {
  if BCX == 0 {
    BCX = bump_big(400) as usize;
    zero_bytes(BCX, 400);
  }
}

fn big_class_of(n: usize) -> usize {
  let mut k: usize = 6;
  let mut stride: usize = 8192;
  while stride < n && k < 15 {
    stride = stride * 2;
    k += 1;
  }
  return k;
}

fn as_note_chunk(base: usize, end_: usize, k: usize) {
  if CTN == CTC {
    let mut newcap: usize = 16;
    if CTC != 0 {
      newcap = CTC * 2;
    }
    let p: usize = bump_big(newcap * 24) as usize;
    let mut i: usize = 0;
    while i < CTN * 3 {
      intrinsics.store_u64((p + i * 8) as *u8,
                           intrinsics.load_u64((CT + i * 8) as *u8));
      i += 1;
    }
    CT = p;
    CTC = newcap;
  }
  intrinsics.store_u64((CT + CTN * 24) as *u8, base as u64);
  intrinsics.store_u64((CT + CTN * 24 + 8) as *u8, end_ as u64);
  intrinsics.store_u64((CT + CTN * 24 + 16) as *u8, k as u64);
  CTN += 1;
}

fn __alloc(n: usize) -> *u8 {
  if n <= 64 {
    if FL0 != 0 {
      let h: usize = FL0;
      FL0 = intrinsics.load_u64((h + 16) as *u8) as usize;
      zero_bytes(h + 24, 40);
      return h as *u8;
    }
    if C0 == E0 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 0);
      LO0 = chunk;
      HI0 = chunk + 16777216;
      C0 = chunk + 64;
      E0 = chunk + 16777216;
      zero_bytes(chunk + 24, 40);
      return chunk as *u8;
    }
    let h2: usize = C0;
    C0 = C0 + 64;
    zero_bytes(h2 + 24, 40);
    return h2 as *u8;
  }
  if n <= 128 {
    if FL1 != 0 {
      let h3: usize = FL1;
      FL1 = intrinsics.load_u64((h3 + 16) as *u8) as usize;
      zero_bytes(h3 + 24, 104);
      return h3 as *u8;
    }
    if C1 == E1 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 1);
      LO1 = chunk;
      HI1 = chunk + 16777216;
      C1 = chunk + 128;
      E1 = chunk + 16777216;
      zero_bytes(chunk + 24, 104);
      return chunk as *u8;
    }
    let h4: usize = C1;
    C1 = C1 + 128;
    zero_bytes(h4 + 24, 104);
    return h4 as *u8;
  }
  if n <= 256 {
    if FL2 != 0 {
      let h5: usize = FL2;
      FL2 = intrinsics.load_u64((h5 + 16) as *u8) as usize;
      zero_bytes(h5 + 24, 232);
      return h5 as *u8;
    }
    if C2 == E2 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 2);
      LO2 = chunk;
      HI2 = chunk + 16777216;
      C2 = chunk + 256;
      E2 = chunk + 16777216;
      zero_bytes(chunk + 24, 232);
      return chunk as *u8;
    }
    let h6: usize = C2;
    C2 = C2 + 256;
    zero_bytes(h6 + 24, 232);
    return h6 as *u8;
  }
  if n <= 512 {
    if FL3 != 0 {
      let h7: usize = FL3;
      FL3 = intrinsics.load_u64((h7 + 16) as *u8) as usize;
      zero_bytes(h7 + 24, 488);
      return h7 as *u8;
    }
    if C3 == E3 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 3);
      LO3 = chunk;
      HI3 = chunk + 16777216;
      C3 = chunk + 512;
      E3 = chunk + 16777216;
      zero_bytes(chunk + 24, 488);
      return chunk as *u8;
    }
    let h8: usize = C3;
    C3 = C3 + 512;
    zero_bytes(h8 + 24, 488);
    return h8 as *u8;
  }
  if n <= 1024 {
    if FL4 != 0 {
      let h9: usize = FL4;
      FL4 = intrinsics.load_u64((h9 + 16) as *u8) as usize;
      zero_bytes(h9 + 24, 1000);
      return h9 as *u8;
    }
    if C4 == E4 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 4);
      LO4 = chunk;
      HI4 = chunk + 16777216;
      C4 = chunk + 1024;
      E4 = chunk + 16777216;
      zero_bytes(chunk + 24, 1000);
      return chunk as *u8;
    }
    let h10: usize = C4;
    C4 = C4 + 1024;
    zero_bytes(h10 + 24, 1000);
    return h10 as *u8;
  }
  if n <= 4096 {
    if FL5 != 0 {
      let h11: usize = FL5;
      FL5 = intrinsics.load_u64((h11 + 16) as *u8) as usize;
      zero_bytes(h11 + 24, 4072);
      return h11 as *u8;
    }
    if C5 == E5 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 5);
      LO5 = chunk;
      HI5 = chunk + 16777216;
      C5 = chunk + 4096;
      E5 = chunk + 16777216;
      zero_bytes(chunk + 24, 4072);
      return chunk as *u8;
    }
    let h12: usize = C5;
    C5 = C5 + 4096;
    zero_bytes(h12 + 24, 4072);
    return h12 as *u8;
  }
  if n <= 4194304 {
    bcx_ensure();
    let k: usize = big_class_of(n);
    let j: usize = k - 6;
    let stride: usize = as_class_stride(k);
    let head: usize = intrinsics.load_u64((BCX + j * 8) as *u8) as usize;
    if head != 0 {
      intrinsics.store_u64((BCX + j * 8) as *u8,
                           intrinsics.load_u64((head + 16) as *u8));
      zero_bytes(head + 24, stride - 24);
      return head as *u8;
    }
    let mut cur: usize = intrinsics.load_u64((BCX + 80 + j * 8) as *u8) as usize;
    let endr: usize = intrinsics.load_u64((BCX + 160 + j * 8) as *u8) as usize;
    if cur == endr {
      let mut want: usize = 16777216;
      if stride * 8 > want {
        want = stride * 8;
      }
      let chunk: usize = bump_big(want) as usize;
      as_note_chunk(chunk, chunk + want, k);
      intrinsics.store_u64((BCX + 240 + j * 8) as *u8, chunk as u64);
      intrinsics.store_u64((BCX + 320 + j * 8) as *u8, (chunk + want) as u64);
      intrinsics.store_u64((BCX + 80 + j * 8) as *u8, (chunk + stride) as u64);
      intrinsics.store_u64((BCX + 160 + j * 8) as *u8, (chunk + want) as u64);
      cur = chunk + stride;
      zero_bytes(chunk + 24, stride - 24);
      return chunk as *u8;
    }
    intrinsics.store_u64((BCX + 80 + j * 8) as *u8, (cur + stride) as u64);
    zero_bytes(cur + 24, stride - 24);
    return cur as *u8;
  }
  return bump_big(n);
}

static mut BADFREE: usize = 0;

fn __free(p: *u8) {
  let a: usize = p as usize;
  if intrinsics.load_u64(a as *u8) == dead_mark() {
    return;
  }
  // the release path frees only after its dec brought the count to zero;
  // a nonzero count here means a stale owner released a block that has
  // since been reused — refuse it (a leak, never a corruption) and say so
  if intrinsics.load_u64(a as *u8) != 0 {
    BADFREE += 1;
    if BADFREE < 8 {
      __eprint_str(__cat3("BADFREE a=", __fmt_u64(a as u64), " rc="));
      __eprint_str(__cat3("", __fmt_u64(intrinsics.load_u64(a as *u8)), "\\n"));
    }
    return;
  }
  if a >= LO0 && a < HI0 && (a - LO0) % 64 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL0 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL0 = a;
    return;
  }
  if a >= LO1 && a < HI1 && (a - LO1) % 128 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL1 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL1 = a;
    return;
  }
  if a >= LO2 && a < HI2 && (a - LO2) % 256 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL2 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL2 = a;
    return;
  }
  if a >= LO3 && a < HI3 && (a - LO3) % 512 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL3 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL3 = a;
    return;
  }
  if a >= LO4 && a < HI4 && (a - LO4) % 1024 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL4 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL4 = a;
    return;
  }
  if a >= LO5 && a < HI5 && (a - LO5) % 4096 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL5 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL5 = a;
    return;
  }
  // big classes: the current chunk per class lives in the BCX lo/hi pair
  if BCX != 0 {
    let mut j: usize = 0;
    while j < 10 {
      let blo: usize = intrinsics.load_u64((BCX + 240 + j * 8) as *u8) as usize;
      let bhi: usize = intrinsics.load_u64((BCX + 320 + j * 8) as *u8) as usize;
      if a >= blo && a < bhi {
        let s2: usize = as_class_stride(j + 6);
        if (a - blo) % s2 == 0 {
          intrinsics.store_u64((a + 16) as *u8,
                               intrinsics.load_u64((BCX + j * 8) as *u8));
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          intrinsics.store_u64((BCX + j * 8) as *u8, a as u64);
          return;
        }
      }
      j += 1;
    }
  }
  // exhausted chunks: the block's chunk is in the registry, not in LO/HI
  let mut t: usize = 0;
  while t < CTN {
    let base: usize = intrinsics.load_u64((CT + t * 24) as *u8) as usize;
    let hi: usize = intrinsics.load_u64((CT + t * 24 + 8) as *u8) as usize;
    if a >= base && a < hi {
      let k: usize = intrinsics.load_u64((CT + t * 24 + 16) as *u8) as usize;
      let s: usize = as_class_stride(k);
      if (a - base) % s == 0 {
        if k == 0 {
          intrinsics.store_u64((a + 16) as *u8, FL0 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL0 = a;
          return;
        }
        if k == 1 {
          intrinsics.store_u64((a + 16) as *u8, FL1 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL1 = a;
          return;
        }
        if k == 2 {
          intrinsics.store_u64((a + 16) as *u8, FL2 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL2 = a;
          return;
        }
        if k == 3 {
          intrinsics.store_u64((a + 16) as *u8, FL3 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL3 = a;
          return;
        }
        if k == 4 {
          intrinsics.store_u64((a + 16) as *u8, FL4 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL4 = a;
          return;
        }
        if k == 5 {
          intrinsics.store_u64((a + 16) as *u8, FL5 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL5 = a;
          return;
        }
        // big class: push onto its BCX freelist (BCX is live — the class
        // carved a chunk through bcx_ensure before this block existed)
        let bj: usize = k - 6;
        intrinsics.store_u64((a + 16) as *u8,
                             intrinsics.load_u64((BCX + bj * 8) as *u8));
        intrinsics.store_u64(a as *u8, dead_mark() as u64);
        intrinsics.store_u64((BCX + bj * 8) as *u8, a as u64);
        return;
      }
    }
    t += 1;
  }
}

fn __fl_count6(head: usize) -> usize {
  let mut n: usize = 0;
  let mut p: usize = head;
  while p != 0 {
    n += 1;
    p = intrinsics.load_u64((p + 16) as *u8) as usize;
  }
  return n;
}

fn __alloc_dbg() -> usize {
  return __fl_count6(FL0) * 64 + __fl_count6(FL1) * 128 + __fl_count6(FL2) * 256
       + __fl_count6(FL3) * 512 + __fl_count6(FL4) * 1024 + __fl_count6(FL5) * 4096;
}

fn __heap_ptr() -> usize {
  return HEAP;
}


// TEMP instrumentation (strip before release): walk every bucket freelist
// and report how many blocks are parked — carved minus parked minus the
// per-class residue is the live estimate
fn __print_str(s: string) {
  let iov = new Iov { p: (s.ptr as usize) as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(1, iov as usize as i32, 1, nw as usize as i32);
}

fn __eprint_str(s: string) {
  let iov = new Iov { p: (s.ptr as usize) as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(2, iov as usize as i32, 1, nw as usize as i32);
}

fn __exit(code: i32) {
  proc_exit(code);
}

// ---- toolchain host hooks (0.3.x): args + file io over raw wasi ----------
// The self-hosted compiler body calls these per-target hooks; this tail
// implements them over wasi_snapshot_preview1. fd 3 is the preopened
// working directory wasmtime hands the guest.

extern fn args_sizes_get(count: i32, buf: i32) -> i32;
extern fn args_get(argv: i32, buf: i32) -> i32;
extern fn path_open(fd: i32, dirflags: i32, path: i32, path_len: i32,
                    oflags: i32, rights_base: u64, rights_inheriting: u64,
                    fdflags: i32, opened: i32) -> i32;
extern fn fd_read(fd: i32, iovs: i32, iovs_len: i32, nread: i32) -> i32;
extern fn fd_close(fd: i32) -> i32;
// wasmtime 40's preview1 adapter takes the two-directory form:
// (old_fd, old_path, old_len, new_fd, new_path, new_len)
extern fn path_rename(old_fd: i32, old_path: i32, old_path_len: i32,
                      new_fd: i32, new_path: i32, new_path_len: i32) -> i32;

fn __c_len(p: *u8) -> i32 {
  let mut n: i32 = 0;
  loop {
    if intrinsics.load_u8(((p as usize) + (n as usize)) as *u8) == 0 {
      break;
    }
    n += 1;
  }
  return n;
}

// flags: 0 = read-only, nonzero = create/truncate + write
fn __open(path: *u8, flags: i32, mode: i32) -> i32 {
  let plen: i32 = __c_len(path);
  let mut oflags: i32 = 0;
  let mut rights: u64 = 2; // FD_READ
  if flags != 0 {
    oflags = 1 | 8; // CREAT | TRUNC
    rights = (2 | 4) as u64; // FD_READ | FD_WRITE
  }
  let out: *u8 = __alloc(4);
  let err: i32 = path_open(3, 0, path as usize as i32, plen, oflags,
                           rights, rights, 0, out as usize as i32);
  if err != 0 {
    return -1;
  }
  return intrinsics.load_u64(out) as i32;
}

fn __read(fd: i32, buf: *u8, n: usize) -> isize {
  let iov = new Iov { p: buf as usize as i32, l: n as i32 };
  let nr = new Iov { p: 0, l: 0 };
  if fd_read(fd, iov as usize as i32, 1, nr as usize as i32) != 0 {
    return -1;
  }
  // the out-param address IS &nr (the struct base): the count lands in .p
  return nr.p as isize;
}

// one line from stdin, the newline stripped; "" at EOF. Byte-at-a-time so
// the reader never consumes past the line — a following read_line continues
// exactly where this one stopped
fn read_line() -> string {
  let mut buf: []u8 = make([]u8, 128);
  let mut n: usize = 0;
  loop {
    if n + 1 >= len(buf) {
      let grown: []u8 = make([]u8, len(buf) * 2);
      let mut k: usize = 0;
      while k < n {
        grown[k] = buf[k];
        k += 1;
      }
      buf = grown;
    }
    if __read(0, ((buf.ptr as usize) + n) as *u8, 1) <= 0 {
      break;
    }
    if buf[n] == 10 {
      break;
    }
    n += 1;
  }
  return intrinsics.slice_string(buf[0..n]);
}

fn __write(fd: i32, buf: *u8, n: usize) -> isize {
  let iov = new Iov { p: buf as usize as i32, l: n as i32 };
  let nw = new Iov { p: 0, l: 0 };
  if fd_write(fd, iov as usize as i32, 1, nw as usize as i32) != 0 {
    return -1;
  }
  // the out-param address IS &nw (the struct base): the count lands in .p
  return nw.p as isize;
}

fn __close(fd: i32) -> i32 {
  return fd_close(fd);
}

// tmp+rename keeps every write on a fresh path; over WASI it rides the
// preopened cwd (fd 3), so both paths must be relative to it
fn __rename(old_path: *u8, new_path: *u8) -> i32 {
  return path_rename(3, old_path as usize as i32, __c_len(old_path),
                     3, new_path as usize as i32, __c_len(new_path));
}

fn __can_spawn() -> bool {
  return false;
}

fn __program_args() -> []string {
  let info: *u8 = __alloc(8); // [count: i32][bufsize: i32]
  if args_sizes_get(info as usize as i32, ((info as usize) + 4) as i32) != 0 {
    return make([]string, 0);
  }
  let count: usize = intrinsics.load_u32(info) as usize;
  let bufsize: usize = intrinsics.load_u32(((info as usize) + 4) as *u8) as usize;
  if count == 0 {
    return make([]string, 0);
  }
  let argv: *u8 = __alloc(count * 4 + 8);
  let buf: *u8 = __alloc(bufsize + 8);
  if args_get(argv as usize as i32, buf as usize as i32) != 0 {
    return make([]string, 0);
  }
  let args: []string = make([]string, count);
  let mut i: usize = 0;
  while i < count {
    let p: usize = intrinsics.load_u32(((argv as usize) + (i * 4)) as *u8) as usize;
    let n: usize = __c_len(p as *u8) as usize;
    let raw: []u8 = make([]u8, n);
    let mut k: usize = 0;
    while k < n {
      raw[k] = intrinsics.load_u8(((p as usize) + k) as *u8);
      k += 1;
    }
    args[i] = intrinsics.slice_string(raw);
    i += 1;
  }
  return args;
}
"""; }
fn prelude_hosted_src() -> string { return """// hosted prelude tail (amd64-linux / arm64-mac): libc externs, the four
// per-target hooks the core builds on (__print_str / __eprint_str / __exit
// / __alloc / __free), and the cc-runner externs the toolchain itself uses.

extern fn malloc(n: usize) -> *u8;

extern fn calloc(nm: usize, sz: usize) -> *u8;

extern fn free(p: *u8);

extern fn system(cmd: *u8) -> i32;

extern fn chmod(path: *u8, mode: i32) -> i32;

extern fn write(fd: i32, buf: *u8, n: usize) -> isize;

extern fn exit(code: i32) -> void;

fn __alloc(n: usize) -> *u8 {
  // zeroed: fresh element slots read as null references, so the first
  // assignment into a slot releases null (a no-op) instead of stale heap
  // bytes reinterpreted as a reference count
  return calloc(1, n);
}

fn __free(p: *u8) {
  free(p);
}
fn __heap_ptr() -> usize {
  return 0; // hosted allocates through libc; there is no bump pointer
}


fn __print_str(s: string) {
  write(1, s.ptr, s.len);
}

fn __eprint_str(s: string) {
  write(2, s.ptr, s.len);
}

fn __exit(code: i32) {
  exit(code);
}

// ---- toolchain host hooks (0.3.x): args + file io over libc --------------
extern fn open(path: *u8, flags: i32, mode: i32) -> i32;
extern fn read(fd: i32, buf: *u8, n: usize) -> isize;
extern fn close(fd: i32) -> i32;
extern fn _NSGetArgc() -> *i32;
extern fn _NSGetArgv() -> **u8;

fn __open(path: *u8, flags: i32, mode: i32) -> i32 {
  return open(path, flags, mode);
}

fn __read(fd: i32, buf: *u8, n: usize) -> isize {
  return read(fd, buf, n);
}

fn __write(fd: i32, buf: *u8, n: usize) -> isize {
  return write(fd, buf, n);
}

fn __close(fd: i32) -> i32 {
  return close(fd);
}

fn __can_spawn() -> bool {
  return true;
}

fn __program_args() -> []string {
  let count: usize = (*_NSGetArgc()) as usize;
  let raw: *u8 = *_NSGetArgv(); // char**
  let args: []string = make([]string, count);
  let mut i: usize = 0;
  while i < count {
    let s: *u8 = (intrinsics.load_u64((raw as usize + i * 8) as *u8) as usize) as *u8;
    args[i] = __str_from_c(s);
    i += 1;
  }
  return args;
}

// read a NUL-terminated C string out of foreign memory
fn __str_from_c(p: *u8) -> string {
  let mut n: usize = 0;
  loop {
    if intrinsics.load_u8(((p as usize) + n) as *u8) == 0 {
      break;
    }
    n += 1;
  }
  let raw: []u8 = make([]u8, n);
  let mut i: usize = 0;
  while i < n {
    raw[i] = intrinsics.load_u8(((p as usize) + i) as *u8);
    i += 1;
  }
  return intrinsics.slice_string(raw);
}
"""; }
// core + per-target tail, concatenated exactly as tools/embed.py
// does for the boot compiler — the image is standalone (no boot/
// tree, no CWD dependence)
pub fn read_prelude(tail: string) -> Result[string, string] {
  if cli.streq(tail, "mac.rho") {
    return Result.Ok(prelude_core_src() + prelude_mac_src());
  }
  if cli.streq(tail, "wasi.rho") {
    return Result.Ok(prelude_core_src() + prelude_wasi_src());
  }
  if cli.streq(tail, "hosted.rho") {
    return Result.Ok(prelude_core_src() + prelude_hosted_src());
  }
  return Result.Ok(prelude_core_src());
}
