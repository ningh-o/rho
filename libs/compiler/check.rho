// check.rho — the self-hosted compiler's checker seed (T2.2 growth).
// The full type layer grows here; today it walks the fn table and
// the statements proving every CALLED name has a definition and every
// variable reference is bound — unknown names are errors (exit 1)
// before emission runs.
use parse;

pub fn name_known(prog: *Prog, name: string) -> bool {
  if name == "len" || name == "assert" || name == "format" ||
      name == "assert_eq" || name == "printf" || name == "eprintf" ||
      name == "panic" {
    return true;
  }
  if name == "__fd_read_packed" || name == "__fd_write" ||
      name == "__fd_close" || name == "__path_open" ||
      name == "__string_from" {
    // std.io's raw window: the kernel's wasi tail, lowered by the
    // emitter (the __ face is never user-callable by law, but the
    // names anchor here like printf's do)
    return true;
  }
  if name == "weak" {
    // the weak namespace's only member: weak.from(p) — the identity
    return true;
  }
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name == name {
      return true;
    }
    i = i + 1;
  }
  // name[T1, T2] — a generic fn named with explicit type arguments
  // (the wall lift: callers name generic types): the base must be a
  // fn and the argument count must match its declaration (the emitter
  // instantiates from the folded spelling)
  if parse.has_targs(name) {
    let base: string = parse.targs_base(name);
    let mut j: usize = 0;
    while j < len(prog.fns) {
      if prog.fns[j].name == base && len(prog.fns[j].tparams) > 0 {
        let mut ob: usize = 0;
        while ob < len(name) {
          if name[ob] == 91 {
            break;
          }
          ob = ob + 1;
        }
        return targs_arg_count(name, ob) ==
            (len(prog.fns[j].tparams) as i64);
      }
      j = j + 1;
    }
  }
  return false;
}

// depth-0 commas inside name[(ob+1)..len-1], plus one — the folded
// type-argument count
fn targs_arg_count(name: string, ob: usize) -> i64 {
  let mut n: i64 = 1;
  let mut depth: i64 = 0;
  let mut i: usize = ob + 1;
  while i + 1 < len(name) {
    if name[i] == 91 {
      depth = depth + 1;
    }
    if name[i] == 93 {
      depth = depth - 1;
    }
    if name[i] == 44 && depth == 0 {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

pub fn enum_known(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < prog.nenums {
    if prog.enums[i].name == name {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// the variant's tag, -1 when the enum or variant is unknown
pub fn enum_variant(prog: *Prog, ename: string,
                    vname: string) -> i64 {
  let mut i: usize = 0;
  while i < prog.nenums {
    if prog.enums[i].name == ename {
      let mut k: usize = 0;
      while k < prog.enums[i].nv {
        if prog.enums[i].vnames[k] == vname {
          return k as i64;
        }
        k = k + 1;
      }
      return 0 - 1;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub fn struct_known(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < prog.nstructs {
    if prog.structs[i].name == name {
      return true;
    }
    i = i + 1;
  }
  // Name[args] — the base must be a generic struct and the argument
  // count must match its declaration (the emitter instantiates)
  let ob: i64 = bracket_at(name);
  if ob >= 0 && name[len(name) - 1..len(name)] == "]" {
    let base: string = name[0..(ob as usize)];
    let mut j: usize = 0;
    while j < prog.nstructs {
      if prog.structs[j].name == base &&
          len(prog.structs[j].tparams) > 0 {
        return arg_count(name, ob) ==
            (len(prog.structs[j].tparams) as i64);
      }
      j = j + 1;
    }
  }
  return false;
}

// the index of the first '[' in a text, -1 when none
fn bracket_at(s: string) -> i64 {
  let mut i: usize = 0;
  while i < len(s) {
    if s[i] == 91 {
      return i as i64;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// depth-0 commas inside name[(ob+1)..len-1], plus one
fn arg_count(name: string, ob: i64) -> i64 {
  let mut n: i64 = 1;
  let mut depth: i64 = 0;
  let mut i: usize = (ob as usize) + 1;
  while i < len(name) - 1 {
    let mut b: u8 = name[i];
    if b == 91 {
      depth = depth + 1;
    }
    if b == 93 {
      depth = depth - 1;
    }
    if b == 44 && depth == 0 {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

fn fn_named(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name == name {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// some Type.method exists (the receiver's own type is beyond the
// name-level checker — suffix match keeps the refusal honest)
fn method_known(prog: *Prog, mname: string) -> bool {
  if mname == "get" {
    // weak.get() — the absence probe over the header's rc
    return true;
  }
  if mname == "is_some" || mname == "is_none" || mname == "is_ok" ||
      mname == "is_err" {
    // the absence faces over Option/Result boxes — the emitter reads
    // the tag slot natively (the boot prelude's match arms, twinned)
    return true;
  }
  let mut i: usize = 0;
  while i < len(prog.fns) {
    let n: string = prog.fns[i].name;
    if len(n) > len(mname) + 1 &&
       n[len(n) - len(mname) - 1] == 46 {
      let mut k: usize = 0;
      let mut hit: bool = true;
      while k < len(mname) {
        if n[len(n) - len(mname) + k] != mname[k] {
          hit = false;
        }
        k = k + 1;
      }
      if hit {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

// the scalar faces the §6.8 capture law refuses on: a mut binding of
// one of these types carries its value IN the binding, so the
// closure's copy diverges on any rebind
fn vty_scalar(ty: string) -> bool {
  return ty == "i8" || ty == "i16" || ty == "i32" || ty == "i64" ||
         ty == "u8" || ty == "u16" || ty == "u32" || ty == "u64" ||
         ty == "usize" || ty == "f32" || ty == "f64" || ty == "bool";
}

// §6.8's walker: the closure body's identifier reads are its
// captures. The body walks in its OWN stack (seeded with the
// enclosing bindings, the closure's params shadowing first) — rho's
// value semantics pop every inner scope for free, so an inner `let`
// of the same name shadows the capture out of the law's reach and a
// nested closure enforces its own captures against what it sees.
fn clo_captures(e: *Expr, bound: []string, muts: []bool, vtys: []bool,
                nb: usize, mut errs: *ErrBox) {
  let mut n: usize = nb;
  let mut names: []string = make([]string, 128);
  let mut imuts: []bool = make([]bool, 128);
  let mut ivtys: []bool = make([]bool, 128);
  let mut si: usize = 0;
  while si < nb && n < 128 {
    names[n] = bound[si];
    imuts[n] = muts[si];
    ivtys[n] = vtys[si];
    n = n + 1;
    si = si + 1;
  }
  let mut k: usize = 0;
  while k < len(e.fnames) && n < 128 {
    names[n] = e.fnames[k];
    imuts[n] = false;
    ivtys[n] = false;
    n = n + 1;
    k = k + 1;
  }
  if len(e.marms) > 0 {
    clo_stmts(e.marms[0].body, mut names, mut imuts, mut ivtys, n, mut errs);
  }
}

fn clo_expr(e: *Expr, mut names: []string, mut imuts: []bool,
            mut ivtys: []bool, n: usize, mut errs: *ErrBox) {
  let mut n: usize = n;
  if e.tag == parse.EX_VAR {
    // innermost binding wins (boot's lookup): scan from the top and
    // judge only the first name hit
    let mut k: usize = n;
    while k > 0 {
      k = k - 1;
      if names[k] == e.name {
        if imuts[k] && ivtys[k] {
          eprintf("check: a closure may not capture the mut local '{}' (a value copy would diverge; share a heap object through a pointer instead)\n", e.name);
          errs.n = errs.n + 1;
        }
        return;
      }
    }
    return;
  }
  if e.tag == parse.EX_CLO {
    let mut k2: usize = 0;
    while k2 < len(e.fnames) && n < len(names) {
      names[n] = e.fnames[k2];
      imuts[n] = false;
      ivtys[n] = false;
      n = n + 1;
      k2 = k2 + 1;
    }
    if len(e.marms) > 0 {
      clo_stmts(e.marms[0].body, mut names, mut imuts, mut ivtys, n, mut errs);
    }
    return;
  }
  match e.lhs {
    Option.Some(b) => {
      clo_expr(b, mut names, mut imuts, mut ivtys, n, mut errs);
    },
    Option.None => {},
  }
  match e.rhs {
    Option.Some(r) => {
      clo_expr(r, mut names, mut imuts, mut ivtys, n, mut errs);
    },
    Option.None => {},
  }
  let mut k3: usize = 0;
  while k3 < len(e.args) {
    clo_expr(e.args[k3], mut names, mut imuts, mut ivtys, n, mut errs);
    k3 = k3 + 1;
  }
  let mut k4: usize = 0;
  while k4 < len(e.marms) {
    let arm = e.marms[k4];
    let mut b0 = new NameBox { names: make([]string, 8), n: 0 };
    pat_binders_into(arm.pat, mut b0);
    let mut k5: usize = 0;
    while k5 < b0.n && n < len(names) {
      names[n] = b0.names[k5];
      imuts[n] = false;
      ivtys[n] = false;
      n = n + 1;
      k5 = k5 + 1;
    }
    match arm.val {
      Option.Some(av) => {
        clo_expr(av, mut names, mut imuts, mut ivtys, n, mut errs);
      },
      Option.None => {},
    }
    match arm.guard {
      Option.Some(gd) => {
        clo_expr(gd, mut names, mut imuts, mut ivtys, n, mut errs);
      },
      Option.None => {},
    }
    clo_stmts(arm.body, mut names, mut imuts, mut ivtys, n, mut errs);
    k4 = k4 + 1;
  }
}

fn clo_stmts(nodes: []*Stmt, mut names: []string, mut imuts: []bool,
             mut ivtys: []bool, n: usize, mut errs: *ErrBox) {
  let mut n: usize = n;
  let mut i: usize = 0;
  while i < len(nodes) {
    let st = nodes[i];
    if st.tag == parse.ST_LET {
      match st.val {
        Option.Some(v) => {
          clo_expr(v, mut names, mut imuts, mut ivtys, n, mut errs);
        },
        Option.None => {},
      }
      if n < len(names) {
        names[n] = st.name;
        imuts[n] = st.ret == 1;
        ivtys[n] = false;
        if len(st.fmt) > 0 {
          ivtys[n] = vty_scalar(st.fmt);
        } else {
          match st.val {
            Option.Some(e9) => {
              ivtys[n] = e9.tag == parse.EX_LIT;
            },
            Option.None => {},
          }
        }
        n = n + 1;
      }
    }
    if st.tag == parse.ST_SET || st.tag == parse.ST_CALL ||
        st.tag == parse.ST_RET || st.tag == parse.ST_PF {
      match st.val {
        Option.Some(v) => {
          clo_expr(v, mut names, mut imuts, mut ivtys, n, mut errs);
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_ISTORE || st.tag == parse.ST_FSTORE {
      let mut k: usize = 0;
      while k < len(st.args) {
        clo_expr(st.args[k], mut names, mut imuts, mut ivtys, n, mut errs);
        k = k + 1;
      }
      match st.val {
        Option.Some(v) => {
          clo_expr(v, mut names, mut imuts, mut ivtys, n, mut errs);
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_MATCH {
      match st.val {
        Option.Some(sc) => {
          clo_expr(sc, mut names, mut imuts, mut ivtys, n, mut errs);
        },
        Option.None => {},
      }
      let mut k2: usize = 0;
      while k2 < len(st.marms) {
        let arm = st.marms[k2];
        let mut b0 = new NameBox { names: make([]string, 8), n: 0 };
        pat_binders_into(arm.pat, mut b0);
        let mut k5: usize = 0;
        while k5 < b0.n && n < len(names) {
          names[n] = b0.names[k5];
          imuts[n] = false;
          ivtys[n] = false;
          n = n + 1;
          k5 = k5 + 1;
        }
        match arm.val {
          Option.Some(av) => {
            clo_expr(av, mut names, mut imuts, mut ivtys, n, mut errs);
          },
          Option.None => {},
        }
        match arm.guard {
          Option.Some(gd) => {
            clo_expr(gd, mut names, mut imuts, mut ivtys, n, mut errs);
          },
          Option.None => {},
        }
        clo_stmts(arm.body, mut names, mut imuts, mut ivtys, n, mut errs);
        k2 = k2 + 1;
      }
    }
    if st.tag == parse.ST_IF || st.tag == parse.ST_WHILE ||
        st.tag == parse.ST_LOOP || st.tag == parse.ST_BLOCK {
      match st.val {
        Option.Some(v) => {
          clo_expr(v, mut names, mut imuts, mut ivtys, n, mut errs);
        },
        Option.None => {},
      }
      clo_stmts(st.body, mut names, mut imuts, mut ivtys, n, mut errs);
      clo_stmts(st.body2, mut names, mut imuts, mut ivtys, n, mut errs);
    }
    if st.tag == parse.ST_DEFER {
      match st.sub {
        Option.Some(inner) => {
          let mut one: []*Stmt = make([]*Stmt, 1);
          one[0] = inner;
          clo_stmts(one, mut names, mut imuts, mut ivtys, n, mut errs);
        },
        Option.None => {},
      }
    }
    i = i + 1;
  }
}

fn expr_walk(e: *Expr, prog: *Prog, mut bound: []string, mut muts: []bool,
             mut vtys: []bool, nb: usize, mut errs: *ErrBox) {
  if e.tag == parse.EX_MAKE {
    let mut k: usize = 0;
    while k < len(e.args) {
      expr_walk(e.args[k], prog, mut bound, mut muts, mut vtys, nb, mut errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_IDX {
    match e.lhs {
      Option.Some(b) => {
        expr_walk(b, prog, mut bound, mut muts, mut vtys, nb, mut errs);
      },
      Option.None => {},
    }
    match e.rhs {
      Option.Some(i) => {
        expr_walk(i, prog, mut bound, mut muts, mut vtys, nb, mut errs);
      },
      Option.None => {},
    }
    return;
  }
  if e.tag == parse.EX_SLICE2 {
    match e.lhs {
      Option.Some(b) => {
        expr_walk(b, prog, mut bound, mut muts, mut vtys, nb, mut errs);
      },
      Option.None => {},
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      expr_walk(e.args[k], prog, mut bound, mut muts, mut vtys, nb, mut errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_NEW {
    if !struct_known(prog, e.name) {
      eprintf("check: unknown struct '{}'\n", e.name);
      errs.n = errs.n + 1;
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      expr_walk(e.args[k], prog, mut bound, mut muts, mut vtys, nb, mut errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_FIELD || e.tag == parse.EX_DEREF {
    // Enum.Var without call parens — the unit-variant constructor
    if e.tag == parse.EX_FIELD {
      match e.lhs {
        Option.Some(b) => {
          if b.tag == parse.EX_VAR && (enum_known(prog, b.name) ||
              b.name == "Option" || b.name == "Result") {
            if enum_variant(prog, b.name, e.name) < 0 &&
                !(b.name == "Option" || b.name == "Result") {
              eprintf("check: unknown variant '{}.{}'\n", b.name, e.name);
              errs.n = errs.n + 1;
            }
            return;
          }
        },
        Option.None => {},
      }
    }
    match e.lhs {
      Option.Some(b) => {
        expr_walk(b, prog, mut bound, mut muts, mut vtys, nb, mut errs);
      },
      Option.None => {},
    }
    return;
  }
  if e.tag == parse.EX_Q {
    match e.lhs {
      Option.Some(inner) => {
        expr_walk(inner, prog, mut bound, mut muts, mut vtys, nb, mut errs);
      },
      Option.None => {},
    }
    return;
  }
  if e.tag == parse.EX_MATCH {
    match e.lhs {
      Option.Some(sc) => {
        expr_walk(sc, prog, mut bound, mut muts, mut vtys, nb, mut errs);
      },
      Option.None => {},
    }
    let mut k: usize = 0;
    while k < len(e.marms) {
      walk_arm(e.marms[k], prog, mut bound, mut muts, mut vtys, nb, mut errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_MCALL {
    let mut assoc: bool = false;
    // §18: markers pair on real methods and associated fns only —
    // enum constructors, weak.from, and the zero-arg builtin faces
    // never pair in boot
    let mut pair: bool = false;
    match e.lhs {
      Option.Some(r) => {
        if r.tag == parse.EX_VAR && (enum_known(prog, r.name) ||
            r.name == "Option" || r.name == "Result") {
          // Enum.Var / Enum.Var(args) — the constructor call (the
          // two builtins ride the same path)
          assoc = true;
          if enum_variant(prog, r.name, e.name) < 0 &&
              !(r.name == "Option" || r.name == "Result") {
            eprintf("check: unknown variant '{}.{}'\n", r.name, e.name);
            errs.n = errs.n + 1;
          }
        } else {
        if e.name == "to_str" {
          // the prelude's to_str rides every primitive
          let mut ka: usize = 0;
          while ka < len(e.args) {
            expr_walk(e.args[ka], prog, mut bound, mut muts, mut vtys, nb, mut errs);
            ka = ka + 1;
          }
          return;
        }
        if r.tag == parse.EX_VAR && r.name == "weak" {
          // weak.from(p) — the namespace's one builtin (get() rides
          // the method surface below)
          if e.name != "from" {
            eprintf("check: unknown fn 'weak.{}'\n", e.name);
            errs.n = errs.n + 1;
          }
        } else {
        if r.tag == parse.EX_VAR && struct_known(prog, r.name) {
          // Type.name(args) — the associated-fn call; the type itself
          // is not a variable reference
          assoc = true;
          if !fn_named(prog, r.name + "." + e.name) {
            eprintf("check: unknown fn '{}.{}'\n", r.name, e.name);
            errs.n = errs.n + 1;
          }
          pair = true;
        } else {
          expr_walk(r, prog, mut bound, mut muts, mut vtys, nb, mut errs);
          if !method_known(prog, e.name) {
            eprintf("check: unknown method '{}'\n", e.name);
            errs.n = errs.n + 1;
          }
          if e.name != "get" && e.name != "is_some" &&
              e.name != "is_none" && e.name != "is_ok" &&
              e.name != "is_err" {
            pair = true;
          }
        }
        }
        }
      },
      Option.None => {},
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      if pair {
        marker_law(e.args[k], bound, muts, nb, mut errs);
      }
      expr_walk(e.args[k], prog, mut bound, mut muts, mut vtys, nb, mut errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_CLO {
    // a closure literal: its body binds its own params and captures
    // (the emitter resolves captures against the enclosing env) — and
    // §6.8's capture law runs here: a mut local of VALUE type may not
    // ride along (the copy would diverge from the original on any
    // rebind). Managed handles capture fine; the law refuses only on
    // knowledge, so an untyped binding stays allowed.
    clo_captures(e, bound, muts, vtys, nb, mut errs);
    return;
  }
  if e.tag == parse.EX_CALL {
    // call-on-call: the callee is an expression, not a name — walk it
    if len(e.name) == 0 {
      match e.lhs {
        Option.Some(callee) => {
          expr_walk(callee, prog, mut bound, mut muts, mut vtys, nb, mut errs);
        },
        Option.None => {},
      }
      let mut k3: usize = 0;
      while k3 < len(e.args) {
        // §18: boot pairs markers against the fn-value signature —
        // the root-binding tail rides here
        marker_law(e.args[k3], bound, muts, nb, mut errs);
        expr_walk(e.args[k3], prog, mut bound, mut muts, mut vtys, nb, mut errs);
        k3 = k3 + 1;
      }
      return;
    }
    // a locally-bound name (a closure value) is callable
    let mut isbound: bool = false;
    let mut b: usize = 0;
    while b < nb {
      if bound[b] == e.name {
        isbound = true;
      }
      b = b + 1;
    }
    if !isbound && !name_known(prog, e.name) {
      eprintf("check: unknown fn '{}'\n", e.name);
      errs.n = errs.n + 1;
    }
    // §18: markers pair against a DECLARED fn's signature (builtins
    // and fn values never pair in boot) — the root-binding tail
    if !isbound && user_fn_named(prog, e.name) {
      let mut kp: usize = 0;
      while kp < len(e.args) {
        marker_law(e.args[kp], bound, muts, nb, mut errs);
        kp = kp + 1;
      }
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      expr_walk(e.args[k], prog, mut bound, mut muts, mut vtys, nb, mut errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_VAR {
    let mut hit: bool = false;
    let mut k: usize = 0;
    while k < nb {
      if bound[k] == e.name {
        hit = true;
      }
      k = k + 1;
    }
    let mut g: usize = 0;
    while g < prog.nconsts {
      if prog.consts[g] == e.name {
        hit = true;
      }
      g = g + 1;
    }
    if !hit && !name_known(prog, e.name) {
      // a plain fn's name is a value (the trampoline pair)
      eprintf("check: unknown name '{}'\n", e.name);
      errs.n = errs.n + 1;
    }
    return;
  }
  match e.lhs {
    Option.Some(l) => {
      expr_walk(l, prog, mut bound, mut muts, mut vtys, nb, mut errs);
    },
    Option.None => {},
  }
  match e.rhs {
    Option.Some(r) => {
      expr_walk(r, prog, mut bound, mut muts, mut vtys, nb, mut errs);
    },
    Option.None => {},
  }
}

// a pattern's binder-name collector: the walker threads it by
// pointer, growing the table on demand (a fixed cap was the same
// out-of-bounds class the param and arg tables held before it)
struct NameBox {
  names: []string,
  n: usize,
}

// one pattern's binder names, in order (nested payloads recurse; an
// or-pattern's alternatives ride the identical-binder law and then
// all collect — duplicate names in the scope are harmless lookups)
fn pat_binders_into(p: *Pat, mut b: *NameBox) {
  if p.kind == 3 {
    if b.n >= len(b.names) {
      let mut big: []string = make([]string, len(b.names) * 2);
      let mut i: usize = 0;
      while i < len(b.names) {
        big[i] = b.names[i];
        i = i + 1;
      }
      b.names = big;
    }
    b.names[b.n] = p.name;
    b.n = b.n + 1;
    return;
  }
  if p.kind == 4 {
    let mut a: usize = 0;
    while a < len(p.alts) {
      pat_binders_into(p.alts[a], mut b);
      a = a + 1;
    }
    return;
  }
  if p.kind == 2 {
    let mut k: usize = 0;
    while k < len(p.subs) {
      pat_binders_into(p.subs[k], mut b);
      k = k + 1;
    }
    return;
  }
}

fn walk_arm(a: *MatchArm, prog: *Prog, mut bound: []string,
            mut muts: []bool, mut vtys: []bool, nb0: usize,
            mut errs: *ErrBox) {
  let mut nb: usize = nb0;
  // the outer slot the binders are about to take may hold a live
  // outer name — put it back when the arm's scope closes
  let mut save_n: string = "";
  let mut save_m: bool = false;
  let mut save_v: bool = false;
  if nb < len(bound) {
    save_n = bound[nb];
    save_m = muts[nb];
    save_v = vtys[nb];
  }
  // §19's identical-binder law: every or-alternative binds the same
  // name set — count and membership — else the checker refuses
  if a.pat.kind == 4 && len(a.pat.alts) > 1 {
    let mut b0 = new NameBox { names: make([]string, 8), n: 0 };
    pat_binders_into(a.pat.alts[0], mut b0);
    let mut ai: usize = 1;
    while ai < len(a.pat.alts) {
      let mut bi = new NameBox { names: make([]string, 8), n: 0 };
      pat_binders_into(a.pat.alts[ai], mut bi);
      if bi.n != b0.n {
        eprintf("check: or-pattern alternatives bind different names\n");
        errs.n = errs.n + 1;
      } else {
        let mut x: usize = 0;
        while x < bi.n {
          let mut hit: bool = false;
          let mut y: usize = 0;
          while y < b0.n {
            if b0.names[y] == bi.names[x] {
              hit = true;
            }
            y = y + 1;
          }
          if !hit {
            eprintf("check: or-pattern alternatives bind different names\n");
            errs.n = errs.n + 1;
          }
          x = x + 1;
        }
      }
      ai = ai + 1;
    }
  }
  let mut nb_all = new NameBox { names: make([]string, 8), n: 0 };
  pat_binders_into(a.pat, mut nb_all);
  let mut k: usize = 0;
  while k < nb_all.n {
    if nb < len(bound) {
      bound[nb] = nb_all.names[k];
      muts[nb] = false; // a binder is a let without mut
      vtys[nb] = false; // and a fresh value: never the capture hazard
      nb = nb + 1;
    }
    k = k + 1;
  }
  match a.guard {
    Option.Some(gd) => {
      // the §19 guard evaluates after the pattern matches, in scope
      // of its bindings: the guard's names resolve against the
      // pattern's binders
      expr_walk(gd, prog, mut bound, mut muts, mut vtys, nb, mut errs);
    },
    Option.None => {},
  }
  // the block arm's statements walk with the binders in scope, the
  // tail expression riding as a final statement (its names resolve
  // against the block's own lets)
  match a.val {
    Option.Some(v) => {
      let mut all: []*Stmt = make([]*Stmt, len(a.body) + 1);
      let mut q: usize = 0;
      while q < len(a.body) {
        all[q] = a.body[q];
        q = q + 1;
      }
      all[q] = parse.wrap_expr_stmt(v);
      stmts_walk(all, prog, mut bound, mut muts, mut vtys, nb,
                 mut make([]string, 32), 0, mut errs);
    },
    Option.None => {
      stmts_walk(a.body, prog, mut bound, mut muts, mut vtys, nb,
                 mut make([]string, 32), 0, mut errs);
    },
  }
  if nb0 < len(bound) {
    bound[nb0] = save_n;
    muts[nb0] = save_m;
    vtys[nb0] = save_v;
  }
}

// The assignment law (§18): every write target must be a mut binding.
// A let without mut, a non-mut parameter, or a match binder refuses
// with boot's exact diagnostic, pointed at the lvalue; a const refuses
// its own way; a static mut is the law's one global write target.
// Returns whether the name is known at all (bound, const, or static).
fn assign_law(prog: *Prog, name: string, line: i32, col: i32,
              bound: []string, muts: []bool, nb: usize,
              mut errs: *ErrBox) -> bool {
  let mut k: usize = 0;
  let mut hit: bool = false;
  let mut m: bool = false;
  while k < nb {
    if bound[k] == name {
      hit = true;
      m = muts[k];
    }
    k = k + 1;
  }
  if hit {
    if !m {
      eprintf("main.rho:{}:{}: error: '{}' is immutable (declare with let mut)\n",
              line as i64, col as i64, name);
      errs.n = errs.n + 1;
    }
    return true;
  }
  let mut ci: usize = 0;
  while ci < prog.nconsts {
    if prog.consts[ci] == name {
      if !prog.cstatic[ci] {
        eprintf("main.rho:{}:{}: error: cannot assign to const '{}'\n",
                line as i64, col as i64, name);
        errs.n = errs.n + 1;
      }
      return true;
    }
    ci = ci + 1;
  }
  return false;
}

// a fn the PROGRAM declares — plain or name[..](…) targs spelling.
// Boot pairs call-site markers against a DECLARED fn's signature;
// builtins and fn values never pair, so the marker law stays off
// their faces
fn user_fn_named(prog: *Prog, name: string) -> bool {
  if fn_named(prog, name) {
    return true;
  }
  if parse.has_targs(name) {
    return fn_named(prog, parse.targs_base(name));
  }
  return false;
}

// the mut-ness of the root binding a marked argument's view hangs
// from (§18) — the name-level twin of boot's root_binding_mut: paths
// resolve through the muts table (last hit wins, the innermost
// scope); an unbound name is a const, a static, or unknown (their
// own laws govern, never this one)
fn root_mut(name: string, bound: []string, muts: []bool,
            nb: usize) -> bool {
  let mut k: usize = 0;
  let mut hit: bool = false;
  let mut m: bool = true;
  while k < nb {
    if bound[k] == name {
      hit = true;
      m = muts[k];
    }
    k = k + 1;
  }
  if hit {
    return m;
  }
  return true;
}

// §18 at the call site: a marked argument's root binding must be mut
// (boot's pair_arg_markers tail — the view would let the callee store
// through a binding the caller itself cannot store through). The root
// walk follows field/index chains to the path; a deref or a temporary
// is its own (mut) root, exactly like boot's root_binding_mut. The
// diagnostic anchors at the token after the argument, boot-exact.
fn marker_law(e: *Expr, bound: []string, muts: []bool, nb: usize,
              mut errs: *ErrBox) {
  if !e.amut {
    return;
  }
  let mut root: *Expr = e;
  let mut guard: usize = 0;
  while guard < 64 {
    if root.tag == parse.EX_FIELD || root.tag == parse.EX_IDX {
      match root.lhs {
        Option.Some(b) => {
          root = b;
        },
        Option.None => {
          return;
        },
      }
    } else {
      break;
    }
    guard = guard + 1;
  }
  if root.tag != parse.EX_VAR {
    return;
  }
  if !root_mut(root.name, bound, muts, nb) {
    eprintf("main.rho:{}:{}: error: the marked argument needs a mut root binding (declare the binding with let mut)\n",
            e.aline as i64, e.acol as i64);
    errs.n = errs.n + 1;
  }
}

fn label_known(labels: []string, nl: usize, name: string) -> bool {
  let mut k: usize = 0;
  while k < nl {
    if labels[k] == name {
      return true;
    }
    k = k + 1;
  }
  return false;
}

fn stmts_walk(nodes: []*Stmt, prog: *Prog, mut bound: []string,
              mut muts: []bool, mut vtys: []bool, nb0: usize,
              mut labels: []string, nl0: usize, mut errs: *ErrBox) {
  let mut nb: usize = nb0;
  let mut nl: usize = nl0;
  let mut i: usize = 0;
  while i < len(nodes) {
    let mut st = nodes[i];
    // the assignment law runs before anything else about the stmt
    if st.tag == parse.ST_SET || st.tag == parse.ST_ISTORE ||
        st.tag == parse.ST_FSTORE {
      if !assign_law(prog, st.name, st.line, st.col, bound, muts, nb,
                     mut errs) {
        eprintf("check: unknown name '{}'\n", st.name);
        errs.n = errs.n + 1;
      }
    }
    if st.tag == parse.ST_LET || st.tag == parse.ST_SET ||
        st.tag == parse.ST_CALL || st.tag == parse.ST_RET ||
        st.tag == parse.ST_FSTORE {
      match st.val {
        Option.Some(e) => {
          expr_walk(e, prog, mut bound, mut muts, mut vtys, nb, mut errs);
        },
        Option.None => {},
      }
      if st.tag == parse.ST_LET {
        // the literal lanes: a string literal cannot initialize a
        // non-string binding, a bool literal a non-bool one — the
        // boot-exact primary diagnostic, pointed at the value
        match st.val {
          Option.Some(e2) => {
            let ty: string = st.fmt;
            if len(ty) > 0 && e2.tag == parse.EX_STR && ty != "string" {
              eprintf("main.rho:{}:{}: error: expected {}, found string\n",
                      st.init_line as i64, st.init_col as i64, ty);
              errs.n = errs.n + 1;
            }
            if len(ty) > 0 && e2.tag == parse.EX_LIT &&
                (e2.name == "true" || e2.name == "false") && ty != "bool" {
              eprintf("main.rho:{}:{}: error: expected {}, found bool\n",
                      st.init_line as i64, st.init_col as i64, ty);
              errs.n = errs.n + 1;
            }
          },
          Option.None => {},
        }
      }
      if st.tag == parse.ST_LET {
        // a let introduces the binding; an assignment (ST_SET) binds
        // nothing — the law reads the binding it already finds
        if nb < len(bound) {
          bound[nb] = st.name;
          muts[nb] = st.ret == 1; // the mut flag rides the ret slot
          vtys[nb] = false;
          if len(st.fmt) > 0 {
            vtys[nb] = vty_scalar(st.fmt);
          } else {
            match st.val {
              Option.Some(e9) => {
                vtys[nb] = e9.tag == parse.EX_LIT;
              },
              Option.None => {},
            }
          }
          nb = nb + 1;
        }
      }
      if st.tag == parse.ST_FSTORE {
        // the base's law ran at the head (assignment law + unknown
        // name); what remains is the store's own operands
        let mut q: usize = 0;
        while q < len(st.args) {
          expr_walk(st.args[q], prog, mut bound, mut muts, mut vtys, nb, mut errs);
          q = q + 1;
        }
      }
    }
    if st.tag == parse.ST_PF {
      let mut k: usize = 0;
      while k < len(st.args) {
        expr_walk(st.args[k], prog, mut bound, mut muts, mut vtys, nb, mut errs);
        k = k + 1;
      }
    }
    if st.tag == parse.ST_MATCH {
      match st.val {
        Option.Some(sc) => {
          expr_walk(sc, prog, mut bound, mut muts, mut vtys, nb, mut errs);
        },
        Option.None => {},
      }
      let mut k: usize = 0;
      while k < len(st.marms) {
        walk_arm(st.marms[k], prog, mut bound, mut muts, mut vtys, nb, mut errs);
        k = k + 1;
      }
    }
    if st.tag == parse.ST_DEFER {
      match st.sub {
        Option.Some(inner) => {
          // the deferred scope: slot nb may hold a live outer name
          let mut save_n: string = "";
          let mut save_m: bool = false;
          let mut save_v: bool = false;
          if nb < len(bound) {
            save_n = bound[nb];
            save_m = muts[nb];
            save_v = vtys[nb];
          }
          let mut one: []*Stmt = make([]*Stmt, 1);
          one[0] = inner;
          stmts_walk(one, prog, mut bound, mut muts, mut vtys, nb, mut labels, nl, mut errs);
          if nb < len(bound) {
            bound[nb] = save_n;
            muts[nb] = save_m;
            vtys[nb] = save_v;
          }
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_ISTORE {
      let mut k: usize = 0;
      while k < len(st.args) {
        expr_walk(st.args[k], prog, mut bound, mut muts, mut vtys, nb, mut errs);
        k = k + 1;
      }
      match st.val {
        Option.Some(e) => {
          expr_walk(e, prog, mut bound, mut muts, mut vtys, nb, mut errs);
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_IF {
      match st.val {
        Option.Some(e) => {
          expr_walk(e, prog, mut bound, mut muts, mut vtys, nb, mut errs);
        },
        Option.None => {},
      }
      // each branch scope: put back the outer slot the branch may take
      let mut save_n: string = "";
      let mut save_m: bool = false;
      let mut save_v: bool = false;
      if nb < len(bound) {
        save_n = bound[nb];
        save_m = muts[nb];
        save_v = vtys[nb];
      }
      stmts_walk(st.body, prog, mut bound, mut muts, mut vtys, nb, mut labels, nl, mut errs);
      if nb < len(bound) {
        bound[nb] = save_n;
        muts[nb] = save_m;
        vtys[nb] = save_v;
      }
      stmts_walk(st.body2, prog, mut bound, mut muts, mut vtys, nb, mut labels, nl, mut errs);
      if nb < len(bound) {
        bound[nb] = save_n;
        muts[nb] = save_m;
        vtys[nb] = save_v;
      }
    }
    if st.tag == parse.ST_WHILE {
      match st.val {
        Option.Some(e) => {
          expr_walk(e, prog, mut bound, mut muts, mut vtys, nb, mut errs);
        },
        Option.None => {},
      }
      if len(st.name) > 0 {
        if nl < len(labels) {
          labels[nl] = st.name;
          nl = nl + 1;
        }
      }
      let mut save_n: string = "";
      let mut save_m: bool = false;
      let mut save_v: bool = false;
      if nb < len(bound) {
        save_n = bound[nb];
        save_m = muts[nb];
        save_v = vtys[nb];
      }
      stmts_walk(st.body, prog, mut bound, mut muts, mut vtys, nb, mut labels, nl, mut errs);
      if nb < len(bound) {
        bound[nb] = save_n;
        muts[nb] = save_m;
        vtys[nb] = save_v;
      }
    }
    if st.tag == parse.ST_LOOP {
      if len(st.name) > 0 {
        if nl < len(labels) {
          labels[nl] = st.name;
          nl = nl + 1;
        }
      }
      let mut save_n: string = "";
      let mut save_m: bool = false;
      let mut save_v: bool = false;
      if nb < len(bound) {
        save_n = bound[nb];
        save_m = muts[nb];
        save_v = vtys[nb];
      }
      stmts_walk(st.body, prog, mut bound, mut muts, mut vtys, nb, mut labels, nl, mut errs);
      if nb < len(bound) {
        bound[nb] = save_n;
        muts[nb] = save_m;
        vtys[nb] = save_v;
      }
    }
    // break/continue bind no names; a named jump must target an
    // enclosing label (the stack holds exactly the enclosing ones)
    if (st.tag == parse.ST_BREAK || st.tag == parse.ST_CONT) &&
        len(st.name) > 0 {
      if !label_known(labels, nl, st.name) {
        eprintf("check: unknown label '{}'\n", st.name);
        errs.n = errs.n + 1;
      }
    }
    i = i + 1;
  }
}

// returns the error count; zero = clean
pub fn check(prog: *Prog) -> i64 {
  let mut errs_box = new_errbox();
  let mut nf: usize = 0;
  while nf < len(prog.fns) {
    let fd0: *FnDef = prog.fns[nf];
    let mut bound: []string = make([]string, 64);
    let mut muts: []bool = make([]bool, 64);
    let mut vtys: []bool = make([]bool, 64);
    let mut k: usize = 0;
    while k < len(fd0.params) {
      bound[k] = fd0.params[k];
      muts[k] = fd0.pmut[k]; // a mut view grants the writes (§18)
      vtys[k] = vty_scalar(fd0.ptypes[k]);
      k = k + 1;
    }
    let mut labels: []string = make([]string, 32);
    stmts_walk(fd0.body, prog, mut bound, mut muts, mut vtys, k, mut labels, 0, mut errs_box);
    nf = nf + 1;
  }
  let mut bound: []string = make([]string, 64);
  let mut muts: []bool = make([]bool, 64);
  let mut vtys: []bool = make([]bool, 64);
  let mut labels: []string = make([]string, 32);
  stmts_walk(prog.main, prog, mut bound, mut muts, mut vtys, 0, mut labels, 0, mut errs_box);
  return errs_box.n;
}

struct ErrBox {
  n: i64,
}

pub fn new_errbox() -> *ErrBox {
  return new ErrBox { n: 0 };
}
