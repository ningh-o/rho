// the checker (check.c port): semantic types, symbols, the module
// walk, generics, expression/statement checking, the drivers, and
// generic fn instantiation
use cli;
use lex;
use parse;
use lower;
use fmt;



// ======================== semantic types (check.c port L1) =================
//
// Types are interned by their mangled name: identical types are pointer-
// identical, which is what `ty_eq` (pointer ==) relies on everywhere.

pub enum TypeKind {
  TyVoid, TyBool, TyI8, TyI16, TyI32, TyI64, TyU8, TyU16, TyU32,
  TyU64, TyF32, TyF64, TyStringK, TyUsize, TyIsize,
  TyIntLit, TyFloatLit, TyNull,
  TyArray, TySlice, TyPtr, TyWeak, TyFn, TyStruct, TyEnum, TyErr, TyDyn,
  TyModule, TyParam,
}

pub static mut g_types: *parse.TypeMap = 0 as *parse.TypeMap;
pub static mut g_recs: *parse.TypeMap = 0 as *parse.TypeMap;

fn type_map() -> *parse.TypeMap {
  if g_types == null {
    g_types = parse.tm_new();
  }
  return g_types;
}

fn rec_map() -> *parse.TypeMap {
  if g_recs == null {
    g_recs = parse.tm_new();
  }
  return g_recs;
}

fn ty_intern2(key: string, t: *parse.Type) -> *parse.Type {
  let found: *parse.Type = parse.tm_lookup(type_map(), key);
  if found != null {
    return found;
  }
  t.mangled = key;
  return parse.tm_intern(type_map(), key, t);
}

// friendly type name for diagnostics (boot: ty_name(t) = t->mangled)
fn ty_name(t: *parse.Type) -> string {
  if t == null {
    return "<null>";
  }
  return t.mangled;
}

fn prim_kind(prim: i32) -> TypeKind {
  if prim == 0 { return TypeKind.TyBool; }
  if prim == 1 { return TypeKind.TyI8; }
  if prim == 2 { return TypeKind.TyI16; }
  if prim == 3 { return TypeKind.TyI32; }
  if prim == 4 { return TypeKind.TyI64; }
  if prim == 5 { return TypeKind.TyU8; }
  if prim == 6 { return TypeKind.TyU16; }
  if prim == 7 { return TypeKind.TyU32; }
  if prim == 8 { return TypeKind.TyU64; }
  if prim == 9 { return TypeKind.TyF32; }
  if prim == 10 { return TypeKind.TyF64; }
  if prim == 11 { return TypeKind.TyStringK; }
  if prim == 12 { return TypeKind.TyUsize; }
  if prim == 13 { return TypeKind.TyIsize; }
  return TypeKind.TyVoid;
}

pub fn prim_name(prim: i32) -> string {
  if prim == 0 { return "bool"; }
  if prim == 1 { return "i8"; }
  if prim == 2 { return "i16"; }
  if prim == 3 { return "i32"; }
  if prim == 4 { return "i64"; }
  if prim == 5 { return "u8"; }
  if prim == 6 { return "u16"; }
  if prim == 7 { return "u32"; }
  if prim == 8 { return "u64"; }
  if prim == 9 { return "f32"; }
  if prim == 10 { return "f64"; }
  if prim == 11 { return "string"; }
  if prim == 12 { return "usize"; }
  if prim == 13 { return "isize"; }
  return "void";
}

fn ty_prim(prim: i32) -> *parse.Type {
  return ty_intern2(prim_name(prim), new parse.Type {
    kind: prim_kind(prim), elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_ptr(elem: *parse.Type) -> *parse.Type {
  return ty_intern2("*" + elem.mangled, new parse.Type {
    kind: TypeKind.TyPtr, elem: elem, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_weak(elem: *parse.Type) -> *parse.Type {
  return ty_intern2("weak[" + elem.mangled + "]", new parse.Type {
    kind: TypeKind.TyWeak, elem: elem, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_slice(elem: *parse.Type) -> *parse.Type {
  return ty_intern2("[]" + elem.mangled, new parse.Type {
    kind: TypeKind.TySlice, elem: elem, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_array(elem: *parse.Type, len: u64) -> *parse.Type {
  return ty_intern2("[" + cli.itoa(len as i64) + "]" + elem.mangled + "", new parse.Type {
    kind: TypeKind.TyArray, elem: elem, len: len, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_fn(params: []*parse.Type, ret: *parse.Type) -> *parse.Type {
  let mut key: string = "fn(";
  let mut i: usize = 0;
  while i < len(params) {
    if i > 0 {
      key = key + ";";
    }
    key = key + params[i].mangled;
    i += 1;
  }
  key = key + ")->" + ret.mangled;
  return ty_intern2(key, new parse.Type {
    kind: TypeKind.TyFn, elem: null, len: 0, rec: null,
    params: params, ret: ret, mangled: "",
  });
}

fn ty_err() -> *parse.Type {
  return ty_intern2("<error>", new parse.Type {
    kind: TypeKind.TyErr, elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "<error>",
  });
}

pub static mut g_module_type: *parse.Type = 0 as *parse.Type;

fn ty_module() -> *parse.Type {
  if g_module_type == null {
    g_module_type = new parse.Type {
      kind: TypeKind.TyModule, elem: null, len: 0, rec: null,
      params: fresh_type_vec2(), ret: null, mangled: "<module>",
    };
  }
  return g_module_type;
}

fn ty_param_(name: string) -> *parse.Type {
  let t: *parse.Type = new parse.Type {
    kind: TypeKind.TyParam, elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: name,
  };
  return t;
}

pub fn fresh_type_vec2() -> []*parse.Type {
  return make([]*parse.Type, 0); // empty: push_type appends
}


// ============== symbols & scopes (check.c port L2) ========================

pub enum SymKind {
  SyLocal, SyParam, SyFn, SyStruct, SyEnum, SyStatic, SyConst,
  SyModule, SyExtern, SyVariant, SyTrait, SyImpl, SyTraitMethod,
}

pub struct Sym {
  kind: SymKind,
  name: string,
  type: *parse.Type,
  decl: *parse.Decl,
  mutable: bool,
  variant_index: i32,
  local_id: i32,
  symbol: string,
  owner: *Module,
  module: *Module, // SY_MODULE: the referenced module
  trait_rec: *parse.RecType, // SY_TRAIT: the ordered requirement carrier
}

struct Binding { name: string, sym: *Sym, next: *Binding }
struct CScope { bindings: *Binding, parent: *CScope }

pub static mut cur_scope: *CScope = 0 as *CScope;
pub static mut cur_ret: *parse.Type = 0 as *parse.Type;
pub static mut cur_fn_sym: *Sym = 0 as *Sym;
pub static mut next_local_id: i32 = 0;
pub static mut g_cap_list: *cli.Vec[*Sym] = 0 as *cli.Vec[*Sym];
pub static mut g_cap_boundary: i32 = 0;

fn scope_push() {
  let s: *CScope = new CScope { bindings: null, parent: cur_scope };
  cur_scope = s;
}

fn scope_pop() {
  cur_scope = cur_scope.parent;
}

fn scope_decl(name: string, sym: *Sym) {
  if scope_lookup_local(cur_scope, name) != null {
    if cur_fn_sym != null {
      cli.err_at(cur_fn_sym.decl.file, 0, 0, "duplicate name `" + name + "`");
    } else {
      cli.err_at(cur_module.path, 0, 0, "duplicate name `" + name + "`");
    }
    return;
  }
  let b: *Binding = new Binding { name: name, sym: sym, next: cur_scope.bindings };
  cur_scope.bindings = b;
}

fn scope_lookup_local(s: *CScope, name: string) -> *Sym {
  let mut b: *Binding = s.bindings;
  while b != null {
    if cli.streq(b.name, name) {
      return b.sym;
    }
    b = b.next;
  }
  return null;
}

fn scope_lookup(name: string) -> *Sym {
  let mut s: *CScope = cur_scope;
  while s != null {
    let sym: *Sym = scope_lookup_local(s, name);
    if sym != null {
      return sym;
    }
    s = s.parent;
  }
  return null;
}

fn lookup(name: string) -> *Sym {
  let mut s: *CScope = cur_scope;
  while s != null {
    let sym: *Sym = scope_lookup_local(s, name);
    if sym != null {
      return sym;
    }
    s = s.parent;
  }
  if cur_module != null {
    let msym: *Sym = sm_get(cur_module.syms, name);
    if msym != null {
      return msym;
    }
  }
  // root build parameters: the entry file's consts are visible in every
  // module, with the prelude's implicit status (spec §7.2)
  let psym: *Sym = param_lookup(name);
  if psym != null {
    return psym;
  }
  if prelude_module != null && prelude_module != cur_module {
    return sm_get(prelude_module.syms, name);
  }
  return null;
}


// ============== module walk (check.c port L3) =============================

struct SymMapEnt { key: string, val: *Sym }
struct SymMap { items: []*SymMapEnt, n: usize }

pub fn sm_new() -> *SymMap {
  return new SymMap { items: make([]*SymMapEnt, 4096), n: 0 };
}

fn sm_put(m: *SymMap, key: string, val: *Sym) {
  let mut i: usize = 0;
  while i < m.n {
    if cli.streq(m.items[i].key, key) {
      m.items[i].val = val;
      return;
    }
    i += 1;
  }
  let e: *SymMapEnt = new SymMapEnt { key: key, val: val };
  m.items[m.n] = e;
  m.n += 1;
}

pub fn sm_get(m: *SymMap, key: string) -> *Sym {
  let mut i: usize = 0;
  while i < m.n {
    if cli.streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return null;
}

pub struct Module {
  path: string,
  ns: string,
  root: *parse.Decl,
  syms: *SymMap,
  is_prelude: bool,
  checked: bool,
}

pub static mut cur_module: *Module = 0 as *Module;
pub static mut prelude_module: *Module = 0 as *Module;
pub static mut g_aux_modules: *cli.Vec[*Module] = 0 as *cli.Vec[*Module];

// =========== root build parameters (spec §7.2) ============================
//
// A `const` declared in the entry (root) file IS a build parameter: typed
// bool/i32/string, its initializer must be comptime (the const law already
// demands that), `rho build --set name=value` overrides the declared
// default, and the name is visible in every module without a `use` — the
// same implicit status the prelude carries. Comptime-known conditions over
// these consts (and any const, any literal, and their folded combinations)
// fold at check time: the dead branch is parsed but never checked, never
// lowered — references inside it to functions that do not exist are not
// errors, and modules only it reaches are shaken out of the artifact.

// the root's const decls, recorded before any module is registered — the
// shadowing diag needs the names even when a `use` loads an aux module
// before the root's own registration completes
pub static mut g_param_decls: *cli.Vec[*parse.Decl] = 0 as *cli.Vec[*parse.Decl];
pub static mut g_param_owner: *Module = 0 as *Module;

// record the root file's consts as build parameters. Called once, after the
// root file is parsed and before anything is checked. Build parameters are
// limited to bool/i32/string (spec §7.2) — anything else is a diagnostic.
pub fn install_build_params(m: *Module) {
  g_param_owner = m;
  g_param_decls = new cli.Vec[*parse.Decl] { items: make([]*parse.Decl, 8), n: 0 };
  let d: *parse.Decl = m.root;
  let mut i: usize = 0;
  while i < d.decls.n {
    let c: *parse.Decl = d.decls.items[i];
    if c.kind == parse.DeclKind.DkConst {
      g_param_decls.push(c);
      if c.ret == null || c.ret.kind != parse.TypeAstKind.TaPrim ||
         (c.ret.prim != 0 && c.ret.prim != 3 && c.ret.prim != 11) {
        cli.err_at(c.file, c.line, c.col, "`" + c.name + "`: root consts are build parameters and must be bool, i32, or string");
      }
    }
    i += 1;
  }
}

pub fn reset_build_params() {
  g_param_decls = null;
  g_param_owner = null;
}

// the parameter's registered sym (typed in the root's decl pass), or null
pub fn param_lookup(name: string) -> *Sym {
  if g_param_owner == null {
    return null;
  }
  return sm_get(g_param_owner.syms, name);
}

// does this name collide with a build parameter? The root's own
// declarations ARE the parameters, so they never collide; a module loaded
// from the root file's own path (the shared body doubles as a namespace —
// `use cli;` from the native modules) is the same source text, so its
// consts ARE the parameters too; the prelude is exempt (it predates the
// params and its body never names them — params take lookup precedence
// over it anyway)
fn param_is_shadowed(m: *Module, name: string) -> bool {
  if g_param_owner == null || m.is_prelude || g_param_decls == null {
    return false;
  }
  if m == g_param_owner || cli.streq(m.path, g_param_owner.path) {
    return false;
  }
  let mut i: usize = 0;
  while i < g_param_decls.n {
    if cli.streq(g_param_decls.items[i].name, name) {
      return true;
    }
    i += 1;
  }
  return false;
}

// the entry file's path: `main` is reserved as a module binding in it
pub static mut g_entry_path: string = "";

// one pending `pub use`: resolved (and its target loaded) at registration,
// materialized only after every module's declarations exist — flattened
// syms must be final before anything aliases them
pub struct UseReq {
  owner: *Module, // the module whose namespace gains the names
  decl: *parse.Decl, // the `pub use` decl: path, alias in `name`, position
  target: *Module, // the resolved target module (null: load failed)
  item: string, // "" = module re-export; else one item name in target
}

pub static mut g_use_reqs: *cli.Vec[*UseReq] = 0 as *cli.Vec[*UseReq];

// module paths mid-flatten — the circular re-export detector
pub static mut g_flat_stack: *cli.Vec[string] = 0 as *cli.Vec[string];

// what a `use` path resolved to: exactly one real body, or the reason
// there is none (the determinism law)
pub struct UseRes {
  found: bool,
  amb: bool, // lib.rho and file.rho coexist
  dotted: bool, // only a dot-bearing file answers this name
  is_pkg: bool, // the real body is a package facade (lib.rho)
  path: string,
  other: string, // the second ambiguity path
}

// a primitive in the spec sense (§2.1): any named builtin type a method can
// anchor to — every integer width, bool, the two floats, and string
fn ty_is_primitive(t: *parse.Type) -> bool {
  if t.kind == TypeKind.TyBool || t.kind == TypeKind.TyI8 ||
     t.kind == TypeKind.TyI16 || t.kind == TypeKind.TyI32 ||
     t.kind == TypeKind.TyI64 || t.kind == TypeKind.TyU8 ||
     t.kind == TypeKind.TyU16 || t.kind == TypeKind.TyU32 ||
     t.kind == TypeKind.TyU64 || t.kind == TypeKind.TyF32 ||
     t.kind == TypeKind.TyF64 || t.kind == TypeKind.TyStringK ||
     t.kind == TypeKind.TyUsize || t.kind == TypeKind.TyIsize {
    return true;
  }
  return false;
}

// Methods on primitive types (`fn i32.to_str(self: i32)`). Struct and enum
// methods hang off the RecType; primitives are interned singletons without
// one, so their methods live here, keyed by the primitive's mangled name.
// The table is GLOBAL: a duplicate primitive method anywhere — prelude
// included — is an error, so a prelude method can never be silently
// shadowed from user code.
struct PrimMethods {
  key: string,
  syms: []*Sym,
}

pub static mut g_prim_methods: *cli.Vec[*PrimMethods] = 0 as *cli.Vec[*PrimMethods];

fn prim_method_find(prim: *parse.Type, name: string) -> *Sym {
  if g_prim_methods == null {
    return null;
  }
  let mut i: usize = 0;
  while i < g_prim_methods.n {
    let v: *PrimMethods = g_prim_methods.items[i];
    if cli.streq(v.key, prim.mangled) {
      let mut k: usize = 0;
      while k < len(v.syms) {
        if cli.streq(v.syms[k].name, name) {
          return v.syms[k];
        }
        k += 1;
      }
      return null;
    }
    i += 1;
  }
  return null;
}

// ---- traits, impls, dyn (0.4.0; boot check.c port) ------------------------

static mut g_dyn_types: *parse.TypeMap = 0 as *parse.TypeMap;

fn ty_void() -> *parse.Type {
  return ty_intern2("void", new parse.Type {
    kind: TypeKind.TyVoid, elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "void",
  });
}

// register an impl block's methods as `Type.name` symbols on the module and
// add an `impl$Trait$Type` symbol so the eager satisfaction check runs once
// every type exists (boot: register_impl_methods)
fn register_impl_methods(m: *Module, d: *parse.Decl) {
  let mut tgt: *parse.TypeAst = d.target;
  while tgt != null && tgt.kind == parse.TypeAstKind.TaPtr {
    tgt = tgt.elem;
  }
  if tgt == null || tgt.kind != parse.TypeAstKind.TaNamed || tgt.path.n != 1 {
    cli.err_at(d.file, d.line, d.col, "impl targets a named type (module-qualified or local)");
    return;
  }
  let tname: string = tgt.path.items[0];
  let mut i: usize = 0;
  while i < d.decls.n {
    let md: *parse.Decl = d.decls.items[i];
    md.recv = tname;
    let sym: *Sym = new Sym {
      kind: SymKind.SyFn, name: md.name, type: null, decl: md,
      mutable: false, variant_index: 0, local_id: 0, symbol: "",
      owner: m, module: null, trait_rec: null,
    };
    let key: string = tname + "." + md.name + "" + "";
    if sm_get(m.syms, key) != null {
      cli.err_at(md.file, md.line, md.col, "duplicate method `" + key + "`" + "");
      i += 1;
      continue;
    }
    sm_put(m.syms, key, sym);
    i += 1;
  }
  let isym: *Sym = new Sym {
    kind: SymKind.SyImpl, name: "impl$" + d.name + "$" + tname + "" + "",
    type: null, decl: d, mutable: false, variant_index: 0, local_id: 0,
    symbol: "", owner: m, module: null, trait_rec: null,
  };
  sm_put(m.syms, isym.name, isym);
}

// the dyn type is interned per trait (ty_eq is pointer equality): one Type
// per trait carrier, mangled `dyn$Name`
fn dyn_type_for(trait_sym: *Sym) -> *parse.Type {
  let rec: *parse.RecType = trait_sym.trait_rec;
  if rec == null {
    return ty_err();
  }
  if g_dyn_types == null {
    g_dyn_types = parse.tm_new();
  }
  let hit: *parse.Type = parse.tm_lookup(g_dyn_types, rec.mangled);
  if hit != null {
    return hit;
  }
  let t: *parse.Type = new parse.Type {
    kind: TypeKind.TyDyn, elem: null, len: 0, rec: rec,
    params: fresh_type_vec2(), ret: null, mangled: "dyn$" + rec.mangled + "",
  };
  parse.tm_intern(g_dyn_types, rec.mangled, t);
  return t;
}

// one method on `t` by name: struct/enum method tables (template methods
// included) or the global primitive table
fn method_on_type(t: *parse.Type, name: string) -> *Sym {
  if t == null {
    return null;
  }
  if t.kind == TypeKind.TyPtr {
    t = t.elem;
  }
  if t == null {
    return null;
  }
  if t.kind == TypeKind.TyStruct || t.kind == TypeKind.TyEnum {
    let mut i: usize = 0;
    while i < len(t.rec.methods) {
      let m: *Sym = t.rec.methods[i];
      if cli.streq(m.name, name) {
        return m;
      }
      i += 1;
    }
    if !t.rec.is_template && t.rec.decl.templ != null {
      let tmpl: *parse.RecType = t.rec.decl.templ;
      let mut j: usize = 0;
      while j < len(tmpl.methods) {
        let m: *Sym = tmpl.methods[j];
        if cli.streq(m.name, name) {
          return m;
        }
        j += 1;
      }
    }
    return null;
  }
  if t.kind == TypeKind.TyIntLit {
    t = ty_prim(3);
  } else if t.kind == TypeKind.TyFloatLit {
    t = ty_prim(10);
  }
  if ty_is_primitive(t) {
    return prim_method_find(t, name);
  }
  return null;
}

// does `m` satisfy the requirement `req`? receiver aside, the signatures
// must agree exactly (param count, each ty_eq, return ty_eq)
fn method_satisfies(m: *Sym, req: *Sym) -> bool {
  let mt: *parse.Type = m.type;     // fn(self, rest...) -> R
  let rt: *parse.Type = req.type;   // fn(rest...) -> R (receiver implicit)
  if mt == null || rt == null || mt.kind != TypeKind.TyFn || rt.kind != TypeKind.TyFn {
    return false;
  }
  if len(mt.params) != len(rt.params) + 1 {
    return false;
  }
  let mut i: usize = 0;
  while i < len(rt.params) {
    if mt.params[i + 1] != rt.params[i] {
      return false;
    }
    i += 1;
  }
  return mt.ret == rt.ret;
}

// the missing requirement named by the last trait_satisfied call
static mut g_missing_idx: i32 = 0; // index into the trait's method list

// the whole satisfaction relation, computed from the method tables
fn trait_satisfied(tr: *parse.RecType, t: *parse.Type) -> bool {
  let mut i: usize = 0;
  while i < len(tr.methods) {
    let req: *Sym = tr.methods[i];
    let m: *Sym = method_on_type(t, req.name);
    if m == null || !method_satisfies(m, req) {
      g_missing_idx = i as i32;
      return false;
    }
    i += 1;
  }
  return true;
}

// *T -> dyn Trait, in place: the expr node becomes an EX_DYNBOX wrapping
// a shallow copy of itself, so every caller holding the pointer sees the box
fn try_dyn_coerce(e: *parse.Expr, got: *parse.Type, expected: *parse.Type) -> bool {
  if e == null || expected == null || expected.kind != TypeKind.TyDyn || got == null {
    return false;
  }
  if got.kind != TypeKind.TyPtr || got.elem == null ||
     (got.elem.kind != TypeKind.TyStruct && got.elem.kind != TypeKind.TyEnum) {
    return false; // dyn rides new-allocated struct pointers only
  }
  if !trait_satisfied(expected.rec, got.elem) {
    cli.err_at(e.file, e.line, e.col, "`" + ty_name(got.elem) + "` does not implement `" + expected.rec.mangled + "`: missing or mismatched `" + expected.rec.methods[g_missing_idx as usize].name + "`" + "" + "" + "");
    e.typed = ty_err();
    return true; // handled (as an error) — don't double-report below
  }
  let inner: *parse.Expr = new parse.Expr {
    kind: e.kind, file: e.file, line: e.line, col: e.col,
    iv: e.iv, fv: e.fv, sv: e.sv, bv: e.bv, a: e.a, b: e.b, c: e.c,
    binop: e.binop, unop: e.unop, args: e.args, arg_names: e.arg_names,
    items: e.items, ty: e.ty, arms: e.arms, params: e.params, ret: e.ret,
    q_ok: e.q_ok, q_err: e.q_err, fold_live: e.fold_live, else_if: e.else_if, fnval: e.fnval,
    caps: e.caps, typed: e.typed, sym: e.sym, spread: e.spread,
  };
  e.kind = parse.ExprKind.ExDynbox;
  e.a = inner;
  e.b = null;
  e.args = parse.fresh_expr_vec();
  e.arg_names = parse.fresh_str_vec();
  e.typed = expected;
  return true;
}

// resolve the trait carriers and run the impl blocks' eager satisfaction
// checks; runs once struct/enum method tables are wired (boot phase 2)
fn resolve_traits_and_impls(m: *Module) {
  let saved: *Module = cur_module;
  cur_module = m;
  let mut i: usize = 0;
  while i < m.syms.n {
    let sym: *Sym = m.syms.items[i].val;
    if sym.kind == SymKind.SyTrait && sym.type == null {
      // the carrier: methods are the ordered requirement list; the order IS
      // the vtable layout. Method types exclude the receiver.
      let rec: *parse.RecType = new parse.RecType {
        decl: sym.decl, is_prelude: false, targs: make([]*parse.Type, 0),
        mangled: sym.decl.name, field_types: make([]*parse.Type, 0), fields_done: false,
        resolving: false, is_template: false, offsets: make([]i64, 0),
        var_offsets: make([]*parse.I64Vec, 0), var_poff: make([]i64, 0),
        size: 0, align: 0, env_tenv: null, owner_mod: sym.owner,
        methods: make([]*Sym, 0), is_trait: true,
      };
      sym.trait_rec = rec;
      sym.type = ty_err(); // a trait is not a value type; dyn_type_for builds it
      let mut k: usize = 0;
      while k < sym.decl.decls.n {
        let md: *parse.Decl = sym.decl.decls.items[k];
        let ms: *Sym = new Sym {
          kind: SymKind.SyTraitMethod, name: md.name, type: null, decl: md,
          mutable: false, variant_index: 0, local_id: 0, symbol: "",
          owner: sym.owner, module: null, trait_rec: null,
        };
        let mut ps: []*parse.Type = fresh_type_vec2();
        let mut j: usize = 1;
        while j < md.params.n { // skip the receiver
          ps = push_type(ps, resolve_type_in_module(sym.owner, md.params.items[j].ty));
          j += 1;
        }
        let mut ret: *parse.Type = ty_void();
        if md.ret != null {
          ret = resolve_type_in_module(sym.owner, md.ret);
        }
        ms.type = ty_fn(ps, ret);
        rec.methods = push_sym(rec.methods, ms);
        k += 1;
      }
    }
    i += 1;
  }
  i = 0;
  while i < m.syms.n {
    let sym: *Sym = m.syms.items[i].val;
    if sym.kind == SymKind.SyImpl && sym.decl != null {
      let d: *parse.Decl = sym.decl;
      let mut tsym: *Sym = sm_get(m.syms, d.name);
      if tsym == null && prelude_module != null && prelude_module != m {
        tsym = sm_get(prelude_module.syms, d.name);
      }
      if tsym == null || tsym.kind != SymKind.SyTrait {
        cli.err_at(d.file, d.line, d.col, "unknown trait `" + d.name + "` in impl" + "");
        i += 1;
        continue;
      }
      let tt: *parse.Type = resolve_type_in_module(m, d.target);
      if !trait_satisfied(tsym.trait_rec, tt) {
        cli.err_at(d.file, d.line, d.col, "`" + ty_name(tt) + "` does not implement `" + d.name + "`: missing or mismatched `" + tsym.trait_rec.methods[g_missing_idx as usize].name + "`" + "" + "" + "");
      }
    }
    i += 1;
  }
  cur_module = saved;
}

// register one declaration into the module's symbol table
fn declare_sym(m: *Module, d: *parse.Decl) {
  // the shadowing law reaches build parameters: a module-level item named
  // like a root const would silently win the lookup and change what every
  // `if (param)` in this module folds to
  if param_is_shadowed(m, d.name) {
    cli.err_at(d.file, d.line, d.col, "`" + d.name + "` shadows a build parameter declared in the root file");
  }
  let sym: *Sym = new Sym {
    kind: SymKind.SyFn, name: d.name, type: null, decl: d,
    mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: m,
    module: null,
  trait_rec: null,
  };
  if d.kind == parse.DeclKind.DkImpl {
    register_impl_methods(m, d);
    return;
  }
  if d.kind == parse.DeclKind.DkTrait {
    sym.kind = SymKind.SyTrait;
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == parse.DeclKind.DkFn {
    sym.kind = SymKind.SyFn;
    if d.is_method {
      // methods live under `Recv.name`, mirroring the boot registration
      sm_put(m.syms, d.recv + "." + d.name, sym);
      return;
    }
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == parse.DeclKind.DkStruct {
    sym.kind = SymKind.SyStruct;
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == parse.DeclKind.DkEnum {
    sym.kind = SymKind.SyEnum;
    sm_put(m.syms, d.name, sym);
    let mut vi: i32 = 0;
    let mut viu: usize = 0;
    while viu < d.variants.n {
      let v: *parse.VariantAst = d.variants.items[viu];
      let vsym: *Sym = new Sym {
        kind: SymKind.SyVariant, name: v.name, type: null, decl: d,
        mutable: false, variant_index: vi, local_id: 0, symbol: "",
    owner: m,
    module: null,
      trait_rec: null,
      };
      sm_put(m.syms, v.name, vsym);
      vi += 1;
      viu += 1;
    }
    return;
  }
  if d.kind == parse.DeclKind.DkStatic || d.kind == parse.DeclKind.DkConst {
    sym.kind = SymKind.SyStatic;
    if d.kind == parse.DeclKind.DkConst {
      sym.kind = SymKind.SyConst;
    }
    sym.mutable = d.is_mut;
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == parse.DeclKind.DkExtern {
    sym.kind = SymKind.SyExtern;
    sm_put(m.syms, d.name, sym);
    return;
  }
}

// walk all decls of a parsed module and populate its symbol table
pub fn check_module(m: *Module) {
  cur_module = m;
  let d: *parse.Decl = m.root;
  let mut i: usize = 0;
  while i < d.decls.n {
    let ud: *parse.Decl = d.decls.items[i];
    if ud.kind == parse.DeclKind.DkUse && ud.path.n > 0 {
      // resolve the used module (exactly one real body: a/b/c/lib.rho or
      // a/b/c.rho — both is an ambiguity), load it, bind its namespace
      // under the last segment or the alias, and record re-exports for the
      // materialize pass
      if ud.pub_ && ud.path.n >= 2 {
        process_pub_item_use(m, ud);
        i += 1;
        continue;
      }
      let res: *UseRes = resolve_use_path(m, ud.path);
      let dotted: string = segs_join(ud.path, ".");
      if res.amb {
        let mut msg: string = "ambiguous use `" + dotted + "`: both `";
        msg = msg + res.path + "` and `";
        msg = msg + res.other + "` exist";
        cli.err_at(ud.file, ud.line, ud.col, msg);
        i += 1;
        continue;
      }
      if res.dotted {
        cli.err_at(ud.file, ud.line, ud.col,
          "module file names cannot contain dots: `" + res.path + "` is not a module");
        i += 1;
        continue;
      }
      if !res.found {
        cli.err_at(ud.file, ud.line, ud.col,
          "cannot read `" + segs_join(ud.path, "/") + ".rho`" + "");
        i += 1;
        continue;
      }
      let ns_name: string = ud.path.items[ud.path.n - 1];
      let aux: *Module = load_module_at(res.path, ns_name);
      if aux != null && try_privacy(m, ud, res) {
        if len(ud.name) > 0 || !ud.pub_ {
          // a plain use (any arity) and `pub use mod as x` bind the
          // namespace; the binding's decl carries its pub flag, which the
          // chain-access visibility checks read
          let mut bind: string = ns_name;
          if len(ud.name) > 0 {
            bind = ud.name;
          }
          if bind_module_ns(m, bind, aux, ud) && ud.pub_ {
            record_req(m, ud, aux, "");
          }
        } else {
          // `pub use mod;` — the full flatten; no local namespace binding
          record_req(m, ud, aux, "");
        }
      }
      i += 1;
      continue;
    }
    declare_sym(m, ud);
    i += 1;
  }
}


// ============== generics core (check.c port L4) ===========================

pub static mut g_tenv: *parse.TypeMap = 0 as *parse.TypeMap;

fn tenv() -> *parse.TypeMap {
  if g_tenv == null {
    g_tenv = parse.tm_new();
  }
  return g_tenv;
}

fn rec_intern(decl: *parse.Decl, owner: *Module, mangled: string) -> *parse.RecType {
  let t: *parse.Type = parse.tm_lookup(rec_map(), mangled);
  if t != null {
    return t.rec;
  }
  let r: *parse.RecType = new parse.RecType {
    decl: decl, is_prelude: owner.is_prelude, targs: fresh_type_vec2(),
    mangled: mangled, field_types: fresh_type_vec2(), fields_done: false,
    resolving: false, is_template: false, offsets: make([]i64, 0),
    var_offsets: make([]*parse.I64Vec, 0), var_poff: make([]i64, 0),
    size: 0, align: 0, env_tenv: null, owner_mod: owner,
    methods: make([]*Sym, 0), is_trait: false,
  };
  parse.tm_intern(rec_map(), mangled, new parse.Type {
    kind: TypeKind.TyStruct, elem: null, len: 0, rec: r,
    params: fresh_type_vec2(), ret: null, mangled: mangled,
  });
  return r;
}

fn template_env_of(d: *parse.Decl) -> *parse.TypeMap {
  let env: *parse.TypeMap = parse.tm_new();
  let mut i: usize = 0;
  while i < d.tparams.n {
    parse.tm_put(env, d.tparams.items[i], ty_param_(d.tparams.items[i]));
    i += 1;
  }
  return env;
}

pub fn push_type(items: []*parse.Type, t: *parse.Type) -> []*parse.Type {
  let out: []*parse.Type = make([]*parse.Type, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = t;
  return out;
}

fn ensure_template(d: *parse.Decl, owner: *Module) -> *parse.RecType {
  if d.templ != null {
    return d.templ;
  }
  let base: string = owner.path + "." + d.name;
  let rec: *parse.RecType = rec_intern(d, owner, base + "[]");
  rec.is_template = true;
  rec.targs = fresh_type_vec2();
  let env: *parse.TypeMap = template_env_of(d);
  rec.env_tenv = env;
  let mut i: usize = 0;
  while i < d.tparams.n {
    let tv: *parse.Type = parse.tm_get(env, d.tparams.items[i]);
    rec.targs = push_type(rec.targs, tv);
    i += 1;
  }
  d.templ = rec;
  return rec;
}

fn rec_type_env(rec: *parse.RecType) -> *parse.TypeMap {
  if rec.env_tenv == null {
    rec.env_tenv = parse.tm_new();
  }
  return rec.env_tenv;
}

fn inst_from_targs(sym: *Sym, owner: *Module, targs: []*parse.Type) -> *parse.Type {
  let d: *parse.Decl = sym.decl;
  let base: string = owner.path + "." + d.name;
  let mut mangled: string = base + "[";
  let mut i: usize = 0;
  while i < len(targs) {
    if i > 0 {
      mangled = mangled + ",";
    }
    mangled = mangled + targs[i].mangled;
    i += 1;
  }
  mangled = mangled + "]";
  let rec: *parse.RecType = rec_intern(d, owner, mangled);
  if len(rec.targs) == 0 && d.tparams.n > 0 {
    let mut j: usize = 0;
    while j < d.tparams.n {
      parse.tm_put(rec_type_env(rec), d.tparams.items[j], targs[j]);
      j += 1;
    }
    rec.targs = targs;
  }
  let t: *parse.Type = new parse.Type {
    kind: TypeKind.TyStruct, elem: null, len: 0, rec: rec,
    params: fresh_type_vec2(), ret: null, mangled: mangled,
  };
  if sym.kind == SymKind.SyEnum {
    t.kind = TypeKind.TyEnum;
  }
  return ty_intern2(mangled, t);
}


// ============== type substitution & resolution (check.c port L5) =========

fn subst_type(t: *parse.Type, env: *parse.TypeMap) -> *parse.Type {
  if t == null {
    return t;
  }
  if t.kind == TypeKind.TyParam {
    let r: *parse.Type = parse.tm_get(env, t.mangled);
    if r != null {
      return r;
    }
    return t;
  }
  if t.kind == TypeKind.TyPtr {
    return ty_ptr(subst_type(t.elem, env));
  }
  if t.kind == TypeKind.TyWeak {
    return ty_weak(subst_type(t.elem, env));
  }
  if t.kind == TypeKind.TySlice {
    return ty_slice(subst_type(t.elem, env));
  }
  if t.kind == TypeKind.TyArray {
    return ty_array(subst_type(t.elem, env), t.len);
  }
  if t.kind == TypeKind.TyFn {
    let mut ps: []*parse.Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < len(t.params) {
      ps = push_type(ps, subst_type(t.params[i], env));
      i += 1;
    }
    return ty_fn(ps, subst_type(t.ret, env));
  }
  return t;
}

// bind type parameters by structural matching of a template type against
// the argument's concrete type
fn infer_targs(tmpl: *parse.Type, arg: *parse.Type, env: *parse.TypeMap) {
  if tmpl == null || arg == null || tmpl.kind != TypeKind.TyParam {
    if tmpl == null || arg == null {
      return;
    }
    if tmpl.kind == TypeKind.TyPtr {
      if arg.kind == TypeKind.TyPtr {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyWeak {
      if arg.kind == TypeKind.TyWeak {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TySlice {
      if arg.kind == TypeKind.TySlice {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyArray {
      if arg.kind == TypeKind.TyArray && arg.len == tmpl.len {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyFn {
      if arg.kind == TypeKind.TyFn && len(arg.params) == len(tmpl.params) {
        let mut i: usize = 0;
        while i < len(tmpl.params) {
          infer_targs(tmpl.params[i], arg.params[i], env);
          i += 1;
        }
        infer_targs(tmpl.ret, arg.ret, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyStruct || tmpl.kind == TypeKind.TyEnum {
      if arg.kind == tmpl.kind && arg.rec != null && tmpl.rec != null &&
         arg.rec.decl == tmpl.rec.decl {
        let n: usize = if len(tmpl.rec.targs) < len(arg.rec.targs) {
          len(tmpl.rec.targs)
        } else {
          len(arg.rec.targs)
        };
        let mut i: usize = 0;
        while i < n {
          infer_targs(tmpl.rec.targs[i], arg.rec.targs[i], env);
          i += 1;
        }
      }
      return;
    }
    return;
  }
  let bound: *parse.Type = parse.tm_get(env, tmpl.mangled);
  if bound == null {
    parse.tm_put(env, tmpl.mangled, arg);
  } else if bound != arg && bound.kind != TypeKind.TyErr && arg.kind != TypeKind.TyErr {
    // conflicting bindings: prefer the concrete over a literal
    if bound.kind == TypeKind.TyIntLit || arg.kind == TypeKind.TyIntLit ||
       bound.kind == TypeKind.TyFloatLit || arg.kind == TypeKind.TyFloatLit {
      if bound.kind == TypeKind.TyIntLit || bound.kind == TypeKind.TyFloatLit {
        if arg.kind != TypeKind.TyIntLit && arg.kind != TypeKind.TyFloatLit {
          parse.tm_put(env, tmpl.mangled, arg);
        }
      } else {
        parse.tm_put(env, tmpl.mangled, bound);
      }
    }
  }
}

fn type_has_param(t: *parse.Type) -> bool {
  if t == null {
    return false;
  }
  if t.kind == TypeKind.TyParam {
    return true;
  }
  if t.elem != null && type_has_param(t.elem) {
    return true;
  }
  if t.kind == TypeKind.TyFn {
    let mut i: usize = 0;
    while i < len(t.params) {
      if type_has_param(t.params[i]) {
        return true;
      }
      i += 1;
    }
    if type_has_param(t.ret) {
      return true;
    }
  }
  if t.rec != null {
    let mut i: usize = 0;
    while i < len(t.rec.targs) {
      if type_has_param(t.rec.targs[i]) {
        return true;
      }
      i += 1;
    }
  }
  return false;
}

// resolve a named struct/enum type (non-generic path; generics with explicit
// targs arrive through inst_from_targs via resolve_named)
fn named_type_simple(sym: *Sym, owner: *Module) -> *parse.Type {
  let d: *parse.Decl = sym.decl;
  let base: string = owner.path + "." + d.name;
  let rec: *parse.RecType = rec_intern(d, owner, base);
  let t: *parse.Type = new parse.Type {
    kind: TypeKind.TyStruct, elem: null, len: 0, rec: rec,
    params: fresh_type_vec2(), ret: null, mangled: base,
  };
  if sym.kind == SymKind.SyEnum {
    t.kind = TypeKind.TyEnum;
  }
  return ty_intern2(base, t);
}

// resolve a TypeAst into a semantic Type within a module
pub fn resolve_type_in_module(m: *Module, ta: *parse.TypeAst) -> *parse.Type {
  if ta == null {
    return ty_prim(14); // void
  }
  let saved: *Module = cur_module;
  cur_module = m;
  let mut result: *parse.Type = ty_err();
  if ta.kind == parse.TypeAstKind.TaPrim {
    result = ty_prim(ta.prim);
  } else if ta.kind == parse.TypeAstKind.TaPtr {
    result = ty_ptr(resolve_type_in_module(m, ta.elem));
  } else if ta.kind == parse.TypeAstKind.TaWeak {
    result = ty_weak(resolve_type_in_module(m, ta.elem));
  } else if ta.kind == parse.TypeAstKind.TaDyn {
    // dyn Trait: intern one aggregate type per trait carrier
    let last: string = ta.path.items[ta.path.n - 1];
    let mut tsym: *Sym = sm_get(m.syms, last);
    if tsym == null || tsym.kind != SymKind.SyTrait {
      if prelude_module != null && prelude_module != m {
        let ps: *Sym = sm_get(prelude_module.syms, last);
        if ps != null && ps.kind == SymKind.SyTrait {
          tsym = ps;
        }
      }
    }
    if tsym == null || tsym.kind != SymKind.SyTrait {
      cli.err_at(ta.file, ta.line, ta.col, "unknown trait `" + last + "`" + "");
    } else {
      result = dyn_type_for(tsym);
    }
  } else if ta.kind == parse.TypeAstKind.TaArray {
    let elem: *parse.Type = resolve_type_in_module(m, ta.elem);
    if ta.size == null {
      result = ty_slice(elem);
    } else {
      // const-evaluated array sizes: the size expression folds through
      // the same const lane static initializers use (literals, named
      // consts, and their arithmetic)
      let v: *lower.CV = lower.const_eval(ta.size, m);
      if v.ok && v.is_int && v.i > 0 {
        result = ty_array(elem, v.i);
        // arrays hold elements inline, so an array whose element chain
        // lands on a struct CURRENTLY BEING RESOLVED (rec.resolving is
        // the in-flight marker struct field resolution sets) is an
        // infinite value — reject here, before layout can chase it
        let mut w: *parse.Type = result;
        while w != null && w.kind == TypeKind.TyArray {
          w = w.elem;
        }
        if w != null && (w.kind == TypeKind.TyStruct || w.kind == TypeKind.TyEnum) &&
           w.rec != null && w.rec.resolving {
          cli.err_at(ta.file, ta.line, ta.col,
                      "array of `" + ty_name(w) + "` while it is being defined — the struct would contain itself inline");
          result = ty_err();
        }
      } else {
        cli.err_at(ta.file, ta.line, ta.col, "array size must be a positive constant");
        result = ty_err();
      }
    }
  } else if ta.kind == parse.TypeAstKind.TaNamed {
    let last: string = ta.path.items[ta.path.n - 1];
    if ta.path.n == 1 {
      if g_tenv != null && ta.targs.n == 0 {
        let tv: *parse.Type = parse.tm_get(g_tenv, last);
        if tv != null {
          cur_module = saved;
          return tv;
        }
      }
      let mut sym: *Sym = sm_get(m.syms, last);
      if sym == null || (sym.kind != SymKind.SyStruct && sym.kind != SymKind.SyEnum) {
        if prelude_module != null && prelude_module != m {
          sym = sm_get(prelude_module.syms, last);
          if sym != null && (sym.kind == SymKind.SyStruct || sym.kind == SymKind.SyEnum) {
            cur_module = saved;
            return named_type_full(sym, prelude_module, ta);
          }
        }
        cli.err_at(ta.file, ta.line, ta.col, "unknown type `" + last + "`");
        cur_module = saved;
        return ty_err();
      }
      cur_module = saved;
      return named_type_full(sym, m, ta);
    }
    // module-qualified type: `mod.Type[T]`, and one level deeper through a
    // re-exported namespace (`pkg.sub.Type`) — every segment but the last
    // must name a module
    if ta.path.n > 2 {
      let mut walk: *Module = m;
      let mut si: usize = 0;
      let mut chain_ok: bool = true;
      while si + 1 < ta.path.n {
        let seg: string = ta.path.items[si];
        let msym: *Sym = sm_get(walk.syms, seg);
        if msym == null || msym.kind != SymKind.SyModule || msym.module == null {
          cli.err_at(ta.file, ta.line, ta.col, "unknown module `" + seg + "`" + "");
          chain_ok = false;
          break;
        }
        walk = msym.module;
        si += 1;
      }
      if !chain_ok {
        cur_module = saved;
        return ty_err();
      }
      let lastq: string = ta.path.items[ta.path.n - 1];
      let tsymq: *Sym = sm_get(walk.syms, lastq);
      if tsymq == null || (tsymq.kind != SymKind.SyStruct && tsymq.kind != SymKind.SyEnum) {
        cli.err_at(ta.file, ta.line, ta.col, "unknown type `" + lastq + "` in module `" + ta.path.items[0] + "`");
        cur_module = saved;
        return ty_err();
      }
      cur_module = saved;
      return named_type_full(tsymq, walk, ta);
    }
    let qns: string = ta.path.items[0];
    let mod_sym: *Sym = sm_get(m.syms, qns);
    if mod_sym == null || mod_sym.kind != SymKind.SyModule {
      cli.err_at(ta.file, ta.line, ta.col, "unknown module `" + qns + "`");
      cur_module = saved;
      return ty_err();
    }
    let tsym: *Sym = sm_get(mod_sym.module.syms, last);
    if tsym == null || (tsym.kind != SymKind.SyStruct && tsym.kind != SymKind.SyEnum) {
      cli.err_at(ta.file, ta.line, ta.col, "unknown type `" + last + "` in module `" + qns + "`");
      cur_module = saved;
      return ty_err();
    }
    cur_module = saved;
    return named_type_full(tsym, mod_sym.module, ta);
  } else if ta.kind == parse.TypeAstKind.TaFn {
    let mut ps: []*parse.Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < ta.params.n {
      ps = push_type(ps, resolve_type_in_module(m, ta.params.items[i]));
      i += 1;
    }
    let r: *parse.Type = resolve_type_in_module(m, ta.ret);
    result = ty_fn(ps, r);
  }
  cur_module = saved;
  return result;
}

// full named-type resolution: non-generic, bare-generic (template or bound
// instance), and explicit-targs paths
fn named_type_full(sym: *Sym, owner: *Module, ta: *parse.TypeAst) -> *parse.Type {
  let d: *parse.Decl = sym.decl;
  let nparams: usize = d.tparams.n;
  let ntargs: usize = ta.targs.n;
  if nparams == 0 && ntargs == 0 {
    return named_type_simple(sym, owner);
  }
  if ntargs == 0 {
    let mut targs: []*parse.Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < nparams {
      let mut tv: *parse.Type = null;
      if g_tenv != null {
        tv = parse.tm_get(g_tenv, d.tparams.items[i]);
      }
      if tv == null || tv.kind == TypeKind.TyErr {
        cli.err_at(ta.file, ta.line, ta.col, "generic type `" + d.name + "` needs type arguments");
        return ty_err();
      }
      targs = push_type(targs, tv);
      i += 1;
    }
    let mut anyp: bool = false;
    let mut k: usize = 0;
    while k < len(targs) {
      if targs[k].kind == TypeKind.TyParam {
        anyp = true;
      }
      k += 1;
    }
    if !anyp {
      return inst_from_targs(sym, owner, targs);
    }
    if anyp {
      let rt: *parse.RecType = ensure_template(d, owner);
      let t: *parse.Type = new parse.Type {
        kind: TypeKind.TyStruct, elem: null, len: 0, rec: rt,
        params: fresh_type_vec2(), ret: null, mangled: rt.mangled,
      };
      if sym.kind == SymKind.SyEnum {
        t.kind = TypeKind.TyEnum;
      }
      return ty_intern2(rt.mangled, t);
    }
    return ty_err();
  }
  if nparams != ntargs {
    cli.err_at(ta.file, ta.line, ta.col, "`" + d.name + "` takes " + cli.itoa(nparams as i64) + " type arguments, got " + cli.itoa(ntargs as i64) + "");
    return ty_err();
  }
  let mut targs: []*parse.Type = fresh_type_vec2();
  let mut i: usize = 0;
  while i < ntargs {
    // type arguments resolve in the caller's module: `mod.Vec[LocalType]`
    // names the caller's `LocalType`, exactly as the unqualified form does
    let mut targ: *parse.Type = resolve_type_in_module(cur_module, ta.targs.items[i]);
    if targ.kind == TypeKind.TyIntLit {
      targ = ty_prim(3); // i32
    }
    if targ.kind == TypeKind.TyFloatLit {
      targ = ty_prim(10); // f64
    }
    if targ.kind == TypeKind.TyErr {
      return ty_err();
    }
    targs = push_type(targs, targ);
    i += 1;
  }
  return inst_from_targs(sym, owner, targs);
}


// ============== expression checking (check.c port L6a) ====================

pub fn ty_is_int(t: *parse.Type) -> bool {
  return t.kind == TypeKind.TyI8 || t.kind == TypeKind.TyI16 ||
         t.kind == TypeKind.TyI32 || t.kind == TypeKind.TyI64 ||
         t.kind == TypeKind.TyU8 || t.kind == TypeKind.TyU16 ||
         t.kind == TypeKind.TyU32 || t.kind == TypeKind.TyU64 ||
         t.kind == TypeKind.TyUsize || t.kind == TypeKind.TyIsize ||
         t.kind == TypeKind.TyIntLit;
}

fn ty_is_flt(t: *parse.Type) -> bool {
  return t.kind == TypeKind.TyF32 || t.kind == TypeKind.TyF64 ||
         t.kind == TypeKind.TyFloatLit;
}

fn types_compatible(got: *parse.Type, expected: *parse.Type) -> bool {
  return got == expected;
}

// spec 4.2: the types that may take part in element-wise aggregate
// equality, recursively. Ints, floats, bools, strings, pointers and weak
// handles compare directly; enums, structs, arrays and slices compare
// element-wise, so their parts must in turn be comparable; fn values,
// dyn and err payloads never do. A recursive container (a struct with a
// slice of itself) is legal data — the in-flight edge imposes no
// further constraint, so it reads as comparable and the recursion
// stops (lowering's eq-helpers memoize the same way).
fn ty_comparable_rec(t: *parse.Type, seen: []string) -> bool {
  if t == null {
    return false;
  }
  if ty_is_int(t) || ty_is_flt(t) {
    return true;
  }
  if t.kind == TypeKind.TyBool || t.kind == TypeKind.TyStringK ||
     t.kind == TypeKind.TyPtr || t.kind == TypeKind.TyNull ||
     t.kind == TypeKind.TyWeak {
    return true;
  }
  if t.kind == TypeKind.TyArray || t.kind == TypeKind.TySlice {
    return ty_comparable_rec(t.elem, seen);
  }
  if t.kind == TypeKind.TyEnum || t.kind == TypeKind.TyStruct {
    let mut i: usize = 0;
    while i < len(seen) {
      if cli.streq(seen[i], t.mangled) {
        return true;
      }
      i += 1;
    }
    let deeper: []string = lower.push_str(seen, t.mangled);
    if t.kind == TypeKind.TyEnum {
      let d: *parse.Decl = t.rec.decl;
      let mut vi: usize = 0;
      while vi < d.variants.n {
        let v: *parse.VariantAst = d.variants.items[vi];
        let mut nf: usize = 0;
        if v.vkind == parse.VarKind.VarTuple {
          nf = v.types.n;
        } else if v.vkind == parse.VarKind.VarStruct {
          nf = v.fields.n;
        }
        let mut fi: usize = 0;
        while fi < nf {
          if !ty_comparable_rec(variant_field_type(t, vi as i32, fi as i32), deeper) {
            return false;
          }
          fi += 1;
        }
        vi += 1;
      }
      return true;
    }
    let rec: *parse.RecType = t.rec;
    let mut fi2: usize = 0;
    while fi2 < rec.decl.fields.n {
      if !ty_comparable_rec(struct_field_type(rec, fi2), deeper) {
        return false;
      }
      fi2 += 1;
    }
    return true;
  }
  return false;
}

pub fn ty_comparable(t: *parse.Type) -> bool {
  return ty_comparable_rec(t, make([]string, 0));
}

fn require(got_in: *parse.Type, expected: *parse.Type, e: *parse.Expr, what: string) {
  // mirror boot: adapt literals to the expected type AND rewrite the
  // expression's semantic type, so lowering sees the concrete width
  let got: *parse.Type = adapt_literal(got_in, expected);
  if e != null && e.kind != parse.ExprKind.ExDynbox && expected != null &&
     expected.kind == TypeKind.TyDyn && got.kind != TypeKind.TyDyn &&
     !ty_is_or_has_err(got) {
    if try_dyn_coerce(e, got, expected) {
      return; // rewritten in place (or already diagnosed inside)
    }
  }
  e.typed = got;
  if !types_compatible(got, expected) {
    cli.err_at(e.file, e.line, e.col, what + ": expected `" + ty_name(expected) + "`, found `" + ty_name(got) + "`" + "");
  }
}

fn adapt_literal(got: *parse.Type, expected: *parse.Type) -> *parse.Type {
  if got == null {
    return got;
  }
  if got.kind == TypeKind.TyIntLit && expected != null && ty_is_int(expected) &&
     expected.kind != TypeKind.TyIntLit {
    return expected;
  }
  if got.kind == TypeKind.TyFloatLit && expected != null &&
     (expected.kind == TypeKind.TyF32 || expected.kind == TypeKind.TyF64) {
    return expected;
  }
  // `null` adapts to any pointer/weak context: an if/else arm or a match
  // arm may read `null` against `*T` (boot: TY_NULL + TY_PTR/TY_WEAK)
  if got.kind == TypeKind.TyNull && expected != null &&
     (expected.kind == TypeKind.TyPtr || expected.kind == TypeKind.TyWeak) {
    return expected;
  }
  return got;
}

fn check_expr(e: *parse.Expr, expected: *parse.Type) -> *parse.Type {
  if e.kind == parse.ExprKind.ExDynbox {
    // created by try_dyn_coerce: the box already carries its type
    if e.typed == null {
      e.typed = ty_err();
    }
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExInt {
    if expected != null && ty_is_int(expected) && expected.kind != TypeKind.TyIntLit {
      e.typed = expected;
    } else {
      e.typed = ty_intern2("int_lit", new parse.Type { kind: TypeKind.TyIntLit, elem: null, len: 0, rec: null, params: fresh_type_vec2(), ret: null, mangled: "int_lit" });
    }
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExFloat {
    if expected != null && (expected.kind == TypeKind.TyF32 || expected.kind == TypeKind.TyF64) {
      e.typed = expected;
    } else {
      e.typed = ty_intern2("float_lit", new parse.Type { kind: TypeKind.TyFloatLit, elem: null, len: 0, rec: null, params: fresh_type_vec2(), ret: null, mangled: "float_lit" });
    }
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExStr {
    e.typed = ty_prim(11);
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExBool {
    e.typed = ty_prim(0);
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExNull {
    if expected != null && (expected.kind == TypeKind.TyPtr || expected.kind == TypeKind.TyWeak) {
      e.typed = expected;
    } else {
      e.typed = ty_intern2("null", new parse.Type { kind: TypeKind.TyNull, elem: null, len: 0, rec: null, params: fresh_type_vec2(), ret: null, mangled: "null" });
    }
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExName {
    let mut sym: *Sym = lookup(e.sv);
    if sym == null && cur_module != null {
      sym = sm_get(cur_module.syms, e.sv);
    }
    if sym == null {
      cli.err_at(e.file, e.line, e.col, "unknown name `" + e.sv + "`");
      e.typed = ty_err();
      return e.typed;
    }
    e.sym = sym;
    if sym.kind == SymKind.SyModule {
      e.typed = ty_module();
    } else {
      e.typed = sym.type;
    }
    // a fn name in value position makes a closure value
    if sym.kind == SymKind.SyFn || sym.kind == SymKind.SyExtern {
      e.fnval = true;
    }
    if sym.kind == SymKind.SyFn && sym.decl != null && sym.decl.params.n > 0 &&
       sym.decl.params.items[sym.decl.params.n - 1].is_variadic {
      cli.err_at(e.file, e.line, e.col,
             "a variadic function cannot be used as a value (fn types have no `...` spelling)");
      e.typed = ty_err();
      return e.typed;
    }
    // copy-capture: a closure body naming an outer local records it
    if g_cap_list != null &&
       (sym.kind == SymKind.SyLocal || sym.kind == SymKind.SyParam) &&
       sym.local_id < g_cap_boundary {
      let mut dup: bool = false;
      let mut ci: usize = 0;
      while ci < g_cap_list.n {
        if cli.streq(g_cap_list.items[ci].name, sym.name) {
          dup = true;
        }
        ci += 1;
      }
      if !dup {
        g_cap_list.push(sym);
      }
    }
    e.typed = sym.type;
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExUn {
    let a: *parse.Type = check_expr(e.a, null);
    if e.unop == lex.Tok.PBang {
      if a.kind != TypeKind.TyBool {
        cli.err_at(e.file, e.line, e.col, "`!` needs a bool");
      }
      e.typed = ty_prim(0);
      return e.typed;
    }
    if e.unop == lex.Tok.PTilde {
      if !ty_is_int(a) {
        cli.err_at(e.file, e.line, e.col, "`~` needs an integer");
      }
      e.typed = a;
      return e.typed;
    }
    if e.unop == lex.Tok.PMinus {
      if !ty_is_int(a) && !ty_is_flt(a) {
        cli.err_at(e.file, e.line, e.col, "`-` needs a number");
      }
      e.typed = a;
      return e.typed;
    }
    if e.unop == lex.Tok.PStar {
      if a.kind != TypeKind.TyPtr {
        cli.err_at(e.file, e.line, e.col, "`*` dereference needs a pointer, found `" + ty_name(a) + "`");
        e.typed = ty_err();
      } else {
        e.typed = a.elem;
      }
      return e.typed;
    }
    e.typed = ty_err();
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExCast {
    check_expr(e.a, null);
    let target: *parse.Type = resolve_type_in_module(cur_module, e.ty);
    // untyped literals retype to the cast's target at full width — leaving
    // them INT_LIT (i32) truncates constants like (0x1000000000000 as u64)
    if e.a.typed != null && (e.a.typed.kind == TypeKind.TyIntLit ||
                             e.a.typed.kind == TypeKind.TyFloatLit) {
      e.a.typed = target;
    }
    let srct: *parse.Type = e.a.typed;
    let mut ok: bool = (ty_is_int(target) || ty_is_flt(target)) &&
        (ty_is_int(srct) || ty_is_flt(srct) || srct.kind == TypeKind.TyEnum ||
         srct.kind == TypeKind.TyIntLit || srct.kind == TypeKind.TyFloatLit ||
         srct.kind == TypeKind.TyParam || target.kind == TypeKind.TyParam);
    if srct.kind == TypeKind.TyBool || target.kind == TypeKind.TyBool {
      ok = false;
    }
    if (srct.kind == TypeKind.TyPtr || target.kind == TypeKind.TyPtr) &&
       (target.kind == TypeKind.TyUsize || target.kind == TypeKind.TyI64 ||
        srct.kind == TypeKind.TyUsize || srct.kind == TypeKind.TyI64) {
      ok = true;
    }
    if !ok {
      cli.err_at(e.file, e.line, e.col, "cannot cast `" + ty_name(srct) + "` to `" + ty_name(target) + "`");
    }
    e.typed = target;
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExBin {
    let op: lex.Tok = e.binop;
    let mut l: *parse.Type = check_expr(e.a, null);
    let mut r: *parse.Type = null;
    if op == lex.Tok.PAndand || op == lex.Tok.POror {
      if l.kind != TypeKind.TyBool {
        cli.err_at(e.a.file, e.a.line, e.a.col, "left of `" + fmt.spell_op(op) + "` must be bool");
      }
      r = check_expr(e.b, ty_prim(0));
      if r.kind == TypeKind.TyIntLit || r.kind == TypeKind.TyFloatLit {
        r = ty_prim(0);
        e.b.typed = r;
      }
      if r.kind != TypeKind.TyBool {
        cli.err_at(e.b.file, e.b.line, e.b.col, "right of `" + fmt.spell_op(op) + "` must be bool");
      }
      e.typed = ty_prim(0);
      return e.typed;
    }
    if l.kind == TypeKind.TyIntLit || l.kind == TypeKind.TyFloatLit || l.kind == TypeKind.TyNull {
      let r2: *parse.Type = check_expr(e.b, null);
      l = adapt_literal(l, r2);
      e.a.typed = l;
      r = r2;
    } else {
      r = adapt_literal(check_expr(e.b, l), l);
      e.b.typed = r;
    }
    let cmp: bool = op == lex.Tok.PEq || op == lex.Tok.PNe || op == lex.Tok.PLt ||
                    op == lex.Tok.PGt || op == lex.Tok.PLe || op == lex.Tok.PGe;
    if cmp {
      let mut ok: bool = false;
      if op == lex.Tok.PEq || op == lex.Tok.PNe {
        ok = (ty_is_int(l) && ty_is_int(r)) || (ty_is_flt(l) && ty_is_flt(r)) ||
             (l.kind == TypeKind.TyBool && r.kind == TypeKind.TyBool) ||
             ((l.kind == TypeKind.TyPtr || l.kind == TypeKind.TyNull) && (r.kind == TypeKind.TyPtr || r.kind == TypeKind.TyNull)) ||
             (l.kind == TypeKind.TyWeak && (r.kind == TypeKind.TyWeak || r.kind == TypeKind.TyNull)) ||
             (l.kind == TypeKind.TyStringK && r.kind == TypeKind.TyStringK);
        if l.kind == TypeKind.TyEnum && l == r {
          // same comparability gate as structs: an enum whose payload
          // names a fn/dyn/err must not compare (it would silently
          // compare one raw word of the payload)
          if !ty_comparable(l) {
            cli.err_at(e.file, e.line, e.col, "== on `" + ty_name(l) + "` needs comparable payloads");
            return ty_err();
          }
          ok = true;
        } else if l.kind == TypeKind.TyStruct && r.kind == TypeKind.TyStruct && l == r {
          // element-wise (spec 4.2): every field must itself be comparable
          if !ty_comparable(l) {
            cli.err_at(e.file, e.line, e.col, "== on `" + ty_name(l) + "` needs comparable fields");
            return ty_err();
          }
          ok = true;
        } else if (l.kind == TypeKind.TyArray || l.kind == TypeKind.TySlice) && l == r {
          // element-wise (spec 4.2): same element type, itself comparable
          if !ty_comparable(l.elem) {
            cli.err_at(e.file, e.line, e.col, "== on `" + ty_name(l) + "` needs a comparable element type, found `" + ty_name(l.elem) + "`");
            return ty_err();
          }
          ok = true;
        } else if l.kind == TypeKind.TyStruct || r.kind == TypeKind.TyStruct || l.kind == TypeKind.TyArray {
          ok = false;
        }
      } else {
        ok = (ty_is_int(l) && ty_is_int(r)) || (ty_is_flt(l) && ty_is_flt(r));
      }
      if !ok {
        cli.err_at(e.file, e.line, e.col, "cannot compare `" + ty_name(l) + "` and `" + ty_name(r) + "`");
        return ty_err();
      }
      e.typed = ty_prim(0);
      return e.typed;
    }
    if op == lex.Tok.PShl || op == lex.Tok.PShr {
      if !ty_is_int(l) {
        cli.err_at(e.file, e.line, e.col, "shift needs an integer left side");
      }
      if !ty_is_int(r) {
        cli.err_at(e.file, e.line, e.col, "shift needs an integer right side");
      }
      e.typed = l;
      return e.typed;
    }
    if l != r {
      cli.err_at(e.file, e.line, e.col, "type mismatch in `" + fmt.spell_op(op) + "`: `" + ty_name(l) + "` vs `" + ty_name(r) + "`");
      e.typed = ty_err();
      return e.typed;
    }
    if op == lex.Tok.PPlus || op == lex.Tok.PMinus || op == lex.Tok.PStar || op == lex.Tok.PSlash || op == lex.Tok.PPercent {
      // `+` also concatenates strings (string + string -> string, no
      // implicit to_str — mismatched operands take the mismatch diag
      // above, verbatim; boot check.c carries the same rule)
      if (!ty_is_int(l) && !ty_is_flt(l) && !(op == lex.Tok.PPlus && l.kind == TypeKind.TyStringK)) && l.kind != TypeKind.TyParam {
        cli.err_at(e.file, e.line, e.col, "arithmetic needs numbers, found `" + ty_name(l) + "`");
      }
    } else if op == lex.Tok.PAmp || op == lex.Tok.PPipe || op == lex.Tok.PCaret {
      if !ty_is_int(l) {
        cli.err_at(e.file, e.line, e.col, "bitwise needs integers, found `" + ty_name(l) + "`");
      }
    }
    if l.kind == TypeKind.TyIntLit {
      l = ty_prim(3);
    }
    if l.kind == TypeKind.TyFloatLit {
      // float literals default to f64 (spec §1), or follow the context;
      // retype the operand nodes too so the lowerer sees settled types
      if expected != null && expected.kind == TypeKind.TyF32 {
        l = ty_prim(9);
      } else {
        l = ty_prim(10);
      }
      if e.a.typed.kind == TypeKind.TyFloatLit {
        e.a.typed = l;
      }
      if e.b.typed.kind == TypeKind.TyFloatLit {
        e.b.typed = l;
      }
    }
    e.typed = l;
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExIndex {
    let base: *parse.Type = check_expr(e.a, null);
    let mut idx: *parse.Type = check_expr(e.b, null);
    if idx.kind == TypeKind.TyIntLit {
      idx = ty_prim(12);
      e.b.typed = idx;
    }
    if !ty_is_int(idx) {
      cli.err_at(e.b.file, e.b.line, e.b.col, "index must be an integer, found `" + ty_name(idx) + "`");
    }
    if base.kind == TypeKind.TyArray || base.kind == TypeKind.TySlice {
      e.typed = base.elem;
    } else if base.kind == TypeKind.TyStringK {
      e.typed = ty_prim(5);
    } else {
      cli.err_at(e.file, e.line, e.col, "cannot index `" + ty_name(base) + "`");
      e.typed = ty_err();
    }
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExSlice {
    let base: *parse.Type = check_expr(e.a, null);
    let mut lo: *parse.Type = check_expr(e.b, null);
    let mut hi: *parse.Type = check_expr(e.c, null);
    if lo.kind == TypeKind.TyIntLit {
      lo = ty_prim(12);
      e.b.typed = lo;
    }
    if hi.kind == TypeKind.TyIntLit {
      hi = ty_prim(12);
      e.c.typed = hi;
    }
    if !ty_is_int(lo) || !ty_is_int(hi) {
      cli.err_at(e.file, e.line, e.col, "slice bounds must be integers");
    }
    if base.kind == TypeKind.TyArray || base.kind == TypeKind.TySlice {
      e.typed = ty_slice(base.elem);
    } else if base.kind == TypeKind.TyStringK {
      e.typed = ty_prim(11);
    } else {
      cli.err_at(e.file, e.line, e.col, "cannot slice `" + ty_name(base) + "`");
      e.typed = ty_err();
    }
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExIf {
    return check_if_expr(e, expected);
  }
  if e.kind == parse.ExprKind.ExBlock {
    // a `{ ... }` in value position (a match arm block): the block's value
    // is its trailing tail expression's type, void when it has none
    scope_push();
    let mut result: *parse.Type = ty_prim(14);
    let mut i: usize = 0;
    while i < e.items.n {
      let s: *parse.Stmt = e.items.items[i];
      check_stmt(s);
      if i + 1 == e.items.n && s.kind == parse.StmtKind.StExpr && s.tail {
        result = s.a.typed;
      }
      i += 1;
    }
    scope_pop();
    e.typed = result;
    return result;
  }
  if e.kind == parse.ExprKind.ExQmark {
    // expr? : expr must be a Result or Option; yields the Ok/Some payload
    let operand: *parse.Type = check_expr(e.a, null);
    if operand.kind != TypeKind.TyEnum {
      let mut what: string = ty_name(operand);
      if operand.kind == TypeKind.TyIntLit || operand.kind == TypeKind.TyFloatLit {
        what = "an untyped literal";
      }
      cli.err_at(e.file, e.line, e.col, "`?` needs a Result or Option, found `" + what + "`");
      e.typed = ty_err();
      return e.typed;
    }
    let ed: *parse.Decl = operand.rec.decl;
    let mut ok_i: i32 = 0 - 1;
    let mut err_i: i32 = 0 - 1;
    let mut none_i: i32 = 0 - 1;
    let mut some_i: i32 = 0 - 1;
    let mut vi: usize = 0;
    while vi < ed.variants.n {
      let vn: string = ed.variants.items[vi].name;
      if cli.streq(vn, "Ok") {
        ok_i = vi as i32;
      }
      if cli.streq(vn, "Err") {
        err_i = vi as i32;
      }
      if cli.streq(vn, "Some") {
        some_i = vi as i32;
      }
      if cli.streq(vn, "None") {
        none_i = vi as i32;
      }
      vi += 1;
    }
    let result_like: bool = ok_i >= 0 && err_i >= 0;
    let option_like: bool = some_i >= 0 && none_i >= 0;
    if !result_like && !option_like {
      cli.err_at(e.file, e.line, e.col, "`?` needs a Result or Option, found `" + ty_name(operand) + "`");
      e.typed = ty_err();
      return e.typed;
    }
    let mut qv: i32 = some_i;
    let mut qe: i32 = none_i;
    if result_like {
      qv = ok_i;
      qe = err_i;
    }
    expr_set_q(e, qv, qe);
    // the enclosing function must return the same family, with a
    // compatible error payload for Results
    let mut rn: *parse.Type = cur_ret;
    if rn == null {
      rn = ty_prim(14);
    }
    if cur_ret == null || cur_ret.kind != TypeKind.TyEnum || cur_ret.rec.decl != ed {
      let mut fam: string = "Result";
      if !result_like {
        fam = "Option";
      }
      cli.err_at(e.file, e.line, e.col, "`?` propagates into `" + fam + "`, but this function returns `" + ty_name(rn) + "`");
      e.typed = ty_err();
      return e.typed;
    }
    if result_like {
      let e_op: *parse.Type = variant_field_type(operand, err_i, 0);
      let e_ret: *parse.Type = variant_field_type(cur_ret, err_i, 0);
      if !types_compatible(e_op, e_ret) {
        cli.err_at(e.file, e.line, e.col, "error payload mismatch: function propagates `" + ty_name(e_ret) + "`, operand carries `" + ty_name(e_op) + "`");
        e.typed = ty_err();
        return e.typed;
      }
    }
    e.typed = variant_field_type(operand, e.q_ok, 0);
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExClosure {
    // copy-capture closures: outer locals the body names are snapshotted
    let saved_caps: *cli.Vec[*Sym] = g_cap_list;
    let saved_boundary: i32 = g_cap_boundary;
    let caps: *cli.Vec[*Sym] = new cli.Vec[*Sym] { items: make([]*Sym, 8), n: 0 };
    g_cap_list = caps;
    g_cap_boundary = next_local_id;
    // params: type ASTs resolve now; body checked in a nested scope
    scope_push();
    let mut ps: []*parse.Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < e.params.n {
      let p: *parse.Param = e.params.items[i];
      let pt: *parse.Type = resolve_type_in_module(cur_module, p.ty);
      ps = push_type(ps, pt);
      let psym: *Sym = new Sym {
        kind: SymKind.SyParam, name: p.name, type: pt, decl: null,
        mutable: true, variant_index: 0, local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
      trait_rec: null,
      };
      next_local_id += 1;
      scope_decl(p.name, psym);
      i += 1;
    }
    let mut rt: *parse.Type = ty_prim(14);
    if e.ret != null {
      rt = resolve_type_in_module(cur_module, e.ret);
    }
    // return statements inside check against the closure's return type
    let saved_ret: *parse.Type = cur_ret;
    cur_ret = rt;
    let bt: *parse.Type = check_block_value2(e.items);
    cur_ret = saved_ret;
    if rt.kind != TypeKind.TyVoid && !block_returns(e.items) {
      cli.err_at(e.file, e.line, e.col, "missing return: closure body must produce `" + ty_name(rt) + "`");
    }
    scope_pop();
    g_cap_list = saved_caps;
    g_cap_boundary = saved_boundary;
    let mut ci: usize = 0;
    while ci < caps.n {
      let cap: *Sym = caps.items[ci];
      if cap.kind == SymKind.SyLocal && cap.mutable {
        cli.err_at(e.file, e.line, e.col, "cannot capture mutable `" + cap.name + "` (boot-era closures copy; box it in a struct instead)");
      }
      ci += 1;
    }
    e.caps = caps.items[0..caps.n];
    e.typed = ty_fn(ps, rt);
    return e.typed;
  }
  if e.kind == parse.ExprKind.ExField {
    return check_field_access(e, expected);
  }
  if e.kind == parse.ExprKind.ExCall {
    return check_call(e, expected);
  }
  if e.kind == parse.ExprKind.ExNew {
    return check_new(e);
  }
  if e.kind == parse.ExprKind.ExMatch {
    return check_match(e, expected);
  }
  cli.err_at(e.file, e.line, e.col, "internal: unexpected expression form");
  e.typed = ty_err();
  return e.typed;
}


// ============== field access & new (check.c port L6b) =====================

pub fn struct_field_type(rec: *parse.RecType, i: usize) -> *parse.Type {
  if !rec.fields_done {
    if rec.resolving {
      return ty_err(); // self-containing struct; layout phase reports it
    }
    rec.resolving = true;
    let d: *parse.Decl = rec.decl;
    let saved: *Module = cur_module;
    let saved_env: *parse.TypeMap = g_tenv;
    // owner module of the rec is approximated by cur_module's prelude flag:
    // the self compiler checks one module at a time
    if prelude_module != null && rec.is_prelude {
      cur_module = prelude_module;
    }
    g_tenv = rec.env_tenv;
    let mut j: usize = 0;
    while j < d.fields.n {
      let fa: *parse.FieldAst = d.fields.items[j];
      let ft: *parse.Type = resolve_type_in_module(rec.owner_module(), fa.ty);
      rec.field_types = push_type(rec.field_types, ft);
      j += 1;
    }
    g_tenv = saved_env;
    rec.resolving = false;
    rec.fields_done = true;
    cur_module = saved;
  }
  if len(rec.field_types) > i {
    return rec.field_types[i];
  }
  return ty_err();
}

// RecType keeps the owning module (needed to resolve field types in the
// right namespace); rho port stores it directly
fn RecType.owner_module(self: *parse.RecType) -> *Module {
  if self.owner_mod != null {
    return self.owner_mod;
  }
  return cur_module;
}

// resolve `mod.item` for any module-typed base (a bare binding or a chain
// through a re-exported namespace)
fn check_module_item(e: *parse.Expr) -> *parse.Type {
  let item: *Sym = sm_get(e.a.sym.module.syms, e.sv);
  if item == null {
    let msg: string = "module `" + e.a.sv + "` has no item `" + "" + "";
    cli.err_at("", 0, 0, msg + e.sv + "`" + "" + "");
    e.typed = ty_err();
    return e.typed;
  }
  // a namespace behind a namespace (`pkg.sub`): visible only when the
  // binding was itself a re-export
  if item.kind == SymKind.SyModule && item.module != null {
    if item.decl != null && !item.decl.pub_ && item.owner != null && !item.owner.is_prelude {
      let msg: string = e.a.sv + "." + "";
      cli.err_at("", 0, 0, msg + e.sv + "` is not public" + "" + "");
    }
    e.sym = item;
    e.typed = ty_module();
    return e.typed;
  }
  if item.kind == SymKind.SyStatic || item.kind == SymKind.SyConst {
    if !item.decl.pub_ && !item.owner.is_prelude {
      let msg: string = e.a.sv + "." + "";
      cli.err_at("", 0, 0, msg + e.sv + "` is not public" + "" + "");
    }
    e.sym = item;
    e.typed = item.type;
    return e.typed;
  }
  if item.kind == SymKind.SyFn || item.kind == SymKind.SyExtern {
    e.sym = item;
    e.typed = item.type;
    e.fnval = true;
    return e.typed;
  }
  // a named type behind a module: `lex.Tok` yields the type so chained
  // variant access and constructor calls resolve (`lex.Tok.TkA`)
  if item.kind == SymKind.SyEnum || item.kind == SymKind.SyStruct {
    if !item.decl.pub_ && !item.owner.is_prelude {
      let msg2: string = e.a.sv + "." + "";
      cli.err_at("", 0, 0, msg2 + e.sv + "` is not public" + "" + "");
    }
    e.sym = item;
    e.typed = item.type;
    return e.typed;
  }
  let msg: string = e.a.sv + "." + "";
  cli.err_at("", 0, 0, msg + e.sv + "` is a type; types are not values" + "" + "");
  e.typed = ty_err();
  return e.typed;
}

fn check_field_access(e: *parse.Expr, expected: *parse.Type) -> *parse.Type {
  // module access: statics/consts/types/namespaces (functions go through
  // call resolution). The base is either a bare module binding or a chain
  // through one (`pkg.sub.item` — a re-exported namespace).
  if e.a.kind == parse.ExprKind.ExName && e.a.sym == null {
    check_expr(e.a, null);
  }
  if e.a.sym != null && e.a.sym.kind == SymKind.SyModule && e.a.sym.module != null &&
     (e.a.kind == parse.ExprKind.ExName ||
      (e.a.typed != null && e.a.typed.kind == TypeKind.TyModule)) {
    return check_module_item(e);
  }
  let base: *parse.Type = check_expr(e.a, null);
  if base != null && base.kind == TypeKind.TyModule &&
     e.a.sym != null && e.a.sym.kind == SymKind.SyModule && e.a.sym.module != null {
    return check_module_item(e);
  }
  if base.kind == TypeKind.TySlice || base.kind == TypeKind.TyStringK {
    if cli.streq(e.sv, "len") {
      e.typed = ty_prim(12);
      return e.typed;
    }
    if cli.streq(e.sv, "ptr") {
      if base.kind == TypeKind.TyStringK {
        e.typed = ty_ptr(ty_prim(5));
      } else {
        e.typed = ty_ptr(base.elem);
      }
      return e.typed;
    }
    cli.err_at(e.file, e.line, e.col, "slices have `len` and `ptr`, not `" + e.sv + "`");
    e.typed = ty_err();
    return e.typed;
  }
  if base.kind == TypeKind.TyPtr {
    let deref: *parse.Type = base.elem;
    if deref.kind == TypeKind.TyStruct {
      let rec: *parse.RecType = deref.rec;
      let d: *parse.Decl = rec.decl;
      let mut i: usize = 0;
      while i < d.fields.n {
        let fa: *parse.FieldAst = d.fields.items[i];
        if cli.streq(fa.name, e.sv) {
          e.typed = struct_field_type(rec, i);
          return e.typed;
        }
        i += 1;
      }
      cli.err_at(e.file, e.line, e.col, "no field `" + e.sv + "` on `" + ty_name(deref) + "`");
      e.typed = ty_err();
      return e.typed;
    }
    cli.err_at(e.file, e.line, e.col, "`" + ty_name(deref) + "` has no fields (auto-deref only works on struct pointers)");
    e.typed = ty_err();
    return e.typed;
  }
  if base.kind == TypeKind.TyStruct {
    let rec: *parse.RecType = base.rec;
    let d: *parse.Decl = rec.decl;
    let mut i: usize = 0;
    while i < d.fields.n {
      let fa: *parse.FieldAst = d.fields.items[i];
      if cli.streq(fa.name, e.sv) {
        e.typed = struct_field_type(rec, i);
        return e.typed;
      }
      i += 1;
    }
    cli.err_at(e.file, e.line, e.col, "no field `" + e.sv + "` on `" + ty_name(base) + "`");
    e.typed = ty_err();
    return e.typed;
  }
  if e.a.kind == parse.ExprKind.ExName || e.a.kind == parse.ExprKind.ExField {
    let sym: *Sym = e.a.sym;
    if sym != null && sym.kind == SymKind.SyEnum {
      let d: *parse.Decl = sym.decl;
      let mut i: usize = 0;
      while i < d.variants.n {
        let v: *parse.VariantAst = d.variants.items[i];
        if cli.streq(v.name, e.sv) {
          if v.vkind != parse.VarKind.VarUnit {
            cli.err_at("", 0, 0, "variant carries a payload; call it to construct");
            e.typed = ty_err();
            return e.typed;
          }
          let mut vtype: *parse.Type = sym.type;
          // unit variant of a generic enum: take the expected instantiation
          // when the context pins one (`let x: Option[i32] = Option.None`)
          if vtype != null && vtype.rec != null && vtype.rec.is_template &&
             expected != null && expected.kind == TypeKind.TyEnum &&
             expected.rec != null && expected.rec.decl == d {
            vtype = expected;
          }
          let vs: *Sym = new Sym {
            kind: SymKind.SyVariant, name: e.sv, type: vtype, decl: d,
            mutable: false, variant_index: i as i32, local_id: 0, symbol: "",
    owner: cur_module,
    module: null,
          trait_rec: null,
          };
          e.sym = vs;
          e.typed = vs.type;
          return e.typed;
        }
        i += 1;
      }
      cli.err_at("", 0, 0, "enum has no such variant");
      e.typed = ty_err();
      return e.typed;
    }
  }
  cli.err_at("", 0, 0, "cannot access field");
  e.typed = ty_err();
  return e.typed;
}

fn check_new(e: *parse.Expr) -> *parse.Type {
  let t: *parse.Type = resolve_type_in_module(cur_module, e.ty);
  if t.kind != TypeKind.TyStruct {
    cli.err_at("", 0, 0, "`new` takes a struct type");
    e.typed = ty_err();
    return e.typed;
  }
  let rec: *parse.RecType = t.rec;
  let d: *parse.Decl = rec.decl;
  struct_field_type(rec, if d.fields.n > 0 { d.fields.n - 1 } else { 0 });
  if e.items.n != d.fields.n {
    cli.err_at("", 0, 0, "struct initializer count mismatch");
  }
  let mut i: usize = 0;
  while i < e.items.n {
    let entry: *parse.Stmt = e.items.items[i];
    let fname: string = entry.name;
    let argi: *parse.Expr = e.args.items[i];
    let mut found: bool = false;
    let mut j: usize = 0;
    while j < d.fields.n {
      let df: *parse.FieldAst = d.fields.items[j];
      if cli.streq(df.name, fname) {
        let ft: *parse.Type = struct_field_type(rec, j);
        require(check_expr(argi, ft), ft, argi, "field initializer");
        found = true;
        break;
      }
      j += 1;
    }
    if !found {
      cli.err_at(argi.file, argi.line, argi.col, "no field `" + fname + "` on `" + d.name + "`");
    }
    i += 1;
  }
  e.typed = ty_ptr(t);
  return e.typed;
}


// ============== match checking (check.c port L6c, compact) ===============



// resolve a payload field type of an enum variant against the enum's own
// tparam environment (simplified variant_field_type: no layout needed for
// checking, only for lowering — the layout port arrives with L6d)
pub fn variant_field_type(enum_t: *parse.Type, variant: i32, field: i32) -> *parse.Type {
  let rec: *parse.RecType = enum_t.rec;
  let d: *parse.Decl = rec.decl;
  if variant < 0 || variant >= d.variants.n as i32 {
    return ty_err();
  }
  let v: *parse.VariantAst = d.variants.items[variant];
  let mut ta: *parse.TypeAst = null;
  if v.vkind == parse.VarKind.VarTuple {
    if field < 0 || field >= v.types.n as i32 {
      return ty_err();
    }
    ta = v.types.items[field];
  } else if v.vkind == parse.VarKind.VarStruct {
    if field < 0 || field >= v.fields.n as i32 {
      return ty_err();
    }
    ta = v.fields.items[field].ty;
  } else {
    return ty_err();
  }
  let saved: *Module = cur_module;
  let saved_env: *parse.TypeMap = g_tenv;
  if rec.is_prelude && prelude_module != null {
    cur_module = prelude_module;
  }
  g_tenv = rec.env_tenv;
  let t: *parse.Type = resolve_type_in_module(cur_module, ta);
  g_tenv = saved_env;
  cur_module = saved;
  return t;
}

// does this expression's if-chain guarantee a return on both sides?
fn if_expr_returns(ifx: *parse.Expr) -> bool {
  // a folded if has one live branch — only it can return
  if ifx.fold_live == 1 {
    let then: *parse.Stmt = ifx.items.items[0];
    return block_returns(then.stmts);
  }
  if ifx.fold_live == 2 {
    if ifx.else_if != null {
      return if_expr_returns(ifx.else_if);
    }
    if ifx.items.n < 2 {
      return false;
    }
    return block_returns(ifx.items.items[1].stmts);
  }
  let then: *parse.Stmt = ifx.items.items[0];
  if !block_returns(then.stmts) {
    return false;
  }
  if ifx.else_if != null {
    return if_expr_returns(ifx.else_if);
  }
  if ifx.items.n < 2 {
    return false;
  }
  return block_returns(ifx.items.items[1].stmts);
}

fn loop_has_break(stmts: *cli.Vec[*parse.Stmt]) -> bool {
  let mut i: usize = 0;
  while i < stmts.n {
    let s: *parse.Stmt = stmts.items[i];
    if s.kind == parse.StmtKind.StBreak {
      return true;
    }
    if s.kind == parse.StmtKind.StWhile || s.kind == parse.StmtKind.StLoop {
      // an inner loop's break belongs to the inner loop
      i += 1;
      continue;
    }
    if s.stmts.n > 0 && loop_has_break(s.stmts) {
      return true;
    }
    if s.kind == parse.StmtKind.StExpr {
      if s.a.kind == parse.ExprKind.ExIf && if_arms_have_break(s.a) {
        return true;
      }
      if s.a.kind == parse.ExprKind.ExMatch {
        let mut j: usize = 0;
        while j < s.a.arms.n {
          let arm: *parse.MatchArm = s.a.arms.items[j];
          if arm.body.kind == parse.ExprKind.ExBlock && arm.body.items.n > 0 &&
             loop_has_break(arm.body.items) {
            return true;
          }
          j += 1;
        }
      }
    }
    i += 1;
  }
  return false;
}

fn if_arms_have_break(ifx: *parse.Expr) -> bool {
  // a folded if has one live branch — only its break can break
  if ifx.fold_live == 1 {
    let then: *parse.Stmt = ifx.items.items[0];
    return then.stmts.n > 0 && loop_has_break(then.stmts);
  }
  if ifx.fold_live == 2 {
    if ifx.else_if != null {
      return if_arms_have_break(ifx.else_if);
    }
    if ifx.items.n > 1 {
      let blk: *parse.Stmt = ifx.items.items[1];
      return blk.stmts.n > 0 && loop_has_break(blk.stmts);
    }
    return false;
  }
  let then: *parse.Stmt = ifx.items.items[0];
  if then.stmts.n > 0 && loop_has_break(then.stmts) {
    return true;
  }
  if ifx.else_if != null {
    return if_arms_have_break(ifx.else_if);
  }
  if ifx.items.n > 1 {
    let blk: *parse.Stmt = ifx.items.items[1];
    if blk.stmts.n > 0 && loop_has_break(blk.stmts) {
      return true;
    }
  }
  return false;
}

fn stmt_returns(s: *parse.Stmt) -> bool {
  if s.kind == parse.StmtKind.StReturn {
    return true;
  }
  if s.kind == parse.StmtKind.StExpr && s.tail && s.a.kind == parse.ExprKind.ExCall {
    // a call in tail position returns iff its callee returns; a callee
    // mid-judgment (this very fn, or a mutual cycle) answers from its
    // declared signature — see call_returns
    if s.a.a != null && s.a.a.sym != null {
      return call_returns(s.a.a.sym);
    }
  }
  if s.kind == parse.StmtKind.StExpr && s.a.kind == parse.ExprKind.ExIf {
    return if_expr_returns(s.a);
  }
  if s.kind == parse.StmtKind.StExpr && s.a.kind == parse.ExprKind.ExMatch {
    if s.a.arms.n == 0 {
      return false;
    }
    let mut i: usize = 0;
    while i < s.a.arms.n {
      let arm: *parse.MatchArm = s.a.arms.items[i];
      if arm.body.kind != parse.ExprKind.ExBlock {
        // expression arms produce values, they do not return
        i += 1;
        continue;
      }
      let mut any: bool = false;
      let mut j: usize = 0;
      while j < arm.body.items.n {
        if stmt_returns(arm.body.items.items[j]) {
          any = true;
        }
        j += 1;
      }
      if !any {
        return false;
      }
      i += 1;
    }
    return true;
  }
  if s.kind == parse.StmtKind.StLoop {
    return !loop_has_break(s.body);
  }
  if s.kind == parse.StmtKind.StBlock {
    return block_returns(s.stmts);
  }
  return false;
}

fn block_returns(stmts: *cli.Vec[*parse.Stmt]) -> bool {
  if stmts.n == 0 {
    return false;
  }
  return stmt_returns(stmts.items[stmts.n - 1]);
}

// ---- return-ness of calls: the cycle-safe law -----------------------------
//
// A call in tail position counts as a returning tail exactly when its
// callee returns. Judging a fn walks its body, so a self-recursive tail
// (`fn dive(n: i32) -> i32 { dive(n + 1) }`) is self-referential: while a
// fn is mid-judgment (in flight), a call to it is answered from its
// DECLARED signature — a non-void return type counts as returning. The
// verdict is memoized, so diagnostics never depend on stack depth.

pub struct RetMemo {
  d: *parse.Decl,
  ret: bool,
}

pub static mut g_ret_memo: *cli.Vec[*RetMemo] = 0 as *cli.Vec[*RetMemo];
pub static mut g_ret_judging: *cli.Vec[*parse.Decl] = 0 as *cli.Vec[*parse.Decl];

fn ret_judging(d: *parse.Decl) -> bool {
  if g_ret_judging == null {
    return false;
  }
  let mut i: usize = 0;
  while i < g_ret_judging.n {
    if g_ret_judging.items[i] == d {
      return true;
    }
    i += 1;
  }
  return false;
}

// the declared signature's answer: a fn returns iff its return type is a
// real value (void fns produce nothing, so a call to one is no returning
// tail)
fn declared_returns(sym: *Sym) -> bool {
  if sym.type == null || sym.type.ret == null {
    return false;
  }
  return sym.type.ret.kind != TypeKind.TyVoid;
}

// does a call to this fn count as returning? memoized; cycle-safe.
fn call_returns(sym: *Sym) -> bool {
  let d: *parse.Decl = sym.decl;
  if d == null || d.kind != parse.DeclKind.DkFn {
    // externs and anything bodyless answer from the signature alone
    if sym.kind == SymKind.SyExtern {
      return declared_returns(sym);
    }
    return false;
  }
  if ret_judging(d) {
    return declared_returns(sym);
  }
  if g_ret_memo != null {
    let mut i: usize = 0;
    while i < g_ret_memo.n {
      if g_ret_memo.items[i].d == d {
        return g_ret_memo.items[i].ret;
      }
      i += 1;
    }
  }
  if g_ret_memo == null {
    g_ret_memo = new cli.Vec[*RetMemo] { items: make([]*RetMemo, 8), n: 0 };
  }
  if g_ret_judging == null {
    g_ret_judging = new cli.Vec[*parse.Decl] { items: make([]*parse.Decl, 8), n: 0 };
  }
  g_ret_judging.push(d);
  let verdict: bool = block_returns(d.body);
  g_ret_judging.n -= 1;
  let m: *RetMemo = new RetMemo { d: d, ret: verdict };
  g_ret_memo.push(m);
  return verdict;
}

fn check_match(e: *parse.Expr, expected: *parse.Type) -> *parse.Type {
  let scrut: *parse.Type = check_expr(e.a, null);
  let mut ed: *parse.Decl = null;
  let int_match: bool = ty_is_int(scrut) || scrut.kind == TypeKind.TyIntLit;
  if scrut.kind == TypeKind.TyEnum {
    ed = scrut.rec.decl;
  } else if !int_match {
    cli.err_at(e.file, e.line, e.col, "match scrutinee must be an enum or integer, found `" + ty_name(scrut) + "`");
    e.typed = ty_err();
    return e.typed;
  }
  let covered: []bool = make([]bool, 256);
  let mut wildcard: bool = false;
  let mut result: *parse.Type = null;
  let mut i: usize = 0;
  while i < e.arms.n {
    let arm: *parse.MatchArm = e.arms.items[i];
    if ed != null {
      if arm.pk == parse.PatKind.PatWildcard {
        wildcard = true;
      } else if arm.pk == parse.PatKind.PatUnit || arm.pk == parse.PatKind.PatTuple || arm.pk == parse.PatKind.PatStruct {
        let vn: string = arm.pat_path.items[arm.pat_path.n - 1];
        let mut found: bool = false;
        let mut j: usize = 0;
        while j < ed.variants.n {
          let v: *parse.VariantAst = ed.variants.items[j];
          if !cli.streq(v.name, vn) {
            j += 1;
            continue;
          }
          if arm.pk == parse.PatKind.PatUnit && v.vkind != parse.VarKind.VarUnit {
            cli.err_at(arm.file, arm.line, arm.col, "variant `" + vn + "` carries a payload; bind it: `" + vn + "(..)`");
          } else if arm.pk != parse.PatKind.PatUnit && v.vkind == parse.VarKind.VarUnit {
            cli.err_at(arm.file, arm.line, arm.col, "variant `" + vn + "` has no payload to bind");
          }
          covered[j] = true;
          arm.variant_index = j as i32;
          arm.disc = v.disc;
          found = true;
          break;
        }
        if !found {
          cli.err_at(arm.file, arm.line, arm.col, "no variant `" + vn + "` on `" + ty_name(scrut) + "`");
        } else {
          let v: *parse.VariantAst = ed.variants.items[arm.variant_index as usize];
          let mut nfields: usize = 0;
          if v.vkind == parse.VarKind.VarTuple {
            nfields = v.types.n;
          } else if v.vkind == parse.VarKind.VarStruct {
            nfields = v.fields.n;
          }
          let mut nbinds: usize = 0;
          if arm.pk == parse.PatKind.PatTuple {
            nbinds = arm.pat_names.n;
          } else if arm.pk == parse.PatKind.PatStruct {
            nbinds = arm.pat_fields.n;
          }
          if arm.pk != parse.PatKind.PatUnit && nbinds != nfields {
            cli.err_at(arm.file, arm.line, arm.col, "pattern `" + vn + "` binds " + cli.itoa(nbinds as i64) + " values, variant has " + cli.itoa(nfields as i64) + "");
          } else if arm.pk == parse.PatKind.PatTuple && v.vkind == parse.VarKind.VarTuple {
            let mut b: usize = 0;
            while b < nbinds && b < nfields {
              let nm: string = arm.pat_names.items[b];
              if !cli.streq(nm, "_") {
                let bs: *Sym = new Sym {
                  kind: SymKind.SyLocal, name: nm,
                  type: variant_field_type(scrut, arm.variant_index, b as i32),
                  decl: null, mutable: false, variant_index: 0,
                  local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
                trait_rec: null,
                };
                next_local_id += 1;
                arm.bind_syms = push_sym(arm.bind_syms, bs);
                arm.bind_fidx = lower.push_i64(arm.bind_fidx, b as i64);
              } else {
                arm.bind_syms = push_sym(arm.bind_syms, null);
                arm.bind_fidx = lower.push_i64(arm.bind_fidx, b as i64);
              }
              b += 1;
            }
          } else if arm.pk == parse.PatKind.PatStruct && v.vkind == parse.VarKind.VarStruct {
            // every pattern field must exist on the variant; bindings in
            // pattern order, types from the matched variant field
            let mut b: usize = 0;
            while b < nbinds {
              let fa: *parse.FieldAst = arm.pat_fields.items[b];
              let mut hit: bool = false;
              let mut j2: usize = 0;
              while j2 < v.fields.n {
                let vf: *parse.FieldAst = v.fields.items[j2];
                if cli.streq(vf.name, fa.name) {
                  hit = true;
                  let nm: string = arm.pat_names.items[b];
                  if !cli.streq(nm, "_") {
                    let bs: *Sym = new Sym {
                      kind: SymKind.SyLocal, name: nm,
                      type: variant_field_type(scrut, arm.variant_index, j2 as i32),
                      decl: null, mutable: false, variant_index: 0,
                      local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
                    trait_rec: null,
                    };
                    next_local_id += 1;
                    arm.bind_syms = push_sym(arm.bind_syms, bs);
                    arm.bind_fidx = lower.push_i64(arm.bind_fidx, j2 as i64);
                  } else {
                    arm.bind_syms = push_sym(arm.bind_syms, null);
                    arm.bind_fidx = lower.push_i64(arm.bind_fidx, j2 as i64);
                  }
                  break;
                }
                j2 += 1;
              }
              if !hit {
                cli.err_at(fa.file, fa.line, fa.col, "variant `" + vn + "` has no field `" + fa.name + "`");
              }
              b += 1;
            }
            if nbinds != 0 && len(arm.bind_syms) != v.fields.n {
              cli.err_at(arm.file, arm.line, arm.col, "pattern `" + vn + " { .. }` must bind every field" + "" + "");
            }
          }
        }
      } else {
        cli.err_at(arm.file, arm.line, arm.col, "this pattern does not match an enum");
      }
    } else {
      if arm.pk == parse.PatKind.PatWildcard {
        wildcard = true;
      } else if arm.pk == parse.PatKind.PatInt {
        // literal match
      } else {
        cli.err_at(arm.file, arm.line, arm.col, "integer match arms must be literals or `_`");
      }
    }
    scope_push();
    let mut bi: usize = 0;
    while bi < len(arm.bind_syms) {
      let bs: *Sym = arm.bind_syms[bi];
      if bs != null {
        if scope_lookup(bs.name) != null {
          cli.err_at(arm.file, arm.line, arm.col, "`" + bs.name + "` shadows an existing binding");
        }
        scope_decl(bs.name, bs);
      }
      bi += 1;
    }
    let bt: *parse.Type = check_expr(arm.body, expected);
    if result == null {
      result = bt;
    } else {
      let u: *parse.Type = unify2(result, bt, arm.body);
      if u.kind != TypeKind.TyErr {
        result = u;
      }
    }
    scope_pop();
    i += 1;
  }
  if ed != null && !wildcard {
    let mut j: usize = 0;
    while j < ed.variants.n {
      if !covered[j] {
        cli.err_at(e.file, e.line, e.col, "match is not exhaustive: missing `" + ed.variants.items[j].name + "`");
        break;
      }
      j += 1;
    }
  }
  if int_match && !wildcard && e.arms.n == 0 {
    cli.err_at(e.file, e.line, e.col, "match needs at least one arm");
  }
  if result == null {
    result = ty_prim(14);
  }
  e.typed = result;
  return e.typed;
}

fn push_sym(items: []*Sym, s: *Sym) -> []*Sym {
  let out: []*Sym = make([]*Sym, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = s;
  return out;
}


// ============== callee resolution (check.c port L6d-1) ====================

enum CtKind { CtNone, CtFn, CtExtern, CtVariant, CtIndirect }

struct CallTarget {
  kind: CtKind,
  sym: *Sym,
  fn_type: *parse.Type,
  variant: i32,
  enum_type: *parse.Type,
  is_method: bool,
  is_ctor: bool,
  inst_rec: *parse.RecType,
}

fn deref_to_struct(t: *parse.Type) -> *parse.Type {
  let mut cur: *parse.Type = t;
  while cur != null && cur.kind == TypeKind.TyPtr {
    cur = cur.elem;
  }
  if cur != null && (cur.kind == TypeKind.TyStruct || cur.kind == TypeKind.TyEnum) {
    return cur;
  }
  return null;
}

fn resolve_callee(callee: *parse.Expr) -> *CallTarget {
  let ct: *CallTarget = new CallTarget {
    kind: CtKind.CtNone, sym: null, fn_type: null, variant: 0,
    enum_type: null, is_method: false, is_ctor: false, inst_rec: null,
  };
  if callee.kind == parse.ExprKind.ExName {
    let mut sym: *Sym = lookup(callee.sv);
    if sym == null && cur_module != null {
      sym = sm_get(cur_module.syms, callee.sv);
    }
    if sym == null {
      if cur_fn_sym != null { eprintf("{}", cur_fn_sym.name); }
      eprintf("{}", "\n");
      cli.err_at("", 0, 0, "unknown function `" + callee.sv + "`");
      return ct;
    }
    if sym.kind == SymKind.SyFn || sym.kind == SymKind.SyExtern {
      ct.kind = CtKind.CtFn;
      if sym.kind == SymKind.SyExtern {
        ct.kind = CtKind.CtExtern;
      }
      ct.sym = sym;
      ct.fn_type = sym.type;
      callee.sym = sym;
      return ct;
    }
    if sym.type != null && sym.type.kind == TypeKind.TyFn {
      ct.kind = CtKind.CtIndirect;
      ct.fn_type = sym.type;
      callee.sym = sym;
      callee.typed = sym.type;
      return ct;
    }
    cli.err_at("", 0, 0, "this name is not a function");
    return ct;
  }
  if callee.kind == parse.ExprKind.ExField {
    if callee.a.kind == parse.ExprKind.ExName {
      let base: *Sym = lookup(callee.a.sv);
      if base != null && base.kind == SymKind.SyModule {
        let item: *Sym = sm_get(base.module.syms, callee.sv);
        if item != null && (item.kind == SymKind.SyFn || item.kind == SymKind.SyExtern) {
          if !item.decl.pub_ && !item.owner.is_prelude {
            cli.err_at("", 0, 0, callee.a.sv + "." + callee.sv + "" + " is not public");
          }
          if item.kind == SymKind.SyFn {
            ct.kind = CtKind.CtFn;
          } else {
            ct.kind = CtKind.CtExtern;
          }
          ct.sym = item;
          ct.fn_type = item.type;
          callee.sym = item;
          return ct;
        }
        cli.err_at("", 0, 0, "module `" + callee.a.sv + "` has no function `" + callee.sv + "`" + "" + "" + "" + "");
        return ct;
      }
      if base != null && base.kind == SymKind.SyEnum {
        let d: *parse.Decl = base.decl;
        let mut i: usize = 0;
        while i < d.variants.n {
          let v: *parse.VariantAst = d.variants.items[i];
          if cli.streq(v.name, callee.sv) {
            ct.kind = CtKind.CtVariant;
            ct.variant = i as i32;
            ct.enum_type = base.type;
            ct.is_ctor = v.vkind == parse.VarKind.VarStruct;
            let vs: *Sym = new Sym {
              kind: SymKind.SyVariant, name: callee.sv, type: base.type,
              decl: d, mutable: false, variant_index: i as i32,
              local_id: 0, symbol: "",
    owner: cur_module,
    module: null,
            trait_rec: null,
            };
            callee.sym = vs;
            return ct;
          }
          i += 1;
        }
      }
      if base != null && (base.kind == SymKind.SyStruct || base.kind == SymKind.SyEnum) {
        // associated function `Type.make(...)` lives under `Type.make`
        let fn_sym: *Sym = sm_get(cur_module.syms, callee.sv);
        if fn_sym != null && fn_sym.kind == SymKind.SyFn && !fn_sym.decl.is_method {
          ct.kind = CtKind.CtFn;
          ct.sym = fn_sym;
          ct.fn_type = fn_sym.type;
          callee.sym = fn_sym;
          return ct;
        }
        cli.err_at("", 0, 0, "type has no such associated function");
        return ct;
      }
    }
    // module-qualified type callee: `lex.Tok.TkIdent(...)`,
    // `lex.Box.make(...)` — a two-segment `mod.Type` chain resolves to the
    // type sym, so variants construct and associated fns call exactly as
    // the unqualified forms do
    if callee.a.kind == parse.ExprKind.ExField && callee.a.a.kind == parse.ExprKind.ExName {
      let ns_sym: *Sym = lookup(callee.a.a.sv);
      if ns_sym != null && ns_sym.kind == SymKind.SyModule {
        check_expr(callee.a, null);
        let qbase: *Sym = callee.a.sym;
        if qbase != null && qbase.kind == SymKind.SyEnum {
          let qd: *parse.Decl = qbase.decl;
          let mut qi: usize = 0;
          while qi < qd.variants.n {
            let qv: *parse.VariantAst = qd.variants.items[qi];
            if cli.streq(qv.name, callee.sv) {
              ct.kind = CtKind.CtVariant;
              ct.variant = qi as i32;
              ct.enum_type = qbase.type;
              ct.is_ctor = qv.vkind == parse.VarKind.VarStruct;
              let qvs: *Sym = new Sym {
                kind: SymKind.SyVariant, name: callee.sv, type: qbase.type,
                decl: qd, mutable: false, variant_index: qi as i32,
                local_id: 0, symbol: "",
    owner: cur_module,
    module: null,
            trait_rec: null,
              };
              callee.sym = qvs;
              return ct;
            }
            qi += 1;
          }
        }
        // `pkg.sub.fn(...)` — a call through a re-exported namespace
        if qbase != null && qbase.kind == SymKind.SyModule && qbase.module != null {
          let qitem: *Sym = sm_get(qbase.module.syms, callee.sv);
          if qitem != null && (qitem.kind == SymKind.SyFn || qitem.kind == SymKind.SyExtern) {
            if !qitem.decl.pub_ && !qitem.owner.is_prelude {
              cli.err_at("", 0, 0, callee.a.sv + "." + callee.sv + "` is not public" + "" + "");
            }
            if qitem.kind == SymKind.SyFn {
              ct.kind = CtKind.CtFn;
            } else {
              ct.kind = CtKind.CtExtern;
            }
            ct.sym = qitem;
            ct.fn_type = qitem.type;
            callee.sym = qitem;
            return ct;
          }
        }
        if qbase != null && (qbase.kind == SymKind.SyStruct || qbase.kind == SymKind.SyEnum) {
          // associated function `Type.make(...)` lives in the type's owner
          let qfn: *Sym = sm_get(qbase.owner.syms, callee.sv);
          if qfn != null && qfn.kind == SymKind.SyFn && !qfn.decl.is_method {
            ct.kind = CtKind.CtFn;
            ct.sym = qfn;
            ct.fn_type = qfn.type;
            callee.sym = qfn;
            return ct;
          }
          // not a variant ctor or associated fn: a method — falls through
        }
      }
    }
    // method call: `receiver.name(...)`
    let bt: *parse.Type = check_expr(callee.a, null);
    // 4z) dyn receiver: the name must be one of the trait's requirements;
    // the callee sym is the requirement itself (SY_TRAIT_METHOD) and the
    // receiver stays the fat value — lowering emits the virtual call
    if bt != null && bt.kind == TypeKind.TyDyn {
      let mut i4z: usize = 0;
      let found: bool = false;
      while i4z < len(bt.rec.methods) {
        let m: *Sym = bt.rec.methods[i4z];
        if cli.streq(m.name, callee.sv) {
          ct.kind = CtKind.CtFn;
          ct.sym = m;
          ct.fn_type = m.type;
          ct.is_method = true;
          callee.sym = m;
          callee.typed = m.type.ret;
          callee.a.typed = bt;
          return ct;
        }
        i4z += 1;
      }
      if !found {
        cli.err_at(callee.file, callee.line, callee.col, "trait `" + bt.rec.mangled + "` has no method `" + callee.sv + "`" + "");
        return ct;
      }
    }
    let rec_t: *parse.Type = deref_to_struct(bt);
    if rec_t != null {
      let rec: *parse.RecType = rec_t.rec;
      let mut i: usize = 0;
      while i < len(rec.methods) {
        let m: *Sym = rec.methods[i];
        if cli.streq(m.name, callee.sv) {
          ct.kind = CtKind.CtFn;
          ct.sym = m;
          ct.fn_type = m.type;
          ct.is_method = true;
          callee.sym = m;
          callee.a.typed = bt;
          return ct;
        }
        i += 1;
      }
      if !rec.is_template && rec.decl.templ != null {
        let tmpl: *parse.RecType = rec.decl.templ;
        let mut j: usize = 0;
        while j < len(tmpl.methods) {
          let m: *Sym = tmpl.methods[j];
          if cli.streq(m.name, callee.sv) {
            ct.kind = CtKind.CtFn;
            ct.sym = m;
            ct.fn_type = m.type;
            ct.is_method = true;
            ct.inst_rec = rec;
            callee.sym = m;
            callee.a.typed = bt;
            return ct;
          }
          j += 1;
        }
      }
    }
    // 4b) primitive receiver (`n.to_str()`): auto-deref through pointers,
    // then the global primitive method table. Untyped literals resolve as
    // their default width (i32 / f64); the method-arg adapter materializes
    // the constant at `self`'s width below
    if rec_t == null {
      let mut pt: *parse.Type = bt;
      while pt != null && pt.kind == TypeKind.TyPtr {
        pt = pt.elem;
      }
      if pt != null && pt.kind == TypeKind.TyIntLit {
        pt = ty_prim(3);
      } else if pt != null && pt.kind == TypeKind.TyFloatLit {
        pt = ty_prim(10);
      }
      if pt != null && ty_is_primitive(pt) {
        let pm: *Sym = prim_method_find(pt, callee.sv);
        if pm != null {
          ct.kind = CtKind.CtFn;
          ct.sym = pm;
          ct.fn_type = pm.type;
          ct.is_method = true;
          callee.sym = pm;
          callee.a.typed = bt;
          return ct;
        }
      }
    }
    // fall-through (boot check.c: the dotted path always resolves, errors,
    // or returns): no method anywhere on this receiver
    cli.err_at(callee.file, callee.line, callee.col, "no method `" + callee.sv + "` for `" + ty_name(bt) + "`");
    return ct;
  }
  let t: *parse.Type = check_expr(callee, null);
  if t.kind == TypeKind.TyFn {
    ct.kind = CtKind.CtIndirect;
    ct.fn_type = t;
    return ct;
  }
  cli.err_at("", 0, 0, "cannot call this expression");
  return ct;
}


// ============== check_call: builtins (check.c port L6d-2) =================

// printf/eprintf/format format strings: split the literal into runs between
// `{}` placeholders; `{{` and `}}` are literal braces. Returns false on a
// stray brace (already diagnosed); the runs land in parts, the hole count
// in holes.
static mut g_fmt_holes: i32 = 0;
static mut g_fmt_bad: i32 = 0; // the stray brace character, 0 when clean

fn split_format(fmt: string, parts: *cli.Vec[string]) -> bool {
  g_fmt_holes = 0;
  let mut cur: []u8 = make([]u8, 0);
  let mut i: usize = 0;
  let n: usize = len(fmt);
  while i < n {
    let ch: u8 = fmt[i];
    if ch == 123 || ch == 125 { // '{' '}'
      if i + 1 < n && fmt[i + 1] == ch { // `{{` / `}}`
        cur = lower.push_u8(cur, ch);
        i += 2;
        continue;
      }
      if ch == 123 && i + 1 < n && fmt[i + 1] == 125 { // `{}` hole
        parts.push(intrinsics.slice_string(cur));
        cur = make([]u8, 0);
        g_fmt_holes += 1;
        i += 2;
        continue;
      }
      g_fmt_bad = ch as i32;
      return false;
    }
    cur = lower.push_u8(cur, ch);
    i += 1;
  }
  parts.push(intrinsics.slice_string(cur));
  return true;
}

fn mk_str_lit(sv: string, file: string, line: i32, col: i32) -> *parse.Expr {
  let lit: *parse.Expr = parse.mkexpr(parse.ExprKind.ExStr, file, line, col);
  lit.sv = sv;
  return lit;
}

fn check_call(e: *parse.Expr, expected: *parse.Type) -> *parse.Type {
  // printf/eprintf/format builtins: each `{}` takes the next value's
  // to_str. The printing pair desugars here into `__fmt_print("...",
  // x.to_str(), ...)` — a variadic string join in the prelude — or, with
  // no placeholders, into the raw byte sink; format desugars the same way
  // into `__fmt_build(...) -> string` (no placeholders: the literal
  // itself); then the regular path checks the rewritten call
  if e.a.kind == parse.ExprKind.ExName && (cli.streq(e.a.sv, "printf") || cli.streq(e.a.sv, "eprintf") || cli.streq(e.a.sv, "format")) {
    let err_sink: bool = cli.streq(e.a.sv, "eprintf");
    let to_value: bool = cli.streq(e.a.sv, "format");
    let mut verb: string = "printf";
    if err_sink {
      verb = "eprintf";
    } else if to_value {
      verb = "format";
    }
    if e.args.n == 0 {
      cli.err_at(e.file, e.line, e.col, "a call to " + verb + " needs a format string" + "");
      e.typed = ty_err();
      return e.typed;
    }
    let fmt: *parse.Expr = e.args.items[0];
    if fmt.kind != parse.ExprKind.ExStr {
      cli.err_at(fmt.file, fmt.line, fmt.col, "the format string passed to " + verb + " must be a string literal" + "");
      e.typed = ty_err();
      return e.typed;
    }
    let parts: *cli.Vec[string] = new cli.Vec[string] { items: make([]string, 8), n: 0 };
    if !split_format(fmt.sv, parts) {
      let b1: []u8 = lower.push_u8(make([]u8, 0), g_fmt_bad as u8);
      let b2: []u8 = lower.push_u8(lower.push_u8(make([]u8, 0), g_fmt_bad as u8), g_fmt_bad as u8);
      cli.err_at(fmt.file, fmt.line, fmt.col,
             "stray `" + cli.bytes_as_string(b1) + "` in the format string (escape it as `" + cli.bytes_as_string(b2) + "`)");
      e.typed = ty_err();
      return e.typed;
    }
    if g_fmt_holes as usize != e.args.n - 1 {
      cli.err_at(e.file, e.line, e.col, "the format string has " + cli.itoa(g_fmt_holes as i64) + " `{}` but " + cli.itoa((e.args.n - 1) as i64) + " values were given" + "");
      e.typed = ty_err();
      return e.typed;
    }
    let nargs: *cli.Vec[*parse.Expr] = parse.fresh_expr_vec();
    if g_fmt_holes == 0 && to_value {
      // format with no placeholders is the literal itself: no call, no copy
      e.kind = parse.ExprKind.ExStr;
      e.sv = parts.items[0];
      return check_expr(e, null);
    }
    if g_fmt_holes == 0 {
      nargs.push(mk_str_lit(parts.items[0], fmt.file, fmt.line, fmt.col));
      if err_sink {
        e.a.sv = "__eprint_str";
      } else {
        e.a.sv = "__print_str";
      }
    } else {
      let mut k: usize = 0;
      while k <= g_fmt_holes as usize {
        nargs.push(mk_str_lit(parts.items[k], fmt.file, fmt.line, fmt.col));
        if k == g_fmt_holes as usize {
          break;
        }
        let recv: *parse.Expr = e.args.items[k + 1];
        let field: *parse.Expr = parse.mkexpr(parse.ExprKind.ExField, recv.file, recv.line, recv.col);
        field.a = recv;
        field.sv = "to_str";
        let call: *parse.Expr = parse.mkexpr(parse.ExprKind.ExCall, recv.file, recv.line, recv.col);
        call.a = field;
        nargs.push(call);
        k += 1;
      }
      if to_value {
        e.a.sv = "__fmt_build";
      } else if err_sink {
        e.a.sv = "__fmt_eprint";
      } else {
        e.a.sv = "__fmt_print";
      }
    }
    e.args = nargs;
    e.arg_names = parse.fresh_str_vec();
    e.a.sym = null;
    // fall through: the sink is variadic, so each value is checked
    // against string; a value without to_str reports its own error there
  }
  // make(T, n)
  if e.a.kind == parse.ExprKind.ExName && cli.streq(e.a.sv, "make") {
    if e.args.n != 2 {
      cli.err_at("", 0, 0, "make takes (type, length)");
      e.typed = ty_err();
      return e.typed;
    }
    let tye: *parse.Expr = e.args.items[0];
    if tye.kind != parse.ExprKind.ExType || tye.ty.kind != parse.TypeAstKind.TaArray || tye.ty.size != null {
      cli.err_at("", 0, 0, "make takes a slice type like `[]i32`");
      e.typed = ty_err();
      return e.typed;
    }
    let elem: *parse.Type = resolve_type_in_module(cur_module, tye.ty.elem);
    let mut ln: *parse.Type = check_expr(e.args.items[1], null);
    if ln.kind == TypeKind.TyIntLit {
      ln = ty_prim(12);
      e.args.items[1].typed = ln;
    }
    if !ty_is_int(ln) {
      cli.err_at("", 0, 0, "make length must be an integer");
    }
    e.typed = ty_slice(elem);
    return e.typed;
  }
  // len(x)
  if e.a.kind == parse.ExprKind.ExName && cli.streq(e.a.sv, "len") {
    if e.args.n != 1 {
      cli.err_at("", 0, 0, "len takes one argument");
      e.typed = ty_err();
      return e.typed;
    }
    let t: *parse.Type = check_expr(e.args.items[0], null);
    if t.kind != TypeKind.TySlice && t.kind != TypeKind.TyStringK && t.kind != TypeKind.TyArray {
      cli.err_at("", 0, 0, "len needs an array, slice or string");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = ty_prim(12);
    return e.typed;
  }
  // weak.from(p)
  if e.a.kind == parse.ExprKind.ExField && e.a.a.kind == parse.ExprKind.ExName &&
     cli.streq(e.a.a.sv, "weak") && cli.streq(e.a.sv, "from") {
    if e.args.n != 1 {
      cli.err_at("", 0, 0, "weak.from takes one argument");
      e.typed = ty_err();
      return e.typed;
    }
    let t: *parse.Type = check_expr(e.args.items[0], null);
    if t.kind != TypeKind.TyPtr ||
       (t.elem.kind != TypeKind.TyStruct && t.elem.kind != TypeKind.TyEnum) {
      cli.err_at("", 0, 0, "weak.from needs a pointer to a new object");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = ty_weak(t.elem);
    return e.typed;
  }
  // w.get()
  if e.a.kind == parse.ExprKind.ExField && cli.streq(e.a.sv, "get") {
    let mut bt: *parse.Type = e.a.a.typed;
    if bt == null {
      bt = check_expr(e.a.a, null);
    }
    if bt != null && bt.kind == TypeKind.TyWeak {
      if e.args.n != 0 {
        cli.err_at("", 0, 0, "get takes no arguments");
      }
      e.typed = ty_ptr(bt.elem);
      return e.typed;
    }
  }
  // intrinsics.*
  if e.a.kind == parse.ExprKind.ExField && e.a.a.kind == parse.ExprKind.ExName &&
     cli.streq(e.a.a.sv, "intrinsics") {
    let name: string = e.a.sv;
    let is_load: bool = cli.streq(name, "load_u8") || cli.streq(name, "load_u32") ||
                        cli.streq(name, "load_u64") || cli.streq(name, "load_i64");
    let is_store: bool = cli.streq(name, "store_u8") || cli.streq(name, "store_u32") ||
                         cli.streq(name, "store_u64") || cli.streq(name, "store_i64");
    let is_memcpy: bool = cli.streq(name, "memcpy");
    let is_slice_str: bool = cli.streq(name, "slice_string");
    let is_bits: bool = cli.streq(name, "f64_bits") || cli.streq(name, "f32_bits");
    let is_mem: bool = cli.streq(name, "mem_size") || cli.streq(name, "mem_grow");
    if !is_load && !is_store && !is_memcpy && !is_slice_str && !is_bits &&
       !is_mem {
      cli.err_at("", 0, 0, "unknown intrinsic `" + name + "`");
      e.typed = ty_err();
      return e.typed;
    }
    if is_mem {
      // linear-memory introspection (spec 10): the wasi prelude's bump
      // allocator grows memory on demand with these — both yield usize
      if cli.streq(name, "mem_grow") {
        if e.args.n != 1 {
          cli.err_at("", 0, 0, "intrinsics.mem_grow takes one argument");
          e.typed = ty_err();
          return e.typed;
        }
        let gt: *parse.Type = check_expr(e.args.items[0], null);
        if gt.kind != TypeKind.TyUsize {
          cli.err_at("", 0, 0, "intrinsics.mem_grow needs usize pages");
          e.typed = ty_err();
          return e.typed;
        }
      } else {
        if e.args.n != 0 {
          cli.err_at("", 0, 0, "intrinsics.mem_size takes no arguments");
          e.typed = ty_err();
          return e.typed;
        }
      }
      e.typed = ty_prim(12); // usize
      return e.typed;
    }
    if is_bits {
      if e.args.n != 1 {
        cli.err_at("", 0, 0, "unknown intrinsic `" + name + "`");
        e.typed = ty_err();
        return e.typed;
      }
      let t: *parse.Type = check_expr(e.args.items[0], null);
      let wantf64: bool = cli.streq(name, "f64_bits");
      if wantf64 && t.kind != TypeKind.TyF64 {
        cli.err_at("", 0, 0, "intrinsics.f64_bits needs f64");
        e.typed = ty_err();
        return e.typed;
      }
      if !wantf64 && t.kind != TypeKind.TyF32 {
        cli.err_at("", 0, 0, "intrinsics.f32_bits needs f32");
        e.typed = ty_err();
        return e.typed;
      }
      if wantf64 {
        e.typed = ty_prim(8); // u64
      } else {
        e.typed = ty_prim(7); // u32
      }
      return e.typed;
    }
    if is_load {
      if e.args.n != 1 {
        cli.err_at("", 0, 0, "intrinsics load takes one pointer");
        e.typed = ty_err();
        return e.typed;
      }
      let t: *parse.Type = check_expr(e.args.items[0], null);
      if t.kind != TypeKind.TyPtr {
        cli.err_at("", 0, 0, "intrinsics load needs a pointer");
        e.typed = ty_err();
        return e.typed;
      }
      let mut k: i32 = 8; // u32 default falls out below
      if cli.streq(name, "load_u8") { k = 5; }
      if cli.streq(name, "load_u32") { k = 7; }
      if cli.streq(name, "load_u64") { k = 8; }
      if cli.streq(name, "load_i64") { k = 4; }
      e.typed = ty_prim(k);
      return e.typed;
    }
    if is_store {
      if e.args.n != 2 {
        cli.err_at("", 0, 0, "intrinsics store takes pointer and value");
        e.typed = ty_err();
        return e.typed;
      }
      let t: *parse.Type = check_expr(e.args.items[0], null);
      if t.kind != TypeKind.TyPtr {
        cli.err_at("", 0, 0, "intrinsics store needs a pointer");
        e.typed = ty_err();
        return e.typed;
      }
      check_expr(e.args.items[1], null);
      e.typed = ty_prim(14);
      return e.typed;
    }
    if is_memcpy {
      if e.args.n != 3 {
        cli.err_at("", 0, 0, "memcpy takes dst, src and count");
        e.typed = ty_err();
        return e.typed;
      }
      check_expr(e.args.items[0], null);
      check_expr(e.args.items[1], null);
      check_expr(e.args.items[2], null);
      e.typed = ty_prim(14);
      return e.typed;
    }
    // slice_string
    if e.args.n != 1 {
      cli.err_at("", 0, 0, "slice_string takes one []u8");
      e.typed = ty_err();
      return e.typed;
    }
    let t: *parse.Type = check_expr(e.args.items[0], null);
    if t.kind != TypeKind.TySlice {
      cli.err_at("", 0, 0, "slice_string takes a []u8");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = ty_prim(11);
    return e.typed;
  }
  // general call path (L6e): resolve_callee + arg checking + generics
  let ct: *CallTarget = resolve_callee(e.a);
  if ct.kind == CtKind.CtNone {
    e.typed = ty_err();
    return e.typed;
  }
  if ct.kind == CtKind.CtVariant {
    // variant construction: if the context pins an instantiation of the same
    // enum, use it; payloads resolve under the enum's template env
    if expected != null && expected.kind == TypeKind.TyEnum &&
       expected.rec != null && expected.rec.decl == ct.enum_type.rec.decl {
      ct.enum_type = expected;
    }
    let d: *parse.Decl = ct.enum_type.rec.decl;
    let v: *parse.VariantAst = d.variants.items[ct.variant];
    let saved_env: *parse.TypeMap = g_tenv;
    if ct.enum_type.rec.env_tenv != null {
      g_tenv = ct.enum_type.rec.env_tenv;
    }
    if ct.is_ctor {
      let mut i: usize = 0;
      while i < e.args.n {
        let init: *parse.Expr = e.args.items[i];
        let mut ft: *parse.Type = null;
        if v.vkind == parse.VarKind.VarStruct && i < v.fields.n {
          // named field: find the payload type by name
          let mut nm: string = "";
          if i < e.arg_names.n {
            nm = e.arg_names.items[i];
          }
          let mut j2: usize = 0;
          while j2 < v.fields.n {
            if cli.streq(v.fields.items[j2].name, nm) {
              ft = variant_field_type(ct.enum_type, ct.variant, j2 as i32);
              j2 = v.fields.n;
            } else {
              j2 += 1;
            }
          }
        }
        let got: *parse.Type = check_expr(init, ft);
        if ft != null {
          init.typed = adapt_literal(got, ft);
        }
        i += 1;
      }
    } else {
      let mut i: usize = 0;
      while i < e.args.n {
        let mut at: *parse.Type = null;
        if i < v.types.n {
          at = resolve_type_in_module(cur_module, v.types.items[i]);
        }
        check_expr(e.args.items[i], at);
        i += 1;
      }
    }
    g_tenv = saved_env;
    e.typed = ct.enum_type;
    return e.typed;
  }
  // generic call: infer the type arguments and specialize
  if ct.kind == CtKind.CtFn &&
     (ct.inst_rec != null || (ct.sym.decl.templated && ct.sym.decl.tparams.n > 0)) {
    let env: *parse.TypeMap = parse.tm_new();
    let names: *cli.Vec[string] = make_str_vec();
    if ct.inst_rec != null {
      let rd: *parse.Decl = ct.inst_rec.decl;
      let mut ri: usize = 0;
      while ri < rd.tparams.n && ri < len(ct.inst_rec.targs) {
        names.push(rd.tparams.items[ri]);
        parse.tm_put(env, rd.tparams.items[ri], ct.inst_rec.targs[ri]);
        ri += 1;
      }
    }
    let mut ni: usize = 0;
    while ni < ct.sym.decl.tparams.n {
      names.push(ct.sym.decl.tparams.items[ni]);
      ni += 1;
    }
    let fn_t: *parse.Type = ct.fn_type; // template signature
    let nparams0: usize = len(fn_t.params);
    let first: usize = if ct.is_method { 1 } else { 0 };
    if ct.is_method {
      let mut recv: *parse.Type = e.a.a.typed;
      if recv == null {
        recv = check_expr(e.a.a, null);
      }
      infer_targs(fn_t.params[0], recv, env);
    }
    if e.args.n + first != nparams0 {
      cli.err_at(e.file, e.line, e.col, "function takes " + cli.itoa((nparams0 - first) as i64) + " arguments, got " + cli.itoa(e.args.n as i64) + "");
    }
    let mut gi: usize = 0;
    while gi < e.args.n {
      let at: *parse.Type = check_expr(e.args.items[gi], null);
      infer_targs(fn_t.params[first + gi], at, env);
      gi += 1;
    }
    // untyped literals adapt through a direct `-> T` return
    if expected != null && fn_t.ret != null && fn_t.ret.kind == TypeKind.TyParam {
      let targ: *parse.Type = parse.tm_get(env, fn_t.ret.mangled);
      if targ != null && targ.kind == TypeKind.TyIntLit && ty_is_int(expected) {
        parse.tm_put(env, fn_t.ret.mangled, expected);
      } else if targ != null && targ.kind == TypeKind.TyFloatLit && ty_is_flt(expected) {
        parse.tm_put(env, fn_t.ret.mangled, expected);
      }
    }
    let inst: *Sym = instantiate_fn(ct.sym, names.items[0..names.n], env, e);
    ct.sym = inst;
    ct.fn_type = inst.type;
    ct.inst_rec = null;
    e.a.sym = inst; // lower emits the call against the instantiation
  }
  // fn/extern/indirect: check args against the signature
  let ft: *parse.Type = ct.fn_type;
  let nparams: usize = len(ft.params);
  // variadic callee: the trailing `rest: T...` parameter is a []T the call
  // site builds from the extra arguments (or takes whole from `xs...`)
  let variadic: bool = ct.sym != null && ct.sym.kind == SymKind.SyFn &&
                       ct.sym.decl != null && ct.sym.decl.kind == parse.DeclKind.DkFn &&
                       ct.sym.decl.params.n > 0 &&
                       ct.sym.decl.params.items[ct.sym.decl.params.n - 1].is_variadic;
  let spread: bool = e.args.n > 0 && e.args.items[e.args.n - 1].spread;
  if spread && !variadic {
    cli.err_at(e.args.items[e.args.n - 1].file, e.args.items[e.args.n - 1].line,
           e.args.items[e.args.n - 1].col, "`...` spread needs a variadic parameter to fill");
  }
  // a dyn call's signature already excludes the receiver — the virtual
  // call passes the object as the hidden env, so args align with params
  let dyn_call: bool = ct.sym != null && ct.sym.kind == SymKind.SyTraitMethod;
  let mut arg_off: usize = 0;
  if ct.is_method && dyn_call {
    if !variadic || spread {
      if e.args.n != nparams {
        cli.err_at(e.file, e.line, e.col, "method takes " + cli.itoa(nparams as i64) + " arguments, got " + cli.itoa(e.args.n as i64) + "" + "" + "");
      }
    } else {
      if e.args.n < nparams {
        cli.err_at(e.file, e.line, e.col, "method takes at least " + cli.itoa(nparams as i64) + " arguments, got " + cli.itoa(e.args.n as i64) + "" + "" + "");
      }
    }
  } else if ct.is_method {
    if !variadic || spread {
      if e.args.n + 1 != nparams {
        cli.err_at(e.file, e.line, e.col, "method takes " + cli.itoa((nparams - 1) as i64) + " arguments, got " + cli.itoa(e.args.n as i64) + "");
      }
    } else {
      if e.args.n + 1 < nparams {
        cli.err_at(e.file, e.line, e.col, "method takes at least " + cli.itoa((nparams - 1) as i64) + " arguments, got " + cli.itoa(e.args.n as i64) + "");
      }
    }
    let self_param: *parse.Type = ft.params[0];
    let mut recv: *parse.Type = e.a.a.typed;
    if recv == null || recv.kind == TypeKind.TyErr {
      recv = check_expr(e.a.a, null);
    }
    // accept receiver by value or pointer when self matches the other form
    let mut ok: bool = types_compatible(recv, self_param);
    let literal_recv: bool = recv != null &&
      (recv.kind == TypeKind.TyIntLit || recv.kind == TypeKind.TyFloatLit);
    if !ok && recv != null && recv.kind == TypeKind.TyPtr && self_param.kind != TypeKind.TyPtr &&
       types_compatible(recv.elem, self_param) {
      ok = true; // self: T, receiver *T: auto-deref (no auto-ref; there is no &)
    }
    if !ok && literal_recv && self_param != null &&
       ((recv.kind == TypeKind.TyIntLit && ty_is_int(self_param)) ||
        (recv.kind == TypeKind.TyFloatLit && ty_is_flt(self_param))) {
      ok = true; // untyped literal receiver adapts to self (`5.to_str()`)
    }
    if !ok {
      cli.err_at(e.a.file, e.a.line, e.a.col, "method `" + e.a.sv + "` expects self as `" + ty_name(self_param) + "`, receiver is `" + ty_name(recv) + "`");
    } else if literal_recv {
      // adapt it so lowering materializes the constant at self's width
      require(recv, self_param, e.a.a, "method receiver");
    }
    arg_off = 1;
  } else if variadic && !spread {
    if e.args.n < nparams - 1 {
      cli.err_at(e.file, e.line, e.col, "function takes at least " + cli.itoa((nparams - 1) as i64) + " arguments, got " + cli.itoa(e.args.n as i64) + "" + "" + "");
    }
  } else if variadic && spread {
    if e.args.n != nparams {
      cli.err_at(e.file, e.line, e.col, "function takes exactly " + cli.itoa((nparams - 1) as i64) + " arguments before the spread, got " + cli.itoa(e.args.n as i64) + "" + "" + "");
    }
  } else if e.args.n != nparams {
    cli.err_at(e.file, e.line, e.col, "function takes " + cli.itoa(nparams as i64) + " arguments, got " + cli.itoa(e.args.n as i64) + "");
  }
  let mut i: usize = arg_off;
  while i < nparams {
    let ai: usize = i - arg_off;
    if ai >= e.args.n {
      break;
    }
    let last: bool = i + 1 == nparams;
    let pt: *parse.Type = ft.params[i];
    if variadic && last {
      // the slice param: a spread arg passes its value whole; otherwise the
      // remaining args are checked element-wise against T
      if spread {
        let at: *parse.Type = check_expr(e.args.items[ai], pt);
        if at.kind != TypeKind.TyErr && at != pt {
          cli.err_at(e.args.items[ai].file, e.args.items[ai].line, e.args.items[ai].col,
                 "spread needs `" + ty_name(pt) + "`, found `" + ty_name(at) + "`" + "");
        }
        i += 1;
        continue;
      }
      let elem: *parse.Type = pt.elem;
      let mut k: usize = ai;
      while k < e.args.n {
        let at2: *parse.Type = check_expr(e.args.items[k], elem);
        require(at2, elem, e.args.items[k], "argument");
        k += 1;
      }
      break;
    }
    let at3: *parse.Type = check_expr(e.args.items[ai], pt);
    if !(e.args.items[ai].spread && !variadic) {
      require(at3, pt, e.args.items[ai], "argument");
    }
    i += 1;
  }
  e.typed = ft.ret;
  // never coercion: panic never returns, so a call to it is compatible with
  // any expected type (match arms like `Result.Err(_) => panic("...")`)
  if expected != null && expected.kind != TypeKind.TyErr &&
     expected.kind != TypeKind.TyVoid && ft.ret != null &&
     ft.ret.kind == TypeKind.TyVoid && ct.sym != null && ct.sym.owner != null &&
     cli.streq(ct.sym.name, "panic") &&
     (ct.sym.owner == prelude_module || ct.sym.owner.is_prelude) {
    e.typed = expected;
  }
  return e.typed;
}


// ============== statement checking (check.c port L6e) =====================

pub static mut in_defer: bool = false;
pub static mut loop_depth: i32 = 0;

fn ty_is_or_has_err(t: *parse.Type) -> bool {
  if t == null {
    return false;
  }
  if t.kind == TypeKind.TyErr {
    return true;
  }
  if t.elem != null && ty_is_or_has_err(t.elem) {
    return true;
  }
  if t.ret != null && ty_is_or_has_err(t.ret) {
    return true;
  }
  return false;
}

fn lvalue_mutable(e: *parse.Expr) -> bool {
  if e.kind == parse.ExprKind.ExName {
    let sym: *Sym = e.sym;
    if sym == null {
      return false;
    }
    if sym.kind == SymKind.SyLocal || sym.kind == SymKind.SyParam ||
       sym.kind == SymKind.SyStatic {
      return sym.mutable;
    }
    return false;
  }
  if e.kind == parse.ExprKind.ExUn && e.unop == lex.Tok.PStar {
    return true; // *p — the pointer decides
  }
  if e.kind == parse.ExprKind.ExField {
    // module-qualified storage: `mod.STATIC = x` mutates the static itself;
    // a const stays immutable wherever it is named
    let fsym: *Sym = e.sym;
    if fsym != null && (fsym.kind == SymKind.SyStatic || fsym.kind == SymKind.SyConst) {
      return fsym.kind == SymKind.SyStatic && fsym.mutable;
    }
    let bt: *parse.Type = e.a.typed;
    if bt != null && bt.kind == TypeKind.TyPtr {
      return true; // heap object
    }
    return lvalue_mutable(e.a);
  }
  if e.kind == parse.ExprKind.ExIndex {
    let bt: *parse.Type = e.a.typed;
    if bt != null && bt.kind == TypeKind.TySlice {
      return true; // heap buffer shared by reference
    }
    return lvalue_mutable(e.a);
  }
  return false;
}

fn check_stmt(s: *parse.Stmt) {
  if s.kind == parse.StmtKind.StLet {
    let mut ann: *parse.Type = null;
    if s.ty != null {
      ann = resolve_type_in_module(cur_module, s.ty);
    }
    let mut t: *parse.Type = check_expr(s.a, ann);
    if ann != null {
      // the annotation pins the binding's type; literals adapt, anything
      // else must genuinely match. An error type already has its own
      // diagnostic — don't pile a second one onto it
      if !ty_is_or_has_err(ann) && !ty_is_or_has_err(t) {
        require(t, ann, s.a, "initializer");
      }
      t = ann;
      if s.a.kind != parse.ExprKind.ExDynbox && t.kind == TypeKind.TyDyn &&
         s.a.typed != null && s.a.typed.kind != TypeKind.TyDyn &&
         !ty_is_or_has_err(s.a.typed) {
        try_dyn_coerce(s.a, s.a.typed, t);
        s.a.typed = t;
      }
    } else {
      if t.kind == TypeKind.TyIntLit {
        t = ty_prim(3);
      } else if t.kind == TypeKind.TyFloatLit {
        t = ty_prim(10);
      } else if t.kind == TypeKind.TyNull {
        cli.err_at(s.file, s.line, s.col, "`null` needs a type annotation");
        t = ty_err();
      } else if t.kind == TypeKind.TyErr {
        t = ty_err();
      } else if t.kind == TypeKind.TyVoid {
        cli.err_at(s.file, s.line, s.col, "cannot bind void");
        t = ty_err();
      }
    }
    let sym: *Sym = new Sym {
      kind: SymKind.SyLocal, name: s.name, type: t, decl: null,
      mutable: s.mut_, variant_index: 0, local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
    trait_rec: null,
    };
    next_local_id += 1;
    if scope_lookup(s.name) != null {
      cli.err_at(s.file, s.line, s.col, "`" + s.name + "` shadows an existing binding" + "");
    }
    scope_decl(s.name, sym);
    s.a.typed = t;
    return;
  }
  if s.kind == parse.StmtKind.StAssign {
    let target: *parse.Type = check_expr(s.a, null);
    let compound: bool = s.assign_op != lex.Tok.PAssign;
    let mut value: *parse.Type = null;
    if compound {
      value = adapt_literal(check_expr(s.b, target), target);
      s.b.typed = value;
      // target op value must be well-formed and equal target's type
      if s.assign_op == lex.Tok.PShleq || s.assign_op == lex.Tok.PShreq {
        if !ty_is_int(target) || !ty_is_int(value) {
          cli.err_at(s.file, s.line, s.col, "shift assignment needs integers");
        }
      } else {
        if !types_compatible(target, value) && !(ty_is_int(target) && ty_is_int(value)) &&
           !(ty_is_flt(target) && ty_is_flt(value)) {
          cli.err_at(s.file, s.line, s.col, "type mismatch in assignment: `" + ty_name(target) + "` vs `" + ty_name(value) + "`");
        }
      }
    } else {
      value = adapt_literal(check_expr(s.b, target), target);
      if value != target && target.kind == TypeKind.TyDyn &&
         value.kind != TypeKind.TyDyn && !ty_is_or_has_err(value) {
        try_dyn_coerce(s.b, value, target);
        value = target;
      }
      s.b.typed = value;
      if !types_compatible(target, value) {
        cli.err_at(s.file, s.line, s.col, "cannot assign `" + ty_name(value) + "` to `" + ty_name(target) + "`");
      }
    }
    if !lvalue_mutable(s.a) {
      cli.err_at(s.file, s.line, s.col, "cannot assign to an immutable binding (declare it `let mut`)");
    }
    return;
  }
  if s.kind == parse.StmtKind.StExpr {
    check_expr(s.a, null);
    return;
  }
  if s.kind == parse.StmtKind.StReturn {
    if in_defer {
      cli.err_at(s.file, s.line, s.col, "`return` is not allowed in defer");
      return;
    }
    if cur_ret == null || cur_ret.kind == TypeKind.TyVoid {
      if s.a != null {
        cli.err_at(s.file, s.line, s.col, "this function returns nothing");
      }
    } else {
      if s.a == null {
        cli.err_at(s.file, s.line, s.col, "missing return value");
      } else {
        require(check_expr(s.a, cur_ret), cur_ret, s.a, "return value");
      }
    }
    return;
  }
  if s.kind == parse.StmtKind.StBreak || s.kind == parse.StmtKind.StContinue {
    let mut w: string = "break";
    if s.kind == parse.StmtKind.StContinue {
      w = "continue";
    }
    if in_defer {
      cli.err_at(s.file, s.line, s.col, "`" + w + "` is not allowed in defer");
    } else if loop_depth == 0 {
      cli.err_at(s.file, s.line, s.col, "`" + w + "` outside of a loop");
    }
    return;
  }
  if s.kind == parse.StmtKind.StDefer {
    let saved: bool = in_defer;
    in_defer = true;
    scope_push();
    let mut i: usize = 0;
    while i < s.stmts.n {
      check_stmt(s.stmts.items[i]);
      i += 1;
    }
    scope_pop();
    in_defer = saved;
    return;
  }
  if s.kind == parse.StmtKind.StWhile {
    let saved_depth: i32 = loop_depth;
    loop_depth += 1;
    let cond: *parse.Type = check_expr(s.cond, null);
    if cond.kind != TypeKind.TyBool {
      cli.err_at("", 0, 0, "while condition must be bool");
    }
    scope_push();
    let mut i: usize = 0;
    while i < s.body.n {
      check_stmt(s.body.items[i]);
      i += 1;
    }
    scope_pop();
    loop_depth = saved_depth;
    return;
  }
  if s.kind == parse.StmtKind.StLoop {
    let saved_depth: i32 = loop_depth;
    loop_depth += 1;
    scope_push();
    let mut i: usize = 0;
    while i < s.body.n {
      check_stmt(s.body.items[i]);
      i += 1;
    }
    scope_pop();
    loop_depth = saved_depth;
    return;
  }
  if s.kind == parse.StmtKind.StBlock {
    scope_push();
    let mut i: usize = 0;
    while i < s.stmts.n {
      check_stmt(s.stmts.items[i]);
      i += 1;
    }
    scope_pop();
    return;
  }
}

fn check_fn_body(d: *parse.Decl, sym: *Sym, m: *Module) {
  // resolve against the fn's OWN module (boot: cur_module = sym->owner) —
  // instantiation clones checked here belong to the generic's owner, not
  // to whichever module ran the worklist last
  let saved_mod: *Module = cur_module;
  cur_module = sym.owner;
  if d.tparams.n > 0 {
    // generic template: check once under TY_PARAM placeholders
    g_tenv = template_env_of(d);
  } else if len(d.recv) > 0 {
    let mut struct_sym: *Sym = sm_get(m.syms, d.recv);
    if struct_sym == null && prelude_module != null && prelude_module != m {
      struct_sym = sm_get(prelude_module.syms, d.recv);
    }
    if struct_sym != null && struct_sym.decl.tparams.n > 0 {
      let tmpl: *parse.RecType = ensure_template(struct_sym.decl, m);
      g_tenv = tmpl.env_tenv;
    }
  }
  cur_ret = sym.type.ret;
  // this fn's return-ness is being judged: tail calls to it inside its own
  // body answer from the declared signature (cycle-safe, memoized)
  if g_ret_judging == null {
    g_ret_judging = new cli.Vec[*parse.Decl] { items: make([]*parse.Decl, 8), n: 0 };
  }
  g_ret_judging.push(d);
  scope_push();
  let mut i: usize = 0;
  while i < d.params.n {
    let p: *parse.Param = d.params.items[i];
    // use the symbol's resolved signature: instantiation clones carry
    // concrete param types the AST re-resolution would clobber
    let pt: *parse.Type = if i < len(sym.type.params) {
      sym.type.params[i]
    } else {
      resolve_type_in_module(cur_module, p.ty)
    };
    let ps: *Sym = new Sym {
      kind: SymKind.SyParam, name: p.name, type: pt, decl: null,
      mutable: true, variant_index: 0, local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
    trait_rec: null,
    };
    next_local_id += 1;
    scope_decl(p.name, ps);
    i += 1;
  }
  let mut k: usize = 0;
  while k < d.body.n {
    check_stmt(d.body.items[k]);
    k += 1;
  }
  if cur_ret != null && cur_ret.kind != TypeKind.TyVoid && !block_returns(d.body) {
    cli.err_at(d.file, d.line, d.col, "missing return: `" + d.name + "` is `" + ty_name(cur_ret) + "`");
  }
  g_ret_judging.n -= 1;
  scope_pop();
  g_tenv = null;
  cur_module = saved_mod;
}


// ============== check driver (check.c port L6f) ===========================

// attach a method to its receiver struct's RecType — or, for a primitive
// receiver (`fn i32.to_str`), to the global primitive table — and build the
// fn type
fn wire_method(m: *Module, d: *parse.Decl) -> *parse.Type {
  let mut struct_sym: *Sym = sm_get(m.syms, d.recv);
  if struct_sym == null && prelude_module != null && prelude_module != m {
    struct_sym = sm_get(prelude_module.syms, d.recv);
  }
  // resolve the signature under the RECEIVER type's template env, so bare
  // generic references (`self: Option`) name the template
  let saved_env: *parse.TypeMap = g_tenv;
  if struct_sym != null && struct_sym.decl.tparams.n > 0 {
    let tmpl: *parse.RecType = ensure_template(struct_sym.decl, m);
    g_tenv = tmpl.env_tenv;
  }
  let nparams: usize = d.params.n;
  let mut ps: []*parse.Type = fresh_type_vec2();
  let mut i: usize = 0;
  while i < nparams {
    ps = push_type(ps, resolve_type_in_module(m, d.params.items[i].ty));
    i += 1;
  }
  let ret: *parse.Type = resolve_type_in_module(m, d.ret);
  let ft: *parse.Type = ty_fn(ps, ret);
  let msym: *Sym = new Sym {
    kind: SymKind.SyFn, name: d.name, type: ft, decl: d,
    mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: cur_module,
    module: null,
  trait_rec: null,
  };
  // attach the method to the receiver's own rec (deref through *self) — or
  // to the global per-primitive table when self anchors a builtin type
  if len(ps) > 0 {
    let mut rec_t: *parse.Type = ps[0];
    if rec_t.kind == TypeKind.TyPtr {
      rec_t = rec_t.elem;
    }
    if rec_t.kind == TypeKind.TyStruct || rec_t.kind == TypeKind.TyEnum {
      if rec_t.rec != null {
        rec_t.rec.methods = push_sym(rec_t.rec.methods, msym);
      }
    } else if ty_is_primitive(rec_t) {
      if prim_method_find(rec_t, d.name) != null {
        cli.err_at(d.file, d.line, d.col, "duplicate method `" + d.name + "` for primitive `" + rec_t.mangled + "` (primitive methods are global)" + "");
      } else {
        if g_prim_methods == null {
          g_prim_methods = new cli.Vec[*PrimMethods] { items: make([]*PrimMethods, 8), n: 0 };
        }
        let mut list: *PrimMethods = null;
        let mut li: usize = 0;
        while li < g_prim_methods.n {
          if cli.streq(g_prim_methods.items[li].key, rec_t.mangled) {
            list = g_prim_methods.items[li];
          }
          li += 1;
        }
        if list == null {
          list = new PrimMethods { key: rec_t.mangled, syms: make([]*Sym, 0) };
          g_prim_methods.push(list);
        }
        list.syms = push_sym(list.syms, msym);
      }
    } else {
      cli.err_at(d.file, d.line, d.col, "`self` must be a struct, enum, or primitive");
    }
  }
  g_tenv = saved_env;
  return ft;
}

// one fn parameter's resolved type: `rest: T...` is `[]T` to every caller
// (the call site decides how the slice is built)
fn variadic_param_type(m: *Module, d: *parse.Decl, idx: usize) -> *parse.Type {
  let pt: *parse.Type = resolve_type_in_module(m, d.params.items[idx].ty);
  if d.params.items[idx].is_variadic {
    if type_has_param(pt) {
      cli.err_at(d.params.items[idx].file, d.params.items[idx].line, d.params.items[idx].col,
             "a variadic parameter needs a concrete element type");
    }
    return ty_slice(pt);
  }
  return pt;
}

// resolve one fn/method decl's signature into its symbol (pass 2a body,
// shared with impl-block methods)
fn resolve_fn_signature(m: *Module, decl: *parse.Decl) {
  let nparams: usize = decl.params.n;
  let mut ps: []*parse.Type = fresh_type_vec2();
  let mut j: usize = 0;
  while j < nparams {
    if len(decl.recv) > 0 {
      let mut rsym: *Sym = sm_get(m.syms, decl.recv);
      if rsym == null && prelude_module != null && prelude_module != m {
        rsym = sm_get(prelude_module.syms, decl.recv);
      }
      if rsym != null && rsym.decl.tparams.n > 0 {
        let tmpl: *parse.RecType = ensure_template(rsym.decl, m);
        g_tenv = tmpl.env_tenv;
        ps = push_type(ps, variadic_param_type(m, decl, j));
        g_tenv = null;
        j += 1;
        continue;
      }
    }
    if decl.tparams.n > 0 {
      let saved_env: *parse.TypeMap = g_tenv;
      g_tenv = template_env_of(decl);
      ps = push_type(ps, variadic_param_type(m, decl, j));
      g_tenv = saved_env;
      j += 1;
      continue;
    }
    ps = push_type(ps, variadic_param_type(m, decl, j));
    j += 1;
  }
  let mut ret: *parse.Type = null;
  if decl.tparams.n > 0 {
    let saved_env1: *parse.TypeMap = g_tenv;
    g_tenv = template_env_of(decl);
    ret = resolve_type_in_module(m, decl.ret);
    g_tenv = saved_env1;
  } else {
    ret = resolve_type_in_module(m, decl.ret);
  }
  let ft: *parse.Type = ty_fn(ps, ret);
  let mut tsym: *Sym = sm_get(m.syms, decl.name);
  if decl.is_method {
    tsym = sm_get(m.syms, decl.recv + "." + decl.name + "" + "");
  }
  if tsym != null {
    tsym.type = ft;
  }
}

// full semantic check of a parsed module; returns the diag count
// load one `use` target: read + parse + register syms; the caller checks it
// resolve one `use` path to its single real body. Candidates per base
// directory, in order: `a/b/c/lib.rho` (a package — import its facade),
// then `a/b/c.rho`; both is an ambiguity. Bases: the using file's
// directory, then the entry file's directory (g_use_root, boot:
// g_root_dir) — exactly two, never a search-path list. A dot-bearing file
// (`a.b.c.rho`) is remembered only as a fallback hint: it is not a module,
// and the diag says so when nothing real answers the name.
fn resolve_use_path(m: *Module, path: *cli.Vec[string]) -> *UseRes {
  let res: *UseRes = new UseRes {
    found: false, amb: false, dotted: false, is_pkg: false,
    path: "", other: "",
  };
  let rel: string = segs_join(path, "/");
  let rel_dotted: string = segs_join(path, ".") + ".rho" + "";
  let bases: *cli.Vec[string] = new cli.Vec[string] { items: make([]string, 2), n: 0 };
  bases.push(dir_of_path(m.path));
  if !cli.streq(g_use_root, "") && !cli.streq(g_use_root, dir_of_path(m.path)) {
    bases.push(g_use_root);
  }
  let mut bi: usize = 0;
  while bi < bases.n {
    let dirp: string = bases.items[bi] + rel + "";
    let pkgp: string = dirp + "/lib.rho";
    let filep: string = dirp + ".rho";
    let pe: bool = file_readable(pkgp);
    let fe: bool = file_readable(filep);
    if pe && fe {
      res.amb = true;
      res.path = pkgp;
      res.other = filep;
      return res;
    }
    if pe {
      res.found = true;
      res.is_pkg = true;
      res.path = pkgp;
      return res;
    }
    if fe {
      res.found = true;
      res.path = filep;
      return res;
    }
    if !res.dotted {
      // hint only: a dot-bearing name is not a module, whatever it says
      let dp: string = bases.items[bi] + rel_dotted + "";
      if file_readable(dp) {
        res.dotted = true;
        res.path = dp;
      }
    }
    bi += 1;
  }
  return res;
}

// the nearest enclosing directory (never above the entry directory) that
// holds a `lib.rho` — the package a file belongs to; "" when loose. A
// package's plain files are package-private: only the facade is
// addressable from outside.
fn package_root_of(path: string) -> string {
  let mut dir: string = dir_of_path(path);
  loop {
    if file_readable(dir + "lib.rho") {
      return dir;
    }
    if cli.streq(dir, "") {
      return "";
    }
    if !cli.streq(g_use_root, "") && len(dir) <= len(g_use_root) {
      return "";
    }
    // dir ends with '/': drop the segment before that slash
    let mut cut: usize = 0;
    let mut i: usize = 0;
    while i < len(dir) - 1 {
      if dir[i] == 47 {
        cut = i;
      }
      i += 1;
    }
    if cut == 0 {
      return "";
    }
    dir = dir[0..cut + 1];
  }
}

// the facade's name: the last segment of its directory
fn package_name_of(dir: string) -> string {
  if len(dir) < 2 {
    return dir;
  }
  let end: usize = len(dir) - 1;
  let mut start: usize = 0;
  let mut i: usize = 0;
  while i < end {
    if dir[i] == 47 {
      start = i + 1;
    }
    i += 1;
  }
  return dir[start..end];
}

fn file_readable(path: string) -> bool {
  let r: Result[string, string] = cli.read_file(path);
  return r.is_ok();
}

fn dir_of_path(path: string) -> string {
  let mut last: usize = 0;
  let mut i: usize = 0;
  while i < len(path) {
    if path[i] == 47 {
      last = i + 1;
    }
    i += 1;
  }
  return path[0..last];
}

fn segs_join(path: *cli.Vec[string], sep: string) -> string {
  let mut out: string = "";
  let mut i: usize = 0;
  while i < path.n {
    if i > 0 {
      out = out + sep;
    }
    out = out + path.items[i];
    i += 1;
  }
  return out;
}

// package privacy at use time: a plain-file body inside a package is
// reachable only from within that package
fn try_privacy(m: *Module, ud: *parse.Decl, res: *UseRes) -> bool {
  if res.is_pkg {
    return true;
  }
  let bpkg: string = package_root_of(res.path);
  if cli.streq(bpkg, "") {
    return true;
  }
  let upkg: string = package_root_of(m.path);
  if cli.streq(bpkg, upkg) {
    return true;
  }
  let mut msg: string = "`" + segs_join(ud.path, ".") + "` is package-private (use the package facade `";
  msg = msg + package_name_of(bpkg) + "`)";
  cli.err_at(ud.file, ud.line, ud.col, msg);
  return false;
}

// bind one namespace name in m's symbol table; the binding's decl carries
// the pub flag the chain-access checks read. `main` is reserved in the
// root file; duplicates are the boot law's `duplicate name`.
fn bind_module_ns(m: *Module, name: string, target: *Module, decl: *parse.Decl) -> bool {
  if cli.streq(name, "main") && cli.streq(m.path, g_entry_path) {
    cli.err_at(decl.file, decl.line, decl.col,
      "`main` is reserved: the root file cannot use a module named `main`");
    return false;
  }
  if sm_get(m.syms, name) != null {
    cli.err_at(decl.file, decl.line, decl.col, "duplicate name `" + name + "`");
    return false;
  }
  let msym: *Sym = new Sym {
    kind: SymKind.SyModule, name: name, type: null,
    decl: decl, mutable: false, variant_index: 0, local_id: 0,
    symbol: "", owner: m, module: target, trait_rec: null,
  };
  sm_put(m.syms, name, msym);
  return true;
}

fn record_req(owner: *Module, d: *parse.Decl, target: *Module, item: string) {
  if g_use_reqs == null {
    g_use_reqs = new cli.Vec[*UseReq] { items: make([]*UseReq, 8), n: 0 };
  }
  g_use_reqs.push(new UseReq { owner: owner, decl: d, target: target, item: item });
}

// whether `name` is (or will be, once the re-exports materialize) present
// in a module's namespace: current syms, this module's own re-export
// records, or the pub declarations a flatten will carry
fn module_exports_or_will(target: *Module, name: string, depth: i32) -> bool {
  if depth > 8 {
    return false;
  }
  if sm_get(target.syms, name) != null {
    return true;
  }
  if g_use_reqs == null {
    return false;
  }
  let mut i: usize = 0;
  while i < g_use_reqs.n {
    let r: *UseReq = g_use_reqs.items[i];
    if r.owner == target && r.target != null {
      if !cli.streq(r.item, "") {
        let mut out: string = r.item;
        if len(r.decl.name) > 0 {
          out = r.decl.name;
        }
        if cli.streq(out, name) {
          return true;
        }
      } else if len(r.decl.name) > 0 {
        if cli.streq(r.decl.name, name) {
          return true;
        }
      } else {
        let root2: *parse.Decl = r.target.root;
        let mut j: usize = 0;
        while j < root2.decls.n {
          let d2: *parse.Decl = root2.decls.items[j];
          if d2.pub_ && decl_is_entity(d2) && !d2.is_method && cli.streq(d2.name, name) {
            return true;
          }
          j += 1;
        }
        if module_exports_or_will(r.target, name, depth + 1) {
          return true;
        }
      }
    }
    i += 1;
  }
  return false;
}

fn req_by_decl(d: *parse.Decl) -> *UseReq {
  if g_use_reqs == null {
    return null;
  }
  let mut i: usize = 0;
  while i < g_use_reqs.n {
    if g_use_reqs.items[i].decl == d {
      return g_use_reqs.items[i];
    }
    i += 1;
  }
  return null;
}

fn decl_is_entity(d: *parse.Decl) -> bool {
  if d.kind == parse.DeclKind.DkFn || d.kind == parse.DeclKind.DkStruct ||
     d.kind == parse.DeclKind.DkEnum || d.kind == parse.DeclKind.DkStatic ||
     d.kind == parse.DeclKind.DkConst || d.kind == parse.DeclKind.DkTrait ||
     d.kind == parse.DeclKind.DkExtern {
    return true;
  }
  return false;
}

fn sym_is_entity(s: *Sym) -> bool {
  if s.kind == SymKind.SyFn || s.kind == SymKind.SyStruct || s.kind == SymKind.SyEnum ||
     s.kind == SymKind.SyStatic || s.kind == SymKind.SyConst || s.kind == SymKind.SyTrait ||
     s.kind == SymKind.SyExtern {
    return true;
  }
  return false;
}

// `pub use mod.item [as alias];` — the single-item form. Both readings of
// the last segment are enumerated (the module file `mod/item.rho`, the
// item `item` of module `mod`); exactly one may exist, never a silent pick.
fn process_pub_item_use(m: *Module, ud: *parse.Decl) {
  let parent_path: *cli.Vec[string] = new cli.Vec[string] { items: make([]string, 8), n: 0 };
  let mut si: usize = 0;
  while si + 1 < ud.path.n {
    parent_path.push(ud.path.items[si]);
    si += 1;
  }
  let full: *UseRes = resolve_use_path(m, ud.path);
  let parent: *UseRes = resolve_use_path(m, parent_path);
  let dotted: string = segs_join(ud.path, ".");
  let last: string = ud.path.items[ud.path.n - 1];
  let parent_ns: string = ud.path.items[ud.path.n - 2];
  if full.amb {
    let mut msg: string = "ambiguous use `" + dotted + "`: both `";
    msg = msg + full.path + "` and `";
    msg = msg + full.other + "` exist";
    cli.err_at(ud.file, ud.line, ud.col, msg);
    return;
  }
  if parent.amb {
    let mut msg: string = "ambiguous use `" + segs_join(parent_path, ".") + "`: both `";
    msg = msg + parent.path + "` and `";
    msg = msg + parent.other + "` exist";
    cli.err_at(ud.file, ud.line, ud.col, msg);
    return;
  }
  let mut item_exists: bool = false;
  let mut parent_mod: *Module = null;
  if parent.found {
    parent_mod = load_module_at(parent.path, parent_ns);
    if parent_mod != null && module_exports_or_will(parent_mod, last, 0) {
      item_exists = true;
    }
  }
  if full.found && item_exists {
    let mut msg: string = "ambiguous re-export `" + dotted + "`: both the module `";
    msg = msg + full.path + "` and the item `";
    msg = msg + last + "` of module `";
    msg = msg + parent_ns + "` exist";
    cli.err_at(ud.file, ud.line, ud.col, msg);
    return;
  }
  if full.found {
    // module re-export: full flatten, or the namespace under an alias
    let aux: *Module = load_module_at(full.path, last);
    if aux == null || !try_privacy(m, ud, full) {
      return;
    }
    if len(ud.name) > 0 {
      if bind_module_ns(m, ud.name, aux, ud) {
        record_req(m, ud, aux, "");
      }
      return;
    }
    record_req(m, ud, aux, "");
    return;
  }
  if item_exists {
    if !try_privacy(m, ud, parent) {
      return;
    }
    record_req(m, ud, parent_mod, last);
    return;
  }
  if full.dotted || parent.dotted {
    let mut dp: string = full.path;
    if cli.streq(dp, "") {
      dp = parent.path;
    }
    cli.err_at(ud.file, ud.line, ud.col,
      "module file names cannot contain dots: `" + dp + "` is not a module");
    return;
  }
  if parent_mod != null {
    cli.err_at(ud.file, ud.line, ud.col,
      "module `" + parent_ns + "` has no item `" + last + "`" + "");
    return;
  }
  cli.err_at(ud.file, ud.line, ud.col,
    "cannot read `" + segs_join(ud.path, "/") + ".rho`" + "");
}

// parse + register one module file, or return the cached instance; cycles
// terminate at the path-keyed cache (boot: modules_by_path)
fn load_module_at(path: string, ns: string) -> *Module {
  if g_aux_modules != null {
    let mut ci: usize = 0;
    while ci < g_aux_modules.n {
      if cli.streq(g_aux_modules.items[ci].path, path) {
        return g_aux_modules.items[ci];
      }
      ci += 1;
    }
  }
  let r: Result[string, string] = cli.read_file(path);
  if r.is_err() {
    cli.err_at(path, 1, 1, "cannot read `" + path + "`" + "");
    return null;
  }
  // judge this parse by its OWN diags (a delta), never the global count —
  // an earlier decl's diag must not poison every later module load
  let before: i32 = cli.diag_count();
  let aux_root: *parse.Decl = parse.parse_file(path, r.get_ok());
  if cli.diag_count() > before {
    return null;
  }
  let aux: *Module = new Module {
    path: path, ns: ns, root: aux_root, syms: sm_new(),
    is_prelude: false, checked: false,
  };
  if g_aux_modules == null {
    g_aux_modules = new cli.Vec[*Module] { items: make([]*Module, 8), n: 0 };
  }
  g_aux_modules.push(aux);
  check_module(aux);
  return aux;
}

// the materialize pass: after every module's declarations are registered,
// carry each recorded re-export into its owner's namespace. Aliases are
// the ORIGINAL sym objects re-keyed — never copies — so instantiation,
// statics and symbol names stay one entity.
fn materialize_use_reqs() {
  if g_use_reqs == null {
    return;
  }
  // to a fixpoint: one re-export may name an alias another only produces
  // later in the same pass; leftovers diag when the queue settles
  let mut pending: *cli.Vec[i32] = new cli.Vec[i32] { items: make([]i32, 8), n: 0 };
  let mut i: usize = 0;
  while i < g_use_reqs.n {
    pending.push(i as i32);
    i += 1;
  }
  let mut progress: bool = true;
  while progress {
    progress = false;
    let mut pi: usize = 0;
    while pi < pending.n {
      let idx: i32 = pending.items[pi];
      if idx >= 0 && req_try(g_use_reqs.items[idx as usize], g_use_reqs.items[idx as usize].owner, false) {
        pending.items[pi] = 0 - 1;
        progress = true;
      }
      pi += 1;
    }
  }
  let mut pi: usize = 0;
  while pi < pending.n {
    let idx: i32 = pending.items[pi];
    if idx >= 0 {
      let req: *UseReq = g_use_reqs.items[idx as usize];
      req_try(req, req.owner, true);
    }
    pi += 1;
  }
}

// carry one re-export into dst's namespace (dst = its owner at materialize
// time, or the flattening module when reached transitively). With `emit`
// off the failures stay silent — the fixpoint uses that to retry until the
// queue settles.
fn req_try(req: *UseReq, dst: *Module, emit: bool) -> bool {
  if req.target == null {
    return true;
  }
  let d: *parse.Decl = req.decl;
  let alias: string = d.name;
  if cli.streq(req.item, "") {
    if len(alias) > 0 {
      return true; // `pub use mod as ns;` bound its namespace at registration
    }
    flatten_module_e(req.target, dst, d, emit);
    return true;
  }
  let sym: *Sym = sm_get(req.target.syms, req.item);
  if sym == null {
    if emit {
      cli.err_at(d.file, d.line, d.col,
        "module `" + req.target.ns + "` has no item `" + req.item + "`" + "");
    }
    return false;
  }
  let mut name: string = req.item;
  if len(alias) > 0 {
    name = alias;
  }
  if sym.kind == SymKind.SyModule {
    // re-exporting a namespace keeps it a namespace
    if sym.decl != null && !sym.decl.pub_ && sym.owner != null && !sym.owner.is_prelude {
      if emit {
        cli.err_at(d.file, d.line, d.col, "`" + req.item + "` is not public");
      }
      return false;
    }
    if sm_get(dst.syms, name) != null {
      if emit {
        cli.err_at(d.file, d.line, d.col, "duplicate name `" + name + "`");
      }
      return false;
    }
    sm_put(dst.syms, name, sym);
    return true;
  }
  if !sym_is_entity(sym) {
    if emit {
      cli.err_at(d.file, d.line, d.col,
        "cannot re-export `" + req.item + "` (not a module item)");
    }
    return false;
  }
  if sym.decl != null && !sym.decl.pub_ && !sym.owner.is_prelude {
    if emit {
      cli.err_at(d.file, d.line, d.col, "`" + req.item + "` is not public");
    }
    return false;
  }
  if sm_get(dst.syms, name) != null {
    if emit {
      cli.err_at(d.file, d.line, d.col, "duplicate name `" + name + "`");
    }
    return false;
  }
  sm_put(dst.syms, name, sym);
  return true;
}

// `pub use mod;` — walk the target's public declarations and re-key each
// one's sym into dst, transitively through the target's own pub uses. A
// path already on the stack is a circular re-export.
fn flatten_module(target: *Module, dst: *Module, req_decl: *parse.Decl) {
  flatten_module_e(target, dst, req_decl, true);
}

fn flatten_module_e(target: *Module, dst: *Module, req_decl: *parse.Decl, emit: bool) {
  if g_flat_stack != null {
    let mut fi: usize = 0;
    while fi < g_flat_stack.n {
      if cli.streq(g_flat_stack.items[fi], target.path) {
        // the stack state is real regardless of the retry lane: the cycle
        // diag is deterministic, so it fires on detection, not on emit
        cli.err_at(req_decl.file, req_decl.line, req_decl.col,
          "circular re-export through `" + target.ns + "`");
        return;
      }
      fi += 1;
    }
  }
  if g_flat_stack == null {
    g_flat_stack = new cli.Vec[string] { items: make([]string, 8), n: 0 };
  }
  g_flat_stack.push(target.path);
  let root: *parse.Decl = target.root;
  let mut i: usize = 0;
  while i < root.decls.n {
    let d: *parse.Decl = root.decls.items[i];
    if d.pub_ && d.kind == parse.DeclKind.DkUse {
      let sub: *UseReq = req_by_decl(d);
      if sub != null {
        req_try(sub, dst, emit);
      }
      i += 1;
      continue;
    }
    if !d.pub_ || !decl_is_entity(d) || d.is_method {
      // private things stay private; methods stay behind their type
      i += 1;
      continue;
    }
    let sym: *Sym = sm_get(target.syms, d.name);
    if sym == null {
      i += 1;
      continue;
    }
    if sm_get(dst.syms, d.name) != null {
      if emit {
        cli.err_at(req_decl.file, req_decl.line, req_decl.col,
          "duplicate name `" + d.name + "`");
      }
      i += 1;
      continue;
    }
    sm_put(dst.syms, d.name, sym);
    i += 1;
  }
  g_flat_stack.n -= 1;
}

// the entry file's directory (with trailing slash): `use` falls back to
// it when the using file's directory has no such module (boot: g_root_dir)
pub static mut g_use_root: string = "";

fn scope_decl_module(m: *Module) {
  // boot parity: module-level fns are NOT in the lexical scope — call/name
  // resolution falls back to the module table (lets named like fns, e.g.
  // `let at`, would otherwise false-positive as shadowing)
  let d: *parse.Decl = m.root;
  let mut i: usize = 0;
  while i < d.decls.n {
    let decl: *parse.Decl = d.decls.items[i];
    if decl.kind == parse.DeclKind.DkFn || decl.kind == parse.DeclKind.DkImpl ||
       decl.kind == parse.DeclKind.DkUse {
      // impl blocks carry no module-scope name of their own (their methods
      // register under `Type.name`; the block's `name` is the trait's);
      // uses are namespace bindings and never enter the lexical scope —
      // aliased ones carry their alias in `name`, so they are skipped
      // explicitly
      i += 1;
      continue;
    }
    let sym: *Sym = sm_get(m.syms, decl.name);
    if sym != null {
      scope_decl(decl.name, sym);
    }
    i += 1;
  }
}

// ============== value containment (decl-time) ==============================
//
// A struct's VALUE holds its inline parts: fixed arrays and nested
// structs live inside it; pointers, slices, strings, weak handles, fn
// values and dyn boxes are indirections. A containment cycle — S holds
// [2]S, or A holds B holds A — is an infinite value no layout can size.
// The in-flight `resolving` guard catches the direct cases that resolve
// inside the field window, but a type resolved outside it (a later decl,
// a generic substitution) slipped both guards, compiled, and misbehaved
// at runtime. This walk is the honest decl-time check: every interned
// struct, every inline chain, a visited set. Enum payload containment
// rides the same rec interning but walks nothing yet — variant payloads
// resolve through their own lane and get their pass when a real shape
// demands it.

fn ct_push(items: []*parse.RecType, r: *parse.RecType) -> []*parse.RecType {
  let out: []*parse.RecType = make([]*parse.RecType, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = r;
  return out;
}

fn ct_in(items: []*parse.RecType, r: *parse.RecType) -> bool {
  let mut i: usize = 0;
  while i < len(items) {
    if items[i] == r {
      return true;
    }
    i += 1;
  }
  return false;
}

// the offending rec, or null when the chain is finite
fn ct_cycle(t: *parse.Type, stack: []*parse.RecType, depth: i32) -> *parse.RecType {
  if t == null || depth > 256 {
    return null;
  }
  if t.kind == TypeKind.TyArray {
    return ct_cycle(t.elem, stack, depth + 1);
  }
  if t.kind == TypeKind.TyStruct {
    if t.rec == null || t.rec.is_template || t.rec.is_trait {
      return null;
    }
    if ct_in(stack, t.rec) {
      return t.rec;
    }
    let d: *parse.Decl = t.rec.decl;
    if d == null || d.fields.n == 0 {
      return null;
    }
    let deeper: []*parse.RecType = ct_push(stack, t.rec);
    let mut j: usize = 0;
    while j < d.fields.n {
      let ft: *parse.Type = struct_field_type(t.rec, j);
      if ft != null && ft.kind != TypeKind.TyErr {
        let hit: *parse.RecType = ct_cycle(ft, deeper, depth + 1);
        if hit != null {
          return hit;
        }
      }
      j += 1;
    }
  }
  return null;
}

fn check_containment() {
  let rm: *parse.TypeMap = rec_map();
  let mut i: usize = 0;
  while i < rm.n {
    let t: *parse.Type = rm.items[i].val;
    if t != null && t.kind == TypeKind.TyStruct && t.rec != null &&
       !t.rec.is_template && !t.rec.is_trait && t.rec.decl != null {
      let hit: *parse.RecType = ct_cycle(t, make([]*parse.RecType, 0), 0);
      if hit != null {
        cli.err_at(hit.decl.file, hit.decl.line, hit.decl.col,
                   "struct `" + hit.mangled + "` contains itself inline — an inline cycle (through fields or arrays) is an infinite value");
      }
    }
    i += 1;
  }
}

pub fn check_all(m: *Module) -> i32 {
  m.checked = true;
  cur_module = m;
  check_module(m);
  // flat phase model (boot: phase loops over g_module_order) — every
  // module settles its declarations before any body checks, and the
  // instantiation worklist drains once, globally, at the end
  check_module_decls(m);
  let mut ai: usize = 0;
  while g_aux_modules != null && ai < g_aux_modules.n {
    let aux: *Module = g_aux_modules.items[ai];
    if !aux.checked {
      check_module_decls(aux);
      aux.checked = true;
    }
    ai += 1;
  }
  // re-exports materialize once every module's declarations exist: the
  // aliases are the targets' final syms, re-keyed
  materialize_use_reqs();
  check_containment();
  check_module_bodies(m);
  ai = 0;
  while g_aux_modules != null && ai < g_aux_modules.n {
    let aux: *Module = g_aux_modules.items[ai];
    check_module_bodies(aux);
    ai += 1;
  }
  // instantiation worklist: each clone's body re-checked under its concrete
  // environment; checking may discover further instantiations, so the loop
  // runs until the queue settles
  if g_instantiations != null {
    let mut wl: usize = 0;
    while wl < g_instantiations.n {
      let isym: *Sym = g_instantiations.items[wl];
      wl += 1;
      let saved_env: *parse.TypeMap = g_tenv;
      g_tenv = isym.decl.tenv;
      cur_fn_sym = isym;
      // bounds: each `[T: Trait]` is verified against the concrete type this
      // clone was instantiated with, anchored at the instantiation
      if isym.decl.tparam_bounds != null {
        let cd: *parse.Decl = isym.decl;
        let mut bi: usize = 0;
        while bi < cd.tparams.n && bi < cd.tparam_bounds.n {
          let ba: *parse.TypeAst = cd.tparam_bounds.items[bi];
          if ba == null {
            bi += 1;
            continue;
          }
          // a bound is written as the bare trait name — resolve it as a
          // trait, not through the general type path
          let mut tr: *parse.RecType = null;
          if ba.kind == parse.TypeAstKind.TaNamed && ba.path.n == 1 {
            let bname: string = ba.path.items[0];
            let mut tsym: *Sym = sm_get(isym.owner.syms, bname);
            if tsym == null && prelude_module != null && prelude_module != m {
              tsym = sm_get(prelude_module.syms, bname);
            }
            if tsym != null && tsym.kind == SymKind.SyTrait {
              tr = tsym.trait_rec;
            }
          } else if ba.kind == parse.TypeAstKind.TaDyn {
            let bname: string = ba.path.items[ba.path.n - 1];
            let mut tsym: *Sym = sm_get(isym.owner.syms, bname);
            if tsym == null && prelude_module != null && prelude_module != m {
              tsym = sm_get(prelude_module.syms, bname);
            }
            if tsym != null && tsym.kind == SymKind.SyTrait {
              tr = tsym.trait_rec;
            }
          }
          if tr == null {
            bi += 1;
            continue;
          }
          let conc: *parse.Type = parse.tm_get(g_tenv, cd.tparams.items[bi]);
          if conc == null || conc.kind == TypeKind.TyParam {
            bi += 1;
            continue;
          }
          if !trait_satisfied(tr, conc) {
            let m1: string = "` does not implement `" + tr.mangled;
            let m2: string = m1 + "` (bound at instantiation): missing or mismatched `";
            let msg: string = "`" + ty_name(conc) + m2 + tr.methods[g_missing_idx as usize].name + "`" + "";
            cli.err_at(cd.file, cd.line, cd.col, msg);
          }
          bi += 1;
        }
      }
      check_fn_body(isym.decl, isym, m);
      g_tenv = saved_env;
    }
  }
  return cli.diag_count();
}

// per-module declaration passes (boot: phase 2) — struct/enum types,
// method wiring, fn signatures
pub fn check_module_decls(m: *Module) {
  cur_module = m;
  scope_push();
    scope_decl_module(m);
  let d: *parse.Decl = m.root;
  // pass 1: resolve struct/enum types, wire methods
  let mut i: usize = 0;
  while i < d.decls.n {
    let decl: *parse.Decl = d.decls.items[i];
    if decl.kind == parse.DeclKind.DkStruct || decl.kind == parse.DeclKind.DkEnum {
      let ssym: *Sym = sm_get(m.syms, decl.name);
      if ssym != null && ssym.type == null {
        if decl.tparams.n > 0 {
          let tmpl: *parse.RecType = ensure_template(decl, m);
          let t: *parse.Type = new parse.Type {
            kind: TypeKind.TyStruct, elem: null, len: 0, rec: tmpl,
            params: fresh_type_vec2(), ret: null, mangled: tmpl.mangled,
          };
          if decl.kind == parse.DeclKind.DkEnum {
            t.kind = TypeKind.TyEnum;
          }
          ssym.type = t;
        } else {
          ssym.type = named_type_simple(ssym, m);
        }
      }
    }
    if decl.kind == parse.DeclKind.DkFn {
      if len(decl.recv) > 0 {
        wire_method(m, decl);
      }
    }
    if decl.kind == parse.DeclKind.DkImpl {
      let mut ii: usize = 0;
      while ii < decl.decls.n {
        let md: *parse.Decl = decl.decls.items[ii];
        if len(md.recv) > 0 {
          wire_method(m, md);
        }
        ii += 1;
      }
    }
    i += 1;
  }
  // pass 2a: resolve fn signatures (and templated flags) for every decl —
  // before any body checks, so calls see concrete templates
  i = 0;
  while i < d.decls.n {
    let decl: *parse.Decl = d.decls.items[i];
    if decl.kind == parse.DeclKind.DkFn {
      if len(decl.recv) > 0 {
        let mut rsym: *Sym = sm_get(m.syms, decl.recv);
        if rsym == null && prelude_module != null && prelude_module != m {
          rsym = sm_get(prelude_module.syms, decl.recv);
        }
        if rsym != null && rsym.decl.tparams.n > 0 {
          decl.templated = true;
        }
      }
      if decl.tparams.n > 0 {
        decl.templated = true;
      }
      let nparams0: usize = decl.params.n;
      let mut ps0: []*parse.Type = fresh_type_vec2();
      let mut j0: usize = 0;
      while j0 < nparams0 {
        if len(decl.recv) > 0 {
          let mut rsym2: *Sym = sm_get(m.syms, decl.recv);
          if rsym2 == null && prelude_module != null && prelude_module != m {
            rsym2 = sm_get(prelude_module.syms, decl.recv);
          }
          if rsym2 != null && rsym2.decl.tparams.n > 0 {
            let tmpl0: *parse.RecType = ensure_template(rsym2.decl, m);
            g_tenv = tmpl0.env_tenv;
            ps0 = push_type(ps0, variadic_param_type(m, decl, j0));
            g_tenv = null;
            j0 += 1;
            continue;
          }
        }
        if decl.tparams.n > 0 {
          let saved_env0: *parse.TypeMap = g_tenv;
          g_tenv = template_env_of(decl);
          ps0 = push_type(ps0, variadic_param_type(m, decl, j0));
          g_tenv = saved_env0;
          j0 += 1;
          continue;
        }
        ps0 = push_type(ps0, variadic_param_type(m, decl, j0));
        j0 += 1;
      }
      let mut ret0: *parse.Type = null;
      if decl.tparams.n > 0 {
        let saved_env1: *parse.TypeMap = g_tenv;
        g_tenv = template_env_of(decl);
        ret0 = resolve_type_in_module(m, decl.ret);
        g_tenv = saved_env1;
      } else if len(decl.recv) > 0 {
        let mut rsym3: *Sym = sm_get(m.syms, decl.recv);
        if rsym3 == null && prelude_module != null && prelude_module != m {
          rsym3 = sm_get(prelude_module.syms, decl.recv);
        }
        if rsym3 != null && rsym3.decl.tparams.n > 0 {
          let tmpl1: *parse.RecType = ensure_template(rsym3.decl, m);
          g_tenv = tmpl1.env_tenv;
          ret0 = resolve_type_in_module(m, decl.ret);
          g_tenv = null;
        } else {
          ret0 = resolve_type_in_module(m, decl.ret);
        }
      } else {
        ret0 = resolve_type_in_module(m, decl.ret);
      }
      let ft0: *parse.Type = ty_fn(ps0, ret0);
      let mut tsym0: *Sym = sm_get(m.syms, decl.name);
      if decl.is_method {
        tsym0 = sm_get(m.syms, decl.recv + "." + decl.name);
      }
      if tsym0 != null {
        tsym0.type = ft0;
      }
    }
    if decl.kind == parse.DeclKind.DkImpl {
      // an impl block's methods resolve through the same machinery
      let mut ii0: usize = 0;
      while ii0 < decl.decls.n {
        resolve_fn_signature(m, decl.decls.items[ii0]);
        ii0 += 1;
      }
    }
    if decl.kind == parse.DeclKind.DkExtern {
      let esym: *Sym = sm_get(m.syms, decl.name);
      if esym != null && esym.type == null {
        let mut ps1: []*parse.Type = fresh_type_vec2();
        let mut j1: usize = 0;
        while j1 < decl.params.n {
          ps1 = push_type(ps1, resolve_type_in_module(m, decl.params.items[j1].ty));
          j1 += 1;
        }
        esym.type = ty_fn(ps1, resolve_type_in_module(m, decl.ret));
      }
    }
    if decl.kind == parse.DeclKind.DkStatic || decl.kind == parse.DeclKind.DkConst {
      let ann: *parse.Type = resolve_type_in_module(m, decl.ret);
      let ssym: *Sym = sm_get(m.syms, decl.name);
      if ssym != null {
        ssym.type = ann;
      }
      if decl.init != null {
        let v: *lower.CV = lower.const_eval(decl.init, m);
        if !v.ok {
          cli.err_at(decl.file, decl.line, decl.col, decl.name + ": initializer must be a compile-time constant" + "");
        } else {
          decl.ceval_ok = true;
          decl.ceval_is_int = v.is_int;
          decl.ceval_i = v.i;
          decl.ceval_f = v.f;
          decl.ceval_b = v.b;
        }
        decl.init.typed = ann;
      }
    }
    i += 1;
  }
  // trait carriers + impl eager satisfaction, once signatures exist (boot
  // resolves the whole sym table in phase 2; self's 2a is the equivalent)
  resolve_traits_and_impls(m);
  scope_pop();
}

// per-module body passes (boot: phase 3) — fn bodies and impl members
pub fn check_module_bodies(m: *Module) {
  cur_module = m;
  scope_push();
    scope_decl_module(m);
  let d: *parse.Decl = m.root;
  let mut i: usize = 0;
  // pass 2b: check fn bodies (plain fns and methods alike; generics once)
  i = 0;
  while i < d.decls.n {
    let decl: *parse.Decl = d.decls.items[i];
    if decl.kind == parse.DeclKind.DkFn {
      // build the fn symbol's signature type on the fly (methods resolve
      // under the receiver type's template env)
      if len(decl.recv) > 0 {
        let mut rsym: *Sym = sm_get(m.syms, decl.recv);
        if rsym == null && prelude_module != null && prelude_module != m {
          rsym = sm_get(prelude_module.syms, decl.recv);
        }
        if rsym != null && rsym.decl.tparams.n > 0 {
          let tmpl: *parse.RecType = ensure_template(rsym.decl, m);
          g_tenv = tmpl.env_tenv;
          decl.templated = true;
        }
      }
      if decl.tparams.n > 0 {
        g_tenv = template_env_of(decl);
        decl.templated = true;
      }
      let mut tsym: *Sym = sm_get(m.syms, decl.name);
      if decl.is_method {
        tsym = sm_get(m.syms, decl.recv + "." + decl.name);
      }
      let mut ft: *parse.Type = null;
      if tsym != null && tsym.type != null {
        // pass 2a resolved the signature already; re-resolving would
        // re-emit diagnostics for names that failed to resolve
        ft = tsym.type;
      } else {
        let nparams: usize = decl.params.n;
        let mut ps: []*parse.Type = fresh_type_vec2();
        let mut j: usize = 0;
        while j < nparams {
          ps = push_type(ps, variadic_param_type(m, decl, j));
          j += 1;
        }
        ft = ty_fn(ps, resolve_type_in_module(m, decl.ret));
        if tsym != null {
          tsym.type = ft;
        }
      }
      g_tenv = null;
      let fsym: *Sym = new Sym {
        kind: SymKind.SyFn, name: decl.name, type: ft, decl: decl,
        mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: cur_module,
    module: null,
      trait_rec: null,
      };
      cur_fn_sym = fsym;
      // generic templates are checked per instantiation, never directly
      if !decl.templated {
        check_fn_body(decl, fsym, m);
      }
    }
    if decl.kind == parse.DeclKind.DkExtern {
      // resolve the extern signature into its symbol
      let esym: *Sym = sm_get(m.syms, decl.name);
      if esym != null && esym.type == null {
        let mut ps: []*parse.Type = fresh_type_vec2();
        let mut j: usize = 0;
        while j < decl.params.n {
          ps = push_type(ps, resolve_type_in_module(m, decl.params.items[j].ty));
          j += 1;
        }
        esym.type = ty_fn(ps, resolve_type_in_module(m, decl.ret));
      }
    }
    if decl.kind == parse.DeclKind.DkStatic || decl.kind == parse.DeclKind.DkConst {
      let ann: *parse.Type = resolve_type_in_module(m, decl.ret);
      let ssym: *Sym = sm_get(m.syms, decl.name);
      if ssym != null {
        ssym.type = ann;
      }
      if decl.init != null {
        let v: *lower.CV = lower.const_eval(decl.init, m);
        if !v.ok {
          cli.err_at(decl.file, decl.line, decl.col, decl.name + ": initializer must be a compile-time constant" + "");
        } else {
          decl.ceval_ok = true;
          decl.ceval_is_int = v.is_int;
          decl.ceval_i = v.i;
          decl.ceval_f = v.f;
          decl.ceval_b = v.b;
        }
        decl.init.typed = ann;
      }
    }
    i += 1;
  }
  // impl-block method bodies (boot phase 3 catches them through the sym
  // table; self's passes are decl-driven, so walk the impl decls here)
  i = 0;
  while i < d.decls.n {
    let decl: *parse.Decl = d.decls.items[i];
    if decl.kind == parse.DeclKind.DkImpl {
      let mut ii: usize = 0;
      while ii < decl.decls.n {
        let md: *parse.Decl = decl.decls.items[ii];
        if !md.templated {
          let msym: *Sym = sm_get(m.syms, md.recv + "." + md.name + "" + "");
          if msym != null {
            let fsym: *Sym = new Sym {
              kind: SymKind.SyFn, name: md.name, type: msym.type, decl: md,
              mutable: false, variant_index: 0, local_id: 0, symbol: "",
              owner: cur_module, module: null, trait_rec: null,
            };
            cur_fn_sym = fsym;
            check_fn_body(md, fsym, m);
          }
        }
        ii += 1;
      }
    }
    i += 1;
  }
  scope_pop();
}


// ============== if-expressions (check.c port L6f-b) =======================

fn check_block_value2(stmts: *cli.Vec[*parse.Stmt]) -> *parse.Type {
  scope_push();
  let mut result: *parse.Type = ty_prim(14);
  let mut i: usize = 0;
  while i < stmts.n {
    let s: *parse.Stmt = stmts.items[i];
    if i + 1 == stmts.n && s.kind == parse.StmtKind.StExpr && s.tail {
      result = check_expr(s.a, null);
    } else {
      check_stmt(s);
    }
    i += 1;
  }
  scope_pop();
  return result;
}

// store the qmark family fields (kept in one place; the two consecutive
// scalar stores through the pointer confuse no one)
fn expr_set_q(e: *parse.Expr, ok: i32, err: i32) {
  e.q_ok = ok;
  e.q_err = err;
}

fn is_panic_call(e: *parse.Expr) -> bool {
  if e == null || e.kind != parse.ExprKind.ExCall || e.a == null || e.a.sym == null {
    return false;
  }
  let s: *Sym = e.a.sym;
  if !cli.streq(s.name, "panic") || s.owner == null {
    return false;
  }
  return s.owner == prelude_module || s.owner.is_prelude;
}

fn unify2(a: *parse.Type, b: *parse.Type, at: *parse.Expr) -> *parse.Type {
  if a == null || a.kind == TypeKind.TyErr {
    return b;
  }
  if b == null || b.kind == TypeKind.TyErr {
    return a;
  }
  // panic never returns: its arm coerces to the other branch's type
  if a.kind == TypeKind.TyVoid && b.kind != TypeKind.TyVoid && is_panic_call(at) {
    return b;
  }
  if b.kind == TypeKind.TyVoid && a.kind != TypeKind.TyVoid && is_panic_call(at) {
    return a;
  }
  if a != null && a.kind == TypeKind.TyParam {
    return b;
  }
  if b != null && b.kind == TypeKind.TyParam {
    return a;
  }
  if a.kind == TypeKind.TyErr {
    return b;
  }
  if b.kind == TypeKind.TyErr {
    return a;
  }
  // untyped literals adapt to the other side's type
  let u: *parse.Type = adapt_literal(a, b);
  let v: *parse.Type = adapt_literal(b, a);
  if u.kind == TypeKind.TyVoid && v.kind == TypeKind.TyVoid {
    return u;
  }
  if types_compatible(u, v) {
    return u;
  }
  cli.err_at(at.file, at.line, at.col, "branches have different types: `" + ty_name(a) + "` vs `" + ty_name(b) + "`");
  return ty_err();
}

// ============== comptime conditions (spec §7.3) ===========================
//
// The three-valued answer a folded `if` asks for: -1 unknown, 0 false,
// 1 true. A condition is known when it is a literal, a const (the root's
// build parameters included), or a comptime combination of those — the
// same lane static initializers ride, extended with bool operands and the
// short-circuit operators. The values are raw u64 bit patterns compared
// signed or unsigned by the operand's checked type, exactly as the
// runtime compares them.

struct CCVal { ok: bool, is_int: bool, i: u64, b: bool }

fn cc_new() -> *CCVal {
  return new CCVal { ok: false, is_int: false, i: 0, b: false };
}

// name resolution for comptime conditions: the same chain as lookup()
// (scope, module, build parameters, prelude) without touching scope state
fn cc_lookup(name: string) -> *Sym {
  let psym: *Sym = param_lookup(name);
  if psym != null {
    return psym;
  }
  if cur_module != null {
    let msym: *Sym = sm_get(cur_module.syms, name);
    if msym != null {
      return msym;
    }
  }
  if prelude_module != null && prelude_module != cur_module {
    return sm_get(prelude_module.syms, name);
  }
  return null;
}

fn cc_signed(e: *parse.Expr) -> bool {
  if e.typed == null {
    return false;
  }
  let k: TypeKind = e.typed.kind;
  // TyIntLit rides with the signed family: an untyped literal's default
  // domain is i32 (the let-binding law), and folding `((-51) >= 24))`
  // unsigned once judged it TRUE — the -51 wrapped as u64 (found by fuzz
  // seed 153, pinned by corpus/104)
  if k == TypeKind.TyI8 || k == TypeKind.TyI16 || k == TypeKind.TyI32 ||
     k == TypeKind.TyI64 || k == TypeKind.TyIsize || k == TypeKind.TyIntLit {
    return true;
  }
  return false;
}

// evaluate e to a comptime value; depth bounds const-to-const chains
fn cc_value(e: *parse.Expr, depth: i32) -> *CCVal {
  let r: *CCVal = cc_new();
  if e == null || depth > 32 {
    return r;
  }
  if e.kind == parse.ExprKind.ExInt {
    r.ok = true;
    r.is_int = true;
    r.i = e.iv;
    return r;
  }
  if e.kind == parse.ExprKind.ExBool {
    r.ok = true;
    r.b = e.bv;
    return r;
  }
  if e.kind == parse.ExprKind.ExCast {
    let a: *CCVal = cc_value(e.a, depth + 1);
    if !a.ok || !a.is_int {
      return r;
    }
    r.ok = true;
    r.is_int = true;
    r.i = a.i;
    return r;
  }
  if e.kind == parse.ExprKind.ExName {
    let sym: *Sym = cc_lookup(e.sv);
    if sym == null || sym.kind != SymKind.SyConst || sym.decl == null ||
       sym.decl.kind != parse.DeclKind.DkConst || sym.decl.init == null {
      return r;
    }
    return cc_value(sym.decl.init, depth + 1);
  }
  if e.kind == parse.ExprKind.ExUn {
    let a: *CCVal = cc_value(e.a, depth + 1);
    if !a.ok {
      return r;
    }
    if e.unop == lex.Tok.PBang {
      if a.is_int {
        return r;
      }
      r.ok = true;
      r.b = !a.b;
      return r;
    }
    if !a.is_int {
      return r;
    }
    r.ok = true;
    r.is_int = true;
    if e.unop == lex.Tok.PMinus {
      r.i = (0 - (a.i as i64)) as u64;
    } else if e.unop == lex.Tok.PTilde {
      r.i = ~a.i;
    } else {
      r.ok = false;
    }
    return r;
  }
  if e.kind == parse.ExprKind.ExBin {
    let op: lex.Tok = e.binop;
    if op == lex.Tok.PAndand || op == lex.Tok.POror {
      // short-circuit: a known left side can decide the whole operator even
      // when the right side is unknown — at runtime that side never runs
      let a: *CCVal = cc_value(e.a, depth + 1);
      if !a.ok || a.is_int {
        return r;
      }
      if op == lex.Tok.PAndand && !a.b {
        r.ok = true;
        r.b = false;
        return r;
      }
      if op == lex.Tok.POror && a.b {
        r.ok = true;
        r.b = true;
        return r;
      }
      let b: *CCVal = cc_value(e.b, depth + 1);
      if !b.ok || b.is_int {
        return r;
      }
      r.ok = true;
      if op == lex.Tok.PAndand {
        r.b = a.b && b.b;
      } else {
        r.b = a.b || b.b;
      }
      return r;
    }
    let a: *CCVal = cc_value(e.a, depth + 1);
    let b: *CCVal = cc_value(e.b, depth + 1);
    if !a.ok || !b.ok {
      return r;
    }
    if !a.is_int && !b.is_int {
      // bool == bool, bool != bool
      if op == lex.Tok.PEq || op == lex.Tok.PNe {
        r.ok = true;
        if op == lex.Tok.PEq {
          r.b = a.b == b.b;
        } else {
          r.b = a.b != b.b;
        }
      }
      return r;
    }
    if !a.is_int || !b.is_int {
      return r;
    }
    let x: u64 = a.i;
    let y: u64 = b.i;
    if op == lex.Tok.PEq || op == lex.Tok.PNe || op == lex.Tok.PLt ||
       op == lex.Tok.PGt || op == lex.Tok.PLe || op == lex.Tok.PGe {
      r.ok = true;
      let signed: bool = cc_signed(e.a) || cc_signed(e.b);
      if op == lex.Tok.PEq {
        r.b = x == y;
      } else if op == lex.Tok.PNe {
        r.b = x != y;
      } else if signed {
        let sx: i64 = x as i64;
        let sy: i64 = y as i64;
        if op == lex.Tok.PLt { r.b = sx < sy; }
        else if op == lex.Tok.PGt { r.b = sx > sy; }
        else if op == lex.Tok.PLe { r.b = sx <= sy; }
        else { r.b = sx >= sy; }
      } else {
        if op == lex.Tok.PLt { r.b = x < y; }
        else if op == lex.Tok.PGt { r.b = x > y; }
        else if op == lex.Tok.PLe { r.b = x <= y; }
        else { r.b = x >= y; }
      }
      return r;
    }
    r.ok = true;
    r.is_int = true;
    if op == lex.Tok.PPlus { r.i = x + y; }
    else if op == lex.Tok.PMinus { r.i = x - y; }
    else if op == lex.Tok.PStar { r.i = x * y; }
    else if op == lex.Tok.PSlash {
      if y == 0 {
        r.ok = false;
      } else {
        r.i = x / y;
      }
    }
    else if op == lex.Tok.PPercent {
      if y == 0 {
        r.ok = false;
      } else {
        r.i = x % y;
      }
    }
    else if op == lex.Tok.PAmp { r.i = x & y; }
    else if op == lex.Tok.PPipe { r.i = x | y; }
    else if op == lex.Tok.PCaret { r.i = x ^ y; }
    else if op == lex.Tok.PShl { r.i = x << (y & 63); }
    else if op == lex.Tok.PShr { r.i = x >> (y & 63); }
    else {
      r.ok = false;
    }
    return r;
  }
  return r;
}

// the fold verdict for a checked condition: -1 unknown, 0 false, 1 true
fn cond_known(e: *parse.Expr) -> i32 {
  let v: *CCVal = cc_value(e, 0);
  if !v.ok || v.is_int {
    return 0 - 1;
  }
  if v.b {
    return 1;
  }
  return 0;
}

fn check_if_expr(e: *parse.Expr, expected: *parse.Type) -> *parse.Type {
  let cond: *parse.Type = check_expr(e.a, null);
  if cond.kind != TypeKind.TyBool {
    cli.err_at(e.a.file, e.a.line, e.a.col, "if condition must be bool, found `" + ty_name(cond) + "`");
  }
  // comptime fold (spec §7.3): a decided condition keeps only its live
  // branch — the dead one is skipped whole, so names it alone references
  // never resolve and modules only it reaches are never lowered
  let cc: i32 = cond_known(e.a);
  if cc >= 0 {
    // fold_live: 1 = the then branch survives, 2 = the else side does
    e.fold_live = 1;
    if cc == 0 {
      e.fold_live = 2;
    }
    if e.fold_live == 1 {
      let then_blk: *parse.Stmt = e.items.items[0];
      let t: *parse.Type = check_block_value2(then_blk.stmts);
      e.typed = t;
      return t;
    }
    if e.else_if != null {
      let et: *parse.Type = check_expr(e.else_if, expected);
      e.typed = et;
      return et;
    }
    if e.items.n > 1 {
      let else_blk: *parse.Stmt = e.items.items[1];
      let et: *parse.Type = check_block_value2(else_blk.stmts);
      e.typed = et;
      return et;
    }
    let vt: *parse.Type = ty_prim(14);
    e.typed = vt;
    return vt;
  }
  let then_blk: *parse.Stmt = e.items.items[0];
  let t: *parse.Type = check_block_value2(then_blk.stmts);
  let mut result: *parse.Type = ty_prim(14);
  if e.else_if != null {
    let et: *parse.Type = check_expr(e.else_if, if expected != null { expected } else { t });
    result = unify2(t, et, e.else_if);
  } else if e.items.n > 1 {
    let else_blk: *parse.Stmt = e.items.items[1];
    let et: *parse.Type = check_block_value2(else_blk.stmts);
    result = unify2(t, et, e);
  }
  e.typed = result;
  return result;
}

// ============== generic fn instantiation (check.c port L7) =================

// ---- declaration cloning (instantiation bodies) ----------------------------

fn clone_typeast(t: *parse.TypeAst) -> *parse.TypeAst {
  if t == null {
    return null;
  }
  let c: *parse.TypeAst = new parse.TypeAst {
    kind: t.kind, prim: t.prim, path: t.path, targs: t.targs, elem: t.elem,
    params: t.params, ret: t.ret, size: t.size,
    file: t.file, line: t.line, col: t.col,
  };
  // deep-copy the recursive fields; path/string payloads are immutable
  let mut ta: *cli.Vec[*parse.TypeAst] = new cli.Vec[*parse.TypeAst] { items: make([]*parse.TypeAst, 4), n: 0 };
  let mut i: usize = 0;
  while i < t.targs.n {
    ta.push(clone_typeast(t.targs.items[i]));
    i += 1;
  }
  c.targs = ta;
  let mut tp: *cli.Vec[*parse.TypeAst] = new cli.Vec[*parse.TypeAst] { items: make([]*parse.TypeAst, 4), n: 0 };
  i = 0;
  while i < t.params.n {
    tp.push(clone_typeast(t.params.items[i]));
    i += 1;
  }
  c.params = tp;
  c.elem = clone_typeast(t.elem);
  c.ret = clone_typeast(t.ret);
  c.size = clone_expr(t.size);
  return c;
}

fn clone_fieldast(f: *parse.FieldAst) -> *parse.FieldAst {
  if f == null {
    return null;
  }
  return new parse.FieldAst {
    name: f.name, ty: clone_typeast(f.ty), file: f.file, line: f.line, col: f.col,
  };
}

fn clone_param(p: *parse.Param) -> *parse.Param {
  if p == null {
    return null;
  }
  return new parse.Param {
    name: p.name, ty: clone_typeast(p.ty), is_self: p.is_self,
    is_variadic: p.is_variadic,
    file: p.file, line: p.line, col: p.col,
  };
}

fn clone_arm(a: *parse.MatchArm) -> *parse.MatchArm {
  if a == null {
    return null;
  }
  let mut pf: *cli.Vec[*parse.FieldAst] = new cli.Vec[*parse.FieldAst] { items: make([]*parse.FieldAst, 4), n: 0 };
  let mut i: usize = 0;
  while i < a.pat_fields.n {
    pf.push(clone_fieldast(a.pat_fields.items[i]));
    i += 1;
  }
  return new parse.MatchArm {
    pk: a.pk, pat_path: a.pat_path, pat_int: a.pat_int, variant_index: a.variant_index,
    disc: a.disc, pat_str: a.pat_str, pat_names: a.pat_names, pat_fields: pf,
    bind_syms: make([]*Sym, 0), bind_fidx: make([]i64, 0),
    body: clone_expr(a.body), file: a.file, line: a.line, col: a.col,
  };
}

fn clone_stmt(s: *parse.Stmt) -> *parse.Stmt {
  if s == null {
    return null;
  }
  let c: *parse.Stmt = new parse.Stmt {
    kind: s.kind, file: s.file, line: s.line, col: s.col, pre: s.pre,
    mut_: s.mut_, tail: s.tail, name: s.name, ty: clone_typeast(s.ty),
    a: clone_expr(s.a), b: clone_expr(s.b), assign_op: s.assign_op,
    stmts: new cli.Vec[*parse.Stmt] { items: make([]*parse.Stmt, 4), n: 0 },
    cond: clone_expr(s.cond),
    body: new cli.Vec[*parse.Stmt] { items: make([]*parse.Stmt, 4), n: 0 },
  };
  let mut i: usize = 0;
  while i < s.stmts.n {
    c.stmts.push(clone_stmt(s.stmts.items[i]));
    i += 1;
  }
  i = 0;
  while i < s.body.n {
    c.body.push(clone_stmt(s.body.items[i]));
    i += 1;
  }
  return c;
}

fn clone_expr(e: *parse.Expr) -> *parse.Expr {
  if e == null {
    return null;
  }
  let c: *parse.Expr = new parse.Expr {
    kind: e.kind, file: e.file, line: e.line, col: e.col,
    iv: e.iv, fv: e.fv, sv: e.sv, bv: e.bv,
    a: clone_expr(e.a), b: clone_expr(e.b), c: clone_expr(e.c),
    binop: e.binop, unop: e.unop,
    args: new cli.Vec[*parse.Expr] { items: make([]*parse.Expr, 4), n: 0 },
    arg_names: e.arg_names,
    ty: clone_typeast(e.ty),
    arms: new cli.Vec[*parse.MatchArm] { items: make([]*parse.MatchArm, 4), n: 0 },
    params: new cli.Vec[*parse.Param] { items: make([]*parse.Param, 4), n: 0 },
    ret: clone_typeast(e.ret),
    q_ok: e.q_ok, q_err: e.q_err, fold_live: e.fold_live, else_if: clone_expr(e.else_if),
    fnval: e.fnval, caps: make([]*Sym, 0),
    items: new cli.Vec[*parse.Stmt] { items: make([]*parse.Stmt, 4), n: 0 },
    typed: null, sym: null, spread: e.spread,
  };
  let mut i: usize = 0;
  while i < e.args.n {
    c.args.push(clone_expr(e.args.items[i]));
    i += 1;
  }
  i = 0;
  while i < e.arms.n {
    c.arms.push(clone_arm(e.arms.items[i]));
    i += 1;
  }
  i = 0;
  while i < e.params.n {
    c.params.push(clone_param(e.params.items[i]));
    i += 1;
  }
  // NEW field lists: name entries in items alongside args
  if e.kind == parse.ExprKind.ExNew {
    i = 0;
    while i < e.items.n {
      let entry: *parse.Stmt = e.items.items[i];
      let nc: *parse.Stmt = new parse.Stmt {
        kind: parse.StmtKind.StBlock, file: entry.file, line: entry.line, col: entry.col,
        pre: entry.pre, mut_: false, tail: false, name: entry.name, ty: null,
        a: null, b: null, assign_op: entry.assign_op,
        stmts: new cli.Vec[*parse.Stmt] { items: make([]*parse.Stmt, 0), n: 0 },
        cond: null, body: new cli.Vec[*parse.Stmt] { items: make([]*parse.Stmt, 0), n: 0 },
      };
      c.items.push(nc);
      i += 1;
    }
  } else {
    i = 0;
    while i < e.items.n {
      c.items.push(clone_stmt(e.items.items[i]));
      i += 1;
    }
  }
  return c;
}

fn clone_fn_decl(d: *parse.Decl) -> *parse.Decl {
  let c: *parse.Decl = new parse.Decl {
    kind: parse.DeclKind.DkFn, file: d.file, line: d.line, col: d.col, pre: d.pre,
    pub_: d.pub_, is_mut: d.is_mut, name: d.name,
    path: d.path,
    params: new cli.Vec[*parse.Param] { items: make([]*parse.Param, 4), n: 0 },
    ret: clone_typeast(d.ret),
    fields: d.fields, variants: d.variants, init: d.init,
    body: new cli.Vec[*parse.Stmt] { items: make([]*parse.Stmt, 8), n: 0 },
    tparams: make_str_vec(), is_method: d.is_method, recv: d.recv,
    decls: d.decls, target: null, tparam_bounds: d.tparam_bounds, templ: null,
    templated: false, tenv: null, owner: null,
    ceval_ok: false, ceval_is_int: false, ceval_i: 0, ceval_f: 0.0, ceval_b: false,
  };
  let mut i: usize = 0;
  while i < d.params.n {
    c.params.push(clone_param(d.params.items[i]));
    i += 1;
  }
  i = 0;
  while i < d.body.n {
    c.body.push(clone_stmt(d.body.items[i]));
    i += 1;
  }
  return c;
}

// ---- instantiation ---------------------------------------------------------

pub static mut g_instantiations: *cli.Vec[*Sym] = 0 as *cli.Vec[*Sym]; // pending body checks
pub static mut g_instantiated_names: *cli.Vec[string] = 0 as *cli.Vec[string]; // mangled keys
pub static mut g_instantiated_syms: *cli.Vec[*Sym] = 0 as *cli.Vec[*Sym];
pub static mut g_instantiation_depth: i32 = 0;

fn make_str_vec() -> *cli.Vec[string] {
  return new cli.Vec[string] { items: make([]string, 8), n: 0 };
}

fn instantiated_get(mangled: string) -> *Sym {
  if g_instantiated_names == null {
    return null;
  }
  let mut i: usize = 0;
  while i < g_instantiated_names.n {
    if cli.streq(g_instantiated_names.items[i], mangled) {
      return g_instantiated_syms.items[i];
    }
    i += 1;
  }
  return null;
}

// resolve a cloned fn symbol's signature under its tenv (boot resolve_sym_type)
fn resolve_inst_signature(sym: *Sym) {
  let d: *parse.Decl = sym.decl;
  let saved_env: *parse.TypeMap = g_tenv;
  let saved_mod: *Module = cur_module;
  cur_module = sym.owner;
  g_tenv = d.tenv;
  let mut ps: []*parse.Type = fresh_type_vec2();
  let mut i: usize = 0;
  while i < d.params.n {
    ps = push_type(ps, resolve_type_in_module(sym.owner, d.params.items[i].ty));
    i += 1;
  }
  let ret: *parse.Type = resolve_type_in_module(sym.owner, d.ret);
  sym.type = ty_fn(ps, ret);
  g_tenv = saved_env;
  cur_module = saved_mod;
}

fn instantiate_fn(gsym: *Sym, names: []string, env: *parse.TypeMap, at: *parse.Expr) -> *Sym {
  let d: *parse.Decl = gsym.decl;
  // mangle in the canonical parameter order so the name is deterministic
  let mut mangled: string = d.name + "$" + "";
  let mut i: usize = 0;
  while i < len(names) {
    let targ: *parse.Type = parse.tm_get(env, names[i]);
    if i > 0 {
      mangled = mangled + "," + "";
    }
    if targ == null || targ.kind == TypeKind.TyParam {
      cli.err_at(at.file, at.line, at.col, "cannot infer `" + names[i] + "` for `" + d.name + "`");
      return gsym;
    }
    let mut targ2: *parse.Type = targ;
    if targ2.kind == TypeKind.TyIntLit {
      targ2 = ty_prim(3); // i32
    }
    if targ2.kind == TypeKind.TyFloatLit {
      targ2 = ty_prim(10); // f64
    }
    parse.tm_put(env, names[i], targ2);
    mangled = mangled + targ2.mangled + "";
    i += 1;
  }
  let existing: *Sym = instantiated_get(mangled);
  if existing != null {
    return existing;
  }
  g_instantiation_depth += 1;
  if g_instantiation_depth > 256 {
    cli.err_at("", 0, 0, "generic instantiation nesting too deep (recursive generics?)");
    g_instantiation_depth -= 1;
    return gsym;
  }
  let clone: *parse.Decl = clone_fn_decl(d);
  clone.name = mangled;
  clone.tenv = env;
  clone.owner = gsym.owner;
  let sym: *Sym = new Sym {
    kind: SymKind.SyFn, name: mangled, type: null, decl: clone,
    mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: gsym.owner,
    module: null,
  trait_rec: null,
  };
  if g_instantiated_names == null {
    g_instantiated_names = new cli.Vec[string] { items: make([]string, 64), n: 0 };
    g_instantiated_syms = new cli.Vec[*Sym] { items: make([]*Sym, 64), n: 0 };
  }
  g_instantiated_names.push(mangled);
  g_instantiated_syms.push(sym);
  let saved_mod: *Module = cur_module;
  let saved_env: *parse.TypeMap = g_tenv;
  cur_module = gsym.owner;
  g_tenv = env;
  resolve_inst_signature(sym);
  g_tenv = saved_env;
  cur_module = saved_mod;
  // register the instantiation in the owner module's symbol table so lower
  // emits it (boot: map_put(&owner->syms, mangled, sym))
  sm_put(gsym.owner.syms, mangled, sym);
  if g_instantiations == null {
    g_instantiations = new cli.Vec[*Sym] { items: make([]*Sym, 64), n: 0 };
  }
  g_instantiations.push(sym);
  g_instantiation_depth -= 1;
  return sym;
}
