// check.rho — the self-hosted compiler's checker seed (T2.2 growth).
// The full type layer grows here; today it walks the fn table and
// the statements proving every CALLED name has a definition and every
// variable reference is bound — unknown names are errors (exit 1)
// before emission runs.
use parse;

pub fn name_known(prog: *Prog, name: string) -> bool {
  if name == "len" || name == "assert" || name == "format" ||
      name == "assert_eq" || name == "printf" || name == "eprintf" {
    return true;
  }
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name == name {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub fn enum_known(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < prog.nenums {
    if prog.enums[i].name == name {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// the variant's tag, -1 when the enum or variant is unknown
pub fn enum_variant(prog: *Prog, ename: string,
                    vname: string) -> i64 {
  let mut i: usize = 0;
  while i < prog.nenums {
    if prog.enums[i].name == ename {
      let mut k: usize = 0;
      while k < prog.enums[i].nv {
        if prog.enums[i].vnames[k] == vname {
          return k as i64;
        }
        k = k + 1;
      }
      return 0 - 1;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub fn struct_known(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < prog.nstructs {
    if prog.structs[i].name == name {
      return true;
    }
    i = i + 1;
  }
  // Name[args] — the base must be a generic struct and the argument
  // count must match its declaration (the emitter instantiates)
  let ob: i64 = bracket_at(name);
  if ob >= 0 && name[len(name) - 1..len(name)] == "]" {
    let base: string = name[0..(ob as usize)];
    let mut j: usize = 0;
    while j < prog.nstructs {
      if prog.structs[j].name == base &&
          len(prog.structs[j].tparams) > 0 {
        return arg_count(name, ob) ==
            (len(prog.structs[j].tparams) as i64);
      }
      j = j + 1;
    }
  }
  return false;
}

// the index of the first '[' in a text, -1 when none
fn bracket_at(s: string) -> i64 {
  let mut i: usize = 0;
  while i < len(s) {
    if s[i] == 91 {
      return i as i64;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// depth-0 commas inside name[(ob+1)..len-1], plus one
fn arg_count(name: string, ob: i64) -> i64 {
  let mut n: i64 = 1;
  let mut depth: i64 = 0;
  let mut i: usize = (ob as usize) + 1;
  while i < len(name) - 1 {
    let b: u8 = name[i];
    if b == 91 {
      depth = depth + 1;
    }
    if b == 93 {
      depth = depth - 1;
    }
    if b == 44 && depth == 0 {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

fn fn_named(prog: *Prog, name: string) -> bool {
  let mut i: usize = 0;
  while i < len(prog.fns) {
    if prog.fns[i].name == name {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// some Type.method exists (the receiver's own type is beyond the
// name-level checker — suffix match keeps the refusal honest)
fn method_known(prog: *Prog, mname: string) -> bool {
  let mut i: usize = 0;
  while i < len(prog.fns) {
    let n: string = prog.fns[i].name;
    if len(n) > len(mname) + 1 &&
       n[len(n) - len(mname) - 1] == 46 {
      let mut k: usize = 0;
      let mut hit: bool = true;
      while k < len(mname) {
        if n[len(n) - len(mname) + k] != mname[k] {
          hit = false;
        }
        k = k + 1;
      }
      if hit {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

fn expr_walk(e: *Expr, prog: *Prog, bound: []string, nb: usize,
             errs: *ErrBox) {
  if e.tag == parse.EX_MAKE {
    let mut k: usize = 0;
    while k < len(e.args) {
      expr_walk(e.args[k], prog, bound, nb, errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_IDX {
    match e.lhs {
      Option.Some(b) => {
        expr_walk(b, prog, bound, nb, errs);
      },
      Option.None => {},
    }
    match e.rhs {
      Option.Some(i) => {
        expr_walk(i, prog, bound, nb, errs);
      },
      Option.None => {},
    }
    return;
  }
  if e.tag == parse.EX_SLICE2 {
    match e.lhs {
      Option.Some(b) => {
        expr_walk(b, prog, bound, nb, errs);
      },
      Option.None => {},
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      expr_walk(e.args[k], prog, bound, nb, errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_NEW {
    if !struct_known(prog, e.name) {
      eprintf("check: unknown struct '{}'\n", e.name);
      errs.n = errs.n + 1;
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      expr_walk(e.args[k], prog, bound, nb, errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_FIELD || e.tag == parse.EX_DEREF {
    // Enum.Var without call parens — the unit-variant constructor
    if e.tag == parse.EX_FIELD {
      match e.lhs {
        Option.Some(b) => {
          if b.tag == parse.EX_VAR && (enum_known(prog, b.name) ||
              b.name == "Option" || b.name == "Result") {
            if enum_variant(prog, b.name, e.name) < 0 &&
                !(b.name == "Option" || b.name == "Result") {
              eprintf("check: unknown variant '{}.{}'\n", b.name, e.name);
              errs.n = errs.n + 1;
            }
            return;
          }
        },
        Option.None => {},
      }
    }
    match e.lhs {
      Option.Some(b) => {
        expr_walk(b, prog, bound, nb, errs);
      },
      Option.None => {},
    }
    return;
  }
  if e.tag == parse.EX_Q {
    match e.lhs {
      Option.Some(inner) => {
        expr_walk(inner, prog, bound, nb, errs);
      },
      Option.None => {},
    }
    return;
  }
  if e.tag == parse.EX_MATCH {
    match e.lhs {
      Option.Some(sc) => {
        expr_walk(sc, prog, bound, nb, errs);
      },
      Option.None => {},
    }
    let mut k: usize = 0;
    while k < len(e.marms) {
      walk_arm(e.marms[k], prog, bound, nb, errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_MCALL {
    let mut assoc: bool = false;
    match e.lhs {
      Option.Some(r) => {
        if r.tag == parse.EX_VAR && (enum_known(prog, r.name) ||
            r.name == "Option" || r.name == "Result") {
          // Enum.Var / Enum.Var(args) — the constructor call (the
          // two builtins ride the same path)
          assoc = true;
          if enum_variant(prog, r.name, e.name) < 0 &&
              !(r.name == "Option" || r.name == "Result") {
            eprintf("check: unknown variant '{}.{}'\n", r.name, e.name);
            errs.n = errs.n + 1;
          }
        } else {
        if e.name == "to_str" {
          // the prelude's to_str rides every primitive
          let mut ka: usize = 0;
          while ka < len(e.args) {
            expr_walk(e.args[ka], prog, bound, nb, errs);
            ka = ka + 1;
          }
          return;
        }
        if r.tag == parse.EX_VAR && struct_known(prog, r.name) {
          // Type.name(args) — the associated-fn call; the type itself
          // is not a variable reference
          assoc = true;
          if !fn_named(prog, r.name + "." + e.name) {
            eprintf("check: unknown fn '{}.{}'\n", r.name, e.name);
            errs.n = errs.n + 1;
          }
        } else {
          expr_walk(r, prog, bound, nb, errs);
          if !method_known(prog, e.name) {
            eprintf("check: unknown method '{}'\n", e.name);
            errs.n = errs.n + 1;
          }
        }
        }
      },
      Option.None => {},
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      expr_walk(e.args[k], prog, bound, nb, errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_CLO {
    // a closure literal: its body binds its own params and captures
    // (the emitter resolves captures against the enclosing env)
    return;
  }
  if e.tag == parse.EX_CALL {
    // a locally-bound name (a closure value) is callable
    let mut isbound: bool = false;
    let mut b: usize = 0;
    while b < nb {
      if bound[b] == e.name {
        isbound = true;
      }
      b = b + 1;
    }
    if !isbound && !name_known(prog, e.name) {
      eprintf("check: unknown fn '{}'\n", e.name);
      errs.n = errs.n + 1;
    }
    let mut k: usize = 0;
    while k < len(e.args) {
      expr_walk(e.args[k], prog, bound, nb, errs);
      k = k + 1;
    }
    return;
  }
  if e.tag == parse.EX_VAR {
    let mut hit: bool = false;
    let mut k: usize = 0;
    while k < nb {
      if bound[k] == e.name {
        hit = true;
      }
      k = k + 1;
    }
    let mut g: usize = 0;
    while g < prog.nconsts {
      if prog.consts[g] == e.name {
        hit = true;
      }
      g = g + 1;
    }
    if !hit && !name_known(prog, e.name) {
      // a plain fn's name is a value (the trampoline pair)
      eprintf("check: unknown name '{}'\n", e.name);
      errs.n = errs.n + 1;
    }
    return;
  }
  match e.lhs {
    Option.Some(l) => {
      expr_walk(l, prog, bound, nb, errs);
    },
    Option.None => {},
  }
  match e.rhs {
    Option.Some(r) => {
      expr_walk(r, prog, bound, nb, errs);
    },
    Option.None => {},
  }
}

fn walk_arm(a: *MatchArm, prog: *Prog, bound: []string,
             nb0: usize, errs: *ErrBox) {
  let mut nb: usize = nb0;
  let mut k: usize = 0;
  while k < len(a.pat.binders) {
    if nb < len(bound) {
      bound[nb] = a.pat.binders[k];
      nb = nb + 1;
    }
    k = k + 1;
  }
  // the block arm's statements walk with the binders in scope, the
  // tail expression riding as a final statement (its names resolve
  // against the block's own lets)
  match a.val {
    Option.Some(v) => {
      let all: []*Stmt = make([]*Stmt, len(a.body) + 1);
      let mut q: usize = 0;
      while q < len(a.body) {
        all[q] = a.body[q];
        q = q + 1;
      }
      all[q] = parse.wrap_expr_stmt(v);
      stmts_walk(all, prog, bound, nb, make([]string, 32), 0, errs);
    },
    Option.None => {
      stmts_walk(a.body, prog, bound, nb, make([]string, 32), 0, errs);
    },
  }
}

fn label_known(labels: []string, nl: usize, name: string) -> bool {
  let mut k: usize = 0;
  while k < nl {
    if labels[k] == name {
      return true;
    }
    k = k + 1;
  }
  return false;
}

fn stmts_walk(nodes: []*Stmt, prog: *Prog, bound: []string,
              nb0: usize, labels: []string, nl0: usize,
              errs: *ErrBox) {
  let mut nb: usize = nb0;
  let mut nl: usize = nl0;
  let mut i: usize = 0;
  while i < len(nodes) {
    let st = nodes[i];
    if st.tag == parse.ST_LET || st.tag == parse.ST_SET ||
        st.tag == parse.ST_CALL || st.tag == parse.ST_RET ||
        st.tag == parse.ST_FSTORE {
      match st.val {
        Option.Some(e) => {
          expr_walk(e, prog, bound, nb, errs);
        },
        Option.None => {},
      }
      if st.tag == parse.ST_LET || st.tag == parse.ST_SET {
        if nb < len(bound) {
          bound[nb] = st.name;
          nb = nb + 1;
        }
      }
      if st.tag == parse.ST_FSTORE {
        // the base must be a bound name; a named jump must not have
        // eaten it (dotted statements never carry labels)
        let mut hit: bool = false;
        let mut k: usize = 0;
        while k < nb {
          if bound[k] == st.name {
            hit = true;
          }
          k = k + 1;
        }
        if !hit {
          eprintf("check: unknown name '{}'\n", st.name);
          errs.n = errs.n + 1;
        }
        let mut q: usize = 0;
        while q < len(st.args) {
          expr_walk(st.args[q], prog, bound, nb, errs);
          q = q + 1;
        }
      }
    }
    if st.tag == parse.ST_PF {
      let mut k: usize = 0;
      while k < len(st.args) {
        expr_walk(st.args[k], prog, bound, nb, errs);
        k = k + 1;
      }
    }
    if st.tag == parse.ST_MATCH {
      match st.val {
        Option.Some(sc) => {
          expr_walk(sc, prog, bound, nb, errs);
        },
        Option.None => {},
      }
      let mut k: usize = 0;
      while k < len(st.marms) {
        walk_arm(st.marms[k], prog, bound, nb, errs);
        k = k + 1;
      }
    }
    if st.tag == parse.ST_DEFER {
      match st.sub {
        Option.Some(inner) => {
          let one: []*Stmt = make([]*Stmt, 1);
          one[0] = inner;
          stmts_walk(one, prog, bound, nb, labels, nl, errs);
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_ISTORE {
      let mut k: usize = 0;
      while k < len(st.args) {
        expr_walk(st.args[k], prog, bound, nb, errs);
        k = k + 1;
      }
      match st.val {
        Option.Some(e) => {
          expr_walk(e, prog, bound, nb, errs);
        },
        Option.None => {},
      }
    }
    if st.tag == parse.ST_IF {
      match st.val {
        Option.Some(e) => {
          expr_walk(e, prog, bound, nb, errs);
        },
        Option.None => {},
      }
      stmts_walk(st.body, prog, bound, nb, labels, nl, errs);
      stmts_walk(st.body2, prog, bound, nb, labels, nl, errs);
    }
    if st.tag == parse.ST_WHILE {
      match st.val {
        Option.Some(e) => {
          expr_walk(e, prog, bound, nb, errs);
        },
        Option.None => {},
      }
      if len(st.name) > 0 {
        if nl < len(labels) {
          labels[nl] = st.name;
          nl = nl + 1;
        }
      }
      stmts_walk(st.body, prog, bound, nb, labels, nl, errs);
    }
    if st.tag == parse.ST_LOOP {
      if len(st.name) > 0 {
        if nl < len(labels) {
          labels[nl] = st.name;
          nl = nl + 1;
        }
      }
      stmts_walk(st.body, prog, bound, nb, labels, nl, errs);
    }
    // break/continue bind no names; a named jump must target an
    // enclosing label (the stack holds exactly the enclosing ones)
    if (st.tag == parse.ST_BREAK || st.tag == parse.ST_CONT) &&
        len(st.name) > 0 {
      if !label_known(labels, nl, st.name) {
        eprintf("check: unknown label '{}'\n", st.name);
        errs.n = errs.n + 1;
      }
    }
    i = i + 1;
  }
}

// returns the error count; zero = clean
pub fn check(prog: *Prog) -> i64 {
  let errs_box = new_errbox();
  let mut nf: usize = 0;
  while nf < len(prog.fns) {
    let bound: []string = make([]string, 64);
    let mut k: usize = 0;
    while k < len(prog.fns[nf].params) {
      bound[k] = prog.fns[nf].params[k];
      k = k + 1;
    }
    let labels: []string = make([]string, 32);
    stmts_walk(prog.fns[nf].body, prog, bound, k, labels, 0, errs_box);
    nf = nf + 1;
  }
  let bound: []string = make([]string, 64);
  let labels: []string = make([]string, 32);
  stmts_walk(prog.main, prog, bound, 0, labels, 0, errs_box);
  return errs_box.n;
}

struct ErrBox {
  n: i64,
}

pub fn new_errbox() -> *ErrBox {
  return new ErrBox { n: 0 };
}
