(module (enum Op (Add 0 i32 i32) (Scale 1 (k i32) (v i32)) (Zero 2)) (fn eval (params (o Op)) (ret i32) (return (match (name o) (arm Op.Add(_ b) (name b)) (arm Op.Scale{k _ v v} (name v)) (arm Op.Zero (int 0))))) (fn main (params) (ret i32) (return (bin + (bin + (call (name eval) (call (field (name Op) Add) (int 1) (int 2))) (call (name eval) (call (field (name Op) Scale) k: (int 3) v: (int 4)))) (call (name eval) (field (name Op) Zero))))))
