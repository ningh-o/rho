(module (fn half_even (params (v i32)) (ret Result[i32, string]) (expr (if (bin != (bin % (name v) (int 2)) (int 0)) (block (return (call (field (name Result) Err) (str "odd")))))) (return (call (field (name Result) Ok) (bin / (name v) (int 2))))) (fn run (params (v i32)) (ret Result[i32, string]) (let h i32 (qmark (call (name half_even) (name v)))) (return (call (field (name Result) Ok) (bin * (name h) (int 2))))) (fn main (params) (ret i32) (let r Result[i32, string] (call (name run) (int 8))) (return (match (name r) (arm Result.Ok(x) (name x)) (arm Result.Err(_) (bin - (int 0) (int 1)))))))
