(module (struct P (a i32) (b bool)) (fn to_str (params (self *P)) (ret string) (return (call (name format) (str "P({}, {})") (field (name self) a) (field (name self) b)))) (fn greet (params (name string) (n i32)) (ret string) (return (call (name format) (str "hi {}, {} time(s)") (name name) (name n)))) (fn main (params) (ret i32) (let s string (call (name greet) (str "rho") (int 3))) (let p void (new P (a (int 1)) (b (bool true)))) (let t string (call (name format) (str "[{}] [{}]") (name s) (name p))) (let z string (call (name format) (str "nothing to fill"))) (return (int 0))))
