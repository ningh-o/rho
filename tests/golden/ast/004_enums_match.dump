(module (enum Op (Add 0) (Sub 1) (Mul 2) (Div 10)) (fn apply (params (code Op)) (ret string) (return (match (name code) (arm Op.Add (str "add")) (arm Op.Sub (str "sub")) (arm Op.Mul (str "mul")) (arm Op.Div (str "div"))))) (fn digit_name (params (d i32)) (ret string) (return (match (name d) (arm 0 (str "zero")) (arm 1 (str "one")) (arm _ (str "many"))))) (fn encode (params (code Op)) (ret i32) (return (cast i32 (name code)))) (fn main (params) (ret i32) (let a string (call (name apply) (field (name Op) Mul))) (let b string (call (name digit_name) (int 1))) (expr (if (bin && (bin && (bin == (name a) (str "mul")) (bin == (name b) (str "one"))) (bin == (call (name encode) (field (name Op) Div)) (int 10))) (block (return (call (name encode) (field (name Op) Add)))))) (return (un - (int 1)))))
