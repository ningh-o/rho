fn pick(v: bool) -> i64 {
  if v {
    return 1;
  }
  return 2;
}
fn main() -> i32 {
  let mut total = 0;
  let mut i = 0;
  outer: while i < 10 {
    i += 1;
    let mut j = 0;
    while j < 3 {
      j += 1;
      if j == 2 {
        continue outer;
      }
      if i == 7 {
        break outer;
      }
      total += 1;
    }
  }
  scan: loop {
    i += 1;
    if i % 3 == 0 {
      continue scan;
    }
    if i > 8 {
      break scan;
    }
  }
  let t = pick(i == 3 || total == 6 && true);
  printf("total={} i={} t={} f={} n={}\n", total, i, t, !false, ~5);
  return 0;
}
