// expect: integer literal does not fit string
// spec: spec.md §5 — string + concatenates strings and never coerces
// spec: type-system.md §13 — binary + requires both sides the same type
// "a" + 1 is the canonical no-coercion violation: the integer never
// silently converts, the check must refuse it by name
fn main() -> i32 {
  let s: string = "a" + 1;
  return 0;
}
