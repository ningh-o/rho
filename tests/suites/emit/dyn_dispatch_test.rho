// out: d=pt(1,2)
// out: v=ct(7) ct(7)
// out: p=bx:t
trait Show {
  fn to_str(self) -> string,
}

trait Bump {
  fn bump(mut self) -> i32,
}

struct Pt {
  x: i32,
  y: i32,
}

fn Pt.to_str(self: *Pt) -> string {
  return format("pt({},{})", self.x, self.y);
}

struct Ct {
  n: i32,
}

fn Ct.to_str(self: *Ct) -> string {
  return format("ct({})", self.n);
}

fn Ct.bump(mut self: *Ct) -> i32 {
  self.n = self.n + 1;
  return self.n;
}

fn main() -> i32 {
  let p = new Pt { x: 1, y: 2 };
  let d: dyn Show = p;
  printf("d={}\n", d);
  // re-coercion through assignment; identity is the object
  let mut c = new Ct { n: 5 };
  let v1: dyn Show = c;
  let mut v2: dyn Show = p;
  v2 = c;
  c.bump();
  c.bump();
  printf("v={} {}\n", v1, v2);
  // a second trait over the same type dispatches its own vtable
  let mut b: dyn Bump = c;
  printf("p={}\n", if b.bump() == 8 { "bx:t" } else { "no" });
  return 0;
}
