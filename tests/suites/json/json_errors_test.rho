// json_errors_test.rho — illegal inputs refuse through Result with
// byte-accurate 1-based line:col positions (spec: TODO T4.5 + design
// §14/§4 + RFC 8259 §2).
// out: ERR value expected @1:1
// out: ERR value expected @1:4
// out: ERR trailing characters after JSON value @1:5
// out: ERR leading zero in number @1:2
// out: ERR number: fraction digit expected @1:3
// out: ERR number: exponent digit expected @1:3
// out: ERR array: ',' or ']' expected @1:4
// out: ERR object: ':' expected @1:6
// out: ERR object: ':' expected @2:7
// out: ERR invalid literal: expected 'true' @1:4
// out: ERR invalid UTF-8 continuation byte @1:2
// out: ERR unescaped control character in string @1:3
// out: ERR overlong UTF-8 sequence @1:2
// out: ERR UTF-8 encoded surrogate @1:2
// out: ERR UTF-8 code point above U+10FFFF @1:2
// out: ERR value expected @3:3
// spec: TODO T4.5 + design §14 + design §4
use std.json;

fn where_err(text: string) -> string {
  let r = json.parse(text);
  let s = match r {
    Result.Ok(_) => "parsed?!",
    Result.Err(e) => {
      let m = "ERR " + e.msg + " @" + (e.line.to_str()) + ":" + (e.col.to_str());
      m
    }
  };
  return s;
}

fn main() -> i32 {
  printf("{}\n", where_err(""));
  printf("{}\n", where_err("[1,"));
  printf("{}\n", where_err("[1] junk"));
  printf("{}\n", where_err("01"));
  printf("{}\n", where_err("1."));
  printf("{}\n", where_err("1e"));
  printf("{}\n", where_err("[1 2]"));
  printf("{}\n", where_err("{\"a\" 1}"));
  // the position is line-accurate: the key starts on line 2, col 4
  printf("{}\n", where_err("{\n  \"a\" 1}"));
  printf("{}\n", where_err("tru"));
  // a raw invalid UTF-8 lead byte (0x80) is refused, never laundered
  printf("{}\n", where_err("\"\x80\""));
  // a native NUL byte inside a string is the unescaped control
  // character it is — peek() separates EOF (−1) from NUL (0), so the
  // error is no longer misreported as "unterminated string"
  printf("{}\n", where_err("\"a\x00b\""));
  // canonical-form law (RFC 3629): overlong, surrogate and
  // beyond-U+10FFFF encodings are not UTF-8 and refuse with their own
  // names (comments name the bytes: E0 A0..; ED A0..; F4 90..)
  printf("{}\n", where_err("\"\xe0\x80\xa1\""));
  printf("{}\n", where_err("\"\xed\xa0\x80\""));
  printf("{}\n", where_err("\"\xf4\x90\x80\x80\""));
  // positions count lines: the bad token sits on line 3, col 3
  printf("{}\n", where_err("[\n 1,\n  x]"));
  return 0;
}
