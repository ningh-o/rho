// expect: 'mut' marks a view parameter (*T, []T); 'x' is a value
// spec: TODO.md §18
// the mut marker exists only on write-through views (pointers and
// slices); marking a by-value parameter claims a write the callee
// never gets
fn f(mut x: i32) -> i32 { return x; }

fn main() -> i32 {
  return f(1);
}
