// out: const init: 42
// out: expr init: 43
// exit: 0
// spec: syntax.md §4.3 — static initializers must be acyclic and
// comptime-evaluable: literals, consts, and plain constructors of them
// the bug below is FIXED (statics fold in the same fixpoint as
// consts); the outputs are the law: a static initialized from a const
// or a comptime const-expression reads that value, never 0.
const B: i32 = 42;
const A: i32 = 6;
static mut with_const: i32 = B;
static mut with_expr: i32 = (A + B) - 5;
fn main() -> i32 {
  printf("const init: {}\n", with_const);
  printf("expr init: {}\n", with_expr);
  return 0;
}
