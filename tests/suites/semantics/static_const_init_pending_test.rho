// out: const init: 42
// out: expr init: 43
// exit: 0
// spec: syntax.md §4.3 — static initializers must be acyclic and
// comptime-evaluable: literals, consts, and plain constructors of them
// OBSERVED TODAY (bug B-9): a static initialized from a const or a
// comptime const-expression is ACCEPTED but the value is dropped —
// the static reads 0. `static mut s2: i32 = B;` (B=42) prints 0.
// The outputs below are the LAW; the case promotes when const-valued
// static initializers land.
const B: i32 = 42;
const A: i32 = 6;
static mut with_const: i32 = B;
static mut with_expr: i32 = (A + B) - 5;
fn main() -> i32 {
  printf("const init: {}\n", with_const);
  printf("expr init: {}\n", with_expr);
  return 0;
}
