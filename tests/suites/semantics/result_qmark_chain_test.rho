// out: chain(3) -> ok=13
// out: chain(-1) -> err=negative
// out: chain(-2) -> err=negative
// exit: 0
// spec: type-system.md §12
// `e?` on a Result propagates Err(e) out of a function returning
// Result[U, F] with F EXACTLY the propagated error type, and yields T
// on Ok. Nested `?`s chain: each Ok flows on as a plain value, the
// first Err short-circuits both steps — `parse(-1)` fails the first,
// `parse(-2)` fails the second (the error text is the same value that
// was propagated).
fn parse(n: i32) -> Result[i32, string] {
  if n < 0 {
    return Result.Err("negative");
  }
  return Result.Ok(n * 2);
}
fn chain(n: i32) -> Result[i32, string] {
  let a: i32 = parse(n)?;
  let b: i32 = parse(a)?;
  return Result.Ok(b + 1);
}
fn main() -> i32 {
  match chain(3) {
    Result.Ok(v) => printf("chain(3) -> ok={}\n", v),
    Result.Err(e) => printf("chain(3) -> err={}\n", e),
  }
  match chain(-1) {
    Result.Ok(v) => printf("chain(-1) -> ok={}\n", v),
    Result.Err(e) => printf("chain(-1) -> err={}\n", e),
  }
  match chain(-2) {
    Result.Ok(v) => printf("chain(-2) -> ok={}\n", v),
    Result.Err(e) => printf("chain(-2) -> err={}\n", e),
  }
  return 0;
}
