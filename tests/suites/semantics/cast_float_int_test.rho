// out: 3.9 as i32=3 -3.9 as i32=-3 (truncation toward zero)
// out: 1e300 as i32=2147483647 -1e300 as i32=-2147483648 (saturate)
// out: 1e300 as u64=18446744073709551615 -3.9 as u8=0
// out: nan as i32=0 nan as u8=0
// out: 9007199254740993 as f64=9007199254740992.0 (round to nearest)
// out: f64 1.5 as f32=1.5 f32->f64 roundtrip=0.10000000149011612
// exit: 0
// spec: type-system.md §3
// Float→int `as` truncates toward zero and SATURATES out of range
// (NaN→0): no wraparound, no UB. Int→float rounds to the nearest
// representable value (9007199254740993 loses its last bit in f64).
// f64→f32 narrows to the nearest f32; the f32 nearest 0.1 widened
// back shows its exact value.
fn main() -> i32 {
  let f: f64 = 3.9;
  let g: f64 = -3.9;
  printf("3.9 as i32={} -3.9 as i32={} (truncation toward zero)\n",
         (f as i32), (g as i32));
  let huge: f64 = 1.0e300;
  printf("1e300 as i32={} -1e300 as i32={} (saturate)\n",
         (huge as i32), ((-huge) as i32));
  printf("1e300 as u64={} -3.9 as u8={}\n", (huge as u64), (g as u8));
  let nan: f64 = (0.0 / 0.0);
  printf("nan as i32={} nan as u8={}\n", (nan as i32), (nan as u8));
  let i: i64 = 9007199254740993;
  let asf: f64 = (i as f64);
  printf("9007199254740993 as f64={} (round to nearest)\n", asf);
  let d: f64 = 1.5;
  let h: f32 = 0.1;
  printf("f64 1.5 as f32={} f32->f64 roundtrip={}\n", (d as f32), (h as f64));
  return 0;
}
