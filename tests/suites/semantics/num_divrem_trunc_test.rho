// out: i32 -7/2=-3 -7%2=-1 7/-2=-3 7%-2=1 -7/-2=3 -7%-2=-1
// out: i64 -9/4=-2 -9%4=-1 9/-4=-2 9%-4=1
// out: u32 7/2=3 7%2=1
// out: i32 min/-1=-2147483648 min%-1=0
// exit: 0
// spec: spec.md §4, type-system.md §13
// Division truncates toward zero and the remainder takes the
// dividend's sign (C semantics, not floor): -7/2 = -3 with -7%2 = -1,
// 7/-2 = -3 with 7%-2 = 1. MIN / -1 = MIN with no trap (the wrap law
// absorbs the one out-of-range quotient), MIN % -1 = 0.
fn main() -> i32 {
  let a: i32 = -7;
  printf("i32 -7/2={} -7%2={} 7/-2={} 7%-2={} -7/-2={} -7%-2={}\n",
         (a / 2), (a % 2), (7 / (-2)), (7 % (-2)), ((-7) / (-2)), ((-7) % (-2)));
  let b: i64 = -9;
  printf("i64 -9/4={} -9%4={} 9/-4={} 9%-4={}\n",
         (b / 4), (b % 4), (9 / (-4)), (9 % (-4)));
  let u: u32 = 7;
  printf("u32 7/2={} 7%2={}\n", (u / 2), (u % 2));
  let min: i32 = -2147483648;
  printf("i32 min/-1={} min%-1={}\n", (min / (-1)), (min % (-1)));
  return 0;
}
