// out: f64 0.1=0.10000000000000001
// out: f32 0.1=0.100000001
// out: f64 1/3=0.33333333333333331
// out: 1e21=1e+21 1e-7=9.9999999999999995e-08
// out: inf=inf neginf=-inf negzero=-0.0
// exit: 0
// spec: spec.md §4 (IEEE-754), §5 (printf via to_str)
// Float text is the shortest round-trip form: 17 significant digits
// for f64, 9 for f32 — f64's nearest value to 0.1 prints as
// 0.10000000000000001 while f32's nearer approximation prints as
// 0.100000001. Integral values keep a visible fraction; magnitudes
// beyond the positional window print scientifically with a signed
// two-digit exponent.
fn main() -> i32 {
  let d: f64 = 0.1;
  printf("f64 0.1={}\n", d);
  let f: f32 = 0.1;
  printf("f32 0.1={}\n", f);
  let third: f64 = (1.0 / 3.0);
  printf("f64 1/3={}\n", third);
  let big: f64 = 1.0e21;
  let tiny: f64 = 1.0e-7;
  printf("1e21={} 1e-7={}\n", big, tiny);
  let inf: f64 = (1.0 / 0.0);
  let ninf: f64 = (-1.0 / 0.0);
  let nz: f64 = -0.0;
  printf("inf={} neginf={} negzero={}\n", inf, ninf, nz);
  return 0;
}
