// spec: spec.md §7
// set: MODE=false
// out: w=4 m=false r=0.5 n=plain b=100
const WIDTH: i32 = 4;
const MODE: bool = true;
const RATE: f64 = 0.5;
const NAME: string = "plain";
const BIG: u64 = 100;

fn main() -> i32 {
  printf("w={} m={} r={} n={} b={}\n", WIDTH, MODE, RATE, NAME, BIG);
  return 0;
}
