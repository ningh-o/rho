// out: assoc=16 area=24
// out: bare=2 moved=11 12
// out: mutself=10 2
// out: typed=5
// exit: 0
// spec: syntax.md §4.1
// Methods and associated functions: `fn Rect.square(n: i32)` (first
// parameter is not self) is an associated function called as
// Rect.square(3); `fn Rect.area(self: *Rect)` is a method. In a dotted
// method the receiver may be bare — `self` (read-only *T) or
// `mut self` (writable); the fully-typed form stays legal.
struct Rect {
  w: i32,
  h: i32,
}
fn Rect.square(n: i32) -> i32 {
  return n * n;
}
fn Rect.area(self: *Rect) -> i32 {
  return self.w * self.h;
}
fn Rect.moved(self, dx: i32, dy: i32) -> *Rect {
  return new Rect { w: self.w + dx, h: self.h + dy };
}
fn Rect.shift(mut self, dx: i32) {
  self.w = self.w + dx;
  return;
}
fn Rect.scaled(self: *Rect, k: i32) -> i32 {
  return self.w * self.h * k;
}
fn main() -> i32 {
  let r0 = new Rect { w: 4, h: 6 };
  printf("assoc={} area={}\n", Rect.square(4), r0.area());
  let r = new Rect { w: 1, h: 2 };
  let m = r.moved(10, 10);
  printf("bare={} moved={} {}\n", r.area(), m.w, m.h);
  let mut rs = new Rect { w: 8, h: 2 };
  rs.shift(2);
  printf("mutself={} {}\n", rs.w, rs.h);
  let t = new Rect { w: 1, h: 5 };
  printf("typed={}\n", t.scaled(1));
  return 0;
}
