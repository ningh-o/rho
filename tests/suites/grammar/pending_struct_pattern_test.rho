// out: 1 3
// exit: 0
// spec: syntax.md §7
// `struct_pat := path '{' ident ':' pattern … '}'` is a pattern
// production of its own — matching a struct value by its type path
// (`Pt { x, y } => …`) must destructure it. Today boot refuses:
// "variant pattern on non-enum Pt", treating every path pattern as an
// enum variant.
struct Pt {
  x: i32,
  y: i32,
}
fn main() -> i32 {
  let p = new Pt { x: 1, y: 3 };
  match *p {
    Pt { x, y } => printf("{} {}\n", x, y),
  }
  return 0;
}
