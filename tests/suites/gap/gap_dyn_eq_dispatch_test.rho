struct A { v: i32 }
struct B { v: i32 }
impl Eq for A {
  fn eq(self, other: Self) -> bool { return self.v == other.v; }
}
impl Eq for B {
  fn eq(self, other: Self) -> bool { return self.v == other.v; }
}
fn main() -> i32 {
  let x: dyn Eq = new A { v: 1 };
  let y: dyn Eq = new A { v: 1 };
  let z: dyn Eq = new B { v: 1 };
  printf("dyn-eq: {} {}\n", x.eq(y), x.eq(z));
  return 0;
}
