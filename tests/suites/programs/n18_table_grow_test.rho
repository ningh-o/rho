fn main() -> i32 {
  let a: *S0 = new S0 { v: 10 };
  let b: *S32 = new S32 { v: 32 };
  printf("{}\n", a.v + b.v);
  printf("{}\n", a.m0());
  printf("{}\n", b.m16());
  let e0: E0 = E0.B0;
  match e0 {
    E0.B0 => { printf("e0-b\n"); },
    _ => { printf("?\n"); }
  }
  let e16: E16 = E16.B16;
  match e16 {
    E16.B16 => { printf("e16-b\n"); },
    _ => { printf("?\n"); }
  }
  let e32: E32 = E32.B32;
  match e32 {
    E32.B32 => { printf("e32-b\n"); },
    _ => { printf("?\n"); }
  }
  return 0;
}
