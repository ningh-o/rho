// programs tier — whole-program pin, dissolved from
// corpus/ at the freeze (T6.4).
// out: 42
// out: hi
// out: true
// out: 7
// out: 7
// out: 10
// out: 3
// out: first=3 4
// out: second=3 4
// n19 — call-site type arguments (the wall lift): a factory's T rides
// only its return type, so argument inference can never bind it; the
// explicit name[T] spelling binds. std.collections' vec_of
// instantiates over a type the PROGRAM owns (the compiler-consumption
// shape), the collapsed generic push serves element types std cannot
// name, and inference keeps working where it can (box_of(true)).
use std.collections;

struct Pt {
  x: i64,
  y: i64,
}

struct Box[T] {
  v: T,
}

fn box_of[T](x: T) -> *Box[T] {
  return new Box[T] { v: x };
}

fn zeros[T](n: usize) -> []T {
  return make([]T, n);
}

fn main() -> i32 {
  let b = box_of[i64](41);
  printf("{}\n", b.v + 1);
  let s = box_of[string]("hi");
  printf("{}\n", s.v);
  let c = box_of(true);
  printf("{}\n", c.v);
  let mut z = zeros[i64](3);
  z[0] = 7;
  printf("{}\n", z[0]);
  let mut vp = collections.vec_of[*Pt](2);
  let p1: *Pt = new Pt { x: 3, y: 4 };
  vp.push(p1);
  let got: *Pt = vp.get(0);
  printf("{}\n", got.x + got.y);
  let mut vi = collections.vec_of[i64](4);
  vi.push(9);
  vi.push(10);
  printf("{}\n", vi.get(1));
  // the ordered maps ride the same door: a pointer-valued map is
  // spellable now, and insert collapses to its generic form
  let mut mp = collections.smap_of[*Pt](4);
  mp.insert("first", p1);
  mp.insert("second", p1);
  match mp.insert("first", p1) {
    Option.Some(old) => { printf("{}\n", old.x); },
    Option.None => { printf("absent\n"); }
  }
  let mut w: usize = 0;
  while w < mp.len() {
    printf("{}={} {}\n", mp.key_at(w), mp.val_at(w).x, mp.val_at(w).y);
    w = w + 1;
  }
  return 0;
}
