// programs tier — whole-program pin, dissolved from
// corpus/ at the freeze (T6.4).
// out: 2.5
// out: 4.0
// out: 0.30000000000000004
// out: 0.33333333333333331
// out: 1.0000000000000001e+300
// out: 2.5000000000000001e-05
// out: -0.5
// out: 100.0
// out: 4.9406564584124654e-324
// out: 1.7976931348623157e+308
// out: -2.5000000000000001e-09
// out: 123.456
// out: 10000000000000000.0
// out: 1e+17
// out: inf
// out: nan
// out: -inf
// out: 0.100000001
// out: -2.75
// out: 3.5
// exit: 0
// adapted: f64-valued expressions take `as f32` (as-only conversions)
fn main() -> i32 {
  printf("{}\n", 2.5);
  printf("{}\n", 4.0);
  printf("{}\n", 0.1 + 0.2);
  printf("{}\n", 1.0 / 3.0);
  printf("{}\n", 1e300);
  printf("{}\n", 0.000025);
  printf("{}\n", 0.0 - 0.5);
  printf("{}\n", 100.0);
  printf("{}\n", 5e-324);
  printf("{}\n", 1.7976931348623157e308);
  printf("{}\n", 0.0 - 2.5e-9);
  printf("{}\n", 123.456);
  printf("{}\n", 1e16);
  printf("{}\n", 1e17);
  printf("{}\n", 1.0 / 0.0);
  printf("{}\n", 0.0 / 0.0);
  printf("{}\n", 0.0 - 1.0 / 0.0);
  let f: f32 = 0.1;
  printf("{}\n", f);
  let g: f32 = (0.0 - 2.75) as f32;
  printf("{}\n", g);
  let h: f32 = 3.5;
  printf("{}\n", h);
  return 0;
}
