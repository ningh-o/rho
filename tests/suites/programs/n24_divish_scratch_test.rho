// programs tier — whole-program pin, dissolved from
// corpus/ at the freeze (T6.4).
// out: t5=-12
// out: t6=50
// out: t7=0
// n24 — a divish op's dividend parks in a fresh local (fuzz seed 7):
// it once parked in the shared $r scratch, and a nested divish on the
// rhs parked its own dividend there first — (a ^ b) / (c % 38) read
// the rhs's lhs as the dividend and evaluated (c % 38) / (c % 38).
// Each operand still evaluates exactly once.
fn main() -> i32 {
  let mut t5: i64 = (((-8 as i64) ^ (-78 as i64)) / ((-6 as i64) % 38));
  printf("t5={}\n", t5);
  let a: i64 = 100;
  let b: i64 = 7;
  let c: i64 = 30;
  let mut t6: i64 = ((a * b) / (c % 16));
  printf("t6={}\n", t6);
  let mut t7: i64 = ((a - 40) % (c / 5));
  printf("t7={}\n", t7);
  return 0;
}
