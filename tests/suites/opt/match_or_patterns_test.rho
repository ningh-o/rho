// spec: TODO.md §19 — or-patterns: any alternative matches, identical binder sets
// spec: syntax.md §7 — arm_pat := pattern ('|' pattern)*
// out: 9
// out: 16
// out: 0
// out: hit
// §19 or-patterns landed (T3.9, 2026-09-26): alternatives join on `|`,
// the identical-binder law holds (the same binder `r` on both
// alternatives is the ratified shape; a mismatched set refuses at
// check), and the bare variant form rides the same alternatives
enum Shape {
  Circle(i32),
  Square(i32),
  Dot,
}

enum Opt {
  None,
  Some(i32),
}

fn area(s: Shape) -> i32 {
  return match s {
    Shape.Circle(r) | Shape.Square(r) => r * r,
    Shape.Dot => 0,
  };
}

fn hit(o: Opt) -> string {
  return match o {
    Some(1) | Some(2) => "hit",
    Some(v) => "v",
    None => "none",
  };
}

fn main() -> i32 {
  printf("{}\n", area(Shape.Circle(3)));
  printf("{}\n", area(Shape.Square(4)));
  printf("{}\n", area(Shape.Dot));
  printf("{}\n", hit(Opt.Some(2)));
  return 0;
}
