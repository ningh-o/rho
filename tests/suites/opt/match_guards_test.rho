// spec: TODO.md §19 — guards: pattern if cond, cond sees the pattern's bindings
// spec: syntax.md §7 — guarded arms never close exhaustiveness, a fallback remains
// out: small
// out: medium
// out: large
// out: big
// out: v=2
// out: none
// §19 guards landed (T3.9, 2026-09-26): the guard evaluates after the
// pattern matches, in scope of its bindings; a failed guard falls to
// the next arm, and a guarded arm never counts toward exhaustiveness
// (this match keeps its `_` fallback)
fn classify(n: i32) -> string {
  return match n {
    x if x < 10 => "small",
    x if x < 100 => "medium",
    _ => "large",
  };
}

enum Opt {
  None,
  Some(i32),
}

fn size(o: Opt) -> string {
  return match o {
    Some(v) if v > 5 => "big",
    Some(v) => format("v={}", v),
    None => "none",
  };
}

fn main() -> i32 {
  printf("{}\n", classify(3));
  printf("{}\n", classify(42));
  printf("{}\n", classify(1000));
  printf("{}\n", size(Opt.Some(9)));
  printf("{}\n", size(Opt.Some(2)));
  printf("{}\n", size(Opt.None));
  return 0;
}
