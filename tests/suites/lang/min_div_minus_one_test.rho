// out: min/-1: i8=-128 i16=-32768 i32=-2147483648 i64=-9223372036854775808
// out: min*-1: i8=-128 i16=-32768 i32=-2147483648 i64=-9223372036854775808
// out: -min: i8=-128 i16=-32768 i32=-2147483648 i64=-9223372036854775808
// out: no panic: reached the end
// exit: 0
// spec: spec.md §4
// MIN / -1 wraps to MIN instead of panicking — the one signed
// division with no representable positive result; the same holds for
// MIN * -1 and unary -MIN. A pure value law: the program must reach
// its last line (exit 0, no panic).
fn main() -> i32 {
  let m8: i8 = (-128);
  let m16: i16 = (-32768);
  let m32: i32 = (-2147483648);
  let m64: i64 = (-9223372036854775808);
  printf("min/-1: i8={} i16={} i32={} i64={}\n", (m8 / (-1)), (m16 / (-1)), (m32 / (-1)), (m64 / (-1)));
  printf("min*-1: i8={} i16={} i32={} i64={}\n", (m8 * (-1)), (m16 * (-1)), (m32 * (-1)), (m64 * (-1)));
  printf("-min: i8={} i16={} i32={} i64={}\n", (-m8), (-m16), (-m32), (-m64));
  printf("no panic: reached the end\n");
  return 0;
}
