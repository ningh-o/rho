// expect: want bool
// spec: syntax.md §6.1
// Conditions of if/while are bool; there is no truthiness: an i32
// expression in condition position must fail check ("if/while
// condition is i32, want bool").
fn main() -> i32 {
  let n: i32 = 1;
  if n {
    return 1;
  }
  while n {
    return 1;
  }
  return 0;
}
