// expect: may not be marked 'mut'
// spec: TODO.md §18
// The marker pairs in BOTH directions: a parameter that is not a mut
// view refuses the `mut` marker at the call site — a value or plain
// view parameter takes a copy, and marking it would claim a
// write-through the callee does not have.
fn sum(xs: []i32) -> i32 {
  let mut t: i32 = 0;
  let mut i: usize = 0;
  while i < len(xs) {
    t += xs[i];
    i += 1;
  }
  return t;
}
fn main() -> i32 {
  let a: []i32 = [1, 2, 3];
  sum(mut a);
  return 0;
}
