// out: i32: 1<<30=1073741824 1<<31=-2147483648 1<<32=1 1<<33=2
// out: i32: -16>>1=-8 -16>>2=-4 -16>>31=-1
// out: i64: 1<<63=-9223372036854775808 1<<64=1 1<<65=2
// out: u32: max>>1=2147483647 max>>32=4294967295 1<<31=2147483648 1<<32=1
// out: u64: max>>63=1 max>>64=18446744073709551615 1<<64=1 1<<65=2
// out: u8: 255>>8=255 255>>100=15 1<<8=1
// out: i8: -128>>100=-8 1<<8=1
// exit: 0
// spec: spec.md §4
// Shift counts are masked by the LEFT operand's declared width
// (spec.md §4: 5 bits below i32, 6 bits at i64, 3 bits at i8), so
// `<< width` is a no-op; signed >> fills with the sign bit, unsigned
// >> fills with zero (255 >> 100 masks to >> 4 = 15; 1i8 << 8 is
// 1 << (8 & 7) = 1).
fn main() -> i32 {
  printf("i32: 1<<30={} 1<<31={} 1<<32={} 1<<33={}\n", (1 << 30), (1 << 31), (1 << 32), (1 << 33));
  let n: i32 = (-16);
  printf("i32: -16>>1={} -16>>2={} -16>>31={}\n", (n >> 1), (n >> 2), (n >> 31));
  let one64: i64 = 1;
  printf("i64: 1<<63={} 1<<64={} 1<<65={}\n", (one64 << 63), (one64 << 64), (one64 << 65));
  let m32: u32 = 4294967295;
  let oneu32: u32 = 1;
  printf("u32: max>>1={} max>>32={} 1<<31={} 1<<32={}\n", (m32 >> 1), (m32 >> 32), (oneu32 << 31), (oneu32 << 32));
  let m64: u64 = 18446744073709551615;
  let oneu64: u64 = 1;
  printf("u64: max>>63={} max>>64={} 1<<64={} 1<<65={}\n", (m64 >> 63), (m64 >> 64), (oneu64 << 64), (oneu64 << 65));
  let b8: u8 = 255;
  printf("u8: 255>>8={} 255>>100={} 1<<8={}\n", (b8 >> 8), (b8 >> 100), (1 as u8 << 8));
  let m8: i8 = (-128);
  printf("i8: -128>>100={} 1<<8={}\n", (m8 >> 100), (1 as i8 << 8));
  return 0;
}
