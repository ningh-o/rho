// expect: needs a mut root binding
// spec: TODO.md §18
// The root walk follows field chains: a view handed out of a field
// of a read-only binding is the same hazard — the ROOT binding
// governs, wherever the view hangs off it.
struct S { v: i64, }
struct W { s: *S, }
fn bump(mut p: *S) -> i64 {
  p.v = p.v + 1;
  return p.v;
}
fn main() -> i32 {
  let w: *W = new W { s: new S { v: 1 } };
  bump(mut w.s);
  return 0;
}
