// expect: mut
// pending: T3.6
// spec: TODO.md §18
// PENDING the T3.6 mut-view law (TODO.md §18, ratified but not
// implemented): a binding without `mut` is a read-only view, so a
// field store through it (`p.x = 5`) and a slice-element store
// through it (`s[0] = 9`) must fail check. Today both stores are
// still accepted, so this case FAILS its own criteria (check passes)
// — that failure is the pending marker, and the case goes green the
// day T3.6 lands.
struct P {
  x: i32,
  y: i32,
}
fn main() -> i32 {
  let p = new P { x: 1, y: 2 };
  p.x = 5;
  let s: []i32 = [1, 2, 3];
  s[0] = 9;
  printf("p.x={} s0={}\n", p.x, s[0]);
  return 0;
}
