// exit: 0
// a folded if in value position: the expression's type is the live
// branch's. (Aggregate-valued ifs stay unsupported in 0.0.5, folded or
// not — the value lane is for scalars.)
const pick_left: bool = true;
const use_big: bool = false;

fn main() -> i32 {
  let n: i32 = if pick_left { 10 } else { 20 };
  printf("{}\n", n);
  let scaled: i32 = if use_big { n * 100 } else { n * 2 };
  printf("{}\n", scaled);
  let b: bool = if pick_left { true } else { false };
  if b {
    printf("bool lane\n");
  }
  // early-return law under folding: the live branch returns
  if pick_left {
    return 0;
  }
  printf("unreachable\n");
  return 1;
}
