struct Point {
  x: i32,
  y: i32,
}

fn Point.to_str(self: *Point) -> string {
  return cat("(", cat(self.x.to_str(), "))"));
}

fn i32.double(self: i32) -> i32 {
  return self * 2;
}

fn main() -> i32 {
  let n: i32 = 21;
  printf("{}\n", n.double());
  printf("{}\n", n);
  let flag: bool = true;
  printf("{}\n", flag);
  return 0;
}
