// bench kernel: naive recursive fib(32) — fixed input, deterministic.
// Stresses call overhead, argument passing, and integer arithmetic.
fn fib(n: i64) -> i64 {
  if n < 2 {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

fn main() -> i32 {
  printf("fib(32)={}\n", fib(32));
  return 0;
}
