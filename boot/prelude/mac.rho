// arm64-mac prelude tail: freestanding — the runtime stubs (_write, _exit)
// ride in the image (assembled by rho's own assembler), and __alloc is a
// bump allocator over the image heap (zero-filled __DATA tail, initialized
// by _rho_rt_start before main). No libc anywhere.

extern fn write(fd: i32, buf: *u8, n: usize) -> isize;

extern fn exit(code: i32) -> void;

static mut HEAP: usize = 0;

fn __alloc(n: usize) -> *u8 {
  // the heap starts zeroed and is never reused, so every allocation is
  // fresh zeroed memory: fresh element slots read as null references, so
  // the first assignment into a slot releases null (a no-op) instead of
  // stale heap bytes reinterpreted as a reference count
  let p: usize = HEAP;
  let mut end: usize = p + n;
  end = (end + 15) & 18446744073709551600;
  HEAP = end;
  return p as *u8;
}

fn __free(p: *u8) {
}

fn __print_str(s: string) {
  write(1, s.ptr, s.len);
}

fn __eprint_str(s: string) {
  write(2, s.ptr, s.len);
}

fn __exit(code: i32) {
  exit(code);
}
