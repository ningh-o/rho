// hosted prelude tail (amd64-linux / arm64-mac): libc externs, the four
// per-target hooks the core builds on (__print_str / __eprint_str / __exit
// / __alloc / __free), and the cc-runner externs the toolchain itself uses.

extern fn malloc(n: usize) -> *u8;

extern fn calloc(nm: usize, sz: usize) -> *u8;

extern fn free(p: *u8);

extern fn system(cmd: *u8) -> i32;

extern fn chmod(path: *u8, mode: i32) -> i32;

extern fn write(fd: i32, buf: *u8, n: usize) -> isize;

extern fn exit(code: i32) -> void;

fn __alloc(n: usize) -> *u8 {
  // zeroed: fresh element slots read as null references, so the first
  // assignment into a slot releases null (a no-op) instead of stale heap
  // bytes reinterpreted as a reference count
  return calloc(1, n);
}

fn __free(p: *u8) {
  free(p);
}

fn __print_str(s: string) {
  write(1, s.ptr, s.len);
}

fn __eprint_str(s: string) {
  write(2, s.ptr, s.len);
}

fn __exit(code: i32) {
  exit(code);
}
