extern fn malloc(n: usize) -> *u8;

extern fn calloc(nm: usize, sz: usize) -> *u8;

extern fn free(p: *u8);

extern fn system(cmd: *u8) -> i32;

extern fn chmod(path: *u8, mode: i32) -> i32;

pub enum Option[T] {
  Some(T),
  None,
}

pub enum Result[T, E] {
  Ok(T),
  Err(E),
}

fn Option.is_some(self: Option) -> bool {
  return match self {
    Option.Some(_) => true,
    Option.None => false,
  };
}

fn Option.is_none(self: Option) -> bool {
  return match self {
    Option.Some(_) => false,
    Option.None => true,
  };
}

fn Result.is_ok(self: Result) -> bool {
  return match self {
    Result.Ok(_) => true,
    Result.Err(_) => false,
  };
}

fn Result.is_err(self: Result) -> bool {
  return match self {
    Result.Ok(_) => false,
    Result.Err(_) => true,
  };
}

fn __alloc(n: usize) -> *u8 {
  // zeroed: fresh element slots read as null references, so the first
  // assignment into a slot releases null (a no-op) instead of stale heap
  // bytes reinterpreted as a reference count
  return calloc(1, n);
}

fn __free(p: *u8) {
  free(p);
}

extern fn write(fd: i32, buf: *u8, n: usize) -> isize;

extern fn exit(code: i32) -> void;

fn print(s: string) {
  write(1, s.ptr, s.len);
}

fn eprint(s: string) {
  write(2, s.ptr, s.len);
}

fn panic(msg: string) {
  eprint("panic: ");
  eprint(msg);
  eprint("\n");
  exit(101);
}

fn assert(cond: bool) {
  if (!cond) {
    panic("assertion failed");
  }
}

fn __panic_div() {
  panic("division by zero");
}

fn __panic_oob() {
  panic("index out of bounds");
}

fn __panic_null() {
  panic("null dereference");
}

fn print_bytes(b: []u8) {
  write(1, b.ptr, b.len);
}

fn print_int(v: i64) {
  let buf: []u8 = make([]u8, 24);
  let mut n: usize = 24;
  let mut x: i64 = v;
  let neg: bool = (x < 0);
  if neg {
    x = (0 - x);
  }
  loop {
    n -= 1;
    let d: i64 = (x % 10);
    buf[n] = (48 + d) as u8;
    x /= 10;
    if (x == 0) {
      break;
    }
  }
  if neg {
    n -= 1;
    buf[n] = 45;
  }
  print_bytes(buf[n..24]);
}

fn print_ln() {
  print("\n");
}

fn __streq(a: string, b: string) -> bool {
  if len(a) != len(b) {
    return false;
  }
  let mut i: usize = 0;
  while i < len(a) {
    if a[i] != b[i] {
      return false;
    }
    i += 1;
  }
  return true;
}
