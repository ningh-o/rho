extern fn fd_write(fd: i32, iovs: i32, count: i32, nwritten: i32) -> i32;
extern fn proc_exit(code: i32);

pub enum Option[T] {
  Some(T),
  None,
}

pub enum Result[T, E] {
  Ok(T),
  Err(E),
}

struct Iov {
  p: i32,
  l: i32,
}

static mut HEAP: usize = 65536;

fn Option.is_some(self: Option) -> bool {
  return match self {
    Option.Some(_) => true,
    Option.None => false,
  };
}

fn Option.is_none(self: Option) -> bool {
  return match self {
    Option.Some(_) => false,
    Option.None => true,
  };
}

fn Result.is_ok(self: Result) -> bool {
  return match self {
    Result.Ok(_) => true,
    Result.Err(_) => false,
  };
}

fn Result.is_err(self: Result) -> bool {
  return match self {
    Result.Ok(_) => false,
    Result.Err(_) => true,
  };
}

fn __alloc(n: usize) -> *u8 {
  let p: usize = HEAP;
  let mut end: usize = p + n;
  end = (end + 7) & 4294967288;
  HEAP = end;
  return p as *u8;
}

fn __free(p: *u8) {
}

fn print(s: string) {
  let iov = new Iov { p: (s.ptr as usize) as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(1, iov as usize as i32, 1, nw as usize as i32);
}

fn eprint(s: string) {
  let iov = new Iov { p: (s.ptr as usize) as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(2, iov as usize as i32, 1, nw as usize as i32);
}

fn panic(msg: string) {
  eprint("panic: ");
  eprint(msg);
  eprint("\n");
  proc_exit(101);
}

fn assert(cond: bool) {
  if !cond {
    panic("assertion failed");
  }
}

fn __panic_div() {
  panic("division by zero");
}

fn __panic_oob() {
  panic("index out of bounds");
}

fn __panic_null() {
  panic("null dereference");
}

fn print_bytes(b: []u8) {
  let iov = new Iov { p: (b.ptr as usize) as i32, l: b.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(1, iov as usize as i32, 1, nw as usize as i32);
}

fn print_int(v: i64) {
  let buf: []u8 = make([]u8, 24);
  let mut n: usize = 24;
  let mut x: i64 = v;
  let neg: bool = (x < 0);
  if neg {
    x = (0 - x);
  }
  loop {
    n -= 1;
    let d: i64 = (x % 10);
    buf[n] = (48 + d) as u8;
    x /= 10;
    if (x == 0) {
      break;
    }
  }
  if neg {
    n -= 1;
    buf[n] = 45;
  }
  print_bytes(buf[n..24]);
}

fn print_ln() {
  print("\n");
}

fn __streq(a: string, b: string) -> bool {
  if len(a) != len(b) {
    return false;
  }
  let mut i: usize = 0;
  while i < len(a) {
    if a[i] != b[i] {
      return false;
    }
    i += 1;
  }
  return true;
}
