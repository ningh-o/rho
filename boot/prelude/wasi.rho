// wasm32-wasi prelude tail: fd_write/proc_write imports, a bump allocator
// over the linear-memory heap, and the per-target hooks the core builds on.

extern fn fd_write(fd: i32, iovs: i32, count: i32, nwritten: i32) -> i32;

extern fn proc_exit(code: i32);

extern fn system(cmd: *u8) -> i32;

extern fn chmod(path: *u8, mode: i32) -> i32;

struct Iov {
  p: i32,
  l: i32,
}

static mut HEAP: usize = 65536;

fn __alloc(n: usize) -> *u8 {
  let p: usize = HEAP;
  let mut end: usize = p + n;
  end = (end + 7) & 4294967288;
  HEAP = end;
  return p as *u8;
}

fn __free(p: *u8) {
}

fn __print_str(s: string) {
  let iov = new Iov { p: (s.ptr as usize) as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(1, iov as usize as i32, 1, nw as usize as i32);
}

fn __eprint_str(s: string) {
  let iov = new Iov { p: (s.ptr as usize) as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(2, iov as usize as i32, 1, nw as usize as i32);
}

fn __exit(code: i32) {
  proc_exit(code);
}
