extern fn fd_write(fd: i32, iovs: i32, count: i32, nwritten: i32) -> i32;
extern fn proc_exit(code: i32);

struct Iov {
  p: i32,
  l: i32,
}

static mut HEAP: usize = 65536;

fn __alloc(n: usize) -> *u8 {
  let p: usize = HEAP;
  let mut end: usize = p + n;
  end = (end + 7) & 4294967288;
  HEAP = end;
  return p as *u8;
}

fn __free(p: *u8) {
}

fn print(s: string) {
  let iov = new Iov { p: s.ptr as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(1, iov.ptr as i32, 1, nw.ptr as i32);
}

fn eprint(s: string) {
  let iov = new Iov { p: s.ptr as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(2, iov.ptr as i32, 1, nw.ptr as i32);
}

fn panic(msg: string) {
  eprint("panic: ");
  eprint(msg);
  eprint("\n");
  proc_exit(101);
}

fn assert(cond: bool) {
  if !cond {
    panic("assertion failed");
  }
}

fn __panic_div() {
  panic("division by zero");
}

fn __panic_oob() {
  panic("index out of bounds");
}

fn __panic_null() {
  panic("null dereference");
}
