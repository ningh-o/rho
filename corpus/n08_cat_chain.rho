// exit: 0
fn assert_eq(a: string, b: string) {
  assert(a == b, "assert_eq failed");
  return;
}

// 063 — `+` over dynamic (non-literal) operands: a loop of one-byte
// slices reassembles the whole source, a slice-of-slice piece and a
// format piece ride the same chain, and == judges every result
fn main() -> i32 {
  let src: string = "chain-of-pieces";
  let mut built: string = "";
  let mut i: usize = 0;
  while (i < len(src)) {
    built = built + src[i..(i + 1)];
    i += 1;
  }
  assert_eq(built, src);
  printf("{}\n", built);
  let piece: string = src[0..5] + src[6..8] + src[9..15];
  assert_eq(piece, "chainofpieces");
  printf("{}\n", piece);
  let nested: string = src[0..9][6..8] + (src[9..15] + "");
  assert_eq(nested, "ofpieces");
  printf("{}\n", nested);
  let mixed: string = format("[{}]", len(src)) + "|" + src[0..5];
  assert_eq(mixed, "[15]|chain");
  printf("{}\n", mixed);
  return 0;
}
