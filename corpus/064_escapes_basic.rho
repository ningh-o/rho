// exit: 0
// 064 — the basic escapes (\n \t \\ \"): each decodes to exactly one
// byte, a doubled backslash stays one backslash, and escaped text
// equals the same string built by hand with cat
fn main() -> i32 {
  printf("{} {} {} {}\n", len("\n"), len("\t"), len("\\"), len("\""));
  printf("{} {}\n", len("\\n"), len("\\\\"));
  assert_eq("a\tb", cat("a", cat("\t", "b")));
  assert_eq("line1\nline2", cat("line1", cat("\n", "line2")));
  assert_eq("a\\b", cat("a", cat("\\", "b")));
  assert_eq("say \"hi\"", cat("say ", cat("\"", cat("hi", "\""))));
  printf("say \"hi\" \\ ok\n");
  printf("{} {} {} {}\n", "\n"[0], "\t"[0], "\\"[0], "\""[0]);
  printf("tab[\t]done\n");
  return 0;
}
