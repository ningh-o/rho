// exit: 0
// 062 — the join helpers user code stacks on string `+` (the libs/json
// idiom): left- and right-associated spellings agree, and a helper's
// trailing argument may itself nest a sum or another helper
fn join3(a: string, b: string, c: string) -> string {
  return (a + b) + c;
}

fn join3r(a: string, b: string, c: string) -> string {
  return a + (b + c);
}

fn join4(a: string, b: string, c: string, d: string) -> string {
  return ((a + b) + c) + d;
}

fn join4r(a: string, b: string, c: string, d: string) -> string {
  return a + (b + (c + d));
}

fn main() -> i32 {
  let flat: string = "wxyz!";
  let a: string = join3("w", "xy", "z!");
  let b: string = join3r("w", "xy", "z!");
  let c: string = join4("w", "x", "yz", "!");
  let d: string = join4r("w", "x", "yz", "!");
  let tail: string = join4("w", "x", "y", "z" + "!");
  let nest: string = join4(join3("w", "x", "y"), "z", "!", "");
  assert_eq(a, flat);
  assert_eq(b, flat);
  assert_eq(c, flat);
  assert_eq(d, flat);
  assert_eq(tail, flat);
  assert_eq(nest, flat);
  printf("{}\n{}\n{}\n{}\n{}\n{}\n", a, b, c, d, tail, nest);
  return 0;
}
