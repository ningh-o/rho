// exit: 0
// adapted from 099_churn_release: three thousand allocate/observe/drop
// rounds; self-assignment stays a no-op; reassignment releases the old
struct Node {
  v: i32,
}

fn make_node(v: i32) -> *Node {
  return new Node { v: v };
}

fn alive(w: weak[Node]) -> bool {
  return match w.get() {
    Option.Some(_) => true,
    Option.None => false,
  };
}

fn main() -> i32 {
  let mut died: i32 = 0;
  let mut i: i32 = 0;
  while (i < 3000) {
    let mut n: ?*Node = Option.Some(make_node(i));
    let w: weak[Node] = weak.from(deref(n));
    n = Option.None;
    if !alive(w) {
      died += 1;
    }
    i += 1;
  }
  printf("churn: died={}\n", died);
  let mut a: *Node = make_node(1);
  let wa: weak[Node] = weak.from(a);
  a = a;
  printf("self-assign: alive={} v={}\n", alive(wa), a.v);
  let old: weak[Node] = wa;
  a = make_node(2);
  let fresh: weak[Node] = weak.from(a);
  printf("reassign: old_dead={} fresh_alive={} v={}\n", !alive(old), alive(fresh), a.v);
  return 0;
}

fn deref(o: ?*Node) -> *Node {
  return match o {
    Option.Some(p) => p,
    Option.None => make_node(0),
  };
}
