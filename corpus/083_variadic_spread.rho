// exit: 0
// slice 083: spread calls — an existing slice fills the rest parameter
// whole: full, sub-slice, empty, after fixed args, spread twice, and
// over pointer element types
struct Pair[A, B] {
  a: A,
  b: B,
}

fn total(ns: i64...) -> i64 {
  let mut t: i64 = 0;
  let mut i: usize = 0;
  while i < len(ns) {
    t += ns[i];
    i += 1;
  }
  return t;
}

// a spread may follow fixed arguments — but only when the callee has
// fixed parameters to match: a zero-fixed variadic called with an
// argument before the spread is a checker error in the frozen oracle
fn plus(base: i64, ns: i64...) -> i64 {
  return base + total(ns...);
}

fn pair_sum(ps: *Pair[i32, i64]...) -> i64 {
  let mut t: i64 = 0;
  let mut i: usize = 0;
  while i < len(ps) {
    t += (ps[i].a as i64) + ps[i].b;
    i += 1;
  }
  return t;
}

fn main() -> i32 {
  let mut xs: []i64 = make([]i64, 4);
  xs[0] = 3;
  xs[1] = 9;
  xs[2] = 2;
  xs[3] = 7;
  printf("full={}\n", total(xs...));
  // fixed arguments before the spread, matched to the callee's fixed head
  printf("head={}\n", plus(100, xs...));
  // a sub-slice shares the buffer but spreads on its own
  let mid = xs[1..3];
  printf("mid={} (len {})\n", total(mid...), len(mid));
  // the empty spread is the empty call
  let none: []i64 = make([]i64, 0);
  printf("empty={} {}\n", total(none...), total());
  // the same slice spread twice stays independent
  printf("twice={}\n", total(xs...) + total(xs...));
  // pointer-element spread
  let mut ps: []*Pair[i32, i64] = make([]*Pair[i32, i64], 2);
  ps[0] = new Pair[i32, i64] { a: 1, b: 2 };
  ps[1] = new Pair[i32, i64] { a: 30, b: 40 };
  printf("pairs={}\n", pair_sum(ps...));
  return 0;
}
