// exit: 0
fn main() -> i32 {
  printf("i32: {}\n", 42);
  printf("{}\n", -7);
  printf("{}\n", 0);
  let almost: i64 = 9223372036854775807;
  printf("{}\n", almost + 1);
  let umax: u64 = 18446744073709551615;
  printf("{}\n", umax);
  let u8v: u8 = 255;
  printf("{}\n", u8v);
  let i8v: i8 = (0 - 128) as i8;
  printf("{}\n", i8v);
  let u16v: u16 = 65535;
  printf("{}\n", u16v);
  let i16v: i16 = (0 - 32768) as i16;
  printf("{}\n", i16v);
  let u32v: u32 = 4000000000;
  printf("{}\n", u32v);
  printf("{}\n", true);
  printf("{}\n", false);
  printf("{}\n", "a string");
  eprintf("stderr line\n");
  printf("{}\n", "con" + ("cat" + "enated"));
  return 0;
}
