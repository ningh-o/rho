// exit: 0
// signed shifts are arithmetic (sign-filling); the count masks by
// the LEFT OPERAND'S WIDTH (spec.md §4) — 1 << 33 on i32 shifts by
// 1, and a sub-word width masks by its own width (1i8 << 8 is 1:
// 8 & 7 = 0, then truncate keeps it)
// exit: 0
// signed shifts are arithmetic (sign-filling); the amount is masked to
// the operand's register width — 5 bits below i32, 6 bits at i64 — so
// 1 << 32 on i32 is 1 again, and sub-word widths shift in the 32-bit
// register and truncate afterwards (1i8 << 8 is 0, not 1)
fn main() -> i32 {
  printf("i32: 1<<30={} 1<<31={} 1<<32={} 1<<33={}\n", (1 << 30), (1 << 31), (1 << 32), (1 << 33));
  let n: i32 = (-16);
  let m32: i32 = (-2147483648);
  printf("i32: -16>>2={} min>>31={} min>>32={}\n", (n >> 2), (m32 >> 31), (m32 >> 32));
  let one64: i64 = 1;
  let n64: i64 = (-1);
  let m64: i64 = (-9223372036854775808);
  printf("i64: 1<<62={} 1<<63={} 1<<64={} 1<<65={}\n", (one64 << 62), (one64 << 63), (one64 << 64), (one64 << 65));
  printf("i64: -1>>1={} -1>>63={} -1>>64={} min>>63={}\n", (n64 >> 1), (n64 >> 63), (n64 >> 64), (m64 >> 63));
  printf("i64: (1<<63)>>63={}\n", ((one64 << 63) >> 63));
  let m8: i8 = (-128);
  printf("i8: 1<<7={} 1<<8={} m8>>7={} m8>>8={} m8>>100={}\n", (1 as i8 << 7), (1 as i8 << 8), (m8 >> 7), (m8 >> 8), (m8 >> 100));
  return 0;
}
