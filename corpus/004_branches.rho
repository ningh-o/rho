// exit: 10
fn classify(n: i32) -> i32 {
  if n < 0 {
    return 1;
  } else if n == 0 {
    return 2;
  } else if n < 10 {
    return 3;
  }
  return 4;
}

fn main() -> i32 {
  let mut acc: i32 = 0;
  acc += classify(-5);
  acc += classify(0);
  acc += classify(5);
  acc += classify(50);
  loop {
    acc += 0;
    break;
  }
  return acc + 0;
}
