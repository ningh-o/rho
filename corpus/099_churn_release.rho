// exit: 0
// release survives churn: three thousand allocate/observe/drop rounds each
// see the weak flip to null; overwriting a binding releases exactly the old
// object; assigning a variable to itself is a no-op and keeps the object.
struct Node {
  v: i32,
}

fn make_node(v: i32) -> *Node {
  return new Node { v: v };
}

fn main() -> i32 {
  let mut died: i32 = 0;
  let mut i: i32 = 0;
  while (i < 3000) {
    let mut n: *Node = make_node(i);
    let w: weak[Node] = weak.from(n);
    n = null;
    if (w.get() == null) {
      died += 1;
    }
    i += 1;
  }
  printf("churn: died={}\n", died);
  let mut a: *Node = make_node(1);
  let wa: weak[Node] = weak.from(a);
  a = a;
  printf("self-assign: alive={} v={}\n", (wa.get() != null), a.v);
  let old: weak[Node] = wa;
  a = make_node(2);
  let fresh: weak[Node] = weak.from(a);
  printf("reassign: old_dead={} fresh_alive={} v={}\n", (old.get() == null), (fresh.get() != null), a.v);
  return 0;
}
