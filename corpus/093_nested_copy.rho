// exit: 0
// aggregate copies are shallow: deref-copying a struct retains each managed
// field once, so the slice view and the node pointer are shared — a write
// through the copy shows up through the original; per-field copies behave
// the same way, and strings compare by contents.
struct Node {
  v: i32,
}

struct Bundle {
  xs: []i32,
  name: string,
  node: *Node,
}

fn make_bundle() -> *Bundle {
  let mut xs: []i32 = make([]i32, 3);
  xs[0] = 5;
  xs[1] = 6;
  xs[2] = 7;
  return new Bundle { xs: xs, name: "hold", node: new Node { v: 9 } };
}

fn main() -> i32 {
  let b: *Bundle = make_bundle();
  let mut st: Bundle = (*b);
  st.xs[1] = 60;
  st.node.v = 90;
  printf("shared: b.xs[1]={} b.node.v={}\n", b.xs[1], b.node.v);
  printf("copy reads: st.xs[1]={} st.node.v={}\n", st.xs[1], st.node.v);
  printf("identity: node_eq={} name_eq={}\n", (st.node == b.node), (st.name == b.name));
  let mut xs2: []i32 = b.xs;
  let node2: *Node = b.node;
  xs2[2] = 70;
  printf("field copies: b.xs[2]={} same_node={}\n", b.xs[2], (node2 == b.node));
  return 0;
}
