// exit: 0
// adapted: f64-valued expressions take `as f32` (as-only conversions)
fn main() -> i32 {
  printf("{}\n", 2.5);
  printf("{}\n", 4.0);
  printf("{}\n", 0.1 + 0.2);
  printf("{}\n", 1.0 / 3.0);
  printf("{}\n", 1e300);
  printf("{}\n", 0.000025);
  printf("{}\n", 0.0 - 0.5);
  printf("{}\n", 100.0);
  printf("{}\n", 5e-324);
  printf("{}\n", 1.7976931348623157e308);
  printf("{}\n", 0.0 - 2.5e-9);
  printf("{}\n", 123.456);
  printf("{}\n", 1e16);
  printf("{}\n", 1e17);
  printf("{}\n", 1.0 / 0.0);
  printf("{}\n", 0.0 / 0.0);
  printf("{}\n", 0.0 - 1.0 / 0.0);
  let f: f32 = 0.1;
  printf("{}\n", f);
  let g: f32 = (0.0 - 2.75) as f32;
  printf("{}\n", g);
  let h: f32 = 3.5;
  printf("{}\n", h);
  return 0;
}
