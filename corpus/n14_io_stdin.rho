// exit: 0
// the __ face through the differential: stdin's byte window reads
// empty under the harness, so the packed read returns 0 and the
// round-trip string is empty; the write side counts "ok\n"
fn main() -> i32 {
  let mut buf: []u8 = make([]u8, 32);
  let n: i32 = __fd_read_packed(0, mut buf);
  let s: string = __string_from(buf, n as usize);
  printf("n={} len={}\n", n, len(s));
  let w: i32 = __fd_write(1, "ok\n");
  printf("w={}\n", w);
  return 0;
}
