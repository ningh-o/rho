// exit: 0
// slice 087: []dyn strides by the 16-byte fat element — store, reload,
// overwrite, read from both ends, sub-slice in stride, and a second
// trait over the same shapes
trait Show {
  fn to_str(self) -> string,
}

trait Size {
  fn size(self) -> i32,
}

struct Pt {
  x: i32,
  y: i32,
}

fn Pt.to_str(self: *Pt) -> string {
  return format("pt({},{})", self.x, self.y);
}

fn Pt.size(self: *Pt) -> i32 {
  return self.x + self.y;
}

struct Bx {
  tag: string,
}

fn Bx.to_str(self: *Bx) -> string {
  return format("bx:{}", self.tag);
}

fn Bx.size(self: *Bx) -> i32 {
  return len(self.tag) as i32;
}

struct Num {
  v: i32,
}

fn Num.to_str(self: *Num) -> string {
  return format("num({})", self.v);
}

fn Num.size(self: *Num) -> i32 {
  return self.v;
}

fn main() -> i32 {
  let items: []dyn Show = make([]dyn Show, 4);
  items[0] = new Pt { x: 1, y: 2 };
  items[1] = new Bx { tag: "abc" };
  items[2] = new Num { v: 7 };
  items[3] = new Pt { x: 5, y: 5 };
  let mut i: usize = 0;
  while i < len(items) {
    printf("[{}] {}\n", i, items[i]);
    i += 1;
  }
  // overwriting one fat element leaves the neighbors alone
  items[1] = new Pt { x: 9, y: 9 };
  printf("overwritten: {}\n", items[1]);
  printf("ends {} | {}\n", items[0], items[len(items) - 1]);
  // a sub-slice keeps the stride and shares the buffer
  let tail = items[2..4];
  printf("tail n={} first={}\n", len(tail), tail[0]);
  i = 0;
  while i < len(tail) {
    printf("tail [{}] {}\n", i, tail[i]);
    i += 1;
  }
  // a second trait over the same shapes
  let sized: []dyn Size = make([]dyn Size, 3);
  sized[0] = new Pt { x: 2, y: 3 };
  sized[1] = new Bx { tag: "abcd" };
  sized[2] = new Num { v: 10 };
  let mut sum: i32 = 0;
  i = 0;
  while i < len(sized) {
    sum += sized[i].size();
    i += 1;
  }
  printf("sizes sum={} one={}\n", sum, sized[1].size());
  return 0;
}
