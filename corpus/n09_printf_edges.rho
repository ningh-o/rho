// exit: 0
// adapted: assert_eq lives in the file (string form)
fn assert_eq(a: string, b: string) {
  assert(a == b, "assert_eq failed");
  return;
}

// 067 — printf placeholder boundaries: `{}` at the very start and the
// very end, adjacent holes, doubled braces as literals (also flush
// against the string edges), a holeless call, and a value whose own
// text contains braces — only the literal is ever scanned
fn main() -> i32 {
  printf("{} first\n", 1);
  printf("last {}\n", 2);
  printf("{}{}\n", 3, 4);
  printf("{{}} and {{{}}}\n", 5);
  printf("end {{\n");
  printf("close }}\n");
  printf("[{}]\n", format("{{}}"));
  printf("no holes at all\n");
  printf("{}\n", "braced " + "{}");
  return 0;
}
