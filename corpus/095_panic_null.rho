// exit: 101
// dereferencing null panics: the object is released, the weak observes the
// death, get() hands back null, and the first field access through that
// null traps with the process exit 101.
struct Node {
  v: i32,
}

fn make_node(v: i32) -> *Node {
  return new Node { v: v };
}

fn main() -> i32 {
  let mut n: *Node = make_node(8);
  let w: weak[Node] = weak.from(n);
  n = null;
  printf("released: alive={}\n", (w.get() != null));
  let q: *Node = w.get();
  printf("get: q_null={}\n", (q == null));
  printf("reading q.v\n");
  printf("q.v={}\n", q.v);
  printf("unreachable\n");
  return 0;
}
