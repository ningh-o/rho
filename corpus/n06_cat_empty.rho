// exit: 0
fn assert_eq(a: string, b: string) {
  assert(a == b, "assert_eq failed");
  return;
}

// 062 — the join helpers user code stacks on string `+` (the libs/json
// idiom): left- and right-associated spellings agree, and a helper's
// trailing argument may itself nest a sum or another helper
fn join3(a: string, b: string, c: string) -> string {
  return (a + b) + c;
}

fn join3r(a: string, b: string, c: string) -> string {
  return a + (b + c);
}

fn join4(a: string, b: string, c: string, d: string) -> string {
  return ((a + b) + c) + d;
}

fn join4r(a: string, b: string, c: string, d: string) -> string {
  return a + (b + (c + d));
}

// 061 — `+` against the empty string: either side, both sides,
// nested empties, an empty carved out by a slice; length moves,
// content never does
fn main() -> i32 {
  let s: string = "rho";
  let e: string = "";
  assert_eq(e + s, "rho");
  assert_eq(s + e, "rho");
  assert_eq(e + e, "");
  assert_eq(e + (e + (e + s)), "rho");
  printf("[{}][{}][{}]\n", e + s, s + e, e + e);
  printf("{} {} {} {}\n", len(s), len(e), len(e + e), len(e + s));
  let half: string = s[2..2];
  assert_eq(half, "");
  printf("[{}] {}\n", half, len(half));
  printf("[{}] [{}]\n", format("{}", e), format("{}|{}", e, e));
  return 0;
}
