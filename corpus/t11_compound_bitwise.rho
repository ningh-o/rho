// exit: 0
// tranche 3 — bitwise compound assignments end-to-end at several
// widths: &= |= ^= <<= >>= with wrap/shift-mask semantics
fn main() -> i32 {
  let mut a: u32 = 0xF0F0;
  a &= 0x0FF0;
  printf("{}\n", a);
  a |= 0x000F;
  printf("{}\n", a);
  a ^= 0xFFFF;
  printf("{}\n", a);
  let mut b: i32 = 1;
  b <<= 40;
  printf("{}\n", b);
  b >>= 2;
  printf("{}\n", b);
  let mut c: u8 = 200;
  c += 100;
  printf("{}\n", c);
  let mut d: i64 = 1;
  d <<= 62;
  printf("{}\n", d);
  d >>= 61;
  printf("{}\n", d);
  return 0;
}
