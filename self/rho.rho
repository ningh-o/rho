  .long 0
rho_rt_argv:
  .quad 0
"""; }

// ---- shared assembler helpers ---------------------------------------------

struct ASym {
  name: string,
  sec: i32,
  off: u64,
  defined: bool,
}

struct AFix {
  sec: i32,
  at: u64,   // byte offset of the patched field inside its section
  kind: i32,
  sym: string,
}

struct AEnt { key: string, val: *ASym }

struct AMap {
  slots: []*AEnt,
  cap: usize,
  n: usize,
}

fn am_put(m: *AMap, key: string, val: *ASym) {
  if m.n * 10 >= m.cap * 7 {
    let ncap: usize = if m.cap == 0 { 64 } else { m.cap * 2 };
    let slots: []*AEnt = make([]*AEnt, ncap);
    let old: []*AEnt = m.slots;
    let oldn: usize = m.cap;
    m.slots = slots;
    m.cap = ncap;
    m.n = 0;
    let mut i: usize = 0;
    while i < oldn {
      if old[i] != null {
        am_put(m, old[i].key, old[i].val);
      }
      i += 1;
    }
  }
  let mut i: usize = map_hash(key) & (m.cap - 1);
  while m.slots[i] != null {
    if streq(m.slots[i].key, key) {
      m.slots[i].val = val;
      return;
    }
    i = (i + 1) & (m.cap - 1);
  }
  m.slots[i] = new AEnt { key: key, val: val };
  m.n += 1;
}

fn am_get(m: *AMap, key: string) -> *ASym {
  if m.cap == 0 {
    return null;
  }
  let mut i: usize = map_hash(key) & (m.cap - 1);
  while m.slots[i] != null {
    if streq(m.slots[i].key, key) {
      return m.slots[i].val;
    }
    i = (i + 1) & (m.cap - 1);
  }
  return null;
}

// arm64 fixup kinds (0-6) and amd64 fixup kinds (7-8)
static mut FIX_ADRP: i32 = 0;
static mut FIX_ADDPAGE: i32 = 1;
static mut FIX_B26: i32 = 2;
static mut FIX_BL26: i32 = 3;
static mut FIX_BC19: i32 = 4;
static mut FIX_CB19: i32 = 5;
static mut FIX_ABS64: i32 = 6;
static mut FIX_REL32: i32 = 7;
static mut FIX_RIPREL: i32 = 8;

// section images: 0 text, 1 strings, 2 data
struct ASMCtx {
  out: []*Vec[u8],
  syms: *Vec[*ASym],
  by_name: *AMap,
  fixes: *Vec[*AFix],
  sec: i32,
  base: u64, // vaddr of the first text byte
  errors: i32,
  is_arm: bool,
}

fn ac_new(base: u64, is_arm: bool) -> *ASMCtx {
  let out: []*Vec[u8] = make([]*Vec[u8], 3);
  let mut i: usize = 0;
  while i < 3 {
    out[i] = new Vec[u8] { items: make([]u8, 4096), n: 0 };
    i += 1;
  }
  return new ASMCtx {
    out: out, syms: new Vec[*ASym] { items: make([]*ASym, 256), n: 0 },
    by_name: new AMap { slots: make([]*AEnt, 0), cap: 0, n: 0 },
    fixes: new Vec[*AFix] { items: make([]*AFix, 256), n: 0 },
    sec: 0, base: base, errors: 0, is_arm: is_arm,
  };
}

fn asm_err(a: *ASMCtx, msg: string) {
  if a.is_arm {
    eprintf("{}", cat("rho: asm64: ", cat3(msg, "\n", "")));
  } else {
    eprintf("{}", cat("rho: asm86: ", cat3(msg, "\n", "")));
  }
  a.errors += 1;
}

fn a_emitb(a: *ASMCtx, byte: i32) {
  a.out[a.sec as usize].push((byte & 255) as u8);
}

fn a_emit4(a: *ASMCtx, w: u32) {
  a.out[a.sec as usize].push((w & 255) as u8);
  a.out[a.sec as usize].push(((w >> 8) & 255) as u8);
  a.out[a.sec as usize].push(((w >> 16) & 255) as u8);
  a.out[a.sec as usize].push(((w >> 24) & 255) as u8);
}

fn a_emit32(a: *ASMCtx, w: u32) {
  a_emit4(a, w);
}

fn a_cur(a: *ASMCtx) -> *Vec[u8] {
  return a.out[a.sec as usize];
}

fn sym_get(a: *ASMCtx, name: string, define: bool) -> *ASym {
  let s: *ASym = am_get(a.by_name, name);
  if s != null {
    return s;
  }
  if !define {
    return null;
  }
  let ns: *ASym = new ASym { name: name, sec: a.sec, off: a_cur(a).n as u64, defined: false };
  a.syms.push(ns);
  am_put(a.by_name, name, ns);
  return ns;
}

fn a_fixup(a: *ASMCtx, kind: i32, sym: string) {
  a.fixes.push(new AFix { sec: a.sec, at: a_cur(a).n as u64, kind: kind, sym: sym });
}

fn asm_hexv(c: u8) -> i32 {
  if c >= 48 && c <= 57 {
    return (c - 48) as i32;
  }
  if c >= 97 && c <= 102 {
    return (c - 97) as i32 + 10;
  }
  if c >= 65 && c <= 70 {
    return (c - 65) as i32 + 10;
  }
  return 0 - 1;
}

struct AImm { ok: bool, v: i64 }

// accepts an optional immediate marker (# arm64, $ AT&T), a sign, and
// decimal or 0x hex digits
fn asm_parse_imm(s_in: string) -> *AImm {
  let s: string = s_in;
  let mut i: usize = 0;
  let n: usize = len(s);
  if i < n && (s[i] == 35 || s[i] == 36) { // '#' '$'
    i += 1;
  }
  let mut neg: bool = false;
  if i < n && s[i] == 45 { // '-'
    neg = true;
    i += 1;
  }
  if i >= n {
    return new AImm { ok: false, v: 0 };
  }
  let mut v: i64 = 0;
  if i + 1 < n && s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88) { // 0x 0X
    i += 2;
    let mut any: bool = false;
    while i < n {
      let hv: i32 = asm_hexv(s[i]);
      if hv < 0 {
        break;
      }
      v = v * 16 + hv as i64;
      i += 1;
      any = true;
    }
    if !any {
      return new AImm { ok: false, v: 0 };
    }
  } else {
    let mut any: bool = false;
    while i < n && s[i] >= 48 && s[i] <= 57 {
      v = v * 10 + (s[i] - 48) as i64;
      i += 1;
      any = true;
    }
    if !any {
      return new AImm { ok: false, v: 0 };
    }
  }
  if i != n {
    return new AImm { ok: false, v: 0 };
  }
  if neg {
    v = 0 - v;
  }
  return new AImm { ok: true, v: v };
}

// leading-run atoi for directive arguments ("16", "2")
fn asm_atoi(s: string) -> i32 {
  let mut i: usize = 0;
  let n: usize = len(s);
  let mut neg: bool = false;
  while i < n && (s[i] == 32 || s[i] == 9) {
    i += 1;
  }
  if i < n && s[i] == 45 {
    neg = true;
    i += 1;
  }
  let mut v: i32 = 0;
  while i < n && s[i] >= 48 && s[i] <= 57 {
    v = v * 10 + (s[i] - 48) as i32;
    i += 1;
  }
  if neg {
    return 0 - v;
  }
  return v;
}

// index of needle in hay at/after `from`, -1 when absent
fn str_index_from(hay: string, needle: string, from: usize) -> i64 {
  let hn: usize = len(hay);
  let nn: usize = len(needle);
  if nn == 0 {
    return from as i64;
  }
  let mut i: usize = from;
  while i + nn <= hn {
    let mut k: usize = 0;
    let mut eq: bool = true;
    while k < nn {
      if hay[i + k] != needle[k] {
        eq = false;
        k = nn;
      }
      k += 1;
    }
    if eq {
      return i as i64;
    }
    i += 1;
  }
  return (0 - 1) as i64;
}

fn str_starts(s: string, prefix: string) -> bool {
  if len(s) < len(prefix) {
    return false;
  }
  return streq(s[0..len(prefix)], prefix);
}

fn str_ends_byte(s: string, last: u8) -> bool {
  return len(s) > 0 && s[len(s) - 1] == last;
}

// split on '\n' (strtok_r semantics: empty lines skipped)
fn asm_split_lines(text: string) -> *Vec[string] {
  let out: *Vec[string] = new Vec[string] { items: make([]string, 256), n: 0 };
  let n: usize = len(text);
  let mut start: usize = 0;
  let mut i: usize = 0;
  while i <= n {
    if i == n || text[i] == 10 {
      if i > start {
        out.push(text[start..i]);
      }
      start = i + 1;
    }
    i += 1;
  }
  return out;
}

// `//` starts a comment only outside a quoted payload: .ascii lines carry
// string bytes that may themselves contain `//` (the embedded prelude is
// full of line comments) and must survive the comment strip verbatim
fn asm_line_comment(line: string) -> i64 {
  let mut in_str: bool = false;
  let n: usize = len(line);
  let mut i: usize = 0;
  while i < n {
    let c: u8 = line[i];
    if in_str {
      if c == 92 {
        i += 2;
        continue;
      }
      if c == 34 {
        in_str = false;
      }
    } else if c == 34 {
      in_str = true;
    } else if c == 47 && i + 1 < n && line[i + 1] == 47 {
      return i as i64;
    }
    i += 1;
  }
  return -1;
}

// strip a `//` comment, then leading spaces/tabs
fn asm_prepare(line: string) -> string {
  let mut s: string = line;
  let cut: i64 = asm_line_comment(s);
  if cut >= 0 {
    s = s[0..cut as usize];
  }
  let mut i: usize = 0;
  while i < len(s) && (s[i] == 32 || s[i] == 9) {
    i += 1;
  }
  return s[i..len(s)];
}

// splits the mnemonic off the first operand, then the rest on top-level
// commas; bracketed groups and quoted strings keep their commas
fn asm_split_ops(line: string) -> *Vec[string] {
  let ops: *Vec[string] = new Vec[string] { items: make([]string, 8), n: 0 };
  let n: usize = len(line);
  let mut p: usize = 0;
  while p < n && (line[p] == 32 || line[p] == 9) {
    p += 1;
  }
  if p >= n {
    return ops;
  }
  let mn_start: usize = p;
  while p < n && line[p] != 32 && line[p] != 9 {
    p += 1;
  }
  ops.push(line[mn_start..p]);
  while p < n && (line[p] == 32 || line[p] == 9) {
    p += 1;
  }
  while p < n && ops.n < 8 {
    let op_start: usize = p;
    let mut in_br: bool = false;
    let mut in_str: bool = false;
    while p < n {
      let c: u8 = line[p];
      if c == 34 { // '"'
        in_str = !in_str;
      } else if !in_str && c == 91 { // '['
        in_br = true;
      } else if !in_str && c == 93 { // ']'
        in_br = false;
      } else if !in_str && !in_br && c == 44 { // ','
        break;
      }
      p += 1;
    }
    ops.push(line[op_start..p]);
    if p < n && line[p] == 44 {
      p += 1;
    }
    while p < n && (line[p] == 32 || line[p] == 9) {
      p += 1;
    }
  }
  return ops;
}

// vaddr of an offset inside a section under the final image layout: text
// at base, strings 8-aligned after text (same page), data on its own page
struct ALayout { str_a: u64, data_a: u64, heap_a: u64 }

fn a_sec_vaddr(a: *ASMCtx, ly: *ALayout, sec: i32, off: u64) -> u64 {
  if sec == 0 {
    return a.base + off;
  }
  if sec == 1 {
    return ly.str_a + off;
  }
  return ly.data_a + off;
}

// ---- arm64 assembler (asm64.c port) ---------------------------------------

static mut RC_X: i32 = 0;
static mut RC_W: i32 = 1;
static mut RC_SP: i32 = 2;
static mut RC_VS: i32 = 3;
static mut RC_VD: i32 = 4;
static mut RC_NONE: i32 = 5;

struct AReg { cls: i32, n: i32 }

fn ar_reg(cls: i32, n: i32) -> *AReg {
  return new AReg { cls: cls, n: n };
}

fn ar_parse_reg(s: string) -> *AReg {
  if streq(s, "sp") {
    return ar_reg(RC_SP, 31);
  }
  if streq(s, "xzr") {
    return ar_reg(RC_X, 31);
  }
  if len(s) >= 2 {
    let c0: u8 = s[0];
    let c1: u8 = s[1];
    if c1 >= 48 && c1 <= 57 {
      let num: i32 = asm_atoi(s[1..len(s)]);
      if num <= 30 {
        if c0 == 120 { return ar_reg(RC_X, num); }  // 'x'
        if c0 == 119 { return ar_reg(RC_W, num); }  // 'w'
        if c0 == 115 { return ar_reg(RC_VS, num); } // 's'
        if c0 == 100 { return ar_reg(RC_VD, num); } // 'd'
      }
    }
  }
  return ar_reg(RC_NONE, 0);
}

fn ar_cond_code(s: string) -> i32 {
  // ARM condition codes; hs/lo are aliases of cs/cc
  if streq(s, "eq") { return 0; }
  if streq(s, "ne") { return 1; }
  if streq(s, "cs") { return 2; }
  if streq(s, "cc") { return 3; }
  if streq(s, "mi") { return 4; }
  if streq(s, "pl") { return 5; }
  if streq(s, "vs") { return 6; }
  if streq(s, "vc") { return 7; }
  if streq(s, "hi") { return 8; }
  if streq(s, "ls") { return 9; }
  if streq(s, "ge") { return 10; }
  if streq(s, "lt") { return 11; }
  if streq(s, "gt") { return 12; }
  if streq(s, "le") { return 13; }
  if streq(s, "hs") { return 2; }
  if streq(s, "lo") { return 3; }
  return 0 - 1;
}

// strip an @PAGE/@PAGEOFF marker from a symbol reference
fn ar_sym_ref(s: string) -> string {
  let at: i64 = str_index_from(s, "@PAGE", 0);
  if at >= 0 {
    return s[0..at as usize];
  }
  return s;
}

fn ar_addsub_imm(a: *ASMCtx, is_sub_in: bool, set: bool, rd: *AReg, rn: *AReg, imm_in: i64, mn: string) {
  let mut is_sub: bool = is_sub_in;
  let mut imm: i64 = imm_in;
  if imm < 0 { // the emitter prints negative immediates; flip add/sub
    is_sub = !is_sub;
    imm = 0 - imm;
  }
  if imm > 4095 {
    asm_err(a, cat3(mn, cat3(" immediate out of range: ", itoa(imm), ""), ""));
    return;
  }
  let mut base: u32 = 0;
  if rd.cls == RC_W { // sp always rides the 64-bit form
    base = if is_sub { if set { 0x71000000 } else { 0x51000000 } } else { if set { 0x31000000 } else { 0x11000000 } };
  } else {
    base = if is_sub { if set { 0xF1000000 } else { 0xD1000000 } } else { if set { 0xB1000000 } else { 0x91000000 } };
  }
  let rn_enc: u32 = if rn.cls == RC_SP { 31 } else { rn.n as u32 };
  let rd_enc: u32 = if rd.cls == RC_SP { 31 } else { rd.n as u32 };
  a_emit32(a, base | ((imm as u32) << 10) | (rn_enc << 5) | rd_enc);
}

fn ar_addsub_reg(a: *ASMCtx, is_sub: bool, set: bool, rd: *AReg, rn: *AReg, rm: *AReg) {
  let base: u32 = if rd.cls == RC_X {
    if is_sub { if set { 0xEB000000 } else { 0xCB000000 } } else { if set { 0xAB000000 } else { 0x8B000000 } }
  } else {
    if is_sub { if set { 0x6B000000 } else { 0x4B000000 } } else { if set { 0x2B000000 } else { 0x0B000000 } }
  };
  let rn_enc: u32 = if rn.cls == RC_SP { 31 } else { rn.n as u32 };
  let rd_enc: u32 = if rd.cls == RC_SP { 31 } else { rd.n as u32 };
  a_emit32(a, base | ((rm.n as u32) << 16) | (rn_enc << 5) | rd_enc);
}

fn ar_movz(a: *ASMCtx, rd: *AReg, imm: i64, hw: i32) {
  let maxhw: i32 = if rd.cls == RC_X { 3 } else { 1 };
  if imm < 0 || imm > 65535 || hw < 0 || hw > maxhw {
    asm_err(a, cat3("movz/movk out of range: ", itoa(imm), ""));
    return;
  }
  let base: u32 = if rd.cls == RC_X { 0xD2800000 } else { 0x52800000 };
  a_emit32(a, base | ((hw as u32) << 21) | ((imm as u32) << 5) | (rd.n as u32));
}

fn ar_movk(a: *ASMCtx, rd: *AReg, imm: i64, hw: i32) {
  let maxhw: i32 = if rd.cls == RC_X { 3 } else { 1 };
  if imm < 0 || imm > 65535 || hw < 0 || hw > maxhw {
    asm_err(a, cat3("movk out of range: ", itoa(imm), ""));
    return;
  }
  let base: u32 = if rd.cls == RC_X { 0xF2800000 } else { 0x72800000 };
  a_emit32(a, base | ((hw as u32) << 21) | ((imm as u32) << 5) | (rd.n as u32));
}

// loads/stores, unsigned-offset [Xn] forms (imm12 = 0)
fn ar_mem(a: *ASMCtx, base: u32, rt: *AReg, rn: *AReg) {
  a_emit32(a, base | ((rn.n as u32) << 5) | (rt.n as u32));
}

fn ar_pair(a: *ASMCtx, load: bool, post: bool, rt: *AReg, rt2: *AReg, rn: *AReg, imm: i64) {
  if imm % 8 != 0 || imm > 240 || imm + 256 < 0 {
    asm_err(a, cat3("stp/ldp offset out of range: ", itoa(imm), ""));
    return;
  }
  let imm7: u32 = ((imm / 8) as u32) & 0x7F;
  let base: u32 = if load {
    if post { 0xA8C00000 } else { 0xA9C00000 }
  } else {
    if post { 0xA8800000 } else { 0xA9800000 }
  };
  a_emit32(a, base | (imm7 << 15) | ((rt2.n as u32) << 10) | ((rn.n as u32) << 5) | (rt.n as u32));
}

fn ar_dprec2(a: *ASMCtx, opcode6: u32, rd: *AReg, rn: *AReg, rm: *AReg) {
  a_emit32(a, 0x9AC00000 | ((rm.n as u32) << 16) | (opcode6 << 10) | ((rn.n as u32) << 5) | (rd.n as u32));
}

fn ar_dprec3(a: *ASMCtx, msub: bool, rd: *AReg, rn: *AReg, rm: *AReg, ra: *AReg) {
  let base: u32 = 0x9B000000 | ((if msub { 0x8000 } else { 0 }) as u32);
  a_emit32(a, base | ((rm.n as u32) << 16) | ((ra.n as u32) << 10) | ((rn.n as u32) << 5) | (rd.n as u32));
}

// FP data-processing: opcode FMUL=0 FDIV=1 FADD=2 FSUB=3
fn ar_fp3(a: *ASMCtx, opcode: u32, rd: *AReg, rn: *AReg, rm: *AReg) {
  let word: u32 = 0x1E000000 | ((if rd.cls == RC_VD { 1 << 22 } else { 0 }) as u32) | (1 << 21) |
                  ((rm.n as u32) << 16) | (opcode << 12) | (1 << 11) | ((rn.n as u32) << 5) | (rd.n as u32);
  a_emit32(a, word);
}

fn ar_asm_line(a: *ASMCtx, mn: string, ops: []string) {
  let nops: i32 = len(ops) as i32;
  if str_starts(mn, "b.") { // b.cond
    let cond: i32 = ar_cond_code(mn[2..len(mn)]);
    if cond < 0 || nops != 1 {
      asm_err(a, "bad b.cond");
      return;
    }
    let s: *ASym = sym_get(a, ops[0], true);
    a_fixup(a, FIX_BC19, s.name);
    a_emit32(a, 0x54000000 | (cond as u32));
    return;
  }
  if streq(mn, "adrp") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    if rd.cls != RC_X {
      asm_err(a, "bad adrp");
      return;
    }
    let s: *ASym = sym_get(a, ar_sym_ref(ops[1]), true);
    a_fixup(a, FIX_ADRP, s.name);
    a_emit32(a, 0x90000000 | (rd.n as u32));
    return;
  }
  if (streq(mn, "add") || streq(mn, "sub")) && nops == 3 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    let is_sub: bool = mn[0] == 115; // 's'
    let o2: string = ops[2];
    if len(o2) > 0 && o2[0] == 35 { // '#'
      let imm: *AImm = asm_parse_imm(o2);
      if !imm.ok {
        asm_err(a, cat("bad ", cat3(mn, " immediate", "")));
        return;
      }
      ar_addsub_imm(a, is_sub, false, rd, rn, imm.v, mn);
    } else if str_index_from(o2, "@", 0) >= 0 || ar_parse_reg(o2).cls == RC_NONE {
      // @PAGEOFF marker (mac dialect) or a bare symbol (ELF dialect):
      // the low page half of a page-relative address
      if is_sub || rd.cls != RC_X {
        asm_err(a, "bad pageoff add");
        return;
      }
      let s: *ASym = sym_get(a, ar_sym_ref(o2), true);
      a_fixup(a, FIX_ADDPAGE, s.name);
      a_emit32(a, 0x91000000 | ((rn.n as u32) << 5) | (rd.n as u32));
    } else {
      ar_addsub_reg(a, is_sub, false, rd, rn, ar_parse_reg(o2));
    }
    return;
  }
  if streq(mn, "cmp") && nops == 2 {
    let rn: *AReg = ar_parse_reg(ops[0]);
    let xzr: *AReg = ar_reg(RC_X, 31);
    let o1: string = ops[1];
    if len(o1) > 0 && o1[0] == 35 {
      let imm: *AImm = asm_parse_imm(o1);
      ar_addsub_imm(a, true, true, xzr, rn, imm.v, mn);
    } else {
      ar_addsub_reg(a, true, true, xzr, rn, ar_parse_reg(o1));
    }
    return;
  }
  if streq(mn, "subs") && nops == 3 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    let o2: string = ops[2];
    if len(o2) > 0 && o2[0] == 35 {
      let imm: *AImm = asm_parse_imm(o2);
      ar_addsub_imm(a, true, true, rd, rn, imm.v, mn);
    } else {
      ar_addsub_reg(a, true, true, rd, rn, ar_parse_reg(o2));
    }
    return;
  }
  if streq(mn, "cset") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let cond: i32 = ar_cond_code(ops[1]);
    if rd.cls != RC_X || cond < 0 {
      asm_err(a, "bad cset");
      return;
    }
    // CSET Xd, cond = CSINC Xd, XZR, XZR, cond^1
    a_emit32(a, 0x9A9F07E0 | (((cond ^ 1) as u32) << 12) | (rd.n as u32));
    return;
  }
  if (streq(mn, "cbz") || streq(mn, "cbnz")) && nops == 2 {
    let rt: *AReg = ar_parse_reg(ops[0]);
    let s: *ASym = sym_get(a, ops[1], true);
    a_fixup(a, FIX_CB19, s.name);
    let nz: bool = mn[2] == 110; // 'n'
    let base: u32 = if rt.cls == RC_X {
      if nz { 0xB5000000 } else { 0xB4000000 }
    } else {
      if nz { 0x35000000 } else { 0x34000000 }
    };
    a_emit32(a, base | (rt.n as u32));
    return;
  }
  if streq(mn, "b") && nops == 1 {
    let s: *ASym = sym_get(a, ops[0], true);
    a_fixup(a, FIX_B26, s.name);
    a_emit32(a, 0x14000000);
    return;
  }
  if streq(mn, "bl") && nops == 1 {
    let s: *ASym = sym_get(a, ops[0], true);
    a_fixup(a, FIX_BL26, s.name);
    a_emit32(a, 0x94000000);
    return;
  }
  if streq(mn, "blr") && nops == 1 {
    let rn: *AReg = ar_parse_reg(ops[0]);
    a_emit32(a, 0xD63F0000 | ((rn.n as u32) << 5));
    return;
  }
  if streq(mn, "ret") && nops == 0 {
    a_emit32(a, 0xD65F03C0);
    return;
  }
  if streq(mn, "svc") && nops == 1 {
    let imm: *AImm = asm_parse_imm(ops[0]);
    a_emit32(a, 0xD4000001 | ((imm.v as u32) << 5));
    return;
  }
  if streq(mn, "mov") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let o1: string = ops[1];
    if len(o1) > 0 && o1[0] == 35 {
      let imm: *AImm = asm_parse_imm(o1);
      ar_movz(a, rd, imm.v, 0);
    } else if rd.cls == RC_SP || streq(o1, "sp") {
      // mov SP, Xn / mov Xd, SP — the ADD-immediate #0 form
      ar_addsub_imm(a, false, false, rd, ar_parse_reg(o1), 0, "mov");
    } else {
      let rm: *AReg = ar_parse_reg(o1);
      let base: u32 = if rd.cls == RC_X { 0xAA000000 } else { 0x2A000000 };
      a_emit32(a, base | ((rm.n as u32) << 16) | (31 << 5) | (rd.n as u32)); // ORR Xd, XZR, Xm
    }
    return;
  }
  if streq(mn, "movz") && nops == 2 {
    let imm: *AImm = asm_parse_imm(ops[1]);
    ar_movz(a, ar_parse_reg(ops[0]), imm.v, 0);
    return;
  }
  if streq(mn, "movk") && (nops == 2 || nops == 3) {
    let imm: *AImm = asm_parse_imm(ops[1]);
    let mut hw: i32 = 0;
    if nops == 3 && str_starts(ops[2], "lsl") {
      hw = asm_atoi(ops[2][3..len(ops[2])]) / 16;
    }
    ar_movk(a, ar_parse_reg(ops[0]), imm.v, hw);
    return;
  }
  if (streq(mn, "stp") || streq(mn, "ldp")) && nops >= 3 {
    let load: bool = mn[0] == 108; // 'l'
    let rt: *AReg = ar_parse_reg(ops[0]);
    let rt2: *AReg = ar_parse_reg(ops[1]);
    let sp: *AReg = ar_reg(RC_SP, 31);
    if nops == 3 && str_starts(ops[2], "[sp, ") { // pre-index [sp, #-N]!
      let imm_s_full: string = ops[2][5..len(ops[2])];
      let close: i64 = str_index_from(imm_s_full, "]", 0);
      let mut imm_s: string = imm_s_full;
      if close >= 0 {
        imm_s = imm_s_full[0..close as usize];
      }
      let imm: *AImm = asm_parse_imm(imm_s);
      if imm.ok {
        ar_pair(a, load, false, rt, rt2, sp, imm.v);
        return;
      }
    } else if nops == 4 && streq(ops[2], "[sp]") { // post-index [sp], #N
      let imm: *AImm = asm_parse_imm(ops[3]);
      if imm.ok {
        ar_pair(a, load, true, rt, rt2, sp, imm.v);
        return;
      }
    }
    asm_err(a, cat("bad ", cat3(mn, " addressing", "")));
    return;
  }
  if streq(mn, "mul") && nops == 3 {
    let xzr: *AReg = ar_reg(RC_X, 31);
    ar_dprec3(a, false, ar_parse_reg(ops[0]), ar_parse_reg(ops[1]),
              ar_parse_reg(ops[2]), xzr);
    return;
  }
  if streq(mn, "msub") && nops == 4 {
    ar_dprec3(a, true, ar_parse_reg(ops[0]), ar_parse_reg(ops[1]),
              ar_parse_reg(ops[2]), ar_parse_reg(ops[3]));
    return;
  }
  if (streq(mn, "sdiv") || streq(mn, "udiv")) && nops == 3 {
    ar_dprec2(a, if streq(mn, "sdiv") { 0x03 } else { 0x02 },
              ar_parse_reg(ops[0]), ar_parse_reg(ops[1]), ar_parse_reg(ops[2]));
    return;
  }
  if (streq(mn, "lslv") || streq(mn, "lsrv") || streq(mn, "asrv")) && nops == 3 {
    let op: u32 = if streq(mn, "lslv") { 0x08 } else { if streq(mn, "lsrv") { 0x09 } else { 0x0A } };
    ar_dprec2(a, op, ar_parse_reg(ops[0]), ar_parse_reg(ops[1]), ar_parse_reg(ops[2]));
    return;
  }
  if (streq(mn, "and") || streq(mn, "orr") || streq(mn, "eor")) && nops == 3 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    let rm: *AReg = ar_parse_reg(ops[2]);
    let opc: i32 = if streq(mn, "and") { 0 } else { if streq(mn, "orr") { 1 } else { 2 } };
    let mut base: u32 = if rd.cls == RC_X { 0x8A000000 } else { 0x0A000000 };
    base |= (((opc >> 1) as u32) << 30) | (((opc & 1) as u32) << 29);
    a_emit32(a, base | ((rm.n as u32) << 16) | ((rn.n as u32) << 5) | (rd.n as u32));
    return;
  }
  if streq(mn, "neg") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rm: *AReg = ar_parse_reg(ops[1]);
    let base: u32 = if rd.cls == RC_X { 0xCB0003E0 } else { 0x4B0003E0 };
    a_emit32(a, base | ((rm.n as u32) << 16) | (rd.n as u32));
    return;
  }
  if streq(mn, "sxtw") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    a_emit32(a, 0x93407C00 | ((rn.n as u32) << 5) | (rd.n as u32)); // SBFM Xd, Wn, #0, #31
    return;
  }
  if streq(mn, "uxtw") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    a_emit32(a, 0xD3407C00 | ((rn.n as u32) << 5) | (rd.n as u32)); // UBFM Xd, Wn, #0, #31
    return;
  }
  if streq(mn, "uxtb") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    a_emit32(a, 0x53001C00 | ((rn.n as u32) << 5) | (rd.n as u32)); // UBFM Wd, Wn, #0, #7
    return;
  }
  if (streq(mn, "fadd") || streq(mn, "fsub") || streq(mn, "fmul") || streq(mn, "fdiv")) && nops == 3 {
    let opcode: u32 = if streq(mn, "fmul") { 0 } else { if streq(mn, "fdiv") { 1 } else { if streq(mn, "fadd") { 2 } else { 3 } } };
    ar_fp3(a, opcode, ar_parse_reg(ops[0]), ar_parse_reg(ops[1]), ar_parse_reg(ops[2]));
    return;
  }
  if streq(mn, "fcmp") && nops == 2 {
    let rn: *AReg = ar_parse_reg(ops[0]);
    let rm: *AReg = ar_parse_reg(ops[1]);
    let base: u32 = 0x1E202000 | ((if rn.cls == RC_VD { 1 << 22 } else { 0 }) as u32);
    a_emit32(a, base | ((rm.n as u32) << 16) | ((rn.n as u32) << 5));
    return;
  }
  if streq(mn, "fcvt") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    if rd.cls == RC_VD && rn.cls == RC_VS {
      a_emit32(a, 0x1E22C000 | ((rn.n as u32) << 5) | (rd.n as u32)); // S -> D
    } else if rd.cls == RC_VS && rn.cls == RC_VD {
      a_emit32(a, 0x1E62C000 | ((rn.n as u32) << 5) | (rd.n as u32)); // D -> S
    } else {
      asm_err(a, "bad fcvt");
    }
    return;
  }
  if streq(mn, "fcvtzs") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    a_emit32(a, (if rd.cls == RC_X { 0x9E780000 } else { 0x1E780000 }) | ((rn.n as u32) << 5) | (rd.n as u32));
    return;
  }
  if (streq(mn, "scvtf") || streq(mn, "ucvtf")) && nops == 2 {
    // the emitter always converts from x8: D dest rides sf=1, S dest sf=0
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    if rn.cls != RC_X || (rd.cls != RC_VD && rd.cls != RC_VS) {
      asm_err(a, cat("bad ", cat3(mn, "", "")));
      return;
    }
    let mut base: u32 = 0x9E220000;
    if streq(mn, "ucvtf") {
      base = 0x9E230000;
    }
    if rd.cls == RC_VS {
      base = base & 0x7FFFFFFF;
    }
    a_emit32(a, base | ((rn.n as u32) << 5) | (rd.n as u32));
    return;
  }
  if (streq(mn, "scvtf") || streq(mn, "ucvtf")) && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    // the emitter always converts from x8: D dest rides sf=1, S dest sf=0
    if rn.cls != RC_X || (rd.cls != RC_VD && rd.cls != RC_VS) {
      asm_err(a, cat3("bad ", mn, ""));
      return;
    }
    let base: u32 = if streq(mn, "scvtf") {
      if rd.cls == RC_VD { 0x9E220000 } else { 0x1E220000 }
    } else {
      if rd.cls == RC_VD { 0x9E230000 } else { 0x1E230000 }
    };
    a_emit32(a, base | ((rn.n as u32) << 5) | (rd.n as u32));
    return;
  }
  if streq(mn, "fmov") && nops == 2 {
    let rd: *AReg = ar_parse_reg(ops[0]);
    let rn: *AReg = ar_parse_reg(ops[1]);
    if rd.cls == RC_X && rn.cls == RC_VD {
      a_emit32(a, 0x9E660000 | ((rn.n as u32) << 5) | (rd.n as u32));
    } else if rd.cls == RC_VD && rn.cls == RC_X {
      a_emit32(a, 0x9E670000 | ((rn.n as u32) << 5) | (rd.n as u32));
    } else if rd.cls == RC_VS && rn.cls == RC_W {
      a_emit32(a, 0x1E270000 | ((rn.n as u32) << 5) | (rd.n as u32));
    } else if rd.cls == RC_W && rn.cls == RC_VS {
      a_emit32(a, 0x1E660000 | ((rn.n as u32) << 5) | (rd.n as u32)); // fmov wd, sn — f32 bits
    } else {
      asm_err(a, "bad fmov");
    }
    return;
  }

  // loads/stores — mnemonic plus register class pick the encoding row
  {
    let rt: *AReg = ar_parse_reg(ops[0]);
    let src: string = ops[1];
    let mut matched: bool = true;
    let mut base: u32 = 0;
    if streq(mn, "str") && rt.cls == RC_X { base = 0xF9000000; }
    else if streq(mn, "ldr") && rt.cls == RC_X { base = 0xF9400000; }
    else if streq(mn, "str") && rt.cls == RC_W { base = 0xB9000000; }
    else if streq(mn, "ldr") && rt.cls == RC_W { base = 0xB9400000; }
    else if streq(mn, "str") && rt.cls == RC_VS { base = 0xBD000000; }
    else if streq(mn, "ldr") && rt.cls == RC_VS { base = 0xBD400000; }
    else if streq(mn, "str") && rt.cls == RC_VD { base = 0xFD000000; }
    else if streq(mn, "ldr") && rt.cls == RC_VD { base = 0xFD400000; }
    else if streq(mn, "strb") && rt.cls == RC_W { base = 0x39000000; }
    else if streq(mn, "ldrb") && rt.cls == RC_W { base = 0x39400000; }
    else if streq(mn, "strh") && rt.cls == RC_W { base = 0x79000000; }
    else if streq(mn, "ldrh") && rt.cls == RC_W { base = 0x79400000; }
    else if streq(mn, "ldrsb") && rt.cls == RC_X { base = 0x39800000; }
    else if streq(mn, "ldrsh") && rt.cls == RC_X { base = 0x79800000; }
    else if streq(mn, "ldrsw") && rt.cls == RC_X { base = 0xB9800000; }
    else { matched = false; }
    if matched {
      if len(src) == 0 || src[0] != 91 { // '['
        asm_err(a, cat("bad ", cat3(mn, " addressing", "")));
        return;
      }
      let rn: *AReg = ar_parse_reg(src[1..len(src)]);
      ar_mem(a, base, rt, rn);
      return;
    }
  }

  asm_err(a, cat("unknown instruction `", cat3(mn, "'", "")));
}

// ---- amd64 assembler (asm86.c port) ---------------------------------------

static mut R86_8: i32 = 0;
static mut R86_16: i32 = 1;
static mut R86_32: i32 = 2;
static mut R86_64: i32 = 3;
static mut R86_XMM: i32 = 4;
static mut R86_NONE: i32 = 5;

struct MReg { cls: i32, n: i32 }

fn mreg(cls: i32, n: i32) -> *MReg {
  return new MReg { cls: cls, n: n };
}

fn m_parse_reg(s_in: string) -> *MReg {
  let mut s: string = s_in;
  if len(s) == 0 {
    return mreg(R86_NONE, 0);
  }
  if s[0] == 37 { // '%'
    s = s[1..len(s)];
  }
  if len(s) == 0 {
    return mreg(R86_NONE, 0);
  }
  if s[0] == 114 && len(s) > 1 && s[1] >= 48 && s[1] <= 57 { // 'r'
    let num: i32 = asm_atoi(s[1..len(s)]);
    if num >= 8 && num <= 15 {
      let mut di: usize = 1;
      while di < len(s) && s[di] >= 48 && s[di] <= 57 {
        di += 1;
      }
      if di == len(s) {
        return mreg(R86_64, num);
      }
      let sfx: string = s[di..len(s)];
      if streq(sfx, "d") { return mreg(R86_32, num); }
      if streq(sfx, "w") { return mreg(R86_16, num); }
      if streq(sfx, "b") { return mreg(R86_8, num); }
    }
    return mreg(R86_NONE, 0);
  }
  if streq(s, "rax") { return mreg(R86_64, 0); }
  if streq(s, "rcx") { return mreg(R86_64, 1); }
  if streq(s, "rdx") { return mreg(R86_64, 2); }
  if streq(s, "rbx") { return mreg(R86_64, 3); }
  if streq(s, "rsp") { return mreg(R86_64, 4); }
  if streq(s, "rbp") { return mreg(R86_64, 5); }
  if streq(s, "rsi") { return mreg(R86_64, 6); }
  if streq(s, "rdi") { return mreg(R86_64, 7); }
  if streq(s, "eax") { return mreg(R86_32, 0); }
  if streq(s, "ecx") { return mreg(R86_32, 1); }
  if streq(s, "edx") { return mreg(R86_32, 2); }
  if streq(s, "ebx") { return mreg(R86_32, 3); }
  if streq(s, "esp") { return mreg(R86_32, 4); }
  if streq(s, "ebp") { return mreg(R86_32, 5); }
  if streq(s, "esi") { return mreg(R86_32, 6); }
  if streq(s, "edi") { return mreg(R86_32, 7); }
  if streq(s, "ax") { return mreg(R86_16, 0); }
  if streq(s, "cx") { return mreg(R86_16, 1); }
  if streq(s, "dx") { return mreg(R86_16, 2); }
  if streq(s, "bx") { return mreg(R86_16, 3); }
  if streq(s, "sp") { return mreg(R86_16, 4); }
  if streq(s, "bp") { return mreg(R86_16, 5); }
  if streq(s, "si") { return mreg(R86_16, 6); }
  if streq(s, "di") { return mreg(R86_16, 7); }
  if streq(s, "al") { return mreg(R86_8, 0); }
  if streq(s, "cl") { return mreg(R86_8, 1); }
  if streq(s, "dl") { return mreg(R86_8, 2); }
  if streq(s, "bl") { return mreg(R86_8, 3); }
  if streq(s, "spl") { return mreg(R86_8, 4); }
  if streq(s, "bpl") { return mreg(R86_8, 5); }
  if streq(s, "sil") { return mreg(R86_8, 6); }
  if streq(s, "dil") { return mreg(R86_8, 7); }
  if str_starts(s, "xmm") && len(s) == 4 && s[3] >= 48 && s[3] <= 55 {
    return mreg(R86_XMM, (s[3] - 48) as i32);
  }
  return mreg(R86_NONE, 0);
}

// memory operand: `disp(%reg)' / `(%reg)' / `sym(%rip)'
struct AMem {
  has: bool,
  rip: bool,
  ripsym: string,
  disp: i64,
  base: *MReg,
}

fn mem_none() -> *AMem {
  return new AMem { has: false, rip: false, ripsym: "", disp: 0, base: mreg(R86_NONE, 0) };
}

fn m_parse_mem(s: string) -> *AMem {
  let m: *AMem = mem_none();
  let lp_i: i64 = str_index_from(s, "(", 0);
  if lp_i < 0 {
    return m;
  }
  let lp: usize = lp_i as usize;
  m.has = true;
  if str_starts(s[lp..len(s)], "(%rip)") {
    m.rip = true;
    m.ripsym = s[0..lp];
    return m;
  }
  let close_i: i64 = str_index_from(s[lp + 1..len(s)], ")", 0);
  if close_i < 0 {
    return mem_none();
  }
  let close: usize = lp + 1 + close_i as usize;
  let disp_s: string = s[0..lp];
  let base_s: string = s[lp + 1..close];
  m.disp = 0;
  if len(disp_s) > 0 {
    let d: *AImm = asm_parse_imm(disp_s);
    if !d.ok {
      return mem_none();
    }
    m.disp = d.v;
  }
  m.base = m_parse_reg(base_s);
  if m.base.cls != R86_64 {
    return mem_none();
  }
  return m;
}

// legacy prefix then REX; REX appears when the operand is 64-bit, any
// register number needs bit 4, or a byte register needs the spl/bpl/sil/dil
// escape
fn m_prefix_rex(a: *ASMCtx, prefix: i32, w: bool, reg: *MReg, rm: *MReg) {
  if prefix != 0 {
    a_emitb(a, prefix);
  }
  let reghi: bool = reg.cls != R86_NONE && reg.n >= 8;
  let rmhi: bool = (rm.cls == R86_64 || rm.cls == R86_32 || rm.cls == R86_16 || rm.cls == R86_8) && rm.n >= 8;
  let b8: bool = (reg.cls == R86_8 && reg.n >= 4) || (rm.cls == R86_8 && rm.n >= 4);
  if w || reghi || rmhi || b8 {
    a_emitb(a, 0x40 | (if w { 8 } else { 0 }) | (if reghi { 4 } else { 0 }) | (if rmhi { 1 } else { 0 }));
  }
}

// ModRM + displacement for a memory rm operand; regfield is the /digit or
// source register. Returns the fixup position for rip-relative operands,
// -1 otherwise.
fn m_modrm_mem(a: *ASMCtx, regfield: i32, m: *AMem) -> i64 {
  if m.rip {
    a_emitb(a, 0x05 | (regfield & 7) << 3); // mod=00 rm=101
    let at: i64 = a_cur(a).n as i64;
    a_emit4(a, 0);
    return at;
  }
  let bn: i32 = m.base.n & 7;
  if m.disp == 0 && bn != 5 { // mod=00 with base; rbp needs a disp (mod00+5 = rip)
    a_emitb(a, (regfield & 7) << 3 | bn);
    return (0 - 1) as i64;
  }
  a_emitb(a, 0x80 | (regfield & 7) << 3 | bn); // mod=10, disp32
  a_emit4(a, (m.disp as i32) as u32);
  return (0 - 1) as i64;
}

// reg-reg ModRM (mod=11), AT&T order: `op %src, %dst`
fn m_modrm_rr(a: *ASMCtx, src: *MReg, dst: *MReg) {
  a_emitb(a, 0xC0 | (src.n & 7) << 3 | (dst.n & 7));
}

// ALU/mov reg<-reg: opcode with reg field = src, rm = dst
fn m_op_rr(a: *ASMCtx, prefix: i32, opc: i32, w: bool, src: *MReg, dst: *MReg) {
  m_prefix_rex(a, prefix, w, src, dst);
  a_emitb(a, opc);
  m_modrm_rr(a, src, dst);
}

// ALU/mov reg<-mem or mem<-reg; the reg operand is the reg field
fn m_op_rm(a: *ASMCtx, prefix: i32, opc: i32, w: bool, reg: *MReg, m: *AMem, riprel: bool) {
  m_prefix_rex(a, prefix, w, reg, mreg(R86_NONE, 0));
  a_emitb(a, opc);
  let at: i64 = m_modrm_mem(a, reg.n, m);
  if riprel && at >= 0 {
    a_fixup(a, FIX_RIPREL, m.ripsym);
  }
}

// immediate group ops (add/or/and/sub/xor/cmp): 83 imm8 / 81 imm32, /digit
fn m_op_imm(a: *ASMCtx, digit: i32, w: bool, imm: i64, rm: *MReg) {
  m_prefix_rex(a, 0, w, mreg(R86_NONE, 0), rm);
  if imm + 128 >= 0 && imm <= 127 {
    a_emitb(a, if w { 0x83 } else { 0x80 });
    a_emitb(a, 0xC0 | digit << 3 | (rm.n & 7));
    a_emitb(a, (imm & 255) as i32);
  } else {
    a_emitb(a, 0x81);
    a_emitb(a, 0xC0 | digit << 3 | (rm.n & 7));
    a_emit4(a, (imm as i32) as u32);
  }
}

// jcc/setcc condition suffix -> low opcode nibble
fn m_cc_op(s: string) -> i32 {
  if streq(s, "o") { return 0; }
  if streq(s, "no") { return 1; }
  if streq(s, "b") { return 2; }
  if streq(s, "ae") { return 3; }
  if streq(s, "e") { return 4; }
  if streq(s, "ne") { return 5; }
  if streq(s, "be") { return 6; }
  if streq(s, "a") { return 7; }
  if streq(s, "s") { return 8; }
  if streq(s, "ns") { return 9; }
  if streq(s, "p") { return 10; }
  if streq(s, "np") { return 11; }
  if streq(s, "l") { return 12; }
  if streq(s, "ge") { return 13; }
  if streq(s, "le") { return 14; }
  if streq(s, "g") { return 15; }
  return 0 - 1;
}

fn m_alu_row(mn: string) -> i32 {
  // row into the ALU tables, -1 when mn is not an ALU op
  if str_starts(mn, "add") { return 0; }
  if str_starts(mn, "sub") { return 1; }
  if str_starts(mn, "and") { return 2; }
  if str_starts(mn, "or") { return 3; }
  if str_starts(mn, "xor") { return 4; }
  if str_starts(mn, "cmp") { return 5; }
  return 0 - 1;
}

fn m_alu_opcm(row: i32) -> i32 {
  // r/m <- r opcode row (0x01 family)
  if row == 0 { return 0x01; }
  if row == 1 { return 0x29; }
  if row == 2 { return 0x21; }
  if row == 3 { return 0x09; }
  if row == 4 { return 0x31; }
  return 0x39; // cmp
}

fn m_alu_opmr(row: i32) -> i32 {
  // r <- r/m opcode row (0x03 family)
  if row == 0 { return 0x03; }
  if row == 1 { return 0x2B; }
  if row == 2 { return 0x23; }
  if row == 3 { return 0x0B; }
  if row == 4 { return 0x33; }
  return 0x3B; // cmp
}

fn m_alu_digit(row: i32) -> i32 {
  if row == 0 { return 0; }
  if row == 1 { return 5; }
  if row == 2 { return 4; }
  if row == 3 { return 1; }
  if row == 4 { return 6; }
  return 7; // cmp
}

fn m_alu_mnlen(row: i32) -> usize {
  if row == 3 { return 2; } // "or"
  return 3;
}

fn m86_asm_line(a: *ASMCtx, mn: string, ops: []string) {
  let nops: i32 = len(ops) as i32;
  // ---- ALU (add/sub/and/or/xor/cmp), AT&T order `op src, dst`;
  // unsuffixed mnemonics only appear for 64-bit pairs ----
  let row: i32 = m_alu_row(mn);
  if row >= 0 {
    let ml: usize = m_alu_mnlen(row);
    let mut sfx: u8 = 0;
    if len(mn) > ml {
      sfx = mn[ml];
    }
    let sfx_ok: bool = sfx == 0 || sfx == 98 || sfx == 119 || sfx == 108 || sfx == 113; // 0 b w l q
    if sfx_ok {
      let w: bool = sfx == 0 || sfx == 113;
      let size: i32 = if sfx == 98 { 1 } else { if sfx == 119 { 2 } else { if sfx == 108 { 4 } else { 8 } } };
      let p66: i32 = if sfx == 119 { 0x66 } else { 0 };
      if nops == 2 {
        let o0: string = ops[0];
        let o1: string = ops[1];
        if len(o0) > 0 && o0[0] == 36 { // '$': the immediate is the source
          let imm: *AImm = asm_parse_imm(o0);
          if !imm.ok {
            asm_err(a, cat("bad ", cat3(mn, " immediate", "")));
            return;
          }
          let rm: *MReg = m_parse_reg(o1);
          if rm.cls != R86_NONE {
            m_op_imm(a, m_alu_digit(row), w, imm.v, rm);
            return;
          }
          let m: *AMem = m_parse_mem(o1);
          if !m.has {
            asm_err(a, cat("bad ", cat3(mn, " operand", "")));
            return;
          }
          // imm -> mem: 80/81/83 /digit by width
          let imm8: bool = imm.v + 128 >= 0 && imm.v <= 127;
          m_prefix_rex(a, 0, w, mreg(R86_NONE, 0), mreg(R86_NONE, 0));
          if size != 1 && imm8 {
            a_emitb(a, 0x83);
            m_modrm_mem(a, m_alu_digit(row), m);
            a_emitb(a, (imm.v & 255) as i32);
          } else {
            a_emitb(a, if size == 1 { 0x80 } else { 0x81 });
            m_modrm_mem(a, m_alu_digit(row), m);
            if size == 1 {
              a_emitb(a, (imm.v & 255) as i32);
            } else {
              a_emit4(a, (imm.v as i32) as u32);
            }
          }
          return;
        }
        // register source first, memory source second — AT&T `op src, dst`
        let src: *MReg = m_parse_reg(o0);
        if src.cls != R86_NONE {
          let dst: *MReg = m_parse_reg(o1);
          if dst.cls != R86_NONE {
            if dst.cls != src.cls {
              asm_err(a, cat3(mn, " size mismatch", ""));
              return;
            }
            m_op_rr(a, p66, if size == 1 { m_alu_opcm(row) - 1 } else { m_alu_opcm(row) }, size == 8, src, dst);
            return;
          }
          let m: *AMem = m_parse_mem(o1);
          if !m.has {
            asm_err(a, cat("bad ", cat3(mn, " operand", "")));
            return;
          }
          m_op_rm(a, p66, if size == 1 { m_alu_opcm(row) - 1 } else { m_alu_opcm(row) }, size == 8, src, m, false);
          return;
        }
        let m: *AMem = m_parse_mem(o0);
        if m.has {
          let dst: *MReg = m_parse_reg(o1);
          if dst.cls != R86_NONE {
            m_op_rm(a, p66, if size == 1 { m_alu_opmr(row) - 1 } else { m_alu_opmr(row) }, size == 8, dst, m, false);
            return;
          }
        }
      }
    }
  }

  // ---- movss / movsd: xmm <-> mem (the rip-relative literal pool rides
  // the load form) ----
  if (streq(mn, "movss") || streq(mn, "movsd")) && nops == 2 {
    let prefix: i32 = if mn[4] == 115 { 0xF3 } else { 0xF2 }; // movss F3, movsd F2
    let mut xm: *MReg = mreg(R86_NONE, 0);
    let mut m: *AMem = mem_none();
    let mut opc: i32 = 0;
    if m_parse_reg(ops[0]).cls == R86_XMM { // `movsd %xmm0, mem` — store
      xm = m_parse_reg(ops[0]);
      m = m_parse_mem(ops[1]);
      opc = 0x11;
    } else { // `movsd mem, %xmm0` — load
      xm = m_parse_reg(ops[1]);
      m = m_parse_mem(ops[0]);
      opc = 0x10;
    }
    if xm.cls != R86_XMM || !m.has {
      asm_err(a, cat("bad ", cat3(mn, " operand", "")));
      return;
    }
    m_prefix_rex(a, prefix, false, xm, mreg(R86_NONE, 0));
    a_emitb(a, 0x0F);
    a_emitb(a, opc);
    let at: i64 = m_modrm_mem(a, xm.n, m);
    if at >= 0 {
      a_fixup(a, FIX_RIPREL, m.ripsym);
    }
    return;
  }

  // ---- movd / movq with an xmm source: exact bit move xmm -> gpr ----
  if (streq(mn, "movd") || streq(mn, "movq")) && nops == 2 && m_parse_reg(ops[0]).cls == R86_XMM {
    let xm: *MReg = m_parse_reg(ops[0]);
    let g: *MReg = m_parse_reg(ops[1]);
    if g.cls != R86_32 && g.cls != R86_64 {
      asm_err(a, cat("bad ", cat3(mn, "", "")));
      return;
    }
    a_emitb(a, 0x66);
    m_prefix_rex(a, 0, g.cls == R86_64, g, xm);
    a_emitb(a, 0x0F);
    a_emitb(a, 0x7E);
    m_modrm_rr(a, xm, g); // MOVQ r/m64, xmm: reg = xmm source, rm = gpr
    return;
  }

  // ---- mov family ----
  if str_starts(mn, "mov") {
    let sfx_s: string = mn[3..len(mn)];
    // 0 b, 1 w, 2 l, 3 q, 4 absq, 5 sbq, 6 swq, 7 slq, 8 zbq, 9 zwq
    let mut sfx: i32 = 0 - 1;
    if streq(sfx_s, "b") { sfx = 0; }
    else if streq(sfx_s, "w") { sfx = 1; }
    else if streq(sfx_s, "l") { sfx = 2; }
    else if streq(sfx_s, "q") { sfx = 3; }
    else if streq(sfx_s, "absq") { sfx = 4; }
    else if streq(sfx_s, "sbq") { sfx = 5; }
    else if streq(sfx_s, "swq") { sfx = 6; }
    else if streq(sfx_s, "slq") { sfx = 7; }
    else if streq(sfx_s, "zbq") { sfx = 8; }
    else if streq(sfx_s, "zwq") { sfx = 9; }
    if sfx < 0 || nops != 2 {
      asm_err(a, cat("unhandled `", cat3(mn, "' operand forms", "")));
      return;
    }

    if sfx == 4 { // movabsq $imm64, reg
      let imm: *AImm = asm_parse_imm(ops[0]);
      let rd: *MReg = m_parse_reg(ops[1]);
      if len(ops[0]) == 0 || ops[0][0] != 36 || rd.cls != R86_64 || !imm.ok {
        asm_err(a, "bad movabsq");
        return;
      }
      m_prefix_rex(a, 0, true, rd, mreg(R86_NONE, 0));
      a_emitb(a, 0xB8 | (rd.n & 7));
      a_emit4(a, (imm.v as i32) as u32);
      a_emit4(a, ((imm.v >> 32) as i32) as u32);
      return;
    }
    if sfx >= 5 { // movsbq/movswq/movslq/movzbq/movzwq r64 <- r/m
      // sbq(0F BE) swq(0F BF) slq(63/movsxd) zbq(0F B6) zwq(0F B7)
      let code: i32 = if sfx == 5 { 0x0FBE } else { if sfx == 6 { 0x0FBF } else { if sfx == 7 { 0x063 } else { if sfx == 8 { 0x0FB6 } else { 0x0FB7 } } } };
      let rd: *MReg = m_parse_reg(ops[1]);
      if rd.cls != R86_64 {
        asm_err(a, "bad movsx/movzx");
        return;
      }
      let opc0: i32 = (code >> 8) & 0xFF;
      let opc1: i32 = code & 0xFF;
      let two: bool = code > 0xFF;
      let rs: *MReg = m_parse_reg(ops[0]);
      if rs.cls != R86_NONE { // reg,reg: reg = dst, rm = src
        m_prefix_rex(a, 0, true, rd, rs);
        if two {
          a_emitb(a, opc0);
        } else {
          a_emitb(a, opc1);
        }
        if two {
          a_emitb(a, opc1);
        }
        m_modrm_rr(a, rd, rs);
        return;
      }
      let m: *AMem = m_parse_mem(ops[0]);
      if !m.has {
        asm_err(a, "bad movsx/movzx operand");
        return;
      }
      m_prefix_rex(a, 0, true, rd, mreg(R86_NONE, 0));
      if two {
        a_emitb(a, opc0);
      }
      a_emitb(a, opc1);
      m_modrm_mem(a, rd.n, m);
      return;
    }
    // plain moves: b/w/l/q; direction and width from the operand classes
    let size: i32 = if sfx == 0 { 1 } else { if sfx == 1 { 2 } else { if sfx == 2 { 4 } else { 8 } } };
    let a0: *MReg = m_parse_reg(ops[0]);
    let a1: *MReg = m_parse_reg(ops[1]);
    if len(ops[0]) > 0 && ops[0][0] == 36 { // immediate source
      let imm: *AImm = asm_parse_imm(ops[0]);
      if a1.cls != R86_NONE { // $imm, reg
        if size == 8 {
          m_prefix_rex(a, 0, true, mreg(R86_NONE, 0), a1);
          a_emitb(a, 0xC7);
          a_emitb(a, 0xC0 | (a1.n & 7));
          a_emit4(a, (imm.v as i32) as u32);
        } else if size == 4 && a1.cls == R86_32 {
          a_emitb(a, 0xB8 | (a1.n & 7));
          a_emit4(a, (imm.v as i32) as u32);
        } else {
          asm_err(a, "bad mov immediate width");
          return;
        }
        return;
      }
      let m: *AMem = m_parse_mem(ops[1]); // $imm, mem — the C7 form is 64-bit only
      if size != 8 || !m.has {
        asm_err(a, "bad mov immediate operand");
        return;
      }
      m_prefix_rex(a, 0, true, mreg(R86_NONE, 0), mreg(R86_NONE, 0));
      a_emitb(a, 0xC7);
      m_modrm_mem(a, 0, m);
      a_emit4(a, (imm.v as i32) as u32);
      return;
    }
    if a1.cls != R86_NONE && a0.cls != R86_NONE { // reg,reg
      if size == 1 {
        m_op_rr(a, 0, 0x88, false, a0, a1);
      } else {
        m_op_rr(a, if size == 2 { 0x66 } else { 0 }, 0x89, size == 8, a0, a1);
      }
      return;
    }
    // reg <-> mem, AT&T: a register in the SOURCE position means a store
    let mut m: *AMem = mem_none();
    let mut to_mem: bool = false;
    let mut r: *MReg = mreg(R86_NONE, 0);
    if a0.cls != R86_NONE { // `movq %reg, mem`
      m = m_parse_mem(ops[1]);
      to_mem = true;
      r = a0;
    } else if a1.cls != R86_NONE { // `movq mem, %reg`
      m = m_parse_mem(ops[0]);
      r = a1;
    }
    if !m.has || r.cls == R86_NONE {
      asm_err(a, "bad mov operand");
      return;
    }
    if to_mem {
      if size == 1 {
        m_op_rm(a, 0, 0x88, false, r, m, false);
      } else {
        m_op_rm(a, if size == 2 { 0x66 } else { 0 }, 0x89, size == 8, r, m, false);
      }
    } else {
      if size == 1 { // byte loads ride movsbq/movzbq, never plain movb
        asm_err(a, "bad movb load");
        return;
      }
      m_op_rm(a, if size == 2 { 0x66 } else { 0 }, 0x8B, size == 8, r, m, false);
    }
    return;
  }

  if streq(mn, "leaq") && nops == 2 {
    let rd: *MReg = m_parse_reg(ops[1]);
    let m: *AMem = m_parse_mem(ops[0]);
    if rd.cls != R86_64 || !m.has {
      asm_err(a, "bad leaq");
      return;
    }
    m_op_rm(a, 0, 0x8D, true, rd, m, true);
    return;
  }

  // ---- multiply / divide ----
  if streq(mn, "imul") && nops == 2 {
    let dst: *MReg = m_parse_reg(ops[1]);
    let src: *MReg = m_parse_reg(ops[0]);
    if dst.cls != R86_64 || src.cls != R86_64 {
      asm_err(a, "bad imul");
      return;
    }
    m_prefix_rex(a, 0, true, dst, src);
    a_emitb(a, 0x0F);
    a_emitb(a, 0xAF);
    m_modrm_rr(a, dst, src);
    return;
  }
  if (streq(mn, "idivq") || streq(mn, "divq")) && nops == 1 {
    let rm: *MReg = m_parse_reg(ops[0]);
    if rm.cls != R86_64 {
      asm_err(a, "bad div");
      return;
    }
    m_prefix_rex(a, 0, true, mreg(R86_NONE, 0), rm);
    a_emitb(a, 0xF7);
    a_emitb(a, 0xC0 | (if streq(mn, "idivq") { 7 } else { 6 }) << 3 | (rm.n & 7));
    return;
  }
  if streq(mn, "cqo") && nops == 0 {
    a_emitb(a, 0x48);
    a_emitb(a, 0x99);
    return;
  }
  if streq(mn, "negq") && nops == 1 {
    let rm: *MReg = m_parse_reg(ops[0]);
    if rm.cls != R86_64 {
      asm_err(a, "bad negq");
      return;
    }
    m_prefix_rex(a, 0, true, mreg(R86_NONE, 0), rm);
    a_emitb(a, 0xF7);
    a_emitb(a, 0xC0 | 3 << 3 | (rm.n & 7));
    return;
  }
  if (streq(mn, "incq") || streq(mn, "decq")) && nops == 1 {
    let rm: *MReg = m_parse_reg(ops[0]);
    if rm.cls != R86_64 {
      asm_err(a, "bad inc/dec");
      return;
    }
    m_prefix_rex(a, 0, true, mreg(R86_NONE, 0), rm);
    a_emitb(a, 0xFF);
    a_emitb(a, 0xC0 | (if streq(mn, "incq") { 0 } else { 1 }) << 3 | (rm.n & 7));
    return;
  }
  if streq(mn, "testq") && nops == 2 {
    let src: *MReg = m_parse_reg(ops[0]);
    let dst: *MReg = m_parse_reg(ops[1]);
    if src.cls != R86_64 || dst.cls != R86_64 {
      asm_err(a, "bad testq");
      return;
    }
    m_op_rr(a, 0, 0x85, true, src, dst);
    return;
  }
  // ---- shifts ----
  if (str_starts(mn, "sal") || str_starts(mn, "shl") || str_starts(mn, "shr") || str_starts(mn, "sar")) && nops == 2 {
    // sal/shl 'l'->4, sar 'r' with 'a' at [1]->7, shr 'r'->5
    let digit: i32 = if mn[2] == 108 { 4 } else { if mn[2] == 114 && mn[1] == 97 { 7 } else { 5 } };
    let rd: *MReg = m_parse_reg(ops[1]);
    if rd.cls != R86_64 {
      asm_err(a, "bad shift");
      return;
    }
    if len(ops[0]) > 0 && ops[0][0] == 36 {
      let imm: *AImm = asm_parse_imm(ops[0]);
      m_prefix_rex(a, 0, true, mreg(R86_NONE, 0), rd);
      a_emitb(a, 0xC1);
      a_emitb(a, 0xC0 | digit << 3 | (rd.n & 7));
      a_emitb(a, (imm.v & 255) as i32);
    } else {
      let cl: *MReg = m_parse_reg(ops[0]);
      if cl.cls != R86_8 || cl.n != 1 {
        asm_err(a, "bad shift count");
        return;
      }
      m_prefix_rex(a, 0, true, mreg(R86_NONE, 0), rd);
      a_emitb(a, 0xD3);
      a_emitb(a, 0xC0 | digit << 3 | (rd.n & 7));
    }
    return;
  }

  // ---- setcc / byte logic ----
  if str_starts(mn, "set") && nops == 1 {
    let cc: i32 = m_cc_op(mn[3..len(mn)]);
    let rd: *MReg = m_parse_reg(ops[0]);
    if cc < 0 || rd.cls != R86_8 {
      asm_err(a, "bad setcc");
      return;
    }
    m_prefix_rex(a, 0, false, mreg(R86_NONE, 0), rd);
    a_emitb(a, 0x0F);
    a_emitb(a, 0x90 | cc);
    a_emitb(a, 0xC0 | (rd.n & 7));
    return;
  }
  if (streq(mn, "andb") || streq(mn, "orb")) && nops == 2 {
    let src: *MReg = m_parse_reg(ops[0]);
    let dst: *MReg = m_parse_reg(ops[1]);
    if src.cls != R86_8 || dst.cls != R86_8 {
      asm_err(a, "bad byte logic");
      return;
    }
    m_op_rr(a, 0, if streq(mn, "andb") { 0x20 } else { 0x08 }, false, src, dst);
    return;
  }

  // ---- branches / calls ----
  if mn[0] == 106 && nops == 1 { // 'j'
    let mut cc: i32 = m_cc_op(mn[1..len(mn)]);
    if cc < 0 && streq(mn[1..len(mn)], "z") {
      cc = 4; // jz/jnz are je/jne
    }
    if cc < 0 && streq(mn[1..len(mn)], "nz") {
      cc = 5;
    }
    if cc >= 0 {
      let s: *ASym = sym_get(a, ops[0], true);
      a_emitb(a, 0x0F);
      a_emitb(a, 0x80 | cc);
      a_fixup(a, FIX_REL32, s.name); // the rel32 slot, after the opcode bytes
      a_emit4(a, 0);
      return;
    }
  }
  if streq(mn, "jmp") && nops == 1 {
    let s: *ASym = sym_get(a, ops[0], true);
    a_emitb(a, 0xE9);
    a_fixup(a, FIX_REL32, s.name);
    a_emit4(a, 0);
    return;
  }
  if streq(mn, "call") && nops == 1 {
    if len(ops[0]) > 0 && ops[0][0] == 42 { // '*'
      let rm: *MReg = m_parse_reg(ops[0][1..len(ops[0])]);
      if rm.cls != R86_64 {
        asm_err(a, "bad indirect call");
        return;
      }
      m_prefix_rex(a, 0, false, mreg(R86_NONE, 0), rm);
      a_emitb(a, 0xFF);
      a_emitb(a, 0xC0 | 2 << 3 | (rm.n & 7));
      return;
    }
    let s: *ASym = sym_get(a, ops[0], true);
    a_emitb(a, 0xE8);
    a_fixup(a, FIX_REL32, s.name);
    a_emit4(a, 0);
    return;
  }
  if streq(mn, "ret") && nops == 0 {
    a_emitb(a, 0xC3);
    return;
  }
  if streq(mn, "syscall") && nops == 0 {
    a_emitb(a, 0x0F);
    a_emitb(a, 0x05);
    return;
  }
  if streq(mn, "cld") && nops == 0 {
    a_emitb(a, 0xFC);
    return;
  }
  if streq(mn, "rep") && nops == 1 && streq(ops[0], "movsb") {
    a_emitb(a, 0xF3);
    a_emitb(a, 0xA4);
    return;
  }
  if (streq(mn, "pushq") || streq(mn, "popq")) && nops == 1 {
    let r: *MReg = m_parse_reg(ops[0]);
    if r.cls != R86_64 {
      asm_err(a, "bad push/pop");
      return;
    }
    if r.n >= 8 {
      a_emitb(a, 0x41);
    }
    a_emitb(a, (if streq(mn, "pushq") { 0x50 } else { 0x58 }) | (r.n & 7));
    return;
  }

  // ---- SSE ----
  {
    let mut sse_pre: i32 = 0;
    let mut sse_opc: i32 = 0;
    let mut sse_hit: bool = true;
    if streq(mn, "addss") { sse_pre = 0xF3; sse_opc = 0x58; }
    else if streq(mn, "addsd") { sse_pre = 0xF2; sse_opc = 0x58; }
    else if streq(mn, "subss") { sse_pre = 0xF3; sse_opc = 0x5C; }
    else if streq(mn, "subsd") { sse_pre = 0xF2; sse_opc = 0x5C; }
    else if streq(mn, "mulss") { sse_pre = 0xF3; sse_opc = 0x59; }
    else if streq(mn, "mulsd") { sse_pre = 0xF2; sse_opc = 0x59; }
    else if streq(mn, "divss") { sse_pre = 0xF3; sse_opc = 0x5E; }
    else if streq(mn, "divsd") { sse_pre = 0xF2; sse_opc = 0x5E; }
    else if streq(mn, "ucomiss") { sse_pre = 0x00; sse_opc = 0x2E; }
    else if streq(mn, "ucomisd") { sse_pre = 0x66; sse_opc = 0x2E; }
    else if streq(mn, "cvtss2sd") { sse_pre = 0xF3; sse_opc = 0x5A; }
    else if streq(mn, "cvtsd2ss") { sse_pre = 0xF2; sse_opc = 0x5A; }
    else { sse_hit = false; }
    if sse_hit && nops == 2 {
      let dst: *MReg = m_parse_reg(ops[1]);
      let src: *MReg = m_parse_reg(ops[0]);
      if dst.cls != R86_XMM || src.cls != R86_XMM {
        asm_err(a, cat("bad ", cat3(mn, "", "")));
        return;
      }
      m_prefix_rex(a, sse_pre, false, dst, mreg(R86_NONE, 0));
      a_emitb(a, 0x0F);
      a_emitb(a, sse_opc);
      m_modrm_rr(a, dst, src);
      return;
    }
  }
  if (streq(mn, "cvtsi2sd") || streq(mn, "cvtsi2ss")) && nops == 2 {
    let dst: *MReg = m_parse_reg(ops[1]);
    let src: *MReg = m_parse_reg(ops[0]);
    if dst.cls != R86_XMM || src.cls != R86_64 {
      asm_err(a, "bad cvtsi2s*");
      return;
    }
    m_prefix_rex(a, if streq(mn, "cvtsi2sd") { 0xF2 } else { 0xF3 }, true, dst, src);
    a_emitb(a, 0x0F);
    a_emitb(a, 0x2A);
    m_modrm_rr(a, dst, src);
    return;
  }
  if (str_starts(mn, "cvttss2si") || str_starts(mn, "cvttsd2si")) && nops == 2 {
    let dst: *MReg = m_parse_reg(ops[1]);
    let src: *MReg = m_parse_reg(ops[0]);
    let q: bool = mn[9] == 113; // 'q'
    let want_cls: i32 = if q { R86_64 } else { R86_32 };
    if src.cls != R86_XMM || dst.cls != want_cls {
      asm_err(a, "bad cvtt*2si");
      return;
    }
    // cvttss2si vs cvttsd2si share 's' at [4]; the width letter is [5]
    m_prefix_rex(a, if mn[5] == 115 { 0xF3 } else { 0xF2 }, q, dst, mreg(R86_NONE, 0));
    a_emitb(a, 0x0F);
    a_emitb(a, 0x2C);
    m_modrm_rr(a, dst, src);
    return;
  }

  asm_err(a, cat("unknown instruction `", cat3(mn, "'", "")));
}

// ---- assembly drivers ------------------------------------------------------

fn rd32le(buf: []u8, at: u64) -> u32 {
  let i: usize = at as usize;
  return (buf[i] as u32) | ((buf[i + 1] as u32) << 8) | ((buf[i + 2] as u32) << 16) | ((buf[i + 3] as u32) << 24);
}

fn wr32le(buf: []u8, at: u64, w: u32) {
  let i: usize = at as usize;
  buf[i] = (w & 255) as u8;
  buf[i + 1] = ((w >> 8) & 255) as u8;
  buf[i + 2] = ((w >> 16) & 255) as u8;
  buf[i + 3] = ((w >> 24) & 255) as u8;
}

fn wr64le(buf: []u8, at: u64, v: u64) {
  let mut b: i32 = 0;
  while b < 8 {
    buf[at as usize + b as usize] = ((v >> (8 * b)) & 255) as u8;
    b += 1;
  }
}

// `.quad`/`.long`/`.byte`/`.zero`/`.p2align`/`.ascii`, shared by both
// assemblers; returns false for anything unrecognized (skipped by the caller)
fn a_directive_data(a: *ASMCtx, rest: string, which: string) -> bool {
  if streq(which, ".quad") {
    let v: *AImm = asm_parse_imm(rest);
    if v.ok {
      let mut i: i32 = 0;
      while i < 8 {
        a_emitb(a, (((v.v as u64) >> (8 * i)) & 255) as i32);
        i += 1;
      }
    } else {
      // `.quad Lsymbol` — absolute address relocation (any label name)
      let s: *ASym = sym_get(a, rest, true);
      a_fixup(a, FIX_ABS64, s.name);
      let mut i: i32 = 0;
      while i < 8 {
        a_emitb(a, 0);
        i += 1;
      }
    }
    return true;
  }
  if streq(which, ".long") {
    let v: *AImm = asm_parse_imm(rest);
    let mut i: i32 = 0;
    while i < 4 {
      a_emitb(a, (((v.v as u64) >> (8 * i)) & 255) as i32);
      i += 1;
    }
    return true;
  }
  if streq(which, ".byte") {
    let v: *AImm = asm_parse_imm(rest);
    a_emitb(a, (v.v & 255) as i32);
    return true;
  }
  if streq(which, ".zero") {
    let v: *AImm = asm_parse_imm(rest);
    let mut i: i64 = 0;
    while i < v.v {
      a_emitb(a, 0);
      i += 1;
    }
    return true;
  }
  if streq(which, ".p2align") {
    let n: i32 = asm_atoi(rest);
    let mask: u64 = (1 as u64 << n) - 1;
    while (a_cur(a).n as u64) & mask != 0 {
      a_emitb(a, 0);
    }
    return true;
  }
  if streq(which, ".ascii") {
    let q_i: i64 = str_index_from(rest, "\"", 0);
    if q_i < 0 {
      return true;
    }
    let mut p: usize = q_i as usize + 1;
    while p < len(rest) && rest[p] != 34 {
      if rest[p] == 92 && p + 1 < len(rest) && rest[p + 1] >= 48 && rest[p + 1] <= 55 { // '\' + octal
        let mut v: i32 = 0;
        let mut nd: i32 = 0;
        p += 1;
        while p < len(rest) && rest[p] >= 48 && rest[p] <= 55 && nd < 3 {
          v = v * 8 + (rest[p] - 48) as i32;
          p += 1;
          nd += 1;
        }
        p -= 1;
        a_emitb(a, v);
      } else {
        a_emitb(a, rest[p] as i32);
      }
      p += 1;
    }
    return true;
  }
  return false;
}

fn asm64_resolve(a: *ASMCtx, ly: *ALayout) {
  let mut i: usize = 0;
  while i < a.fixes.n {
    let f: *AFix = a.fixes.items[i];
    let s: *ASym = am_get(a.by_name, f.sym);
    let mut target: u64 = 0;
    if s != null && s.defined {
      target = a_sec_vaddr(a, ly, s.sec, s.off);
    } else if streq(f.sym, "_rho_rt_heap") {
      target = ly.heap_a;
    } else {
      asm_err(a, cat("undefined symbol `", cat3(f.sym, cat("' (fixup kind ", cat3(itoa(f.kind as i64), ")", "")), "")));
      i += 1;
      continue;
    }
    let pc: u64 = a_sec_vaddr(a, ly, f.sec, f.at);
    let mut w: u32 = rd32le(a.out[f.sec as usize].items, f.at);
    if f.kind == FIX_ADRP {
      let page: i64 = ((target >> 12) as i64) - ((pc >> 12) as i64);
      if page + (1 << 20) < 0 || page >= (1 << 20) {
        asm_err(a, "adrp page out of range");
        i += 1;
        continue;
      }
      w |= (((page & 3) as u32) << 29) | ((((page >> 2) & 0x7FFFF) as u32) << 5);
    } else if f.kind == FIX_ADDPAGE {
      w |= ((target & 0xFFF) as u32) << 10;
    } else if f.kind == FIX_B26 || f.kind == FIX_BL26 {
      let d: i64 = (target as i64 - pc as i64) >> 2;
      if d + (1 << 25) < 0 || d >= (1 << 25) {
        asm_err(a, "branch out of range");
        i += 1;
        continue;
      }
      w |= (d as u32) & 0x3FFFFFF;
    } else if f.kind == FIX_ABS64 {
      wr64le(a.out[f.sec as usize].items, f.at, target);
      i += 1;
      continue;
    } else if f.kind == FIX_BC19 || f.kind == FIX_CB19 {
      let d: i64 = (target as i64 - pc as i64) >> 2;
      if d + (1 << 18) < 0 || d >= (1 << 18) {
        asm_err(a, "branch out of range");
        i += 1;
        continue;
      }
      w |= ((d & 0x7FFFF) as u32) << 5;
    }
    wr32le(a.out[f.sec as usize].items, f.at, w);
    i += 1;
  }
}

fn asm86_resolve(a: *ASMCtx, ly: *ALayout) {
  let mut i: usize = 0;
  while i < a.fixes.n {
    let f: *AFix = a.fixes.items[i];
    let s: *ASym = am_get(a.by_name, f.sym);
    let mut target: u64 = 0;
    if s != null && s.defined {
      target = a_sec_vaddr(a, ly, s.sec, s.off);
    } else if streq(f.sym, "_rho_rt_heap") {
      target = ly.heap_a;
    } else {
      asm_err(a, cat("undefined symbol `", cat3(f.sym, "'", "")));
      i += 1;
      continue;
    }
    if f.kind == FIX_ABS64 {
      wr64le(a.out[f.sec as usize].items, f.at, target);
      i += 1;
      continue;
    }
    let pc: u64 = a_sec_vaddr(a, ly, f.sec, f.at);
    // rel32: branches/calls count from the next instruction, rip-relative
    // from the next byte — the same pc+4 either way
    let d: i64 = target as i64 - ((pc + 4) as i64);
    if d + (1 << 31) < 0 || d >= (1 << 31) {
      asm_err(a, cat("relocation out of range for `", cat3(f.sym, "'", "")));
      i += 1;
      continue;
    }
    wr32le(a.out[f.sec as usize].items, f.at, d as u32);
    i += 1;
  }
}

// computes the text|strings|page|data|page|heap layout both assemblers and
// both image writers share
fn a_layout(a: *ASMCtx, page: u64, heap_override: u64) -> *ALayout {
  let pmask: u64 = page - 1;
  let ly: *ALayout = new ALayout { str_a: 0, data_a: 0, heap_a: 0 };
  ly.str_a = a.base + ((a.out[0].n as u64 + 7) & ~(7 as u64));
  // the data page starts past EVERYTHING in the r-x image — the rodata
  // strings fold into the text section bytes, so rounding past str alone
  // would let __DATA overlap the string tail
  ly.data_a = (ly.str_a + a.out[1].n as u64 + pmask) & ~pmask;
  if ly.data_a < a.base + a.out[0].n as u64 {
    ly.data_a = (a.base + a.out[0].n as u64 + pmask) & ~pmask;
  }
  if heap_override != 0 {
    ly.heap_a = heap_override;
  } else {
    ly.heap_a = (ly.data_a + a.out[2].n as u64 + pmask) & ~pmask;
  }
  return ly;
}

struct AResult { ok: bool, text: *Vec[u8], strsec: *Vec[u8], data: *Vec[u8], str_va: u64, data_va: u64, heap_va: u64 }

fn a_result_failed() -> *AResult {
  return new AResult { ok: false, text: null, strsec: null, data: null, str_va: 0, data_va: 0, heap_va: 0 };
}

// assembles the full text (runtime blob first, then the emitted program).
// `base` is the vaddr the first text byte will have in the final image;
// `page` is the target's segment alignment (0x1000 linux, 0x4000 arm64-mac
// — Apple Silicon maps segments on 16K boundaries and the kernel's strict
// validation rejects anything else). `heap_override` pins the bump heap's
// vaddr (mac images carry the heap in a fixed trailing segment); 0 = lay
// it out right after the data page.
fn asm64_assemble(text: string, base: u64, page: u64, heap_override: u64) -> *AResult {
  eprintf("{}", cat3("ASM@in len=", itoa(len(text) as i64), "\n"));
  let a: *ASMCtx = ac_new(base, true);
  let lines: *Vec[string] = asm_split_lines(text);
  let mut li: usize = 0;
  while li < lines.n {
    let line: string = asm_prepare(lines.items[li]);
    li += 1;
    if len(line) == 0 {
      continue;
    }
    if line[0] == 46 { // '.'
      let sp_i: i64 = str_index_from(line, " ", 0);
      let mut name: string = line;
      let mut rest: string = "";
      if sp_i >= 0 {
        name = line[0..sp_i as usize];
        let mut r: usize = sp_i as usize + 1;
        while r < len(line) && line[r] == 32 {
          r += 1;
        }
        rest = line[r..len(line)];
      }
      if streq(name, ".data") {
        a.sec = 2;
      } else if streq(name, ".text") || streq(name, ".rodata") {
        // standalone section switches (the ELF dialect emits them)
        a.sec = 0;
      } else if streq(name, ".section") {
        // the rodata strings fold into the text section image: they ride
        // the same bytes in the final image (one r-x page). mach-o names
        // come in as __text/__rhostr/__data fragments; ELF targets use
        // the plain dot names
        if streq(rest, ".text") || streq(rest, ".rodata") {
          a.sec = 0;
        } else if streq(rest, ".data") {
          a.sec = 2;
        } else {
          a.sec = 0;
          if str_index_from(rest, "__rhostr", 0) >= 0 {
            a.sec = 0; // strings fold into text
          } else if str_index_from(rest, "__data", 0) >= 0 {
            a.sec = 2;
          }
        }
      } else if streq(name, ".globl") {
        sym_get(a, rest, true);
      } else {
        // .build_version / .subsections_via_symbols / anything else:
        // a_directive_data handles the data directives, the rest skip
        a_directive_data(a, rest, name);
      }
      continue;
    }
    if str_ends_byte(line, 58) { // ':'
      let label: string = line[0..len(line) - 1];
      let s: *ASym = sym_get(a, label, true);
      if s.defined {
        asm_err(a, cat("duplicate label `", cat3(label, "'", "")));
        continue;
      }
      s.defined = true;
      s.sec = a.sec;
      s.off = a_cur(a).n as u64;
      continue;
    }
    let ops: *Vec[string] = asm_split_ops(line);
    if ops.n > 0 {
      let rest: []string = ops.items[1..ops.n];
      ar_asm_line(a, ops.items[0], rest);
    }
  }
  let ly: *ALayout = a_layout(a, page, heap_override);
  asm64_resolve(a, ly);
  if a.errors > 0 {
    return a_result_failed();
  }
  return new AResult { ok: true, text: a.out[0], strsec: a.out[1], data: a.out[2], str_va: ly.str_a, data_va: ly.data_a, heap_va: ly.heap_a };
}

fn asm86_assemble(text: string, base: u64, page: u64, heap_override: u64) -> *AResult {
  let a: *ASMCtx = ac_new(base, false);
  let lines: *Vec[string] = asm_split_lines(text);
  let mut li: usize = 0;
  while li < lines.n {
    let raw: string = asm_prepare(lines.items[li]);
    li += 1;
    if len(raw) == 0 {
      continue;
    }
    // labels first: the amd64 literal pool uses dot-prefixed names
    if str_ends_byte(raw, 58) { // ':'
      let label: string = raw[0..len(raw) - 1];
      let s: *ASym = sym_get(a, label, true);
      if s.defined {
        asm_err(a, cat("duplicate label `", cat3(label, "'", "")));
        continue;
      }
      s.defined = true;
      s.sec = a.sec;
      s.off = a_cur(a).n as u64;
      continue;
    }
    if raw[0] == 46 { // '.'
      let sp_i: i64 = str_index_from(raw, " ", 0);
      let mut name: string = raw;
      let mut rest: string = "";
      if sp_i >= 0 {
        name = raw[0..sp_i as usize];
        let mut r: usize = sp_i as usize + 1;
        while r < len(raw) && raw[r] == 32 {
          r += 1;
        }
        rest = raw[r..len(raw)];
      }
      if streq(name, ".text") {
        a.sec = 0;
      } else if streq(name, ".data") {
        a.sec = 2;
      } else if streq(name, ".section") {
        // ".rodata" folds into the text image (one r-x page in the final
        // ELF); ".data" splits off
        if str_starts(rest, ".rodata") || str_starts(rest, "__rodata") || str_starts(rest, "__TEXT") {
          a.sec = 0;
        } else if str_starts(rest, ".data") || str_starts(rest, "__data") || str_starts(rest, "__DATA") {
          a.sec = 2;
        } else {
          asm_err(a, cat("unknown section `", cat3(rest, "'", "")));
        }
      } else if streq(name, ".globl") {
        sym_get(a, rest, true);
      } else {
        a_directive_data(a, rest, name);
      }
      continue;
    }
    let ops: *Vec[string] = asm_split_ops(raw);
    if ops.n > 0 {
      let rest: []string = ops.items[1..ops.n];
      m86_asm_line(a, ops.items[0], rest);
    }
  }
  let ly: *ALayout = a_layout(a, page, heap_override);
  asm86_resolve(a, ly);
  if a.errors > 0 {
    return a_result_failed();
  }
  return new AResult { ok: true, text: a.out[0], strsec: a.out[1], data: a.out[2], str_va: ly.str_a, data_va: ly.data_a, heap_va: ly.heap_a };
}

// ---- SHA-256 (macho64.c port) ---------------------------------------------

struct Sha256 {
  h: []u64, // eight 32-bit words, held in u64 and masked on update
  len: u64,
  buf: []u8,
  n: usize,
}

fn sha256_init(s: *Sha256) {
  s.h[0] = 0x6A09E667;
  s.h[1] = 0xBB67AE85;
  s.h[2] = 0x3C6EF372;
  s.h[3] = 0xA54FF53A;
  s.h[4] = 0x510E527F;
  s.h[5] = 0x9B05688C;
  s.h[6] = 0x1F83D9AB;
  s.h[7] = 0x5BE0CD19;
  s.len = 0;
  s.n = 0;
}

fn sha_rotr(x: u64, n: i32) -> u64 {
  let m: u64 = 0xFFFFFFFF;
  return ((x >> n) | (x << (32 - n))) & m;
}

fn sha_k(i: i32) -> u64 {
  // the SHA-256 round constants, in order
  if i == 0 { return 0x428A2F98; }
  if i == 1 { return 0x71374491; }
  if i == 2 { return 0xB5C0FBCF; }
  if i == 3 { return 0xE9B5DBA5; }
  if i == 4 { return 0x3956C25B; }
  if i == 5 { return 0x59F111F1; }
  if i == 6 { return 0x923F82A4; }
  if i == 7 { return 0xAB1C5ED5; }
  if i == 8 { return 0xD807AA98; }
  if i == 9 { return 0x12835B01; }
  if i == 10 { return 0x243185BE; }
  if i == 11 { return 0x550C7DC3; }
  if i == 12 { return 0x72BE5D74; }
  if i == 13 { return 0x80DEB1FE; }
  if i == 14 { return 0x9BDC06A7; }
  if i == 15 { return 0xC19BF174; }
  if i == 16 { return 0xE49B69C1; }
  if i == 17 { return 0xEFBE4786; }
  if i == 18 { return 0x0FC19DC6; }
  if i == 19 { return 0x240CA1CC; }
  if i == 20 { return 0x2DE92C6F; }
  if i == 21 { return 0x4A7484AA; }
  if i == 22 { return 0x5CB0A9DC; }
  if i == 23 { return 0x76F988DA; }
  if i == 24 { return 0x983E5152; }
  if i == 25 { return 0xA831C66D; }
  if i == 26 { return 0xB00327C8; }
  if i == 27 { return 0xBF597FC7; }
  if i == 28 { return 0xC6E00BF3; }
  if i == 29 { return 0xD5A79147; }
  if i == 30 { return 0x06CA6351; }
  if i == 31 { return 0x14292967; }
  if i == 32 { return 0x27B70A85; }
  if i == 33 { return 0x2E1B2138; }
  if i == 34 { return 0x4D2C6DFC; }
  if i == 35 { return 0x53380D13; }
  if i == 36 { return 0x650A7354; }
  if i == 37 { return 0x766A0ABB; }
  if i == 38 { return 0x81C2C92E; }
  if i == 39 { return 0x92722C85; }
  if i == 40 { return 0xA2BFE8A1; }
  if i == 41 { return 0xA81A664B; }
  if i == 42 { return 0xC24B8B70; }
  if i == 43 { return 0xC76C51A3; }
  if i == 44 { return 0xD192E819; }
  if i == 45 { return 0xD6990624; }
  if i == 46 { return 0xF40E3585; }
  if i == 47 { return 0x106AA070; }
  if i == 48 { return 0x19A4C116; }
  if i == 49 { return 0x1E376C08; }
  if i == 50 { return 0x2748774C; }
  if i == 51 { return 0x34B0BCB5; }
  if i == 52 { return 0x391C0CB3; }
  if i == 53 { return 0x4ED8AA4A; }
  if i == 54 { return 0x5B9CCA4F; }
  if i == 55 { return 0x682E6FF3; }
  if i == 56 { return 0x748F82EE; }
  if i == 57 { return 0x78A5636F; }
  if i == 58 { return 0x84C87814; }
  if i == 59 { return 0x8CC70208; }
  if i == 60 { return 0x90BEFFFA; }
  if i == 61 { return 0xA4506CEB; }
  if i == 62 { return 0xBEF9A3F7; }
  return 0xC67178F2;
}

fn sha256_block(s: *Sha256, p: []u8) {
  let M: u64 = 0xFFFFFFFF;
  let w: []u64 = make([]u64, 64);
  let mut i: i32 = 0;
  while i < 16 {
    w[i] = ((p[i * 4] as u64) << 24) | ((p[i * 4 + 1] as u64) << 16) |
           ((p[i * 4 + 2] as u64) << 8) | (p[i * 4 + 3] as u64);
    i += 1;
  }
  while i < 64 {
    let s0: u64 = (sha_rotr(w[i - 15], 7) ^ sha_rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)) & M;
    let s1: u64 = (sha_rotr(w[i - 2], 17) ^ sha_rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)) & M;
    w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & M;
    i += 1;
  }
  let mut a: u64 = s.h[0];
  let mut b: u64 = s.h[1];
  let mut c: u64 = s.h[2];
  let mut d: u64 = s.h[3];
  let mut e: u64 = s.h[4];
  let mut f: u64 = s.h[5];
  let mut g: u64 = s.h[6];
  let mut hh: u64 = s.h[7];
  i = 0;
  while i < 64 {
    let S1: u64 = (sha_rotr(e, 6) ^ sha_rotr(e, 11) ^ sha_rotr(e, 25)) & M;
    let ch: u64 = ((e & f) ^ (~e & g)) & M;
    let t1: u64 = (hh + S1 + ch + sha_k(i) + w[i]) & M;
    let S0: u64 = (sha_rotr(a, 2) ^ sha_rotr(a, 13) ^ sha_rotr(a, 22)) & M;
    let maj: u64 = ((a & b) ^ (a & c) ^ (b & c)) & M;
    let t2: u64 = (S0 + maj) & M;
    hh = g;
    g = f;
    f = e;
    e = (d + t1) & M;
    d = c;
    c = b;
    b = a;
    a = (t1 + t2) & M;
    i += 1;
  }
  s.h[0] = (s.h[0] + a) & M;
  s.h[1] = (s.h[1] + b) & M;
  s.h[2] = (s.h[2] + c) & M;
  s.h[3] = (s.h[3] + d) & M;
  s.h[4] = (s.h[4] + e) & M;
  s.h[5] = (s.h[5] + f) & M;
  s.h[6] = (s.h[6] + g) & M;
  s.h[7] = (s.h[7] + hh) & M;
}

fn sha256_update(s: *Sha256, data: []u8) {
  s.len = s.len + len(data) as u64;
  let mut idx: usize = 0;
  let mut remaining: usize = len(data);
  while remaining > 0 {
    let room: usize = 64 - s.n;
    let take: usize = if room < remaining { room } else { remaining };
    let mut k: usize = 0;
    while k < take {
      s.buf[s.n + k] = data[idx + k];
      k += 1;
    }
    s.n = s.n + take;
    idx = idx + take;
    remaining = remaining - take;
    if s.n == 64 {
      sha256_block(s, s.buf);
      s.n = 0;
    }
  }
}

fn sha256_final(s: *Sha256) -> []u8 {
  let out: []u8 = make([]u8, 32);
  let bits: u64 = s.len * 8;
  let pad: []u8 = make([]u8, 1);
  pad[0] = 0x80;
  sha256_update(s, pad);
  let z: []u8 = make([]u8, 1);
  z[0] = 0;
  while s.n != 56 {
    sha256_update(s, z);
  }
  let lenb: []u8 = make([]u8, 8);
  let mut i: i32 = 0;
  while i < 8 {
    lenb[i] = ((bits >> (56 - i * 8)) & 255) as u8;
    i += 1;
  }
  sha256_update(s, lenb);
  i = 0;
  while i < 8 {
    out[i * 4] = ((s.h[i] >> 24) & 255) as u8;
    out[i * 4 + 1] = ((s.h[i] >> 16) & 255) as u8;
    out[i * 4 + 2] = ((s.h[i] >> 8) & 255) as u8;
    out[i * 4 + 3] = (s.h[i] & 255) as u8;
    i += 1;
  }
  return out;
}

// ---- image writers (elf64.c / macho64.c ports) ----------------------------

fn b_put32(b: *Vec[u8], v: u32) {
  b.push((v & 255) as u8);
  b.push(((v >> 8) & 255) as u8);
  b.push(((v >> 16) & 255) as u8);
  b.push(((v >> 24) & 255) as u8);
}

fn b_put64(b: *Vec[u8], v: u64) {
  let mut i: i32 = 0;
  while i < 8 {
    b.push(((v >> (8 * i)) & 255) as u8);
    i += 1;
  }
}

fn b_put16(b: *Vec[u8], v: u32) {
  b.push((v & 255) as u8);
  b.push(((v >> 8) & 255) as u8);
}

fn b_put_be32(b: *Vec[u8], v: u32) {
  b.push(((v >> 24) & 255) as u8);
  b.push(((v >> 16) & 255) as u8);
  b.push(((v >> 8) & 255) as u8);
  b.push((v & 255) as u8);
}

fn b_put_be64(b: *Vec[u8], v: u64) {
  let mut i: i32 = 7;
  while i >= 0 {
    b.push(((v >> (8 * i)) & 255) as u8);
    i -= 1;
  }
}

fn b_put_name(b: *Vec[u8], name: string) {
  let n: usize = len(name);
  let mut i: i32 = 0;
  while i < 16 {
    if i < n as i32 {
      b.push(name[i as usize]);
    } else {
      b.push(0);
    }
    i += 1;
  }
}

fn b_push_str(b: *Vec[u8], s: string) {
  let mut i: usize = 0;
  while i < len(s) {
    b.push(s[i]);
    i += 1;
  }
}

// writes a section_64 entry
fn macho_sect(b: *Vec[u8], sect_name: string, seg_name: string, addr: u64, size: u64, offset: u32, align_exp: u32, flags: u32) {
  b_put_name(b, sect_name);
  b_put_name(b, seg_name);
  b_put64(b, addr);
  b_put64(b, size);
  b_put32(b, offset);
  b_put32(b, align_exp); // 2^align
  b_put32(b, 0);         // reloff
  b_put32(b, 0);         // nreloc
  b_put32(b, flags);
  b_put32(b, 0); // reserved1
  b_put32(b, 0); // reserved2
  b_put32(b, 0); // reserved3
}

// the zero-fill bump heap: its own trailing segment, fixed address
static mut HEAP_BYTES: u64 = 0x70000000;    // 1.75 GiB — measured ceiling: 0x7E000000 starves the dyld shared-region carve (kernel kills the map)
static mut HEAP_VADDR_OFF: u64 = 0x1000000; // heap vmaddr = VM_BASE + this

// writes a static Mach-O for arm64-mac: a fixed-address executable plus the
// ad-hoc code signature (SHA-256 page hashes in a SuperBlob)
fn macho64_write(r: *AResult, text_vaddr: u64, data_vaddr: u64, heap_vaddr: u64, out_path: string) -> bool {
  let page: u64 = 4096;            // signature page size (log2 12) — Apple's
                                   // own ld signs arm64 images at 4K too
  let segpage: u64 = 0x4000;       // arm64 segments map on 16K boundaries;
                                   // the kernel's strict validation rejects
                                   // any other segment size
  let VM_BASE: u64 = 0x100000000;  // main-image load address

  let text_size: u64 = r.text.n as u64;
  let data_size: u64 = r.data.n as u64;

  let hdr: u64 = text_vaddr - VM_BASE;
  let text_end: u64 = data_vaddr - VM_BASE; // 16K-aligned (asm64 lays it out)
  let data_fileoff: u64 = data_vaddr - VM_BASE;
  // one page discipline, no segment ever overlaps another; the heap is its
  // own trailing zero-fill segment at a fixed address
  let data_fs: u64 = (data_size + segpage - 1) & ~(segpage - 1);
  // __LINKEDIT = minimal chained-fixups table + empty exports trie + the
  // signature (AppleSystemPolicy kills MH_DYLDLINK images whose fixups or
  // trie commands are absent or empty — dyld must find parseable blobs)
  let FIXUPS_BYTES: u64 = 56; // ld's exact shape: header, pad, 5-seg table
  let TRIE_BYTES: u64 = 8;    // one terminal byte + pad
  let le_off: u64 = data_fileoff + data_fs; // still 16K-aligned
  let fixups_off: u64 = le_off;
  let trie_off: u64 = le_off + FIXUPS_BYTES;
  let sig_off: u64 = le_off + FIXUPS_BYTES + (TRIE_BYTES as u64); // codeLimit
  let sig_nslots: u64 = (sig_off + page - (1 as u64)) / page;
  let sig_size: u64 = ((20 + 88 + 4) as u64) + sig_nslots * (32 as u64);
  let le_fs: u64 = FIXUPS_BYTES + TRIE_BYTES + sig_size;

  let b: *Vec[u8] = new Vec[u8] { items: make([]u8, 4096), n: 0 };
  b_put32(b, 0xFEEDFACF);
  b_put32(b, 0x0100000C);         // cputype ARM64
  b_put32(b, 0);                  // cpusubtype
  b_put32(b, 2);                  // MH_EXECUTE
  b_put32(b, 14);                 // ncmds
  b_put32(b, 824);                 // sizeofcmds (ARM64_MAC_HDR - 32)
  b_put32(b, 0x00200085);         // flags: NOUNDEFS|DYLDLINK|TWOLEVEL|PIE
  b_put32(b, 0);                  // reserved

  // LC_SEGMENT_64 __PAGEZERO
  b_put32(b, 0x19);
  b_put32(b, 72);
  b_put_name(b, "__PAGEZERO");
  b_put64(b, 0);
  b_put64(b, VM_BASE);
  b_put64(b, 0);
  b_put64(b, 0);
  b_put32(b, 0);
  b_put32(b, 0);
  b_put32(b, 0);
  b_put32(b, 0);

  // LC_SEGMENT_64 __TEXT (r-x)
  b_put32(b, 0x19);
  b_put32(b, 152);
  b_put_name(b, "__TEXT");
  b_put64(b, VM_BASE);
  b_put64(b, text_end);
  b_put64(b, 0);
  b_put64(b, text_end);
  b_put32(b, 5);
  b_put32(b, 5);
  b_put32(b, 1);
  b_put32(b, 0);
  macho_sect(b, "__text", "__TEXT", text_vaddr, text_size, hdr as u32, 3, 0x80000400);

  // LC_SEGMENT_64 __DATA (rw-): file-backed, vmsize == filesize
  b_put32(b, 0x19);
  b_put32(b, 152);
  b_put_name(b, "__DATA");
  b_put64(b, data_vaddr);
  b_put64(b, data_fs);
  b_put64(b, data_fileoff);
  b_put64(b, data_fs);
  b_put32(b, 3);
  b_put32(b, 3);
  b_put32(b, 1);
  b_put32(b, 0);
  macho_sect(b, "__data", "__DATA", data_vaddr, data_size, data_fileoff as u32, 3, 0);

  // LC_SEGMENT_64 __HEAP (rw-): the 16 MiB bump heap as a pure zero-fill
  // segment at a fixed address — nothing in the file, fresh zero pages
  b_put32(b, 0x19);
  b_put32(b, 152);
  b_put_name(b, "__HEAP");
  b_put64(b, VM_BASE + HEAP_VADDR_OFF);
  b_put64(b, HEAP_BYTES);
  b_put64(b, 0);
  b_put64(b, 0);
  b_put32(b, 3);
  b_put32(b, 3);
  b_put32(b, 1);
  b_put32(b, 0);
  macho_sect(b, "__rhoheap", "__HEAP", heap_vaddr, HEAP_BYTES, 0, 4, 1); // S_ZEROFILL

  // LC_SEGMENT_64 __LINKEDIT (r--): its vmaddr sits PAST the BSS heap — a
  // segment overlapping __DATA's zero-fill tail is a load-time overlap the
  // kernel kills on sight; vaddr and fileoff only need to agree modulo the
  // 16K page, and both are aligned
  b_put32(b, 0x19);
  b_put32(b, 72);
  b_put_name(b, "__LINKEDIT");
  b_put64(b, VM_BASE + le_off);
  b_put64(b, (le_fs + segpage - 1) & ~(segpage - 1));
  b_put64(b, le_off);
  b_put64(b, le_fs);
  b_put32(b, 1);
  b_put32(b, 1);
  b_put32(b, 0);
  b_put32(b, 0);

  // LC_DYLD_CHAINED_FIXUPS: a well-formed, entirely-empty fixups table —
  // three segments, no starts, no imports
  b_put32(b, 0x80000034);
  b_put32(b, 16);
  b_put32(b, fixups_off as u32);
  b_put32(b, FIXUPS_BYTES as u32);

  // LC_DYLD_EXPORTS_TRIE: a single terminal byte — no exported symbols
  b_put32(b, 0x80000033);
  b_put32(b, 16);
  b_put32(b, trie_off as u32);
  b_put32(b, TRIE_BYTES as u32);

  // LC_UUID: deterministic
  b_put32(b, 0x1B);
  b_put32(b, 24);
  let mut i: i32 = 0;
  while i < 16 {
    b.push(((i * 37 + 11) & 0xFF) as u8);
    i += 1;
  }

  // LC_BUILD_VERSION: platform macOS, minOS/SDK 13.0.0
  b_put32(b, 0x32);
  b_put32(b, 24);
  b_put32(b, 1);
  b_put32(b, 0x000D0000);
  b_put32(b, 0x000D0000);
  b_put32(b, 0);

  // LC_SOURCE_VERSION: 0.0
  b_put32(b, 0x2A);
  b_put32(b, 16);
  b_put_be64(b, 0);

  // LC_LOAD_DYLIB libSystem: present-but-unused — a MH_DYLDLINK main image
  // with zero dylibs is killed by the kernel's system policy
  b_put32(b, 0xC);
  b_put32(b, 56); // cmdsize
  b_put32(b, 24); // name offset
  b_put32(b, 0);  // timestamp
  b_put32(b, 0);  // current_version
  b_put32(b, 0);  // compatibility_version
  b_push_str(b, "/usr/lib/libSystem.B.dylib");
  while b.n % 8 != 0 {
    b.push(0);
  }

  // LC_LOAD_DYLINKER: on arm64 macOS every executable is entered via dyld —
  // a static image without this command is killed at exec
  b_put32(b, 0xE);
  b_put32(b, 32); // cmdsize: 12 + name, 8-aligned
  b_put32(b, 12);
  b_push_str(b, "/usr/lib/dyld");
  while b.n % 8 != 0 {
    b.push(0);
  }

  // LC_MAIN: dyld jumps to _rho_rt_start (the first text byte)
  b_put32(b, 0x80000028);
  b_put32(b, 24);
  b_put64(b, hdr);
  b_put64(b, 0);

  // LC_CODE_SIGNATURE — size deterministic, written before hashing
  b_put32(b, 0x1D);
  b_put32(b, 16);
  b_put32(b, sig_off as u32);
  b_put32(b, sig_size as u32);

  // __text starts 8-aligned: pad the command block after the last command
  while b.n % 8 != 0 {
    b.push(0);
  }

  if b.n as u64 != hdr {
    eprintf("{}", "rho: macho64: header block != expected size\n");
    return false;
  }

  b_push_str_bytes(b, r.text);
  b_push_str_bytes(b, r.strsec);
  while (b.n as u64) < data_fileoff {
    b.push(0);
  }
  b_push_str_bytes(b, r.data);
  while (b.n as u64) < le_off { // zero pad __DATA out to its rounded size
    b.push(0);
  }

  // ---- __LINKEDIT: chained fixups (LE), ld's exact shape ----
  b_put32(b, 0);            // fixups_version
  b_put32(b, 32);           // starts_offset
  b_put32(b, FIXUPS_BYTES as u32); // imports_offset (empty table)
  b_put32(b, FIXUPS_BYTES as u32); // symbols_offset (empty table)
  b_put32(b, 0);            // imports_count
  b_put32(b, 1);            // imports_format: DYLD_CHAINED_IMPORT — dyld
                            // rejects 0 ("unknown imports format") even
                            // with no imports
  b_put32(b, 0);            // symbols_format
  b_put32(b, 0);            // 4 bytes of pad, starts table 4-aligned at 32
  b_put32(b, 5);            // segCount (every segment, incl. PAGEZERO/HEAP)
  b_put32(b, 0);            // segInfoOffset[0] — no fixups anywhere
  b_put32(b, 0);            // segInfoOffset[1]
  b_put32(b, 0);            // segInfoOffset[2]
  b_put32(b, 0);            // segInfoOffset[3]
  b_put32(b, 0);            // segInfoOffset[4]
  // ---- exports trie: one terminal node, no children ----
  b.push(0);
  i = 1;
  while i < TRIE_BYTES as i32 {
    b.push(0);
    i += 1;
  }

  // ---- ad-hoc code signature (CS_ADHOC | CS_LINKER_SIGNED) ----
  let ident: string = "rho";
  let ident_len: u64 = 4; // "rho" + NUL
  let sig: *Vec[u8] = new Vec[u8] { items: make([]u8, 4096), n: 0 };
  b_put_be32(sig, 0xFADE0CC0);
  b_put_be32(sig, sig_size as u32);
  b_put_be32(sig, 1);
  b_put_be32(sig, 0);
  b_put_be32(sig, 20);

  b_put_be32(sig, 0xFADE0C02);
  b_put_be32(sig, (sig_size - 20) as u32);
  b_put_be32(sig, 0x00020400);
  b_put_be32(sig, 0x00020002); // CS_ADHOC | CS_LINKER_SIGNED — plain CS_ADHOC is intermittently rejected by the kernel (unkillable wait, not a kill; measured 2026-09-21)
                               // provenance chain is what the kernel's
                               // system policy kills
  b_put_be32(sig, (88 + ident_len) as u32);
  b_put_be32(sig, 88);
  b_put_be32(sig, 0);
  b_put_be32(sig, sig_nslots as u32);
  b_put_be32(sig, sig_off as u32);
  sig.push(32);
  sig.push(2);
  sig.push(0);
  sig.push(12);
  b_put_be32(sig, 0);
  b_put_be32(sig, 0);
  b_put_be32(sig, 0);
  b_put_be32(sig, 0);
  b_put_be64(sig, 0);
  b_put_be64(sig, 0);
  b_put_be64(sig, text_end);
  b_put_be64(sig, 1); // CS_EXECSEG_MAIN_BINARY
  b_push_str(sig, ident);
  sig.push(0);
  let mut p: u64 = 0;
  while p < sig_nslots {
    let start: u64 = p * page;
    let mut take: u64 = page;
    if sig_off - start < page {
      take = sig_off - start;
    }
    let sha: *Sha256 = new Sha256 { h: make([]u64, 8), len: 0, buf: make([]u8, 64), n: 0 };
    sha256_init(sha);
    sha256_update(sha, b.items[start..(start + take) as usize]);
    let digest: []u8 = sha256_final(sha);
    let mut di: usize = 0;
    while di < 32 {
      sig.push(digest[di]);
      di += 1;
    }
    p += 1;
  }

  if sig.n as u64 != sig_size {
    eprintf("{}", "rho: macho64: signature != expected size\n");
    return false;
  }

  // image + signature in one write (the file ends exactly at
  // dataoff+datasize — anything after the signature fails the kernel's
  // strict validation; mode bits are the caller's concern: a freestanding
  // compiler cannot chmod)
  let out_all: []u8 = make([]u8, b.n + sig.n);
  let mut k: usize = 0;
  while k < b.n {
    out_all[k] = b.items[k];
    k += 1;
  }
  k = 0;
  while k < sig.n {
    out_all[b.n + k] = sig.items[k];
    k += 1;
  }
  return write_file(out_path, bytes_as_string(out_all));
}

fn b_push_str_bytes(b: *Vec[u8], data: *Vec[u8]) {
  let mut i: usize = 0;
  while i < data.n {
    b.push(data.items[i]);
    i += 1;
  }
}

fn elf_phdr(b: *Vec[u8], ptype: u32, flags: u32, off: u64, vaddr: u64, filesz: u64, memsz: u64, align: u64) {
  b_put32(b, ptype);
  b_put32(b, flags);
  b_put64(b, off);
  b_put64(b, vaddr);
  b_put64(b, vaddr); // p_paddr
  b_put64(b, filesz);
  b_put64(b, memsz);
  b_put64(b, align);
}

// writes a static ELF64 for the linux targets (amd64-linux, arm64-linux):
// an ET_EXEC image with two PT_LOAD segments — r-x covering the ELF header,
// program headers, text and the rodata strings folded into it; rw- covering
// the data image with a zero-fill tail that is the bump-allocator heap —
// plus PT_GNU_STACK. No interpreter, no relocations, no section table.
fn elf64_write(r: *AResult, machine: u32, text_vaddr: u64, data_vaddr: u64, heap_vaddr: u64, out_path: string) -> bool {
  let base: u64 = 0x400000; // fixed non-PIE load address
  let hdr: u64 = 232;       // 64-byte Ehdr + 3 program headers

  let data_size: u64 = r.data.n as u64;
  let off_data: u64 = data_vaddr - base; // congruent: vaddr - offset = 0x400000

  if text_vaddr != base + hdr || heap_vaddr < data_vaddr + data_size {
    eprintf("{}", "rho: elf64: layout mismatch\n");
    return false;
  }

  let b: *Vec[u8] = new Vec[u8] { items: make([]u8, 4096), n: 0 };

  // ---- Ehdr ----
  let ident: []u8 = make([]u8, 16);
  ident[0] = 0x7F;
  ident[1] = 69;  // 'E'
  ident[2] = 76;  // 'L'
  ident[3] = 70;  // 'F'
  ident[4] = 2;
  ident[5] = 1;
  ident[6] = 1;
  ident[7] = 0;
  let mut qi: usize = 0;
  while qi < 16 {
    b.push(ident[qi]);
    qi += 1;
  }
  b_put16(b, 2);          // e_type = ET_EXEC
  b_put16(b, machine);
  b_put32(b, 1);          // e_version
  b_put64(b, text_vaddr); // e_entry — first text byte (the runtime blob)
  b_put64(b, 64);         // e_phoff
  b_put64(b, 0);          // e_shoff — no section table
  b_put32(b, 0);          // e_flags
  b_put16(b, 64);         // e_ehsize
  b_put16(b, 56);         // e_phentsize
  b_put16(b, 3);          // e_phnum
  b_put16(b, 0);          // e_shentsize
  b_put16(b, 0);          // e_shnum
  b_put16(b, 0);          // e_shstrndx

  // ---- Phdr[0]: r-x text (header block + text + folded strings) ----
  elf_phdr(b, 1, 5, 0, base, off_data, off_data, 0x10000);

  // ---- Phdr[1]: rw- data, BSS tail = the bump heap ----
  elf_phdr(b, 1, 6, off_data, data_vaddr, data_size,
           heap_vaddr + HEAP_BYTES - data_vaddr, 0x10000);

  // ---- Phdr[2]: PT_GNU_STACK — non-executable stack ----
  elf_phdr(b, 0x6474E551, 6, 0, 0, 0, 0, 0x10);

  if b.n as u64 != hdr {
    eprintf("{}", "rho: elf64: header block != expected size\n");
    return false;
  }

  b_push_str_bytes(b, r.text);
  b_push_str_bytes(b, r.strsec);
  while (b.n as u64) < off_data {
    b.push(0);
  }
  b_push_str_bytes(b, r.data);
  return write_file(out_path, bytes_as_string(b.items[0..b.n]));
}

// ---- build_to native dispatch ---------------------------------------------

static mut ARM64_MAC_HDR: u64 = 856;
static mut ELF64_HDR: u64 = 232;

// native image pipeline: runtime blob + emitted text -> assemble -> write
// the image. Returns 0 on success; the caller prints the artifact line.
fn build_native_image(target: i32, text: []u8, out_path: string) -> i32 {
  if target == 0 {
    // amd64-linux: rho's own assembly -> own assembler -> static ELF;
    // no libc, no interpreter, no external toolchain anywhere
    let full: string = cat(rt_amd64_linux(), bytes_as_string(text));
    let r: *AResult = asm86_assemble(full, 0x400000 + ELF64_HDR, 0x1000, 0);
    if !r.ok {
      return 1;
    }
    if !elf64_write(r, 62, // EM_X86_64
 0x400000 + ELF64_HDR, r.data_va, r.heap_va, out_path) {
      return 1;
    }
    return 0;
  }
  if target == 4 {
    // arm64-linux: raw syscalls, the asm-generic table (write=64, exit=93)
    let full: string = cat(rt_arm64_linux(), bytes_as_string(text));
    let r: *AResult = asm64_assemble(full, 0x400000 + ELF64_HDR, 0x1000, 0);
    if !r.ok {
      return 1;
    }
    if !elf64_write(r, 183, // EM_AARCH64
 0x400000 + ELF64_HDR, r.data_va, r.heap_va, out_path) {
      return 1;
    }
    return 0;
  }
  if target == 2 {
    // arm64-mac: static Mach-O with an ad-hoc signature; image base
    // VM 0x100000000 + the fixed 856-byte load-command block; 16K pages —
    // Apple Silicon maps segments on 16K boundaries
    let full: string = cat(rt_arm64(), bytes_as_string(text));
    let r: *AResult = asm64_assemble(full, (0x100000000 as u64) + ARM64_MAC_HDR, 0x4000,
                                     (0x100000000 as u64) + 0x1000000);
    if !r.ok {
      return 1;
    }
    if !macho64_write(r, (0x100000000 as u64) + ARM64_MAC_HDR, r.data_va, r.heap_va, out_path) {
      return 1;
    }
    return 0;
  }
  // amd64-mac: .s only (Rosetta test vehicle; never assembled in-tree) —
  // handled by the caller's shared native tail
  return 0 - 1;
}

// ============== generic fn instantiation (check.c port L7) =================

// ---- declaration cloning (instantiation bodies) ----------------------------

fn clone_typeast(t: *TypeAst) -> *TypeAst {
  if t == null {
    return null;
  }
  let c: *TypeAst = new TypeAst {
    kind: t.kind, prim: t.prim, path: t.path, targs: t.targs, elem: t.elem,
    params: t.params, ret: t.ret, size: t.size,
    file: t.file, line: t.line, col: t.col,
  };
  // deep-copy the recursive fields; path/string payloads are immutable
  let mut ta: *Vec[*TypeAst] = new Vec[*TypeAst] { items: make([]*TypeAst, 4), n: 0 };
  let mut i: usize = 0;
  while i < t.targs.n {
    ta.push(clone_typeast(t.targs.items[i]));
    i += 1;
  }
  c.targs = ta;
  let mut tp: *Vec[*TypeAst] = new Vec[*TypeAst] { items: make([]*TypeAst, 4), n: 0 };
  i = 0;
  while i < t.params.n {
    tp.push(clone_typeast(t.params.items[i]));
    i += 1;
  }
  c.params = tp;
  c.elem = clone_typeast(t.elem);
  c.ret = clone_typeast(t.ret);
  c.size = clone_expr(t.size);
  return c;
}

fn clone_fieldast(f: *FieldAst) -> *FieldAst {
  if f == null {
    return null;
  }
  return new FieldAst {
    name: f.name, ty: clone_typeast(f.ty), file: f.file, line: f.line, col: f.col,
  };
}

fn clone_param(p: *Param) -> *Param {
  if p == null {
    return null;
  }
  return new Param {
    name: p.name, ty: clone_typeast(p.ty), is_self: p.is_self,
    is_variadic: p.is_variadic,
    file: p.file, line: p.line, col: p.col,
  };
}

fn clone_arm(a: *MatchArm) -> *MatchArm {
  if a == null {
    return null;
  }
  let mut pf: *Vec[*FieldAst] = new Vec[*FieldAst] { items: make([]*FieldAst, 4), n: 0 };
  let mut i: usize = 0;
  while i < a.pat_fields.n {
    pf.push(clone_fieldast(a.pat_fields.items[i]));
    i += 1;
  }
  return new MatchArm {
    pk: a.pk, pat_path: a.pat_path, pat_int: a.pat_int, variant_index: a.variant_index,
    disc: a.disc, pat_str: a.pat_str, pat_names: a.pat_names, pat_fields: pf,
    bind_syms: make([]*Sym, 0), bind_fidx: make([]i64, 0),
    body: clone_expr(a.body), file: a.file, line: a.line, col: a.col,
  };
}

fn clone_stmt(s: *Stmt) -> *Stmt {
  if s == null {
    return null;
  }
  let c: *Stmt = new Stmt {
    kind: s.kind, file: s.file, line: s.line, col: s.col, pre: s.pre,
    mut_: s.mut_, tail: s.tail, name: s.name, ty: clone_typeast(s.ty),
    a: clone_expr(s.a), b: clone_expr(s.b), assign_op: s.assign_op,
    stmts: new Vec[*Stmt] { items: make([]*Stmt, 4), n: 0 },
    cond: clone_expr(s.cond),
    body: new Vec[*Stmt] { items: make([]*Stmt, 4), n: 0 },
  };
  let mut i: usize = 0;
  while i < s.stmts.n {
    c.stmts.push(clone_stmt(s.stmts.items[i]));
    i += 1;
  }
  i = 0;
  while i < s.body.n {
    c.body.push(clone_stmt(s.body.items[i]));
    i += 1;
  }
  return c;
}

fn clone_expr(e: *Expr) -> *Expr {
  if e == null {
    return null;
  }
  let c: *Expr = new Expr {
    kind: e.kind, file: e.file, line: e.line, col: e.col,
    iv: e.iv, fv: e.fv, sv: e.sv, bv: e.bv,
    a: clone_expr(e.a), b: clone_expr(e.b), c: clone_expr(e.c),
    binop: e.binop, unop: e.unop,
    args: new Vec[*Expr] { items: make([]*Expr, 4), n: 0 },
    arg_names: e.arg_names,
    ty: clone_typeast(e.ty),
    arms: new Vec[*MatchArm] { items: make([]*MatchArm, 4), n: 0 },
    params: new Vec[*Param] { items: make([]*Param, 4), n: 0 },
    ret: clone_typeast(e.ret),
    q_ok: e.q_ok, q_err: e.q_err, else_if: clone_expr(e.else_if),
    fnval: e.fnval, caps: make([]*Sym, 0),
    items: new Vec[*Stmt] { items: make([]*Stmt, 4), n: 0 },
    typed: null, sym: null, spread: e.spread,
  };
  let mut i: usize = 0;
  while i < e.args.n {
    c.args.push(clone_expr(e.args.items[i]));
    i += 1;
  }
  i = 0;
  while i < e.arms.n {
    c.arms.push(clone_arm(e.arms.items[i]));
    i += 1;
  }
  i = 0;
  while i < e.params.n {
    c.params.push(clone_param(e.params.items[i]));
    i += 1;
  }
  // NEW field lists: name entries in items alongside args
  if e.kind == ExprKind.ExNew {
    i = 0;
    while i < e.items.n {
      let entry: *Stmt = e.items.items[i];
      let nc: *Stmt = new Stmt {
        kind: StmtKind.StBlock, file: entry.file, line: entry.line, col: entry.col,
        pre: entry.pre, mut_: false, tail: false, name: entry.name, ty: null,
        a: null, b: null, assign_op: entry.assign_op,
        stmts: new Vec[*Stmt] { items: make([]*Stmt, 0), n: 0 },
        cond: null, body: new Vec[*Stmt] { items: make([]*Stmt, 0), n: 0 },
      };
      c.items.push(nc);
      i += 1;
    }
  } else {
    i = 0;
    while i < e.items.n {
      c.items.push(clone_stmt(e.items.items[i]));
      i += 1;
    }
  }
  return c;
}

fn clone_fn_decl(d: *Decl) -> *Decl {
  let c: *Decl = new Decl {
    kind: DeclKind.DkFn, file: d.file, line: d.line, col: d.col, pre: d.pre,
    pub_: d.pub_, is_mut: d.is_mut, name: d.name,
    path: d.path,
    params: new Vec[*Param] { items: make([]*Param, 4), n: 0 },
    ret: clone_typeast(d.ret),
    fields: d.fields, variants: d.variants, init: d.init,
    body: new Vec[*Stmt] { items: make([]*Stmt, 8), n: 0 },
    tparams: make_str_vec(), is_method: d.is_method, recv: d.recv,
    decls: d.decls, target: null, tparam_bounds: d.tparam_bounds, templ: null,
    templated: false, tenv: null, owner: null,
    ceval_ok: false, ceval_is_int: false, ceval_i: 0, ceval_f: 0.0,
  };
  let mut i: usize = 0;
  while i < d.params.n {
    c.params.push(clone_param(d.params.items[i]));
    i += 1;
  }
  i = 0;
  while i < d.body.n {
    c.body.push(clone_stmt(d.body.items[i]));
    i += 1;
  }
  return c;
}

// ---- instantiation ---------------------------------------------------------

static mut g_instantiations: *Vec[*Sym] = 0 as *Vec[*Sym]; // pending body checks
static mut g_instantiated_names: *Vec[string] = 0 as *Vec[string]; // mangled keys
static mut g_instantiated_syms: *Vec[*Sym] = 0 as *Vec[*Sym];
static mut g_instantiation_depth: i32 = 0;

fn make_str_vec() -> *Vec[string] {
  return new Vec[string] { items: make([]string, 8), n: 0 };
}

fn instantiated_get(mangled: string) -> *Sym {
  if g_instantiated_names == null {
    return null;
  }
  let mut i: usize = 0;
  while i < g_instantiated_names.n {
    if streq(g_instantiated_names.items[i], mangled) {
      return g_instantiated_syms.items[i];
    }
    i += 1;
  }
  return null;
}

// resolve a cloned fn symbol's signature under its tenv (boot resolve_sym_type)
fn resolve_inst_signature(sym: *Sym) {
  let d: *Decl = sym.decl;
  let saved_env: *TypeMap = g_tenv;
  let saved_mod: *Module = cur_module;
  cur_module = sym.owner;
  g_tenv = d.tenv;
  let mut ps: []*Type = fresh_type_vec2();
  let mut i: usize = 0;
  while i < d.params.n {
    ps = push_type(ps, resolve_type_in_module(sym.owner, d.params.items[i].ty));
    i += 1;
  }
  let ret: *Type = resolve_type_in_module(sym.owner, d.ret);
  sym.type = ty_fn(ps, ret);
  g_tenv = saved_env;
  cur_module = saved_mod;
}

fn instantiate_fn(gsym: *Sym, names: []string, env: *TypeMap, at: *Expr) -> *Sym {
  let d: *Decl = gsym.decl;
  // mangle in the canonical parameter order so the name is deterministic
  let mut mangled: string = cat3(d.name, "$", "");
  let mut i: usize = 0;
  while i < len(names) {
    let targ: *Type = tm_get(env, names[i]);
    if i > 0 {
      mangled = cat3(mangled, ",", "");
    }
    if targ == null || targ.kind == TypeKind.TyParam {
      err_at(at.file, at.line, at.col, cat5("cannot infer `", names[i], "` for `", d.name, "`"));
      return gsym;
    }
    let mut targ2: *Type = targ;
    if targ2.kind == TypeKind.TyIntLit {
      targ2 = ty_prim(3); // i32
    }
    if targ2.kind == TypeKind.TyFloatLit {
      targ2 = ty_prim(10); // f64
    }
    tm_put(env, names[i], targ2);
    mangled = cat3(mangled, targ2.mangled, "");
    i += 1;
  }
  let existing: *Sym = instantiated_get(mangled);
  if existing != null {
    return existing;
  }
  g_instantiation_depth += 1;
  if g_instantiation_depth > 256 {
    err_at("", 0, 0, "generic instantiation nesting too deep (recursive generics?)");
    g_instantiation_depth -= 1;
    return gsym;
  }
  let clone: *Decl = clone_fn_decl(d);
  clone.name = mangled;
  clone.tenv = env;
  clone.owner = gsym.owner;
  let sym: *Sym = new Sym {
    kind: SymKind.SyFn, name: mangled, type: null, decl: clone,
    mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: gsym.owner,
    module: null,
  trait_rec: null,
  };
  if g_instantiated_names == null {
    g_instantiated_names = new Vec[string] { items: make([]string, 64), n: 0 };
    g_instantiated_syms = new Vec[*Sym] { items: make([]*Sym, 64), n: 0 };
  }
  g_instantiated_names.push(mangled);
  g_instantiated_syms.push(sym);
  let saved_mod: *Module = cur_module;
  let saved_env: *TypeMap = g_tenv;
  cur_module = gsym.owner;
  g_tenv = env;
  resolve_inst_signature(sym);
  g_tenv = saved_env;
  cur_module = saved_mod;
  // register the instantiation in the owner module's symbol table so lower
  // emits it (boot: map_put(&owner->syms, mangled, sym))
  sm_put(gsym.owner.syms, mangled, sym);
  if g_instantiations == null {
    g_instantiations = new Vec[*Sym] { items: make([]*Sym, 64), n: 0 };
  }
  g_instantiations.push(sym);
  g_instantiation_depth -= 1;
  return sym;
}


// ---------------------------------------------------------------- fmt -----
//
// Canonical formatter (port of boot's fmt.c): one style, no configuration.
// `fmt` output is idempotent and reparses to the same AST — both pinned by
// the fmt battery (boot fmt file == stage0 fmt file == stage1 fmt file).

static mut g_sb: *Vec[u8] = 0 as *Vec[u8];
static mut f_indent: i32 = 0;

fn sb_c(c: u8) {
  g_sb.push(c);
}
fn sb_s(s: string) {
  let mut i: usize = 0;
  while i < len(s) {
    g_sb.push(s[i]);
    i += 1;
  }
}
// newline + the current indent (two spaces per level)
fn f_line() {
  sb_c(10);
  let mut i: i32 = 0;
  while i < f_indent {
    sb_s("  ");
    i += 1;
  }
}

// operator spelling for bin/un/assign ops (boot: tok_spell)
fn spell_op(t: Tok) -> string {
  if t == Tok.PPlus { return "+"; }
  if t == Tok.PPluseq { return "+="; }
  if t == Tok.PMinus { return "-"; }
  if t == Tok.PMinuseq { return "-="; }
  if t == Tok.PStar { return "*"; }
  if t == Tok.PStareq { return "*="; }
  if t == Tok.PSlash { return "/"; }
  if t == Tok.PSlasheq { return "/="; }
  if t == Tok.PPercent { return "%"; }
  if t == Tok.PPercenteq { return "%="; }
  if t == Tok.PBang { return "!"; }
  if t == Tok.PTilde { return "~"; }
  if t == Tok.PAmp { return "&"; }
  if t == Tok.PAmpeq { return "&="; }
  if t == Tok.PPipe { return "|"; }
  if t == Tok.PPipeeq { return "|="; }
  if t == Tok.PCaret { return "^"; }
  if t == Tok.PCareteq { return "^="; }
  if t == Tok.PShl { return "<<"; }
  if t == Tok.PShleq { return "<<="; }
  if t == Tok.PShr { return ">>"; }
  if t == Tok.PShreq { return ">>="; }
  if t == Tok.PAndand { return "&&"; }
  if t == Tok.POror { return "||"; }
  if t == Tok.PEq { return "=="; }
  if t == Tok.PNe { return "!="; }
  if t == Tok.PLt { return "<"; }
  if t == Tok.PGt { return ">"; }
  if t == Tok.PLe { return "<="; }
  if t == Tok.PGe { return ">="; }
  if t == Tok.PAssign { return "="; }
  return tok_name(t);
}

fn f_strlit(s: string) {
  sb_c(34); // "
  let mut i: usize = 0;
  while i < len(s) {
    let c: u8 = s[i];
    if c == 10 {
      sb_s("\\n");
    } else if c == 9 {
      sb_s("\\t");
    } else if c == 13 {
      sb_s("\\r");
    } else if c == 92 {
      sb_s("\\\\");
    } else if c == 34 {
      sb_s("\\\"");
    } else if c == 0 {
      sb_s("\\0");
    } else if c < 32 {
      // \x%02x, lowercase hex
      sb_s("\\x");
      let hi: u8 = c >> 4;
      let lo: u8 = c & 15;
      if hi < 10 { sb_c(48 + hi); } else { sb_c(87 + hi); }
      if lo < 10 { sb_c(48 + lo); } else { sb_c(87 + lo); }
    } else {
      sb_c(c);
    }
    i += 1;
  }
  sb_c(34);
}

// can the value take the canonical multiline form without changing a
// byte? The form prints the value's own bytes between the delimiters, so
// the value itself must carry the block's shape: it opens with the
// newline that follows the opener, every interior line is indented at
// least `col` columns, and the last line is exactly `col` spaces — the
// line the closing """ rides. Anything else stays single-line escaped.
fn ml_representable(s: string, col: i32) -> bool {
  let ind: usize = col as usize;
  if len(s) < ind + 1 || s[0] != 10 {
    return false;
  }
  let mut last_nl: usize = 0;
  let mut i: usize = 1;
  while i < len(s) {
    if s[i] == 10 {
      last_nl = i;
    }
    i += 1;
  }
  if len(s) - last_nl - 1 != ind {
    return false;
  }
  let mut k: usize = last_nl + 1;
  while k < len(s) {
    if s[k] != 32 {
      return false;
    }
    k += 1;
  }
  let mut a: usize = 1;
  while a < last_nl {
    let mut e: usize = a;
    while s[e] != 10 {
      e += 1;
    }
    let mut ws: usize = 0;
    while ws < ind && a + ws < e && s[a + ws] == 32 {
      ws += 1;
    }
    if ws < ind {
      return false;
    }
    a = e + 1;
  }
  return true;
}

// emit the value's bytes for the multiline form: newlines are printed
// raw (they draw the block's lines), everything else escapes as in
// f_strlit. Quotes: a run of three or more must keep any three RAW
// quotes from appearing in the output — an unescaped """ closes the
// literal — so every third quote of a run is written escaped: \"""
// decodes to """ and no raw run exceeds two.
fn f_ml_bytes(s: string, from: usize, to: usize) {
  let mut i: usize = from;
  let mut run: usize = 0;
  while i < to {
    let c: u8 = s[i];
    if c == 34 {
      run += 1;
      if run % 3 == 0 {
        sb_s("\\\"");
      } else {
        sb_c(34);
      }
      i += 1;
      continue;
    }
    run = 0;
    if c == 10 {
      sb_c(10);
    } else if c == 9 {
      sb_s("\\t");
    } else if c == 13 {
      sb_s("\\r");
    } else if c == 92 {
      sb_s("\\\\");
    } else if c == 0 {
      sb_s("\\0");
    } else if c < 32 {
      sb_s("\\x");
      let hi: u8 = c >> 4;
      let lo: u8 = c & 15;
      if hi < 10 { sb_c(48 + hi); } else { sb_c(87 + hi); }
      if lo < 10 { sb_c(48 + lo); } else { sb_c(87 + lo); }
    } else {
      sb_c(c);
    }
    i += 1;
  }
}

// the fmt form of a string literal: values without newlines (and values
// the multiline form cannot carry byte-exactly) stay single-line escaped;
// everything else becomes a canonical triple-quoted block — opener where
// the literal sits, then the value's own bytes: its newlines draw the
// block's lines, its indentation is the block's indent, and its final
// line of spaces carries the closing delimiter. Nothing is added and
// nothing is stripped — anything fmt added would be content — so the
// block reparses to the same value byte for byte.
fn f_strlit_fmt(s: string) {
  if !ml_representable(s, (f_indent + 1) * 2) {
    f_strlit(s);
    return;
  }
  sb_s("\"\"\"");
  f_ml_bytes(s, 0, len(s));
  sb_s("\"\"\"");
}

fn f_type(t: *TypeAst) {
  if t == null {
    return;
  }
  if t.kind == TypeAstKind.TaPrim {
    sb_s(prim_name(t.prim));
    return;
  }
  if t.kind == TypeAstKind.TaArray {
    if t.size != null {
      sb_c(91); // [
      f_expr(t.size);
      sb_c(93); // ]
    } else {
      sb_s("[]");
    }
    f_type(t.elem);
    return;
  }
  if t.kind == TypeAstKind.TaPtr {
    sb_c(42); // *
    f_type(t.elem);
    return;
  }
  if t.kind == TypeAstKind.TaWeak {
    sb_s("weak[");
    f_type(t.elem);
    sb_c(93);
    return;
  }
  if t.kind == TypeAstKind.TaNamed {
    let mut i: usize = 0;
    while i < t.path.n {
      if i > 0 {
        sb_c(46); // .
      }
      sb_s(t.path.items[i]);
      i += 1;
    }
    if t.targs.n > 0 {
      sb_c(91);
      let mut j: usize = 0;
      while j < t.targs.n {
        if j > 0 {
          sb_s(", ");
        }
        f_type(t.targs.items[j]);
        j += 1;
      }
      sb_c(93);
    }
    return;
  }
  // TaFn
  sb_s("fn(");
  let mut i: usize = 0;
  while i < t.params.n {
    if i > 0 {
      sb_s(", ");
    }
    f_type(t.params.items[i]);
    i += 1;
  }
  sb_c(41); // )
  if t.ret != null {
    sb_s(" -> ");
    f_type(t.ret);
  }
}

// expressions print without precedence machinery: binary/unary ops always
// get parens (boot relies on the same shape — its parent_bp is dead too)
fn f_expr(e: *Expr) {
  if e.kind == ExprKind.ExInt {
    sb_s(utoa(e.iv));
    return;
  }
  if e.kind == ExprKind.ExFloat {
    fmt_float(e.fv);
    return;
  }
  if e.kind == ExprKind.ExStr {
    f_strlit_fmt(e.sv);
    return;
  }
  if e.kind == ExprKind.ExBool {
    if e.bv { sb_s("true"); } else { sb_s("false"); }
    return;
  }
  if e.kind == ExprKind.ExNull {
    sb_s("null");
    return;
  }
  if e.kind == ExprKind.ExName {
    sb_s(e.sv);
    return;
  }
  if e.kind == ExprKind.ExType {
    f_type(e.ty);
    return;
  }
  if e.kind == ExprKind.ExBin {
    sb_c(40); // (
    f_expr(e.a);
    sb_c(32);
    sb_s(spell_op(e.binop));
    sb_c(32);
    f_expr(e.b);
    sb_c(41); // )
    return;
  }
  if e.kind == ExprKind.ExUn {
    sb_c(40);
    sb_s(spell_op(e.unop));
    f_expr(e.a);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExCall {
    f_expr(e.a);
    sb_c(40);
    let mut i: usize = 0;
    while i < e.args.n {
      if i > 0 {
        sb_s(", ");
      }
      if e.arg_names != null && i < e.arg_names.n && e.arg_names.items[i] != "" {
        sb_s(e.arg_names.items[i]);
        sb_s(": ");
      }
      f_expr(e.args.items[i]);
      i += 1;
    }
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExIndex {
    f_expr(e.a);
    sb_c(91);
    f_expr(e.b);
    sb_c(93);
    return;
  }
  if e.kind == ExprKind.ExSlice {
    f_expr(e.a);
    sb_c(91);
    f_expr(e.b);
    sb_s("..");
    f_expr(e.c);
    sb_c(93);
    return;
  }
  if e.kind == ExprKind.ExField {
    f_expr(e.a);
    sb_c(46);
    sb_s(e.sv);
    return;
  }
  if e.kind == ExprKind.ExCast {
    f_expr(e.a);
    sb_s(" as ");
    f_type(e.ty);
    return;
  }
  if e.kind == ExprKind.ExNew {
    sb_s("new ");
    f_type(e.ty);
    sb_s(" { ");
    let mut i: usize = 0;
    while i < e.args.n {
      if i > 0 {
        sb_s(", ");
      }
      sb_s(e.items.items[i].name);
      sb_s(": ");
      f_expr(e.args.items[i]);
      i += 1;
    }
    sb_s(" }");
    return;
  }
  if e.kind == ExprKind.ExMake {
    sb_s("make(");
    f_type(e.ty);
    sb_s(", ");
    f_expr(e.c);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExClosure {
    sb_s("fn(");
    let mut i: usize = 0;
    while i < e.params.n {
      if i > 0 {
        sb_s(", ");
      }
      sb_s(e.params.items[i].name);
      sb_s(": ");
      f_type(e.params.items[i].ty);
      i += 1;
    }
    sb_c(41);
    if e.ret != null {
      sb_s(" -> ");
      f_type(e.ret);
    }
    sb_s(" {");
    f_indent += 1;
    f_stmts(e.items);
    f_indent -= 1;
    f_line();
    sb_c(125); // }
    return;
  }
  if e.kind == ExprKind.ExMatch {
    f_match_full(e);
    return;
  }
  if e.kind == ExprKind.ExQmark {
    f_expr(e.a);
    sb_c(63); // ?
    return;
  }
  if e.kind == ExprKind.ExIf {
    f_if_full(e);
    return;
  }
  // ExEnumCtor / ExMethod / ExBlock: post-parse placeholders, same as boot
  sb_s("...");
}

// full expression printing — if/match get real block bodies
fn f_expr_full(e: *Expr) {
  if e.kind == ExprKind.ExIf {
    f_if_full(e);
    return;
  }
  if e.kind == ExprKind.ExMatch {
    f_match_full(e);
    return;
  }
  f_expr(e);
}

fn f_if_full(e: *Expr) {
  sb_s("if ");
  f_expr_full(e.a);
  sb_s(" {");
  f_indent += 1;
  f_stmts(e.items.items[0].stmts);
  f_indent -= 1;
  f_line();
  if e.else_if != null {
    sb_s("} else ");
    f_if_full(e.else_if);
    return;
  }
  if e.items.n > 1 {
    sb_s("} else ");
    sb_c(123); // {
    f_indent += 1;
    f_stmts(e.items.items[1].stmts);
    f_indent -= 1;
    f_line();
  }
  sb_c(125); // }
}

fn f_pat_path(arm: *MatchArm) {
  let mut j: usize = 0;
  while j < arm.pat_path.n {
    if j > 0 {
      sb_c(46); // .
    }
    sb_s(arm.pat_path.items[j]);
    j += 1;
  }
}

fn f_match_full(e: *Expr) {
  sb_s("match ");
  f_expr_full(e.a);
  sb_s(" {");
  f_indent += 1;
  let mut i: usize = 0;
  while i < e.arms.n {
    let arm: *MatchArm = e.arms.items[i];
    f_line();
    if arm.pk == PatKind.PatWildcard {
      sb_s("_");
    } else if arm.pk == PatKind.PatInt {
      sb_s(utoa(arm.pat_int));
    } else if arm.pk == PatKind.PatStr {
      f_strlit_fmt(arm.pat_str);
    } else if arm.pk == PatKind.PatTuple {
      f_pat_path(arm);
      sb_c(40);
      let mut j: usize = 0;
      while j < arm.pat_names.n {
        if j > 0 {
          sb_s(", ");
        }
        sb_s(arm.pat_names.items[j]);
        j += 1;
      }
      sb_c(41);
    } else if arm.pk == PatKind.PatStruct {
      f_pat_path(arm);
      sb_s(" { ");
      let mut j: usize = 0;
      while j < arm.pat_fields.n {
        if j > 0 {
          sb_s(", ");
        }
        sb_s(arm.pat_fields.items[j].name);
        sb_s(": ");
        sb_s(arm.pat_names.items[j]);
        j += 1;
      }
      sb_s(" }");
    } else {
      f_pat_path(arm);
    }
    sb_s(" => ");
    if arm.body.kind == ExprKind.ExBlock {
      sb_c(123);
      f_indent += 1;
      f_stmts(arm.body.items);
      f_indent -= 1;
      f_line();
      sb_c(125);
    } else {
      f_expr_full(arm.body);
    }
    sb_c(44); // ,
    i += 1;
  }
  f_indent -= 1;
  f_line();
  sb_c(125);
}

fn f_stmt(s: *Stmt) {
  f_pre(s.pre);
  if s.kind == StmtKind.StLet {
    sb_s("let ");
    if s.mut_ {
      sb_s("mut ");
    }
    sb_s(s.name);
    if s.ty != null {
      sb_s(": ");
      f_type(s.ty);
    }
    sb_s(" = ");
    f_expr_full(s.a);
    if !s.tail {
      sb_c(59); // ;
    }
    return;
  }
  if s.kind == StmtKind.StAssign {
    f_expr_full(s.a);
    sb_c(32);
    sb_s(spell_op(s.assign_op));
    sb_c(32);
    f_expr_full(s.b);
    sb_c(59);
    return;
  }
  if s.kind == StmtKind.StExpr {
    f_expr_full(s.a);
    if !s.tail && s.a.kind != ExprKind.ExIf && s.a.kind != ExprKind.ExMatch &&
       s.a.kind != ExprKind.ExBlock {
      sb_c(59);
    }
    return;
  }
  if s.kind == StmtKind.StReturn {
    sb_s("return");
    if s.a != null {
      sb_c(32);
      f_expr_full(s.a);
    }
    sb_c(59);
    return;
  }
  if s.kind == StmtKind.StBreak {
    sb_s("break;");
    return;
  }
  if s.kind == StmtKind.StContinue {
    sb_s("continue;");
    return;
  }
  if s.kind == StmtKind.StDefer {
    sb_s("defer ");
    if s.stmts.n == 1 && s.stmts.items[0].kind == StmtKind.StBlock {
      let blk: *Stmt = s.stmts.items[0];
      sb_c(123);
      f_indent += 1;
      f_stmts(blk.stmts);
      f_indent -= 1;
      f_line();
      sb_c(125);
    } else {
      let mut i: usize = 0;
      while i < s.stmts.n {
        f_stmt(s.stmts.items[i]);
        i += 1;
      }
    }
    return;
  }
  if s.kind == StmtKind.StWhile {
    sb_s("while ");
    f_expr_full(s.cond);
    sb_s(" {");
    f_indent += 1;
    f_stmts(s.body);
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  if s.kind == StmtKind.StLoop {
    sb_s("loop {");
    f_indent += 1;
    f_stmts(s.body);
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  // StBlock
  sb_c(123);
  f_indent += 1;
  f_stmts(s.stmts);
  f_indent -= 1;
  f_line();
  sb_c(125);
}

fn f_stmts(stmts: *Vec[*Stmt]) {
  let mut i: usize = 0;
  while i < stmts.n {
    f_line();
    f_stmt(stmts.items[i]);
    i += 1;
  }
}

// leading line comments, re-emitted at the current indent
fn f_pre(pre: *Vec[string]) {
  if pre == null {
    return;
  }
  let mut i: usize = 0;
  while i < pre.n {
    sb_s("//");
    sb_s(pre.items[i]);
    f_line();
    i += 1;
  }
}

fn f_tparams(tparams: *Vec[string]) {
  if tparams == null || tparams.n == 0 {
    return;
  }
  sb_c(91); // [
  let mut i: usize = 0;
  while i < tparams.n {
    if i > 0 {
      sb_s(", ");
    }
    sb_s(tparams.items[i]);
    i += 1;
  }
  sb_c(93); // ]
}

fn f_params(params: *Vec[*Param]) {
  sb_c(40); // (
  let mut i: usize = 0;
  while i < params.n {
    if i > 0 {
      sb_s(", ");
    }
    sb_s(params.items[i].name);
    sb_s(": ");
    f_type(params.items[i].ty);
    i += 1;
  }
  sb_c(41); // )
}

fn f_decl(d: *Decl) {
  f_pre(d.pre);
  if d.kind == DeclKind.DkUse {
    sb_s("use ");
    let mut i: usize = 0;
    while i < d.path.n {
      if i > 0 {
        sb_c(47); // /
      }
      sb_s(d.path.items[i]);
      i += 1;
    }
    sb_c(59);
    return;
  }
  if d.kind == DeclKind.DkExtern {
    sb_s("extern fn ");
    sb_s(d.name);
    f_params(d.params);
    if d.ret != null {
      sb_s(" -> ");
      f_type(d.ret);
    }
    sb_c(59);
    return;
  }
  if d.kind == DeclKind.DkFn {
    if d.pub_ {
      sb_s("pub ");
    }
    sb_s("fn ");
    if len(d.recv) > 0 {
      sb_s(d.recv);
      sb_c(46);
    }
    sb_s(d.name);
    f_tparams(d.tparams);
    f_params(d.params);
    if d.ret != null {
      sb_s(" -> ");
      f_type(d.ret);
    }
    sb_s(" {");
    f_indent += 1;
    f_stmts(d.body);
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  if d.kind == DeclKind.DkStruct {
    if d.pub_ {
      sb_s("pub ");
    }
    sb_s("struct ");
    sb_s(d.name);
    f_tparams(d.tparams);
    if d.fields.n == 0 {
      sb_s(" {}");
      return;
    }
    sb_s(" {");
    f_indent += 1;
    let mut i: usize = 0;
    while i < d.fields.n {
      f_line();
      sb_s(d.fields.items[i].name);
      sb_s(": ");
      f_type(d.fields.items[i].ty);
      sb_c(44);
      i += 1;
    }
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  if d.kind == DeclKind.DkEnum {
    if d.pub_ {
      sb_s("pub ");
    }
    sb_s("enum ");
    sb_s(d.name);
    f_tparams(d.tparams);
    sb_s(" {");
    f_indent += 1;
    let mut i: usize = 0;
    while i < d.variants.n {
      let v: *VariantAst = d.variants.items[i];
      f_line();
      sb_s(v.name);
      if v.vkind == VarKind.VarTuple {
        sb_c(40);
        let mut j: usize = 0;
        while j < v.types.n {
          if j > 0 {
            sb_s(", ");
          }
          f_type(v.types.items[j]);
          j += 1;
        }
        sb_c(41);
      } else if v.vkind == VarKind.VarStruct {
        sb_s(" { ");
        let mut j: usize = 0;
        while j < v.fields.n {
          if j > 0 {
            sb_s(", ");
          }
          sb_s(v.fields.items[j].name);
          sb_s(": ");
          f_type(v.fields.items[j].ty);
          j += 1;
        }
        sb_s(" }");
      }
      if v.has_disc {
        sb_s(" = ");
        sb_s(utoa(v.disc));
      }
      sb_c(44);
      i += 1;
    }
    f_indent -= 1;
    f_line();
    sb_c(125);
    return;
  }
  if d.kind == DeclKind.DkStatic {
    sb_s("static ");
    if d.is_mut {
      sb_s("mut ");
    }
    sb_s(d.name);
    sb_s(": ");
    f_type(d.ret);
    sb_s(" = ");
    f_expr_full(d.init);
    sb_c(59);
    return;
  }
  // DkConst
  sb_s("const ");
  sb_s(d.name);
  sb_s(": ");
  f_type(d.ret);
  sb_s(" = ");
  f_expr_full(d.init);
  sb_c(59);
}

fn fmt_module(module: *Decl) -> string {
  g_sb = new Vec[u8] { items: make([]u8, 65536), n: 0 };
  f_indent = 0;
  let mut first: bool = true;
  let mut i: usize = 0;
  while i < module.decls.n {
    let d: *Decl = module.decls.items[i];
    if !first {
      sb_c(10);
    }
    f_decl(d);
    sb_c(10);
    first = false;
    i += 1;
  }
  if module.pre != null && module.pre.n > 0 {
    f_pre(module.pre);
    // f_pre leaves the cursor on a fresh line; close it
    sb_c(10);
  }
  return intrinsics.slice_string(g_sb.items[0..g_sb.n]);
}


// ------------------------------------------------------ %g, six digits ----
//
// The EX_FLOAT canonical form: C printf("%g") of the literal's value.
// Implemented exactly — the double's bit pattern is decomposed and rounded
// as a big decimal integer, so the 6-significant-digit rounding matches
// libc for every finite input (no float arithmetic on the value itself).

// decimal big-int, base 1e9, little-endian limbs; 160 limbs (1440 digits)
// covers 5^1074 * 2^53 with room to spare
struct Big {
  w: []u32,
  n: usize,
}

fn big_new() -> *Big {
  return new Big { w: make([]u32, 160), n: 1 };
}

fn big_trim(b: *Big) {
  while b.n > 1 && b.w[b.n - 1] == 0 {
    b.n -= 1;
  }
}

fn big_set_u64(b: *Big, v: u64) {
  b.w[0] = (v % 1000000000) as u32;
  b.w[1] = ((v / 1000000000) % 1000000000) as u32;
  b.w[2] = (v / 1000000000000000000) as u32;
  b.n = 3;
  big_trim(b);
}

// schoolbook multiply by a factor < 1e9; products stay under 2^63
fn big_mul_u32(b: *Big, m: u32) {
  let mut carry: u64 = 0;
  let mut i: usize = 0;
  while i < b.n {
    let cur: u64 = b.w[i] as u64 * m as u64 + carry;
    b.w[i] = (cur % 1000000000) as u32;
    carry = cur / 1000000000;
    i += 1;
  }
  while carry > 0 {
    b.w[b.n] = (carry % 1000000000) as u32;
    carry = carry / 1000000000;
    b.n += 1;
  }
}

fn big_get_u64(b: *Big) -> u64 {
  let mut v: u64 = 0;
  let mut i: usize = b.n;
  while i > 0 {
    i -= 1;
    v = v * 1000000000 + b.w[i] as u64;
  }
  return v;
}

// add a single-digit value (< 10) to the low limb
fn big_add_u32(b: *Big, v: u32) {
  b.w[0] = b.w[0] + v;
  let mut i: usize = 0;
  while b.w[i] >= 1000000000 {
    b.w[i] = b.w[i] - 1000000000;
    i += 1;
    b.w[i] = b.w[i] + 1;
  }
  if i >= b.n {
    b.n = i + 1;
  }
}

// floor(a * 2^bits / b) rounded half-even on the exact remainder; `a` is
// consumed, `b` must exceed the remainder at every step (b > 0, a < b)
fn big_div_bits(a: *Big, b: *Big, bits: i64) -> u64 {
  let mut q: u64 = 0;
  let mut j: i64 = 0;
  while j < bits {
    big_mul_u32(a, 2);
    q = q * 2;
    if big_cmp(a, b) >= 0 {
      big_sub(a, b);
      q += 1;
    }
    j += 1;
  }
  big_mul_u32(a, 2);
  let c: i32 = big_cmp(a, b);
  if c > 0 || (c == 0 && (q & 1) == 1) {
    q += 1;
  }
  return q;
}

// a -= b in place; caller guarantees a >= b
fn big_sub(a: *Big, b: *Big) {  let mut borrow: i64 = 0;
  let mut i: usize = 0;
  while i < a.n {
    let sub: i64 = borrow;
    let mut cur: i64 = a.w[i] as i64 - sub;
    if i < b.n {
      cur = a.w[i] as i64 - b.w[i] as i64 - borrow;
    }
    if cur < 0 {
      cur += 1000000000;
      borrow = 1;
    } else {
      borrow = 0;
    }
    a.w[i] = cur as u32;
    i += 1;
  }
  big_trim(a);
}

fn big_add_one(b: *Big) {
  let mut i: usize = 0;
  loop {
    if i >= b.n {
      b.w[i] = 1;
      b.n += 1;
      return;
    }
    b.w[i] = b.w[i] + 1;
    if b.w[i] < 1000000000 {
      return;
    }
    b.w[i] = 0;
    i += 1;
  }
}

fn big_clone(a: *Big) -> *Big {
  let b: *Big = big_new();
  let mut i: usize = 0;
  while i < a.n {
    b.w[i] = a.w[i];
    i += 1;
  }
  b.n = a.n;
  return b;
}

fn big_cmp(a: *Big, b: *Big) -> i32 {
  if a.n != b.n {
    if a.n < b.n {
      return 0 - 1;
    }
    return 1;
  }
  let mut i: usize = a.n;
  while i > 0 {
    i -= 1;
    if a.w[i] != b.w[i] {
      if a.w[i] < b.w[i] {
        return 0 - 1;
      }
      return 1;
    }
  }
  return 0;
}

fn p10_u64(r: usize) -> u64 {
  let mut v: u64 = 1;
  let mut i: usize = 0;
  while (i as i64) < r as i64 {
    v = v * 10;
    i += 1;
  }
  return v;
}

fn pow2_u32(k: i64) -> u32 {
  let mut v: u32 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 2;
    i += 1;
  }
  return v;
}

fn pow5_u32(k: i64) -> u32 {
  let mut v: u32 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 5;
    i += 1;
  }
  return v;
}

// 5 * 10^(cut-1): half of the divisor 10^cut
fn big_half(cut: usize) -> *Big {
  let h: *Big = big_new();
  let pos: usize = cut - 1;
  let l: usize = pos / 9;
  let r: usize = pos % 9;
  h.w[l] = (5 * p10_u64(r)) as u32;
  h.n = l + 1;
  return h;
}

// Q = N div 10^cut (returned); N becomes N mod 10^cut
fn big_divmod_pow10(b: *Big, cut: usize) -> *Big {
  let l: usize = cut / 9;
  let r: usize = cut % 9;
  let q: *Big = big_new();
  if b.n <= l {
    return q;
  }
  let qn: usize = b.n - l;
  let p: u64 = p10_u64(r);
  let mut rem: u64 = 0;
  let mut i: usize = qn;
  while i > 0 {
    i -= 1;
    let cur: u64 = rem * 1000000000 + b.w[l + i] as u64;
    q.w[i] = (cur / p) as u32;
    rem = cur % p;
  }
  q.n = qn;
  big_trim(q);
  if r > 0 {
    b.w[l] = rem as u32;
    b.n = l + 1;
  } else {
    b.n = l;
  }
  if b.n == 0 {
    b.w[0] = 0;
    b.n = 1;
  }
  big_trim(b);
  return q;
}

fn u32_digits(v: u32) -> i64 {
  let mut d: i64 = 1;
  let mut x: u32 = v;
  while x >= 10 {
    x = x / 10;
    d += 1;
  }
  return d;
}

fn substr(s: string, a: usize, b: usize) -> string {
  let buf: []u8 = make([]u8, b - a);
  let mut i: usize = a;
  while i < b {
    buf[i - a] = s[i];
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

// strip trailing '0's ("1000" -> "1", "000" -> "")
fn g6_strip(fr: string) -> string {
  let mut k: usize = len(fr);
  while k > 0 && fr[k - 1] == 48 {
    k -= 1;
  }
  return substr(fr, 0, k);
}

fn rep0(cnt: usize) -> string {
  let buf: []u8 = make([]u8, cnt);
  let mut i: usize = 0;
  while i < cnt {
    buf[i] = 48;
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

fn g_digits(x: f64, prec: i64) -> string {
  let bits: u64 = intrinsics.f64_bits(x);
  let be: u64 = (bits >> 52) & 2047;
  if be == 2047 {
    if (bits & 4503599627370495) == 0 {
      return "inf";
    }
    return "nan";
  }
  if (bits << 1) == 0 {
    return "0";
  }
  let mut m2: u64 = 0;
  let mut e2: i64 = 0;
  if be == 0 {
    m2 = bits & 4503599627370495;
    e2 = (0 - 1074) as i64;
  } else {
    m2 = (bits & 4503599627370495) | 4503599627370496;
    e2 = be as i64 - 1075;
  }
  // exact integer N with x == N / 10^s
  let b: *Big = big_new();
  big_set_u64(b, m2);
  let mut s: i64 = 0;
  if e2 >= 0 {
    let mut k: i64 = e2;
    while k >= 29 {
      big_mul_u32(b, 536870912);
      k -= 29;
    }
    if k > 0 {
      big_mul_u32(b, pow2_u32(k));
    }
  } else {
    // x = m2 * 2^-k = (m2 * 5^k) / 10^k — powers of FIVE: multiplying by
    // powers of ten here would smuggle extra factors of two into N
    let mut k: i64 = 0 - e2;
    while k >= 9 {
      big_mul_u32(b, 1953125);
      s += 9;
      k -= 9;
    }
    if k > 0 {
      big_mul_u32(b, pow5_u32(k));
      s += k;
    }
  }
  // n: x = 0.<digits> * 10^n; cut at `prec` significant digits
  let topd: i64 = u32_digits(b.w[b.n - 1]);
  let mut n: i64 = (b.n as i64 - 1) * 9 + topd - s;
  let cut: i64 = s + n - prec;
  let mut qv: u64 = 0;
  if cut > 0 {
    let q: *Big = big_divmod_pow10(b, cut as usize);
    // round half to even on the exact remainder
    let c: i32 = big_cmp(b, big_half(cut as usize));
    if c > 0 || (c == 0 && (q.w[0] & 1) == 1) {
      big_add_one(q);
    }
    qv = big_get_u64(q);
  } else if cut == 0 {
    qv = big_get_u64(b);
  } else {
    let mut k: i64 = 0 - cut;
    while k >= 9 {
      big_mul_u32(b, 1000000000);
      k -= 9;
    }
    if k > 0 {
      big_mul_u32(b, p10_u64(k as usize) as u32);
    }
    qv = big_get_u64(b);
  }
  // round-up carry: 999...9.7 -> 10^prec -> re-exponent
  if qv >= p10_u64(prec as usize) {
    qv = qv / 10;
    n += 1;
  }
  let e10: i64 = n - 1;
  let ds: string = utoa(qv);
  if e10 >= (0 - 4) as i64 && e10 < prec {
    if e10 >= 0 {
      let ip: usize = e10 as usize + 1;
      let frac: string = g6_strip(substr(ds, ip, prec as usize));
      if len(frac) == 0 {
        return substr(ds, 0, ip);
      }
      return cat3(substr(ds, 0, ip), cat3(".", frac, ""), "");
    }
    let all: string = g6_strip(cat3(rep0((0 - e10 - 1) as usize), ds, ""));
    if len(all) == 0 {
      return "0";
    }
    return cat3("0.", all, "");
  }
  let mut out: string = substr(ds, 0, 1);
  let frac: string = g6_strip(substr(ds, 1, prec as usize));
  if len(frac) > 0 {
    out = cat3(out, cat3(".", frac, ""), "");
  }
  let mut ae: i64 = e10;
  if ae < 0 {
    ae = 0 - ae;
  }
  let mut es: string = itoa(ae);
  if ae < 10 {
    es = cat3("0", es, "");
  }
  if e10 < 0 {
    return cat3(out, cat3("e-", es, ""), "");
  }
  return cat3(out, cat3("e+", es, ""), "");
}

fn g6(x: f64) -> string {
  return g_digits(x, 6);
}

fn fmt_float(x: f64) {
  let s: string = g6(x);
  sb_s(s);
  // keep it a float literal: no '.' or 'e' in the %g form means append ".0"
  let mut i: usize = 0;
  while i < len(s) {
    if s[i] == 46 || s[i] == 101 {
      return;
    }
    i += 1;
  }
  sb_s(".0");
}
