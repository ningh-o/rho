  mov x0, #0
  sub x0, x0, #100
  mov x8, #56
  svc #0
  ret
.globl close
close:
  mov x8, #57
  svc #0
  ret
.globl rename
rename:
  mov x2, x1
  mov x1, x0
  mov x0, #0
  sub x0, x0, #100
  mov x8, #38
  svc #0
  ret
.globl _NSGetArgc
_NSGetArgc:
