// rho — the self-hosted compiler (0.1.0).
//
// One file, one module: the whole compiler, written in the frozen 0.0.5
// language surface. Bootstrap invariant (spec §13): boot(self) == self(self)
// byte for byte, and boot(corpus) == self(corpus).

extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);
extern fn open(path: *u8, flags: i32, mode: i32) -> i32;
extern fn read(fd: i32, buf: *u8, n: usize) -> isize;
extern fn close(fd: i32) -> i32;

// rho's main takes no arguments; the bootstrap driver pulls argv from
// libSystem (arm64-mac target; other hosts provide their own accessors)
extern fn _NSGetArgc() -> *i32;
extern fn _NSGetArgv() -> **u8;

fn program_args() -> []string {
  let count: usize = (*_NSGetArgc()) as usize;
  let raw: *u8 = *_NSGetArgv(); // char**
  let args: []string = make([]string, count);
  let mut i: usize = 0;
  while i < count {
    let s: *u8 = (intrinsics.load_u64((raw as usize + i * 8) as *u8) as usize) as *u8;
    args[i] = str_from_c(s);
    i += 1;
  }
  return args;
}

// read a NUL-terminated C string out of foreign memory
fn str_from_c(p: *u8) -> string {
  let mut n: usize = 0;
  loop {
    if intrinsics.load_u8((p as usize + n) as *u8) == 0 {
      break;
    }
    n += 1;
  }
  let buf: []u8 = make([]u8, n);
  let mut i: usize = 0;
  while i < n {
    buf[i] = intrinsics.load_u8((p as usize + i) as *u8);
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

// ---------------------------------------------------------------- bytes ---

// NUL-terminated copy for extern calls; returns the owning slice so the
// buffer outlives the call — a raw *u8 would dangle the moment this returns
fn cstr(s: string) -> []u8 {
  let buf: []u8 = make([]u8, len(s) + 1);
  let mut i: usize = 0;
  while i < len(s) {
    buf[i] = s[i];
    i += 1;
  }
  buf[len(s)] = 0;
  return buf;
}

fn itoa(v: i64) -> string {
  let buf: []u8 = make([]u8, 24);
  let mut n: usize = 24;
  let mut x: i64 = v;
  let neg: bool = x < 0;
  if neg {
    x = 0 - x;
  }
  loop {
    n -= 1;
    buf[n] = (48 + x % 10) as u8;
    x /= 10;
    if x == 0 {
      break;
    }
  }
  if neg {
    n -= 1;
    buf[n] = 45;
  }
  return intrinsics.slice_string(buf[n..24]);
}

// ---------------------------------------------------------------- vec ---

struct Vec[T] {
  items: []T,
  n: usize,
}

fn Vec.init(self: *Vec) {
  self.items = make([]T, 8);
  self.n = 0;
}

// growth through a helper: ownership transfers at the call boundary, which
// the rc machinery accounts cleanly
fn grow_to[T](items: []T) -> []T {
  let grown: []T = make([]T, len(items) * 2);
  let mut i: usize = 0;
  while i < len(items) {
    grown[i] = items[i];
    i += 1;
  }
  return grown;
}

fn Vec.push(self: *Vec, v: T) {
  if self.n == len(self.items) {
    self.items = grow_to(self.items);
  }
  self.items[self.n] = v;
  self.n += 1;
}

fn Vec.last(self: *Vec) -> T {
  return self.items[self.n - 1];
}

fn Vec.pop(self: *Vec) -> T {
  self.n -= 1;
  return self.items[self.n];
}

// ---------------------------------------------------------------- map ---

// Open-addressing string map, FNV-1a with a fixed seed: iteration follows
// insertion order via the keys vector, so compile output never depends on
// hash placement (spec §11.4).
struct Map[V] {
  slots: []*MapEnt[V],
  cap: usize,
  n: usize,
  keys: Vec[string],
}

struct MapEnt[V] {
  key: string,
  val: V,
  used: bool,
}

fn map_hash(s: string) -> usize {
  let mut h: u64 = 1469598103934665603;
  let mut i: usize = 0;
  while i < len(s) {
    h ^= s[i] as u64;
    h *= 1099511628211;
    i += 1;
  }
  return h as usize;
}

// get() is only valid after has(); there is no zero value of V
fn Map.get(self: *Map, key: string) -> V {
  assert(self.has(key));
  let mut i: usize = map_hash(key) & (self.cap - 1);
  while self.slots[i] != null {
    if streq(self.slots[i].key, key) {
      return self.slots[i].val;
    }
    i = (i + 1) & (self.cap - 1);
  }
  panic("map.get: missing key");
}

fn Map.has(self: *Map, key: string) -> bool {
  if self.cap == 0 {
    return false;
  }
  let mut i: usize = map_hash(key) & (self.cap - 1);
  while self.slots[i] != null {
    if streq(self.slots[i].key, key) {
      return true;
    }
    i = (i + 1) & (self.cap - 1);
  }
  return false;
}

fn Map.put(self: *Map, key: string, val: V) {
  if self.n * 10 >= self.cap * 7 {
    let ncap: usize = if self.cap == 0 { 16 } else { self.cap * 2 };
    let slots: []*MapEnt[V] = make([]*MapEnt[V], ncap);
    let old: []*MapEnt[V] = self.slots;
    let oldn: usize = self.cap;
    self.slots = slots;
    self.cap = ncap;
    self.n = 0;
    let mut i: usize = 0;
    while i < oldn {
      if old[i] != null {
        self.put(old[i].key, old[i].val);
      }
      i += 1;
    }
  }
  let mut i: usize = map_hash(key) & (self.cap - 1);
  while self.slots[i] != null {
    if streq(self.slots[i].key, key) {
      self.slots[i].val = val;
      return;
    }
    i = (i + 1) & (self.cap - 1);
  }
  let ent: *MapEnt[V] = new MapEnt[V] { key: key, val: val, used: true };
  self.slots[i] = ent;
  self.n += 1;
  self.keys.push(key);
}

fn streq(a: string, b: string) -> bool {
  if len(a) != len(b) {
    return false;
  }
  let mut i: usize = 0;
  while i < len(a) {
    if a[i] != b[i] {
      return false;
    }
    i += 1;
  }
  return true;
}

fn cat(a: string, b: string) -> string {
  let buf: []u8 = make([]u8, len(a) + len(b));
  let mut i: usize = 0;
  while i < len(a) {
    buf[i] = a[i];
    i += 1;
  }
  let mut j: usize = 0;
  while j < len(b) {
    buf[i + j] = b[j];
    j += 1;
  }
  return intrinsics.slice_string(buf);
}

fn cat3(a: string, b: string, c: string) -> string {
  return cat(a, cat(b, c));
}

// ---------------------------------------------------------------- file io --

// grow in a helper: ownership transfers at the call boundary, which the
// rc machinery accounts cleanly (an in-loop let + reassignment does not)
fn grow(buf: []u8, cap: usize) -> []u8 {
  let grown: []u8 = make([]u8, cap * 2);
  let mut i: usize = 0;
  while i < cap {
    grown[i] = buf[i];
    i += 1;
  }
  return grown;
}

fn read_file(path: string) -> Result[string, string] {
  let pathz: []u8 = cstr(path);
  let fd: i32 = open(pathz.ptr, 0, 0); // O_RDONLY
  if fd < 0 {
    return Result.Err(cat3("cannot open ", path, ""));
  }
  let mut cap: usize = 1 << 16;
  let mut buf: []u8 = make([]u8, cap);
  let mut n: usize = 0;
  loop {
    if n == cap {
      buf = grow(buf, cap);
      cap *= 2;
    }
    let got: isize = read(fd, (buf.ptr as usize + n) as *u8, cap - n);
    if got <= 0 {
      break;
    }
    n += got as usize;
  }
  close(fd);
  return Result.Ok(intrinsics.slice_string(buf[0..n]));
}

fn write_file(path: string, data: string) -> bool {
  // O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 on linux; 1|0x0200|0x0400 on mac.
  // The bootstrap targets arm64-mac first; keep the mac constants and let
  // the linux port adjust.
  let pathz: []u8 = cstr(path);
  let fd: i32 = open(pathz.ptr, 1 | 0x0200 | 0x0400, 420);
  if fd < 0 {
    return false;
  }
  let mut off: usize = 0;
  while off < len(data) {
    let put: isize = write(fd, (data.ptr as usize + off) as *u8, len(data) - off);
    if put <= 0 {
      close(fd);
      return false;
    }
    off += put as usize;
  }
  close(fd);
  return true;
}

fn flush_out(s: string) {
  // assemble-then-write: the driver collects output in an SB and writes once
  print(s);
}


fn Result.get_ok(self: Result) -> T {
  return match self {
    Result.Ok(v) => v,
    Result.Err(_) => panic("get_ok on Err"),
  };
}

fn Result.get_err(self: Result) -> E {
  return match self {
    Result.Err(e) => e,
    Result.Ok(_) => panic("get_err on Ok"),
  };
}

// ---------------------------------------------------------------- lexer ---

enum Tok {
  TkEof,
  TkIdent,
  TkInt,
  TkFloat,
  TkStr,
  KwFn, KwLet, KwMut, KwIf, KwElse, KwWhile, KwLoop, KwBreak,
  KwContinue, KwReturn, KwDefer, KwStruct, KwEnum, KwUse, KwPub,
  KwStatic, KwConst, KwMatch, KwAs, KwNew, KwNull, KwTrue, KwFalse,
  KwWeak, KwSelf, KwExtern,
  PLparen, PRparen, PLbrace, PRbrace, PLbracket, PRbracket,
  PComma, PColon, PSemi, PDot, PArrow, PFatarrow, PEllipsis2,
  PPlus, PMinus, PStar, PSlash, PPercent, PBang, PTilde, PAmp,
  PPipe, PCaret, PShl, PShr, PAndand, POror, PEq, PNe, PLt, PGt,
  PLe, PGe, PAssign, PPluseq, PMinuseq, PStareq, PSlasheq,
  PPercenteq, PAmpeq, PPipeeq, PCareteq, PShleq, PShreq, PQmark,
}

struct Token {
  kind: Tok,
  text: string,
  file: string,
  line: i32,
  col: i32,
  iv: u64,
  fv: f64,
  pre: *Vec[string], // line comments riding on the next token (for fmt)
  pending: *Vec[string], // lexer-local scratch while scanning
  pos: usize, // next read position (scratch)
  line2: i32, // lexer line (scratch)
  col2: i32, // lexer col (scratch)
}

struct Lexer {
  file: string,
  src: string,
  t: Token, // scratch: carries pos/line/col/pending between helpers
  out: *Vec[*Token],
}

fn tok_name(k: Tok) -> string {
  return match k {
    Tok.TkEof => "end of file",
    Tok.TkIdent => "identifier",
    Tok.TkInt => "integer",
    Tok.TkFloat => "float",
    Tok.TkStr => "string",
    Tok.KwFn => "`fn`",
    Tok.KwLet => "`let`",
    Tok.KwMut => "`mut`",
    Tok.KwIf => "`if`",
    Tok.KwElse => "`else`",
    Tok.KwWhile => "`while`",
    Tok.KwLoop => "`loop`",
    Tok.KwBreak => "`break`",
    Tok.KwContinue => "`continue`",
    Tok.KwReturn => "`return`",
    Tok.KwDefer => "`defer`",
    Tok.KwStruct => "`struct`",
    Tok.KwEnum => "`enum`",
    Tok.KwUse => "`use`",
    Tok.KwPub => "`pub`",
    Tok.KwStatic => "`static`",
    Tok.KwConst => "`const`",
    Tok.KwMatch => "`match`",
    Tok.KwAs => "`as`",
    Tok.KwNew => "`new`",
    Tok.KwNull => "`null`",
    Tok.KwTrue => "`true`",
    Tok.KwFalse => "`false`",
    Tok.KwWeak => "`weak`",
    Tok.KwSelf => "`self`",
    Tok.KwExtern => "`extern`",
    Tok.PLparen => "`(`",
    Tok.PRparen => "`)`",
    Tok.PLbrace => "`{`",
    Tok.PRbrace => "`}`",
    Tok.PLbracket => "`[`",
    Tok.PRbracket => "`]`",
    Tok.PComma => "`,`",
    Tok.PColon => "`:`",
    Tok.PSemi => "`;`",
    Tok.PDot => "`.`",
    Tok.PArrow => "`->`",
    Tok.PFatarrow => "`=>`",
    Tok.PEllipsis2 => "`..`",
    Tok.PPlus => "`+`",
    Tok.PMinus => "`-`",
    Tok.PStar => "`*`",
    Tok.PSlash => "`/`",
    Tok.PPercent => "`%`",
    Tok.PBang => "`!`",
    Tok.PTilde => "`~`",
    Tok.PAmp => "`&`",
    Tok.PPipe => "`|`",
    Tok.PCaret => "`^`",
    Tok.PShl => "`<<`",
    Tok.PShr => "`>>`",
    Tok.PAndand => "`&&`",
    Tok.POror => "`||`",
    Tok.PEq => "`==`",
    Tok.PNe => "`!=`",
    Tok.PLt => "`<`",
    Tok.PGt => "`>`",
    Tok.PLe => "`<=`",
    Tok.PGe => "`>=`",
    Tok.PAssign => "`=`",
    Tok.PPluseq => "`+=`",
    Tok.PMinuseq => "`-=`",
    Tok.PStareq => "`*=`",
    Tok.PSlasheq => "`/=`",
    Tok.PPercenteq => "`%=`",
    Tok.PAmpeq => "`&=`",
    Tok.PPipeeq => "`|=`",
    Tok.PCareteq => "`^=`",
    Tok.PShleq => "`<<=`",
    Tok.PShreq => "`>>=`",
    Tok.PQmark => "`?`",
  };
}

fn spell2(k: Tok) -> string {
  return match k {
    Tok.PPlus => "+",
    Tok.PPluseq => "+=",
    Tok.PMinus => "-",
    Tok.PMinuseq => "-=",
    Tok.PStar => "*",
    Tok.PStareq => "*=",
    Tok.PSlash => "/",
    Tok.PSlasheq => "/=",
    Tok.PPercent => "%",
    Tok.PPercenteq => "%=",
    Tok.PBang => "!",
    Tok.PTilde => "~",
    Tok.PAmp => "&",
    Tok.PAmpeq => "&=",
    Tok.PPipe => "|",
    Tok.PPipeeq => "|=",
    Tok.PCaret => "^",
    Tok.PCareteq => "^=",
    Tok.PShl => "<<",
    Tok.PShleq => "<<=",
    Tok.PShr => ">>",
    Tok.PShreq => ">>=",
    Tok.PAndand => "&&",
    Tok.POror => "||",
    Tok.PEq => "==",
    Tok.PNe => "!=",
    Tok.PLt => "<",
    Tok.PGt => ">",
    Tok.PLe => "<=",
    Tok.PGe => ">=",
    Tok.PAssign => "=",
    Tok.PEllipsis2 => "..",
    Tok.PArrow => "->",
    Tok.PFatarrow => "=>",
    Tok.PColon => ":",
    Tok.PSemi => ";",
    Tok.PComma => ",",
    Tok.PDot => ".",
    Tok.PLparen => "(",
    Tok.PRparen => ")",
    Tok.PLbrace => "{",
    Tok.PRbrace => "}",
    Tok.PLbracket => "[",
    Tok.PRbracket => "]",
    Tok.PQmark => "?",
    _ => tok_name(k),
  };
}

fn ident_or_keyword(s: string) -> Tok {
  if streq(s, "fn") { return Tok.KwFn; }
  if streq(s, "let") { return Tok.KwLet; }
  if streq(s, "mut") { return Tok.KwMut; }
  if streq(s, "if") { return Tok.KwIf; }
  if streq(s, "else") { return Tok.KwElse; }
  if streq(s, "while") { return Tok.KwWhile; }
  if streq(s, "loop") { return Tok.KwLoop; }
  if streq(s, "break") { return Tok.KwBreak; }
  if streq(s, "continue") { return Tok.KwContinue; }
  if streq(s, "return") { return Tok.KwReturn; }
  if streq(s, "defer") { return Tok.KwDefer; }
  if streq(s, "struct") { return Tok.KwStruct; }
  if streq(s, "enum") { return Tok.KwEnum; }
  if streq(s, "use") { return Tok.KwUse; }
  if streq(s, "pub") { return Tok.KwPub; }
  if streq(s, "static") { return Tok.KwStatic; }
  if streq(s, "const") { return Tok.KwConst; }
  if streq(s, "match") { return Tok.KwMatch; }
  if streq(s, "as") { return Tok.KwAs; }
  if streq(s, "new") { return Tok.KwNew; }
  if streq(s, "null") { return Tok.KwNull; }
  if streq(s, "true") { return Tok.KwTrue; }
  if streq(s, "false") { return Tok.KwFalse; }
  if streq(s, "weak") { return Tok.KwWeak; }
  if streq(s, "self") { return Tok.KwSelf; }
  if streq(s, "extern") { return Tok.KwExtern; }
  return Tok.TkIdent;
}


fn is_ws(c: u8) -> bool {
  return c == 32 || c == 9 || c == 13;
}
fn is_ident_start(c: u8) -> bool {
  if c >= 97 && c <= 122 {
    return true;
  }
  if c >= 65 && c <= 90 {
    return true;
  }
  return c == 95;
}

fn is_ident_char(c: u8) -> bool {
  return is_ident_start(c) || (c >= 48 && c <= 57);
}

fn is_digit(c: u8) -> bool {
  return c >= 48 && c <= 57;
}

fn is_hex(c: u8) -> bool {
  if is_digit(c) {
    return true;
  }
  if c >= 97 && c <= 102 {
    return true;
  }
  return c >= 65 && c <= 70;
}

fn hex_val(c: u8) -> i32 {
  if c >= 48 && c <= 57 {
    return c as i32 - 48;
  }
  if c >= 97 && c <= 102 {
    return c as i32 - 97 + 10;
  }
  if c >= 65 && c <= 70 {
    return c as i32 - 65 + 10;
  }
  return 0 - 1;
}

// digit value in the given base, or -1
fn digit_val(c: u8, base: u64) -> i32 {
  if c >= 48 && c <= 57 {
    return if (c as i32 - 48) as u64 >= base { 0 - 1 } else { c as i32 - 48 };
  }
  if c >= 97 && c <= 102 {
    return if (c as i32 - 87) as u64 >= base { 0 - 1 } else { c as i32 - 87 };
  }
  if c >= 65 && c <= 70 {
    return if (c as i32 - 55) as u64 >= base { 0 - 1 } else { c as i32 - 55 };
  }
  return 0 - 1;
}

fn ch_at(lx: *Lexer, off: usize) -> u8 {
  let i: usize = lx.t.pos + off;
  if i >= len(lx.src) {
    return 0;
  }
  return lx.src[i];
}

fn emit_tok(lx: *Lexer, kind: Tok, start: usize) {
  let t: *Token = new Token {
    kind: kind,
    text: lx.src[start..lx.t.pos],
    file: lx.file,
    line: lx.t.line2,
    col: lx.t.col2,
    iv: 0,
    fv: 0.0,
    pre: lx.t.pending,
    pending: new Vec[string] { items: make([]string, 8), n: 0 },
    pos: 0,
    line2: 1,
    col2: 1,
  };
  t.pre = lx.t.pending;
  lx.t.pending = new Vec[string] { items: make([]string, 8), n: 0 };
  lx.out.push(t);
}

fn lex_error(lx: *Lexer, msg: string) {
  err_at(lx.file, lx.t.line2, lx.t.col2, msg);
}

fn pow10(e: i32) -> f64 {
  let mut r: f64 = 1.0;
  let mut i: i32 = 0;
  while i < e {
    r *= 10.0;
    i += 1;
  }
  return r;
}

// hand-rolled decimal float parse (no libc here): digits[.digits][e[+-]exp]
fn parse_float(s: string) -> f64 {
  let mut v: f64 = 0.0;
  let mut i: usize = 0;
  while i < len(s) && s[i] != 46 && s[i] != 101 && s[i] != 69 {
    v = v * 10.0 + (s[i] - 48) as f64;
    i += 1;
  }
  let mut frac: f64 = 0.0;
  if i < len(s) && s[i] == 46 {
    // skip '.'
    i += 1;
    let mut scale: f64 = 0.1;
    while i < len(s) && s[i] != 101 && s[i] != 69 {
      frac += (s[i] - 48) as f64 * scale;
      scale *= 0.1;
      i += 1;
    }
  }
  v += frac;
  if i < len(s) && (s[i] == 101 || s[i] == 69) {
    i += 1;
    let mut neg: bool = false;
    if i < len(s) && (s[i] == 43 || s[i] == 45) {
      neg = s[i] == 45;
      i += 1;
    }
    let mut e: i32 = 0;
    while i < len(s) {
      e = e * 10 + (s[i] - 48) as i32;
      i += 1;
    }
    if neg {
      e = 0 - e;
    }
    if e >= 0 {
      v *= pow10(e);
    } else {
      v /= pow10(0 - e);
    }
  }
  return v;
}

// scan a string literal (the opening quote is at lx.t.pos)
fn lex_string(lx: *Lexer, start: usize) {
  lx.t.pos += 1;
  let sb: *Vec[u8] = new Vec[u8] { items: make([]u8, 32), n: 0 };
  loop {
    if lx.t.pos >= len(lx.src) || lx.src[lx.t.pos] == 10 {
      lex_error(lx, "unterminated string literal");
      break;
    }
    let d: u8 = lx.src[lx.t.pos];
    if d == 34 {
      lx.t.pos += 1;
      break;
    }
    if d == 92 {
      lx.t.pos += 1;
      if lx.t.pos >= len(lx.src) {
        lex_error(lx, "unterminated escape");
        break;
      }
      let e: u8 = lx.src[lx.t.pos];
      lx.t.pos += 1;
      if e == 110 {
        sb.push(10);
      } else if e == 116 {
        sb.push(9);
      } else if e == 114 {
        sb.push(13);
      } else if e == 92 {
        sb.push(92);
      } else if e == 34 {
        sb.push(34);
      } else if e == 48 {
        sb.push(0);
      } else if e == 120 {
        if is_hex(ch_at(lx, 0)) && is_hex(ch_at(lx, 1)) {
          sb.push((hex_val(ch_at(lx, 0)) * 16 + hex_val(ch_at(lx, 1))) as u8);
          lx.t.pos += 2;
        } else {
          lex_error(lx, "malformed \\x escape");
        }
      } else {
        lex_error(lx, "unknown escape");
        sb.push(e);
      }
      continue;
    }
    sb.push(d);
    lx.t.pos += 1;
  }
  emit_tok(lx, Tok.TkStr, start);
  lx.out.last().text = intrinsics.slice_string(sb.items[0..sb.n]);
  lx.t.col2 += (lx.t.pos - start) as i32;
}

fn lex_file(file: string, src: string, out: *Vec[*Token]) {
  let lx: *Lexer = new Lexer {
    file: file,
    src: src,
    t: *new Token {
      kind: Tok.TkEof,
      text: "",
      file: file,
      line: 1,
      col: 1,
      iv: 0,
      fv: 0.0,
      pre: new Vec[string] { items: make([]string, 8), n: 0 },
      pending: new Vec[string] { items: make([]string, 8), n: 0 },
      pos: 0,
      line2: 1,
      col2: 1,
    },
    out: out,
  };
  lx.t.pending = new Vec[string] { items: make([]string, 8), n: 0 };
  loop {
    if lx.t.pos >= len(src) {
      break;
    }
    let c: u8 = src[lx.t.pos];
    let start: usize = lx.t.pos;
    let start_line: i32 = lx.t.line2;
    let start_col: i32 = lx.t.col2;

    if c == 10 {
      lx.t.pos += 1;
      lx.t.line2 += 1;
      lx.t.col2 = 1;
      continue;
    }
    if is_ws(c) {
      lx.t.pos += 1;
      lx.t.col2 += 1;
      continue;
    }
    if c == 47 && ch_at(lx, 1) == 47 {
      // line comment: trivia riding on the next token
      lx.t.pos += 2;
      let cs: usize = lx.t.pos;
      loop {
        if lx.t.pos >= len(src) || src[lx.t.pos] == 10 {
          break;
        }
        lx.t.pos += 1;
      }
      lx.t.pending.push(src[cs..lx.t.pos]);
      continue;
    }

    // identifiers & keywords
    if is_ident_start(c) {
      loop {
        if lx.t.pos >= len(src) || !is_ident_char(src[lx.t.pos]) {
          break;
        }
        lx.t.pos += 1;
      }
      emit_tok(lx, ident_or_keyword(src[start..lx.t.pos]), start);
      lx.t.col2 += (lx.t.pos - start) as i32;
      continue;
    }

    // numbers (int / float / hex / bin)
    if is_digit(c) {
      let mut is_float: bool = false;
      let mut base: u64 = 10;
      if c == 48 && (ch_at(lx, 1) == 120 || ch_at(lx, 1) == 98) {
        base = if ch_at(lx, 1) == 120 { 16 } else { 2 };
        lx.t.pos += 2;
      }
      let digits: usize = lx.t.pos;
      loop {
        if lx.t.pos >= len(src) {
          break;
        }
        let d: u8 = src[lx.t.pos];
        if d != 95 && digit_val(d, base) < 0 {
          break;
        }
        lx.t.pos += 1;
      }
      if base == 10 && ch_at(lx, 0) == 46 && is_digit(ch_at(lx, 1)) {
        is_float = true;
        lx.t.pos += 1;
        loop {
          if lx.t.pos >= len(src) {
            break;
          }
          let d: u8 = src[lx.t.pos];
          if !is_digit(d) && d != 95 {
            break;
          }
          lx.t.pos += 1;
        }
      }
      if base == 10 && lx.t.pos < len(src) && (src[lx.t.pos] == 101 || src[lx.t.pos] == 69) {
        let save: usize = lx.t.pos;
        lx.t.pos += 1;
        if lx.t.pos < len(src) && (src[lx.t.pos] == 43 || src[lx.t.pos] == 45) {
          lx.t.pos += 1;
        }
        if lx.t.pos < len(src) && is_digit(src[lx.t.pos]) {
          is_float = true;
          loop {
            if lx.t.pos >= len(src) || !is_digit(src[lx.t.pos]) {
              break;
            }
            lx.t.pos += 1;
          }
        } else {
          lx.t.pos = save;
        }
      }
      if lx.t.pos == digits {
        lex_error(lx, "malformed number");
        lx.t.pos += 1;
        lx.t.col2 += 1;
        continue;
      }
      emit_tok(lx, if is_float { Tok.TkFloat } else { Tok.TkInt }, start);
      let mut i: usize = start;
      if is_float {
        let clean: *Vec[u8] = new Vec[u8] { items: make([]u8, 64), n: 0 };
        while i < lx.t.pos {
          if src[i] != 95 {
            clean.push(src[i]);
          }
          i += 1;
        }
        lx.out.last().fv = parse_float(intrinsics.slice_string(clean.items[0..clean.n]));
      } else {
        let mut v: u64 = 0;
        let mut overflow: bool = false;
        if base != 10 {
          i += 2; // skip the 0x/0b prefix: the value digits start after it
        }
        while i < lx.t.pos {
          let d: u8 = src[i];
          i += 1;
          if d == 95 {
            continue;
          }
          let dv: i32 = digit_val(d, base);
          if dv < 0 {
            err_at(file, start_line, start_col, "invalid digit for this base");
            break;
          }
          let next: u64 = v * base + dv as u64;
          if next < v {
            overflow = true;
          }
          v = next;
        }
        if overflow {
          err_at(file, start_line, start_col, "integer literal too large");
        }
        lx.out.last().iv = v;
      }
      lx.t.col2 += (lx.t.pos - start) as i32;
      continue;
    }

    // strings
    if c == 34 {
      lex_string(lx, start);
      continue;
    }

    // two-char operators
    if op2(lx, c, 61, 61, Tok.PEq) { continue; }
    if op2(lx, c, 33, 61, Tok.PNe) { continue; }
    if op2(lx, c, 60, 61, Tok.PLe) { continue; }
    if op2(lx, c, 62, 61, Tok.PGe) { continue; }
    if op2(lx, c, 38, 38, Tok.PAndand) { continue; }
    if op2(lx, c, 124, 124, Tok.POror) { continue; }
    if op2(lx, c, 38, 61, Tok.PAmpeq) { continue; }
    if op2(lx, c, 124, 61, Tok.PPipeeq) { continue; }
    if op2(lx, c, 94, 61, Tok.PCareteq) { continue; }
    if op2(lx, c, 43, 61, Tok.PPluseq) { continue; }
    if op2(lx, c, 45, 61, Tok.PMinuseq) { continue; }
    if op2(lx, c, 42, 61, Tok.PStareq) { continue; }
    if op2(lx, c, 47, 61, Tok.PSlasheq) { continue; }
    if op2(lx, c, 37, 61, Tok.PPercenteq) { continue; }
    if op2(lx, c, 61, 62, Tok.PFatarrow) { continue; }
    if op2(lx, c, 45, 62, Tok.PArrow) { continue; }
    if op2(lx, c, 46, 46, Tok.PEllipsis2) { continue; }
    if op2(lx, c, 60, 60, Tok.PShl) { continue; }
    if op2(lx, c, 62, 62, Tok.PShr) { continue; }

    // single-char operators
    let mut kind: Tok = Tok.TkEof;
    if c == 40 { kind = Tok.PLparen; }
    else if c == 41 { kind = Tok.PRparen; }
    else if c == 123 { kind = Tok.PLbrace; }
    else if c == 125 { kind = Tok.PRbrace; }
    else if c == 91 { kind = Tok.PLbracket; }
    else if c == 93 { kind = Tok.PRbracket; }
    else if c == 44 { kind = Tok.PComma; }
    else if c == 58 { kind = Tok.PColon; }
    else if c == 59 { kind = Tok.PSemi; }
    else if c == 46 { kind = Tok.PDot; }
    else if c == 43 { kind = Tok.PPlus; }
    else if c == 45 { kind = Tok.PMinus; }
    else if c == 42 { kind = Tok.PStar; }
    else if c == 47 { kind = Tok.PSlash; }
    else if c == 37 { kind = Tok.PPercent; }
    else if c == 33 { kind = Tok.PBang; }
    else if c == 126 { kind = Tok.PTilde; }
    else if c == 38 { kind = Tok.PAmp; }
    else if c == 124 { kind = Tok.PPipe; }
    else if c == 94 { kind = Tok.PCaret; }
    else if c == 60 { kind = Tok.PLt; }
    else if c == 62 { kind = Tok.PGt; }
    else if c == 61 { kind = Tok.PAssign; }
    else if c == 63 { kind = Tok.PQmark; }
    else {
      lex_error(lx, "unexpected character");
      lx.t.pos += 1;
      lx.t.col2 += 1;
      continue;
    }
    lx.t.pos += 1;
    lx.t.col2 += 1;
    emit_tok(lx, kind, start);
  }
  let eof: *Token = new Token {
    kind: Tok.TkEof,
    text: "",
    file: file,
    line: lx.t.line2,
    col: lx.t.col2,
    iv: 0,
    fv: 0.0,
    pre: new Vec[string] { items: make([]string, 8), n: 0 },
    pending: new Vec[string] { items: make([]string, 8), n: 0 },
    pos: 0,
    line2: 1,
    col2: 1,
  };
  eof.pre = lx.t.pending;
  out.push(eof);
}

fn op2(lx: *Lexer, c: u8, a: u8, b: u8, kind: Tok) -> bool {
  if c != a || ch_at(lx, 1) != b {
    return false;
  }
  let start: usize = lx.t.pos;
  lx.t.pos += 2;
  lx.t.col2 += 2;
  emit_tok(lx, kind, start);
  return true;
}


// ---------------------------------------------------------------- ast -----

enum ExprKind {
  ExInt, ExFloat, ExStr, ExBool, ExNull, ExName, ExType,
  ExBin, ExUn, ExCall, ExIndex, ExSlice, ExField, ExMethod,
  ExCast, ExNew, ExMake, ExClosure, ExMatch, ExQmark, ExEnumCtor,
  ExIf, ExBlock,
}

enum PatKind {
  PatWildcard, PatInt, PatStr, PatUnit, PatTuple, PatStruct,
}

enum VarKind {
  VarUnit, VarTuple, VarStruct,
}

enum StmtKind {
  StLet, StAssign, StExpr, StReturn, StBreak, StContinue, StDefer,
  StWhile, StLoop, StBlock,
}

enum DeclKind {
  DkFn, DkStruct, DkEnum, DkStatic, DkConst, DkUse, DkExtern,
}

enum TypeAstKind {
  TaPrim, TaNamed, TaPtr, TaWeak, TaArray, TaFn,
}

struct TypeAst {
  kind: TypeAstKind,
  prim: i32,           // TaPrim: index into the primitive name table
  path: *Vec[string],   // TaNamed: segments
  targs: *Vec[*TypeAst],// TaNamed: type arguments
  elem: *TypeAst,      // Ptr/Weak/Array
  params: *Vec[*TypeAst], // Fn
  ret: *TypeAst,       // Fn
  size: *Expr,         // Array: constant length expression
}

struct Param {
  name: string,
  ty: *TypeAst,
  is_self: bool,
  file: string,
  line: i32,
  col: i32,
}

struct FieldAst {
  name: string,
  ty: *TypeAst,
  file: string,
  line: i32,
  col: i32,
}

struct VariantAst {
  name: string,
  vkind: VarKind,
  types: *Vec[*TypeAst],  // VarTuple
  fields: *Vec[*FieldAst],// VarStruct
  has_disc: bool,
  disc: u64,
  file: string,
  line: i32,
  col: i32,
}

struct MatchArm {
  pk: PatKind,
  pat_path: *Vec[string],
  pat_int: u64,
  variant_index: i32,
  disc: u64,
  pat_str: string,
  pat_names: *Vec[string],
  pat_fields: *Vec[*FieldAst],
  body: *Expr,
  file: string,
  line: i32,
  col: i32,
  bind_syms: []*Sym,   // pattern bindings (check)
  bind_fidx: []i64,    // variant field index per binding (check)
}

struct Expr {
  kind: ExprKind,
  file: string,
  line: i32,
  col: i32,
  iv: u64,
  fv: f64,
  sv: string,
  bv: bool,
  a: *Expr,
  b: *Expr,
  c: *Expr,
  binop: Tok,
  unop: Tok,
  args: *Vec[*Expr],
  arg_names: *Vec[string], // "" = positional
  items: *Vec[*Stmt],      // Block stmts / If arms / New field names unused
  ty: *TypeAst,
  arms: *Vec[*MatchArm],
  params: *Vec[*Param],    // Closure
  ret: *TypeAst,          // Closure
  q_ok: i32,
  q_err: i32,
  else_if: *Expr, // ExIf: the else-if chain (null = else is items[1] or none)
  fnval: bool,
  caps: []*Sym, // CLOSURE: copy-captured outer locals (check)
  typed: *Type, // semantic type (check)
  sym: *Sym, // resolved name (check)
}

struct Stmt {
  kind: StmtKind,
  file: string,
  line: i32,
  col: i32,
  pre: *Vec[string],
  mut_: bool,
  tail: bool,
  name: string,
  ty: *TypeAst,
  a: *Expr,
  b: *Expr,
  assign_op: Tok,
  stmts: *Vec[*Stmt],
  cond: *Expr,
  body: *Vec[*Stmt],
}

struct TypeEnt { key: string, val: *Type }
struct TypeMap { items: []*TypeEnt, n: usize }

fn tm_new() -> *TypeMap {
  return new TypeMap { items: make([]*TypeEnt, 65536), n: 0 };
}

// interning: same mangled key always yields the identical *Type
fn tm_intern(m: *TypeMap, key: string, val: *Type) -> *Type {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  let e: *TypeEnt = new TypeEnt { key: key, val: val };
  m.items[m.n] = e;
  m.n += 1;
  return val;
}

fn tm_lookup(m: *TypeMap, key: string) -> *Type {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return null;
}

fn tm_put(m: *TypeMap, key: string, val: *Type) {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      m.items[i].val = val;
      return;
    }
    i += 1;
  }
  let e: *TypeEnt = new TypeEnt { key: key, val: val };
  m.items[m.n] = e;
  m.n += 1;
}

fn tm_get(m: *TypeMap, key: string) -> *Type {
  return tm_lookup(m, key);
}

struct RecType {
  decl: *Decl,
  is_prelude: bool,
  targs: []*Type,
  mangled: string,
  field_types: []*Type,
  fields_done: bool,
  resolving: bool,
  is_template: bool,
  offsets: []i64,
  var_offsets: []*I64Vec, // per variant: field offsets
  var_poff: []i64,        // per variant: payload start
  size: i64,
  align: i64,
  env_tenv: *TypeMap,
  owner_mod: *Module,
  methods: []*Sym,
}

struct I64Vec { items: []i64 }

struct Type {
  kind: TypeKind,
  elem: *Type,
  len: u64,
  rec: *RecType,
  params: []*Type,
  ret: *Type,
  mangled: string,
}

struct Decl {
  kind: DeclKind,
  file: string,
  line: i32,
  col: i32,
  pre: *Vec[string],
  pub_: bool,
  is_mut: bool,
  name: string,
  path: *Vec[string],      // Use
  params: *Vec[*Param],    // Fn/Extern
  ret: *TypeAst,
  fields: *Vec[*FieldAst], // Struct
  variants: *Vec[*VariantAst], // Enum
  init: *Expr,            // Static/Const
  body: *Vec[*Stmt],       // Fn
  tparams: *Vec[string],
  is_method: bool,
  recv: string,
  decls: *Vec[*Decl],      // module root
  templ: *RecType,         // generic definition's RecType (check)
  templated: bool,         // generic template: never lowered directly
  tenv: *TypeMap,          // instantiation env (clones)
  owner: *Module,          // owning module (decl registration)
  ceval_ok: bool,
  ceval_is_int: bool,
  ceval_i: u64,
  ceval_f: f64,
}

// ------------------------------------------------------------- parser -----

struct Parser {
  toks: []*Token,
  i: usize,
}

fn pk(p: *Parser) -> *Token {
  return p.toks[p.i];
}

fn peek2(p: *Parser) -> *Token {
  if p.i + 1 < len(p.toks) {
    return p.toks[p.i + 1];
  }
  return p.toks[p.i];
}

fn at(p: *Parser, k: Tok) -> bool {
  return pk(p).kind == k;
}

fn at_eof(p: *Parser) -> bool {
  return pk(p).kind == Tok.TkEof;
}

fn advance(p: *Parser) -> *Token {
  let t: *Token = pk(p);
  if p.i + 1 < len(p.toks) {
    p.i += 1;
  }
  return t;
}

fn accept(p: *Parser, k: Tok) -> bool {
  if at(p, k) {
    advance(p);
    return true;
  }
  return false;
}

fn expect_tok(p: *Parser, k: Tok, what: string) -> *Token {
  if at(p, k) {
    return advance(p);
  }
  let t: *Token = pk(p);
  err_at(t.file, t.line, t.col, cat3("expected ", what, cat3(", found ", tok_name(t.kind), "")));
  return t;
}

fn at_ident(p: *Parser, s: string) -> bool {
  return at(p, Tok.TkIdent) && streq(pk(p).text, s);
}

fn expect_ident(p: *Parser, what: string) -> *Token {
  if at(p, Tok.TkIdent) {
    return advance(p);
  }
  let t: *Token = pk(p);
  err_at(t.file, t.line, t.col, cat3("expected ", what, cat3(", found ", tok_name(t.kind), "")));
  return t;
}

fn prim_from_name(s: string) -> i32 {
  if streq(s, "bool") { return 0; }
  if streq(s, "i8") { return 1; }
  if streq(s, "i16") { return 2; }
  if streq(s, "i32") { return 3; }
  if streq(s, "i64") { return 4; }
  if streq(s, "u8") { return 5; }
  if streq(s, "u16") { return 6; }
  if streq(s, "u32") { return 7; }
  if streq(s, "u64") { return 8; }
  if streq(s, "f32") { return 9; }
  if streq(s, "f64") { return 10; }
  if streq(s, "string") { return 11; }
  if streq(s, "usize") { return 12; }
  if streq(s, "isize") { return 13; }
  if streq(s, "void") { return 14; }
  return 0 - 1;
}

// ---- type grammar

fn parse_type(p: *Parser) -> *TypeAst {
  let start: *Token = pk(p);
  let mut t: *TypeAst = null;
  if accept(p, Tok.PLbracket) {
    // []T slice or [N]T array — `[*` can only start the element type
    t = new TypeAst { kind: TypeAstKind.TaArray, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null };
    if at(p, Tok.PStar) {
      // [*T] — slice of pointer: the `*` starts the element type
      t.elem = parse_type(p);
      expect_tok(p, Tok.PRbracket, "`]`");
      return t;
    }
    if !at(p, Tok.PRbracket) {
      t.size = parse_expr(p);
    }
    expect_tok(p, Tok.PRbracket, "`]`");
    t.elem = parse_type(p);
    return t;
  }
  if accept(p, Tok.PStar) {
    t = new TypeAst { kind: TypeAstKind.TaPtr, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null };
    t.elem = parse_type(p);
    return t;
  }
  if at(p, Tok.KwWeak) {
    advance(p);
    t = new TypeAst { kind: TypeAstKind.TaWeak, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null };
    expect_tok(p, Tok.PLbracket, "`[`");
    t.elem = parse_type(p);
    expect_tok(p, Tok.PRbracket, "`]`");
    return t;
  }
  if at(p, Tok.KwFn) {
    advance(p);
    t = new TypeAst { kind: TypeAstKind.TaFn, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null };
    expect_tok(p, Tok.PLparen, "`(`");
    if !at(p, Tok.PRparen) {
      loop {
        t.params.push(parse_type(p));
        if !accept(p, Tok.PComma) {
          break;
        }
      }
    }
    expect_tok(p, Tok.PRparen, "`)`");
    if accept(p, Tok.PArrow) {
      t.ret = parse_type(p);
    }
    return t;
  }
  if at(p, Tok.TkIdent) {
    let id: *Token = advance(p);
    let prim: i32 = prim_from_name(id.text);
    if prim >= 0 {
      t = new TypeAst { kind: TypeAstKind.TaPrim, prim: prim, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null };
      return t;
    }
    t = new TypeAst { kind: TypeAstKind.TaNamed, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null };
    t.path.push(id.text);
    while accept(p, Tok.PDot) {
      let seg: *Token = expect_ident(p, "type name");
      t.path.push(seg.text);
    }
    if accept(p, Tok.PLbracket) {
      if !at(p, Tok.PRbracket) {
        loop {
          t.targs.push(parse_type(p));
          if !accept(p, Tok.PComma) {
            break;
          }
        }
      }
      expect_tok(p, Tok.PRbracket, "`]`");
    }
    return t;
  }
  err_at(start.file, start.line, start.col, cat3("expected a type, found ", tok_name(start.kind), ""));
  t = new TypeAst { kind: TypeAstKind.TaPrim, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null };
  return t;
}

fn type_as_expr(p: *Parser) -> *Expr {
  let start: *Token = pk(p);
  let e: *Expr = new Expr {
    kind: ExprKind.ExType, file: start.file, line: start.line, col: start.col,
    iv: 0, fv: 0.0, sv: "", bv: false, a: null, b: null, c: null,
    binop: Tok.TkEof, unop: Tok.TkEof,
    args: fresh_expr_vec(), arg_names: fresh_str_vec(), items: fresh_stmt_vec(),
    ty: parse_type(p), arms: fresh_arm_vec(), params: fresh_param_vec(), ret: null,
    q_ok: 0, q_err: 0, else_if: null, fnval: false, caps: make([]*Sym, 0), typed: null, sym: null,
  };
  return e;
}

// fresh empty containers (no zero values in rho)
fn fresh_str_vec() -> *Vec[string] {
  return new Vec[string] { items: make([]string, 4), n: 0 };
}
fn fresh_expr_vec() -> *Vec[*Expr] {
  return new Vec[*Expr] { items: make([*Expr], 4), n: 0 };
}
fn fresh_stmt_vec() -> *Vec[*Stmt] {
  return new Vec[*Stmt] { items: make([*Stmt], 4), n: 0 };
}
fn fresh_type_vec() -> *Vec[*TypeAst] {
  return new Vec[*TypeAst] { items: make([*TypeAst], 4), n: 0 };
}
fn fresh_param_vec() -> *Vec[*Param] {
  return new Vec[*Param] { items: make([*Param], 4), n: 0 };
}
fn fresh_arm_vec() -> *Vec[*MatchArm] {
  return new Vec[*MatchArm] { items: make([*MatchArm], 4), n: 0 };
}
fn fresh_field_vec() -> *Vec[*FieldAst] {
  return new Vec[*FieldAst] { items: make([*FieldAst], 4), n: 0 };
}
fn fresh_variant_vec() -> *Vec[*VariantAst] {
  return new Vec[*VariantAst] { items: make([*VariantAst], 4), n: 0 };
}
fn fresh_decl_vec() -> *Vec[*Decl] {
  return new Vec[*Decl] { items: make([*Decl], 16), n: 0 };
}
fn fresh_token_vec() -> *Vec[*Token] {
  return new Vec[*Token] { items: make([*Token], 256), n: 0 };
}



fn mkexpr(kind: ExprKind, file: string, line: i32, col: i32) -> *Expr {
  return new Expr {
    kind: kind, file: file, line: line, col: col,
    iv: 0, fv: 0.0, sv: "", bv: false, a: null, b: null, c: null,
    binop: Tok.TkEof, unop: Tok.TkEof,
    args: fresh_expr_vec(), arg_names: fresh_str_vec(), items: fresh_stmt_vec(),
    ty: null, arms: fresh_arm_vec(), params: fresh_param_vec(), ret: null,
    q_ok: 0, q_err: 0, else_if: null, fnval: false, caps: make([]*Sym, 0), typed: null, sym: null,
  };
}

fn parse_param(p: *Parser) -> *Param {
  let start: *Token = pk(p);
  let pa: *Param = new Param { name: "", ty: null, is_self: false, file: start.file, line: start.line, col: start.col };
  if at(p, Tok.KwSelf) {
    advance(p);
    pa.is_self = true;
    pa.name = "self";
  } else {
    let id: *Token = expect_ident(p, "parameter name");
    pa.name = id.text;
  }
  expect_tok(p, Tok.PColon, "`:`");
  pa.ty = parse_type(p);
  return pa;
}

fn parse_tparams(p: *Parser, out: *Vec[string]) {
  if !accept(p, Tok.PLbracket) {
    return;
  }
  if !at(p, Tok.PRbracket) {
    loop {
      let id: *Token = expect_ident(p, "type parameter name");
      out.push(id.text);
      if !accept(p, Tok.PComma) {
        break;
      }
    }
  }
  expect_tok(p, Tok.PRbracket, "`]`");
}

fn parse_block_stmts(p: *Parser, end: Tok) -> *Stmt {
  let start: *Token = pk(p);
  let s: *Stmt = mkstmt(StmtKind.StBlock, start.file, start.line, start.col);
  while !at(p, end) && !at_eof(p) {
    let before: usize = p.i;
    let inner: *Stmt = parse_stmt(p);
    if inner != null {
      s.stmts.push(inner);
    }
    if p.i == before {
      advance(p);
    }
  }
  return s;
}

fn parse_block(p: *Parser) -> *Vec[*Stmt] {
  expect_tok(p, Tok.PLbrace, "`{`");
  let s: *Stmt = parse_block_stmts(p, Tok.PRbrace);
  expect_tok(p, Tok.PRbrace, "`}`");
  return s.stmts;
}

fn level_of(k: Tok) -> i32 {
  if k == Tok.POror { return 2; }
  if k == Tok.PAndand { return 3; }
  if k == Tok.PEq { return 4; }
  if k == Tok.PNe { return 4; }
  if k == Tok.PLt { return 5; }
  if k == Tok.PGt { return 5; }
  if k == Tok.PLe { return 5; }
  if k == Tok.PGe { return 5; }
  if k == Tok.PPipe { return 6; }
  if k == Tok.PCaret { return 7; }
  if k == Tok.PAmp { return 8; }
  if k == Tok.PShl { return 9; }
  if k == Tok.PShr { return 9; }
  if k == Tok.PPlus { return 10; }
  if k == Tok.PMinus { return 10; }
  if k == Tok.PStar { return 11; }
  if k == Tok.PSlash { return 11; }
  if k == Tok.PPercent { return 11; }
  return 0 - 1;
}

fn parse_if_body(p: *Parser) -> *Expr {
  let start: *Token = pk(p);
  let e: *Expr = mkexpr(ExprKind.ExIf, start.file, start.line, start.col);
  e.a = parse_expr_bp(p, 0);
  expect_tok(p, Tok.PLbrace, "`{`");
  let then: *Stmt = parse_block_stmts(p, Tok.PRbrace);
  expect_tok(p, Tok.PRbrace, "`}`");
  e.items.push(then);
  if accept(p, Tok.KwElse) {
    if at(p, Tok.KwIf) {
      advance(p);
      e.else_if = parse_if_body(p);
    } else {
      expect_tok(p, Tok.PLbrace, "`{`");
      let els: *Stmt = parse_block_stmts(p, Tok.PRbrace);
      expect_tok(p, Tok.PRbrace, "`}`");
      e.items.push(els);
    }
  }
  return e;
}

fn parse_primary(p: *Parser) -> *Expr {
  let start: *Token = pk(p);
  let k: Tok = start.kind;
  if k == Tok.TkInt {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExInt, start.file, start.line, start.col);
    e.iv = start.iv;
    return e;
  }
  if k == Tok.TkFloat {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExFloat, start.file, start.line, start.col);
    e.fv = start.fv;
    return e;
  }
  if k == Tok.TkStr {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExStr, start.file, start.line, start.col);
    e.sv = start.text;
    return e;
  }
  if k == Tok.KwTrue || k == Tok.KwFalse {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExBool, start.file, start.line, start.col);
    e.bv = k == Tok.KwTrue;
    return e;
  }
  if k == Tok.KwNull {
    advance(p);
    return mkexpr(ExprKind.ExNull, start.file, start.line, start.col);
  }
  if k == Tok.KwSelf {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExName, start.file, start.line, start.col);
    e.sv = start.text;
    return e;
  }
  if k == Tok.KwWeak {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExName, start.file, start.line, start.col);
    e.sv = "weak";
    return e;
  }
  if k == Tok.TkIdent {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExName, start.file, start.line, start.col);
    e.sv = start.text;
    return e;
  }
  if k == Tok.PLparen {
    advance(p);
    let e: *Expr = parse_expr(p);
    expect_tok(p, Tok.PRparen, "`)`");
    return e;
  }
  if k == Tok.KwIf {
    advance(p);
    return parse_if_body(p);
  }
  if k == Tok.KwMatch {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExMatch, start.file, start.line, start.col);
    e.a = parse_expr_bp(p, 0);
    expect_tok(p, Tok.PLbrace, "`{`");
    while !at(p, Tok.PRbrace) && !at_eof(p) {
      let pt: *Token = pk(p);
      let arm: *MatchArm = new MatchArm {
        pk: PatKind.PatWildcard, pat_path: fresh_str_vec(), pat_int: 0,
        variant_index: 0, disc: 0, pat_str: "", pat_names: fresh_str_vec(),
        pat_fields: fresh_field_vec(), body: null,
        file: pt.file, line: pt.line, col: pt.col,
       bind_syms: make([]*Sym, 4), bind_fidx: make([]i64, 4),
  };
      if at(p, Tok.TkInt) {
        advance(p);
        arm.pk = PatKind.PatInt;
        arm.pat_int = pt.iv;
      } else if at(p, Tok.TkStr) {
        advance(p);
        arm.pk = PatKind.PatStr;
        arm.pat_str = pt.text;
      } else if at_ident(p, "_") {
        advance(p);
        arm.pk = PatKind.PatWildcard;
      } else if at(p, Tok.TkIdent) {
        advance(p);
        arm.pat_path.push(pt.text);
        while accept(p, Tok.PDot) {
          let seg: *Token = expect_ident(p, "variant name");
          arm.pat_path.push(seg.text);
        }
        if accept(p, Tok.PLparen) {
          arm.pk = PatKind.PatTuple;
          if !at(p, Tok.PRparen) {
            loop {
              let b: *Token = pk(p);
              if at(p, Tok.TkIdent) {
                advance(p);
                arm.pat_names.push(b.text);
              } else {
                err_at(b.file, b.line, b.col, "expected binding name");
                advance(p);
                arm.pat_names.push("_");
              }
              if !accept(p, Tok.PComma) {
                break;
              }
            }
          }
          expect_tok(p, Tok.PRparen, "`)`");
        } else if accept(p, Tok.PLbrace) {
          arm.pk = PatKind.PatStruct;
          while !at(p, Tok.PRbrace) && !at_eof(p) {
            let fn_tok: *Token = expect_ident(p, "field name");
            let fa: *FieldAst = new FieldAst { name: fn_tok.text, ty: null, file: fn_tok.file, line: fn_tok.line, col: fn_tok.col };
            if accept(p, Tok.PColon) {
              let b: *Token = expect_ident(p, "binding name");
              arm.pat_names.push(b.text);
            } else {
              arm.pat_names.push(fn_tok.text);
            }
            arm.pat_fields.push(fa);
            if !accept(p, Tok.PComma) {
              break;
            }
          }
          expect_tok(p, Tok.PRbrace, "`}`");
        } else {
          arm.pk = PatKind.PatUnit;
        }
      } else {
        err_at(pt.file, pt.line, pt.col, cat3("expected a pattern, found ", tok_name(pt.kind), ""));
        advance(p);
        continue;
      }
      expect_tok(p, Tok.PFatarrow, "`=>`");
      if at(p, Tok.PLbrace) {
        advance(p);
        let blk: *Expr = mkexpr(ExprKind.ExBlock, pt.file, pt.line, pt.col);
        let body: *Stmt = parse_block_stmts(p, Tok.PRbrace);
        expect_tok(p, Tok.PRbrace, "`}`");
        blk.items = body.stmts;
        arm.body = blk;
      } else {
        arm.body = parse_expr(p);
      }
      e.arms.push(arm);
      if !accept(p, Tok.PComma) {
        break;
      }
    }
    expect_tok(p, Tok.PRbrace, "`}`");
    return e;
  }
  if k == Tok.KwNew {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExNew, start.file, start.line, start.col);
    e.ty = parse_type(p);
    expect_tok(p, Tok.PLbrace, "`{`");
    while !at(p, Tok.PRbrace) && !at_eof(p) {
      let fn_tok: *Token = expect_ident(p, "field name");
      expect_tok(p, Tok.PColon, "`:`");
      let fa: *FieldAst = new FieldAst { name: fn_tok.text, ty: null, file: fn_tok.file, line: fn_tok.line, col: fn_tok.col };
      e.args.push(parse_expr(p));
      let name_entry: *Stmt = mkstmt(StmtKind.StBlock, fa.file, fa.line, fa.col);
      name_entry.name = fa.name;
      e.items.push(name_entry);
      if !accept(p, Tok.PComma) {
        break;
      }
    }
    expect_tok(p, Tok.PRbrace, "`}`");
    return e;
  }
  if k == Tok.KwFn {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExClosure, start.file, start.line, start.col);
    expect_tok(p, Tok.PLparen, "`(`");
    if !at(p, Tok.PRparen) {
      loop {
        e.params.push(parse_param(p));
        if !accept(p, Tok.PComma) {
          break;
        }
      }
    }
    expect_tok(p, Tok.PRparen, "`)`");
    if accept(p, Tok.PArrow) {
      e.ret = parse_type(p);
    }
    e.items = parse_block(p);
    return e;
  }
  err_at(start.file, start.line, start.col, cat3("expected an expression, found ", tok_name(start.kind), ""));
  advance(p);
  return mkexpr(ExprKind.ExInt, start.file, start.line, start.col);
}

fn parse_postfix(p: *Parser) -> *Expr {
  let mut e: *Expr = parse_primary(p);
  loop {
    let start: *Token = pk(p);
    if accept(p, Tok.PLparen) {
      let call: *Expr = mkexpr(ExprKind.ExCall, start.file, start.line, start.col);
      call.a = e;
      if !at(p, Tok.PRparen) {
        if at(p, Tok.TkIdent) && peek2(p).kind == Tok.PColon {
          let nm: *Token = advance(p);
          advance(p);
          call.arg_names.push(nm.text);
          call.args.push(parse_expr(p));
        } else if e.kind == ExprKind.ExName && streq(e.sv, "make") && at(p, Tok.PLbracket) {
          call.arg_names.push("");
          call.args.push(type_as_expr(p));
        } else {
          call.arg_names.push("");
          call.args.push(parse_expr(p));
        }
        while accept(p, Tok.PComma) {
          if at(p, Tok.TkIdent) && peek2(p).kind == Tok.PColon {
            let nm: *Token = advance(p);
            advance(p);
            call.arg_names.push(nm.text);
            call.args.push(parse_expr(p));
          } else if e.kind == ExprKind.ExName && streq(e.sv, "make") && at(p, Tok.PLbracket) {
            call.arg_names.push("");
            call.args.push(type_as_expr(p));
          } else {
            call.arg_names.push("");
            call.args.push(parse_expr(p));
          }
        }
      }
      expect_tok(p, Tok.PRparen, "`)`");
      e = call;
      continue;
    }
    if accept(p, Tok.PLbracket) {
      if at(p, Tok.PEllipsis2) {
        err_at(start.file, start.line, start.col, "slice needs a start");
        advance(p);
        parse_expr(p);
        expect_tok(p, Tok.PRbracket, "`]`");
        continue;
      }
      let idx: *Expr = parse_expr(p);
      if accept(p, Tok.PEllipsis2) {
        let sl: *Expr = mkexpr(ExprKind.ExSlice, start.file, start.line, start.col);
        sl.a = e;
        sl.b = idx;
        sl.c = parse_expr(p);
        expect_tok(p, Tok.PRbracket, "`]`");
        e = sl;
        continue;
      }
      expect_tok(p, Tok.PRbracket, "`]`");
      let ix: *Expr = mkexpr(ExprKind.ExIndex, start.file, start.line, start.col);
      ix.a = e;
      ix.b = idx;
      e = ix;
      continue;
    }
    if accept(p, Tok.PDot) {
      let name: *Token = expect_ident(p, "field or method name");
      let f: *Expr = mkexpr(ExprKind.ExField, start.file, start.line, start.col);
      f.a = e;
      f.sv = name.text;
      e = f;
      continue;
    }
    if accept(p, Tok.PQmark) {
      let q: *Expr = mkexpr(ExprKind.ExQmark, start.file, start.line, start.col);
      q.a = e;
      e = q;
      continue;
    }
    if at(p, Tok.KwAs) {
      advance(p);
      let c: *Expr = mkexpr(ExprKind.ExCast, start.file, start.line, start.col);
      c.a = e;
      c.ty = parse_type(p);
      e = c;
      continue;
    }
    break;
  }
  return e;
}

fn parse_expr_bp(p: *Parser, min_bp: i32) -> *Expr {
  let start: *Token = pk(p);
  let mut left: *Expr = null;
  let unary_bp: i32 = 12;
  if min_bp <= unary_bp && (at(p, Tok.PBang) || at(p, Tok.PMinus) || at(p, Tok.PTilde) || at(p, Tok.PStar)) {
    let op: *Token = advance(p);
    let operand: *Expr = parse_expr_bp(p, unary_bp);
    let u: *Expr = mkexpr(ExprKind.ExUn, start.file, start.line, start.col);
    u.unop = op.kind;
    u.a = operand;
    left = u;
  } else {
    left = parse_postfix(p);
  }
  loop {
    let bp: i32 = level_of(pk(p).kind);
    if bp < 0 || bp < min_bp {
      break;
    }
    let op: *Token = advance(p);
    let right: *Expr = parse_expr_bp(p, bp + 1);
    let bin: *Expr = mkexpr(ExprKind.ExBin, start.file, start.line, start.col);
    bin.binop = op.kind;
    bin.a = left;
    bin.b = right;
    left = bin;
  }
  return left;
}

fn parse_expr(p: *Parser) -> *Expr {
  return parse_expr_bp(p, 0);
}

fn at_assign_start(p: *Parser) -> bool {
  let k: Tok = pk(p).kind;
  return k == Tok.PAssign || k == Tok.PPluseq || k == Tok.PMinuseq || k == Tok.PStareq
      || k == Tok.PSlasheq || k == Tok.PPercenteq || k == Tok.PAmpeq
      || k == Tok.PPipeeq || k == Tok.PCareteq || k == Tok.PShleq || k == Tok.PShreq;
}

fn mkstmt(kind: StmtKind, file: string, line: i32, col: i32) -> *Stmt {
  return new Stmt {
    kind: kind, file: file, line: line, col: col,
    pre: fresh_str_vec(), mut_: false, tail: false, name: "", ty: null,
    a: null, b: null, assign_op: Tok.TkEof, stmts: fresh_stmt_vec(),
    cond: null, body: fresh_stmt_vec(),
  };
}

fn parse_stmt(p: *Parser) -> *Stmt {
  let start: *Token = pk(p);
  let s: *Stmt = parse_stmt_raw(p);
  if s != null {
    s.pre = start.pre;
  }
  return s;
}

fn parse_stmt_raw(p: *Parser) -> *Stmt {
  let start: *Token = pk(p);
  let k: Tok = start.kind;
  if k == Tok.KwLet {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StLet, start.file, start.line, start.col);
    s.mut_ = accept(p, Tok.KwMut);
    let id: *Token = expect_ident(p, "binding name");
    s.name = id.text;
    if accept(p, Tok.PColon) {
      s.ty = parse_type(p);
    }
    expect_tok(p, Tok.PAssign, "`=` (bindings need an initializer)");
    s.a = parse_expr(p);
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  if k == Tok.KwReturn {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StReturn, start.file, start.line, start.col);
    if !at(p, Tok.PSemi) {
      s.a = parse_expr(p);
    }
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  if k == Tok.KwBreak {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StBreak, start.file, start.line, start.col);
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  if k == Tok.KwContinue {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StContinue, start.file, start.line, start.col);
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  if k == Tok.KwDefer {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StDefer, start.file, start.line, start.col);
    if at(p, Tok.PLbrace) {
      let blk: *Stmt = mkstmt(StmtKind.StBlock, start.file, start.line, start.col);
      blk.stmts = parse_block(p);
      s.stmts.push(blk);
    } else {
      let one: *Stmt = parse_stmt(p);
      s.stmts.push(one);
    }
    return s;
  }
  if k == Tok.KwWhile {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StWhile, start.file, start.line, start.col);
    s.cond = parse_expr(p);
    s.body = parse_block(p);
    return s;
  }
  if k == Tok.KwLoop {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StLoop, start.file, start.line, start.col);
    s.body = parse_block(p);
    return s;
  }
  if k == Tok.PLbrace {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StBlock, start.file, start.line, start.col);
    s.stmts = parse_block_stmts(p, Tok.PRbrace).stmts;
    expect_tok(p, Tok.PRbrace, "`}`");
    return s;
  }
  let e: *Expr = parse_expr(p);
  if at_assign_start(p) {
    let op: *Token = advance(p);
    let s: *Stmt = mkstmt(StmtKind.StAssign, start.file, start.line, start.col);
    s.assign_op = op.kind;
    s.a = e;
    s.b = parse_expr(p);
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  let s: *Stmt = mkstmt(StmtKind.StExpr, start.file, start.line, start.col);
  s.a = e;
  let blocky: bool = e.kind == ExprKind.ExIf || e.kind == ExprKind.ExMatch || e.kind == ExprKind.ExBlock;
  if accept(p, Tok.PSemi) {
    s.tail = false;
  } else if at(p, Tok.PRbrace) {
    s.tail = true;
  } else if blocky {
    s.tail = false;
  } else {
    s.tail = false;
    let t: *Token = pk(p);
    err_at(t.file, t.line, t.col, cat3("expected `;`, found ", tok_name(t.kind), ""));
  }
  return s;
}

fn parse_file(path: string, src: string) -> *Decl {
  let toks: *Vec[*Token] = fresh_token_vec();
  lex_file(path, src, toks);
  let p: *Parser = new Parser { toks: toks.items, i: 0 };
  let module: *Decl = new Decl {
    kind: DeclKind.DkFn, file: path, line: 0, col: 0, pre: fresh_str_vec(),
    pub_: false, is_mut: false, name: "", path: fresh_str_vec(),
    params: fresh_param_vec(), ret: null, fields: fresh_field_vec(),
    variants: fresh_variant_vec(), init: null, body: fresh_stmt_vec(),
    tparams: fresh_str_vec(), is_method: false, recv: "", decls: fresh_decl_vec(),
    templ: null,
    templated: false, tenv: null, owner: null, ceval_ok: false, ceval_is_int: false, ceval_i: 0, ceval_f: 0.0,
  };
  while !at_eof(p) {
    let start: *Token = pk(p);
    let is_pub: bool = accept(p, Tok.KwPub);
    let d: *Decl = new Decl {
      kind: DeclKind.DkFn, file: start.file, line: start.line, col: start.col,
      pre: start.pre, pub_: is_pub, is_mut: false, name: "",
      path: fresh_str_vec(), params: fresh_param_vec(), ret: null,
      fields: fresh_field_vec(), variants: fresh_variant_vec(), init: null,
      body: fresh_stmt_vec(), tparams: fresh_str_vec(), is_method: false,
      recv: "", decls: fresh_decl_vec(), templ: null,
    templated: false, tenv: null, owner: null, ceval_ok: false, ceval_is_int: false, ceval_i: 0, ceval_f: 0.0,
    };
    if accept(p, Tok.KwUse) {
      d.kind = DeclKind.DkUse;
      loop {
        let seg: *Token = expect_ident(p, "module path segment");
        d.path.push(seg.text);
        if !accept(p, Tok.PSlash) {
          break;
        }
      }
      expect_tok(p, Tok.PSemi, "`;`");
    } else if accept(p, Tok.KwExtern) {
      d.kind = DeclKind.DkExtern;
      if at(p, Tok.TkStr) {
        advance(p);
      }
      expect_tok(p, Tok.KwFn, "`fn`");
      let id: *Token = expect_ident(p, "function name");
      d.name = id.text;
      expect_tok(p, Tok.PLparen, "`(`");
      if !at(p, Tok.PRparen) {
        loop {
          d.params.push(parse_param(p));
          if !accept(p, Tok.PComma) {
            break;
          }
        }
      }
      expect_tok(p, Tok.PRparen, "`)`");
      if accept(p, Tok.PArrow) {
        d.ret = parse_type(p);
      }
      expect_tok(p, Tok.PSemi, "`;`");
    } else if accept(p, Tok.KwFn) {
      d.kind = DeclKind.DkFn;
      let id: *Token = expect_ident(p, "function name");
      d.name = id.text;
      if accept(p, Tok.PDot) {
        d.recv = id.text;
        let m: *Token = expect_ident(p, "method name");
        d.name = m.text;
      }
      parse_tparams(p, d.tparams);
      expect_tok(p, Tok.PLparen, "`(`");
      if !at(p, Tok.PRparen) {
        loop {
          d.params.push(parse_param(p));
          if !accept(p, Tok.PComma) {
            break;
          }
        }
      }
      expect_tok(p, Tok.PRparen, "`)`");
      if accept(p, Tok.PArrow) {
        d.ret = parse_type(p);
      }
      if d.params.n > 0 {
        if d.params.items[0].is_self {
          d.is_method = true;
        }
      }
      d.body = parse_block(p);
    } else if accept(p, Tok.KwStruct) {
      d.kind = DeclKind.DkStruct;
      let id: *Token = expect_ident(p, "struct name");
      d.name = id.text;
      parse_tparams(p, d.tparams);
      expect_tok(p, Tok.PLbrace, "`{`");
      while !at(p, Tok.PRbrace) && !at_eof(p) {
        let fn_tok: *Token = expect_ident(p, "field name");
        expect_tok(p, Tok.PColon, "`:`");
        let fa: *FieldAst = new FieldAst { name: fn_tok.text, ty: parse_type(p), file: fn_tok.file, line: fn_tok.line, col: fn_tok.col };
        d.fields.push(fa);
        if !accept(p, Tok.PComma) {
          break;
        }
      }
      expect_tok(p, Tok.PRbrace, "`}`");
    } else if accept(p, Tok.KwEnum) {
      d.kind = DeclKind.DkEnum;
      let id: *Token = expect_ident(p, "enum name");
      d.name = id.text;
      parse_tparams(p, d.tparams);
      expect_tok(p, Tok.PLbrace, "`{`");
      let mut next_disc: u64 = 0;
      while !at(p, Tok.PRbrace) && !at_eof(p) {
        let vn: *Token = expect_ident(p, "variant name");
        let v: *VariantAst = new VariantAst { name: vn.text, vkind: VarKind.VarUnit, types: fresh_type_vec(), fields: fresh_field_vec(), has_disc: false, disc: 0, file: vn.file, line: vn.line, col: vn.col };
        if accept(p, Tok.PLparen) {
          v.vkind = VarKind.VarTuple;
          if !at(p, Tok.PRparen) {
            loop {
              v.types.push(parse_type(p));
              if !accept(p, Tok.PComma) {
                break;
              }
            }
          }
          expect_tok(p, Tok.PRparen, "`)`");
        } else if accept(p, Tok.PLbrace) {
          v.vkind = VarKind.VarStruct;
          while !at(p, Tok.PRbrace) && !at_eof(p) {
            let fn_tok: *Token = expect_ident(p, "field name");
            expect_tok(p, Tok.PColon, "`:`");
            let fa: *FieldAst = new FieldAst { name: fn_tok.text, ty: parse_type(p), file: fn_tok.file, line: fn_tok.line, col: fn_tok.col };
            v.fields.push(fa);
            if !accept(p, Tok.PComma) {
              break;
            }
          }
          expect_tok(p, Tok.PRbrace, "`}`");
        } else {
          v.vkind = VarKind.VarUnit;
        }
        if accept(p, Tok.PAssign) {
          if v.vkind != VarKind.VarUnit {
            err_at(vn.file, vn.line, vn.col, "only unit variants take explicit discriminants");
          }
          let iv: *Token = expect_tok(p, Tok.TkInt, "discriminant");
          v.has_disc = true;
          v.disc = iv.iv;
          next_disc = iv.iv + 1;
        } else {
          v.disc = next_disc;
          next_disc += 1;
        }
        d.variants.push(v);
        if !accept(p, Tok.PComma) {
          break;
        }
      }
      expect_tok(p, Tok.PRbrace, "`}`");
    } else if at(p, Tok.KwStatic) || at(p, Tok.KwConst) {
      let is_static: bool = at(p, Tok.KwStatic);
      advance(p);
      if is_static {
        d.kind = DeclKind.DkStatic;
      } else {
        d.kind = DeclKind.DkConst;
      }
      d.is_mut = is_static && accept(p, Tok.KwMut);
      let id: *Token = expect_ident(p, "name");
      d.name = id.text;
      expect_tok(p, Tok.PColon, "`:`");
      d.ret = parse_type(p);
      expect_tok(p, Tok.PAssign, "`=`");
      d.init = parse_expr(p);
      expect_tok(p, Tok.PSemi, "`;`");
    } else {
      err_at(start.file, start.line, start.col, cat3("expected a declaration (fn/struct/enum/static/const/use), found ", tok_name(start.kind), ""));
      advance(p);
      continue;
    }
      module.decls.push(d);
  }
  module.pre = p.toks[toks.n - 1].pre;
  return module;
}


// ---------------------------------------------------------------- driver ---

struct Diag {
  file: string,
  line: i32,
  col: i32,
  msg: string,
}

static mut diags: *Vec[*Diag] = 0 as *Vec[*Diag];

fn err_at(file: string, line: i32, col: i32, msg: string) {
  if diags == null {
    diags = new Vec[*Diag] { items: make([*Diag], 8), n: 0 };
  }
  diags.push(new Diag { file: file, line: line, col: col, msg: msg });
}

fn diag_count() -> i32 {
  if diags == null {
    return 0;
  }
  return diags.n as i32;
}

fn usage() -> i32 {
  eprint("usage: rho build <file> [-o out] [--target t]\n");
  eprint("       rho check <file>\n");
  return 2;
}

fn main() -> i32 {
  let args: []string = program_args();
  if len(args) < 3 {
    return usage();
  }
  let cmd: string = args[1];
  if !streq(cmd, "build") && !streq(cmd, "check") {
    return usage();
  }
  let path: string = args[2];
  let mut out_path: string = "a.wasm";
  let mut target_wasm: bool = false;
  let mut ai: usize = 3;
  while ai < len(args) {
    if streq(args[ai], "-o") && ai + 1 < len(args) {
      out_path = args[ai + 1];
      ai += 2;
    } else if streq(args[ai], "--target") && ai + 1 < len(args) {
      if streq(args[ai + 1], "wasm32-wasi") {
        target_wasm = true;
      }
      ai += 2;
    } else if streq(args[ai], "--dump-ir") {
      g_dump_ir = true;
      ai += 1;
    } else {
      ai += 1;
    }
  }
  let src_result: Result[string, string] = read_file(path);
  if src_result.is_err() {
    eprint(cat3("rho: ", src_result.get_err(), "\n"));
    return 2;
  }
  let tokens: *Vec[*Token] = fresh_token_vec();
  lex_file(path, src_result.get_ok(), tokens);
  if diag_count() > 0 {
    print_diags();
    return 1;
  }
  let module: *Decl = parse_file(path, src_result.get_ok());
  if diag_count() > 0 {
    print_diags();
    return 1;
  }
  let m: *Module = new Module {
    path: args[2], ns: "", root: module, syms: sm_new(),
    is_prelude: false, checked: false,
  };
  let mut prelude_path: string = "boot/prelude/hosted.rho";
  if target_wasm {
    prelude_path = "boot/prelude/wasi.rho";
  }
  let prelude_r: Result[string, string] = read_file(prelude_path);
  if !prelude_r.is_err() {
    let pparse: *Decl = parse_file("<prelude>", prelude_r.get_ok());
    eprint("[prelude decls=");
    eprint(itoa(pparse.decls.n as i64));
    eprint(" parse-diags=");
    eprint(itoa(diag_count() as i64));
    eprint("]\n");
    let pmod: *Module = new Module {
      path: "<prelude>", ns: "", root: pparse,
      syms: sm_new(), is_prelude: true, checked: false,
    };
    check_all(pmod);
    prelude_module = pmod;
    m.syms = sm_new();
    check_module(m);
  }
  eprint("[prelude diags=");
  eprint(itoa(diag_count() as i64));
  eprint("]\n");
  let diags_before: i32 = diag_count();
  let nd: i32 = check_all(m);
  eprint("[user diags=");
  eprint(itoa((nd - diags_before) as i64));
  eprint("]\n");
  if nd > diags_before {
    print_diags();
    return 1;
  }
  if !target_wasm {
    eprint("parsed ");
    eprint(itoa(module.decls.n as i64));
    eprint(" declarations, type-checked\n");
    return 0;
  }
  g_root_module = m;
  lower_program();
  if g_dump_ir {
    lower_dump_ir();
  }
  let bytes: []u8 = emit_wasm();
  write_file(out_path, bytes_as_string(bytes));
  eprint("built ");
  eprint(out_path);
  eprint("\n");
  return 0;
}

fn print_diags() {
  let mut i: usize = 0;
  while i < diags.n {
    let d: *Diag = diags.items[i];
    eprint(d.file);
    eprint(":");
    eprint(itoa(d.line as i64));
    eprint(":");
    eprint(itoa(d.col as i64));
    eprint(": error: ");
    eprint(d.msg);
    eprint("\n");
    i += 1;
  }
}


// ======================== semantic types (check.c port L1) =================
//
// Types are interned by their mangled name: identical types are pointer-
// identical, which is what `ty_eq` (pointer ==) relies on everywhere.

enum TypeKind {
  TyVoid, TyBool, TyI8, TyI16, TyI32, TyI64, TyU8, TyU16, TyU32,
  TyU64, TyF32, TyF64, TyStringK, TyUsize, TyIsize,
  TyIntLit, TyFloatLit, TyNull,
  TyArray, TySlice, TyPtr, TyWeak, TyFn, TyStruct, TyEnum, TyErr,
  TyModule, TyParam,
}

static mut g_types: *TypeMap = 0 as *TypeMap;
static mut g_recs: *TypeMap = 0 as *TypeMap;

fn type_map() -> *TypeMap {
  if g_types == null {
    g_types = tm_new();
  }
  return g_types;
}

fn rec_map() -> *TypeMap {
  if g_recs == null {
    g_recs = tm_new();
  }
  return g_recs;
}

fn ty_intern2(key: string, t: *Type) -> *Type {
  let found: *Type = tm_lookup(type_map(), key);
  if found != null {
    return found;
  }
  t.mangled = key;
  return tm_intern(type_map(), key, t);
}

fn prim_kind(prim: i32) -> TypeKind {
  if prim == 0 { return TypeKind.TyBool; }
  if prim == 1 { return TypeKind.TyI8; }
  if prim == 2 { return TypeKind.TyI16; }
  if prim == 3 { return TypeKind.TyI32; }
  if prim == 4 { return TypeKind.TyI64; }
  if prim == 5 { return TypeKind.TyU8; }
  if prim == 6 { return TypeKind.TyU16; }
  if prim == 7 { return TypeKind.TyU32; }
  if prim == 8 { return TypeKind.TyU64; }
  if prim == 9 { return TypeKind.TyF32; }
  if prim == 10 { return TypeKind.TyF64; }
  if prim == 11 { return TypeKind.TyStringK; }
  if prim == 12 { return TypeKind.TyUsize; }
  if prim == 13 { return TypeKind.TyIsize; }
  return TypeKind.TyVoid;
}

fn prim_name(prim: i32) -> string {
  if prim == 0 { return "bool"; }
  if prim == 1 { return "i8"; }
  if prim == 2 { return "i16"; }
  if prim == 3 { return "i32"; }
  if prim == 4 { return "i64"; }
  if prim == 5 { return "u8"; }
  if prim == 6 { return "u16"; }
  if prim == 7 { return "u32"; }
  if prim == 8 { return "u64"; }
  if prim == 9 { return "f32"; }
  if prim == 10 { return "f64"; }
  if prim == 11 { return "string"; }
  if prim == 12 { return "usize"; }
  if prim == 13 { return "isize"; }
  return "void";
}

fn ty_prim(prim: i32) -> *Type {
  return ty_intern2(prim_name(prim), new Type {
    kind: prim_kind(prim), elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_ptr(elem: *Type) -> *Type {
  return ty_intern2(cat("*", elem.mangled), new Type {
    kind: TypeKind.TyPtr, elem: elem, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_weak(elem: *Type) -> *Type {
  return ty_intern2(cat3("weak[", elem.mangled, "]"), new Type {
    kind: TypeKind.TyWeak, elem: elem, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_slice(elem: *Type) -> *Type {
  return ty_intern2(cat("[]", elem.mangled), new Type {
    kind: TypeKind.TySlice, elem: elem, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_array(elem: *Type, len: u64) -> *Type {
  return ty_intern2(cat3(cat3("[", itoa(len as i64), "]"), elem.mangled, ""), new Type {
    kind: TypeKind.TyArray, elem: elem, len: len, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_fn(params: []*Type, ret: *Type) -> *Type {
  eprint("[tyfn ret=");
  if ret == null {
    eprint("NULL");
  } else {
    eprint(ret.mangled);
  }
  eprint("]\n");
  let mut key: string = "fn(";
  let mut i: usize = 0;
  while i < len(params) {
    if i > 0 {
      key = cat(key, ";");
    }
    key = cat(key, params[i].mangled);
    i += 1;
  }
  key = cat3(key, ")->", ret.mangled);
  return ty_intern2(key, new Type {
    kind: TypeKind.TyFn, elem: null, len: 0, rec: null,
    params: params, ret: ret, mangled: "",
  });
}

fn ty_err() -> *Type {
  return ty_intern2("<error>", new Type {
    kind: TypeKind.TyErr, elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "<error>",
  });
}

fn ty_param_(name: string) -> *Type {
  let t: *Type = new Type {
    kind: TypeKind.TyParam, elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: name,
  };
  return t;
}

fn fresh_type_vec2() -> []*Type {
  return make([]*Type, 0); // empty: push_type appends
}


// ============== symbols & scopes (check.c port L2) ========================

enum SymKind {
  SyLocal, SyParam, SyFn, SyStruct, SyEnum, SyStatic, SyConst,
  SyModule, SyExtern, SyVariant,
}

struct Sym {
  kind: SymKind,
  name: string,
  type: *Type,
  decl: *Decl,
  mutable: bool,
  variant_index: i32,
  local_id: i32,
  symbol: string,
  owner: *Module,
}

struct Binding { name: string, sym: *Sym, next: *Binding }
struct CScope { bindings: *Binding, parent: *CScope }

static mut cur_scope: *CScope = 0 as *CScope;
static mut cur_ret: *Type = 0 as *Type;
static mut cur_fn_sym: *Sym = 0 as *Sym;
static mut next_local_id: i32 = 0;
static mut g_cap_list: *Vec[*Sym] = 0 as *Vec[*Sym];
static mut g_cap_boundary: i32 = 0;

fn scope_push() {
  let s: *CScope = new CScope { bindings: null, parent: cur_scope };
  cur_scope = s;
}

fn scope_pop() {
  cur_scope = cur_scope.parent;
}

fn scope_decl(name: string, sym: *Sym) {
  let b: *Binding = new Binding { name: name, sym: sym, next: cur_scope.bindings };
  cur_scope.bindings = b;
}

fn scope_lookup_local(s: *CScope, name: string) -> *Sym {
  let mut b: *Binding = s.bindings;
  while b != null {
    if streq(b.name, name) {
      return b.sym;
    }
    b = b.next;
  }
  return null;
}

fn lookup(name: string) -> *Sym {
  let mut s: *CScope = cur_scope;
  while s != null {
    let sym: *Sym = scope_lookup_local(s, name);
    if sym != null {
      return sym;
    }
    s = s.parent;
  }
  return null;
}


// ============== module walk (check.c port L3) =============================

struct SymMapEnt { key: string, val: *Sym }
struct SymMap { items: []*SymMapEnt, n: usize }

fn sm_new() -> *SymMap {
  return new SymMap { items: make([]*SymMapEnt, 4096), n: 0 };
}

fn sm_put(m: *SymMap, key: string, val: *Sym) {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      m.items[i].val = val;
      return;
    }
    i += 1;
  }
  let e: *SymMapEnt = new SymMapEnt { key: key, val: val };
  m.items[m.n] = e;
  m.n += 1;
}

fn sm_get(m: *SymMap, key: string) -> *Sym {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return null;
}

struct Module {
  path: string,
  ns: string,
  root: *Decl,
  syms: *SymMap,
  is_prelude: bool,
  checked: bool,
}

static mut cur_module: *Module = 0 as *Module;
static mut prelude_module: *Module = 0 as *Module;

// register one declaration into the module's symbol table
fn declare_sym(m: *Module, d: *Decl) {
  let sym: *Sym = new Sym {
    kind: SymKind.SyFn, name: d.name, type: null, decl: d,
    mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: m,
  };
  if d.kind == DeclKind.DkFn {
    sym.kind = SymKind.SyFn;
    if d.is_method {
      // methods live under `Recv.name`, mirroring the boot registration
      sm_put(m.syms, cat3(d.recv, ".", d.name), sym);
      return;
    }
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == DeclKind.DkStruct {
    sym.kind = SymKind.SyStruct;
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == DeclKind.DkEnum {
    sym.kind = SymKind.SyEnum;
    sm_put(m.syms, d.name, sym);
    let mut vi: i32 = 0;
    let mut viu: usize = 0;
    while viu < d.variants.n {
      let v: *VariantAst = d.variants.items[viu];
      let vsym: *Sym = new Sym {
        kind: SymKind.SyVariant, name: v.name, type: null, decl: d,
        mutable: false, variant_index: vi, local_id: 0, symbol: "",
    owner: m,
      };
      sm_put(m.syms, v.name, vsym);
      vi += 1;
      viu += 1;
    }
    return;
  }
  if d.kind == DeclKind.DkStatic || d.kind == DeclKind.DkConst {
    sym.kind = SymKind.SyStatic;
    if d.kind == DeclKind.DkConst {
      sym.kind = SymKind.SyConst;
    }
    sym.mutable = d.is_mut;
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == DeclKind.DkExtern {
    sym.kind = SymKind.SyExtern;
    sm_put(m.syms, d.name, sym);
    return;
  }
}

// walk all decls of a parsed module and populate its symbol table
fn check_module(m: *Module) {
  cur_module = m;
  let d: *Decl = m.root;
  let mut i: usize = 0;
  while i < d.decls.n {
    declare_sym(m, d.decls.items[i]);
    i += 1;
  }
}


// ============== generics core (check.c port L4) ===========================

static mut g_tenv: *TypeMap = 0 as *TypeMap;

fn tenv() -> *TypeMap {
  if g_tenv == null {
    g_tenv = tm_new();
  }
  return g_tenv;
}

fn rec_intern(decl: *Decl, owner: *Module, mangled: string) -> *RecType {
  let t: *Type = tm_lookup(rec_map(), mangled);
  if t != null {
    return t.rec;
  }
  let r: *RecType = new RecType {
    decl: decl, is_prelude: owner.is_prelude, targs: fresh_type_vec2(),
    mangled: mangled, field_types: fresh_type_vec2(), fields_done: false,
    resolving: false, is_template: false, offsets: make([]i64, 0),
    var_offsets: make([]*I64Vec, 0), var_poff: make([]i64, 0),
    size: 0, align: 0, env_tenv: null, owner_mod: owner,
    methods: make([]*Sym, 0),
  };
  tm_intern(rec_map(), mangled, new Type {
    kind: TypeKind.TyStruct, elem: null, len: 0, rec: r,
    params: fresh_type_vec2(), ret: null, mangled: mangled,
  });
  return r;
}

fn template_env_of(d: *Decl) -> *TypeMap {
  let env: *TypeMap = tm_new();
  let mut i: usize = 0;
  while i < d.tparams.n {
    tm_put(env, d.tparams.items[i], ty_param_(d.tparams.items[i]));
    i += 1;
  }
  return env;
}

fn push_type(items: []*Type, t: *Type) -> []*Type {
  let out: []*Type = make([]*Type, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = t;
  return out;
}

fn ensure_template(d: *Decl, owner: *Module) -> *RecType {
  if d.templ != null {
    return d.templ;
  }
  let base: string = cat3(owner.path, ".", d.name);
  let rec: *RecType = rec_intern(d, owner, cat(base, "[]"));
  rec.is_template = true;
  rec.targs = fresh_type_vec2();
  let env: *TypeMap = template_env_of(d);
  rec.env_tenv = env;
  let mut i: usize = 0;
  while i < d.tparams.n {
    let tv: *Type = tm_get(env, d.tparams.items[i]);
    rec.targs = push_type(rec.targs, tv);
    i += 1;
  }
  d.templ = rec;
  return rec;
}

fn rec_type_env(rec: *RecType) -> *TypeMap {
  if rec.env_tenv == null {
    rec.env_tenv = tm_new();
  }
  return rec.env_tenv;
}

fn inst_from_targs(sym: *Sym, owner: *Module, targs: []*Type) -> *Type {
  let d: *Decl = sym.decl;
  let base: string = cat3(owner.path, ".", d.name);
  let mut mangled: string = cat(base, "[");
  let mut i: usize = 0;
  while i < len(targs) {
    if i > 0 {
      mangled = cat(mangled, ",");
    }
    mangled = cat(mangled, targs[i].mangled);
    i += 1;
  }
  mangled = cat(mangled, "]");
  let rec: *RecType = rec_intern(d, owner, mangled);
  if len(rec.targs) == 0 && d.tparams.n > 0 {
    let mut j: usize = 0;
    while j < d.tparams.n {
      tm_put(rec_type_env(rec), d.tparams.items[j], targs[j]);
      j += 1;
    }
    rec.targs = targs;
  }
  let t: *Type = new Type {
    kind: TypeKind.TyStruct, elem: null, len: 0, rec: rec,
    params: fresh_type_vec2(), ret: null, mangled: mangled,
  };
  if sym.kind == SymKind.SyEnum {
    t.kind = TypeKind.TyEnum;
  }
  return ty_intern2(mangled, t);
}


// ============== type substitution & resolution (check.c port L5) =========

fn subst_type(t: *Type, env: *TypeMap) -> *Type {
  if t == null {
    return t;
  }
  if t.kind == TypeKind.TyParam {
    let r: *Type = tm_get(env, t.mangled);
    if r != null {
      return r;
    }
    return t;
  }
  if t.kind == TypeKind.TyPtr {
    return ty_ptr(subst_type(t.elem, env));
  }
  if t.kind == TypeKind.TyWeak {
    return ty_weak(subst_type(t.elem, env));
  }
  if t.kind == TypeKind.TySlice {
    return ty_slice(subst_type(t.elem, env));
  }
  if t.kind == TypeKind.TyArray {
    return ty_array(subst_type(t.elem, env), t.len);
  }
  if t.kind == TypeKind.TyFn {
    let mut ps: []*Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < len(t.params) {
      ps = push_type(ps, subst_type(t.params[i], env));
      i += 1;
    }
    return ty_fn(ps, subst_type(t.ret, env));
  }
  return t;
}

// bind type parameters by structural matching of a template type against
// the argument's concrete type
fn infer_targs(tmpl: *Type, arg: *Type, env: *TypeMap) {
  if tmpl == null || arg == null || tmpl.kind != TypeKind.TyParam {
    if tmpl == null || arg == null {
      return;
    }
    if tmpl.kind == TypeKind.TyPtr {
      if arg.kind == TypeKind.TyPtr {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyWeak {
      if arg.kind == TypeKind.TyWeak {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TySlice {
      if arg.kind == TypeKind.TySlice {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyArray {
      if arg.kind == TypeKind.TyArray && arg.len == tmpl.len {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyFn {
      if arg.kind == TypeKind.TyFn && len(arg.params) == len(tmpl.params) {
        let mut i: usize = 0;
        while i < len(tmpl.params) {
          infer_targs(tmpl.params[i], arg.params[i], env);
          i += 1;
        }
        infer_targs(tmpl.ret, arg.ret, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyStruct || tmpl.kind == TypeKind.TyEnum {
      if arg.kind == tmpl.kind && arg.rec != null && tmpl.rec != null &&
         arg.rec.decl == tmpl.rec.decl {
        let n: usize = if len(tmpl.rec.targs) < len(arg.rec.targs) {
          len(tmpl.rec.targs)
        } else {
          len(arg.rec.targs)
        };
        let mut i: usize = 0;
        while i < n {
          infer_targs(tmpl.rec.targs[i], arg.rec.targs[i], env);
          i += 1;
        }
      }
      return;
    }
    return;
  }
  let bound: *Type = tm_get(env, tmpl.mangled);
  if bound == null {
    tm_put(env, tmpl.mangled, arg);
  } else if bound != arg && bound.kind != TypeKind.TyErr && arg.kind != TypeKind.TyErr {
    // conflicting bindings: prefer the concrete over a literal
    if bound.kind == TypeKind.TyIntLit || arg.kind == TypeKind.TyIntLit ||
       bound.kind == TypeKind.TyFloatLit || arg.kind == TypeKind.TyFloatLit {
      if bound.kind == TypeKind.TyIntLit || bound.kind == TypeKind.TyFloatLit {
        if arg.kind != TypeKind.TyIntLit && arg.kind != TypeKind.TyFloatLit {
          tm_put(env, tmpl.mangled, arg);
        }
      } else {
        tm_put(env, tmpl.mangled, bound);
      }
    }
  }
}

fn type_has_param(t: *Type) -> bool {
  if t == null {
    return false;
  }
  if t.kind == TypeKind.TyParam {
    return true;
  }
  if t.elem != null && type_has_param(t.elem) {
    return true;
  }
  if t.kind == TypeKind.TyFn {
    let mut i: usize = 0;
    while i < len(t.params) {
      if type_has_param(t.params[i]) {
        return true;
      }
      i += 1;
    }
    if type_has_param(t.ret) {
      return true;
    }
  }
  if t.rec != null {
    let mut i: usize = 0;
    while i < len(t.rec.targs) {
      if type_has_param(t.rec.targs[i]) {
        return true;
      }
      i += 1;
    }
  }
  return false;
}

// resolve a named struct/enum type (non-generic path; generics with explicit
// targs arrive through inst_from_targs via resolve_named)
fn named_type_simple(sym: *Sym, owner: *Module) -> *Type {
  let d: *Decl = sym.decl;
  let base: string = cat3(owner.path, ".", d.name);
  let rec: *RecType = rec_intern(d, owner, base);
  let t: *Type = new Type {
    kind: TypeKind.TyStruct, elem: null, len: 0, rec: rec,
    params: fresh_type_vec2(), ret: null, mangled: base,
  };
  if sym.kind == SymKind.SyEnum {
    t.kind = TypeKind.TyEnum;
  }
  return ty_intern2(base, t);
}

// resolve a TypeAst into a semantic Type within a module
fn resolve_type_in_module(m: *Module, ta: *TypeAst) -> *Type {
  if ta == null {
    return ty_prim(14); // void
  }
  let saved: *Module = cur_module;
  cur_module = m;
  let mut result: *Type = ty_err();
  if ta.kind == TypeAstKind.TaPrim {
    result = ty_prim(ta.prim);
  } else if ta.kind == TypeAstKind.TaPtr {
    result = ty_ptr(resolve_type_in_module(m, ta.elem));
  } else if ta.kind == TypeAstKind.TaWeak {
    result = ty_weak(resolve_type_in_module(m, ta.elem));
  } else if ta.kind == TypeAstKind.TaArray {
    let elem: *Type = resolve_type_in_module(m, ta.elem);
    if ta.size == null {
      result = ty_slice(elem);
    } else {
      // TODO(check L6): const-evaluated array sizes land with const_eval
      result = ty_slice(elem);
    }
  } else if ta.kind == TypeAstKind.TaNamed {
    let last: string = ta.path.items[ta.path.n - 1];
    if ta.path.n == 1 {
      if g_tenv != null && ta.targs.n == 0 {
        let tv: *Type = tm_get(g_tenv, last);
        if tv != null {
          cur_module = saved;
          return tv;
        }
      }
      let mut sym: *Sym = sm_get(m.syms, last);
      if sym == null || (sym.kind != SymKind.SyStruct && sym.kind != SymKind.SyEnum) {
        if prelude_module != null && prelude_module != m {
          sym = sm_get(prelude_module.syms, last);
          if sym != null && (sym.kind == SymKind.SyStruct || sym.kind == SymKind.SyEnum) {
            cur_module = saved;
            return named_type_full(sym, prelude_module, ta);
          }
        }
        err_at("", 0, 0, cat("unknown type `", cat(last, "`")));
        cur_module = saved;
        return ty_err();
      }
      cur_module = saved;
      return named_type_full(sym, m, ta);
    }
    err_at("", 0, 0, "type paths are `module.Type` at most");
    cur_module = saved;
    return ty_err();
  } else if ta.kind == TypeAstKind.TaFn {
    let mut ps: []*Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < ta.params.n {
      ps = push_type(ps, resolve_type_in_module(m, ta.params.items[i]));
      i += 1;
    }
    let r: *Type = resolve_type_in_module(m, ta.ret);
    result = ty_fn(ps, r);
  }
  cur_module = saved;
  return result;
}

// full named-type resolution: non-generic, bare-generic (template or bound
// instance), and explicit-targs paths
fn named_type_full(sym: *Sym, owner: *Module, ta: *TypeAst) -> *Type {
  let d: *Decl = sym.decl;
  let nparams: usize = d.tparams.n;
  let ntargs: usize = ta.targs.n;
  eprint("[ntf ");
  eprint(d.name);
  eprint(" ntargs=");
  eprint(itoa(ntargs as i64));
  eprint(" tenv=");
  if g_tenv == null {
    eprint("null");
  } else {
    eprint("set");
  }
  eprint("\n");
  if nparams == 0 && ntargs == 0 {
    return named_type_simple(sym, owner);
  }
  if ntargs == 0 {
    let mut targs: []*Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < nparams {
      let mut tv: *Type = null;
      if g_tenv != null {
        tv = tm_get(g_tenv, d.tparams.items[i]);
      }
      if tv == null || tv.kind == TypeKind.TyErr {
        eprint("[nta ");
        eprint(d.name);
        eprint(" tenv=");
        if g_tenv == null {
          eprint("null");
        } else {
          eprint("set");
        }
        eprint("]\n");
        err_at("", 0, 0, cat("generic type `", cat(d.name, "` needs type arguments")));
        return ty_err();
      }
      targs = push_type(targs, tv);
      i += 1;
    }
    let mut anyp: bool = false;
    let mut k: usize = 0;
    while k < len(targs) {
      if targs[k].kind == TypeKind.TyParam {
        anyp = true;
      }
      k += 1;
    }
    if !anyp {
      return inst_from_targs(sym, owner, targs);
    }
    if anyp {
      let rt: *RecType = ensure_template(d, owner);
      let t: *Type = new Type {
        kind: TypeKind.TyStruct, elem: null, len: 0, rec: rt,
        params: fresh_type_vec2(), ret: null, mangled: rt.mangled,
      };
      if sym.kind == SymKind.SyEnum {
        t.kind = TypeKind.TyEnum;
      }
      return ty_intern2(rt.mangled, t);
    }
    return ty_err();
  }
  if nparams != ntargs {
    err_at("", 0, 0, cat("wrong type argument count for `", cat(d.name, "`")));
    return ty_err();
  }
  let mut targs: []*Type = fresh_type_vec2();
  let mut i: usize = 0;
  while i < ntargs {
    let mut targ: *Type = resolve_type_in_module(owner, ta.targs.items[i]);
    if targ.kind == TypeKind.TyIntLit {
      targ = ty_prim(3); // i32
    }
    if targ.kind == TypeKind.TyFloatLit {
      targ = ty_prim(10); // f64
    }
    if targ.kind == TypeKind.TyErr {
      return ty_err();
    }
    targs = push_type(targs, targ);
    i += 1;
  }
  return inst_from_targs(sym, owner, targs);
}


// ============== expression checking (check.c port L6a) ====================

fn ty_is_int(t: *Type) -> bool {
  return t.kind == TypeKind.TyI8 || t.kind == TypeKind.TyI16 ||
         t.kind == TypeKind.TyI32 || t.kind == TypeKind.TyI64 ||
         t.kind == TypeKind.TyU8 || t.kind == TypeKind.TyU16 ||
         t.kind == TypeKind.TyU32 || t.kind == TypeKind.TyU64 ||
         t.kind == TypeKind.TyUsize || t.kind == TypeKind.TyIsize ||
         t.kind == TypeKind.TyIntLit;
}

fn ty_is_flt(t: *Type) -> bool {
  return t.kind == TypeKind.TyF32 || t.kind == TypeKind.TyF64 ||
         t.kind == TypeKind.TyFloatLit;
}

fn types_compatible(got: *Type, expected: *Type) -> bool {
  return got == expected;
}

fn require(got_in: *Type, expected: *Type, e: *Expr, what: string) {
  // mirror boot: adapt literals to the expected type AND rewrite the
  // expression's semantic type, so lowering sees the concrete width
  let got: *Type = adapt_literal(got_in, expected);
  e.typed = got;
  if !types_compatible(got, expected) {
    err_at(e.file, e.line, e.col, cat3(what, ": type mismatch", ""));
  }
}

fn adapt_literal(got: *Type, expected: *Type) -> *Type {
  if got == null {
    return got;
  }
  if got.kind == TypeKind.TyIntLit && expected != null && ty_is_int(expected) &&
     expected.kind != TypeKind.TyIntLit {
    return expected;
  }
  if got.kind == TypeKind.TyFloatLit && expected != null &&
     (expected.kind == TypeKind.TyF32 || expected.kind == TypeKind.TyF64) {
    return expected;
  }
  return got;
}

fn check_expr(e: *Expr, expected: *Type) -> *Type {
  if e.kind == ExprKind.ExInt {
    if expected != null && ty_is_int(expected) && expected.kind != TypeKind.TyIntLit {
      e.typed = expected;
    } else {
      e.typed = ty_intern2("int_lit", new Type { kind: TypeKind.TyIntLit, elem: null, len: 0, rec: null, params: fresh_type_vec2(), ret: null, mangled: "int_lit" });
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExFloat {
    if expected != null && (expected.kind == TypeKind.TyF32 || expected.kind == TypeKind.TyF64) {
      e.typed = expected;
    } else {
      e.typed = ty_intern2("float_lit", new Type { kind: TypeKind.TyFloatLit, elem: null, len: 0, rec: null, params: fresh_type_vec2(), ret: null, mangled: "float_lit" });
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExStr {
    e.typed = ty_prim(11);
    return e.typed;
  }
  if e.kind == ExprKind.ExBool {
    e.typed = ty_prim(0);
    return e.typed;
  }
  if e.kind == ExprKind.ExNull {
    if expected != null && (expected.kind == TypeKind.TyPtr || expected.kind == TypeKind.TyWeak) {
      e.typed = expected;
    } else {
      e.typed = ty_intern2("null", new Type { kind: TypeKind.TyNull, elem: null, len: 0, rec: null, params: fresh_type_vec2(), ret: null, mangled: "null" });
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExName {
    let sym: *Sym = lookup(e.sv);
    if sym == null {
      err_at("", 0, 0, cat("unknown name `", cat(e.sv, "`")));
      e.typed = ty_err();
      return e.typed;
    }
    e.sym = sym;
    // copy-capture: a closure body naming an outer local records it
    if g_cap_list != null &&
       (sym.kind == SymKind.SyLocal || sym.kind == SymKind.SyParam) &&
       sym.local_id < g_cap_boundary {
      let mut dup: bool = false;
      let mut ci: usize = 0;
      while ci < g_cap_list.n {
        if streq(g_cap_list.items[ci].name, sym.name) {
          dup = true;
        }
        ci += 1;
      }
      if !dup {
        g_cap_list.push(sym);
      }
    }
    e.typed = sym.type;
    return e.typed;
  }
  if e.kind == ExprKind.ExUn {
    let a: *Type = check_expr(e.a, null);
    if e.unop == Tok.PBang {
      if a.kind != TypeKind.TyBool {
        err_at("", 0, 0, "`!` needs a bool");
      }
      e.typed = ty_prim(0);
      return e.typed;
    }
    if e.unop == Tok.PTilde {
      if !ty_is_int(a) {
        err_at("", 0, 0, "`~` needs an integer");
      }
      e.typed = a;
      return e.typed;
    }
    if e.unop == Tok.PMinus {
      if !ty_is_int(a) && !ty_is_flt(a) {
        err_at("", 0, 0, "`-` needs a number");
      }
      e.typed = a;
      return e.typed;
    }
    if e.unop == Tok.PStar {
      if a.kind != TypeKind.TyPtr {
        err_at("", 0, 0, "`*` dereference needs a pointer");
        e.typed = ty_err();
      } else {
        e.typed = a.elem;
      }
      return e.typed;
    }
    e.typed = ty_err();
    return e.typed;
  }
  if e.kind == ExprKind.ExCast {
    check_expr(e.a, null);
    let target: *Type = resolve_type_in_module(cur_module, e.ty);
    let srct: *Type = e.a.typed;
    let mut ok: bool = (ty_is_int(target) || ty_is_flt(target)) &&
        (ty_is_int(srct) || ty_is_flt(srct) || srct.kind == TypeKind.TyEnum ||
         srct.kind == TypeKind.TyIntLit || srct.kind == TypeKind.TyFloatLit ||
         srct.kind == TypeKind.TyParam || target.kind == TypeKind.TyParam);
    if srct.kind == TypeKind.TyBool || target.kind == TypeKind.TyBool {
      ok = false;
    }
    if (srct.kind == TypeKind.TyPtr || target.kind == TypeKind.TyPtr) &&
       (target.kind == TypeKind.TyUsize || target.kind == TypeKind.TyI64 ||
        srct.kind == TypeKind.TyUsize || srct.kind == TypeKind.TyI64) {
      ok = true;
    }
    if !ok {
      err_at("", 0, 0, "cannot cast to the requested type");
    }
    e.typed = target;
    return e.typed;
  }
  if e.kind == ExprKind.ExBin {
    let op: Tok = e.binop;
    let mut l: *Type = check_expr(e.a, null);
    let mut r: *Type = null;
    if op == Tok.PAndand || op == Tok.POror {
      if l.kind != TypeKind.TyBool {
        err_at("", 0, 0, "short-circuit operand must be bool");
      }
      r = check_expr(e.b, null);
      if r.kind == TypeKind.TyIntLit || r.kind == TypeKind.TyFloatLit {
        r = ty_prim(0);
        e.b.typed = r;
      }
      if r.kind != TypeKind.TyBool {
        err_at("", 0, 0, "short-circuit operand must be bool");
      }
      e.typed = ty_prim(0);
      return e.typed;
    }
    if l.kind == TypeKind.TyIntLit || l.kind == TypeKind.TyFloatLit || l.kind == TypeKind.TyNull {
      let r2: *Type = check_expr(e.b, null);
      l = adapt_literal(l, r2);
      e.a.typed = l;
      r = r2;
    } else {
      r = adapt_literal(check_expr(e.b, l), l);
      e.b.typed = r;
    }
    let cmp: bool = op == Tok.PEq || op == Tok.PNe || op == Tok.PLt ||
                    op == Tok.PGt || op == Tok.PLe || op == Tok.PGe;
    if cmp {
      let mut ok: bool = false;
      if op == Tok.PEq || op == Tok.PNe {
        ok = (ty_is_int(l) && ty_is_int(r)) || (ty_is_flt(l) && ty_is_flt(r)) ||
             (l.kind == TypeKind.TyBool && r.kind == TypeKind.TyBool) ||
             ((l.kind == TypeKind.TyPtr || l.kind == TypeKind.TyNull) && (r.kind == TypeKind.TyPtr || r.kind == TypeKind.TyNull)) ||
             (l.kind == TypeKind.TyWeak && (r.kind == TypeKind.TyWeak || r.kind == TypeKind.TyNull)) ||
             (l.kind == TypeKind.TyStringK && r.kind == TypeKind.TyStringK);
        if l.kind == TypeKind.TyEnum && l == r {
          ok = true;
        } else if l.kind == TypeKind.TyStruct || r.kind == TypeKind.TyStruct || l.kind == TypeKind.TyArray {
          ok = false;
        }
      } else {
        ok = (ty_is_int(l) && ty_is_int(r)) || (ty_is_flt(l) && ty_is_flt(r));
      }
      if !ok {
        err_at("", 0, 0, "cannot compare these types");
        return ty_err();
      }
      e.typed = ty_prim(0);
      return e.typed;
    }
    if op == Tok.PShl || op == Tok.PShr {
      if !ty_is_int(l) {
        err_at("", 0, 0, "shift needs an integer left side");
      }
      if !ty_is_int(r) {
        err_at("", 0, 0, "shift needs an integer right side");
      }
      e.typed = l;
      return e.typed;
    }
    if l != r {
      err_at("", 0, 0, "type mismatch in binary operator");
      e.typed = ty_err();
      return e.typed;
    }
    if op == Tok.PPlus || op == Tok.PMinus || op == Tok.PStar || op == Tok.PSlash || op == Tok.PPercent {
      if (!ty_is_int(l) && !ty_is_flt(l)) && l.kind != TypeKind.TyParam {
        err_at("", 0, 0, "arithmetic needs numbers");
      }
    } else if op == Tok.PAmp || op == Tok.PPipe || op == Tok.PCaret {
      if !ty_is_int(l) {
        err_at("", 0, 0, "bitwise needs integers");
      }
    }
    if l.kind == TypeKind.TyIntLit {
      l = ty_prim(3);
    }
    if l.kind == TypeKind.TyFloatLit {
      l = ty_prim(10);
      if e.a.typed.kind == TypeKind.TyFloatLit {
        e.a.typed = l;
      }
      if e.b.typed.kind == TypeKind.TyFloatLit {
        e.b.typed = l;
      }
    }
    e.typed = l;
    return e.typed;
  }
  if e.kind == ExprKind.ExIndex {
    let base: *Type = check_expr(e.a, null);
    let mut idx: *Type = check_expr(e.b, null);
    if idx.kind == TypeKind.TyIntLit {
      idx = ty_prim(12);
      e.b.typed = idx;
    }
    if !ty_is_int(idx) {
      err_at("", 0, 0, "index must be an integer");
    }
    if base.kind == TypeKind.TyArray || base.kind == TypeKind.TySlice {
      e.typed = base.elem;
    } else if base.kind == TypeKind.TyStringK {
      e.typed = ty_prim(5);
    } else {
      err_at("", 0, 0, "cannot index this type");
      e.typed = ty_err();
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExSlice {
    let base: *Type = check_expr(e.a, null);
    let mut lo: *Type = check_expr(e.b, null);
    let mut hi: *Type = check_expr(e.c, null);
    if lo.kind == TypeKind.TyIntLit {
      lo = ty_prim(12);
      e.b.typed = lo;
    }
    if hi.kind == TypeKind.TyIntLit {
      hi = ty_prim(12);
      e.c.typed = hi;
    }
    if !ty_is_int(lo) || !ty_is_int(hi) {
      err_at("", 0, 0, "slice bounds must be integers");
    }
    if base.kind == TypeKind.TyArray || base.kind == TypeKind.TySlice {
      e.typed = ty_slice(base.elem);
    } else if base.kind == TypeKind.TyStringK {
      e.typed = ty_prim(11);
    } else {
      err_at("", 0, 0, "cannot slice this type");
      e.typed = ty_err();
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExIf {
    return check_if_expr(e, expected);
  }
  if e.kind == ExprKind.ExQmark {
    // expr? : expr must be a Result; yields the Ok payload
    let et: *Type = check_expr(e.a, null);
    if et.kind != TypeKind.TyEnum {
      err_at("", 0, 0, "`?` needs a Result");
      e.typed = ty_err();
      return e.typed;
    }
    if len(et.rec.targs) != 2 {
      err_at("", 0, 0, "`?` needs a Result[T, E]");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = et.rec.targs[0];
    return e.typed;
  }
  if e.kind == ExprKind.ExClosure {
    // copy-capture closures: outer locals the body names are snapshotted
    let saved_caps: *Vec[*Sym] = g_cap_list;
    let saved_boundary: i32 = g_cap_boundary;
    let caps: *Vec[*Sym] = new Vec[*Sym] { items: make([]*Sym, 8), n: 0 };
    g_cap_list = caps;
    g_cap_boundary = next_local_id;
    // params: type ASTs resolve now; body checked in a nested scope
    scope_push();
    let mut ps: []*Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < e.params.n {
      let p: *Param = e.params.items[i];
      let pt: *Type = resolve_type_in_module(cur_module, p.ty);
      ps = push_type(ps, pt);
      let psym: *Sym = new Sym {
        kind: SymKind.SyParam, name: p.name, type: pt, decl: null,
        mutable: true, variant_index: 0, local_id: next_local_id, symbol: "",
    owner: cur_module,
      };
      next_local_id += 1;
      scope_decl(p.name, psym);
      i += 1;
    }
    let mut rt: *Type = ty_prim(14);
    if e.ret != null {
      rt = resolve_type_in_module(cur_module, e.ret);
    }
    // return statements inside check against the closure's return type
    let saved_ret: *Type = cur_ret;
    cur_ret = rt;
    let bt: *Type = check_block_value2(e.items);
    cur_ret = saved_ret;
    let ends_ret: bool = e.items.n > 0 && e.items.items[e.items.n - 1].kind == StmtKind.StReturn;
    if !ends_ret && rt.kind != TypeKind.TyVoid && bt != rt && bt.kind != TypeKind.TyErr &&
       bt.kind != TypeKind.TyIntLit && bt.kind != TypeKind.TyFloatLit &&
       rt.kind != TypeKind.TyErr {
      err_at("", 0, 0, "closure body type mismatch");
    }
    scope_pop();
    g_cap_list = saved_caps;
    g_cap_boundary = saved_boundary;
    let mut ci: usize = 0;
    while ci < caps.n {
      let cap: *Sym = caps.items[ci];
      if cap.kind == SymKind.SyLocal && cap.mutable {
        err_at("", 0, 0, cat("cannot capture mutable `", cat(cap.name, "` (boot-era closures copy; box it in a struct instead)")));
      }
      ci += 1;
    }
    e.caps = caps.items[0..caps.n];
    e.typed = ty_fn(ps, rt);
    return e.typed;
  }
  if e.kind == ExprKind.ExField {
    return check_field_access(e, expected);
  }
  if e.kind == ExprKind.ExCall {
    return check_call(e, expected);
  }
  if e.kind == ExprKind.ExNew {
    return check_new(e);
  }
  if e.kind == ExprKind.ExMatch {
    return check_match(e, expected);
  }
  eprint("[unhandled expr kind=");
  eprint(itoa(e.kind as i64));
  eprint("]\n");
  err_at("", 0, 0, "internal: expression kind not yet checked");
  e.typed = ty_err();
  return e.typed;
}


// ============== field access & new (check.c port L6b) =====================

fn struct_field_type(rec: *RecType, i: usize) -> *Type {
  if !rec.fields_done {
    if rec.resolving {
      return ty_err(); // self-containing struct; layout phase reports it
    }
    rec.resolving = true;
    let d: *Decl = rec.decl;
    let saved: *Module = cur_module;
    let saved_env: *TypeMap = g_tenv;
    // owner module of the rec is approximated by cur_module's prelude flag:
    // the self compiler checks one module at a time
    if prelude_module != null && rec.is_prelude {
      cur_module = prelude_module;
    }
    g_tenv = rec.env_tenv;
    let mut j: usize = 0;
    while j < d.fields.n {
      let fa: *FieldAst = d.fields.items[j];
      rec.field_types = push_type(rec.field_types, resolve_type_in_module(rec.owner_module(), fa.ty));
      j += 1;
    }
    g_tenv = saved_env;
    rec.resolving = false;
    rec.fields_done = true;
    cur_module = saved;
  }
  if len(rec.field_types) > i {
    return rec.field_types[i];
  }
  return ty_err();
}

// RecType keeps the owning module (needed to resolve field types in the
// right namespace); rho port stores it directly
fn RecType.owner_module(self: *RecType) -> *Module {
  if self.owner_mod != null {
    return self.owner_mod;
  }
  return cur_module;
}

fn check_field_access(e: *Expr, expected: *Type) -> *Type {
  eprint("[fa ");
  eprint(e.sv);
  eprint("]\n");
  let base: *Type = check_expr(e.a, null);
  if base.kind == TypeKind.TySlice || base.kind == TypeKind.TyStringK {
    if streq(e.sv, "len") {
      e.typed = ty_prim(12);
      return e.typed;
    }
    if streq(e.sv, "ptr") {
      if base.kind == TypeKind.TyStringK {
        e.typed = ty_ptr(ty_prim(5));
      } else {
        e.typed = ty_ptr(base.elem);
      }
      return e.typed;
    }
    err_at("", 0, 0, "slices have `len` and `ptr`");
    e.typed = ty_err();
    return e.typed;
  }
  if base.kind == TypeKind.TyPtr {
    let deref: *Type = base.elem;
    if deref.kind == TypeKind.TyStruct {
      let rec: *RecType = deref.rec;
      eprint("[FA-REC m=");
      eprint(rec.mangled);
      eprint(" field=");
      eprint(e.sv);
      eprint(" done=");
      if rec.fields_done { eprint("y"); } else { eprint("n"); }
      eprint("\n");
      let d: *Decl = rec.decl;
      let mut i: usize = 0;
      while i < d.fields.n {
        let fa: *FieldAst = d.fields.items[i];
        if streq(fa.name, e.sv) {
          e.typed = struct_field_type(rec, i);
          return e.typed;
        }
        i += 1;
      }
      err_at("", 0, 0, "no field on this struct");
      e.typed = ty_err();
      return e.typed;
    }
    err_at("", 0, 0, "auto-deref only works on struct pointers");
    e.typed = ty_err();
    return e.typed;
  }
  if base.kind == TypeKind.TyStruct {
    let rec: *RecType = base.rec;
    let d: *Decl = rec.decl;
    let mut i: usize = 0;
    while i < d.fields.n {
      let fa: *FieldAst = d.fields.items[i];
      if streq(fa.name, e.sv) {
        e.typed = struct_field_type(rec, i);
        return e.typed;
      }
      i += 1;
    }
    err_at("", 0, 0, "no such field on struct");
    e.typed = ty_err();
    return e.typed;
  }
  if e.a.kind == ExprKind.ExName {
    let sym: *Sym = e.a.sym;
    if sym != null && sym.kind == SymKind.SyEnum {
      let d: *Decl = sym.decl;
      let mut i: usize = 0;
      while i < d.variants.n {
        let v: *VariantAst = d.variants.items[i];
        if streq(v.name, e.sv) {
          if v.vkind != VarKind.VarUnit {
            err_at("", 0, 0, "variant carries a payload; call it to construct");
            e.typed = ty_err();
            return e.typed;
          }
          let mut vtype: *Type = sym.type;
          // unit variant of a generic enum: take the expected instantiation
          // when the context pins one (`let x: Option[i32] = Option.None`)
          if vtype != null && vtype.rec != null && vtype.rec.is_template &&
             expected != null && expected.kind == TypeKind.TyEnum &&
             expected.rec != null && expected.rec.decl == d {
            vtype = expected;
          }
          let vs: *Sym = new Sym {
            kind: SymKind.SyVariant, name: e.sv, type: vtype, decl: d,
            mutable: false, variant_index: i as i32, local_id: 0, symbol: "",
    owner: cur_module,
          };
          e.sym = vs;
          e.typed = vs.type;
          return e.typed;
        }
        i += 1;
      }
      err_at("", 0, 0, "enum has no such variant");
      e.typed = ty_err();
      return e.typed;
    }
  }
  err_at("", 0, 0, "cannot access field");
  e.typed = ty_err();
  return e.typed;
}

fn check_new(e: *Expr) -> *Type {
  eprint("[new enter items=");
  eprint(itoa(e.items.n as i64));
  eprint(" args=");
  eprint(itoa(e.args.n as i64));
  eprint("\n");
  let t: *Type = resolve_type_in_module(cur_module, e.ty);
  if t.kind != TypeKind.TyStruct {
    err_at("", 0, 0, "`new` takes a struct type");
    e.typed = ty_err();
    return e.typed;
  }
  let rec: *RecType = t.rec;
  let d: *Decl = rec.decl;
  eprint("[new fields=");
  eprint(itoa(d.fields.n as i64));
  eprint("\n");
  struct_field_type(rec, if d.fields.n > 0 { d.fields.n - 1 } else { 0 });
  if e.items.n != d.fields.n {
    err_at("", 0, 0, "struct initializer count mismatch");
  }
  let mut i: usize = 0;
  while i < e.items.n {
    eprint("[new field i=");
    eprint(itoa(i as i64));
    eprint("\n");
    let entry: *Stmt = e.items.items[i];
    let fname: string = entry.name;
    let argi: *Expr = e.args.items[i];
    eprint("[fa=");
    eprint(fname);
    eprint("]\n");
    let mut found: bool = false;
    let mut j: usize = 0;
    while j < d.fields.n {
      let df: *FieldAst = d.fields.items[j];
      eprint("[df=");
      eprint(df.name);
      eprint("]\n");
      if streq(df.name, fname) {
        eprint("[match j=");
        eprint(itoa(j as i64));
        eprint("\n");
        let ft: *Type = struct_field_type(rec, j);
        eprint("[sft done\n");
        let got: *Type = check_expr(argi, ft);
        eprint("[init checked\n");
        if got != ft && got.kind != TypeKind.TyIntLit && got.kind != TypeKind.TyFloatLit &&
           got.kind != TypeKind.TyErr && ft.kind != TypeKind.TyErr &&
           got.kind != TypeKind.TyParam && ft.kind != TypeKind.TyParam &&
           !type_has_param(ft) {
          err_at("", 0, 0, "field initializer type mismatch");
        }
        argi.typed = adapt_literal(got, ft);
        found = true;
        break;
      }
      j += 1;
    }
    if !found {
      err_at("", 0, 0, "no such field on struct");
    }
    i += 1;
  }
  e.typed = ty_ptr(t);
  return e.typed;
}


// ============== match checking (check.c port L6c, compact) ===============



// resolve a payload field type of an enum variant against the enum's own
// tparam environment (simplified variant_field_type: no layout needed for
// checking, only for lowering — the layout port arrives with L6d)
fn variant_field_type(enum_t: *Type, variant: i32, field: i32) -> *Type {
  let rec: *RecType = enum_t.rec;
  let d: *Decl = rec.decl;
  if variant < 0 || variant >= d.variants.n as i32 {
    return ty_err();
  }
  let v: *VariantAst = d.variants.items[variant];
  let mut ta: *TypeAst = null;
  if v.vkind == VarKind.VarTuple {
    if field < 0 || field >= v.types.n as i32 {
      return ty_err();
    }
    ta = v.types.items[field];
  } else if v.vkind == VarKind.VarStruct {
    if field < 0 || field >= v.fields.n as i32 {
      return ty_err();
    }
    ta = v.fields.items[field].ty;
  } else {
    return ty_err();
  }
  let saved: *Module = cur_module;
  let saved_env: *TypeMap = g_tenv;
  if rec.is_prelude && prelude_module != null {
    cur_module = prelude_module;
  }
  g_tenv = rec.env_tenv;
  let t: *Type = resolve_type_in_module(cur_module, ta);
  g_tenv = saved_env;
  cur_module = saved;
  return t;
}

fn check_match(e: *Expr, expected: *Type) -> *Type {
  let scrut: *Type = check_expr(e.a, null);
  let mut ed: *Decl = null;
  let int_match: bool = ty_is_int(scrut) || scrut.kind == TypeKind.TyIntLit;
  if scrut.kind == TypeKind.TyEnum {
    ed = scrut.rec.decl;
  } else if !int_match {
    err_at("", 0, 0, "match scrutinee must be an enum or integer");
    e.typed = ty_err();
    return e.typed;
  }
  let mut result: *Type = null;
  let mut i: usize = 0;
  while i < e.arms.n {
    let arm: *MatchArm = e.arms.items[i];
    if ed != null && arm.pk != PatKind.PatWildcard {
      let vn: string = arm.pat_path.items[arm.pat_path.n - 1];
      let mut found: bool = false;
      let mut j: usize = 0;
      while j < ed.variants.n {
        let v: *VariantAst = ed.variants.items[j];
        if streq(v.name, vn) {
          found = true;
          arm.variant_index = j as i32;
          arm.disc = v.disc;
          let nfields: usize = if v.vkind == VarKind.VarStruct { v.fields.n } else { v.types.n };
          let nbinds: usize = arm.pat_names.n;
          if arm.pk != PatKind.PatUnit && nbinds != nfields {
            err_at("", 0, 0, "pattern binds the wrong number of values");
          } else if arm.pk == PatKind.PatTuple {
            eprint("[tuple bind nbinds=");
            eprint(itoa(nbinds as i64));
            eprint(" nfields=");
            eprint(itoa(nfields as i64));
            eprint("]\n");
            let mut b: usize = 0;
            while b < nbinds && b < nfields {
              let nm: string = arm.pat_names.items[b];
              if !streq(nm, "_") {
                let bs: *Sym = new Sym {
                  kind: SymKind.SyLocal, name: nm,
                  type: variant_field_type(scrut, arm.variant_index, b as i32),
                  decl: null, mutable: false, variant_index: 0,
                  local_id: next_local_id, symbol: "",
    owner: cur_module,
                };
                eprint("[bind ");
                eprint(nm);
                eprint(" t=");
                eprint(bs.type.mangled);
                eprint("\n");
                next_local_id += 1;
                arm.bind_syms = push_sym(arm.bind_syms, bs);
                arm.bind_fidx = push_i64(arm.bind_fidx, b as i64);
              } else {
                arm.bind_syms = push_sym(arm.bind_syms, null);
                arm.bind_fidx = push_i64(arm.bind_fidx, b as i64);
              }
              b += 1;
            }
          } else if arm.pk == PatKind.PatStruct {
            // named pattern fields: resolve each binding by field NAME
            let mut b: usize = 0;
            while b < nbinds && b < nfields {
              let fa: *FieldAst = arm.pat_fields.items[b];
              let nm: string = arm.pat_names.items[b];
              let mut fidx: i64 = (0 - 1) as i64;
              let mut j2: usize = 0;
              while j2 < v.fields.n {
                let vf: *FieldAst = v.fields.items[j2];
                if streq(vf.name, fa.name) {
                  fidx = j2 as i64;
                  break;
                }
                j2 += 1;
              }
              if !streq(nm, "_") {
                let bs: *Sym = new Sym {
                  kind: SymKind.SyLocal, name: nm,
                  type: variant_field_type(scrut, arm.variant_index, fidx as i32),
                  decl: null, mutable: false, variant_index: 0,
                  local_id: next_local_id, symbol: "",
    owner: cur_module,
                };
                next_local_id += 1;
                arm.bind_syms = push_sym(arm.bind_syms, bs);
                arm.bind_fidx = push_i64(arm.bind_fidx, fidx);
              } else {
                arm.bind_syms = push_sym(arm.bind_syms, null);
                arm.bind_fidx = push_i64(arm.bind_fidx, fidx);
              }
              b += 1;
            }
          } else if arm.pk == PatKind.PatTuple {
            let mut b: usize = 0;
            while b < nbinds && b < nfields {
              let nm: string = arm.pat_names.items[b];
              if !streq(nm, "_") {
                let bs: *Sym = new Sym {
                  kind: SymKind.SyLocal, name: nm,
                  type: variant_field_type(scrut, arm.variant_index, b as i32),
                  decl: null, mutable: false, variant_index: 0,
                  local_id: next_local_id, symbol: "",
    owner: cur_module,
                };
                next_local_id += 1;
                arm.bind_syms = push_sym(arm.bind_syms, bs);
              } else {
                arm.bind_syms = push_sym(arm.bind_syms, null);
              }
              b += 1;
            }
          }
          break;
        }
        j += 1;
      }
      if !found {
        err_at("", 0, 0, "no such variant on this enum");
      }
    }
    scope_push();
    let mut bi: usize = 0;
    while bi < len(arm.bind_syms) {
      let bs: *Sym = arm.bind_syms[bi];
      if bs != null {
        scope_decl(bs.name, bs);
      }
      bi += 1;
    }
    let arm_t: *Type = check_expr(arm.body, expected);
    eprint("[arm t=");
    if arm_t == null {
      eprint("null");
    } else {
      eprint(arm_t.mangled);
    }
    eprint("\n");
    if result == null {
      result = arm_t;
    } else if arm_t != result && arm_t.kind != TypeKind.TyErr && result.kind != TypeKind.TyErr &&
              arm_t.kind != TypeKind.TyParam && result.kind != TypeKind.TyParam {
      err_at("", 0, 0, "match arms have inconsistent types");
      result = ty_err();
    }
    scope_pop();
    i += 1;
  }
  if result == null {
    result = ty_prim(14);
  }
  e.typed = result;
  return e.typed;
}

fn push_sym(items: []*Sym, s: *Sym) -> []*Sym {
  let out: []*Sym = make([]*Sym, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = s;
  return out;
}


// ============== callee resolution (check.c port L6d-1) ====================

enum CtKind { CtNone, CtFn, CtExtern, CtVariant, CtIndirect }

struct CallTarget {
  kind: CtKind,
  sym: *Sym,
  fn_type: *Type,
  variant: i32,
  enum_type: *Type,
  is_method: bool,
  is_ctor: bool,
  inst_rec: *RecType,
}

fn deref_to_struct(t: *Type) -> *Type {
  let mut cur: *Type = t;
  while cur != null && cur.kind == TypeKind.TyPtr {
    cur = cur.elem;
  }
  if cur != null && (cur.kind == TypeKind.TyStruct || cur.kind == TypeKind.TyEnum) {
    return cur;
  }
  return null;
}

fn resolve_callee(callee: *Expr) -> *CallTarget {
  let ct: *CallTarget = new CallTarget {
    kind: CtKind.CtNone, sym: null, fn_type: null, variant: 0,
    enum_type: null, is_method: false, is_ctor: false, inst_rec: null,
  };
  if callee.kind == ExprKind.ExName {
    let sym: *Sym = lookup(callee.sv);
    if sym == null {
      err_at("", 0, 0, cat("unknown function `", cat(callee.sv, "`")));
      return ct;
    }
    if sym.kind == SymKind.SyFn || sym.kind == SymKind.SyExtern {
      ct.kind = CtKind.CtFn;
      if sym.kind == SymKind.SyExtern {
        ct.kind = CtKind.CtExtern;
      }
      ct.sym = sym;
      ct.fn_type = sym.type;
      callee.sym = sym;
      return ct;
    }
    if sym.type != null && sym.type.kind == TypeKind.TyFn {
      ct.kind = CtKind.CtIndirect;
      ct.fn_type = sym.type;
      callee.sym = sym;
      callee.typed = sym.type;
      return ct;
    }
    err_at("", 0, 0, "this name is not a function");
    return ct;
  }
  if callee.kind == ExprKind.ExField {
    if callee.a.kind == ExprKind.ExName {
      let base: *Sym = lookup(callee.a.sv);
      if base != null && base.kind == SymKind.SyModule {
        err_at("", 0, 0, "module-qualified calls pending multi-module check");
        return ct;
      }
      if base != null && base.kind == SymKind.SyEnum {
        let d: *Decl = base.decl;
        let mut i: usize = 0;
        while i < d.variants.n {
          let v: *VariantAst = d.variants.items[i];
          if streq(v.name, callee.sv) {
            ct.kind = CtKind.CtVariant;
            ct.variant = i as i32;
            ct.enum_type = base.type;
            ct.is_ctor = v.vkind == VarKind.VarStruct;
            let vs: *Sym = new Sym {
              kind: SymKind.SyVariant, name: callee.sv, type: base.type,
              decl: d, mutable: false, variant_index: i as i32,
              local_id: 0, symbol: "",
    owner: cur_module,
            };
            callee.sym = vs;
            return ct;
          }
          i += 1;
        }
      }
      if base != null && (base.kind == SymKind.SyStruct || base.kind == SymKind.SyEnum) {
        // associated function `Type.make(...)` lives under `Type.make`
        let fn_sym: *Sym = sm_get(cur_module.syms, callee.sv);
        if fn_sym != null && fn_sym.kind == SymKind.SyFn && !fn_sym.decl.is_method {
          ct.kind = CtKind.CtFn;
          ct.sym = fn_sym;
          ct.fn_type = fn_sym.type;
          callee.sym = fn_sym;
          return ct;
        }
        err_at("", 0, 0, "type has no such associated function");
        return ct;
      }
    }
    // method call: `receiver.name(...)`
    let bt: *Type = check_expr(callee.a, null);
    let rec_t: *Type = deref_to_struct(bt);
    if rec_t != null {
      let rec: *RecType = rec_t.rec;
      let mut i: usize = 0;
      eprint("[meths of ");
      eprint(rec.mangled);
      eprint(":");
      let mut mi: usize = 0;
      while mi < len(rec.methods) {
        eprint(rec.methods[mi].name);
        eprint(",");
        mi += 1;
      }
      eprint("]\n");
      while i < len(rec.methods) {
        let m: *Sym = rec.methods[i];
        if streq(m.name, callee.sv) {
          ct.kind = CtKind.CtFn;
          ct.sym = m;
          ct.fn_type = m.type;
          ct.is_method = true;
          callee.sym = m;
          callee.a.typed = bt;
          return ct;
        }
        i += 1;
      }
      eprint("[tmplchk rec=");
      eprint(rec.mangled);
      eprint(" istpl=");
      if rec.is_template {
        eprint("y");
      } else {
        eprint("n");
      }
      eprint(" decltpl=");
      if rec.decl.templ != null {
        eprint("y");
      } else {
        eprint("n");
      }
      eprint("]\n");
      if !rec.is_template && rec.decl.templ != null {
        let tmpl: *RecType = rec.decl.templ;
        eprint("[tmpl meths: ");
        let mut ti: usize = 0;
        while ti < len(tmpl.methods) {
          eprint(tmpl.methods[ti].name);
          eprint(",");
          ti += 1;
        }
        eprint("]\n");
        let mut j: usize = 0;
        while j < len(tmpl.methods) {
          let m: *Sym = tmpl.methods[j];
          if streq(m.name, callee.sv) {
            ct.kind = CtKind.CtFn;
            ct.sym = m;
            ct.fn_type = m.type;
            ct.is_method = true;
            ct.inst_rec = rec;
            callee.sym = m;
            callee.a.typed = bt;
            return ct;
          }
          j += 1;
        }
      }
    }
    err_at("", 0, 0, "no such method for this receiver");
    return ct;
  }
  let t: *Type = check_expr(callee, null);
  if t.kind == TypeKind.TyFn {
    ct.kind = CtKind.CtIndirect;
    ct.fn_type = t;
    return ct;
  }
  err_at("", 0, 0, "cannot call this expression");
  return ct;
}


// ============== check_call: builtins (check.c port L6d-2) =================

fn check_call(e: *Expr, expected: *Type) -> *Type {
  eprint("[call kind=");
  eprint(itoa(e.a.kind as i64));
  eprint(" name=");
  if e.a.kind == ExprKind.ExName {
    eprint(e.a.sv);
  } else if e.a.kind == ExprKind.ExField {
    eprint(e.a.sv);
  }
  eprint("]\n");
  // make(T, n)
  if e.a.kind == ExprKind.ExName && streq(e.a.sv, "make") {
    if e.args.n != 2 {
      err_at("", 0, 0, "make takes (type, length)");
      e.typed = ty_err();
      return e.typed;
    }
    let tye: *Expr = e.args.items[0];
    if tye.kind != ExprKind.ExType || tye.ty.kind != TypeAstKind.TaArray || tye.ty.size != null {
      err_at("", 0, 0, "make takes a slice type like `[]i32`");
      e.typed = ty_err();
      return e.typed;
    }
    let elem: *Type = resolve_type_in_module(cur_module, tye.ty.elem);
    let mut ln: *Type = check_expr(e.args.items[1], null);
    if ln.kind == TypeKind.TyIntLit {
      ln = ty_prim(12);
      e.args.items[1].typed = ln;
    }
    if !ty_is_int(ln) {
      err_at("", 0, 0, "make length must be an integer");
    }
    e.typed = ty_slice(elem);
    return e.typed;
  }
  // len(x)
  if e.a.kind == ExprKind.ExName && streq(e.a.sv, "len") {
    if e.args.n != 1 {
      err_at("", 0, 0, "len takes one argument");
      e.typed = ty_err();
      return e.typed;
    }
    let t: *Type = check_expr(e.args.items[0], null);
    if t.kind != TypeKind.TySlice && t.kind != TypeKind.TyStringK && t.kind != TypeKind.TyArray {
      err_at("", 0, 0, "len needs an array, slice or string");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = ty_prim(12);
    return e.typed;
  }
  // weak.from(p)
  if e.a.kind == ExprKind.ExField && e.a.a.kind == ExprKind.ExName &&
     streq(e.a.a.sv, "weak") && streq(e.a.sv, "from") {
    if e.args.n != 1 {
      err_at("", 0, 0, "weak.from takes one argument");
      e.typed = ty_err();
      return e.typed;
    }
    let t: *Type = check_expr(e.args.items[0], null);
    if t.kind != TypeKind.TyPtr ||
       (t.elem.kind != TypeKind.TyStruct && t.elem.kind != TypeKind.TyEnum) {
      err_at("", 0, 0, "weak.from needs a pointer to a new object");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = ty_weak(t.elem);
    return e.typed;
  }
  // w.get()
  if e.a.kind == ExprKind.ExField && streq(e.a.sv, "get") {
    let mut bt: *Type = e.a.a.typed;
    if bt == null {
      bt = check_expr(e.a.a, null);
    }
    if bt != null && bt.kind == TypeKind.TyWeak {
      if e.args.n != 0 {
        err_at("", 0, 0, "get takes no arguments");
      }
      e.typed = ty_ptr(bt.elem);
      return e.typed;
    }
  }
  // intrinsics.*
  if e.a.kind == ExprKind.ExField && e.a.a.kind == ExprKind.ExName &&
     streq(e.a.a.sv, "intrinsics") {
    let name: string = e.a.sv;
    let is_load: bool = streq(name, "load_u8") || streq(name, "load_u32") ||
                        streq(name, "load_u64") || streq(name, "load_i64");
    let is_store: bool = streq(name, "store_u8") || streq(name, "store_u32") ||
                         streq(name, "store_u64") || streq(name, "store_i64");
    let is_memcpy: bool = streq(name, "memcpy");
    let is_slice_str: bool = streq(name, "slice_string");
    let is_bits: bool = streq(name, "f64_bits") || streq(name, "f32_bits");
    if !is_load && !is_store && !is_memcpy && !is_slice_str && !is_bits {
      err_at("", 0, 0, cat("unknown intrinsic `", cat(name, "`")));
      e.typed = ty_err();
      return e.typed;
    }
    if is_bits {
      if e.args.n != 1 {
        err_at("", 0, 0, cat("unknown intrinsic `", cat(name, "`")));
        e.typed = ty_err();
        return e.typed;
      }
      let t: *Type = check_expr(e.args.items[0], null);
      let wantf64: bool = streq(name, "f64_bits");
      if wantf64 && t.kind != TypeKind.TyF64 {
        err_at("", 0, 0, "intrinsics.f64_bits needs f64");
        e.typed = ty_err();
        return e.typed;
      }
      if !wantf64 && t.kind != TypeKind.TyF32 {
        err_at("", 0, 0, "intrinsics.f32_bits needs f32");
        e.typed = ty_err();
        return e.typed;
      }
      if wantf64 {
        e.typed = ty_prim(8); // u64
      } else {
        e.typed = ty_prim(7); // u32
      }
      return e.typed;
    }
    if is_load {
      if e.args.n != 1 {
        err_at("", 0, 0, "intrinsics load takes one pointer");
        e.typed = ty_err();
        return e.typed;
      }
      let t: *Type = check_expr(e.args.items[0], null);
      if t.kind != TypeKind.TyPtr {
        err_at("", 0, 0, "intrinsics load needs a pointer");
        e.typed = ty_err();
        return e.typed;
      }
      let mut k: i32 = 8; // u32 default falls out below
      if streq(name, "load_u8") { k = 5; }
      if streq(name, "load_u32") { k = 7; }
      if streq(name, "load_u64") { k = 8; }
      if streq(name, "load_i64") { k = 4; }
      e.typed = ty_prim(k);
      return e.typed;
    }
    if is_store {
      if e.args.n != 2 {
        err_at("", 0, 0, "intrinsics store takes pointer and value");
        e.typed = ty_err();
        return e.typed;
      }
      let t: *Type = check_expr(e.args.items[0], null);
      if t.kind != TypeKind.TyPtr {
        err_at("", 0, 0, "intrinsics store needs a pointer");
        e.typed = ty_err();
        return e.typed;
      }
      check_expr(e.args.items[1], null);
      e.typed = ty_prim(14);
      return e.typed;
    }
    if is_memcpy {
      if e.args.n != 3 {
        err_at("", 0, 0, "memcpy takes dst, src and count");
        e.typed = ty_err();
        return e.typed;
      }
      check_expr(e.args.items[0], null);
      check_expr(e.args.items[1], null);
      check_expr(e.args.items[2], null);
      e.typed = ty_prim(14);
      return e.typed;
    }
    // slice_string
    if e.args.n != 1 {
      err_at("", 0, 0, "slice_string takes one []u8");
      e.typed = ty_err();
      return e.typed;
    }
    let t: *Type = check_expr(e.args.items[0], null);
    if t.kind != TypeKind.TySlice {
      err_at("", 0, 0, "slice_string takes a []u8");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = ty_prim(11);
    return e.typed;
  }
  // general call path (L6e): resolve_callee + arg checking + generics
  let ct: *CallTarget = resolve_callee(e.a);
  if ct.kind == CtKind.CtNone {
    e.typed = ty_err();
    return e.typed;
  }
  if ct.kind == CtKind.CtVariant {
    // variant construction: if the context pins an instantiation of the same
    // enum, use it; payloads resolve under the enum's template env
    if expected != null && expected.kind == TypeKind.TyEnum &&
       expected.rec != null && expected.rec.decl == ct.enum_type.rec.decl {
      ct.enum_type = expected;
    }
    let d: *Decl = ct.enum_type.rec.decl;
    let v: *VariantAst = d.variants.items[ct.variant];
    let saved_env: *TypeMap = g_tenv;
    if ct.enum_type.rec.env_tenv != null {
      g_tenv = ct.enum_type.rec.env_tenv;
    }
    if ct.is_ctor {
      let mut i: usize = 0;
      while i < e.args.n {
        let init: *Expr = e.args.items[i];
        check_expr(init, null);
        i += 1;
      }
    } else {
      let mut i: usize = 0;
      while i < e.args.n {
        let mut at: *Type = null;
        if i < v.types.n {
          at = resolve_type_in_module(cur_module, v.types.items[i]);
        }
        check_expr(e.args.items[i], at);
        i += 1;
      }
    }
    g_tenv = saved_env;
    e.typed = ct.enum_type;
    return e.typed;
  }
  // generic call: infer the type arguments and specialize
  if ct.kind == CtKind.CtFn &&
     (ct.inst_rec != null || (ct.sym.decl.templated && ct.sym.decl.tparams.n > 0)) {
    let env: *TypeMap = tm_new();
    let names: *Vec[string] = make_str_vec();
    if ct.inst_rec != null {
      let rd: *Decl = ct.inst_rec.decl;
      let mut ri: usize = 0;
      while ri < rd.tparams.n && ri < len(ct.inst_rec.targs) {
        names.push(rd.tparams.items[ri]);
        tm_put(env, rd.tparams.items[ri], ct.inst_rec.targs[ri]);
        ri += 1;
      }
    }
    let mut ni: usize = 0;
    while ni < ct.sym.decl.tparams.n {
      names.push(ct.sym.decl.tparams.items[ni]);
      ni += 1;
    }
    let fn_t: *Type = ct.fn_type; // template signature
    let nparams0: usize = len(fn_t.params);
    let first: usize = if ct.is_method { 1 } else { 0 };
    if ct.is_method {
      let mut recv: *Type = e.a.a.typed;
      if recv == null {
        recv = check_expr(e.a.a, null);
      }
      infer_targs(fn_t.params[0], recv, env);
    }
    if e.args.n + first != nparams0 {
      err_at("", 0, 0, "argument count mismatch");
      e.typed = ty_err();
      return e.typed;
    }
    let mut gi: usize = 0;
    while gi < e.args.n {
      let at: *Type = check_expr(e.args.items[gi], null);
      infer_targs(fn_t.params[first + gi], at, env);
      gi += 1;
    }
    // untyped literals adapt through a direct `-> T` return
    if expected != null && fn_t.ret != null && fn_t.ret.kind == TypeKind.TyParam {
      let targ: *Type = tm_get(env, fn_t.ret.mangled);
      if targ != null && targ.kind == TypeKind.TyIntLit && ty_is_int(expected) {
        tm_put(env, fn_t.ret.mangled, expected);
      } else if targ != null && targ.kind == TypeKind.TyFloatLit && ty_is_flt(expected) {
        tm_put(env, fn_t.ret.mangled, expected);
      }
    }
    let inst: *Sym = instantiate_fn(ct.sym, names.items[0..names.n], env);
    ct.sym = inst;
    ct.fn_type = inst.type;
    ct.inst_rec = null;
    e.a.sym = inst; // lower emits the call against the instantiation
  }
  // fn/extern/indirect: check args against the signature
  let ft: *Type = ct.fn_type;
  let nparams: usize = len(ft.params);
  let mut arg_off: usize = 0;
  if ct.is_method {
    // ft.params[0] is self; the receiver expression supplies it
    arg_off = 1;
  }
  if e.args.n != nparams - arg_off {
    err_at("", 0, 0, "argument count mismatch");
    e.typed = ty_err();
    return e.typed;
  }
  let mut i: usize = 0;
  while i < e.args.n {
    let pt: *Type = ft.params[i + arg_off];
    let got: *Type = check_expr(e.args.items[i], pt);
    let adapted: *Type = adapt_literal(got, pt);
    if adapted != pt && adapted.kind != TypeKind.TyIntLit &&
       adapted.kind != TypeKind.TyFloatLit && adapted.kind != TypeKind.TyNull &&
       pt.kind != TypeKind.TyErr && got.kind != TypeKind.TyErr &&
       pt.kind != TypeKind.TyParam && !type_has_param(pt) {
      err_at("", 0, 0, "argument type mismatch");
      e.typed = ty_err();
      return e.typed;
    }
    e.args.items[i].typed = adapted;
    i += 1;
  }
  e.typed = ft.ret;
  return e.typed;
}


// ============== statement checking (check.c port L6e) =====================

static mut in_defer: bool = false;
static mut loop_depth: i32 = 0;

fn ty_is_or_has_err(t: *Type) -> bool {
  if t == null {
    return false;
  }
  if t.kind == TypeKind.TyErr {
    return true;
  }
  if t.elem != null && ty_is_or_has_err(t.elem) {
    return true;
  }
  if t.ret != null && ty_is_or_has_err(t.ret) {
    return true;
  }
  return false;
}

fn lvalue_mutable(e: *Expr) -> bool {
  if e.kind == ExprKind.ExName {
    let sym: *Sym = e.sym;
    if sym == null {
      return false;
    }
    if sym.kind == SymKind.SyLocal || sym.kind == SymKind.SyParam ||
       sym.kind == SymKind.SyStatic {
      return sym.mutable;
    }
    return false;
  }
  if e.kind == ExprKind.ExUn && e.unop == Tok.PStar {
    return true; // *p — the pointer decides
  }
  if e.kind == ExprKind.ExField {
    let bt: *Type = e.a.typed;
    if bt != null && bt.kind == TypeKind.TyPtr {
      return true; // heap object
    }
    return lvalue_mutable(e.a);
  }
  if e.kind == ExprKind.ExIndex {
    let bt: *Type = e.a.typed;
    if bt != null && bt.kind == TypeKind.TySlice {
      return true; // heap buffer shared by reference
    }
    return lvalue_mutable(e.a);
  }
  return false;
}

fn check_stmt(s: *Stmt) {
  if s.kind == StmtKind.StLet {
    let mut ann: *Type = null;
    if s.ty != null {
      ann = resolve_type_in_module(cur_module, s.ty);
    }
    let mut t: *Type = check_expr(s.a, ann);
    if ann != null {
      if !ty_is_or_has_err(ann) && !ty_is_or_has_err(t) && t != ann &&
         t.kind != TypeKind.TyIntLit && t.kind != TypeKind.TyFloatLit &&
         t.kind != TypeKind.TyNull && t.kind != TypeKind.TyErr &&
         ann.kind != TypeKind.TyParam && t.kind != TypeKind.TyParam &&
         !type_has_param(ann) && !type_has_param(t) {
        eprint("[letmis ");
        eprint(s.name);
        eprint("\n");
        err_at("", 0, 0, "initializer type mismatch");
      }
      t = ann;
    } else {
      if t.kind == TypeKind.TyIntLit {
        t = ty_prim(3);
      } else if t.kind == TypeKind.TyFloatLit {
        t = ty_prim(10);
      } else if t.kind == TypeKind.TyNull {
        err_at("", 0, 0, "`null` needs a type annotation");
        t = ty_err();
      } else if t.kind == TypeKind.TyErr {
        t = ty_err();
      }
    }
    let sym: *Sym = new Sym {
      kind: SymKind.SyLocal, name: s.name, type: t, decl: null,
      mutable: s.mut_, variant_index: 0, local_id: next_local_id, symbol: "",
    owner: cur_module,
    };
    next_local_id += 1;
    if lookup(s.name) != null {
      err_at("", 0, 0, "shadowing is not allowed (spec §5)");
    }
    scope_decl(s.name, sym);
    s.a.typed = t;
    return;
  }
  if s.kind == StmtKind.StAssign {
    let target: *Type = check_expr(s.a, null);
    let value: *Type = adapt_literal(check_expr(s.b, target), target);
    s.b.typed = value;
    if target != value && !(ty_is_int(target) && ty_is_int(value)) &&
       !(ty_is_flt(target) && ty_is_flt(value)) &&
       target.kind != TypeKind.TyErr && value.kind != TypeKind.TyErr {
      err_at("", 0, 0, "type mismatch in assignment");
    }
    if !lvalue_mutable(s.a) {
      err_at("", 0, 0, "cannot assign to an immutable binding (declare it `let mut`)");
    }
    return;
  }
  if s.kind == StmtKind.StExpr {
    check_expr(s.a, null);
    return;
  }
  if s.kind == StmtKind.StReturn {
    if cur_ret == null || cur_ret.kind == TypeKind.TyVoid {
      if s.a != null {
        err_at("", 0, 0, "this function returns nothing");
      }
    } else {
      if s.a == null {
        err_at("", 0, 0, "missing return value");
      } else {
        let got: *Type = check_expr(s.a, cur_ret);
        let adapted: *Type = adapt_literal(got, cur_ret);
        s.a.typed = adapted;
      }
    }
    return;
  }
  if s.kind == StmtKind.StBreak || s.kind == StmtKind.StContinue {
    if loop_depth == 0 {
      err_at("", 0, 0, "break/continue outside of a loop");
    }
    return;
  }
  if s.kind == StmtKind.StDefer {
    let saved: bool = in_defer;
    in_defer = true;
    scope_push();
    let mut i: usize = 0;
    while i < s.stmts.n {
      check_stmt(s.stmts.items[i]);
      i += 1;
    }
    scope_pop();
    in_defer = saved;
    return;
  }
  if s.kind == StmtKind.StWhile {
    let saved_depth: i32 = loop_depth;
    loop_depth += 1;
    let cond: *Type = check_expr(s.cond, null);
    if cond.kind != TypeKind.TyBool {
      err_at("", 0, 0, "while condition must be bool");
    }
    scope_push();
    let mut i: usize = 0;
    while i < s.body.n {
      check_stmt(s.body.items[i]);
      i += 1;
    }
    scope_pop();
    loop_depth = saved_depth;
    return;
  }
  if s.kind == StmtKind.StLoop {
    let saved_depth: i32 = loop_depth;
    loop_depth += 1;
    scope_push();
    let mut i: usize = 0;
    while i < s.body.n {
      check_stmt(s.body.items[i]);
      i += 1;
    }
    scope_pop();
    loop_depth = saved_depth;
    return;
  }
  if s.kind == StmtKind.StBlock {
    scope_push();
    let mut i: usize = 0;
    while i < s.stmts.n {
      check_stmt(s.stmts.items[i]);
      i += 1;
    }
    scope_pop();
    return;
  }
}

fn check_fn_body(d: *Decl, sym: *Sym, m: *Module) {
  if d.tparams.n > 0 {
    // generic template: check once under TY_PARAM placeholders
    g_tenv = template_env_of(d);
  } else if len(d.recv) > 0 {
    let mut struct_sym: *Sym = sm_get(m.syms, d.recv);
    if struct_sym == null && prelude_module != null && prelude_module != m {
      struct_sym = sm_get(prelude_module.syms, d.recv);
    }
    if struct_sym != null && struct_sym.decl.tparams.n > 0 {
      let tmpl: *RecType = ensure_template(struct_sym.decl, m);
      g_tenv = tmpl.env_tenv;
    }
  }
  cur_ret = sym.type.ret;
  scope_push();
  let mut i: usize = 0;
  while i < d.params.n {
    let p: *Param = d.params.items[i];
    // use the symbol's resolved signature: instantiation clones carry
    // concrete param types the AST re-resolution would clobber
    let pt: *Type = if i < len(sym.type.params) {
      sym.type.params[i]
    } else {
      resolve_type_in_module(cur_module, p.ty)
    };
    let ps: *Sym = new Sym {
      kind: SymKind.SyParam, name: p.name, type: pt, decl: null,
      mutable: false, variant_index: 0, local_id: next_local_id, symbol: "",
    owner: cur_module,
    };
    next_local_id += 1;
    scope_decl(p.name, ps);
    i += 1;
  }
  let mut k: usize = 0;
  while k < d.body.n {
    check_stmt(d.body.items[k]);
    k += 1;
  }
  scope_pop();
  g_tenv = null;
}


// ============== check driver (check.c port L6f) ===========================

// attach a method to its receiver struct's RecType and build the fn type
fn wire_method(m: *Module, d: *Decl) -> *Type {
  let mut struct_sym: *Sym = sm_get(m.syms, d.recv);
  if struct_sym == null && prelude_module != null && prelude_module != m {
    struct_sym = sm_get(prelude_module.syms, d.recv);
  }
  if struct_sym == null || (struct_sym.kind != SymKind.SyStruct && struct_sym.kind != SymKind.SyEnum) {
    err_at("", 0, 0, "method receiver type not found");
    return ty_err();
  }
  // resolve the signature under the RECEIVER type's template env, so bare
  // generic references (`self: Option`) name the template
  let saved_env: *TypeMap = g_tenv;
  if struct_sym.decl.tparams.n > 0 {
    let tmpl: *RecType = ensure_template(struct_sym.decl, m);
    g_tenv = tmpl.env_tenv;
  }
  let nparams: usize = d.params.n;
  let mut ps: []*Type = fresh_type_vec2();
  let mut i: usize = 0;
  while i < nparams {
    ps = push_type(ps, resolve_type_in_module(m, d.params.items[i].ty));
    i += 1;
  }
  let ret: *Type = resolve_type_in_module(m, d.ret);
  let ft: *Type = ty_fn(ps, ret);
  let msym: *Sym = new Sym {
    kind: SymKind.SyFn, name: d.name, type: ft, decl: d,
    mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: cur_module,
  };
  // attach the method to the receiver's own rec (deref through *self)
  if len(ps) > 0 {
    let mut rec_t: *Type = ps[0];
    if rec_t.kind == TypeKind.TyPtr {
      rec_t = rec_t.elem;
    }
    if rec_t.rec != null {
      rec_t.rec.methods = push_sym(rec_t.rec.methods, msym);
    }
  }
  g_tenv = saved_env;
  return ft;
}

// full semantic check of a parsed module; returns the diag count
fn scope_decl_module(m: *Module) {
  let d: *Decl = m.root;
  let mut i: usize = 0;
  while i < d.decls.n {
    let decl: *Decl = d.decls.items[i];
    let sym: *Sym = sm_get(m.syms, decl.name);
    if sym != null {
      scope_decl(decl.name, sym);
    }
    i += 1;
  }
}

fn check_all(m: *Module) -> i32 {
  cur_module = m;
  check_module(m);
  scope_push();
  scope_decl_module(m);
  if prelude_module != null && prelude_module != m {
    let pd: *Decl = prelude_module.root;
    let mut pi: usize = 0;
    while pi < pd.decls.n {
      let pdecl: *Decl = pd.decls.items[pi];
      let psym: *Sym = sm_get(prelude_module.syms, pdecl.name);
      if psym != null {
        scope_decl(pdecl.name, psym);
      }
      pi += 1;
    }
  }
  let d: *Decl = m.root;
  // pass 1: resolve struct/enum types, wire methods
  let mut i: usize = 0;
  while i < d.decls.n {
    let decl: *Decl = d.decls.items[i];
    if decl.kind == DeclKind.DkStruct || decl.kind == DeclKind.DkEnum {
      let ssym: *Sym = sm_get(m.syms, decl.name);
      if ssym != null && ssym.type == null {
        if decl.tparams.n > 0 {
          let tmpl: *RecType = ensure_template(decl, m);
          let t: *Type = new Type {
            kind: TypeKind.TyStruct, elem: null, len: 0, rec: tmpl,
            params: fresh_type_vec2(), ret: null, mangled: tmpl.mangled,
          };
          if decl.kind == DeclKind.DkEnum {
            t.kind = TypeKind.TyEnum;
          }
          ssym.type = t;
        } else {
          ssym.type = named_type_simple(ssym, m);
        }
      }
    }
    if decl.kind == DeclKind.DkFn {
      eprint("[p1 ");
      eprint(decl.name);
      eprint(" recv=");
      eprint(decl.recv);
      eprint("]\n");
      if len(decl.recv) > 0 {
        wire_method(m, decl);
      }
    }
    i += 1;
  }
  // pass 2a: resolve fn signatures (and templated flags) for every decl —
  // before any body checks, so calls see concrete templates
  i = 0;
  while i < d.decls.n {
    let decl: *Decl = d.decls.items[i];
    if decl.kind == DeclKind.DkFn {
      if len(decl.recv) > 0 {
        let mut rsym: *Sym = sm_get(m.syms, decl.recv);
        if rsym == null && prelude_module != null && prelude_module != m {
          rsym = sm_get(prelude_module.syms, decl.recv);
        }
        if rsym != null && rsym.decl.tparams.n > 0 {
          decl.templated = true;
        }
      }
      if decl.tparams.n > 0 {
        decl.templated = true;
      }
      let nparams0: usize = decl.params.n;
      let mut ps0: []*Type = fresh_type_vec2();
      let mut j0: usize = 0;
      while j0 < nparams0 {
        if len(decl.recv) > 0 {
          let rsym2: *Sym = sm_get(m.syms, decl.recv);
          if rsym2 != null && rsym2.decl.tparams.n > 0 {
            let tmpl0: *RecType = ensure_template(rsym2.decl, m);
            g_tenv = tmpl0.env_tenv;
            ps0 = push_type(ps0, resolve_type_in_module(m, decl.params.items[j0].ty));
            g_tenv = null;
            j0 += 1;
            continue;
          }
        }
        if decl.tparams.n > 0 {
          let saved_env0: *TypeMap = g_tenv;
          g_tenv = template_env_of(decl);
          ps0 = push_type(ps0, resolve_type_in_module(m, decl.params.items[j0].ty));
          g_tenv = saved_env0;
          j0 += 1;
          continue;
        }
        ps0 = push_type(ps0, resolve_type_in_module(m, decl.params.items[j0].ty));
        j0 += 1;
      }
      let mut ret0: *Type = null;
      if decl.tparams.n > 0 {
        let saved_env1: *TypeMap = g_tenv;
        g_tenv = template_env_of(decl);
        ret0 = resolve_type_in_module(m, decl.ret);
        g_tenv = saved_env1;
      } else if len(decl.recv) > 0 {
        let rsym3: *Sym = sm_get(m.syms, decl.recv);
        if rsym3 != null && rsym3.decl.tparams.n > 0 {
          let tmpl1: *RecType = ensure_template(rsym3.decl, m);
          g_tenv = tmpl1.env_tenv;
          ret0 = resolve_type_in_module(m, decl.ret);
          g_tenv = null;
        } else {
          ret0 = resolve_type_in_module(m, decl.ret);
        }
      } else {
        ret0 = resolve_type_in_module(m, decl.ret);
      }
      let ft0: *Type = ty_fn(ps0, ret0);
      let mut tsym0: *Sym = sm_get(m.syms, decl.name);
      if decl.is_method {
        tsym0 = sm_get(m.syms, cat3(decl.recv, ".", decl.name));
      }
      if tsym0 != null {
        tsym0.type = ft0;
      }
    }
    if decl.kind == DeclKind.DkExtern {
      let esym: *Sym = sm_get(m.syms, decl.name);
      if esym != null && esym.type == null {
        let mut ps1: []*Type = fresh_type_vec2();
        let mut j1: usize = 0;
        while j1 < decl.params.n {
          ps1 = push_type(ps1, resolve_type_in_module(m, decl.params.items[j1].ty));
          j1 += 1;
        }
        esym.type = ty_fn(ps1, resolve_type_in_module(m, decl.ret));
      }
    }
    if decl.kind == DeclKind.DkStatic || decl.kind == DeclKind.DkConst {
      let ann: *Type = resolve_type_in_module(m, decl.ret);
      let ssym: *Sym = sm_get(m.syms, decl.name);
      if ssym != null {
        ssym.type = ann;
      }
      if decl.init != null {
        check_expr(decl.init, ann);
        let v: *CV = const_eval(decl.init, m);
        if !v.ok {
          err_at(decl.file, decl.line, decl.col, cat3(decl.name, ": initializer must be a compile-time constant", ""));
        } else {
          decl.ceval_ok = true;
          decl.ceval_is_int = v.is_int;
          decl.ceval_i = v.i;
          decl.ceval_f = v.f;
        }
        decl.init.typed = ann;
      }
    }
    i += 1;
  }
  // pass 2b: check fn bodies (plain fns and methods alike; generics once)
  i = 0;
  while i < d.decls.n {
    let decl: *Decl = d.decls.items[i];
    if decl.kind == DeclKind.DkFn {
      eprint("[sig ");
      eprint(decl.name);
      eprint("]\n");
      // build the fn symbol's signature type on the fly (methods resolve
      // under the receiver type's template env)
      if len(decl.recv) > 0 {
        let mut rsym: *Sym = sm_get(m.syms, decl.recv);
        if rsym == null && prelude_module != null && prelude_module != m {
          rsym = sm_get(prelude_module.syms, decl.recv);
        }
        if rsym != null && rsym.decl.tparams.n > 0 {
          let tmpl: *RecType = ensure_template(rsym.decl, m);
          g_tenv = tmpl.env_tenv;
          decl.templated = true;
        }
      }
      if decl.tparams.n > 0 {
        g_tenv = template_env_of(decl);
        decl.templated = true;
      }
      let nparams: usize = decl.params.n;
      let mut ps: []*Type = fresh_type_vec2();
      let mut j: usize = 0;
      while j < nparams {
        ps = push_type(ps, resolve_type_in_module(m, decl.params.items[j].ty));
        j += 1;
      }
      let ret: *Type = resolve_type_in_module(m, decl.ret);
      let ft: *Type = ty_fn(ps, ret);
      g_tenv = null;
      let mut tsym: *Sym = sm_get(m.syms, decl.name);
      if decl.is_method {
        tsym = sm_get(m.syms, cat3(decl.recv, ".", decl.name));
      }
      if tsym != null {
        tsym.type = ft;
      }
      let fsym: *Sym = new Sym {
        kind: SymKind.SyFn, name: decl.name, type: ft, decl: decl,
        mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: cur_module,
      };
      cur_fn_sym = fsym;
      check_fn_body(decl, fsym, m);
    }
    if decl.kind == DeclKind.DkExtern {
      // resolve the extern signature into its symbol
      let esym: *Sym = sm_get(m.syms, decl.name);
      if esym != null && esym.type == null {
        let mut ps: []*Type = fresh_type_vec2();
        let mut j: usize = 0;
        while j < decl.params.n {
          ps = push_type(ps, resolve_type_in_module(m, decl.params.items[j].ty));
          j += 1;
        }
        esym.type = ty_fn(ps, resolve_type_in_module(m, decl.ret));
      }
    }
    if decl.kind == DeclKind.DkStatic || decl.kind == DeclKind.DkConst {
      let ann: *Type = resolve_type_in_module(m, decl.ret);
      let ssym: *Sym = sm_get(m.syms, decl.name);
      if ssym != null {
        ssym.type = ann;
      }
      if decl.init != null {
        check_expr(decl.init, ann);
        let v: *CV = const_eval(decl.init, m);
        if !v.ok {
          err_at(decl.file, decl.line, decl.col, cat3(decl.name, ": initializer must be a compile-time constant", ""));
        } else {
          decl.ceval_ok = true;
          decl.ceval_is_int = v.is_int;
          decl.ceval_i = v.i;
          decl.ceval_f = v.f;
        }
        decl.init.typed = ann;
      }
    }
    i += 1;
  }
  // instantiation worklist: each clone's body re-checked under its concrete
  // environment; checking may discover further instantiations, so the loop
  // runs until the queue settles
  if g_instantiations != null {
    let mut wl: usize = 0;
    while wl < g_instantiations.n {
      let isym: *Sym = g_instantiations.items[wl];
      wl += 1;
      let saved_env: *TypeMap = g_tenv;
      g_tenv = isym.decl.tenv;
      cur_fn_sym = isym;
      check_fn_body(isym.decl, isym, m);
      g_tenv = saved_env;
    }
  }
  scope_pop();
  return diag_count();
}


// ============== if-expressions (check.c port L6f-b) =======================

fn check_block_value2(stmts: *Vec[*Stmt]) -> *Type {
  scope_push();
  let mut result: *Type = ty_prim(14);
  let mut i: usize = 0;
  while i < stmts.n {
    let s: *Stmt = stmts.items[i];
    if i + 1 == stmts.n && s.kind == StmtKind.StExpr && s.tail {
      result = check_expr(s.a, null);
    } else {
      check_stmt(s);
    }
    i += 1;
  }
  scope_pop();
  return result;
}

fn unify2(a: *Type, b: *Type) -> *Type {
  if a == b {
    return a;
  }
  if a != null && a.kind == TypeKind.TyParam {
    return b;
  }
  if b != null && b.kind == TypeKind.TyParam {
    return a;
  }
  if a.kind == TypeKind.TyErr {
    return b;
  }
  if b.kind == TypeKind.TyErr {
    return a;
  }
  if a.kind == TypeKind.TyIntLit && ty_is_int(b) {
    return b;
  }
  if b.kind == TypeKind.TyIntLit && ty_is_int(a) {
    return a;
  }
  if a.kind == TypeKind.TyFloatLit && ty_is_flt(b) {
    return b;
  }
  if b.kind == TypeKind.TyFloatLit && ty_is_flt(a) {
    return a;
  }
  err_at("", 0, 0, "if arms have different types");
  return ty_err();
}

fn check_if_expr(e: *Expr, expected: *Type) -> *Type {
  let cond: *Type = check_expr(e.a, null);
  if cond.kind != TypeKind.TyBool {
    err_at("", 0, 0, "if condition must be bool");
  }
  let then_blk: *Stmt = (e.items.items[0] as usize) as *Stmt;
  let t: *Type = check_block_value2(then_blk.stmts);
  let mut result: *Type = ty_prim(14);
  if e.else_if != null {
    let et: *Type = check_expr(e.else_if, expected);
    result = unify2(t, et);
  } else if e.items.n > 1 {
    let else_blk: *Stmt = e.items.items[1];
    let et: *Type = check_block_value2(else_blk.stmts);
    result = unify2(t, et);
  } else {
    result = ty_prim(14);
  }
  e.typed = result;
  return result;
}


// ================= IR structures (lower.c port LOW-1) ======================

enum IRType {
  ItI8, ItI16, ItI32, ItI64,
  ItU8, ItU16, ItU32, ItU64, ItUsize,
  ItF32, ItF64,
  ItPtr,
}

struct IRSlot {
  id: i32,
  size: i64,
  align: i64,
  name: string,
}

struct IRVreg {
  id: i32,
  ty: IRType,
}

enum IROp {
  IrConst, IrFconst,
  IrAdd, IrSub, IrMul, IrDiv, IrMod, IrAnd, IrOr, IrXor, IrShl, IrShr,
  IrCmp,
  IrLoad,
  IrStore,
  IrAddrc,
  IrAddi,
  IrCall,
  IrCast,
  IrCopymem,
  IrZero,
  IrLitaddr,
}

enum IRCC { CcEq, CcNe, CcLt, CcLe, CcGt, CcGe }

enum IRCastKind {
  CastTrunc, CastSext, CastZext, CastI2f, CastF2i, CastF32F64,
  CastF64F32, CastBitcopy, CastReinterp,
}

struct IRArg {
  vreg: *IRVreg,
}

struct IRPhi {
  dst: *IRVreg,
  args: []*IRVreg,
  preds: []*IRBlock,
}

struct IRIns {
  op: IROp,
  dst: *IRVreg,
  a: *IRVreg,
  b: *IRVreg,
  slot: *IRSlot,
  imm: i64,
  fimm: f64,
  size: i64,
  is_float: bool,
  signed_ops: bool,
  cc: IRCC,
  cast: IRCastKind,
  cast_from: IRType,
  cast_to: IRType,
  callee: string,
  callee_vreg: *IRVreg,
  args: []*IRVreg,
  addr: *IRVreg,
  lit: i32,
  join_hint: *IRBlock,
}

struct IRBlock {
  id: i32,
  phis: []*IRPhi,
  ins: []*IRIns,
  term_op: i32,      // 0 = none, 100 = br, 101 = cbr, 102 = ret
  br_true: *IRBlock,
  br_false: *IRBlock,
  ret_val: *IRVreg,
  cbr_cond: *IRVreg,
  join_hint: *IRBlock,
  loop_header: bool,
  loop_exit: *IRBlock,
  emitted: bool,     // wasm: control-flow re-nesting marks blocks as it goes
}

struct IRLit {
  label: string,
  bytes: []u8,
}

struct IRFn {
  uid: i32,
  symbol: string,
  ret_is_void: bool,
  ret: *Type,            // null for synthesized (rc) helpers
  returns_aggregate: bool,
  params: []*IRSlot,
  param_types: []*Type,  // parallel to params (null = opaque machine word)
  out_slot: *IRSlot,
  slots: []*IRSlot,
  blocks: []*IRBlock,
  entry: *IRBlock,
  cur: *IRBlock,
  literals: []*IRLit,
  next_vreg: i32,
  next_block: i32,
  next_slot: i32,
  vreg_base: i32, // vreg slot offset base = named slot count at layout
}

static mut g_ir_fns: *Vec[*IRFn] = 0 as *Vec[*IRFn];
static mut g_ir_uid: i32 = 0;

struct IRGlobal {
  symbol: string,
  size: i64,
  align: i64,
  init: []u8,        // empty => zero-initialized
  relocs: []string,  // per-8-byte-word relocation labels ("" = none)
  static_lit: *IRLit, // static string literal block (null = none)
  is_extern: bool,
}

static mut g_ir_globals: *Vec[*IRGlobal] = 0 as *Vec[*IRGlobal];
static mut g_main_cell: *Vec[string] = 0 as *Vec[string]; // [main symbol]
static mut g_root_module: *Module = 0 as *Module;
static mut g_panic_site: i32 = 0;
static mut g_lit_counter: i32 = 0;
static mut g_closure_counter: i32 = 0;
static mut g_eq_fns: *TypeMap2 = 0 as *TypeMap2;

fn ir_size_of(t: IRType) -> i64 {
  if t == IRType.ItI8 || t == IRType.ItU8 { return 1; }
  if t == IRType.ItI16 || t == IRType.ItU16 { return 2; }
  if t == IRType.ItI32 || t == IRType.ItU32 || t == IRType.ItF32 { return 4; }
  return 8;
}

fn ir_is_float_t(t: IRType) -> bool {
  return t == IRType.ItF32 || t == IRType.ItF64;
}


// ================= lowering context & builders (LOW-2) =====================

struct OwnedBind { slot: *IRSlot, ty: *Type }
struct BindEnt { name: string, slot: *IRSlot, next: *BindEnt }
struct LScope {
  bindings: *BindEnt,
  owned: []*OwnedBind,
  defers: []*Stmt,
  parent: *LScope,
  break_to: *IRBlock,
  continue_to: *IRBlock,
  is_loop: bool,
}
struct LCtx {
  f: *IRFn,
  scope: *LScope,
}

fn rc_new_fn(symbol: string) -> *IRFn {
  let f: *IRFn = new IRFn {
    uid: 0, symbol: symbol, ret_is_void: true, ret: null,
    returns_aggregate: false, params: make([]*IRSlot, 0),
    param_types: fresh_type_vec2(),
    out_slot: null, slots: make([]*IRSlot, 0), blocks: make([]*IRBlock, 0),
    entry: null, cur: null, literals: make([]*IRLit, 0),
    next_vreg: 0, next_block: 0, next_slot: 0, vreg_base: 0,
  };
  let cc: *LCtx = rc_ctx(f);
  f.entry = new_block(cc);
  use_block(cc, f.entry);
  return f;
}

fn push_islot(items: []*IRSlot, s: *IRSlot) -> []*IRSlot {
  let out: []*IRSlot = make([]*IRSlot, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = s;
  return out;
}

fn rc_ctx(f: *IRFn) -> *LCtx {
  let c: *LCtx = new LCtx { f: f, scope: null };
  return c;
}

fn new_block(c: *LCtx) -> *IRBlock {
  let b: *IRBlock = new IRBlock {
    id: c.f.next_block, phis: make([]*IRPhi, 0), ins: make([]*IRIns, 0),
    term_op: 0, br_true: null, br_false: null, ret_val: null,
    cbr_cond: null, join_hint: null, loop_header: false, loop_exit: null,
    emitted: false,
  };
  c.f.next_block += 1;
  c.f.blocks = push_ptr(c.f.blocks, b);
  return b;
}

fn push_ptr(items: []*IRBlock, b: *IRBlock) -> []*IRBlock {
  let out: []*IRBlock = make([]*IRBlock, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = b;
  return out;
}

fn use_block(c: *LCtx, b: *IRBlock) {
  c.f.cur = b;
}

fn emit(c: *LCtx, op: IROp) -> *IRIns {
  let i: *IRIns = new IRIns {
    op: op, dst: null, a: null, b: null, slot: null, imm: 0, fimm: 0.0,
    size: 0, is_float: false, signed_ops: true, cc: IRCC.CcEq,
    cast: IRCastKind.CastBitcopy, cast_from: IRType.ItPtr,
    cast_to: IRType.ItPtr, callee: "", callee_vreg: null,
    args: make([]*IRVreg, 0), addr: null, lit: 0, join_hint: null,
  };
  c.f.cur.ins = push_ins(c.f.cur.ins, i);
  return i;
}

fn push_ins(items: []*IRIns, i: *IRIns) -> []*IRIns {
  let out: []*IRIns = make([]*IRIns, len(items) + 1);
  let mut k: usize = 0;
  while k < len(items) {
    out[k] = items[k];
    k += 1;
  }
  out[len(items)] = i;
  return out;
}

fn new_vreg(c: *LCtx, ty: IRType) -> *IRVreg {
  let v: *IRVreg = new IRVreg { id: c.f.next_vreg, ty: ty };
  c.f.next_vreg += 1;
  return v;
}

fn new_slot(c: *LCtx, size: i64, align: i64, name: string) -> *IRSlot {
  // scalars get 8-byte slots: the register spill stores full 64-bit slots
  // and narrower accesses simply use the low bytes
  let mut sz: i64 = size;
  if sz == 0 {
    sz = 8;
  }
  if sz < 8 {
    sz = 8;
  }
  let mut al: i64 = align;
  if al == 0 {
    al = 8;
  }
  let s: *IRSlot = new IRSlot { id: c.f.next_slot, size: sz, align: al, name: name };
  c.f.next_slot += 1;
  c.f.slots = push_slot(c.f.slots, s);
  return s;
}

fn push_slot(items: []*IRSlot, s: *IRSlot) -> []*IRSlot {
  let out: []*IRSlot = make([]*IRSlot, len(items) + 1);
  let mut k: usize = 0;
  while k < len(items) {
    out[k] = items[k];
    k += 1;
  }
  out[len(items)] = s;
  return out;
}

fn v_slotaddr(c: *LCtx, s: *IRSlot) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, IRType.ItPtr);
  let i: *IRIns = emit(c, IROp.IrAddrc);
  i.dst = v;
  i.slot = s;
  return v;
}

fn v_const(c: *LCtx, val: i64, ty: IRType) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, ty);
  let i: *IRIns = emit(c, IROp.IrConst);
  i.dst = v;
  i.imm = val;
  return v;
}

fn v_load(c: *LCtx, addr: *IRVreg, ty: IRType) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, ty);
  let i: *IRIns = emit(c, IROp.IrLoad);
  i.dst = v;
  i.addr = addr;
  i.size = ir_size_of(ty);
  i.is_float = ir_is_float_t(ty);
  return v;
}

fn v_store(c: *LCtx, addr: *IRVreg, val: *IRVreg) {
  let i: *IRIns = emit(c, IROp.IrStore);
  i.addr = addr;
  i.a = val;
  i.size = ir_size_of(val.ty);
  i.is_float = ir_is_float_t(val.ty);
}

fn v_addi(c: *LCtx, a: *IRVreg, imm: i64) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, IRType.ItPtr);
  let i: *IRIns = emit(c, IROp.IrAddi);
  i.dst = v;
  i.a = a;
  i.imm = imm;
  return v;
}

fn v_binop(c: *LCtx, op: IROp, a: *IRVreg, b: *IRVreg, ty: IRType, signed_ops: bool) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, ty);
  let i: *IRIns = emit(c, op);
  i.dst = v;
  i.a = a;
  i.b = b;
  i.is_float = ir_is_float_t(ty);
  i.signed_ops = signed_ops;
  return v;
}

fn v_cmp(c: *LCtx, cc: IRCC, a: *IRVreg, b: *IRVreg, is_float: bool) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, IRType.ItU8);
  let i: *IRIns = emit(c, IROp.IrCmp);
  i.dst = v;
  i.a = a;
  i.b = b;
  i.cc = cc;
  i.is_float = is_float;
  i.signed_ops = true;
  return v;
}

// unsigned >= : rc plausibility guards compare counts, not signs
fn v_cmp_uge(c: *LCtx, a: *IRVreg, b: *IRVreg) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, IRType.ItU8);
  let i: *IRIns = emit(c, IROp.IrCmp);
  i.dst = v;
  i.a = a;
  i.b = b;
  i.cc = IRCC.CcGe;
  i.is_float = false;
  i.signed_ops = false;
  return v;
}

fn emit_br(c: *LCtx, to: *IRBlock) {
  let b: *IRBlock = c.f.cur;
  b.term_op = 100;
  b.br_true = to;
}

fn emit_cbr(c: *LCtx, cond: *IRVreg, tt: *IRBlock, ff: *IRBlock, join: *IRBlock) {
  let b: *IRBlock = c.f.cur;
  b.term_op = 101;
  b.cbr_cond = cond;
  b.br_true = tt;
  b.br_false = ff;
  b.join_hint = join;
}

fn emit_ret(c: *LCtx, v: *IRVreg) {
  let b: *IRBlock = c.f.cur;
  b.term_op = 102;
  b.ret_val = v;
}


// ================= expression lowering (LOW-3) =============================

fn fconst(c: *LCtx, v: f64, ty: IRType) -> *IRVreg {
  let d: *IRVreg = new_vreg(c, ty);
  let i: *IRIns = emit(c, IROp.IrFconst);
  i.dst = d;
  i.fimm = v;
  return d;
}

fn rc_call1(c: *LCtx, helper: string, arg: *IRVreg) {
  let i: *IRIns = emit(c, IROp.IrCall);
  i.callee = helper;
  let a: *IRVreg = arg;
  i.args = push_vreg(i.args, a);
}

fn push_vreg(items: []*IRVreg, v: *IRVreg) -> []*IRVreg {
  let out: []*IRVreg = make([]*IRVreg, len(items) + 1);
  let mut k: usize = 0;
  while k < len(items) {
    out[k] = items[k];
    k += 1;
  }
  out[len(items)] = v;
  return out;
}

fn rc_inc_v(c: *LCtx, p: *IRVreg) { rc_call1(c, "rho__rc_inc", p); }
fn rc_dec_v(c: *LCtx, p: *IRVreg) { rc_call1(c, "rho__rc_dec", p); }

// bind a name to a slot in the current scope
fn lbind(c: *LCtx, name: string, slot: *IRSlot) {
  let b: *BindEnt = new BindEnt { name: name, slot: slot, next: c.scope.bindings };
  c.scope.bindings = b;
}

fn lookup_slot(c: *LCtx, name: string) -> *IRSlot {
  let mut s: *LScope = c.scope;
  while s != null {
    let mut b: *BindEnt = s.bindings;
    while b != null {
      if streq(b.name, name) {
        return b.slot;
      }
      b = b.next;
    }
    s = s.parent;
  }
  return null;
}

// address of a name binding (slot address)
fn addr_of_name(c: *LCtx, name: string) -> *IRVreg {
  let slot: *IRSlot = lookup_slot(c, name);
  if slot == null {
    return null;
  }
  return v_slotaddr(c, slot);
}


// ================= scope/ownership (LOW-4) =================================

fn own_slot(c: *LCtx, slot: *IRSlot, t: *Type) {
  let ob: *OwnedBind = new OwnedBind { slot: slot, ty: t };
  c.scope.owned = push_owned(c.scope.owned, ob);
}

fn push_owned(items: []*OwnedBind, ob: *OwnedBind) -> []*OwnedBind {
  let out: []*OwnedBind = make([]*OwnedBind, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = ob;
  return out;
}

fn release_addr(c: *LCtx, t: *Type, addr: *IRVreg) {
  let fnn: string = value_fn_for(t, false);
  if fnn != "" {
    rc_call1(c, fnn, addr);
  }
}

fn retain_addr(c: *LCtx, t: *Type, addr: *IRVreg) {
  let fnn: string = value_fn_for(t, true);
  if fnn != "" {
    rc_call1(c, fnn, addr);
  }
}

fn release_scope_only(c: *LCtx) {
  let owned: []*OwnedBind = c.scope.owned;
  let mut k: usize = len(owned);
  while k > 0 {
    let ob: *OwnedBind = owned[k - 1];
    release_addr(c, ob.ty, v_slotaddr(c, ob.slot));
    k -= 1;
  }
}

fn scope_pop_release(c: *LCtx) {
  release_scope_only(c);
  c.scope = c.scope.parent;
}

fn owned_empty() -> []*OwnedBind {
  return make([]*OwnedBind, 0);
}

fn scope_push_l(c: *LCtx) {
  let s: *LScope = new LScope {
    bindings: null, owned: owned_empty(), defers: make([]*Stmt, 0),
    parent: c.scope,
    break_to: null, continue_to: null, is_loop: false,
  };
  c.scope = s;
}


// ================= glue synthesis (LOW-5) ==================================

struct TypeEnt2 { key: string, val: string }
struct TypeMap2 { items: []*TypeEnt2, n: usize }

fn tm2_new() -> *TypeMap2 {
  return new TypeMap2 { items: make([]*TypeEnt2, 4096), n: 0 };
}

static mut g_rel_fns: *TypeMap2 = 0 as *TypeMap2;
static mut g_ret_fns: *TypeMap2 = 0 as *TypeMap2;

fn ty_is_managed(t: *Type) -> bool {
  if t == null {
    return false;
  }
  // raw byte pointers carry no rc header; a pointer is reference-counted
  // exactly when it points at a `new` object
  if t.kind == TypeKind.TyPtr {
    return t.elem != null &&
           (t.elem.kind == TypeKind.TyStruct || t.elem.kind == TypeKind.TyEnum);
  }
  if t.kind == TypeKind.TyWeak || t.kind == TypeKind.TySlice ||
     t.kind == TypeKind.TyStringK || t.kind == TypeKind.TyFn {
    return true;
  }
  if t.kind == TypeKind.TyArray {
    return ty_is_managed(t.elem);
  }
  if t.kind == TypeKind.TyStruct {
    struct_field_type(t.rec, 0);
    let mut i: usize = 0;
    while i < len(t.rec.field_types) {
      if ty_is_managed(t.rec.field_types[i]) {
        return true;
      }
      i += 1;
    }
    return false;
  }
  if t.kind == TypeKind.TyEnum {
    let d: *Decl = t.rec.decl;
    let mut i: usize = 0;
    while i < d.variants.n {
      let v: *VariantAst = d.variants.items[i];
      if v.vkind != VarKind.VarUnit {
        return true;
      }
      i += 1;
    }
    return false;
  }
  return false;
}

fn rho_sanitize(s: string) -> string {
  let out: []u8 = make([]u8, len(s));
  let mut i: usize = 0;
  while i < len(s) {
    let ch: u8 = s[i];
    let ok: bool = (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) ||
                   (ch >= 48 && ch <= 57) || ch == 95;
    if ok {
      out[i] = ch;
    } else {
      out[i] = 95;
    }
    i += 1;
  }
  return intrinsics.slice_string(out);
}

fn tm2_get(m: *TypeMap2, key: string) -> string {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return "";
}

fn tm2_put(m: *TypeMap2, key: string, val: string) {
  let e: *TypeEnt2 = new TypeEnt2 { key: key, val: val };
  m.items[m.n] = e;
  m.n += 1;
}

// lazily synthesize rho__rel$<t> / rho__ret$<t>: walk the value of type t at
// the sole pointer parameter. Returns "" for unmanaged types.
fn value_fn_for(t: *Type, retain: bool) -> string {
  if t == null || !ty_is_managed(t) {
    return "";
  }
  let mut cache: *TypeMap2 = rel_cache();
  if retain {
    cache = ret_cache();
  }
  let found: string = tm2_get(cache, t.mangled);
  if found != "" {
    return found;
  }
  // kind prefix keeps the symbol unique: `[]*T` and `*[]T` would sanitize
  // to the same name
  let mut kindp: string = "x_";
  if t.kind == TypeKind.TyPtr { kindp = "p_"; }
  if t.kind == TypeKind.TySlice { kindp = "s_"; }
  if t.kind == TypeKind.TyStringK { kindp = "g_"; }
  if t.kind == TypeKind.TyArray { kindp = "a_"; }
  if t.kind == TypeKind.TyEnum { kindp = "e_"; }
  if t.kind == TypeKind.TyStruct { kindp = "r_"; }
  if t.kind == TypeKind.TyFn { kindp = "f_"; }
  if t.kind == TypeKind.TyWeak { kindp = "w_"; }
  let sym: string = cat3("rho__", cat3(retain_which(retain), cat3("$", kindp, ""), ""),
                         rho_sanitize(t.mangled));
  tm2_put(cache, t.mangled, sym);
  // synthesize the walker body
  let lf: *IRFn = rc_new_fn(sym);
  let c: *LCtx = rc_ctx(lf);
  let as_: *IRSlot = new_slot(c, 8, 8, "addr");
  lf.params = push_islot(lf.params, as_);
  let addr: *IRVreg = v_load(c, v_slotaddr(c, as_), IRType.ItPtr);
  value_walk(c, t, addr, retain);
  finish_fn_c(c);
  return sym;
}

// close a synthesized fn: seal with a void return when still open, register
// it in the program's fn list
fn finish_fn_c(c: *LCtx) {
  let b: *IRBlock = c.f.cur;
  if b.term_op == 0 {
    emit_ret(c, null);
  }
  if g_ir_fns == null {
    g_ir_fns = new Vec[*IRFn] { items: make([]*IRFn, 256), n: 0 };
  }
  g_ir_fns.push(c.f);
}

fn value_walk(c: *LCtx, t: *Type, addr: *IRVreg, retain: bool) {
  if t == null {
    return;
  }
  if t.kind == TypeKind.TyPtr {
    let p: *IRVreg = v_load(c, addr, IRType.ItPtr);
    if retain {
      rc_inc_v(c, p);
    } else {
      rc_dec_v(c, p);
    }
    return;
  }
  if t.kind == TypeKind.TyWeak {
    let h: *IRVreg = v_load(c, addr, IRType.ItPtr);
    if retain {
      rc_call1(c, "rho__rc_winc", h);
    } else {
      rc_call1(c, "rho__rc_wdec", h);
    }
    return;
  }
  if t.kind == TypeKind.TyFn {
    let e2: *IRVreg = v_load(c, v_addi(c, addr, 8), IRType.ItPtr);
    if retain {
      rc_inc_v(c, e2);
    } else {
      rc_dec_v(c, e2);
    }
    return;
  }
  if t.kind == TypeKind.TySlice || t.kind == TypeKind.TyStringK {
    if t.kind == TypeKind.TySlice && ty_is_managed(t.elem) {
      // walk elements: buf at +8, elem stride at +8, count at +16
      let ptr: *IRVreg = v_load(c, v_addi(c, addr, 8), IRType.ItPtr);
      let n: *IRVreg = v_load(c, v_addi(c, addr, 16), IRType.ItUsize);
      let esz: i64 = type_size(t.elem);
      let islot: *IRSlot = new_slot(c, 8, 8, "i");
      v_store(c, v_slotaddr(c, islot), v_const(c, 0, IRType.ItUsize));
      let hdr: *IRBlock = new_block(c);
      let bodyb: *IRBlock = new_block(c);
      let done: *IRBlock = new_block(c);
      emit_br(c, hdr);
      use_block(c, hdr);
      let i: *IRVreg = v_load(c, v_slotaddr(c, islot), IRType.ItUsize);
      let more: *IRVreg = v_cmp(c, IRCC.CcLt, i, n, false);
      emit_cbr(c, more, bodyb, done, done);
      use_block(c, bodyb);
      let scaled: *IRVreg = v_binop(c, IROp.IrMul, i, v_const(c, esz, IRType.ItUsize), IRType.ItUsize, false);
      let ep: *IRVreg = v_binop(c, IROp.IrAdd, ptr, scaled, IRType.ItPtr, false);
      let efnn: string = value_fn_for(t.elem, retain);
      if efnn != "" {
        rc_call1(c, efnn, ep);
      }
      let i2: *IRVreg = v_binop(c, IROp.IrAdd, i, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
      v_store(c, v_slotaddr(c, islot), i2);
      emit_br(c, hdr);
      use_block(c, done);
    }
    let buf: *IRVreg = v_load(c, addr, IRType.ItPtr);
    if retain {
      rc_call1(c, "rho__rc_inch", buf);
    } else {
      rc_call1(c, "rho__rc_dech", buf);
    }
    return;
  }
  if t.kind == TypeKind.TyArray {
    if !ty_is_managed(t.elem) {
      return;
    }
    let esz: i64 = type_size(t.elem);
    let mut i: u64 = 0;
    while i < t.len {
      let efnn: string = value_fn_for(t.elem, retain);
      if efnn != "" {
        rc_call1(c, efnn, v_addi(c, addr, (esz * i as i64)));
      }
      i += 1;
    }
    return;
  }
  if t.kind == TypeKind.TyStruct {
    let rec: *RecType = t.rec;
    let dcl: *Decl = rec.decl;
    let mut i: usize = 0;
    while i < dcl.fields.n {
      let off: i64 = struct_field_offset(rec, i);
      let ft: *Type = struct_field_type(rec, i);
      if ty_is_managed(ft) {
        let efnn: string = value_fn_for(ft, retain);
        if efnn != "" {
          rc_call1(c, efnn, v_addi(c, addr, off));
        }
      }
      i += 1;
    }
    return;
  }
  if t.kind == TypeKind.TyEnum {
    let dcl: *Decl = t.rec.decl;
    let tag: *IRVreg = v_load(c, addr, IRType.ItI32);
    let done: *IRBlock = new_block(c);
    let mut any: bool = false;
    let mut vi: usize = 0;
    while vi < dcl.variants.n {
      let v: *VariantAst = dcl.variants.items[vi];
      let mut nf: usize = 0;
      if v.vkind == VarKind.VarTuple {
        nf = v.types.n;
      } else if v.vkind == VarKind.VarStruct {
        nf = v.fields.n;
      }
      let mut managed: bool = false;
      let mut chk: usize = 0;
      while chk < nf && !managed {
        managed = ty_is_managed(variant_field_type(t, vi as i32, chk as i32));
        chk += 1;
      }
      if !managed {
        vi += 1;
        continue;
      }
      let body: *IRBlock = new_block(c);
      let next: *IRBlock = new_block(c);
      let is: *IRVreg = v_cmp(c, IRCC.CcEq, tag, v_const(c, v.disc as i64, IRType.ItI32), false);
      emit_cbr(c, is, body, next, done);
      use_block(c, body);
      let mut fi: usize = 0;
      while fi < nf {
        let ft: *Type = variant_field_type(t, vi as i32, fi as i32);
        if ty_is_managed(ft) {
          let off: i64 = variant_field_offset(t, vi as i32, fi as i32);
          let efnn: string = value_fn_for(ft, retain);
          if efnn != "" {
            rc_call1(c, efnn, v_addi(c, addr, off));
          }
        }
        fi += 1;
      }
      emit_br(c, done);
      use_block(c, next);
      any = true;
      vi += 1;
    }
    if any {
      emit_br(c, done);
      use_block(c, done);
    }
    return;
  }
}

fn retain_which(retain: bool) -> string {
  if retain {
    return "ret";
  }
  return "rel";
}


fn ret_cache() -> *TypeMap2 {
  if g_ret_fns == null {
    g_ret_fns = tm2_new();
  }
  return g_ret_fns;
}

fn rel_cache() -> *TypeMap2 {
  if g_rel_fns == null {
    g_rel_fns = tm2_new();
  }
  return g_rel_fns;
}


fn elem_size(t: *Type) -> i64 {
  if t == null {
    return 8;
  }
  if t.kind == TypeKind.TyI8 || t.kind == TypeKind.TyU8 || t.kind == TypeKind.TyBool {
    return 1;
  }
  if t.kind == TypeKind.TyI16 || t.kind == TypeKind.TyU16 {
    return 2;
  }
  if t.kind == TypeKind.TyI32 || t.kind == TypeKind.TyU32 || t.kind == TypeKind.TyF32 {
    return 4;
  }
  return 8;
}

// ================= layout (LOW-7) ==========================================

fn round_up_i64(v: i64, a: i64) -> i64 {
  return (v + a - 1) / a * a;
}

fn type_align(t: *Type) -> i64 {
  if t == null {
    return 1;
  }
  if t.kind == TypeKind.TyI8 || t.kind == TypeKind.TyU8 || t.kind == TypeKind.TyBool {
    return 1;
  }
  if t.kind == TypeKind.TyI16 || t.kind == TypeKind.TyU16 {
    return 2;
  }
  if t.kind == TypeKind.TyI32 || t.kind == TypeKind.TyU32 || t.kind == TypeKind.TyF32 {
    return 4;
  }
  if t.kind == TypeKind.TyStruct || t.kind == TypeKind.TyEnum {
    layout_rec(t.rec);
    if t.rec.align > 0 {
      return t.rec.align;
    }
    return 8;
  }
  return 8;
}

fn type_size(t: *Type) -> i64 {
  if t == null {
    return 0;
  }
  if t.kind == TypeKind.TyI8 || t.kind == TypeKind.TyU8 || t.kind == TypeKind.TyBool {
    return 1;
  }
  if t.kind == TypeKind.TyI16 || t.kind == TypeKind.TyU16 {
    return 2;
  }
  if t.kind == TypeKind.TyI32 || t.kind == TypeKind.TyU32 || t.kind == TypeKind.TyF32 {
    return 4;
  }
  if t.kind == TypeKind.TyStringK || t.kind == TypeKind.TySlice {
    return 24;
  }
  if t.kind == TypeKind.TyFn {
    return 16; // {code, env}
  }
  if t.kind == TypeKind.TyStruct || t.kind == TypeKind.TyEnum {
    layout_rec(t.rec);
    return t.rec.size;
  }
  return 8;
}

fn layout_rec(rec: *RecType) {
  if rec.align != 0 {
    return;
  }
  rec.align = (0 - 1) as i64;
  let d: *Decl = rec.decl;
  let saved_mod: *Module = cur_module;
  if rec.owner_mod != null {
    cur_module = rec.owner_mod;
  }
  let mut size: i64 = 0;
  let mut align: i64 = 1;
  if d.kind == DeclKind.DkStruct {
    struct_field_type(rec, 0);
    let mut i: usize = 0;
    while i < d.fields.n {
      let ft: *Type = rec.field_types[i];
      let fa: i64 = type_align(ft);
      if fa > align {
        align = fa;
      }
      let off: i64 = round_up_i64(size, fa);
      rec.offsets = push_i64(rec.offsets, off);
      size = off + type_size(ft);
      i += 1;
    }
  } else {
    align = 4;
    size = 4;
    let saved_env: *TypeMap = g_tenv;
    g_tenv = rec.env_tenv;
    let mut i: usize = 0;
    while i < d.variants.n {
      let v: *VariantAst = d.variants.items[i];
      let foff: *I64Vec = new I64Vec { items: make([]i64, 0) };
      rec.var_offsets = push_i64vec(rec.var_offsets, foff);
      if v.vkind == VarKind.VarUnit {
        rec.var_poff = push_i64(rec.var_poff, 4);
        i += 1;
        continue;
      }
      let mut nfields: usize = v.types.n;
      if v.vkind == VarKind.VarStruct {
        nfields = v.fields.n;
      }
      let mut off: i64 = 4;
      let mut j: usize = 0;
      while j < nfields {
        let mut fta: *TypeAst = v.types.items[j];
        if v.vkind == VarKind.VarStruct {
          fta = v.fields.items[j].ty;
        }
        let vt: *Type = resolve_type_in_module(cur_module, fta);
        let va: i64 = type_align(vt);
        if va > align {
          align = va;
        }
        off = round_up_i64(off, va);
        foff.items = push_i64(foff.items, off);
        off = off + type_size(vt);
        j += 1;
      }
      let mut poff: i64 = 4;
      if len(foff.items) > 0 {
        poff = foff.items[0];
      }
      rec.var_poff = push_i64(rec.var_poff, poff);
      if off > size {
        size = off;
      }
      i += 1;
    }
    g_tenv = saved_env;
  }
  cur_module = saved_mod;
  rec.align = align;
  rec.size = round_up_i64(size, align);
}

fn push_i64vec(items: []*I64Vec, v: *I64Vec) -> []*I64Vec {
  let out: []*I64Vec = make([]*I64Vec, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

// payload start of one variant of an enum value
fn variant_payload_offset(enum_t: *Type, variant: i32) -> i64 {
  layout_rec(enum_t.rec);
  if variant >= 0 && variant as usize < len(enum_t.rec.var_poff) {
    return enum_t.rec.var_poff[variant];
  }
  return 4;
}

fn variant_field_offset(enum_t: *Type, variant: i32, field: i32) -> i64 {
  layout_rec(enum_t.rec);
  if variant >= 0 && variant as usize < len(enum_t.rec.var_offsets) {
    let foff: []i64 = enum_t.rec.var_offsets[variant].items;
    if field >= 0 && field as usize < len(foff) {
      return foff[field];
    }
  }
  return 4;
}

fn push_i64(items: []i64, v: i64) -> []i64 {
  let out: []i64 = make([]i64, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn struct_field_offset(rec: *RecType, i: usize) -> i64 {
  layout_rec(rec);
  if len(rec.offsets) > i {
    return rec.offsets[i];
  }
  return 0;
}
// ================= lowering (LOW-8): checks, panic, rc runtime ==============

struct CV { ok: bool, is_int: bool, i: u64, f: f64, s: string, b: bool }

// compile-time constant evaluation (statics/consts)
fn const_eval(e: *Expr, m: *Module) -> *CV {
  let r: *CV = new CV { ok: false, is_int: false, i: 0, f: 0.0, s: "", b: false };
  let saved: *Module = cur_module;
  cur_module = m;
  if e.kind == ExprKind.ExInt {
    r.ok = true;
    r.is_int = true;
    r.i = e.iv;
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExFloat {
    r.ok = true;
    r.f = e.fv;
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExStr {
    r.ok = true;
    r.s = e.sv;
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExBool {
    r.ok = true;
    r.b = e.bv;
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExName {
    let mut sym: *Sym = sm_get(m.syms, e.sv);
    if sym == null && prelude_module != null && prelude_module != m {
      sym = sm_get(prelude_module.syms, e.sv);
    }
    if sym != null && (sym.kind == SymKind.SyConst || sym.kind == SymKind.SyStatic) {
      if sym.decl.ceval_ok {
        r.ok = true;
        r.is_int = sym.decl.ceval_is_int;
        r.i = sym.decl.ceval_i;
        r.f = sym.decl.ceval_f;
        cur_module = saved;
        return r;
      }
      let v: *CV = const_eval(sym.decl.init, m);
      sym.decl.ceval_ok = v.ok;
      sym.decl.ceval_is_int = v.is_int;
      sym.decl.ceval_i = v.i;
      sym.decl.ceval_f = v.f;
      r.ok = v.ok;
      r.is_int = v.is_int;
      r.i = v.i;
      r.f = v.f;
      cur_module = saved;
      return r;
    }
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExUn {
    let a: *CV = const_eval(e.a, m);
    if !a.ok {
      cur_module = saved;
      return r;
    }
    r.ok = true;
    if e.unop == Tok.PMinus {
      if a.is_int {
        r.is_int = true;
        r.i = (0 - (a.i as i64)) as u64;
      } else {
        r.f = 0.0 - a.f;
      }
    } else if e.unop == Tok.PTilde && a.is_int {
      r.is_int = true;
      r.i = ~a.i;
    } else if e.unop == Tok.PBang {
      r.b = !a.b;
    } else {
      r.ok = false;
    }
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExBin {
    let a: *CV = const_eval(e.a, m);
    let b: *CV = const_eval(e.b, m);
    if !a.ok || !b.ok {
      cur_module = saved;
      return r;
    }
    if !a.is_int || !b.is_int {
      cur_module = saved;
      return r; // no float/str const arithmetic
    }
    r.ok = true;
    r.is_int = true;
    let x: u64 = a.i;
    let y: u64 = b.i;
    let op: Tok = e.binop;
    if op == Tok.PPlus { r.i = x + y; }
    else if op == Tok.PMinus { r.i = x - y; }
    else if op == Tok.PStar { r.i = x * y; }
    else if op == Tok.PSlash { if y != 0 { r.i = x / y; } }
    else if op == Tok.PPercent { if y != 0 { r.i = x % y; } }
    else if op == Tok.PAmp { r.i = x & y; }
    else if op == Tok.PPipe { r.i = x | y; }
    else if op == Tok.PCaret { r.i = x ^ y; }
    else if op == Tok.PShl { r.i = x << (y & 63); }
    else if op == Tok.PShr { r.i = x >> (y & 63); }
    else if op == Tok.PEq { r.is_int = false; r.b = x == y; }
    else if op == Tok.PNe { r.is_int = false; r.b = x != y; }
    else if op == Tok.PLt { r.is_int = false; r.b = x < y; }
    else if op == Tok.PGt { r.is_int = false; r.b = x > y; }
    else if op == Tok.PLe { r.is_int = false; r.b = x <= y; }
    else if op == Tok.PGe { r.is_int = false; r.b = x >= y; }
    else if op == Tok.PAndand { r.is_int = false; r.b = x != 0 && y != 0; }
    else if op == Tok.POror { r.is_int = false; r.b = x != 0 || y != 0; }
    else { r.ok = false; }
    cur_module = saved;
    return r;
  }
  cur_module = saved;
  return r;
}

fn ty_is_signed_int(t: IRType) -> bool {
  if t == IRType.ItI8 || t == IRType.ItI16 || t == IRType.ItI32 || t == IRType.ItI64 {
    return true;
  }
  return false;
}

fn ir_type_of(t: *Type) -> IRType {
  if t.kind == TypeKind.TyBool { return IRType.ItU8; }
  if t.kind == TypeKind.TyI8 { return IRType.ItI8; }
  if t.kind == TypeKind.TyI16 { return IRType.ItI16; }
  if t.kind == TypeKind.TyI32 { return IRType.ItI32; }
  if t.kind == TypeKind.TyI64 { return IRType.ItI64; }
  if t.kind == TypeKind.TyU8 { return IRType.ItU8; }
  if t.kind == TypeKind.TyU16 { return IRType.ItU16; }
  if t.kind == TypeKind.TyU32 { return IRType.ItU32; }
  if t.kind == TypeKind.TyU64 { return IRType.ItU64; }
  if t.kind == TypeKind.TyUsize { return IRType.ItUsize; }
  if t.kind == TypeKind.TyIsize { return IRType.ItI64; }
  if t.kind == TypeKind.TyF32 { return IRType.ItF32; }
  if t.kind == TypeKind.TyF64 { return IRType.ItF64; }
  return IRType.ItPtr;
}

fn ty_is_aggregate(t: *Type) -> bool {
  if t.kind == TypeKind.TyStruct || t.kind == TypeKind.TyEnum ||
     t.kind == TypeKind.TyArray || t.kind == TypeKind.TySlice ||
     t.kind == TypeKind.TyStringK || t.kind == TypeKind.TyFn {
    return true; // TyFn: closure pair {code, env}
  }
  return false;
}

fn push_phi(items: []*IRPhi, p: *IRPhi) -> []*IRPhi {
  let out: []*IRPhi = make([]*IRPhi, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = p;
  return out;
}

// a phi lives in the block whose execution merges: the JOIN block
fn emit_phi_in(c: *LCtx, block: *IRBlock, ty: IRType) -> *IRPhi {
  let saved: *IRBlock = c.f.cur;
  c.f.cur = block;
  let p: *IRPhi = new IRPhi {
    dst: new_vreg(c, ty), args: make([]*IRVreg, 0), preds: make([]*IRBlock, 0),
  };
  block.phis = push_phi(block.phis, p);
  c.f.cur = saved;
  return p;
}

fn phi_add(p: *IRPhi, pred: *IRBlock, v: *IRVreg) {
  p.preds = push_ptr(p.preds, pred);
  p.args = push_vreg(p.args, v);
}

fn push_u8(items: []u8, v: u8) -> []u8 {
  let out: []u8 = make([]u8, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn lit_bytes(c: *LCtx, s: string) -> i32 {
  let mut bytes: []u8 = make([]u8, 0);
  let mut i: usize = 0;
  while i < len(s) {
    bytes = push_u8(bytes, s[i]);
    i += 1;
  }
  bytes = push_u8(bytes, 0); // NUL pad for C interop debugging
  let label: string = cat3("str", itoa(g_lit_counter as i64), "");
  g_lit_counter += 1;
  let l: *IRLit = new IRLit { label: label, bytes: bytes };
  c.f.literals = push_lit(c.f.literals, l);
  return len(c.f.literals) as i32 - 1;
}

fn push_lit(items: []*IRLit, l: *IRLit) -> []*IRLit {
  let out: []*IRLit = make([]*IRLit, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = l;
  return out;
}

// the aggregate-return destination: the out slot holds the caller's buffer
// pointer — load through it, never write into the slot itself
fn ret_dest(c: *LCtx) -> *IRVreg {
  return v_load(c, v_slotaddr(c, c.f.out_slot), IRType.ItPtr);
}

// mangled symbol for a module-level symbol: rho_<path>__<name>
fn sym_symbol(s: *Sym) -> string {
  if s.symbol != "" {
    return s.symbol;
  }
  if s.kind == SymKind.SyExtern {
    return s.name; // C ABI name; emitter adds prefix per target
  }
  let mut path: string = "";
  if s.owner != null {
    path = rho_sanitize(s.owner.path);
  }
  // instantiation markers (`push$u8`) must not fold to the same token as a
  // plain identifier (`push_u8`), so `$` escapes to `_Q_`
  let name: string = rho_sanitize_sym(s.name);
  let sym: string = cat3("rho_", cat3(path, "__", name), "");
  s.symbol = sym;
  return sym;
}

fn rho_sanitize_sym(s: string) -> string {
  let buf: *Vec[u8] = new Vec[u8] { items: make([]u8, 32), n: 0 };
  let mut i: usize = 0;
  while i < len(s) {
    let c: u8 = s[i];
    let ok: bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
                   (c >= 48 && c <= 57) || c == 95;
    if ok {
      buf.push(c);
    } else if c == 36 {
      buf.push(95);
      buf.push(81);
      buf.push(95);
    } else {
      buf.push(95);
    }
    i += 1;
  }
  return intrinsics.slice_string(buf.items[0..buf.n]);
}

fn prelude_fn(name: string) -> *Sym {
  if prelude_module == null {
    return null;
  }
  return sm_get(prelude_module.syms, name);
}

fn panic_call(c: *LCtx, msg: string) {
  // stamp the function name + a per-site counter into the message: runtime
  // panics from generated checks are otherwise indistinguishable
  let site: i32 = g_panic_site;
  g_panic_site += 1;
  let m: string = cat3("[", cat3(c.f.symbol, "#", cat3(itoa(site as i64), "] ", msg)), "");
  let lit: i32 = lit_bytes(c, m);
  let tmp: *IRSlot = new_slot(c, 24, 8, "panicstr");
  let addr: *IRVreg = v_slotaddr(c, tmp);
  let ptrv: *IRVreg = new_vreg(c, IRType.ItPtr);
  let la: *IRIns = emit(c, IROp.IrLitaddr);
  la.dst = ptrv;
  la.lit = lit;
  let bytes: *IRVreg = v_addi(c, ptrv, 24);
  let addr8: *IRVreg = v_addi(c, addr, 8);
  let addr16: *IRVreg = v_addi(c, addr, 16);
  let lenv: *IRVreg = v_const(c, len(m) as i64, IRType.ItUsize);
  let st1: *IRIns = emit(c, IROp.IrStore);
  st1.addr = addr;
  st1.a = ptrv;
  st1.size = 8;
  let st2: *IRIns = emit(c, IROp.IrStore);
  st2.addr = addr8;
  st2.a = bytes;
  st2.size = 8;
  let st3: *IRIns = emit(c, IROp.IrStore);
  st3.addr = addr16;
  st3.a = lenv;
  st3.size = 8;
  // call prelude panic(msg)
  let panic_fn: *Sym = prelude_fn("panic");
  let call: *IRIns = emit(c, IROp.IrCall);
  call.callee = sym_symbol(panic_fn);
  call.args = push_vreg(call.args, addr);
  // panic never returns; keep the block unsealed — a br follows at call site
}

fn null_check(c: *LCtx, ptr: *IRVreg) -> *IRVreg {
  let ok: *IRBlock = new_block(c);
  let bad: *IRBlock = new_block(c);
  let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, ptr, v_const(c, 0, IRType.ItPtr), false);
  emit_cbr(c, isnull, bad, ok, ok);
  use_block(c, bad);
  panic_call(c, "null dereference");
  emit_br(c, ok); // unreachable, keeps the CFG well-formed
  use_block(c, ok);
  return ptr;
}

// bounds check: idx < len, unsigned
fn bounds_check(c: *LCtx, idx: *IRVreg, len_v: *IRVreg) {
  let ok: *IRBlock = new_block(c);
  let bad: *IRBlock = new_block(c);
  let oob: *IRVreg = v_cmp(c, IRCC.CcGe, idx, len_v, false); // unsigned via emitter flag
  emit_cbr(c, oob, bad, ok, ok);
  use_block(c, bad);
  panic_call(c, "index out of bounds");
  emit_br(c, ok);
  use_block(c, ok);
}

// slice upper bound: hi <= len is legal
fn bounds_check_hi(c: *LCtx, hi: *IRVreg, len_v: *IRVreg) {
  let ok: *IRBlock = new_block(c);
  let bad: *IRBlock = new_block(c);
  let oob: *IRVreg = v_cmp(c, IRCC.CcGt, hi, len_v, false);
  emit_cbr(c, oob, bad, ok, ok);
  use_block(c, bad);
  panic_call(c, "index out of bounds");
  emit_br(c, ok);
  use_block(c, ok);
}

fn call_prelude1(c: *LCtx, name: string, arg0: *IRVreg, ret: IRType) -> *IRVreg {
  let fn_: *Sym = prelude_fn(name);
  let call: *IRIns = emit(c, IROp.IrCall);
  call.callee = sym_symbol(fn_);
  if arg0 != null {
    call.args = push_vreg(call.args, arg0);
  }
  call.dst = new_vreg(c, ret);
  return call.dst;
}

// string equality: both operands lowered as slice addresses; calls prelude
fn call_str_cmp(c: *LCtx, e: *Expr, want_eq: bool) -> *IRVreg {
  let a: *IRVreg = lv_expr(c, e.a);
  let b: *IRVreg = lv_expr(c, e.b);
  let fn_: *Sym = prelude_fn("__streq");
  let call: *IRIns = emit(c, IROp.IrCall);
  call.callee = sym_symbol(fn_);
  call.args = push_vreg(call.args, a);
  call.args = push_vreg(call.args, b);
  call.dst = new_vreg(c, IRType.ItU8);
  if !want_eq {
    let one: *IRVreg = v_const(c, 1, IRType.ItU8);
    // negate via XOR 1
    let x: *IRIns = emit(c, IROp.IrXor);
    x.dst = new_vreg(c, IRType.ItU8);
    x.a = call.dst;
    x.b = one;
    return x.dst;
  }
  return call.dst;
}

// slice expression a[lo..hi]: materialize {buf, ptr+lo, hi-lo} into a temp
fn lower_slice(c: *LCtx, e: *Expr) -> *IRVreg {
  let bt: *Type = e.a.typed;
  let base: *IRVreg = lv_expr(c, e.a); // aggregate: address of slice/array
  let mut lo: *IRVreg = lv_expr(c, e.b);
  let mut hi: *IRVreg = lv_expr(c, e.c);
  if lo.ty != IRType.ItUsize {
    lo = v_cast(c, lo, IRType.ItUsize);
  }
  if hi.ty != IRType.ItUsize {
    hi = v_cast(c, hi, IRType.ItUsize);
  }
  let mut len_v: *IRVreg = null;
  if bt.kind == TypeKind.TyArray {
    len_v = v_const(c, bt.len as i64, IRType.ItUsize);
  } else {
    len_v = v_load(c, v_addi(c, base, 16), IRType.ItUsize);
  }
  bounds_check(c, lo, len_v);
  bounds_check_hi(c, hi, len_v);
  let mut buf: *IRVreg = null;
  let mut ptr: *IRVreg = null;
  if bt.kind == TypeKind.TyArray {
    buf = compute_addr(c, e.a); // array address as buffer
    ptr = buf;
  } else {
    buf = v_load(c, base, IRType.ItPtr);
    ptr = v_load(c, v_addi(c, base, 8), IRType.ItPtr);
  }
  let mut esize: i64 = type_size(bt.elem);
  if bt.kind == TypeKind.TyStringK {
    esize = 1;
  }
  let esz: *IRVreg = v_const(c, esize, IRType.ItUsize);
  let mul: *IRIns = emit(c, IROp.IrMul);
  mul.dst = new_vreg(c, IRType.ItUsize);
  mul.a = lo;
  mul.b = esz;
  let scaled: *IRVreg = mul.dst;
  let pa: *IRIns = emit(c, IROp.IrAdd);
  pa.dst = new_vreg(c, IRType.ItPtr);
  pa.a = ptr;
  pa.b = scaled;
  let sub: *IRIns = emit(c, IROp.IrSub);
  sub.dst = new_vreg(c, IRType.ItUsize);
  sub.a = hi;
  sub.b = lo;
  let nlen: *IRVreg = sub.dst;
  let tmp: *IRSlot = new_slot(c, 24, 8, "sliceval");
  let dest: *IRVreg = v_slotaddr(c, tmp);
  let d8: *IRVreg = v_addi(c, dest, 8);
  let d16: *IRVreg = v_addi(c, dest, 16);
  let s1: *IRIns = emit(c, IROp.IrStore);
  s1.addr = dest;
  s1.a = buf;
  s1.size = 8;
  let s2: *IRIns = emit(c, IROp.IrStore);
  s2.addr = d8;
  s2.a = pa.dst;
  s2.size = 8;
  let s3: *IRIns = emit(c, IROp.IrStore);
  s3.addr = d16;
  s3.a = nlen;
  s3.size = 8;
  return dest;
}

fn scope_pop_l(c: *LCtx) {
  c.scope = c.scope.parent;
}

// ---------------------------------------------------- ownership rules ----
//
// An owning rvalue carries its +1 (new/make/call/closure, and match/if
// results which normalize their arms); everything else borrows. Bindings
// own: a let either takes the +1 or retains a borrowed value; scopes
// release what they own, innermost first, on every exit path.

fn expr_owned(e: *Expr) -> bool {
  if e == null || e.typed == null {
    return false;
  }
  if e.kind == ExprKind.ExNew || e.kind == ExprKind.ExClosure {
    return true;
  }
  if e.kind == ExprKind.ExCall {
    // weak.get() lends the object without taking a count: it is a borrow
    if e.a.kind == ExprKind.ExField && streq(e.a.sv, "get") && e.a.a != null &&
       e.a.a.typed != null && e.a.a.typed.kind == TypeKind.TyWeak {
      return false;
    }
    return ty_is_managed(e.typed);
  }
  if e.kind == ExprKind.ExMake || e.kind == ExprKind.ExMatch || e.kind == ExprKind.ExIf {
    return ty_is_managed(e.typed);
  }
  return false;
}

// release every owned binding from the current scope down to (exclusive)
// `stop` — the rc twin of run_defers
fn release_scopes_to(c: *LCtx, stop: *LScope) {
  let mut s: *LScope = c.scope;
  while s != null && s != stop {
    if !s.is_loop {
      // loop bindings release only at the back edge; unwinding an
      // interrupted iteration would double-release or release junk
      let owned: []*OwnedBind = s.owned;
      let mut k: usize = len(owned);
      while k > 0 {
        let ob: *OwnedBind = owned[k - 1];
        release_addr(c, ob.ty, v_slotaddr(c, ob.slot));
        k -= 1;
      }
    }
    s = s.parent;
  }
}

// retain a produced rvalue: aggregates are value addresses, scalars are
// plain pointer vregs
fn retain_or_inc(c: *LCtx, t: *Type, v: *IRVreg) {
  if ty_is_aggregate(t) {
    retain_addr(c, t, v);
  } else if t.kind == TypeKind.TyPtr {
    rc_inc_v(c, v);
  } else if t.kind == TypeKind.TyWeak {
    rc_call1(c, "rho__rc_winc", v);
  }
}

// a block arm's value is pre-owned when its trailing expression is an
// owning producer (or a nested if, which normalizes itself)
fn arm_value_owned(stmts: *Vec[*Stmt]) -> bool {
  if stmts.n == 0 {
    return true; // void-ish; nothing to normalize
  }
  let last: *Stmt = stmts.items[stmts.n - 1];
  if last.kind != StmtKind.StExpr || !last.tail || last.a == null {
    return true;
  }
  return last.a.kind == ExprKind.ExIf || expr_owned(last.a);
}

// ------------------------------------------------------------ closures ----
//
// A closure value is {code: *fn, env: *u8}. Calling one always passes env as
// the final hidden argument, so closure bodies and shims share one ABI.
// Static fn references materialize as {shim, null}: the shim drops env and
// forwards. Boot-era captures are copies — immutable snapshots.

static mut g_shims: *Vec[string] = 0 as *Vec[string];

fn push_str(items: []string, v: string) -> []string {
  let out: []string = make([]string, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn shim_for(fn_: *Sym) -> string {
  let shim_name: string = cat3("rho__shim_", sym_symbol(fn_), "");
  if g_shims == null {
    g_shims = new Vec[string] { items: make([]string, 64), n: 0 };
  }
  let mut i: usize = 0;
  while i < g_shims.n {
    if streq(g_shims.items[i], shim_name) {
      return shim_name;
    }
    i += 1;
  }
  g_shims.push(shim_name);
  let ft: *Type = fn_.type;
  let ret: *Type = ft.ret;
  let agg_ret: bool = ret != null && ty_is_aggregate(ret);

  let lf: *IRFn = rc_new_fn(shim_name);
  lf.ret = ret;
  let cc: *LCtx = rc_ctx(lf);
  if agg_ret {
    lf.returns_aggregate = true;
    lf.out_slot = new_slot(cc, type_size(ret), type_align(ret), "out");
  }
  lf.entry = new_block(cc);
  use_block(cc, lf.entry);

  let mut args: []*IRVreg = make([]*IRVreg, 0);
  if agg_ret {
    let outp: *IRVreg = v_load(cc, v_slotaddr(cc, lf.out_slot), IRType.ItPtr);
    args = push_vreg(args, outp);
  }
  let mut i2: usize = 0;
  while i2 < len(ft.params) {
    let pt: *Type = ft.params[i2];
    let sl: *IRSlot = new_slot(cc, type_size(pt), type_align(pt), "p");
    lf.params = push_islot(lf.params, sl);
    lf.param_types = push_type(lf.param_types, pt);
    let mut it: IRType = ir_type_of(pt);
    if ty_is_aggregate(pt) {
      it = IRType.ItPtr;
    }
    let pv: *IRVreg = v_load(cc, v_slotaddr(cc, sl), it);
    args = push_vreg(args, pv);
    i2 += 1;
  }
  // the closure-ABI env parameter arrives last and is dropped here
  let env: *IRSlot = new_slot(cc, 8, 8, "env");
  lf.params = push_islot(lf.params, env);
  lf.param_types = push_type(lf.param_types, null);

  let call: *IRIns = emit(cc, IROp.IrCall);
  call.callee = sym_symbol(fn_);
  call.args = args;
  let mut rv: *IRVreg = null;
  if ret != null && !agg_ret && ret.kind != TypeKind.TyVoid {
    call.dst = new_vreg(cc, ir_type_of(ret));
    rv = call.dst;
  }
  emit_ret(cc, rv);
  g_ir_fns.push(lf);
  return shim_name;
}

// a fn value for a named function: {shim, null env}
fn closure_value_for_sym(c: *LCtx, fn_: *Sym) -> *IRVreg {
  let shim: string = shim_for(fn_);
  let la: *IRIns = emit(c, IROp.IrAddrc);
  la.dst = new_vreg(c, IRType.ItPtr);
  la.callee = shim;
  la.lit = -1; // global/fn address form
  let zero: *IRVreg = v_const(c, 0, IRType.ItPtr);
  let tmp: *IRSlot = new_slot(c, 16, 8, "fnval");
  let addr: *IRVreg = v_slotaddr(c, tmp);
  let a8: *IRVreg = v_addi(c, addr, 8);
  let s1: *IRIns = emit(c, IROp.IrStore);
  s1.addr = addr;
  s1.a = la.dst;
  s1.size = 8;
  let s2: *IRIns = emit(c, IROp.IrStore);
  s2.addr = a8;
  s2.a = zero;
  s2.size = 8;
  return addr;
}

// ------------------------------------------------------ rc runtime -------
//
// Every heap object carries {rc: usize, wrc: usize, drop: fn} 24 bytes
// before its data; references point at the data. rc with the top bit set
// marks immortal static data.

fn rc_runtime_build() {
  // count helpers come in two conventions: __rc_inc/__rc_dec take the DATA
  // pointer (header at p-24 — *T values, closure envs), __rc_inch/__rc_dech
  // take the HEADER directly (slice buf fields, which sub-slices share while
  // ptr moves). Both null-check their argument.
  let mut variant: i32 = 0;
  while variant < 4 {
    let retain: bool = (variant & 1) == 0;
    let from_data: bool = (variant & 2) == 0;
    let mut nm: string = "rho__rc_dec";
    if retain {
      nm = "rho__rc_inc";
    }
    if !from_data {
      nm = cat3(nm, "h", "");
    }
    let lf: *IRFn = rc_new_fn(nm);
    let c: *LCtx = rc_ctx(lf);
    let ps: *IRSlot = new_slot(c, 8, 8, "p");
    lf.params = push_islot(lf.params, ps);
    lf.param_types = push_type(lf.param_types, null);
    let p: *IRVreg = v_load(c, v_slotaddr(c, ps), IRType.ItPtr);
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, p, v_const(c, 0, IRType.ItPtr), false);
    let cont: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, cont, done);
    use_block(c, cont);
    let mut h: *IRVreg = p;
    if !from_data {
      h = p;
    } else {
      h = v_addi(c, p, -24);
    }
    let rc: *IRVreg = v_load(c, h, IRType.ItUsize);
    let top: *IRVreg = v_binop(c, IROp.IrShr, rc, v_const(c, 63, IRType.ItUsize), IRType.ItUsize, false);
    let immortal: *IRVreg = v_cmp(c, IRCC.CcNe, top, v_const(c, 0, IRType.ItUsize), false);
    if retain {
      let bump: *IRBlock = new_block(c);
      emit_cbr(c, immortal, done, bump, done);
      use_block(c, bump);
      // same plausibility bound as the release path below: never write a
      // count through a header that does not look like one
      let implausible: *IRVreg = v_cmp_uge(c, rc, v_const(c, 65536, IRType.ItUsize));
      let sane: *IRBlock = new_block(c);
      emit_cbr(c, implausible, done, sane, done);
      use_block(c, sane);
      let rc2: *IRVreg = v_binop(c, IROp.IrAdd, rc, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
      v_store(c, h, rc2);
      emit_br(c, done);
      use_block(c, done);
      finish_fn_c(c);
      variant += 1;
      continue;
    }
    // release: on zero, run header.drop (with the data pointer) and free
    // unless weak refs hold it
    let live: *IRBlock = new_block(c);
    emit_cbr(c, immortal, done, live, done);
    use_block(c, live);
    // a plausible live count is small; a pointer-sized value here means h
    // is not a real header — trap instead of writing the count through it
    let implausible2: *IRVreg = v_cmp_uge(c, rc, v_const(c, 65536, IRType.ItUsize));
    let countsane: *IRBlock = new_block(c);
    emit_cbr(c, implausible2, done, countsane, done);
    use_block(c, countsane);
    let rc3: *IRVreg = v_binop(c, IROp.IrSub, rc, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
    v_store(c, h, rc3);
    let dead: *IRVreg = v_cmp(c, IRCC.CcEq, rc3, v_const(c, 0, IRType.ItUsize), false);
    let maybe_drop: *IRBlock = new_block(c);
    emit_cbr(c, dead, maybe_drop, done, done);
    use_block(c, maybe_drop);
    let dropf: *IRVreg = v_load(c, v_addi(c, h, 16), IRType.ItPtr);
    let nod: *IRVreg = v_cmp(c, IRCC.CcEq, dropf, v_const(c, 0, IRType.ItPtr), false);
    let run_drop: *IRBlock = new_block(c);
    let maybe_free: *IRBlock = new_block(c);
    emit_cbr(c, nod, maybe_free, run_drop, done);
    use_block(c, run_drop);
    let mut darg: *IRVreg = p;
    if !from_data {
      darg = v_addi(c, h, 24);
    }
    let dc: *IRIns = emit(c, IROp.IrCall);
    dc.callee_vreg = dropf;
    dc.args = push_vreg(dc.args, darg);
    emit_br(c, maybe_free);
    use_block(c, maybe_free);
    let wrc: *IRVreg = v_load(c, v_addi(c, h, 8), IRType.ItUsize);
    let noweak: *IRVreg = v_cmp(c, IRCC.CcEq, wrc, v_const(c, 0, IRType.ItUsize), false);
    let freeh: *IRBlock = new_block(c);
    emit_cbr(c, noweak, freeh, done, done);
    use_block(c, freeh);
    let fr: *Sym = prelude_fn("__free");
    let fc: *IRIns = emit(c, IROp.IrCall);
    fc.callee = sym_symbol(fr);
    fc.args = push_vreg(fc.args, h);
    emit_br(c, done);
    use_block(c, done);
    finish_fn_c(c);
    variant += 1;
  }
  // __rc_winc(h) / __rc_wdec(h): weak count up/down; last weak of a dead
  // object frees the storage
  {
    let lf: *IRFn = rc_new_fn("rho__rc_winc");
    let c: *LCtx = rc_ctx(lf);
    let hs: *IRSlot = new_slot(c, 8, 8, "h");
    lf.params = push_islot(lf.params, hs);
    lf.param_types = push_type(lf.param_types, null);
    let h: *IRVreg = v_load(c, v_slotaddr(c, hs), IRType.ItPtr);
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, h, v_const(c, 0, IRType.ItPtr), false);
    let cont: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, cont, done);
    use_block(c, cont);
    let w: *IRVreg = v_load(c, v_addi(c, h, 8), IRType.ItUsize);
    let w2: *IRVreg = v_binop(c, IROp.IrAdd, w, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
    v_store(c, v_addi(c, h, 8), w2);
    emit_br(c, done);
    use_block(c, done);
    finish_fn_c(c);
  }
  {
    let lf: *IRFn = rc_new_fn("rho__rc_wdec");
    let c: *LCtx = rc_ctx(lf);
    let hs: *IRSlot = new_slot(c, 8, 8, "h");
    lf.params = push_islot(lf.params, hs);
    lf.param_types = push_type(lf.param_types, null);
    let h: *IRVreg = v_load(c, v_slotaddr(c, hs), IRType.ItPtr);
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, h, v_const(c, 0, IRType.ItPtr), false);
    let cont: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, cont, done);
    use_block(c, cont);
    let w: *IRVreg = v_load(c, v_addi(c, h, 8), IRType.ItUsize);
    let w2: *IRVreg = v_binop(c, IROp.IrSub, w, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
    v_store(c, v_addi(c, h, 8), w2);
    let last: *IRVreg = v_cmp(c, IRCC.CcEq, w2, v_const(c, 0, IRType.ItUsize), false);
    let chk: *IRBlock = new_block(c);
    emit_cbr(c, last, chk, done, done);
    use_block(c, chk);
    let rc: *IRVreg = v_load(c, h, IRType.ItUsize);
    let deadc: *IRVreg = v_cmp(c, IRCC.CcEq, rc, v_const(c, 0, IRType.ItUsize), false);
    let freeh: *IRBlock = new_block(c);
    emit_cbr(c, deadc, freeh, done, done);
    use_block(c, freeh);
    let fr: *Sym = prelude_fn("__free");
    let fc: *IRIns = emit(c, IROp.IrCall);
    fc.callee = sym_symbol(fr);
    fc.args = push_vreg(fc.args, h);
    emit_br(c, done);
    use_block(c, done);
    finish_fn_c(c);
  }
  // __rc_wref(p) -> header: weak.from on a data pointer
  {
    let lf: *IRFn = rc_new_fn("rho__rc_wref");
    let c: *LCtx = rc_ctx(lf);
    lf.ret = null;
    let ps: *IRSlot = new_slot(c, 8, 8, "p");
    lf.params = push_islot(lf.params, ps);
    lf.param_types = push_type(lf.param_types, null);
    let p: *IRVreg = v_load(c, v_slotaddr(c, ps), IRType.ItPtr);
    let nullv: *IRVreg = v_const(c, 0, IRType.ItPtr); // before the branch: phi edges read it
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, p, nullv, false);
    let cont: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, cont, done);
    use_block(c, cont);
    let h: *IRVreg = v_addi(c, p, -24);
    let w: *IRVreg = v_load(c, v_addi(c, h, 8), IRType.ItUsize);
    let w2: *IRVreg = v_binop(c, IROp.IrAdd, w, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
    v_store(c, v_addi(c, h, 8), w2);
    emit_br(c, done);
    use_block(c, done);
    // phi: null path -> 0, cont path -> h
    let phi: *IRPhi = emit_phi_in(c, done, IRType.ItPtr);
    phi_add(phi, lf.entry, nullv);
    phi_add(phi, cont, h);
    emit_ret(c, phi.dst);
    g_ir_fns.push(lf);
  }
  // __rc_wget(h) -> data pointer or null when dead
  {
    let lf: *IRFn = rc_new_fn("rho__rc_wget");
    let c: *LCtx = rc_ctx(lf);
    let hs: *IRSlot = new_slot(c, 8, 8, "h");
    lf.params = push_islot(lf.params, hs);
    lf.param_types = push_type(lf.param_types, null);
    let h: *IRVreg = v_load(c, v_slotaddr(c, hs), IRType.ItPtr);
    let nullv: *IRVreg = v_const(c, 0, IRType.ItPtr); // before the branch: phi edges read it
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, h, nullv, false);
    let live: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, live, done);
    use_block(c, live);
    let rc: *IRVreg = v_load(c, h, IRType.ItUsize);
    let top: *IRVreg = v_binop(c, IROp.IrShr, rc, v_const(c, 63, IRType.ItUsize), IRType.ItUsize, false);
    let immortal: *IRVreg = v_cmp(c, IRCC.CcNe, top, v_const(c, 0, IRType.ItUsize), false);
    let alive2: *IRVreg = v_cmp(c, IRCC.CcNe, rc, v_const(c, 0, IRType.ItUsize), false);
    let alive: *IRVreg = v_binop(c, IROp.IrOr, immortal, alive2, IRType.ItU8, false);
    let yes: *IRBlock = new_block(c);
    emit_cbr(c, alive, yes, done, done);
    use_block(c, yes);
    let data: *IRVreg = v_addi(c, h, 24);
    emit_br(c, done);
    use_block(c, done);
    let phi: *IRPhi = emit_phi_in(c, done, IRType.ItPtr);
    phi_add(phi, lf.entry, nullv);
    phi_add(phi, live, nullv);
    phi_add(phi, yes, data);
    emit_ret(c, phi.dst);
    g_ir_fns.push(lf);
  }
}

// ---- structural equality glue ---------------------------------------------
// rho__eq$<t>(a, b) compares two enum/struct values field by field through a
// result slot (no phis): tags first for enums, then payload/field pairs.

fn eq_fn_for(t: *Type) -> string {
  if t == null || (t.kind != TypeKind.TyEnum && t.kind != TypeKind.TyStruct) {
    return "";
  }
  if g_eq_fns == null {
    g_eq_fns = tm2_new();
  }
  let found: string = tm2_get(g_eq_fns, t.mangled);
  if found != "" {
    return found;
  }
  let sym: string = cat3("rho__eq$", rho_sanitize(t.mangled), "");
  tm2_put(g_eq_fns, t.mangled, sym);
  let lf: *IRFn = rc_new_fn(sym);
  let c: *LCtx = rc_ctx(lf);
  let as_: *IRSlot = new_slot(c, 8, 8, "a");
  let bs: *IRSlot = new_slot(c, 8, 8, "b");
  lf.params = push_islot(lf.params, as_);
  lf.param_types = push_type(lf.param_types, null);
  lf.params = push_islot(lf.params, bs);
  lf.param_types = push_type(lf.param_types, null);
  let pa: *IRVreg = v_load(c, v_slotaddr(c, as_), IRType.ItPtr);
  let pb: *IRVreg = v_load(c, v_slotaddr(c, bs), IRType.ItPtr);
  let rs: *IRSlot = new_slot(c, 8, 8, "eq");
  v_store(c, v_slotaddr(c, rs), v_const(c, 1, IRType.ItU8));
  eq_walk(c, t, pa, pb, rs);
  emit_ret(c, v_load(c, v_slotaddr(c, rs), IRType.ItU8));
  finish_fn_c(c);
  return sym;
}

// AND one field/variant comparison into the result slot
fn eq_and(c: *LCtx, rs: *IRSlot, v: *IRVreg) {
  let cur: *IRVreg = v_load(c, v_slotaddr(c, rs), IRType.ItU8);
  let both: *IRVreg = v_binop(c, IROp.IrAnd, cur, v, IRType.ItU8, false);
  v_store(c, v_slotaddr(c, rs), both);
}

// compare a single non-aggregate field at pa/pb (same offset)
fn eq_field(c: *LCtx, ft: *Type, fa: *IRVreg, fb: *IRVreg, rs: *IRSlot) {
  if ft.kind == TypeKind.TyEnum || ft.kind == TypeKind.TyStruct {
    let fnn: string = eq_fn_for(ft);
    let call: *IRIns = emit(c, IROp.IrCall);
    call.callee = fnn;
    call.args = push_vreg(call.args, fa);
    call.args = push_vreg(call.args, fb);
    call.dst = new_vreg(c, IRType.ItU8);
    eq_and(c, rs, call.dst);
    return;
  }
  let irt: IRType = ir_type_of(ft);
  let va: *IRVreg = v_load(c, fa, irt);
  let vb: *IRVreg = v_load(c, fb, irt);
  let same: *IRVreg = v_cmp(c, IRCC.CcEq, va, vb, ir_is_float_t(irt));
  eq_and(c, rs, same);
}

fn eq_walk(c: *LCtx, t: *Type, pa: *IRVreg, pb: *IRVreg, rs: *IRSlot) {
  if t.kind == TypeKind.TyEnum {
    let d: *Decl = t.rec.decl;
    let tag_a: *IRVreg = v_load(c, pa, IRType.ItI32);
    // tags differ -> false
    let tag_b: *IRVreg = v_load(c, pb, IRType.ItI32);
    let same_tag: *IRVreg = v_cmp(c, IRCC.CcEq, tag_a, tag_b, false);
    let body: *IRBlock = new_block(c);
    let no: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, same_tag, body, no, done);
    use_block(c, no);
    v_store(c, v_slotaddr(c, rs), v_const(c, 0, IRType.ItU8));
    emit_br(c, done);
    use_block(c, body);
    // per variant: only its own fields, gated on the tag
    let mut vi: usize = 0;
    while vi < d.variants.n {
      let v: *VariantAst = d.variants.items[vi];
      let mut nf: usize = 0;
      if v.vkind == VarKind.VarTuple {
        nf = v.types.n;
      } else if v.vkind == VarKind.VarStruct {
        nf = v.fields.n;
      }
      if nf > 0 {
        let mine: *IRBlock = new_block(c);
        let next: *IRBlock = new_block(c);
        let is: *IRVreg = v_cmp(c, IRCC.CcEq, tag_a, v_const(c, v.disc as i64, IRType.ItI32), false);
        emit_cbr(c, is, mine, next, done);
        use_block(c, mine);
        let mut fi: usize = 0;
        while fi < nf {
          let ft: *Type = variant_field_type(t, vi as i32, fi as i32);
          eprint("[EQF ");
          eprint(t.mangled);
          eprint(" v=");
          eprint(itoa(vi as i64));
          eprint(" f=");
          eprint(itoa(fi as i64));
          eprint(" t=");
          if ft != null { eprint(ft.mangled); } else { eprint("null"); }
          eprint("\n");
          let off: i64 = variant_field_offset(t, vi as i32, fi as i32);
          eq_field(c, ft, v_addi(c, pa, off), v_addi(c, pb, off), rs);
          fi += 1;
        }
        emit_br(c, next);
        use_block(c, next);
      }
      vi += 1;
    }
    emit_br(c, done);
    use_block(c, done);
    return;
  }
  // struct: straight field walk
  let rec: *RecType = t.rec;
  let sd: *Decl = rec.decl;
  let mut i: usize = 0;
  while i < sd.fields.n {
    let ft: *Type = struct_field_type(rec, i);
    let off: i64 = struct_field_offset(rec, i);
    eq_field(c, ft, v_addi(c, pa, off), v_addi(c, pb, off), rs);
    i += 1;
  }
}

// lift a closure literal into a standalone fn + env snapshot layout;
// returns the code symbol, with the env drop glue name in envdrop_out
fn lift_closure(c: *LCtx, e: *Expr, envdrop_out: *Vec[string]) -> string {
  let ft: *Type = e.typed;
  let ret: *Type = ft.ret;
  let agg_ret: bool = ret != null && ty_is_aggregate(ret);
  let clo_id: i32 = g_closure_counter;
  g_closure_counter += 1;
  let sym_name: string = cat3(c.f.symbol, "__clo", cat3(itoa(clo_id as i64), "", ""));
  let lf: *IRFn = rc_new_fn(sym_name);
  lf.ret = ret;
  let cc: *LCtx = rc_ctx(lf);
  if agg_ret {
    lf.returns_aggregate = true;
    lf.out_slot = new_slot(cc, type_size(ret), type_align(ret), "out");
  }
  lf.entry = new_block(cc);
  use_block(cc, lf.entry);
  scope_push_l(cc);

  let mut i: usize = 0;
  while i < e.params.n {
    let pa: *Param = e.params.items[i];
    let pt: *Type = ft.params[i];
    let slot: *IRSlot = new_slot(cc, type_size(pt), type_align(pt), pa.name);
    lf.params = push_islot(lf.params, slot);
    lf.param_types = push_type(lf.param_types, pt);
    if ty_is_aggregate(pt) {
      let local: *IRSlot = new_slot(cc, type_size(pt), type_align(pt), pa.name);
      let src_addr: *IRVreg = v_slotaddr(cc, slot);
      let src: *IRVreg = v_load(cc, src_addr, IRType.ItPtr);
      let dst: *IRVreg = v_slotaddr(cc, local);
      let cp: *IRIns = emit(cc, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = src;
      cp.size = type_size(pt);
      lbind(cc, pa.name, local);
    } else {
      lbind(cc, pa.name, slot);
    }
    i += 1;
  }
  let env: *IRSlot = new_slot(cc, 8, 8, "env");
  lf.params = push_islot(lf.params, env);
  lf.param_types = push_type(lf.param_types, null);

  // captures materialize into plain slots from the env data pointer
  let mut off: i64 = 0;
  let mut ci: usize = 0;
  while ci < len(e.caps) {
    let cap: *Sym = e.caps[ci];
    let ct: *Type = cap.type;
    let al: i64 = type_align(ct);
    off = round_up_i64(off, al);
    let envp: *IRVreg = v_load(cc, v_slotaddr(cc, env), IRType.ItPtr);
    let srcaddr: *IRVreg = v_addi(cc, envp, off);
    let slot: *IRSlot = new_slot(cc, type_size(ct), type_align(ct), cap.name);
    let dst: *IRVreg = v_slotaddr(cc, slot);
    if ty_is_aggregate(ct) {
      let cp: *IRIns = emit(cc, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = srcaddr;
      cp.size = type_size(ct);
    } else {
      let v: *IRVreg = v_load(cc, srcaddr, ir_type_of(ct));
      v_store(cc, dst, v);
    }
    lbind(cc, cap.name, slot);
    off += type_size(ct);
    ci += 1;
  }

  let mut si: usize = 0;
  while si < e.items.n {
    lv_stmt(cc, e.items.items[si]);
    si += 1;
  }
  if lf.cur.term_op == 0 {
    run_defers(cc, null);
    emit_ret(cc, null);
  }
  scope_pop_l(cc);
  g_ir_fns.push(lf);

  // env drop glue: releases every captured value when the env object dies
  let envdrop: string = cat3("rho__envdrop$", itoa(clo_id as i64), "");
  let df: *IRFn = rc_new_fn(envdrop);
  let dc: *LCtx = rc_ctx(df);
  let das: *IRSlot = new_slot(dc, 8, 8, "addr");
  df.params = push_islot(df.params, das);
  df.param_types = push_type(df.param_types, null);
  let daddr: *IRVreg = v_load(dc, v_slotaddr(dc, das), IRType.ItPtr);
  let mut doff: i64 = 0;
  let mut di: usize = 0;
  while di < len(e.caps) {
    let cap: *Sym = e.caps[di];
    let ct: *Type = cap.type;
    let al: i64 = type_align(ct);
    doff = round_up_i64(doff, al);
    let cap_addr: *IRVreg = v_addi(dc, daddr, doff); // always: keeps vreg numbering
    let fnn: string = value_fn_for(ct, false);
    if fnn != "" {
      rc_call1(dc, fnn, cap_addr);
    }
    doff += type_size(ct);
    di += 1;
  }
  finish_fn_c(dc);
  envdrop_out.items[0] = envdrop;
  return sym_name;
}

// ------------------------------------------------------------- lvalues ----

fn compute_addr(c: *LCtx, e: *Expr) -> *IRVreg {
  if e.kind == ExprKind.ExStr {
    // string literal used in address context: materialize its slice temp
    return lv_expr(c, e);
  }
  if e.kind == ExprKind.ExName {
    let sym: *Sym = e.sym;
    let slot: *IRSlot = lookup_slot(c, e.sv);
    if slot != null {
      return v_slotaddr(c, slot);
    }
    if sym != null && sym.kind == SymKind.SyStatic {
      let i: *IRIns = emit(c, IROp.IrAddrc);
      i.dst = new_vreg(c, IRType.ItPtr);
      i.callee = sym_symbol(sym); // on demand: lower order is map order
      i.lit = -1;                 // marks global-address form
      return i.dst;
    }
    if sym != null && sym.kind == SymKind.SyConst {
      // constants have no storage; caller only hits this for aggregates
      panic_call(c, "internal: constant has no address");
      return v_const(c, 0, IRType.ItPtr);
    }
    panic_call(c, "internal: unbound name");
    return v_const(c, 0, IRType.ItPtr);
  }
  if e.kind == ExprKind.ExField {
    let bt: *Type = e.a.typed;
    // slice/string built-in fields: {buf, ptr, len}
    let mut value_t: *Type = bt;
    let mut through_ptr: bool = false;
    if value_t != null && value_t.kind == TypeKind.TyPtr {
      value_t = value_t.elem;
      through_ptr = true;
    }
    if value_t != null && (value_t.kind == TypeKind.TySlice || value_t.kind == TypeKind.TyStringK) {
      let mut off: i64 = 0;
      if streq(e.sv, "len") {
        off = 16;
      } else if streq(e.sv, "ptr") {
        off = 8;
      } else {
        panic_call(c, "internal: bad slice field");
        return v_const(c, 0, IRType.ItPtr);
      }
      if through_ptr {
        return v_addi(c, null_check(c, lv_expr(c, e.a)), off);
      }
      return v_addi(c, lv_expr(c, e.a), off);
    }
    if bt != null && bt.kind == TypeKind.TyPtr {
      let base: *IRVreg = null_check(c, lv_expr(c, e.a));
      return v_addi(c, base, struct_field_offset(bt.elem.rec, field_index_of(e, bt.elem.rec) as usize));
    }
    let base2: *IRVreg = compute_addr(c, e.a);
    return v_addi(c, base2, struct_field_offset(bt.rec, field_index_of(e, bt.rec) as usize));
  }
  if e.kind == ExprKind.ExIndex {
    let bt: *Type = e.a.typed;
    let idx: *IRVreg = lv_expr(c, e.b);
    let mut baseaddr: *IRVreg = null;
    let mut esize: i64 = type_size(bt.elem);
    if bt.kind == TypeKind.TyStringK {
      esize = 1;
    }
    if bt.kind == TypeKind.TyArray {
      baseaddr = compute_addr(c, e.a);
      bounds_check(c, idx, v_const(c, bt.len as i64, IRType.ItUsize));
    } else {
      // slice: {buf, ptr, len}
      let sliceaddr: *IRVreg = compute_addr(c, e.a);
      let len_v: *IRVreg = v_load(c, v_addi(c, sliceaddr, 16), IRType.ItUsize);
      bounds_check(c, idx, len_v);
      baseaddr = v_load(c, v_addi(c, sliceaddr, 8), IRType.ItPtr);
    }
    let esz: *IRVreg = v_const(c, esize, IRType.ItUsize);
    let mul: *IRIns = emit(c, IROp.IrMul);
    mul.dst = new_vreg(c, IRType.ItUsize);
    mul.a = idx;
    mul.b = esz;
    let add: *IRIns = emit(c, IROp.IrAdd);
    add.dst = new_vreg(c, IRType.ItPtr);
    add.a = baseaddr;
    add.b = mul.dst;
    return add.dst;
  }
  if e.kind == ExprKind.ExUn {
    // *ptr
    return null_check(c, lv_expr(c, e.a));
  }
  panic_call(c, "internal: not an lvalue");
  return v_const(c, 0, IRType.ItPtr);
}

fn field_index_of(e: *Expr, rec: *RecType) -> i32 {
  let d: *Decl = rec.decl;
  let mut i: usize = 0;
  while i < d.fields.n {
    let fa: *FieldAst = d.fields.items[i];
    if streq(fa.name, e.sv) {
      return i as i32;
    }
    i += 1;
  }
  return 0;
}
fn v_cast(c: *LCtx, src: *IRVreg, to: IRType) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, to);
  let i: *IRIns = emit(c, IROp.IrCast);
  i.dst = v;
  i.a = src;
  i.cast_from = src.ty;
  i.cast_to = to;
  // classify
  if ir_is_float_t(src.ty) && ir_is_float_t(to) {
    if src.ty == IRType.ItF32 && to == IRType.ItF64 {
      i.cast = IRCastKind.CastF32F64;
    } else {
      i.cast = IRCastKind.CastF64F32;
    }
  } else if ir_size_of(src.ty) == ir_size_of(to) &&
             ir_is_float_t(src.ty) && !ir_is_float_t(to) &&
             (to == IRType.ItU32 || to == IRType.ItU64) {
    i.cast = IRCastKind.CastReinterp; // exact bit move (f32_bits/f64_bits)
  } else if ir_is_float_t(src.ty) {
    i.cast = IRCastKind.CastF2i;
  } else if ir_is_float_t(to) {
    i.cast = IRCastKind.CastI2f;
  } else if ir_size_of(src.ty) > ir_size_of(to) {
    i.cast = IRCastKind.CastTrunc;
  } else if ir_size_of(src.ty) < ir_size_of(to) {
    if ty_is_signed_int(src.ty) {
      i.cast = IRCastKind.CastSext;
    } else {
      i.cast = IRCastKind.CastZext;
    }
  } else {
    i.cast = IRCastKind.CastBitcopy;
  }
  return v;
}

// ------------------------------------------------------------ expressions --

fn lv_expr(c: *LCtx, e: *Expr) -> *IRVreg {
  let t: *Type = e.typed;
  if e.kind == ExprKind.ExInt {
    return v_const(c, e.iv as i64, ir_type_of(t));
  }
  if e.kind == ExprKind.ExFloat {
    return fconst(c, e.fv, ir_type_of(t));
  }
  if e.kind == ExprKind.ExBool {
    let mut b: i64 = 0;
    if e.bv {
      b = 1;
    }
    return v_const(c, b, IRType.ItU8);
  }
  if e.kind == ExprKind.ExNull {
    return v_const(c, 0, IRType.ItPtr);
  }
  if e.kind == ExprKind.ExName {
    let sym: *Sym = e.sym;
    if sym != null && sym.kind == SymKind.SyConst {
      if sym.decl.ceval_ok && sym.decl.ceval_is_int {
        return v_const(c, sym.decl.ceval_i as i64, ir_type_of(t));
      }
      if sym.decl.ceval_ok && !sym.decl.ceval_is_int && t != null &&
         (t.kind == TypeKind.TyF32 || t.kind == TypeKind.TyF64) {
        return fconst(c, sym.decl.ceval_f, ir_type_of(t));
      }
      if t != null && ty_is_aggregate(t) {
        return compute_addr(c, e);
      }
      return v_const(c, 0, ir_type_of(t));
    }
    if e.fnval && sym != null &&
       (sym.kind == SymKind.SyFn || sym.kind == SymKind.SyExtern) {
      return closure_value_for_sym(c, sym);
    }
    if t != null && ty_is_aggregate(t) {
      return compute_addr(c, e);
    }
    let slot: *IRSlot = lookup_slot(c, e.sv);
    if slot == null {
      if sym != null && sym.kind == SymKind.SyStatic {
        let i: *IRIns = emit(c, IROp.IrAddrc);
        i.dst = new_vreg(c, IRType.ItPtr);
        i.callee = sym_symbol(sym);
        i.lit = -1;
        return v_load(c, i.dst, ir_type_of(t));
      }
      return v_const(c, 0, ir_type_of(t));
    }
    return v_load(c, v_slotaddr(c, slot), ir_type_of(t));
  }
  if e.kind == ExprKind.ExStr {
    // slice value: {lit(header), lit+24(bytes), len} — the literal carries
    // an immortal 24-byte rc header, so count traffic on it is a no-op
    let tmp: *IRSlot = new_slot(c, 24, 8, "strlit");
    let addr: *IRVreg = v_slotaddr(c, tmp);
    let lit: i32 = lit_bytes(c, e.sv);
    let ptrv: *IRVreg = new_vreg(c, IRType.ItPtr);
    let la: *IRIns = emit(c, IROp.IrLitaddr);
    la.dst = ptrv;
    la.lit = lit;
    let bytes: *IRVreg = v_addi(c, ptrv, 24);
    let a8: *IRVreg = v_addi(c, addr, 8);
    let a16: *IRVreg = v_addi(c, addr, 16);
    let lenv: *IRVreg = v_const(c, len(e.sv) as i64, IRType.ItUsize);
    let s1: *IRIns = emit(c, IROp.IrStore);
    s1.addr = addr;
    s1.a = ptrv;
    s1.size = 8;
    let s2: *IRIns = emit(c, IROp.IrStore);
    s2.addr = a8;
    s2.a = bytes;
    s2.size = 8;
    let s3: *IRIns = emit(c, IROp.IrStore);
    s3.addr = a16;
    s3.a = lenv;
    s3.size = 8;
    return addr;
  }
  if e.kind == ExprKind.ExUn {
    if e.unop == Tok.PStar {
      let p: *IRVreg = null_check(c, lv_expr(c, e.a));
      let pointee: *Type = e.typed;
      if pointee != null && ty_is_aggregate(pointee) {
        return p;
      }
      return v_load(c, p, ir_type_of(pointee));
    }
    let a: *IRVreg = lv_expr(c, e.a);
    let ty: IRType = ir_type_of(t);
    if e.unop == Tok.PBang {
      return v_cmp(c, IRCC.CcEq, a, v_const(c, 0, a.ty), false);
    }
    if e.unop == Tok.PTilde {
      return v_binop(c, IROp.IrXor, a, v_const(c, -1, a.ty), a.ty, false);
    }
    if e.unop == Tok.PMinus {
      if ir_is_float_t(a.ty) {
        let zero: *IRVreg = v_const(c, 0, a.ty);
        let i: *IRIns = emit(c, IROp.IrSub);
        i.dst = new_vreg(c, a.ty);
        i.a = zero;
        i.b = a;
        i.is_float = true;
        i.signed_ops = true;
        return i.dst;
      }
      let zero2: *IRVreg = v_const(c, 0, a.ty);
      return v_binop(c, IROp.IrSub, zero2, a, a.ty, true);
    }
    return v_const(c, 0, ty);
  }
  if e.kind == ExprKind.ExCast {
    let src_t: *Type = e.a.typed;
    if src_t.kind == TypeKind.TyEnum {
      let addr: *IRVreg = lv_expr(c, e.a); // aggregate: address
      let tag: *IRVreg = v_load(c, addr, IRType.ItI32);
      return v_cast(c, tag, ir_type_of(t));
    }
    let a: *IRVreg = lv_expr(c, e.a);
    return v_cast(c, a, ir_type_of(t));
  }
  if e.kind == ExprKind.ExBin {
    let op: Tok = e.binop;
    if op == Tok.PAndand || op == Tok.POror {
      let rhs: *IRBlock = new_block(c);
      let join: *IRBlock = new_block(c);
      let phi: *IRPhi = emit_phi_in(c, join, IRType.ItU8);
      let l: *IRVreg = lv_expr(c, e.a);
      let l_as_u8: *IRVreg = v_cast(c, l, IRType.ItU8); // dead but keeps vreg numbering
      // short-circuit consts must precede the branch: phi edges read them
      let sc_zero: *IRVreg = v_const(c, 0, IRType.ItU8);
      let sc_one: *IRVreg = v_const(c, 1, IRType.ItU8);
      // the phi's lhs edge is the block the cbr actually branches from; a
      // nested `||`/`&&` lhs ends in its own join block, not where we started
      let lhs_block: *IRBlock = c.f.cur;
      if op == Tok.PAndand {
        emit_cbr(c, l, rhs, join, join);
      } else {
        emit_cbr(c, l, join, rhs, join);
      }
      use_block(c, rhs);
      let r: *IRVreg = lv_expr(c, e.b);
      let r_as_u8: *IRVreg = v_cast(c, r, IRType.ItU8);
      let rhs_block: *IRBlock = c.f.cur;
      emit_br(c, join);
      use_block(c, join);
      if op == Tok.PAndand {
        phi_add(phi, lhs_block, sc_zero);
      } else {
        phi_add(phi, lhs_block, sc_one);
      }
      phi_add(phi, rhs_block, r_as_u8);
      return phi.dst;
    }
    let a: *IRVreg = lv_expr(c, e.a);
    let b: *IRVreg = lv_expr(c, e.b);
    let ty: IRType = ir_type_of(t);
    let flt: bool = ir_is_float_t(a.ty);
    if op == Tok.PPlus { return v_binop(c, IROp.IrAdd, a, b, a.ty, true); }
    if op == Tok.PMinus { return v_binop(c, IROp.IrSub, a, b, a.ty, true); }
    if op == Tok.PStar { return v_binop(c, IROp.IrMul, a, b, a.ty, flt); }
    if op == Tok.PSlash {
      let mut sgn: bool = flt;
      if ty_is_signed_int(a.ty) {
        sgn = true;
      }
      return v_binop(c, IROp.IrDiv, a, b, a.ty, sgn);
    }
    if op == Tok.PPercent { return v_binop(c, IROp.IrMod, a, b, a.ty, ty_is_signed_int(a.ty)); }
    if op == Tok.PAmp { return v_binop(c, IROp.IrAnd, a, b, a.ty, false); }
    if op == Tok.PPipe { return v_binop(c, IROp.IrOr, a, b, a.ty, false); }
    if op == Tok.PCaret { return v_binop(c, IROp.IrXor, a, b, a.ty, false); }
    if op == Tok.PShl { return v_binop(c, IROp.IrShl, a, b, a.ty, false); }
    if op == Tok.PShr { return v_binop(c, IROp.IrShr, a, b, a.ty, ty_is_signed_int(a.ty)); }
    if op == Tok.PEq || op == Tok.PNe {
      let mut want_eq: bool = false;
      if op == Tok.PEq {
        want_eq = true;
      }
      let lt: *Type = e.a.typed;
      if lt != null && lt.kind == TypeKind.TyStringK {
        return call_str_cmp(c, e, want_eq);
      }
      if lt != null && lt.kind == TypeKind.TyEnum {
        // a and b are aggregate addresses: compare through tags/glue
        let mut payloadful: bool = false;
        let d: *Decl = lt.rec.decl;
        let mut vi: usize = 0;
        while vi < d.variants.n {
          let v: *VariantAst = d.variants.items[vi];
          if v.vkind != VarKind.VarUnit {
            payloadful = true;
          }
          vi += 1;
        }
        if !payloadful {
          let ta: *IRVreg = v_load(c, a, IRType.ItI32);
          let tb: *IRVreg = v_load(c, b, IRType.ItI32);
          let mut cc: IRCC = IRCC.CcNe;
          if want_eq {
            cc = IRCC.CcEq;
          }
          return v_cmp(c, cc, ta, tb, false);
        }
        let fnn: string = eq_fn_for(lt);
        let call: *IRIns = emit(c, IROp.IrCall);
        call.callee = fnn;
        call.args = push_vreg(call.args, a);
        call.args = push_vreg(call.args, b);
        call.dst = new_vreg(c, IRType.ItU8);
        if want_eq {
          return call.dst;
        }
        return v_cmp(c, IRCC.CcEq, call.dst, v_const(c, 0, IRType.ItU8), false);
      }
      if want_eq {
        return v_cmp(c, IRCC.CcEq, a, b, flt);
      }
      return v_cmp(c, IRCC.CcNe, a, b, flt);
    }
    if op == Tok.PLt { return v_cmp(c, IRCC.CcLt, a, b, flt); }
    if op == Tok.PLe { return v_cmp(c, IRCC.CcLe, a, b, flt); }
    if op == Tok.PGt { return v_cmp(c, IRCC.CcGt, a, b, flt); }
    if op == Tok.PGe { return v_cmp(c, IRCC.CcGe, a, b, flt); }
    return v_const(c, 0, ty);
  }
  if e.kind == ExprKind.ExSlice {
    return lower_slice(c, e);
  }
  if e.kind == ExprKind.ExIndex {
    let t2: *Type = e.typed;
    if t2 != null && ty_is_aggregate(t2) {
      return compute_addr(c, e);
    }
    return v_load(c, compute_addr(c, e), ir_type_of(t2));
  }
  if e.kind == ExprKind.ExField {
    let t2: *Type = e.typed;
    let fsym: *Sym = e.sym;
    if e.fnval && fsym != null &&
       (fsym.kind == SymKind.SyFn || fsym.kind == SymKind.SyExtern) {
      return closure_value_for_sym(c, fsym);
    }
    // unit enum variant used as a value: materialize {tag, zeros}
    if e.sym != null && e.sym.kind == SymKind.SyVariant {
      let vs: *Sym = e.sym;
      let ed: *Decl = vs.decl;
      let disc: u64 = ed.variants.items[vs.variant_index].disc;
      let tmp: *IRSlot = new_slot(c, type_size(t2), type_align(t2), "enumval");
      let dest: *IRVreg = v_slotaddr(c, tmp);
      let tagv: *IRVreg = v_const(c, disc as i64, IRType.ItI32);
      let a4: *IRVreg = v_addi(c, dest, 4);
      let mut rest: i64 = type_size(t2) - 4;
      if rest < 0 {
        rest = 0;
      }
      let tag: *IRIns = emit(c, IROp.IrStore);
      tag.addr = dest;
      tag.a = tagv;
      tag.size = 4;
      if rest > 0 {
        let z: *IRIns = emit(c, IROp.IrZero);
        z.addr = a4;
        z.size = rest;
      }
      return dest;
    }
    if t2 != null && ty_is_aggregate(t2) {
      return compute_addr(c, e);
    }
    return v_load(c, compute_addr(c, e), ir_type_of(t2));
  }
  if e.kind == ExprKind.ExCall {
    if is_make_call(e) {
      return lower_make(c, e, null);
    }
    return compute_call_value(c, e);
  }
  if e.kind == ExprKind.ExNew {
    return lower_new(c, e);
  }
  if e.kind == ExprKind.ExClosure {
    let envdrop_box: *Vec[string] = new Vec[string] { items: make([]string, 1), n: 1 };
    let sym_name: string = lift_closure(c, e, envdrop_box);
    // env object: header + snapshot of every capture
    let mut esz: i64 = 0;
    let mut ci: usize = 0;
    while ci < len(e.caps) {
      let ct: *Type = e.caps[ci].type;
      let al: i64 = type_align(ct);
      esz = round_up_i64(esz, al) + type_size(ct);
      ci += 1;
    }
    let sz: *IRVreg = v_const(c, esz + 24, IRType.ItUsize);
    let obj: *IRVreg = call_prelude1(c, "__alloc", sz, IRType.ItPtr);
    let obj8: *IRVreg = v_addi(c, obj, 8);
    let obj16: *IRVreg = v_addi(c, obj, 16);
    let rc1: *IRVreg = v_const(c, 1, IRType.ItUsize);
    let rc: *IRIns = emit(c, IROp.IrStore);
    rc.addr = obj;
    rc.a = rc1;
    rc.size = 8;
    let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
    let wrc: *IRIns = emit(c, IROp.IrStore);
    wrc.addr = obj8;
    wrc.a = zero;
    wrc.size = 8;
    let mut dropv: *IRVreg = v_const(c, 0, IRType.ItPtr);
    if len(e.caps) > 0 {
      let ga: *IRIns = emit(c, IROp.IrAddrc);
      ga.dst = new_vreg(c, IRType.ItPtr);
      ga.callee = envdrop_box.items[0];
      ga.lit = -1;
      dropv = ga.dst;
    }
    let dr: *IRIns = emit(c, IROp.IrStore);
    dr.addr = obj16;
    dr.a = dropv;
    dr.size = 8;
    let mut off: i64 = 0;
    let mut si: usize = 0;
    while si < len(e.caps) {
      let cap: *Sym = e.caps[si];
      let ct: *Type = cap.type;
      let al: i64 = type_align(ct);
      off = round_up_i64(off, al);
      let daddr: *IRVreg = v_addi(c, obj, 24 + off);
      let srcaddr: *IRVreg = v_slotaddr(c, lookup_slot(c, cap.name));
      if ty_is_aggregate(ct) {
        let cp: *IRIns = emit(c, IROp.IrCopymem);
        cp.addr = daddr;
        cp.a = srcaddr;
        cp.size = type_size(ct);
      } else {
        let v: *IRVreg = v_load(c, srcaddr, ir_type_of(ct));
        v_store(c, daddr, v);
      }
      if ty_is_managed(ct) {
        retain_addr(c, ct, daddr); // the env owns its snapshot
      }
      off += type_size(ct);
      si += 1;
    }
    // the value: {code, env=data pointer}
    let la: *IRIns = emit(c, IROp.IrAddrc);
    la.dst = new_vreg(c, IRType.ItPtr);
    la.callee = sym_name;
    la.lit = -1;
    let envp: *IRVreg = v_addi(c, obj, 24);
    let tmp: *IRSlot = new_slot(c, 16, 8, "cloval");
    let addr: *IRVreg = v_slotaddr(c, tmp);
    let a8: *IRVreg = v_addi(c, addr, 8);
    let s1: *IRIns = emit(c, IROp.IrStore);
    s1.addr = addr;
    s1.a = la.dst;
    s1.size = 8;
    let s2: *IRIns = emit(c, IROp.IrStore);
    s2.addr = a8;
    s2.a = envp;
    s2.size = 8;
    return addr;
  }
  if e.kind == ExprKind.ExMake {
    if t != null && ty_is_aggregate(t) {
      return compute_addr(c, e);
    }
    return compute_call_value(c, e);
  }
  if e.kind == ExprKind.ExIf {
    if t == null || t.kind == TypeKind.TyVoid {
      // statement context: no value to merge
      let then_b: *IRBlock = new_block(c);
      let join: *IRBlock = new_block(c);
      let mut has_else: bool = false;
      if e.items.n > 1 || e.else_if != null {
        has_else = true;
      }
      let mut false_b: *IRBlock = join;
      if has_else {
        false_b = new_block(c);
      }
      let cond: *IRVreg = lv_expr(c, e.a);
      emit_cbr(c, cond, then_b, false_b, join);
      use_block(c, then_b);
      // each arm gets its own scope: a `let` inside an arm must release at
      // the arm's end, not at the enclosing loop's back edge
      scope_push_l(c);
      lv_stmts(c, e.items.items[0].stmts);
      run_defers(c, c.scope.parent);
      scope_pop_release(c);
      emit_br(c, join);
      if has_else {
        use_block(c, false_b);
        if e.else_if != null {
          lv_expr(c, e.else_if);
        } else {
          let els: *Stmt = e.items.items[1];
          scope_push_l(c);
          lv_stmts(c, els.stmts);
          run_defers(c, c.scope.parent);
          scope_pop_release(c);
        }
        emit_br(c, join);
      }
      use_block(c, join);
      return v_const(c, 0, IRType.ItU8);
    }
    let then_b2: *IRBlock = new_block(c);
    let join2: *IRBlock = new_block(c);
    let mut false_b2: *IRBlock = join2;
    if e.items.n > 1 || e.else_if != null {
      false_b2 = new_block(c);
    }
    let phi: *IRPhi = emit_phi_in(c, join2, ir_type_of(t));
    let cond2: *IRVreg = lv_expr(c, e.a);
    emit_cbr(c, cond2, then_b2, false_b2, join2);
    use_block(c, then_b2);
    let then_stmts: *Vec[*Stmt] = e.items.items[0].stmts;
    let tv: *IRVreg = block_value(c, then_stmts, t);
    if ty_is_managed(t) && !arm_value_owned(then_stmts) {
      retain_or_inc(c, t, tv);
    }
    let then_end: *IRBlock = c.f.cur;
    emit_br(c, join2);
    let mut ev: *IRVreg = null;
    let mut else_end: *IRBlock = null;
    if e.items.n > 1 {
      use_block(c, false_b2);
      if e.else_if != null {
        ev = lv_expr(c, e.else_if); // nested ifs normalize their own arms
      } else {
        let els2: *Stmt = e.items.items[1];
        let es: *Vec[*Stmt] = els2.stmts;
        ev = block_value(c, es, t);
        if ty_is_managed(t) && !arm_value_owned(es) {
          retain_or_inc(c, t, ev);
        }
      }
      else_end = c.f.cur;
      emit_br(c, join2);
      use_block(c, join2);
    } else {
      use_block(c, join2);
    }
    phi_add(phi, then_end, tv);
    if e.items.n > 1 {
      phi_add(phi, else_end, ev);
    }
    return phi.dst;
  }
  if e.kind == ExprKind.ExMatch {
    // chain of comparisons; arm values merge at a phi
    let join: *IRBlock = new_block(c);
    let phi: *IRPhi = emit_phi_in(c, join, ir_type_of(t));
    let scrut_t: *Type = e.a.typed;
    let scrut: *IRVreg = lv_expr(c, e.a);
    let mut disc: *IRVreg = null;
    if scrut_t.kind == TypeKind.TyEnum {
      disc = v_load(c, scrut, IRType.ItI32); // scrutinee addr (aggregate)
    }
    let n: usize = e.arms.n;
    let mut i: usize = 0;
    while i < n {
      let arm: *MatchArm = e.arms.items[i];
      let body: *IRBlock = new_block(c);
      let mut next: *IRBlock = join;
      if i + 1 < n {
        next = new_block(c);
      }
      if arm.pk == PatKind.PatWildcard {
        emit_br(c, body);
      } else if scrut_t.kind == TypeKind.TyEnum {
        let is: *IRVreg = v_cmp(c, IRCC.CcEq, disc, v_const(c, arm.disc as i64, IRType.ItI32), false);
        emit_cbr(c, is, body, next, join);
      } else {
        let is2: *IRVreg = v_cmp(c, IRCC.CcEq, scrut, v_const(c, arm.pat_int as i64, scrut.ty), false);
        emit_cbr(c, is2, body, next, join);
      }
      use_block(c, body);
      let bind_scope: bool = len(arm.bind_syms) > 0;
      if bind_scope {
        // payload bindings: slots copied out of the scrutinee's payload area
        scope_push_l(c);
        let mut bi: usize = 0;
        while bi < len(arm.bind_syms) {
          let bs: *Sym = arm.bind_syms[bi];
          if bs != null {
            let ft: *Type = bs.type;
            let mut fidx: i32 = bi as i32;
            if bi < len(arm.bind_fidx) {
              fidx = arm.bind_fidx[bi] as i32;
            }
            let off: i64 = variant_field_offset(scrut_t, arm.variant_index, fidx);
            let faddr: *IRVreg = v_addi(c, scrut, off);
            let slot: *IRSlot = new_slot(c, type_size(ft), type_align(ft), bs.name);
            lbind(c, bs.name, slot);
            let saddr: *IRVreg = v_slotaddr(c, slot);
            if ty_is_aggregate(ft) {
              let cp: *IRIns = emit(c, IROp.IrCopymem);
              cp.addr = saddr;
              cp.a = faddr;
              cp.size = type_size(ft);
            } else {
              v_store(c, saddr, v_load(c, faddr, ir_type_of(ft)));
            }
            if ty_is_managed(ft) {
              retain_addr(c, ft, saddr);
              own_slot(c, slot, ft);
            }
          }
          bi += 1;
        }
      }
      let mut val: *IRVreg = null;
      if arm.body.kind == ExprKind.ExBlock {
        scope_push_l(c);
        val = block_value(c, arm.body.items, t);
        run_defers(c, c.scope.parent);
        scope_pop_release(c);
      } else {
        val = lv_expr(c, arm.body);
      }
      if val == null {
        // a never-returning arm (panic call): the phi still needs an arg,
        // but control never reaches the join from here
        val = v_const(c, 0, ir_type_of(t));
      }
      if t != null && ty_is_managed(t) && !expr_owned(arm.body) {
        retain_or_inc(c, t, val);
      }
      if bind_scope {
        scope_pop_release(c);
      }
      emit_br(c, join);
      phi_add(phi, c.f.cur, val);
      if i + 1 < n {
        use_block(c, next);
      }
      i += 1;
    }
    use_block(c, join);
    return phi.dst;
  }
  if e.kind == ExprKind.ExQmark {
    // `expr?` — on failure, return the whole value unchanged (it already
    // carries the failing tag and payload); on success, yield the payload
    let et: *Type = e.a.typed;
    let val: *IRVreg = lv_expr(c, e.a);
    let tag: *IRVreg = v_load(c, val, IRType.ItI32);
    let okv: *VariantAst = et.rec.decl.variants.items[e.q_ok];
    let is_ok: *IRVreg = v_cmp(c, IRCC.CcEq, tag, v_const(c, okv.disc as i64, IRType.ItI32), false);
    let cont: *IRBlock = new_block(c);
    let prop: *IRBlock = new_block(c);
    emit_cbr(c, is_ok, cont, prop, cont);
    use_block(c, prop);
    run_defers(c, null);
    let dst: *IRVreg = ret_dest(c);
    let cp: *IRIns = emit(c, IROp.IrCopymem);
    cp.addr = dst;
    cp.a = val;
    cp.size = type_size(et);
    if ty_is_managed(et) && !expr_owned(e.a) {
      retain_addr(c, et, dst);
    }
    release_scopes_to(c, null);
    emit_ret(c, null);
    let dead: *IRBlock = new_block(c);
    use_block(c, dead);
    emit_br(c, cont); // unreachable; keeps the CFG well-formed
    use_block(c, cont);
    if ty_is_managed(et) && expr_owned(e.a) {
      release_addr(c, et, val);
    }
    let pt: *Type = e.typed;
    let off: i64 = variant_field_offset(et, e.q_ok, 0);
    if pt != null && ty_is_aggregate(pt) {
      return v_addi(c, val, off);
    }
    return v_load(c, v_addi(c, val, off), ir_type_of(pt));
  }
  if t != null && ty_is_aggregate(t) {
    return compute_addr(c, e);
  }
  panic_call(c, "internal: unlowerable expression");
  return v_const(c, 0, IRType.ItPtr);
}

// ------------------------------------------------------------ calls --------

fn is_make_call(e: *Expr) -> bool {
  return e.kind == ExprKind.ExCall && e.a.kind == ExprKind.ExName &&
         streq(e.a.sv, "make") && e.typed != null &&
         e.typed.kind == TypeKind.TySlice;
}

fn method_receiver(callee: *Expr) -> *Expr {
  if callee.kind != ExprKind.ExField {
    return null;
  }
  let bt: *Type = callee.a.typed;
  let csym: *Sym = callee.sym;
  if bt == null || bt.kind == TypeKind.TyModule || csym == null || csym.decl == null {
    return null;
  }
  if csym.decl.is_method {
    return callee.a;
  }
  return null;
}

fn is_variant_ctor(e: *Expr) -> bool {
  return e.kind == ExprKind.ExCall && e.a.kind == ExprKind.ExField &&
         e.a.sym != null && e.a.sym.kind == SymKind.SyVariant;
}

// make([]T, n): allocate len*esize + header, init slice {buf, ptr, len}
fn lower_make(c: *LCtx, e: *Expr, dest_in: *IRVreg) -> *IRVreg {
  let slice_t: *Type = e.typed;
  let esize: i64 = type_size(slice_t.elem);
  let n: *IRVreg = lv_expr(c, e.args.items[1]);
  let esz: *IRVreg = v_const(c, esize, IRType.ItUsize);
  let hdr: *IRVreg = v_const(c, 24, IRType.ItUsize);
  let mul: *IRIns = emit(c, IROp.IrMul);
  mul.dst = new_vreg(c, IRType.ItUsize);
  mul.a = n;
  mul.b = esz;
  let add: *IRIns = emit(c, IROp.IrAdd);
  add.dst = new_vreg(c, IRType.ItUsize);
  add.a = mul.dst;
  add.b = hdr;
  let obj: *IRVreg = call_prelude1(c, "__alloc", add.dst, IRType.ItPtr);
  // header: {rc=1, wrc=0, drop=null}
  let obj8: *IRVreg = v_addi(c, obj, 8);
  let obj16: *IRVreg = v_addi(c, obj, 16);
  let obj24: *IRVreg = v_addi(c, obj, 24);
  let rc1: *IRVreg = v_const(c, 1, IRType.ItUsize);
  let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
  let rc: *IRIns = emit(c, IROp.IrStore);
  rc.addr = obj;
  rc.a = rc1;
  rc.size = 8;
  let wrc: *IRIns = emit(c, IROp.IrStore);
  wrc.addr = obj8;
  wrc.a = zero;
  wrc.size = 8;
  let drop0: *IRVreg = v_const(c, 0, IRType.ItPtr); // operands before emit: see landmine #1
  let dr: *IRIns = emit(c, IROp.IrStore);
  dr.addr = obj16;
  dr.a = drop0;
  dr.size = 8;
  // slice {buf=obj, ptr=obj+24, len=n}
  let mut dest: *IRVreg = dest_in;
  if dest == null {
    let tmp: *IRSlot = new_slot(c, 24, 8, "slice");
    dest = v_slotaddr(c, tmp);
  }
  let d8: *IRVreg = v_addi(c, dest, 8);
  let d16: *IRVreg = v_addi(c, dest, 16);
  let s1: *IRIns = emit(c, IROp.IrStore);
  s1.addr = dest;
  s1.a = obj;
  s1.size = 8;
  let s2: *IRIns = emit(c, IROp.IrStore);
  s2.addr = d8;
  s2.a = obj24;
  s2.size = 8;
  let s3: *IRIns = emit(c, IROp.IrStore);
  s3.addr = d16;
  s3.a = n;
  s3.size = 8;
  return dest;
}

// new T { fields }: allocate, header, init fields, return the pointer
fn lower_new(c: *LCtx, e: *Expr) -> *IRVreg {
  let ptr_t: *Type = e.typed;
  let struct_t: *Type = ptr_t.elem;
  let size: i64 = type_size(struct_t);
  let obj: *IRVreg = call_prelude1(c, "__alloc", v_const(c, size + 24, IRType.ItUsize), IRType.ItPtr);
  let obj8: *IRVreg = v_addi(c, obj, 8);
  let obj16: *IRVreg = v_addi(c, obj, 16);
  let rc1: *IRVreg = v_const(c, 1, IRType.ItUsize);
  let rc: *IRIns = emit(c, IROp.IrStore);
  rc.addr = obj;
  rc.a = rc1;
  rc.size = 8;
  let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
  let wrc: *IRIns = emit(c, IROp.IrStore);
  wrc.addr = obj8;
  wrc.a = zero;
  wrc.size = 8;
  let mut dropv: *IRVreg = v_const(c, 0, IRType.ItPtr);
  let glue: string = value_fn_for(struct_t, false);
  if glue != "" {
    let ga: *IRIns = emit(c, IROp.IrAddrc);
    ga.dst = new_vreg(c, IRType.ItPtr);
    ga.callee = glue;
    ga.lit = -1;
    dropv = ga.dst;
  }
  let dr: *IRIns = emit(c, IROp.IrStore);
  dr.addr = obj16;
  dr.a = dropv;
  dr.size = 8;
  // the returned reference points at the DATA, 24 bytes past the header
  let data: *IRVreg = v_addi(c, obj, 24);
  let rec: *RecType = struct_t.rec;
  let sd: *Decl = rec.decl;
  let mut i: usize = 0;
  while i < e.items.n {
    let fa: *FieldAst = new FieldAst { name: e.items.items[i].name, ty: null, file: "", line: 0, col: 0 };
    let init: *Expr = e.args.items[i];
    let mut j: usize = 0;
    while j < sd.fields.n {
      if streq(sd.fields.items[j].name, fa.name) {
        let off: i64 = struct_field_offset(rec, j);
        let ft: *Type = struct_field_type(rec, j);
        let faddr: *IRVreg = v_addi(c, data, off);
        if ty_is_aggregate(ft) {
          lv_agg(c, init, faddr);
          if !expr_owned(init) {
            retain_addr(c, ft, faddr);
          }
        } else {
          let v: *IRVreg = lv_expr(c, init);
          v_store(c, faddr, v);
          // the field owns a reference: borrowed inits hand it a +1; owned
          // producers transfer their single count
          if ty_is_managed(ft) && !expr_owned(init) {
            rc_inc_v(c, v);
          }
        }
        j = sd.fields.n; // break
      } else {
        j += 1;
      }
    }
    i += 1;
  }
  return data;
}

// enum variant construction: write {tag, payload fields} into dest (fresh
// temp when dest is NULL); returns the value's address
fn lower_enum_ctor(c: *LCtx, e: *Expr, dest_in: *IRVreg) -> *IRVreg {
  let vs: *Sym = e.a.sym;
  let et: *Type = e.typed;
  let v: *VariantAst = vs.decl.variants.items[vs.variant_index];
  let mut dest: *IRVreg = dest_in;
  if dest == null {
    let tmp: *IRSlot = new_slot(c, type_size(et), type_align(et), "enumval");
    dest = v_slotaddr(c, tmp);
  }
  let tagv: *IRVreg = v_const(c, v.disc as i64, IRType.ItI32);
  let tag: *IRIns = emit(c, IROp.IrStore);
  tag.addr = dest;
  tag.a = tagv;
  tag.size = 4;
  let size: i64 = type_size(et);
  if size > 4 {
    let rest: *IRVreg = v_addi(c, dest, 4);
    let z: *IRIns = emit(c, IROp.IrZero);
    z.addr = rest;
    z.size = size - 4;
  }
  let mut nfields: usize = 0;
  if v.vkind == VarKind.VarTuple {
    nfields = v.types.n;
  } else if v.vkind == VarKind.VarStruct {
    nfields = v.fields.n;
  }
  let mut i: usize = 0;
  while i < e.args.n && i < nfields {
    let arg: *Expr = e.args.items[i];
    let mut fidx: i32 = i as i32;
    if v.vkind == VarKind.VarStruct {
      let mut nm: string = "";
      if i < e.arg_names.n {
        nm = e.arg_names.items[i];
      }
      fidx = -1;
      let mut j: usize = 0;
      while j < v.fields.n {
        if nm != "" && streq(v.fields.items[j].name, nm) {
          fidx = j as i32;
          j = v.fields.n; // break
        } else {
          j += 1;
        }
      }
      if fidx < 0 {
        i += 1;
        continue;
      }
    }
    let off: i64 = variant_field_offset(et, vs.variant_index, fidx);
    let ft: *Type = arg.typed;
    let faddr: *IRVreg = v_addi(c, dest, off);
    if ft != null && ty_is_aggregate(ft) {
      lv_agg(c, arg, faddr);
      if !expr_owned(arg) {
        retain_addr(c, ft, faddr);
      }
    } else {
      let pv: *IRVreg = lv_expr(c, arg);
      v_store(c, faddr, pv);
      if ft != null && ty_is_managed(ft) && !expr_owned(arg) {
        rc_inc_v(c, pv);
      }
    }
    i += 1;
  }
  return dest;
}

fn build_call(c: *LCtx, fn_: *Sym, receiver: *Expr, args_exprs: *Vec[*Expr], out: *IRVreg, scalar_dst: *Vec[*IRVreg]) {
  // args: vregs for scalars, addresses for aggregates; the method receiver,
  // when present, is argument 0
  let mut call_args: []*IRVreg = make([]*IRVreg, 0);
  let mut owned_args: []*Expr = make([]*Expr, 0);  // owned rvalues needing a post-call release
  let mut owned_slots: []usize = make([]usize, 0); // index of each owned value inside call_args
  let ret: *Type = fn_.type.ret;
  let agg_ret: bool = ret != null && ty_is_aggregate(ret);
  if agg_ret {
    call_args = push_vreg(call_args, out);
  }
  let mut param_index: usize = 0;
  if receiver != null {
    let self_t: *Type = fn_.type.params[0];
    call_args = push_vreg(call_args, lv_expr(c, receiver));
    if ty_is_managed(self_t) && expr_owned(receiver) {
      owned_args = push_expr(owned_args, receiver);
      owned_slots = push_usize(owned_slots, len(call_args) - 1);
    }
    param_index = 1;
  }
  let mut i: usize = 0;
  while i < args_exprs.n {
    let arg: *Expr = args_exprs.items[i];
    let mut pt: *Type = arg.typed;
    if param_index + i < len(fn_.type.params) {
      pt = fn_.type.params[param_index + i];
    }
    call_args = push_vreg(call_args, lv_expr(c, arg)); // aggregate rvalue = address of temp
    if pt != null && ty_is_managed(pt) && expr_owned(arg) {
      owned_args = push_expr(owned_args, arg);
      owned_slots = push_usize(owned_slots, len(call_args) - 1);
    }
    i += 1;
  }
  let call: *IRIns = emit(c, IROp.IrCall);
  call.callee = sym_symbol(fn_);
  call.args = call_args;
  if ret != null && !agg_ret && ret.kind != TypeKind.TyVoid {
    call.dst = new_vreg(c, ir_type_of(ret));
  }
  // owned arguments handed their +1 to the callee's param copies
  let mut oi: usize = 0;
  while oi < len(owned_args) {
    let arg: *Expr = owned_args[oi];
    let at: *Type = arg.typed;
    let pv: *IRVreg = call_args[owned_slots[oi]];
    if ty_is_aggregate(at) {
      release_addr(c, at, pv);
    } else {
      rc_dec_v(c, pv);
    }
    oi += 1;
  }
  scalar_dst.items[0] = call.dst;
}

fn push_expr(items: []*Expr, v: *Expr) -> []*Expr {
  let out: []*Expr = make([]*Expr, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn push_usize(items: []usize, v: usize) -> []usize {
  let out: []usize = make([]usize, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn compute_call_value(c: *LCtx, e: *Expr) -> *IRVreg {
  // builtins
  if e.a.kind == ExprKind.ExName && streq(e.a.sv, "len") {
    let arg: *Expr = e.args.items[0];
    let at: *Type = arg.typed;
    if at.kind == TypeKind.TyArray {
      return v_const(c, at.len as i64, IRType.ItUsize);
    }
    let addr: *IRVreg = lv_expr(c, arg); // slice/string aggregate address
    return v_load(c, v_addi(c, addr, 16), IRType.ItUsize);
  }
  // weak.from(p) -> __rc_wref(p): bumps wrc, returns the header handle
  if e.a.kind == ExprKind.ExField && e.a.a.kind == ExprKind.ExName &&
     streq(e.a.a.sv, "weak") && streq(e.a.sv, "from") {
    let p: *IRVreg = lv_expr(c, e.args.items[0]);
    let call: *IRIns = emit(c, IROp.IrCall);
    call.callee = "rho__rc_wref";
    call.args = push_vreg(call.args, p);
    call.dst = new_vreg(c, IRType.ItPtr);
    return call.dst;
  }
  // w.get() -> __rc_wget(w): data pointer or null when the object died
  if e.a.kind == ExprKind.ExField && streq(e.a.sv, "get") &&
     e.a.a.typed != null && e.a.a.typed.kind == TypeKind.TyWeak {
    let w: *IRVreg = lv_expr(c, e.a.a);
    let call: *IRIns = emit(c, IROp.IrCall);
    call.callee = "rho__rc_wget";
    call.args = push_vreg(call.args, w);
    call.dst = new_vreg(c, IRType.ItPtr);
    return call.dst;
  }
  // intrinsics.* — raw-memory kernel (spec §10)
  if e.a.kind == ExprKind.ExField && e.a.a.kind == ExprKind.ExName &&
     streq(e.a.a.sv, "intrinsics") {
    let name: string = e.a.sv;
    if streq(name, "load_u8") || streq(name, "load_u32") ||
       streq(name, "load_u64") || streq(name, "load_i64") {
      let mut it: IRType = IRType.ItI64;
      if streq(name, "load_u8") {
        it = IRType.ItU8;
      } else if streq(name, "load_u32") {
        it = IRType.ItU32;
      } else if streq(name, "load_u64") {
        it = IRType.ItU64;
      }
      let p: *IRVreg = lv_expr(c, e.args.items[0]);
      return v_load(c, p, it);
    }
    if streq(name, "store_u8") || streq(name, "store_u32") ||
       streq(name, "store_u64") || streq(name, "store_i64") {
      let p: *IRVreg = lv_expr(c, e.args.items[0]);
      let v: *IRVreg = lv_expr(c, e.args.items[1]);
      v_store(c, p, v);
      return v_const(c, 0, IRType.ItU8);
    }
    if streq(name, "f64_bits") || streq(name, "f32_bits") {
      let v: *IRVreg = lv_expr(c, e.args.items[0]);
      if streq(name, "f64_bits") {
        return v_cast(c, v, IRType.ItU64);
      }
      return v_cast(c, v, IRType.ItU32);
    }
    if streq(name, "memcpy") {
      let dst: *IRVreg = lv_expr(c, e.args.items[0]);
      let src: *IRVreg = lv_expr(c, e.args.items[1]);
      let cp: *IRIns = emit(c, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = src;
      cp.b = lv_expr(c, e.args.items[2]); // runtime size
      cp.size = -1;
      return v_const(c, 0, IRType.ItU8);
    }
    if streq(name, "slice_string") {
      let base: *IRVreg = lv_expr(c, e.args.items[0]); // []u8 aggregate address
      let len_v: *IRVreg = v_load(c, v_addi(c, base, 16), IRType.ItUsize);
      let ptr: *IRVreg = v_load(c, v_addi(c, base, 8), IRType.ItPtr);
      // obj = __alloc(len + 24): header at obj, data at obj+24 — the same
      // layout make() produces; buf fields hold the header
      let total: *IRVreg = v_binop(c, IROp.IrAdd, len_v, v_const(c, 24, IRType.ItUsize), IRType.ItUsize, false);
      let obj: *IRVreg = call_prelude1(c, "__alloc", total, IRType.ItPtr);
      // header: {rc=1, wrc=0, drop=null}
      let obj8: *IRVreg = v_addi(c, obj, 8);
      let obj16: *IRVreg = v_addi(c, obj, 16);
      let obj24: *IRVreg = v_addi(c, obj, 24);
      let rc1: *IRVreg = v_const(c, 1, IRType.ItUsize);
      let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
      let rc: *IRIns = emit(c, IROp.IrStore);
      rc.addr = obj;
      rc.a = rc1;
      rc.size = 8;
      let wrc: *IRIns = emit(c, IROp.IrStore);
      wrc.addr = obj8;
      wrc.a = zero;
      wrc.size = 8;
      let drop0: *IRVreg = v_const(c, 0, IRType.ItPtr); // operands before emit: landmine #1
      let dr: *IRIns = emit(c, IROp.IrStore);
      dr.addr = obj16;
      dr.a = drop0;
      dr.size = 8;
      let cp: *IRIns = emit(c, IROp.IrCopymem);
      cp.addr = obj24;
      cp.a = ptr;
      cp.b = len_v; // runtime byte count
      cp.size = -1;
      // build {buf=obj (header), ptr=obj+24 (data), len}
      let tmp: *IRSlot = new_slot(c, 24, 8, "strval");
      let dest: *IRVreg = v_slotaddr(c, tmp);
      let d8: *IRVreg = v_addi(c, dest, 8);
      let d16: *IRVreg = v_addi(c, dest, 16);
      let s1: *IRIns = emit(c, IROp.IrStore);
      s1.addr = dest;
      s1.a = obj;
      s1.size = 8;
      let s2: *IRIns = emit(c, IROp.IrStore);
      s2.addr = d8;
      s2.a = obj24;
      s2.size = 8;
      let s3: *IRIns = emit(c, IROp.IrStore);
      s3.addr = d16;
      s3.a = len_v;
      s3.size = 8;
      return dest;
    }
  }
  if is_variant_ctor(e) {
    let et: *Type = e.typed;
    let tmp: *IRSlot = new_slot(c, type_size(et), type_align(et), "enumval");
    return lower_enum_ctor(c, e, v_slotaddr(c, tmp));
  }
  // closure-value call: load {code, env} and call code(args..., env)
  let callee_t: *Type = e.a.typed;
  let csym: *Sym = e.a.sym;
  let mut direct: bool = false;
  if csym != null {
    if csym.kind == SymKind.SyFn || csym.kind == SymKind.SyExtern ||
       csym.kind == SymKind.SyVariant {
      direct = true;
    }
  }
  if callee_t != null && callee_t.kind == TypeKind.TyFn && !direct {
    let val: *IRVreg = lv_expr(c, e.a); // 16-byte value address
    let code: *IRVreg = v_load(c, val, IRType.ItPtr);
    let env: *IRVreg = v_load(c, v_addi(c, val, 8), IRType.ItPtr);
    let ft: *Type = callee_t;
    let ret: *Type = ft.ret;
    let agg: bool = ret != null && ty_is_aggregate(ret);
    let mut args: []*IRVreg = make([]*IRVreg, 0);
    let mut owned_args: []*Expr = make([]*Expr, 0);
    let mut owned_slots: []usize = make([]usize, 0);
    let mut out: *IRVreg = null;
    if agg {
      let tmp: *IRSlot = new_slot(c, type_size(ret), type_align(ret), "out");
      out = v_slotaddr(c, tmp);
      args = push_vreg(args, out);
    }
    let mut i: usize = 0;
    while i < e.args.n && i < len(ft.params) {
      let arg: *Expr = e.args.items[i];
      let pt: *Type = ft.params[i];
      args = push_vreg(args, lv_expr(c, arg));
      if pt != null && ty_is_managed(pt) && expr_owned(arg) {
        owned_args = push_expr(owned_args, arg);
        owned_slots = push_usize(owned_slots, len(args) - 1);
      }
      i += 1;
    }
    args = push_vreg(args, env);
    let call: *IRIns = emit(c, IROp.IrCall);
    call.callee_vreg = code;
    call.args = args;
    // owned arguments handed their +1 to the callee's param copies
    let mut oi: usize = 0;
    while oi < len(owned_args) {
      let arg: *Expr = owned_args[oi];
      let at: *Type = arg.typed;
      let pv: *IRVreg = args[owned_slots[oi]];
      if ty_is_aggregate(at) {
        release_addr(c, at, pv);
      } else {
        rc_dec_v(c, pv);
      }
      oi += 1;
    }
    if agg {
      return out;
    }
    if ret != null && ret.kind != TypeKind.TyVoid {
      call.dst = new_vreg(c, ir_type_of(ret));
      return call.dst;
    }
    return v_const(c, 0, IRType.ItPtr);
  }
  // normal call: callee sym stashed by the checker
  let fn_: *Sym = e.a.sym;
  if fn_ == null {
    panic_call(c, "internal: unresolved callee");
    return v_const(c, 0, IRType.ItPtr);
  }
  let ret: *Type = fn_.type.ret;
  if ret != null && ty_is_aggregate(ret) {
    let tmp: *IRSlot = new_slot(c, type_size(ret), type_align(ret), "ret");
    let out: *IRVreg = v_slotaddr(c, tmp);
    let dst_box: *Vec[*IRVreg] = new Vec[*IRVreg] { items: make([]*IRVreg, 1), n: 1 };
    build_call(c, fn_, method_receiver(e.a), e.args, out, dst_box);
    return out; // value address
  }
  let dst_box2: *Vec[*IRVreg] = new Vec[*IRVreg] { items: make([]*IRVreg, 1), n: 1 };
  build_call(c, fn_, method_receiver(e.a), e.args, null, dst_box2);
  return dst_box2.items[0];
}

// ------------------------------------------------------------ aggregates ---

// write aggregate value `e` into dest (address vreg)
fn lv_agg(c: *LCtx, e: *Expr, dest: *IRVreg) {
  let t: *Type = e.typed;
  if e.kind == ExprKind.ExMake {
    lower_make(c, e, dest);
    return;
  }
  if e.kind == ExprKind.ExStr {
    let addr: *IRVreg = lv_expr(c, e); // lv_expr materializes into a temp
    let cp: *IRIns = emit(c, IROp.IrCopymem);
    cp.addr = dest;
    cp.a = addr;
    cp.size = 24;
    return;
  }
  if e.kind == ExprKind.ExCall {
    if is_make_call(e) {
      lower_make(c, e, dest);
      return;
    }
    if is_variant_ctor(e) {
      lower_enum_ctor(c, e, dest);
      return;
    }
    let fn_: *Sym = e.a.sym;
    if fn_ != null && fn_.type.ret != null && ty_is_aggregate(fn_.type.ret) {
      // call straight into dest
      let mut call_args: []*IRVreg = make([]*IRVreg, 0);
      call_args = push_vreg(call_args, dest);
      let recv: *Expr = method_receiver(e.a);
      let mut pi: usize = 0;
      if recv != null {
        call_args = push_vreg(call_args, lv_expr(c, recv));
        pi = 1;
      }
      let mut i: usize = 0;
      while i < e.args.n {
        call_args = push_vreg(call_args, lv_expr(c, e.args.items[i]));
        i += 1;
      }
      let call: *IRIns = emit(c, IROp.IrCall);
      call.callee = sym_symbol(fn_);
      call.args = call_args;
      return;
    }
    let src: *IRVreg = lv_expr(c, e);
    let cp: *IRIns = emit(c, IROp.IrCopymem);
    cp.addr = dest;
    cp.a = src;
    cp.size = type_size(t);
    return;
  }
  if e.kind == ExprKind.ExIf || e.kind == ExprKind.ExMatch {
    panic_call(c, "internal: aggregate-valued if/match arrives in 0.0.5");
    return;
  }
  // default: aggregates evaluate to addresses
  let src2: *IRVreg = lv_expr(c, e);
  let cp2: *IRIns = emit(c, IROp.IrCopymem);
  cp2.addr = dest;
  cp2.a = src2;
  cp2.size = type_size(t);
}

// block statements with a trailing value; returns value vreg (scalars) or
// address (aggregates); NULL when the block produces nothing
fn block_value(c: *LCtx, stmts: *Vec[*Stmt], t: *Type) -> *IRVreg {
  scope_push_l(c);
  let mut tail: *IRVreg = null;
  let mut i: usize = 0;
  while i < stmts.n {
    let s: *Stmt = stmts.items[i];
    lv_stmt(c, s);
    if i + 1 == stmts.n && s.kind == StmtKind.StExpr && s.tail {
      tail = lv_expr(c, s.a);
    }
    i += 1;
  }
  scope_pop_release(c);
  return tail;
}

// ------------------------------------------------------------ statements ---

fn lv_expr_discard(c: *LCtx, e: *Expr) {
  let t: *Type = e.typed;
  if t != null && ty_is_managed(t) && expr_owned(e) {
    let v: *IRVreg = lv_expr(c, e);
    if ty_is_aggregate(t) {
      release_addr(c, t, v);
    } else {
      rc_dec_v(c, v);
    }
    return;
  }
  lv_expr(c, e);
}

fn lv_stmt(c: *LCtx, s: *Stmt) {
  if s.kind == StmtKind.StLet {
    let t: *Type = s.a.typed;
    let slot: *IRSlot = new_slot(c, type_size(t), type_align(t), s.name);
    lbind(c, s.name, slot);
    let addr: *IRVreg = v_slotaddr(c, slot);
    if ty_is_aggregate(t) {
      lv_agg(c, s.a, addr);
    } else {
      let v: *IRVreg = lv_expr(c, s.a);
      v_store(c, addr, v);
    }
    if ty_is_managed(t) {
      if !expr_owned(s.a) {
        retain_addr(c, t, addr);
      }
      own_slot(c, slot, t);
    }
    return;
  }
  if s.kind == StmtKind.StAssign {
    let t: *Type = s.a.typed;
    let addr: *IRVreg = compute_addr(c, s.a);
    if s.assign_op == Tok.PAssign {
      if ty_is_managed(t) {
        // save the old value before the store overwrites it
        let old: *IRSlot = new_slot(c, type_size(t), type_align(t), "oldval");
        let olda: *IRVreg = v_slotaddr(c, old);
        if ty_is_aggregate(t) {
          let cp: *IRIns = emit(c, IROp.IrCopymem);
          cp.addr = olda;
          cp.a = addr;
          cp.size = type_size(t);
        } else {
          v_store(c, olda, v_load(c, addr, ir_type_of(t)));
        }
        if ty_is_aggregate(t) {
          lv_agg(c, s.b, addr);
          if !expr_owned(s.b) {
            retain_addr(c, t, addr);
          }
        } else {
          let v: *IRVreg = lv_expr(c, s.b);
          v_store(c, addr, v);
          if !expr_owned(s.b) {
            rc_inc_v(c, v);
          }
        }
        release_addr(c, t, olda);
        return;
      }
      if ty_is_aggregate(t) {
        lv_agg(c, s.b, addr);
      } else {
        let v2: *IRVreg = lv_expr(c, s.b);
        v_store(c, addr, v2);
      }
      return;
    }
    let vt: IRType = ir_type_of(t);
    let cur: *IRVreg = v_load(c, addr, vt);
    let rhs: *IRVreg = lv_expr(c, s.b);
    let mut res: *IRVreg = cur;
    let flt: bool = ir_is_float_t(vt);
    let op: Tok = s.assign_op;
    if op == Tok.PPluseq { res = v_binop(c, IROp.IrAdd, cur, rhs, vt, true); }
    else if op == Tok.PMinuseq { res = v_binop(c, IROp.IrSub, cur, rhs, vt, true); }
    else if op == Tok.PStareq { res = v_binop(c, IROp.IrMul, cur, rhs, vt, flt); }
    else if op == Tok.PSlasheq {
      let mut sgn: bool = flt;
      if ty_is_signed_int(vt) {
        sgn = true;
      }
      res = v_binop(c, IROp.IrDiv, cur, rhs, vt, sgn);
    }
    else if op == Tok.PPercenteq { res = v_binop(c, IROp.IrMod, cur, rhs, vt, ty_is_signed_int(vt)); }
    else if op == Tok.PAmpeq { res = v_binop(c, IROp.IrAnd, cur, rhs, vt, false); }
    else if op == Tok.PPipeeq { res = v_binop(c, IROp.IrOr, cur, rhs, vt, false); }
    else if op == Tok.PCareteq { res = v_binop(c, IROp.IrXor, cur, rhs, vt, false); }
    else if op == Tok.PShleq { res = v_binop(c, IROp.IrShl, cur, rhs, vt, false); }
    else if op == Tok.PShreq { res = v_binop(c, IROp.IrShr, cur, rhs, vt, ty_is_signed_int(vt)); }
    v_store(c, addr, res);
    return;
  }
  if s.kind == StmtKind.StExpr {
    lv_expr_discard(c, s.a);
    return;
  }
  if s.kind == StmtKind.StReturn {
    let mut t: *Type = null;
    if s.a != null {
      t = s.a.typed;
    }
    if s.a != null && ty_is_aggregate(t) {
      let src: *IRVreg = lv_expr(c, s.a);
      let dst: *IRVreg = ret_dest(c);
      let cp: *IRIns = emit(c, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = src;
      cp.size = type_size(t);
      if ty_is_managed(t) && !expr_owned(s.a) {
        retain_addr(c, t, dst);
      }
      run_defers(c, null);
      release_scopes_to(c, null);
      emit_ret(c, null);
    } else if s.a != null && ty_is_managed(t) {
      let v: *IRVreg = lv_expr(c, s.a);
      if !expr_owned(s.a) {
        rc_inc_v(c, v);
      }
      run_defers(c, null);
      release_scopes_to(c, null);
      emit_ret(c, v);
    } else {
      // evaluate before defers/release: the value may read scope-owned data
      let mut v: *IRVreg = null;
      if s.a != null {
        v = lv_expr(c, s.a);
      }
      run_defers(c, null);
      release_scopes_to(c, null);
      emit_ret(c, v);
    }
    // continuation block for unreachable code after return
    let dead: *IRBlock = new_block(c);
    use_block(c, dead);
    return;
  }
  if s.kind == StmtKind.StBreak || s.kind == StmtKind.StContinue {
    let mut loop_scope: *LScope = null;
    let mut s2: *LScope = c.scope;
    while s2 != null {
      if (s.kind == StmtKind.StBreak && s2.break_to != null) ||
         (s.kind == StmtKind.StContinue && s2.continue_to != null) {
        loop_scope = s2;
        s2 = null;
      } else {
        s2 = s2.parent;
      }
    }
    run_defers(c, loop_scope); // defers inside the loop body, not the loop scope's own
    release_scopes_to(c, loop_scope);
    if s.kind == StmtKind.StBreak {
      emit_br(c, loop_scope.break_to);
    } else {
      emit_br(c, loop_scope.continue_to);
    }
    let dead: *IRBlock = new_block(c);
    use_block(c, dead);
    return;
  }
  if s.kind == StmtKind.StDefer {
    c.scope.defers = push_stmt(c.scope.defers, s);
    return;
  }
  if s.kind == StmtKind.StWhile {
    let header: *IRBlock = new_block(c);
    let body: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    header.loop_header = true;
    header.loop_exit = done;
    emit_br(c, header);
    use_block(c, header);
    let cond: *IRVreg = lv_expr(c, s.cond);
    emit_cbr(c, cond, body, done, done);
    use_block(c, body);
    scope_push_l(c);
    c.scope.is_loop = true;
    c.scope.break_to = done;
    c.scope.continue_to = header;
    let mut i: usize = 0;
    while i < s.body.n {
      lv_stmt(c, s.body.items[i]);
      i += 1;
    }
    run_defers(c, c.scope.parent);
    scope_pop_release(c);
    emit_br(c, header);
    use_block(c, done);
    return;
  }
  if s.kind == StmtKind.StLoop {
    let body: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    body.loop_header = true;
    body.loop_exit = done;
    emit_br(c, body);
    use_block(c, body);
    scope_push_l(c);
    c.scope.is_loop = true;
    c.scope.break_to = done;
    c.scope.continue_to = body;
    let mut i: usize = 0;
    while i < s.body.n {
      lv_stmt(c, s.body.items[i]);
      i += 1;
    }
    run_defers(c, c.scope.parent);
    scope_pop_release(c);
    emit_br(c, body);
    use_block(c, done);
    return;
  }
  if s.kind == StmtKind.StBlock {
    scope_push_l(c);
    let mut i: usize = 0;
    while i < s.stmts.n {
      lv_stmt(c, s.stmts.items[i]);
      i += 1;
    }
    run_defers(c, c.scope.parent);
    scope_pop_release(c);
    return;
  }
}

fn push_stmt(items: []*Stmt, s: *Stmt) -> []*Stmt {
  let out: []*Stmt = make([]*Stmt, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = s;
  return out;
}

fn lv_stmts(c: *LCtx, stmts: *Vec[*Stmt]) {
  let mut i: usize = 0;
  while i < stmts.n {
    lv_stmt(c, stmts.items[i]);
    i += 1;
  }
}

// run defers innermost-first until (exclusive) scope `stop` (NULL = all)
fn run_defers(c: *LCtx, stop: *LScope) {
  let mut s: *LScope = c.scope;
  while s != null && s != stop {
    let mut i: usize = len(s.defers);
    while i > 0 {
      let d: *Stmt = s.defers[i - 1];
      let mut j: usize = 0;
      while j < d.stmts.n {
        lv_stmt(c, d.stmts.items[j]);
        j += 1;
      }
      i -= 1;
    }
    s = s.parent;
  }
}

// ------------------------------------------------------------ driver -------

fn lower_fn(fn_sym: *Sym) -> *IRFn {
  let d: *Decl = fn_sym.decl;
  let fn_: *IRFn = rc_new_fn(sym_symbol(fn_sym));
  fn_.ret = fn_sym.type.ret;
  if fn_.ret != null && ty_is_aggregate(fn_.ret) {
    fn_.returns_aggregate = true;
    let cc0: *LCtx = rc_ctx(fn_);
    fn_.out_slot = new_slot(cc0, type_size(fn_.ret), type_align(fn_.ret), "out");
  }
  let ctx: *LCtx = rc_ctx(fn_);
  scope_push_l(ctx);

  fn_.entry = new_block(ctx);
  use_block(ctx, fn_.entry);

  let mut i: usize = 0;
  while i < d.params.n {
    let pa: *Param = d.params.items[i];
    let pt: *Type = fn_sym.type.params[i];
    let slot: *IRSlot = new_slot(ctx, type_size(pt), type_align(pt), pa.name);
    fn_.params = push_islot(fn_.params, slot);
    fn_.param_types = push_type(fn_.param_types, pt);
    if ty_is_aggregate(pt) {
      // the register holds a POINTER to the caller's copy; give the parameter
      // a proper local slot and copy the value through after the spill
      let local: *IRSlot = new_slot(ctx, type_size(pt), type_align(pt), pa.name);
      lbind(ctx, pa.name, local);
      let src_addr: *IRVreg = v_slotaddr(ctx, slot);
      let src: *IRVreg = v_load(ctx, src_addr, IRType.ItPtr);
      let dst: *IRVreg = v_slotaddr(ctx, local);
      let cp: *IRIns = emit(ctx, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = src;
      cp.size = type_size(pt);
      if ty_is_managed(pt) {
        retain_addr(ctx, pt, dst);
        own_slot(ctx, local, pt);
      }
    } else {
      lbind(ctx, pa.name, slot);
      if ty_is_managed(pt) {
        retain_addr(ctx, pt, v_slotaddr(ctx, slot));
        own_slot(ctx, slot, pt);
      }
    }
    i += 1;
  }
  if fn_sym.owner == g_root_module && streq(fn_sym.name, "main") {
    if g_main_cell == null {
      g_main_cell = new Vec[string] { items: make([]string, 1), n: 1 };
    }
    g_main_cell.items[0] = fn_.symbol;
  }

  let mut bi: usize = 0;
  while bi < d.body.n {
    lv_stmt(ctx, d.body.items[bi]);
    bi += 1;
  }

  if fn_.cur.term_op == 0 {
    run_defers(ctx, null);
    release_scopes_to(ctx, null);
    emit_ret(ctx, null);
  }
  scope_pop_l(ctx);
  return fn_;
}

fn lower_static(fn_sym: *Sym) {
  let d: *Decl = fn_sym.decl;
  let t: *Type = fn_sym.type;
  let g: *IRGlobal = new IRGlobal {
    symbol: sym_symbol(fn_sym), size: type_size(t), align: type_align(t),
    init: make([]u8, 0), relocs: make([]string, 0), static_lit: null,
    is_extern: false,
  };
  if d.kind == DeclKind.DkStatic && d.init != null && d.init.kind == ExprKind.ExStr {
    // {buf, ptr, len} with relocations into rodata
    let sv: string = d.init.sv;
    let label: string = cat3(g.symbol, "_str", "");
    let mut bytes: []u8 = make([]u8, 0);
    let mut si: usize = 0;
    while si < len(sv) {
      bytes = push_u8(bytes, sv[si]);
      si += 1;
    }
    bytes = push_u8(bytes, 0);
    let lit: *IRLit = new IRLit { label: label, bytes: bytes };
    // the emitter emits this literal block next to the global's data
    g.relocs = push_str(g.relocs, label);
    g.relocs = push_str(g.relocs, cat3(label, "_b", ""));
    g.relocs = push_str(g.relocs, "");
    let len_v: i64 = len(sv) as i64;
    let mut w: i32 = 0;
    while w < 3 {
      let mut word: i64 = 0;
      if w == 2 {
        word = len_v;
      }
      let mut b: i32 = 0;
      while b < 8 {
        g.init = push_u8(g.init, ((word >> (8 * b)) & 255) as u8);
        b += 1;
      }
      w += 1;
    }
    g.static_lit = lit;
  } else if d.init != null && d.init.typed != null && !ty_is_aggregate(d.init.typed) {
    let mut v: u64 = 0;
    if d.ceval_ok && d.ceval_is_int {
      v = d.ceval_i;
    }
    if d.ceval_ok && !d.ceval_is_int {
      // float bit patterns are inexpressible in rho 0.0.5 (no bits
      // intrinsic); no corpus/prelude static uses one — keep zero and note it
      v = 0;
    }
    let size: i64 = type_size(t);
    let mut b: i64 = 0;
    while b < size {
      g.init = push_u8(g.init, ((v >> (8 * b)) & 255) as u8);
      b += 1;
    }
  }
  g_ir_globals.push(g);
}

fn lower_program() {
  g_ir_fns = new Vec[*IRFn] { items: make([]*IRFn, 1024), n: 0 };
  g_ir_globals = new Vec[*IRGlobal] { items: make([]*IRGlobal, 64), n: 0 };
  if g_main_cell == null {
    g_main_cell = new Vec[string] { items: make([]string, 1), n: 1 };
  }
  g_main_cell.items[0] = "";
  // per-compile caches: stale symbols would point at previous compiles'
  // glue fns (which no longer exist in this module's emission)
  g_ret_fns = tm2_new();
  g_rel_fns = tm2_new();
  g_eq_fns = tm2_new();
  g_panic_site = 0;
  g_lit_counter = 0;
  g_closure_counter = 0;
  g_shims = null;
  rc_runtime_build(); // __rc_inc/dec/w* helpers every managed program needs
  // module order: prelude first, then the user module (C's g_module_order)
  let mut mi: i32 = 0;
  while mi < 2 {
    let mut m: *Module = g_root_module;
    if mi == 0 {
      m = prelude_module;
    }
    if m != null {
      let mut k: usize = 0;
      while k < m.syms.n {
        let sym: *Sym = m.syms.items[k].val;
        if sym.kind == SymKind.SyFn && sym.decl != null && sym.decl.body.n > 0 &&
           !sym.decl.templated {
          g_ir_fns.push(lower_fn(sym));
        } else if sym.kind == SymKind.SyStatic {
          lower_static(sym);
        }
        k += 1;
      }
    }
    mi += 1;
  }
}


// ================= emit_wasm (LOW-10): wasm32-wasi binary emitter ===========
// Vregs become wasm locals, frame slots live in linear memory at $fb + off,
// the structured CFG is re-nested (if-diamonds close over `block $join`,
// loops become `block $exit loop $h`), and function addresses — closure code
// fields and rc drop glue — are table indices reached through call_indirect.

struct WType {
  params: []i64, // IRType values
  has_ret: bool,
  ret: IRType,
  index: i32,
}

struct WFn {
  fn_: *IRFn,
  index: i32, // function index (after the two wasi imports)
  type_: i32,
}

struct WLabel {
  kind: i32, // 0 block(exit), 1 loop(header), 2 if placeholder
  b: *IRBlock,
}

struct WClaim {
  b: *IRBlock,
  base: i32, // labels.n at claim time: br depth = labels.n - base
}

struct I64Ent { key: string, val: i64 }
struct I64Map { items: []*I64Ent }

fn im_put(m: *I64Map, key: string, val: i64) {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      m.items[i].val = val;
      return;
    }
    i += 1;
  }
  m.items = push_i64ent(m.items, new I64Ent { key: key, val: val });
}

fn push_i64ent(items: []*I64Ent, e: *I64Ent) -> []*I64Ent {
  let out: []*I64Ent = make([]*I64Ent, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = e;
  return out;
}

fn im_get(m: *I64Map, key: string) -> i64 {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return -1;
}

fn im_has(m: *I64Map, key: string) -> bool {
  return im_get(m, key) != -1 || im_has_zero(m, key);
}

fn im_has_zero(m: *I64Map, key: string) -> bool {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      return true;
    }
    i += 1;
  }
  return false;
}

struct WFnEnt { key: string, val: *WFn }
struct WFnMap { items: []*WFnEnt }

fn fm_put(m: *WFnMap, key: string, val: *WFn) {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      m.items[i].val = val;
      return;
    }
    i += 1;
  }
  m.items = push_wfnent(m.items, new WFnEnt { key: key, val: val });
}

fn push_wfnent(items: []*WFnEnt, e: *WFnEnt) -> []*WFnEnt {
  let out: []*WFnEnt = make([]*WFnEnt, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = e;
  return out;
}

fn fm_get(m: *WFnMap, key: string) -> *WFn {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return null;
}

struct WState {
  fns: []*WFn,
  types: []*WType,
  type_keys: []string, // parallel to types: dedup key per entry
  fn_by_symbol: *WFnMap,
  table_idx: *I64Map,  // symbol -> index+1 (0 = absent)
  table_fns: []string,
  global_addr: *I64Map,
  lit_addr: *I64Map,
  heap_base: i64,
  stack_top: i64,
  data_end: i64,
}

static mut W: *WState = 0 as *WState;

// ---- raw bytes -----------------------------------------------------------------

fn b8(sb: *Vec[u8], b: u8) {
  sb.push(b);
}

fn buleb(sb: *Vec[u8], v: u64) {
  loop {
    let mut b: u8 = (v & 127) as u8;
    let rest: u64 = v >> 7;
    if rest != 0 {
      b = b | 128;
    }
    b8(sb, b);
    if rest == 0 {
      break;
    }
    v = rest;
  }
}

fn bsleb(sb: *Vec[u8], v: i64) {
  let mut more: bool = true;
  let mut x: i64 = v;
  while more {
    let mut b: u8 = (x & 127) as u8;
    x = x >> 7;
    if (x == 0 && (b & 64) == 0) || (x == -1 && (b & 64) != 0) {
      more = false;
    } else {
      b = b | 128;
    }
    b8(sb, b);
  }
}

fn bstr(sb: *Vec[u8], s: string) {
  buleb(sb, len(s) as u64);
  let mut i: usize = 0;
  while i < len(s) {
    b8(sb, s[i]);
    i += 1;
  }
}

fn bsection(out: *Vec[u8], id: u8, body: *Vec[u8]) {
  b8(out, id);
  buleb(out, body.n as u64);
  let mut i: usize = 0;
  while i < body.n {
    b8(out, body.items[i]);
    i += 1;
  }
}

fn bappend(dst: *Vec[u8], src: *Vec[u8]) {
  let mut i: usize = 0;
  while i < src.n {
    b8(dst, src.items[i]);
    i += 1;
  }
}

fn w_vt(t: IRType) -> u8 {
  if t == IRType.ItF32 { return 0x7D; }
  if t == IRType.ItF64 { return 0x7C; }
  if t == IRType.ItI64 || t == IRType.ItU64 || t == IRType.ItUsize { return 0x7E; }
  return 0x7F;
}

fn w_vt_i(t: i64) -> u8 {
  let f32v: i64 = IRType.ItF32 as i64;
  let f64v: i64 = IRType.ItF64 as i64;
  let i64v: i64 = IRType.ItI64 as i64;
  let u64v: i64 = IRType.ItU64 as i64;
  let uszv: i64 = IRType.ItUsize as i64;
  if t == f32v { return 0x7D; }
  if t == f64v { return 0x7C; }
  if t == i64v || t == u64v || t == uszv { return 0x7E; }
  return 0x7F;
}

fn w_is64(t: IRType) -> bool {
  return t == IRType.ItI64 || t == IRType.ItU64 || t == IRType.ItUsize;
}

fn ir_fn_for_symbol(symbol: string) -> *IRFn {
  let mut i: usize = 0;
  while i < g_ir_fns.n {
    if streq(g_ir_fns.items[i].symbol, symbol) {
      return g_ir_fns.items[i];
    }
    i += 1;
  }
  return null;
}

// ---- types ----------------------------------------------------------------------

fn w_type_key(params: []i64, has_ret: bool, ret: IRType) -> string {
  let mut k: string = "";
  let mut i: usize = 0;
  while i < len(params) {
    k = cat3(k, itoa(params[i]), ",");
    i += 1;
  }
  let mut r: i64 = -1;
  if has_ret {
    r = ret as i64;
  }
  return cat3(k, "->", itoa(r));
}

fn w_type_for(params: []i64, has_ret: bool, ret: IRType) -> i32 {
  let k: string = w_type_key(params, has_ret, ret);
  let mut i: usize = 0;
  while i < len(W.type_keys) {
    if streq(W.type_keys[i], k) {
      return W.types[i].index;
    }
    i += 1;
  }
  let t: *WType = new WType {
    params: params, has_ret: has_ret, ret: ret,
    index: len(W.types) as i32,
  };
  W.types = push_wtype(W.types, t);
  W.type_keys = push_str(W.type_keys, k);
  return t.index;
}

fn push_wtype(items: []*WType, t: *WType) -> []*WType {
  let out: []*WType = make([]*WType, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = t;
  return out;
}

fn ty_travels_as_ptr(pt: *Type) -> bool {
  if pt == null {
    return false;
  }
  return pt.kind == TypeKind.TyStruct || pt.kind == TypeKind.TyEnum ||
         pt.kind == TypeKind.TySlice || pt.kind == TypeKind.TyStringK ||
         pt.kind == TypeKind.TyArray || pt.kind == TypeKind.TyFn;
}

// does any RET terminator in fn carry a value?
fn fn_returns_value(fn_: *IRFn) -> bool {
  let mut b: usize = 0;
  while b < len(fn_.blocks) {
    let blk: *IRBlock = fn_.blocks[b];
    if blk.term_op == 102 && blk.ret_val != null {
      return true;
    }
    b += 1;
  }
  return false;
}

fn w_type_of_fn(fn_: *IRFn) -> i32 {
  let mut params: []i64 = make([]i64, 0);
  // agg returns: the hidden out pointer is the FIRST signature param
  if fn_.returns_aggregate {
    params = push_i64(params, IRType.ItPtr as i64);
  }
  let mut i: usize = 0;
  while i < len(fn_.params) {
    let mut pt: *Type = null;
    if i < len(fn_.param_types) {
      pt = fn_.param_types[i];
    }
    // synth (rc) fns carry NULL param types: their params are pointers
    let mut it: IRType = IRType.ItPtr;
    if pt != null && !ty_travels_as_ptr(pt) {
      it = ir_type_of(pt);
    }
    params = push_i64(params, it as i64);
    i += 1;
  }
  // synth (rc) fns carry fn->ret == null whether or not they return — ask
  // the terminators: any RET with a value means the signature needs one
  let no_ret: bool = fn_.returns_aggregate ||
      (fn_.ret != null && fn_.ret.kind == TypeKind.TyVoid) ||
      (fn_.ret == null && !fn_returns_value(fn_));
  if no_ret {
    return w_type_for(params, false, IRType.ItI32);
  }
  let mut ret: IRType = IRType.ItPtr; // synth fns return ptrs
  if fn_.ret != null {
    ret = ir_type_of(fn_.ret);
  }
  return w_type_for(params, true, ret);
}

fn w_type_of_call(i: *IRIns) -> i32 {
  let mut params: []i64 = make([]i64, 0);
  let mut k: usize = 0;
  while k < len(i.args) {
    params = push_i64(params, i.args[k].ty as i64);
    k += 1;
  }
  if i.dst != null {
    return w_type_for(params, true, i.dst.ty);
  }
  return w_type_for(params, false, IRType.ItI32);
}

// ---- data layout ------------------------------------------------------------------
// 1024 | statics | [24B immortal header + bytes] per literal | heap | ... | stack

fn w_layout_data() {
  let mut at: i64 = 1024;
  let mut g: usize = 0;
  while g < g_ir_globals.n {
    let gl: *IRGlobal = g_ir_globals.items[g];
    if !gl.is_extern {
      let al: i64 = if gl.align < 8 { 8 } else { gl.align };
      at = round_up_i64(at, al);
      im_put(W.global_addr, gl.symbol, at);
      at += gl.size;
    }
    g += 1;
  }
  let mut f: usize = 0;
  while f < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[f];
    let mut l: usize = 0;
    while l < len(fn_.literals) {
      let lit: *IRLit = fn_.literals[l];
      at = round_up_i64(at, 8);
      im_put(W.lit_addr, lit.label, at);
      at += 24 + len(lit.bytes) as i64;
      l += 1;
    }
    f += 1;
  }
  W.heap_base = round_up_i64(at, 16);
  // the wasi prelude's HEAP static starts allocation above the data image
  g = 0;
  while g < g_ir_globals.n {
    let gl: *IRGlobal = g_ir_globals.items[g];
    if !gl.is_extern && len(gl.init) == 8 && len(gl.symbol) >= 5 &&
       streq(slice_str(gl.symbol, len(gl.symbol) - 5, len(gl.symbol)), "_HEAP") {
      let v: u64 = W.heap_base as u64;
      let mut b: i32 = 0;
      while b < 8 {
        gl.init[b] = ((v >> (8 * b)) & 255) as u8;
        b += 1;
      }
    }
    g += 1;
  }
  // the bump heap grows up toward the stack; leave it 8 MiB of headroom
  W.stack_top = W.heap_base + 0x800000;
  W.data_end = at;
}

fn slice_str(s: string, lo: usize, hi: usize) -> string {
  return s[lo..hi];
}

// ---- per-function emission ----------------------------------------------------------

struct WFnCtx {
  fn_: *IRFn,
  body: *Vec[u8],
  slot_off: []i64, // slot id -> frame offset (-1 = not yet laid out)
  frame: i64,
  hidden: i32,
  labels: []*WLabel,
  claims: []*WClaim,
}

fn push_claim(items: []*WClaim, c: *WClaim) -> []*WClaim {
  let out: []*WClaim = make([]*WClaim, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = c;
  return out;
}

fn push_label(items: []*WLabel, l: *WLabel) -> []*WLabel {
  let out: []*WLabel = make([]*WLabel, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = l;
  return out;
}

fn slot_offset(c: *WFnCtx, s: *IRSlot) -> i64 {
  while len(c.slot_off) <= s.id as usize {
    c.slot_off = push_i64(c.slot_off, -1);
  }
  let mut off: i64 = c.slot_off[s.id];
  if off >= 0 {
    return off;
  }
  let al: i64 = if s.align > 8 { 8 } else { s.align };
  let sz: i64 = if s.size < 8 { 8 } else { s.size };
  c.frame = round_up_i64(c.frame, al);
  off = c.frame;
  c.frame += sz;
  c.slot_off[s.id] = off;
  return off;
}

// local layout: [hidden out ptr] [declared params] [$fb] [vregs...]
fn fb_local(c: *WFnCtx) -> i64 {
  return len(c.fn_.params) as i64 + c.hidden as i64;
}

fn vreg_local(c: *WFnCtx, v: *IRVreg) -> i64 {
  return len(c.fn_.params) as i64 + c.hidden as i64 + 1 + v.id as i64;
}

fn lget(c: *WFnCtx, v: *IRVreg) {
  b8(c.body, 0x20);
  buleb(c.body, vreg_local(c, v) as u64);
}

fn lset(c: *WFnCtx, v: *IRVreg) {
  b8(c.body, 0x21);
  buleb(c.body, vreg_local(c, v) as u64);
}

fn i32c(c: *WFnCtx, v: i64) {
  b8(c.body, 0x41);
  bsleb(c.body, v);
}

fn emit_load(c: *WFnCtx, i: *IRIns) {
  lget(c, i.addr);
  // op follows the DESTINATION wasm type: pointers are 8 bytes in memory
  // but i32 locals (addresses fit the 32-bit memory space)
  let t: IRType = i.dst.ty;
  if t == IRType.ItF32 {
    b8(c.body, 0x2A);
    buleb(c.body, 2);
  } else if t == IRType.ItF64 {
    b8(c.body, 0x2B);
    buleb(c.body, 3);
  } else if w_is64(t) {
    b8(c.body, 0x29); // i64.load
    buleb(c.body, 3);
  } else {
    let sz: i64 = i.size;
    let sgn: bool = ty_is_signed_int(t);
    let mut op: u8 = 0x28;
    let mut align: u64 = 2;
    if sz == 1 {
      if sgn { op = 0x2C; } else { op = 0x2D; }
      align = 0;
    } else if sz == 2 {
      if sgn { op = 0x2E; } else { op = 0x2F; }
      align = 1;
    }
    b8(c.body, op);
    buleb(c.body, align);
  }
  buleb(c.body, 0);
  lset(c, i.dst);
}

fn emit_store(c: *WFnCtx, i: *IRIns) {
  lget(c, i.addr);
  lget(c, i.a);
  // pointers store as i32 regardless of the 8-byte memory footprint;
  // everything else follows the store SIZE
  let t: IRType = i.a.ty;
  let sz: i64 = i.size;
  if i.is_float {
    if sz == 4 {
      b8(c.body, 0x38);
      buleb(c.body, 2);
    } else {
      b8(c.body, 0x39);
      buleb(c.body, 3);
    }
  } else if t == IRType.ItPtr {
    b8(c.body, 0x36); // i32.store
    buleb(c.body, 2);
  } else {
    let mut op: u8 = 0x37;
    let mut align: u64 = 3;
    if sz == 1 { op = 0x3A; align = 0; }
    else if sz == 2 { op = 0x3B; align = 1; }
    else if sz == 4 { op = 0x36; align = 2; }
    b8(c.body, op);
    buleb(c.body, align);
  }
  buleb(c.body, 0);
}

fn arith_op(op: IROp, ty: IRType, sgn: bool, flt: bool) -> u8 {
  let is64: bool = w_is64(ty);
  if op == IROp.IrAdd {
    if flt {
      if ty == IRType.ItF32 { return 0x92; }
      return 0xA0;
    }
    if is64 { return 0x7C; }
    return 0x6A;
  }
  if op == IROp.IrSub {
    if flt {
      if ty == IRType.ItF32 { return 0x93; }
      return 0xA1;
    }
    if is64 { return 0x7D; }
    return 0x6B;
  }
  if op == IROp.IrMul {
    if flt {
      if ty == IRType.ItF32 { return 0x94; }
      return 0xA2;
    }
    if is64 { return 0x7E; }
    return 0x6C;
  }
  if op == IROp.IrDiv {
    if flt {
      if ty == IRType.ItF32 { return 0x95; }
      return 0xA3;
    }
    if is64 {
      if sgn { return 0x7F; }
      return 0x80;
    }
    if sgn { return 0x6D; }
    return 0x6E;
  }
  if op == IROp.IrMod {
    if is64 {
      if sgn { return 0x81; }
      return 0x82;
    }
    if sgn { return 0x6F; }
    return 0x70;
  }
  if op == IROp.IrAnd { if is64 { return 0x83; } return 0x71; }
  if op == IROp.IrOr { if is64 { return 0x84; } return 0x72; }
  if op == IROp.IrXor { if is64 { return 0x85; } return 0x73; }
  if op == IROp.IrShl { if is64 { return 0x86; } return 0x74; }
  if op == IROp.IrShr {
    if is64 {
      if sgn { return 0x87; }
      return 0x88;
    }
    if sgn { return 0x75; }
    return 0x76;
  }
  return 0x6A;
}

fn emit_cmp(c: *WFnCtx, i: *IRIns) {
  lget(c, i.a);
  lget(c, i.b);
  if i.is_float {
    // eq ne lt gt le ge — f32 0x5B.., f64 0x61..
    let mut idx: i32 = 5;
    if i.cc == IRCC.CcEq { idx = 0; }
    else if i.cc == IRCC.CcNe { idx = 1; }
    else if i.cc == IRCC.CcLt { idx = 2; }
    else if i.cc == IRCC.CcGt { idx = 3; }
    else if i.cc == IRCC.CcLe { idx = 4; }
    let f32ops: []u8 = make([]u8, 6);
    f32ops[0] = 0x5B; f32ops[1] = 0x5C; f32ops[2] = 0x5D;
    f32ops[3] = 0x5E; f32ops[4] = 0x5F; f32ops[5] = 0x60;
    let f64ops: []u8 = make([]u8, 6);
    f64ops[0] = 0x61; f64ops[1] = 0x62; f64ops[2] = 0x63;
    f64ops[3] = 0x64; f64ops[4] = 0x65; f64ops[5] = 0x66;
    if i.a.ty == IRType.ItF32 {
      b8(c.body, f32ops[idx]);
    } else {
      b8(c.body, f64ops[idx]);
    }
  } else {
    let is64: bool = w_is64(i.a.ty);
    let mut base: i32 = 0x46;
    if is64 {
      base = 0x51;
    }
    let mut idx: i32 = 0;
    if i.cc == IRCC.CcEq { idx = 0; }
    else if i.cc == IRCC.CcNe { idx = 1; }
    else if i.cc == IRCC.CcLt { if i.signed_ops { idx = 2; } else { idx = 3; } }
    else if i.cc == IRCC.CcLe { if i.signed_ops { idx = 6; } else { idx = 7; } }
    else if i.cc == IRCC.CcGt { if i.signed_ops { idx = 4; } else { idx = 5; } }
    else if i.cc == IRCC.CcGe { if i.signed_ops { idx = 8; } else { idx = 9; } }
    b8(c.body, (base + idx) as u8);
  }
  lset(c, i.dst);
}

fn prelude_symbol(name: string) -> string {
  let fn_: *Sym = prelude_fn(name);
  if fn_ != null {
    return sym_symbol(fn_);
  }
  return name;
}

// integer div/mod with the zero and MIN/-1 guards the spec promises:
// divisor == 0 -> __panic_div; signed divisor == -1 -> 0 - a (wraps)
fn emit_int_divmod(c: *WFnCtx, i: *IRIns) {
  let is64: bool = w_is64(i.a.ty);
  lget(c, i.b);
  if is64 { b8(c.body, 0x50); } else { b8(c.body, 0x45); } // eqz
  b8(c.body, 0x04); // if void
  b8(c.body, 0x40);
  {
    let sym: string = prelude_symbol("__panic_div");
    let t: *WFn = fm_get(W.fn_by_symbol, sym);
    if t != null {
      b8(c.body, 0x10); // call
      buleb(c.body, t.index as u64);
    }
    b8(c.body, 0x00); // unreachable — panic never returns
  }
  b8(c.body, 0x05); // else
  if i.signed_ops {
    lget(c, i.b);
    if is64 {
      b8(c.body, 0x42); // i64.const -1
      bsleb(c.body, -1);
      b8(c.body, 0x51); // i64.eq
    } else {
      b8(c.body, 0x41); // i32.const -1
      bsleb(c.body, -1);
      b8(c.body, 0x46); // i32.eq
    }
    b8(c.body, 0x04); // if void
    b8(c.body, 0x40);
    // dst = 0 - a (wraps: MIN / -1 -> MIN)
    if is64 {
      b8(c.body, 0x42);
      bsleb(c.body, 0);
    } else {
      b8(c.body, 0x41);
      bsleb(c.body, 0);
    }
    lget(c, i.a);
    if is64 { b8(c.body, 0x7D); } else { b8(c.body, 0x6B); } // sub
    lset(c, i.dst);
    b8(c.body, 0x05); // else
    lget(c, i.a);
    lget(c, i.b);
    b8(c.body, arith_op(i.op, i.a.ty, i.signed_ops, false));
    lset(c, i.dst);
    b8(c.body, 0x0B); // end
  } else {
    lget(c, i.a);
    lget(c, i.b);
    b8(c.body, arith_op(i.op, i.a.ty, i.signed_ops, false));
    lset(c, i.dst);
  }
  b8(c.body, 0x0B); // end if
}

fn table_index_of(symbol: string) {
  if im_has(W.table_idx, symbol) {
    return;
  }
  W.table_fns = push_str(W.table_fns, symbol);
  im_put(W.table_idx, symbol, len(W.table_fns) as i64);
}

fn intrinsics_f32_bits(x: f64) -> u32 {
  return intrinsics.f32_bits(x as f32);
}

fn intrinsics_f64_bits(x: f64) -> u64 {
  return intrinsics.f64_bits(x);
}

fn emit_ins(c: *WFnCtx, i: *IRIns) {
  if i.op == IROp.IrConst {
    if w_is64(i.dst.ty) {
      b8(c.body, 0x42);
      bsleb(c.body, i.imm);
    } else {
      b8(c.body, 0x41);
      bsleb(c.body, i.imm as i32 as i64);
    }
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrFconst {
    if i.dst.ty == IRType.ItF32 {
      let bits: u32 = intrinsics_f32_bits(i.fimm);
      b8(c.body, 0x43);
      let mut k: i32 = 0;
      while k < 4 {
        b8(c.body, ((bits >> (8 * k)) & 255) as u8);
        k += 1;
      }
    } else {
      let bits: u64 = intrinsics_f64_bits(i.fimm);
      b8(c.body, 0x44);
      let mut k: i32 = 0;
      while k < 8 {
        b8(c.body, ((bits >> (8 * k)) & 255) as u8);
        k += 1;
      }
    }
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrDiv || i.op == IROp.IrMod {
    if !i.is_float {
      emit_int_divmod(c, i);
      return;
    }
    // fall through to the float path
  }
  if i.op == IROp.IrAdd || i.op == IROp.IrSub || i.op == IROp.IrMul ||
     i.op == IROp.IrDiv || i.op == IROp.IrMod || i.op == IROp.IrAnd ||
     i.op == IROp.IrOr || i.op == IROp.IrXor || i.op == IROp.IrShl ||
     i.op == IROp.IrShr {
    lget(c, i.a);
    lget(c, i.b);
    // pointer(+/-)usize mixes i32 and i64 on wasm32: narrow the wide side
    if !w_is64(i.a.ty) && w_is64(i.b.ty) && !i.is_float {
      b8(c.body, 0xA7); // i32.wrap_i64
    } else if w_is64(i.a.ty) && !w_is64(i.b.ty) && !i.is_float {
      b8(c.body, 0xAD); // i64.extend_i32_u
    }
    b8(c.body, arith_op(i.op, i.a.ty, i.signed_ops, i.is_float));
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrCmp {
    emit_cmp(c, i);
    return;
  }
  if i.op == IROp.IrLoad {
    emit_load(c, i);
    return;
  }
  if i.op == IROp.IrStore {
    emit_store(c, i);
    return;
  }
  if i.op == IROp.IrAddrc {
    if i.lit == -1 && i.callee != "" {
      if ir_fn_for_symbol(i.callee) != null {
        table_index_of(i.callee);
        i32c(c, im_get(W.table_idx, i.callee) - 1);
      } else {
        i32c(c, im_get(W.global_addr, i.callee));
      }
      lset(c, i.dst);
    } else {
      // frame slot address: $fb + off
      b8(c.body, 0x20);
      buleb(c.body, fb_local(c) as u64);
      i32c(c, slot_offset(c, i.slot));
      b8(c.body, 0x6A);
      lset(c, i.dst);
    }
    return;
  }
  if i.op == IROp.IrLitaddr {
    let lit: *IRLit = c.fn_.literals[i.lit];
    i32c(c, im_get(W.lit_addr, lit.label));
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrAddi {
    lget(c, i.a);
    i32c(c, i.imm);
    b8(c.body, 0x6A);
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrCall {
    if i.callee != "" {
      // resolve first: a body-less rho fn (empty {}) is a no-op, and its
      // arg drops must not follow an already-emitted call opcode
      let mut import: i64 = -1;
      if streq(i.callee, "fd_write") { import = 0; }
      else if streq(i.callee, "proc_exit") { import = 1; }
      let mut t: *WFn = null;
      if import < 0 {
        t = fm_get(W.fn_by_symbol, i.callee);
        if t == null {
          // args are never evaluated on this path (their vregs simply go
          // unconsumed), so only an expected result needs synthesizing
          if i.dst != null {
            if i.dst.ty == IRType.ItF32 || i.dst.ty == IRType.ItF64 {
              if i.dst.ty == IRType.ItF32 {
                b8(c.body, 0x43);
              } else {
                b8(c.body, 0x44);
              }
              let mut z: i32 = 0;
              let mut zb: i32 = 8;
              if i.dst.ty == IRType.ItF32 {
                zb = 4;
              }
              while z < zb {
                b8(c.body, 0);
                z += 1;
              }
            } else {
              if w_is64(i.dst.ty) {
                b8(c.body, 0x42);
              } else {
                b8(c.body, 0x41);
              }
              b8(c.body, 0x00);
            }
            lset(c, i.dst);
          }
          return;
        }
      }
      let mut k: usize = 0;
      while k < len(i.args) {
        lget(c, i.args[k]);
        k += 1;
      }
      b8(c.body, 0x10);
      if import >= 0 {
        buleb(c.body, import as u64);
      } else {
        buleb(c.body, t.index as u64);
      }
    } else {
      let mut k: usize = 0;
      while k < len(i.args) {
        lget(c, i.args[k]);
        k += 1;
      }
      lget(c, i.callee_vreg);
      b8(c.body, 0x11); // call_indirect
      buleb(c.body, w_type_of_call(i) as u64);
      buleb(c.body, 0);
    }
    if i.dst != null {
      lset(c, i.dst);
    }
    return;
  }
  if i.op == IROp.IrCast {
    lget(c, i.a);
    let from: IRType = i.cast_from;
    let to: IRType = i.cast_to;
    let sgn: bool = ty_is_signed_int(from);
    if i.cast == IRCastKind.CastTrunc {
      if w_is64(from) && !w_is64(to) {
        b8(c.body, 0xA7); // i32.wrap_i64
      }
    } else if i.cast == IRCastKind.CastSext {
      if !w_is64(from) && w_is64(to) {
        b8(c.body, 0xAC);
      }
    } else if i.cast == IRCastKind.CastZext {
      if !w_is64(from) && w_is64(to) {
        b8(c.body, 0xAD);
      }
    } else if i.cast == IRCastKind.CastI2f {
      // f32.convert_i32_s/u=0xB2/B3, f32.convert_i64_s/u=0xB4/B5,
      // f64.convert_i32_s/u=0xB7/B8, f64.convert_i64_s/u=0xB9/0xBA
      if to == IRType.ItF32 {
        if w_is64(from) {
          if sgn { b8(c.body, 0xB4); } else { b8(c.body, 0xB5); }
        } else {
          if sgn { b8(c.body, 0xB2); } else { b8(c.body, 0xB3); }
        }
      } else {
        if w_is64(from) {
          if sgn { b8(c.body, 0xB9); } else { b8(c.body, 0xBA); }
        } else {
          if sgn { b8(c.body, 0xB7); } else { b8(c.body, 0xB8); }
        }
      }
    } else if i.cast == IRCastKind.CastF2i {
      // saturating truncation (spec: out-of-range saturates)
      let sgn_to: bool = ty_is_signed_int(to);
      let mut op: i32 = 0;
      if w_is64(to) {
        op = (if from == IRType.ItF32 { 0x04 } else { 0x06 }) + (if sgn_to { 0 } else { 1 });
      } else {
        op = (if from == IRType.ItF32 { 0x00 } else { 0x02 }) + (if sgn_to { 0 } else { 1 });
      }
      b8(c.body, 0xFC);
      b8(c.body, op as u8);
    } else if i.cast == IRCastKind.CastF32F64 {
      b8(c.body, 0xBB); // f64.promote_f32
    } else if i.cast == IRCastKind.CastF64F32 {
      b8(c.body, 0xB6); // f32.demote_f64
    } else if i.cast == IRCastKind.CastReinterp {
      // i32.reinterpret_f32=0xBC, i64.reinterpret_f64=0xBD
      if from == IRType.ItF32 {
        b8(c.body, 0xBC);
      } else {
        b8(c.body, 0xBD);
      }
    } else if i.cast == IRCastKind.CastBitcopy {
      // same-memory-size reinterpretations; across the wasm32 split the
      // pointer half is i32, so 64-bit ints need a width hop
      if from == IRType.ItF32 && to == IRType.ItI32 {
        b8(c.body, 0xBC);
      } else if from == IRType.ItF64 && (to == IRType.ItI64 || to == IRType.ItUsize) {
        b8(c.body, 0xBD);
      } else if from == IRType.ItI32 && to == IRType.ItF32 {
        b8(c.body, 0xBE);
      } else if (from == IRType.ItI64 || from == IRType.ItUsize) && to == IRType.ItF64 {
        b8(c.body, 0xBF);
      } else if from == IRType.ItPtr && w_is64(to) {
        b8(c.body, 0xAD); // i64.extend_i32_u
      } else if w_is64(from) && to == IRType.ItPtr {
        b8(c.body, 0xA7); // i32.wrap_i64
      }
    }
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrCopymem {
    lget(c, i.addr);
    lget(c, i.a);
    if i.size < 0 {
      lget(c, i.b); // runtime byte count
    } else {
      i32c(c, i.size);
    }
    b8(c.body, 0xFC);
    b8(c.body, 0x0A); // memory.copy
    buleb(c.body, 0);
    buleb(c.body, 0);
    return;
  }
  if i.op == IROp.IrZero {
    lget(c, i.addr);
    i32c(c, 0);
    i32c(c, i.size);
    b8(c.body, 0xFC);
    b8(c.body, 0x0B); // memory.fill
    buleb(c.body, 0);
    return;
  }
}
// ---- structured control flow -----------------------------------------------------
// Each branch/join gets exactly ONE label for its lifetime: the first diamond
// that targets it pushes it, arms br to it, and its code is emitted once after
// the outermost construct that referenced it. Loop headers carry explicit
// flags from the lowering (structural guessing mis-fires on rc glue CFGs).

fn pred_count(c: *WFnCtx, t: *IRBlock) -> i32 {
  let mut n: i32 = 0;
  let mut i: usize = 0;
  while i < len(c.fn_.blocks) {
    let b: *IRBlock = c.fn_.blocks[i];
    if b.term_op == 100 && b.br_true == t {
      n += 1;
    } else if b.term_op == 101 {
      if b.br_true == t {
        n += 1;
      }
      if b.br_false == t {
        n += 1;
      }
    }
    i += 1;
  }
  return n;
}

fn has_claim(c: *WFnCtx, b: *IRBlock) -> bool {
  if b == null {
    return false;
  }
  let mut i: usize = 0;
  while i < len(c.claims) {
    if c.claims[i].b == b {
      return true;
    }
    i += 1;
  }
  return false;
}

fn has_label(c: *WFnCtx, b: *IRBlock) -> bool {
  if b == null {
    return false;
  }
  let mut i: usize = 0;
  while i < len(c.labels) {
    if c.labels[i].b == b {
      return true;
    }
    i += 1;
  }
  return false;
}

fn has_target(c: *WFnCtx, b: *IRBlock) -> bool {
  return has_claim(c, b) || has_label(c, b);
}

fn inlineable(c: *WFnCtx, b: *IRBlock) -> bool {
  return !b.loop_header && !has_target(c, b) && !b.emitted && pred_count(c, b) == 1;
}

// can block `target` be reached from `from` following terminators through
// unlabeled, single-pred blocks? (small CFGs; bounded walk)
fn reaches(c: *WFnCtx, from: *IRBlock, target: *IRBlock, depth: i32) -> bool {
  if from == null || depth > 32 {
    return false;
  }
  let mut cur: *IRBlock = from;
  while cur != null {
    if cur == target {
      return true;
    }
    if cur.term_op == 0 {
      return false;
    }
    if cur.term_op == 100 {
      cur = cur.br_true;
    } else if cur.term_op == 102 {
      return false;
    } else {
      return reaches(c, cur.br_true, target, depth + 1) ||
             reaches(c, cur.br_false, target, depth + 1);
    }
  }
  return false;
}

// terminal br target of the chain starting at b (peek only), NULL on return
fn chain_terminal(c: *WFnCtx, b: *IRBlock) -> *IRBlock {
  let mut cur: *IRBlock = b;
  while cur != null {
    if !inlineable(c, cur) {
      return cur; // join, loop header, or labeled target
    }
    if cur.term_op == 0 {
      return null;
    }
    if cur.term_op == 100 {
      let t: *IRBlock = cur.br_true;
      if inlineable(c, t) {
        cur = t;
      } else {
        return t;
      }
    } else if cur.term_op == 102 {
      return cur; // a shared RET block is a join like any other
    } else {
      let r1: *IRBlock = chain_terminal(c, cur.br_true);
      let r2: *IRBlock = chain_terminal(c, cur.br_false);
      if r1 == r2 {
        return r1;
      }
      if r1 != null && r2 != null {
        // the arms' terminals differ: the true join is the deeper one the
        // other side eventually reaches
        let f12: bool = reaches(c, r1, r2, 0);
        let f21: bool = reaches(c, r2, r1, 0);
        if f12 {
          return r2;
        }
        if f21 {
          return r1;
        }
      }
      if r1 != null {
        return r1;
      }
      return r2;
    }
  }
  return null;
}

fn push_label_n(c: *WFnCtx, kind: i32, b: *IRBlock) {
  c.labels = push_label(c.labels, new WLabel { kind: kind, b: b });
}

fn pop_label(c: *WFnCtx) {
  let out: []*WLabel = make([]*WLabel, len(c.labels) - 1);
  let mut i: usize = 0;
  while i < len(c.labels) - 1 {
    out[i] = c.labels[i];
    i += 1;
  }
  c.labels = out;
}

fn pop_claim(c: *WFnCtx) {
  let out: []*WClaim = make([]*WClaim, len(c.claims) - 1);
  let mut i: usize = 0;
  while i < len(c.claims) - 1 {
    out[i] = c.claims[i];
    i += 1;
  }
  c.claims = out;
}

fn br_depth(c: *WFnCtx, t: *IRBlock) -> i32 {
  // claims first: br lands on the claiming diamond's own if — the last
  // construct opened since the claim — one below the raw count
  let mut i: usize = len(c.claims);
  while i > 0 {
    let cl: *WClaim = c.claims[i - 1];
    if cl.b == t {
      return len(c.labels) as i32 - cl.base - 1;
    }
    i -= 1;
  }
  i = len(c.labels);
  while i > 0 {
    if c.labels[i - 1].b == t {
      return len(c.labels) as i32 - i as i32;
    }
    i -= 1;
  }
  return -1;
}

fn edge_copies(c: *WFnCtx, from: *IRBlock, t: *IRBlock) {
  let mut p: usize = 0;
  while p < len(t.phis) {
    let phi: *IRPhi = t.phis[p];
    let mut k: usize = 0;
    while k < len(phi.preds) {
      if phi.preds[k] == from {
        lget(c, phi.args[k]);
        lset(c, phi.dst);
      }
      k += 1;
    }
    p += 1;
  }
}

fn wasm_br(c: *WFnCtx, from: *IRBlock, t: *IRBlock) {
  edge_copies(c, from, t);
  let mut d: i32 = br_depth(c, t);
  if d < 0 {
    d = 0;
  }
  b8(c.body, 0x0C);
  buleb(c.body, d as u64);
}

// emits blocks from `b` (reached from `from`) until the region branches
// out or returns; returns the block the region branched to, or NULL.
fn emit_region_run(c: *WFnCtx, b_in: *IRBlock, from_in: *IRBlock) {
  let mut b: *IRBlock = b_in;
  let mut from: *IRBlock = from_in;
  let mut guard: i32 = 0;
  while b != null && !b.emitted && !has_target(c, b) && guard < 4096 {
    guard += 1;
    let next: *IRBlock = emit_region(c, b, from);
    from = b;
    b = next;
  }
}

fn emit_region(c: *WFnCtx, b_in: *IRBlock, from_in: *IRBlock) -> *IRBlock {
  let mut started_loop: bool = false; // this invocation opened the loop labels
  let mut my_header: *IRBlock = null;
  let mut my_exit: *IRBlock = null;
  let mut from: *IRBlock = from_in;
  let mut b: *IRBlock = b_in;
  while b != null {
    if b.emitted || has_target(c, b) {
      wasm_br(c, from, b);
      return b;
    }
    if b.loop_header {
      // block $exit { loop $h { <body>; } } — the header's own term is
      // dispatched generically below; the body's terminal br back to the
      // header closes the loop, br to the exit breaks out
      my_exit = b.loop_exit;
      my_header = b;
      push_label_n(c, 0, my_exit); // block $exit
      push_label_n(c, 1, my_header); // loop $h
      b8(c.body, 0x02); // block
      b8(c.body, 0x40);
      b8(c.body, 0x03); // loop
      b8(c.body, 0x40);
      started_loop = true;
    }
    b.emitted = true;
    let mut k: usize = 0;
    while k < len(b.ins) {
      emit_ins(c, b.ins[k]);
      k += 1;
    }
    if b.term_op == 0 {
      if started_loop {
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
      }
      return null;
    }
    if b.term_op == 100 {
      let t: *IRBlock = b.br_true;
      // forward entry into a not-yet-emitted loop becomes the construct
      if t.loop_header && !t.emitted {
        from = b;
        b = t;
        continue;
      }
      if t == my_header && started_loop {
        // back edge: repeat the loop
        wasm_br(c, b, t);
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
        if my_exit == null {
          return null;
        }
        from = b;
        b = my_exit;
        started_loop = false;
        my_header = null;
        my_exit = null;
        continue;
      }
      if inlineable(c, t) {
        from = b;
        b = t;
        continue;
      }
      wasm_br(c, b, t);
      if started_loop && t == my_exit {
        // break: leave the loop, the exit's code follows in the caller
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
        return t;
      }
      return t;
    }
    if b.term_op == 102 {
      // restore the shadow stack to the caller's base ($fb + frame), then
      // return (value stays on the stack)
      b8(c.body, 0x20);
      buleb(c.body, fb_local(c) as u64);
      i32c(c, c.frame);
      b8(c.body, 0x6A); // i32.add — $fb + frame = caller's base
      b8(c.body, 0x24); // global.set 0 ($sp)
      buleb(c.body, 0);
      if b.ret_val != null {
        lget(c, b.ret_val);
      }
      b8(c.body, 0x0F); // return
      if started_loop {
        b8(c.body, 0x0B); // end loop (lexically required)
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
      }
      return null;
    }
    // cbr: if { then } else { else }; both arms land on the join via br,
    // whose label/code lives with the first diamond that claimed it.
    let t2: *IRBlock = b.br_true;
    let f2: *IRBlock = b.br_false;
    let mut join: *IRBlock = null;
    if b.join_hint != null {
      join = b.join_hint;
    } else {
      join = chain_terminal(c, t2);
      let join2: *IRBlock = chain_terminal(c, f2);
      if join != join2 {
        // the true join is the deeper terminal the other side reaches
        if join != null && join2 != null && reaches(c, join, join2, 0) {
          join = join2;
        } else {
          if join == null {
            join = join2;
          }
        }
      }
    }
    let mut claimed: bool = false;
    if join != null && !has_target(c, join) && !join.emitted {
      c.claims = push_claim(c.claims, new WClaim { b: join, base: len(c.labels) as i32 });
      claimed = true;
    }
    push_label_n(c, 2, null); // the anonymous if occupies a br depth
    lget(c, b.cbr_cond);
    b8(c.body, 0x04); // if
    b8(c.body, 0x40); // void blocktype
    emit_region_run(c, t2, b);
    b8(c.body, 0x05); // else
    emit_region_run(c, f2, b);
    b8(c.body, 0x0B); // end if
    pop_label(c);     // drop the if placeholder
    if join == null {
      if started_loop {
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
      }
      return null; // both arms returned
    }
    if join.emitted {
      if claimed {
        pop_claim(c); // ours went stale the moment it was emitted
      }
      if started_loop && join == my_exit {
        // a break-if: both arms already br'd; close the loop, emit exit
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
        started_loop = false;
        my_header = null;
        my_exit = null;
        from = b;
        b = join;
        continue;
      }
      return join; // an earlier construct emitted it
    }
    if !claimed {
      if started_loop && join == my_exit {
        // break-if against this loop's exit: close and continue at exit
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
        started_loop = false;
        my_header = null;
        my_exit = null;
        from = b;
        b = join;
        continue;
      }
      return join; // an enclosing construct owns the join and its code
    }
    pop_claim(c); // our claim: the join's code follows right here
    from = b;
    b = join;
  }
  return null;
}

// collect each vreg's IRType: one def instruction, or a block phi
fn vreg_type(fn_: *IRFn, id: i32) -> IRType {
  let mut b: usize = 0;
  while b < len(fn_.blocks) {
    let blk: *IRBlock = fn_.blocks[b];
    let mut p: usize = 0;
    while p < len(blk.phis) {
      let phi: *IRPhi = blk.phis[p];
      if phi.dst.id == id {
        return phi.dst.ty;
      }
      p += 1;
    }
    let mut k: usize = 0;
    while k < len(blk.ins) {
      let i: *IRIns = blk.ins[k];
      if i.dst != null && i.dst.id == id {
        return i.dst.ty;
      }
      k += 1;
    }
    b += 1;
  }
  return IRType.ItI32;
}

static mut fb_ctx: *WFnCtx = 0 as *WFnCtx;

fn emit_fn_body(wf: *WFn) -> *Vec[u8] {
  let fn_: *IRFn = wf.fn_;
  let c: *WFnCtx = new WFnCtx {
    fn_: fn_, body: new Vec[u8] { items: make([]u8, 4096), n: 0 },
    slot_off: make([]i64, 0), frame: 0, hidden: 0,
    labels: make([]*WLabel, 0), claims: make([]*WClaim, 0),
  };
  fb_ctx = c;

  // frame layout first (slots), then locals for every vreg
  let mut i: usize = 0;
  while i < len(fn_.slots) {
    slot_offset(c, fn_.slots[i]);
    i += 1;
  }

  if fn_.returns_aggregate {
    c.hidden = 1;
  }
  // prologue: $sp -= frame; $fb = $sp — slots live at $fb + off inside
  // [fb, fb+frame), safely below every live caller frame
  b8(c.body, 0x23); // global.get 0 ($sp)
  buleb(c.body, 0);
  i32c(c, c.frame);
  b8(c.body, 0x6B); // i32.sub
  b8(c.body, 0x22); // local.tee $fb — set it AND keep the value for $sp
  buleb(c.body, (len(fn_.params) as i64 + c.hidden as i64) as u64);
  b8(c.body, 0x24); // global.set 0 ($sp)
  buleb(c.body, 0);
  // the hidden out pointer (agg returns): save signature local 0 (the out
  // ptr) into the frame's out slot — wasm stores take address FIRST
  if c.hidden != 0 {
    b8(c.body, 0x20); // local.get $fb
    buleb(c.body, (len(fn_.params) as i64 + c.hidden as i64) as u64);
    i32c(c, slot_offset(c, fn_.out_slot));
    b8(c.body, 0x6A); // i32.add — address = $fb + off
    b8(c.body, 0x20); // local.get 0 (out ptr) — value second
    buleb(c.body, 0);
    b8(c.body, 0x36); // i32.store
    buleb(c.body, 2);
    buleb(c.body, 0);
  }

  // incoming params: store each wasm param local into its frame slot
  i = 0;
  while i < len(fn_.params) {
    let ps: *IRSlot = fn_.params[i];
    let mut pt: *Type = null;
    if i < len(fn_.param_types) {
      pt = fn_.param_types[i];
    }
    let agg: bool = ty_travels_as_ptr(pt);
    // wasm store operand order: address first, value second
    b8(c.body, 0x20); // local.get $fb
    buleb(c.body, (len(fn_.params) as i64 + c.hidden as i64) as u64);
    i32c(c, slot_offset(c, ps));
    b8(c.body, 0x6A); // i32.add — address = $fb + off
    b8(c.body, 0x20);
    buleb(c.body, (i as i64 + c.hidden as i64) as u64); // local.get <param i>
    // the pointer/aggregate handle itself lives in the slot
    let mut it: IRType = IRType.ItPtr;
    if !agg && pt != null {
      it = ir_type_of(pt);
    }
    if it == IRType.ItF64 {
      b8(c.body, 0x39);
      buleb(c.body, 3);
    } else if it == IRType.ItF32 {
      b8(c.body, 0x38);
      buleb(c.body, 2);
    } else if w_is64(it) {
      b8(c.body, 0x37);
      buleb(c.body, 3);
    } else {
      b8(c.body, 0x36); // i32.store (also pointers)
      buleb(c.body, 2);
    }
    buleb(c.body, 0);
    i += 1;
  }

  emit_region_run(c, fn_.entry, fn_.entry);
  b8(c.body, 0x0B); // end function body
  return c.body;
}

fn emit_wasm() -> []u8 {
  let out: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 16), n: 0 };
  if g_ir_fns.n == 0 {
    return out.items;
  }

  W = new WState {
    fns: make([]*WFn, 0), types: make([]*WType, 0), type_keys: make([]string, 0),
    fn_by_symbol: new WFnMap { items: make([]*WFnEnt, 0) },
    table_idx: new I64Map { items: make([]*I64Ent, 0) },
    table_fns: make([]string, 0),
    global_addr: new I64Map { items: make([]*I64Ent, 0) },
    lit_addr: new I64Map { items: make([]*I64Ent, 0) },
    heap_base: 0, stack_top: 0, data_end: 0,
  };

  // register the two import signatures FIRST: sections are serialized in
  // order, so anything w_type_for adds during import assembly would land
  // past the already-written type section
  {
    let mut p: []i64 = make([]i64, 0);
    let mut k: i32 = 0;
    while k < 4 {
      p = push_i64(p, IRType.ItI32 as i64);
      k += 1;
    }
    w_type_for(p, true, IRType.ItI32); // fd_write
    p = make([]i64, 0);
    p = push_i64(p, IRType.ItI32 as i64);
    w_type_for(p, false, IRType.ItI32); // proc_exit
  }

  // function table (indices 0,1 are the wasi imports)
  let mut i: usize = 0;
  while i < g_ir_fns.n {
    eprint("[fn ");
    eprint(g_ir_fns.items[i].symbol);
    eprint("]\n");
    let fn_: *IRFn = g_ir_fns.items[i];
    fn_.uid = i as i32;
    let wf: *WFn = new WFn {
      fn_: fn_, index: (2 + i) as i32, type_: w_type_of_fn(fn_),
    };
    W.fns = push_wfn(W.fns, wf);
    fm_put(W.fn_by_symbol, fn_.symbol, wf);
    i += 1;
  }
  eprint("[Wfns ");
  eprint(itoa(len(W.fns) as i64));
  eprint(" ir=");
  eprint(itoa(g_ir_fns.n as i64));
  eprint("]\n");
  w_layout_data();

  // address-taken functions need table entries: scan every instruction
  i = 0;
  while i < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[i];
    let mut b: usize = 0;
    while b < len(fn_.blocks) {
      let blk: *IRBlock = fn_.blocks[b];
      let mut k: usize = 0;
      while k < len(blk.ins) {
        let ins: *IRIns = blk.ins[k];
        if ins.op == IROp.IrAddrc && ins.lit == -1 && ins.callee != "" &&
           ir_fn_for_symbol(ins.callee) != null {
          table_index_of(ins.callee);
        }
        k += 1;
      }
      b += 1;
    }
    i += 1;
  }

  // ---- assemble the module ----
  let typesec: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
  let importsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
  let funcsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 1024), n: 0 };
  let tablesec: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
  let memsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
  let globsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
  let exportsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 64), n: 0 };
  let elemsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
  let codesec: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 16), n: 0 };
  let datasec: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 12), n: 0 };

  // type section
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
    buleb(body, len(W.types) as u64);
    let mut ti: usize = 0;
    while ti < len(W.types) {
      let t: *WType = W.types[ti];
      b8(body, 0x60);
      buleb(body, len(t.params) as u64);
      let mut k2: usize = 0;
      while k2 < len(t.params) {
        b8(body, w_vt_i(t.params[k2]));
        k2 += 1;
      }
      if t.has_ret {
        buleb(body, 1);
        b8(body, w_vt_i(t.ret as i64));
      } else {
        buleb(body, 0);
      }
      ti += 1;
    }
    bsection(typesec, 1, body);
  }

  // import section: fd_write, proc_exit
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 128), n: 0 };
    buleb(body, 2);
    bstr(body, "wasi_snapshot_preview1");
    bstr(body, "fd_write");
    b8(body, 0x00); // func
    {
      let mut p: []i64 = make([]i64, 0);
      let mut k3: i32 = 0;
      while k3 < 4 {
        p = push_i64(p, IRType.ItI32 as i64);
        k3 += 1;
      }
      buleb(body, w_type_for(p, true, IRType.ItI32) as u64);
    }
    bstr(body, "wasi_snapshot_preview1");
    bstr(body, "proc_exit");
    b8(body, 0x00);
    {
      let mut p: []i64 = make([]i64, 0);
      p = push_i64(p, IRType.ItI32 as i64);
      buleb(body, w_type_for(p, false, IRType.ItI32) as u64);
    }
    bsection(importsec, 2, body);
  }

  // function section
  {
    eprint("[funcsec fns=");
    eprint(itoa(len(W.fns) as i64));
    eprint("]\n");
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 4096), n: 0 };
    buleb(body, (len(W.fns) + 1) as u64); // + _start
    let mut fi: usize = 0;
    while fi < len(W.fns) {
      buleb(body, W.fns[fi].type_ as u64);
      fi += 1;
    }
    // _start: () -> ()
    {
      let p: []i64 = make([]i64, 0);
      buleb(body, w_type_for(p, false, IRType.ItI32) as u64);
    }
    bsection(funcsec, 3, body);
  }

  // table section: always present — rc_dec's drop-glue call_indirect needs
  // table 0 to exist even in programs that never take a function address
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
    buleb(body, 1);
    b8(body, 0x70); // funcref
    b8(body, 0x00); // min only
    let mut n: u64 = 1;
    if len(W.table_fns) > 0 {
      n = len(W.table_fns) as u64;
    }
    buleb(body, n);
    bsection(tablesec, 4, body);
  }

  // memory section
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
    let min_pages: u64 = ((W.stack_top + 0xFFFF) / 0x10000 + 1) as u64;
    buleb(body, 1);
    b8(body, 0x00);
    buleb(body, min_pages);
    bsection(memsec, 5, body);
  }

  // global section: $sp (mut i32) = stack top
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
    buleb(body, 1);
    b8(body, 0x7F); // i32
    b8(body, 0x01); // mutable
    b8(body, 0x41); // i32.const
    bsleb(body, W.stack_top);
    b8(body, 0x0B); // end
    bsection(globsec, 6, body);
  }

  // export section: memory + _start
  let start_index: i64 = 2 + len(W.fns) as i64;
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 64), n: 0 };
    buleb(body, 2);
    bstr(body, "memory");
    b8(body, 0x02); // memory
    buleb(body, 0);
    bstr(body, "_start");
    b8(body, 0x00); // func
    buleb(body, start_index as u64);
    bsection(exportsec, 7, body);
  }

  // element section
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
    buleb(body, 1);
    buleb(body, 0); // table 0
    b8(body, 0x41); // i32.const 0
    bsleb(body, 0);
    b8(body, 0x0B);
    buleb(body, len(W.table_fns) as u64);
    let mut ei: usize = 0;
    while ei < len(W.table_fns) {
      let sym: string = W.table_fns[ei];
      let t: *WFn = fm_get(W.fn_by_symbol, sym);
      let mut idx: u64 = 0;
      if t != null {
        idx = t.index as u64;
      }
      buleb(body, idx);
      ei += 1;
    }
    bsection(elemsec, 9, body);
  }

  // code section: [locals decl][body] per function, size-prefixed
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 16), n: 0 };
    buleb(body, (len(W.fns) + 1) as u64);
    let mut ci: usize = 0;
    while ci < len(W.fns) {
      let wf: *WFn = W.fns[ci];
      let fn_: *IRFn = wf.fn_;
      let code: *Vec[u8] = emit_fn_body(wf);
      // locals: one group per local so indices stay params, $fb, then
      // vregs in id order. The signature carries the declared params (plus
      // the hidden out ptr FIRST for agg returns); this decl covers $fb
      // and the vregs only.
      let entry: *Vec[u8] = new Vec[u8] { items: make([]u8, 1024), n: 0 };
      buleb(entry, (1 + fn_.next_vreg) as u64);
      buleb(entry, 1);
      b8(entry, 0x7F); // $fb
      let mut v: i32 = 0;
      while v < fn_.next_vreg {
        buleb(entry, 1);
        b8(entry, w_vt(vreg_type(fn_, v)));
        v += 1;
      }
      bappend(entry, code);
      buleb(body, entry.n as u64);
      bappend(body, entry);
      ci += 1;
    }
    // _start: call main; exit status & 0xFF (POSIX truncation, so main
    // returning 1111 exits 87 exactly like a native process); proc_exit
    {
      let entry: *Vec[u8] = new Vec[u8] { items: make([]u8, 32), n: 0 };
      buleb(entry, 0); // no locals
      let mainf: *WFn = fm_get(W.fn_by_symbol, g_main_cell.items[0]);
      b8(entry, 0x10);
      let mut midx: u64 = 0;
      if mainf != null {
        midx = mainf.index as u64;
      }
      buleb(entry, midx);
      b8(entry, 0x41); // i32.const 255
      b8(entry, 0xFF);
      b8(entry, 0x01);
      b8(entry, 0x71); // i32.and
      b8(entry, 0x10);
      buleb(entry, 1); // proc_exit
      b8(entry, 0x0B); // (unreachable after proc_exit, but valid)
      buleb(body, entry.n as u64);
      bappend(body, entry);
    }
    bsection(codesec, 10, body);
  }

  // data section: statics + literals (24B immortal header + bytes)
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 12), n: 0 };
    let mut count: u64 = 0;
    let mut g: usize = 0;
    while g < g_ir_globals.n {
      let gl: *IRGlobal = g_ir_globals.items[g];
      if !gl.is_extern && len(gl.init) > 0 {
        count += 1;
      }
      g += 1;
    }
    let mut f2: usize = 0;
    while f2 < g_ir_fns.n {
      count += len(g_ir_fns.items[f2].literals) as u64;
      f2 += 1;
    }
    buleb(body, count);
    g = 0;
    while g < g_ir_globals.n {
      let gl: *IRGlobal = g_ir_globals.items[g];
      if gl.is_extern || len(gl.init) == 0 {
        g += 1;
        continue;
      }
      buleb(body, 0); // memory 0
      b8(body, 0x41);
      bsleb(body, im_get(W.global_addr, gl.symbol));
      b8(body, 0x0B);
      buleb(body, len(gl.init) as u64);
      let mut bi: usize = 0;
      while bi < len(gl.init) {
        b8(body, gl.init[bi]);
        bi += 1;
      }
      g += 1;
    }
    f2 = 0;
    while f2 < g_ir_fns.n {
      let fn_: *IRFn = g_ir_fns.items[f2];
      let mut l: usize = 0;
      while l < len(fn_.literals) {
        let lit: *IRLit = fn_.literals[l];
        buleb(body, 0);
        b8(body, 0x41);
        bsleb(body, im_get(W.lit_addr, lit.label));
        b8(body, 0x0B);
        buleb(body, (24 + len(lit.bytes)) as u64);
        // 24-byte immortal rc header: {sentinel, 0, 0}
        let mut k4: i32 = 0;
        while k4 < 24 {
          if k4 == 7 {
            b8(body, 0x80); // little-endian sentinel top byte
          } else {
            b8(body, 0);
          }
          k4 += 1;
        }
        let mut byi: usize = 0;
        while byi < len(lit.bytes) {
          b8(body, lit.bytes[byi]);
          byi += 1;
        }
        l += 1;
      }
      f2 += 1;
    }
    bsection(datasec, 11, body);
  }

  // module header + sections in order
  b8(out, 0);
  b8(out, 0x61); // 'a'
  b8(out, 0x73); // 's'
  b8(out, 0x6D); // 'm'
  b8(out, 1);
  b8(out, 0);
  b8(out, 0);
  b8(out, 0);
  bappend(out, typesec);
  bappend(out, importsec);
  bappend(out, funcsec);
  bappend(out, tablesec);
  bappend(out, memsec);
  bappend(out, globsec);
  bappend(out, exportsec);
  bappend(out, elemsec);
  bappend(out, codesec);
  bappend(out, datasec);
  return out.items[0..out.n];
}

fn push_wfn(items: []*WFn, w: *WFn) -> []*WFn {
  let out: []*WFn = make([]*WFn, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = w;
  return out;
}

fn bytes_as_string(b: []u8) -> string {
  return intrinsics.slice_string(b);
}

// debug: dump IR fns (mirrors boot's RHO_DUMP_IR shape, keys off --dump-ir)
static mut g_dump_ir: bool = false;

fn op_name(op: i32) -> string {
  if op == 100 { return "br"; }
  if op == 101 { return "cbr"; }
  if op == 102 { return "ret"; }
  if op == 0 { return "const"; }
  if op == 1 { return "fconst"; }
  if op == 2 { return "add"; }
  if op == 3 { return "sub"; }
  if op == 4 { return "mul"; }
  if op == 5 { return "div"; }
  if op == 6 { return "mod"; }
  if op == 7 { return "and"; }
  if op == 8 { return "or"; }
  if op == 9 { return "xor"; }
  if op == 10 { return "shl"; }
  if op == 11 { return "shr"; }
  if op == 12 { return "cmp"; }
  if op == 13 { return "load"; }
  if op == 14 { return "store"; }
  if op == 15 { return "addrc"; }
  if op == 16 { return "addi"; }
  if op == 17 { return "call"; }
  if op == 18 { return "cast"; }
  if op == 19 { return "copymem"; }
  if op == 20 { return "zero"; }
  if op == 21 { return "litaddr"; }
  return "?";
}

fn lower_dump_ir() {
  let mut i: usize = 0;
  while i < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[i];
    eprint("fn ");
    eprint(fn_.symbol);
    eprint("\n");
    let mut si: usize = 0;
    while si < len(fn_.slots) {
      eprint("  slot ");
      eprint(itoa(fn_.slots[si].id as i64));
      eprint(" size=");
      eprint(itoa(fn_.slots[si].size));
      eprint(" name=");
      eprint(fn_.slots[si].name);
      eprint("\n");
      si += 1;
    }
    let mut b: usize = 0;
    while b < len(fn_.blocks) {
      let blk: *IRBlock = fn_.blocks[b];
      eprint(" block ");
      eprint(itoa(blk.id as i64));
      eprint("\n");
      let mut p: usize = 0;
      while p < len(blk.phis) {
        let phi: *IRPhi = blk.phis[p];
        eprint("  phi v");
        eprint(itoa(phi.dst.id as i64));
        eprint(" nargs=");
        eprint(itoa(len(phi.args) as i64));
        eprint("\n");
        p += 1;
      }
      let mut k: usize = 0;
      while k < len(blk.ins) {
        let ins: *IRIns = blk.ins[k];
        eprint("  ");
        eprint(op_name(ins.op as i32));
        if ins.dst != null {
          eprint(" d=");
          eprint(itoa(ins.dst.id as i64));
        }
        if ins.a != null {
          eprint(" a=");
          eprint(itoa(ins.a.id as i64));
        }
        if ins.b != null {
          eprint(" b=");
          eprint(itoa(ins.b.id as i64));
        }
        if ins.addr != null {
          eprint(" @");
          eprint(itoa(ins.addr.id as i64));
        }
        if ins.slot != null {
          eprint(" s");
          eprint(itoa(ins.slot.id as i64));
        }
        if ins.callee != "" {
          eprint(" call=");
          eprint(ins.callee);
        }
        if ins.op == IROp.IrConst || ins.op == IROp.IrAddi {
          eprint(" imm=");
          eprint(itoa(ins.imm));
        }
        if ins.size != 0 {
          eprint(" sz=");
          eprint(itoa(ins.size));
        }
        eprint("\n");
        k += 1;
      }
      if blk.term_op != 0 {
        eprint("  term ");
        eprint(op_name(blk.term_op));
        if blk.term_op == 101 {
          eprint(" cond=v");
          eprint(itoa(blk.cbr_cond.id as i64));
          eprint(" then=B");
          eprint(itoa(blk.br_true.id as i64));
          eprint(" else=B");
          eprint(itoa(blk.br_false.id as i64));
        }
        if blk.term_op == 100 {
          eprint(" to=B");
          eprint(itoa(blk.br_true.id as i64));
        }
        if blk.term_op == 102 && blk.ret_val != null {
          eprint(" v=");
          eprint(itoa(blk.ret_val.id as i64));
        }
        eprint("\n");
      }
      b += 1;
    }
    i += 1;
  }
}

// ============== generic fn instantiation (check.c port L7) =================

// ---- declaration cloning (instantiation bodies) ----------------------------

fn clone_typeast(t: *TypeAst) -> *TypeAst {
  if t == null {
    return null;
  }
  let c: *TypeAst = new TypeAst {
    kind: t.kind, prim: t.prim, path: t.path, targs: t.targs, elem: t.elem,
    params: t.params, ret: t.ret, size: t.size,
  };
  // deep-copy the recursive fields; path/string payloads are immutable
  let mut ta: *Vec[*TypeAst] = new Vec[*TypeAst] { items: make([]*TypeAst, 4), n: 0 };
  let mut i: usize = 0;
  while i < t.targs.n {
    ta.push(clone_typeast(t.targs.items[i]));
    i += 1;
  }
  c.targs = ta;
  let mut tp: *Vec[*TypeAst] = new Vec[*TypeAst] { items: make([]*TypeAst, 4), n: 0 };
  i = 0;
  while i < t.params.n {
    tp.push(clone_typeast(t.params.items[i]));
    i += 1;
  }
  c.params = tp;
  c.elem = clone_typeast(t.elem);
  c.ret = clone_typeast(t.ret);
  c.size = clone_expr(t.size);
  return c;
}

fn clone_fieldast(f: *FieldAst) -> *FieldAst {
  if f == null {
    return null;
  }
  return new FieldAst {
    name: f.name, ty: clone_typeast(f.ty), file: f.file, line: f.line, col: f.col,
  };
}

fn clone_param(p: *Param) -> *Param {
  if p == null {
    return null;
  }
  return new Param {
    name: p.name, ty: clone_typeast(p.ty), is_self: p.is_self,
    file: p.file, line: p.line, col: p.col,
  };
}

fn clone_arm(a: *MatchArm) -> *MatchArm {
  if a == null {
    return null;
  }
  let mut pf: *Vec[*FieldAst] = new Vec[*FieldAst] { items: make([]*FieldAst, 4), n: 0 };
  let mut i: usize = 0;
  while i < a.pat_fields.n {
    pf.push(clone_fieldast(a.pat_fields.items[i]));
    i += 1;
  }
  return new MatchArm {
    pk: a.pk, pat_path: a.pat_path, pat_int: a.pat_int, variant_index: a.variant_index,
    disc: a.disc, pat_str: a.pat_str, pat_names: a.pat_names, pat_fields: pf,
    bind_syms: make([]*Sym, 0), bind_fidx: make([]i64, 0),
    body: clone_expr(a.body), file: a.file, line: a.line, col: a.col,
  };
}

fn clone_stmt(s: *Stmt) -> *Stmt {
  if s == null {
    return null;
  }
  let c: *Stmt = new Stmt {
    kind: s.kind, file: s.file, line: s.line, col: s.col, pre: s.pre,
    mut_: s.mut_, tail: s.tail, name: s.name, ty: clone_typeast(s.ty),
    a: clone_expr(s.a), b: clone_expr(s.b), assign_op: s.assign_op,
    stmts: new Vec[*Stmt] { items: make([]*Stmt, 4), n: 0 },
    cond: clone_expr(s.cond),
    body: new Vec[*Stmt] { items: make([]*Stmt, 4), n: 0 },
  };
  let mut i: usize = 0;
  while i < s.stmts.n {
    c.stmts.push(clone_stmt(s.stmts.items[i]));
    i += 1;
  }
  i = 0;
  while i < s.body.n {
    c.body.push(clone_stmt(s.body.items[i]));
    i += 1;
  }
  return c;
}

fn clone_expr(e: *Expr) -> *Expr {
  if e == null {
    return null;
  }
  let c: *Expr = new Expr {
    kind: e.kind, file: e.file, line: e.line, col: e.col,
    iv: e.iv, fv: e.fv, sv: e.sv, bv: e.bv,
    a: clone_expr(e.a), b: clone_expr(e.b), c: clone_expr(e.c),
    binop: e.binop, unop: e.unop,
    args: new Vec[*Expr] { items: make([]*Expr, 4), n: 0 },
    arg_names: e.arg_names,
    ty: clone_typeast(e.ty),
    arms: new Vec[*MatchArm] { items: make([]*MatchArm, 4), n: 0 },
    params: new Vec[*Param] { items: make([]*Param, 4), n: 0 },
    ret: clone_typeast(e.ret),
    q_ok: e.q_ok, q_err: e.q_err, else_if: clone_expr(e.else_if),
    fnval: e.fnval, caps: make([]*Sym, 0),
    items: new Vec[*Stmt] { items: make([]*Stmt, 4), n: 0 },
    typed: null, sym: null,
  };
  let mut i: usize = 0;
  while i < e.args.n {
    c.args.push(clone_expr(e.args.items[i]));
    i += 1;
  }
  i = 0;
  while i < e.arms.n {
    c.arms.push(clone_arm(e.arms.items[i]));
    i += 1;
  }
  i = 0;
  while i < e.params.n {
    c.params.push(clone_param(e.params.items[i]));
    i += 1;
  }
  // NEW field lists: name entries in items alongside args
  if e.kind == ExprKind.ExNew {
    i = 0;
    while i < e.items.n {
      let entry: *Stmt = e.items.items[i];
      let nc: *Stmt = new Stmt {
        kind: StmtKind.StBlock, file: entry.file, line: entry.line, col: entry.col,
        pre: entry.pre, mut_: false, tail: false, name: entry.name, ty: null,
        a: null, b: null, assign_op: entry.assign_op,
        stmts: new Vec[*Stmt] { items: make([]*Stmt, 0), n: 0 },
        cond: null, body: new Vec[*Stmt] { items: make([]*Stmt, 0), n: 0 },
      };
      c.items.push(nc);
      i += 1;
    }
  } else {
    i = 0;
    while i < e.items.n {
      c.items.push(clone_stmt(e.items.items[i]));
      i += 1;
    }
  }
  return c;
}

fn clone_fn_decl(d: *Decl) -> *Decl {
  let c: *Decl = new Decl {
    kind: DeclKind.DkFn, file: d.file, line: d.line, col: d.col, pre: d.pre,
    pub_: d.pub_, is_mut: d.is_mut, name: d.name,
    path: d.path,
    params: new Vec[*Param] { items: make([]*Param, 4), n: 0 },
    ret: clone_typeast(d.ret),
    fields: d.fields, variants: d.variants, init: d.init,
    body: new Vec[*Stmt] { items: make([]*Stmt, 8), n: 0 },
    tparams: make_str_vec(), is_method: d.is_method, recv: d.recv,
    decls: d.decls, templ: null,
    templated: false, tenv: null, owner: null,
    ceval_ok: false, ceval_is_int: false, ceval_i: 0, ceval_f: 0.0,
  };
  let mut i: usize = 0;
  while i < d.params.n {
    c.params.push(clone_param(d.params.items[i]));
    i += 1;
  }
  i = 0;
  while i < d.body.n {
    c.body.push(clone_stmt(d.body.items[i]));
    i += 1;
  }
  return c;
}

// ---- instantiation ---------------------------------------------------------

static mut g_instantiations: *Vec[*Sym] = 0 as *Vec[*Sym]; // pending body checks
static mut g_instantiated_names: *Vec[string] = 0 as *Vec[string]; // mangled keys
static mut g_instantiated_syms: *Vec[*Sym] = 0 as *Vec[*Sym];
static mut g_instantiation_depth: i32 = 0;

fn make_str_vec() -> *Vec[string] {
  return new Vec[string] { items: make([]string, 8), n: 0 };
}

fn instantiated_get(mangled: string) -> *Sym {
  if g_instantiated_names == null {
    return null;
  }
  let mut i: usize = 0;
  while i < g_instantiated_names.n {
    if streq(g_instantiated_names.items[i], mangled) {
      return g_instantiated_syms.items[i];
    }
    i += 1;
  }
  return null;
}

// resolve a cloned fn symbol's signature under its tenv (boot resolve_sym_type)
fn resolve_inst_signature(sym: *Sym) {
  let d: *Decl = sym.decl;
  let saved_env: *TypeMap = g_tenv;
  let saved_mod: *Module = cur_module;
  cur_module = sym.owner;
  g_tenv = d.tenv;
  let mut ps: []*Type = fresh_type_vec2();
  let mut i: usize = 0;
  while i < d.params.n {
    ps = push_type(ps, resolve_type_in_module(sym.owner, d.params.items[i].ty));
    i += 1;
  }
  let ret: *Type = resolve_type_in_module(sym.owner, d.ret);
  sym.type = ty_fn(ps, ret);
  eprint("[CLONESIG ");
  eprint(sym.name);
  eprint(" p0=");
  if len(ps) > 0 && ps[0] != null { eprint(ps[0].mangled); } else { eprint("null"); }
  eprint(" ret=");
  if ret != null { eprint(ret.mangled); } else { eprint("null"); }
  eprint("\n");
  g_tenv = saved_env;
  cur_module = saved_mod;
}

fn instantiate_fn(gsym: *Sym, names: []string, env: *TypeMap) -> *Sym {
  let d: *Decl = gsym.decl;
  // mangle in the canonical parameter order so the name is deterministic
  let mut mangled: string = cat3(d.name, "$", "");
  let mut i: usize = 0;
  while i < len(names) {
    let targ: *Type = tm_get(env, names[i]);
    if i > 0 {
      mangled = cat3(mangled, ",", "");
    }
    if targ == null || targ.kind == TypeKind.TyParam {
      err_at("", 0, 0, cat3("cannot infer `", cat3(names[i], "` for `", cat3(d.name, "`", "")), ""));
      return gsym;
    }
    let mut targ2: *Type = targ;
    if targ2.kind == TypeKind.TyIntLit {
      targ2 = ty_prim(3); // i32
    }
    if targ2.kind == TypeKind.TyFloatLit {
      targ2 = ty_prim(10); // f64
    }
    tm_put(env, names[i], targ2);
    mangled = cat3(mangled, targ2.mangled, "");
    i += 1;
  }
  let existing: *Sym = instantiated_get(mangled);
  if existing != null {
    return existing;
  }
  g_instantiation_depth += 1;
  if g_instantiation_depth > 256 {
    err_at("", 0, 0, "generic instantiation nesting too deep (recursive generics?)");
    g_instantiation_depth -= 1;
    return gsym;
  }
  let clone: *Decl = clone_fn_decl(d);
  clone.name = mangled;
  clone.tenv = env;
  clone.owner = gsym.owner;
  let sym: *Sym = new Sym {
    kind: SymKind.SyFn, name: mangled, type: null, decl: clone,
    mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: gsym.owner,
  };
  if g_instantiated_names == null {
    g_instantiated_names = new Vec[string] { items: make([]string, 64), n: 0 };
    g_instantiated_syms = new Vec[*Sym] { items: make([]*Sym, 64), n: 0 };
  }
  g_instantiated_names.push(mangled);
  g_instantiated_syms.push(sym);
  let saved_mod: *Module = cur_module;
  let saved_env: *TypeMap = g_tenv;
  cur_module = gsym.owner;
  g_tenv = env;
  resolve_inst_signature(sym);
  g_tenv = saved_env;
  cur_module = saved_mod;
  // register the instantiation in the owner module's symbol table so lower
  // emits it (boot: map_put(&owner->syms, mangled, sym))
  sm_put(gsym.owner.syms, mangled, sym);
  if g_instantiations == null {
    g_instantiations = new Vec[*Sym] { items: make([]*Sym, 64), n: 0 };
  }
  g_instantiations.push(sym);
  g_instantiation_depth -= 1;
  return sym;
}


