// rho — the self-hosted compiler (0.3.0 era; see docs/todo.md for the mirror).
//
// One file, one module: the whole compiler, written in the frozen 0.0.5
// language surface. Bootstrap invariant (spec §13): boot(self) == self(self)
// byte for byte, and boot(corpus) == self(corpus).
//
// Host IO rides the prelude's per-target hooks (__open/__read/__write/
// __close/__program_args/__can_spawn): over wasi_snapshot_preview1 on wasm,
// over the RT blob's syscall shims in freestanding images — the mirror's
// own externs moved off libSystem with the 0.3.2 image layer.

fn program_args() -> []string {
  return __program_args();
}

// read a NUL-terminated C string out of foreign memory
fn str_from_c(p: *u8) -> string {
  let mut n: usize = 0;
  loop {
    if intrinsics.load_u8((p as usize + n) as *u8) == 0 {
      break;
    }
    n += 1;
  }
  let buf: []u8 = make([]u8, n);
  let mut i: usize = 0;
  while i < n {
    buf[i] = intrinsics.load_u8((p as usize + i) as *u8);
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

// ---------------------------------------------------------------- bytes ---

// NUL-terminated copy for extern calls; returns the owning slice so the
// buffer outlives the call — a raw *u8 would dangle the moment this returns
fn cstr(s: string) -> []u8 {
  let buf: []u8 = make([]u8, len(s) + 1);
  let mut i: usize = 0;
  while i < len(s) {
    buf[i] = s[i];
    i += 1;
  }
  buf[len(s)] = 0;
  return buf;
}

fn itoa(v: i64) -> string {
  let buf: []u8 = make([]u8, 24);
  let mut n: usize = 24;
  let mut x: i64 = v;
  let neg: bool = x < 0;
  if neg {
    x = 0 - x;
  }
  loop {
    n -= 1;
    buf[n] = (48 + x % 10) as u8;
    x /= 10;
    if x == 0 {
      break;
    }
  }
  if neg {
    n -= 1;
    buf[n] = 45;
  }
  return intrinsics.slice_string(buf[n..24]);
}

// ---------------------------------------------------------------- vec ---

struct Vec[T] {
  items: []T,
  n: usize,
}

fn Vec.init(self: *Vec) {
  self.items = make([]T, 8);
  self.n = 0;
}

// growth through a helper: ownership transfers at the call boundary, which
// the rc machinery accounts cleanly
fn grow_to[T](items: []T) -> []T {
  let grown: []T = make([]T, len(items) * 2);
  let mut i: usize = 0;
  while i < len(items) {
    grown[i] = items[i];
    i += 1;
  }
  return grown;
}

fn Vec.push(self: *Vec, v: T) {
  if self.n == len(self.items) {
    self.items = grow_to(self.items);
  }
  self.items[self.n] = v;
  self.n += 1;
}

fn Vec.last(self: *Vec) -> T {
  return self.items[self.n - 1];
}

fn Vec.pop(self: *Vec) -> T {
  self.n -= 1;
  return self.items[self.n];
}

// ---------------------------------------------------------------- map ---

// Open-addressing string map, FNV-1a with a fixed seed: iteration follows
// insertion order via the keys vector, so compile output never depends on
// hash placement (spec §11.4).
struct Map[V] {
  slots: []*MapEnt[V],
  cap: usize,
  n: usize,
  keys: Vec[string],
}

struct MapEnt[V] {
  key: string,
  val: V,
  used: bool,
}

fn map_hash(s: string) -> usize {
  let mut h: u64 = 1469598103934665603;
  let mut i: usize = 0;
  while i < len(s) {
    h ^= s[i] as u64;
    h *= 1099511628211;
    i += 1;
  }
  return h as usize;
}

// get() is only valid after has(); there is no zero value of V
fn Map.get(self: *Map, key: string) -> V {
  assert(self.has(key));
  let mut i: usize = map_hash(key) & (self.cap - 1);
  while self.slots[i] != null {
    if streq(self.slots[i].key, key) {
      return self.slots[i].val;
    }
    i = (i + 1) & (self.cap - 1);
  }
  panic("map.get: missing key");
}

fn Map.has(self: *Map, key: string) -> bool {
  if self.cap == 0 {
    return false;
  }
  let mut i: usize = map_hash(key) & (self.cap - 1);
  while self.slots[i] != null {
    if streq(self.slots[i].key, key) {
      return true;
    }
    i = (i + 1) & (self.cap - 1);
  }
  return false;
}

fn Map.put(self: *Map, key: string, val: V) {
  if self.n * 10 >= self.cap * 7 {
    let ncap: usize = if self.cap == 0 { 16 } else { self.cap * 2 };
    let slots: []*MapEnt[V] = make([]*MapEnt[V], ncap);
    let old: []*MapEnt[V] = self.slots;
    let oldn: usize = self.cap;
    self.slots = slots;
    self.cap = ncap;
    self.n = 0;
    let mut i: usize = 0;
    while i < oldn {
      if old[i] != null {
        self.put(old[i].key, old[i].val);
      }
      i += 1;
    }
  }
  let mut i: usize = map_hash(key) & (self.cap - 1);
  while self.slots[i] != null {
    if streq(self.slots[i].key, key) {
      self.slots[i].val = val;
      return;
    }
    i = (i + 1) & (self.cap - 1);
  }
  let ent: *MapEnt[V] = new MapEnt[V] { key: key, val: val, used: true };
  self.slots[i] = ent;
  self.n += 1;
  self.keys.push(key);
}

fn streq(a: string, b: string) -> bool {
  if len(a) != len(b) {
    return false;
  }
  let mut i: usize = 0;
  while i < len(a) {
    if a[i] != b[i] {
      return false;
    }
    i += 1;
  }
  return true;
}

fn cat(a: string, b: string) -> string {
  let total: usize = len(a) + len(b);
  let buf: []u8 = make([]u8, total);
  // TEMP forensics: classify which bound fails when the self-compile trips
  // cat's own bounds check — short make (heap side) vs corrupt args (slots)
  if len(buf) != total {
    let s1: string = cat3("CATSHORT req=", itoa(total as i64), " got=");
    eprintf("{}", cat3(s1, itoa(len(buf) as i64), "\n"));
  }
  let mut i: usize = 0;
  while i < len(a) {
    if i >= len(buf) {
      eprintf("{}", cat3("CATA i=", itoa(i as i64), "\n"));
    }
    buf[i] = a[i];
    i += 1;
  }
  let mut j: usize = 0;
  while j < len(b) {
    if i + j >= len(buf) {
      eprintf("{}", cat3("CATB ij=", itoa((i + j) as i64), "\n"));
    }
    buf[i + j] = b[j];
    j += 1;
  }
  return intrinsics.slice_string(buf);
}

fn cat3(a: string, b: string, c: string) -> string {
  return cat(a, cat(b, c));
}

// ---------------------------------------------------------------- file io --

// grow in a helper: ownership transfers at the call boundary, which the
// rc machinery accounts cleanly (an in-loop let + reassignment does not)
fn grow(buf: []u8, cap: usize) -> []u8 {
  let grown: []u8 = make([]u8, cap * 2);
  let mut i: usize = 0;
  while i < cap {
    grown[i] = buf[i];
    i += 1;
  }
  return grown;
}

fn read_file(path: string) -> Result[string, string] {
  let pathz: []u8 = cstr(path);
  let fd: i32 = __open(pathz.ptr, 0, 0); // O_RDONLY
  if fd < 0 {
    return Result.Err(cat3("cannot open ", path, ""));
  }
  let mut cap: usize = 1 << 16;
  let mut buf: []u8 = make([]u8, cap);
  let mut n: usize = 0;
  loop {
    if n == cap {
      buf = grow(buf, cap);
      cap *= 2;
    }
    let got: isize = __read(fd, (buf.ptr as usize + n) as *u8, cap - n);
    if got <= 0 {
      break;
    }
    n += got as usize;
  }
  __close(fd);
  return Result.Ok(intrinsics.slice_string(buf[0..n]));
}

fn write_file(path: string, data: string) -> bool {
  // O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 on linux; 1|0x0200|0x0400 on mac.
  // The bootstrap targets arm64-mac first; keep the mac constants and let
  // the linux port adjust.
  // Every write lands on a fresh vnode via tmp+__rename: an in-place rewrite
  // of an ad-hoc-signed executable leaves the kernel's cached page-hash
  // validation stale, and the next exec of that path wedges uninterruptibly
  // in kernel space (2026-09-21 poison — bytes identical, inode dead).
  let tmp_path: string = cat3(path, ".rho-tmp", "");
  let pathz: []u8 = cstr(tmp_path);
  let fd: i32 = __open(pathz.ptr, 1 | 0x0200 | 0x0400, 420);
  if fd < 0 {
    return false;
  }
  let mut off: usize = 0;
  while off < len(data) {
    let put: isize = __write(fd, (data.ptr as usize + off) as *u8, len(data) - off);
    if put <= 0 {
      __close(fd);
      return false;
    }
    off += put as usize;
  }
  __close(fd);
  if __rename(cstr(tmp_path).ptr, cstr(path).ptr) != 0 {
    return false;
  }
  return true;
}

fn flush_out(s: string) {
  // assemble-then-write: the driver collects output in an SB and writes once
  printf("{}", s);
}


fn Result.get_ok(self: Result) -> T {
  return match self {
    Result.Ok(v) => v,
    Result.Err(_) => panic("get_ok on Err"),
  };
}

fn Result.get_err(self: Result) -> E {
  return match self {
    Result.Err(e) => e,
    Result.Ok(_) => panic("get_err on Ok"),
  };
}

// ---------------------------------------------------------------- lexer ---

enum Tok {
  TkEof,
  TkIdent,
  TkInt,
  TkFloat,
  TkStr,
  KwFn, KwLet, KwMut, KwIf, KwElse, KwWhile, KwLoop, KwBreak,
  KwContinue, KwReturn, KwDefer, KwStruct, KwEnum, KwUse, KwPub,
  KwStatic, KwConst, KwMatch, KwAs, KwNew, KwNull, KwTrue, KwFalse,
  KwWeak, KwSelf, KwExtern, KwTrait, KwImpl, KwFor, KwDyn,
  PLparen, PRparen, PLbrace, PRbrace, PLbracket, PRbracket,
  PComma, PColon, PSemi, PDot, PArrow, PFatarrow, PEllipsis2, PEllipsis3,
  PPlus, PMinus, PStar, PSlash, PPercent, PBang, PTilde, PAmp,
  PPipe, PCaret, PShl, PShr, PAndand, POror, PEq, PNe, PLt, PGt,
  PLe, PGe, PAssign, PPluseq, PMinuseq, PStareq, PSlasheq,
  PPercenteq, PAmpeq, PPipeeq, PCareteq, PShleq, PShreq, PQmark,
}

struct Token {
  kind: Tok,
  text: string,
  file: string,
  line: i32,
  col: i32,
  iv: u64,
  fv: f64,
  pre: *Vec[string], // line comments riding on the next token (for fmt)
  pending: *Vec[string], // lexer-local scratch while scanning
  pos: usize, // next read position (scratch)
  line2: i32, // lexer line (scratch)
  col2: i32, // lexer col (scratch)
}

struct Lexer {
  file: string,
  src: string,
  t: Token, // scratch: carries pos/line/col/pending between helpers
  out: *Vec[*Token],
}

fn tok_name(k: Tok) -> string {
  return match k {
    Tok.TkEof => "end of file",
    Tok.TkIdent => "identifier",
    Tok.TkInt => "integer",
    Tok.TkFloat => "float",
    Tok.TkStr => "string",
    Tok.KwFn => "`fn`",
    Tok.KwLet => "`let`",
    Tok.KwMut => "`mut`",
    Tok.KwIf => "`if`",
    Tok.KwElse => "`else`",
    Tok.KwWhile => "`while`",
    Tok.KwLoop => "`loop`",
    Tok.KwBreak => "`break`",
    Tok.KwContinue => "`continue`",
    Tok.KwReturn => "`return`",
    Tok.KwDefer => "`defer`",
    Tok.KwStruct => "`struct`",
    Tok.KwEnum => "`enum`",
    Tok.KwUse => "`use`",
    Tok.KwPub => "`pub`",
    Tok.KwStatic => "`static`",
    Tok.KwConst => "`const`",
    Tok.KwMatch => "`match`",
    Tok.KwAs => "`as`",
    Tok.KwNew => "`new`",
    Tok.KwNull => "`null`",
    Tok.KwTrue => "`true`",
    Tok.KwFalse => "`false`",
    Tok.KwWeak => "`weak`",
    Tok.KwSelf => "`self`",
    Tok.KwExtern => "`extern`",
    Tok.KwTrait => "`trait`",
    Tok.KwImpl => "`impl`",
    Tok.KwFor => "`for`",
    Tok.KwDyn => "`dyn`",
    Tok.PLparen => "`(`",
    Tok.PRparen => "`)`",
    Tok.PLbrace => "`{`",
    Tok.PRbrace => "`}`",
    Tok.PLbracket => "`[`",
    Tok.PRbracket => "`]`",
    Tok.PComma => "`,`",
    Tok.PColon => "`:`",
    Tok.PSemi => "`;`",
    Tok.PDot => "`.`",
    Tok.PArrow => "`->`",
    Tok.PFatarrow => "`=>`",
    Tok.PEllipsis2 => "`..`",
    Tok.PEllipsis3 => "`...`",
    Tok.PPlus => "`+`",
    Tok.PMinus => "`-`",
    Tok.PStar => "`*`",
    Tok.PSlash => "`/`",
    Tok.PPercent => "`%`",
    Tok.PBang => "`!`",
    Tok.PTilde => "`~`",
    Tok.PAmp => "`&`",
    Tok.PPipe => "`|`",
    Tok.PCaret => "`^`",
    Tok.PShl => "`<<`",
    Tok.PShr => "`>>`",
    Tok.PAndand => "`&&`",
    Tok.POror => "`||`",
    Tok.PEq => "`==`",
    Tok.PNe => "`!=`",
    Tok.PLt => "`<`",
    Tok.PGt => "`>`",
    Tok.PLe => "`<=`",
    Tok.PGe => "`>=`",
    Tok.PAssign => "`=`",
    Tok.PPluseq => "`+=`",
    Tok.PMinuseq => "`-=`",
    Tok.PStareq => "`*=`",
    Tok.PSlasheq => "`/=`",
    Tok.PPercenteq => "`%=`",
    Tok.PAmpeq => "`&=`",
    Tok.PPipeeq => "`|=`",
    Tok.PCareteq => "`^=`",
    Tok.PShleq => "`<<=`",
    Tok.PShreq => "`>>=`",
    Tok.PQmark => "`?`",
  };
}

fn spell2(k: Tok) -> string {
  return match k {
    Tok.PPlus => "+",
    Tok.PPluseq => "+=",
    Tok.PMinus => "-",
    Tok.PMinuseq => "-=",
    Tok.PStar => "*",
    Tok.PStareq => "*=",
    Tok.PSlash => "/",
    Tok.PSlasheq => "/=",
    Tok.PPercent => "%",
    Tok.PPercenteq => "%=",
    Tok.PBang => "!",
    Tok.PTilde => "~",
    Tok.PAmp => "&",
    Tok.PAmpeq => "&=",
    Tok.PPipe => "|",
    Tok.PPipeeq => "|=",
    Tok.PCaret => "^",
    Tok.PCareteq => "^=",
    Tok.PShl => "<<",
    Tok.PShleq => "<<=",
    Tok.PShr => ">>",
    Tok.PShreq => ">>=",
    Tok.PAndand => "&&",
    Tok.POror => "||",
    Tok.PEq => "==",
    Tok.PNe => "!=",
    Tok.PLt => "<",
    Tok.PGt => ">",
    Tok.PLe => "<=",
    Tok.PGe => ">=",
    Tok.PAssign => "=",
    Tok.PEllipsis2 => "..",
    Tok.PEllipsis3 => "...",
    Tok.PArrow => "->",
    Tok.PFatarrow => "=>",
    Tok.PColon => ":",
    Tok.PSemi => ";",
    Tok.PComma => ",",
    Tok.PDot => ".",
    Tok.PLparen => "(",
    Tok.PRparen => ")",
    Tok.PLbrace => "{",
    Tok.PRbrace => "}",
    Tok.PLbracket => "[",
    Tok.PRbracket => "]",
    Tok.PQmark => "?",
    _ => tok_name(k),
  };
}

fn ident_or_keyword(s: string) -> Tok {
  if streq(s, "fn") { return Tok.KwFn; }
  if streq(s, "let") { return Tok.KwLet; }
  if streq(s, "mut") { return Tok.KwMut; }
  if streq(s, "if") { return Tok.KwIf; }
  if streq(s, "else") { return Tok.KwElse; }
  if streq(s, "while") { return Tok.KwWhile; }
  if streq(s, "loop") { return Tok.KwLoop; }
  if streq(s, "break") { return Tok.KwBreak; }
  if streq(s, "continue") { return Tok.KwContinue; }
  if streq(s, "return") { return Tok.KwReturn; }
  if streq(s, "defer") { return Tok.KwDefer; }
  if streq(s, "struct") { return Tok.KwStruct; }
  if streq(s, "enum") { return Tok.KwEnum; }
  if streq(s, "use") { return Tok.KwUse; }
  if streq(s, "pub") { return Tok.KwPub; }
  if streq(s, "static") { return Tok.KwStatic; }
  if streq(s, "const") { return Tok.KwConst; }
  if streq(s, "match") { return Tok.KwMatch; }
  if streq(s, "as") { return Tok.KwAs; }
  if streq(s, "new") { return Tok.KwNew; }
  if streq(s, "null") { return Tok.KwNull; }
  if streq(s, "true") { return Tok.KwTrue; }
  if streq(s, "false") { return Tok.KwFalse; }
  if streq(s, "weak") { return Tok.KwWeak; }
  if streq(s, "self") { return Tok.KwSelf; }
  if streq(s, "extern") { return Tok.KwExtern; }
  if streq(s, "trait") { return Tok.KwTrait; }
  if streq(s, "impl") { return Tok.KwImpl; }
  if streq(s, "for") { return Tok.KwFor; }
  if streq(s, "dyn") { return Tok.KwDyn; }
  return Tok.TkIdent;
}


fn is_ws(c: u8) -> bool {
  return c == 32 || c == 9 || c == 13;
}
fn is_ident_start(c: u8) -> bool {
  if c >= 97 && c <= 122 {
    return true;
  }
  if c >= 65 && c <= 90 {
    return true;
  }
  return c == 95;
}

fn is_ident_char(c: u8) -> bool {
  return is_ident_start(c) || (c >= 48 && c <= 57);
}

fn is_digit(c: u8) -> bool {
  return c >= 48 && c <= 57;
}

fn is_hex(c: u8) -> bool {
  if is_digit(c) {
    return true;
  }
  if c >= 97 && c <= 102 {
    return true;
  }
  return c >= 65 && c <= 70;
}

fn hex_val(c: u8) -> i32 {
  if c >= 48 && c <= 57 {
    return c as i32 - 48;
  }
  if c >= 97 && c <= 102 {
    return c as i32 - 97 + 10;
  }
  if c >= 65 && c <= 70 {
    return c as i32 - 65 + 10;
  }
  return 0 - 1;
}

// digit value in the given base, or -1
fn digit_val(c: u8, base: u64) -> i32 {
  if c >= 48 && c <= 57 {
    return if (c as i32 - 48) as u64 >= base { 0 - 1 } else { c as i32 - 48 };
  }
  if c >= 97 && c <= 102 {
    return if (c as i32 - 87) as u64 >= base { 0 - 1 } else { c as i32 - 87 };
  }
  if c >= 65 && c <= 70 {
    return if (c as i32 - 55) as u64 >= base { 0 - 1 } else { c as i32 - 55 };
  }
  return 0 - 1;
}

fn ch_at(lx: *Lexer, off: usize) -> u8 {
  let i: usize = lx.t.pos + off;
  if i >= len(lx.src) {
    return 0;
  }
  return lx.src[i];
}

fn emit_tok(lx: *Lexer, kind: Tok, start: usize) {
  let t: *Token = new Token {
    kind: kind,
    text: lx.src[start..lx.t.pos],
    file: lx.file,
    line: lx.t.line2,
    col: lx.t.col2,
    iv: 0,
    fv: 0.0,
    pre: lx.t.pending,
    pending: new Vec[string] { items: make([]string, 8), n: 0 },
    pos: 0,
    line2: 1,
    col2: 1,
  };
  t.pre = lx.t.pending;
  lx.t.pending = new Vec[string] { items: make([]string, 8), n: 0 };
  lx.out.push(t);
}

fn lex_error(lx: *Lexer, msg: string) {
  err_at(lx.file, lx.t.line2, lx.t.col2, msg);
}

// exact decimal float parse (strtod semantics, no libc here):
// digits[.digits][e[+-]exp]. The digit string becomes a big-int N and the
// scale a power of ten M; binary long division extracts the mantissa bits
// and rounds half-even on the exact remainder — correctly rounded for every
// literal, including subnormals, where naive `v *= 10^e` loops overflow or
// drift. Digits past the 40th are dropped: that shifts the value by less
// than 1e-40 relative, far below any rounding decision a double can make.
fn parse_float(s: string) -> f64 {
  let d: *Big = big_new(); // significant digits
  let mut sig: usize = 0;
  let mut e10: i64 = 0;
  let mut i: usize = 0;
  let mut seen: bool = false;
  while i < len(s) && s[i] >= 48 && s[i] <= 57 {
    seen = true;
    if sig < 40 {
      big_mul_u32(d, 10);
      big_add_u32(d, (s[i] - 48) as u32);
      sig += 1;
    } else {
      // integer digits beyond the cap: pure magnitude, keep the exponent
      e10 += 1;
    }
    i += 1;
  }
  if i < len(s) && s[i] == 46 {
    i += 1;
    while i < len(s) && s[i] >= 48 && s[i] <= 57 {
      seen = true;
      if sig < 40 {
        big_mul_u32(d, 10);
        big_add_u32(d, (s[i] - 48) as u32);
        sig += 1;
        e10 -= 1;
      }
      i += 1;
    }
  }
  if i < len(s) && (s[i] == 101 || s[i] == 69) {
    i += 1;
    let mut eneg: bool = false;
    if i < len(s) && (s[i] == 43 || s[i] == 45) {
      eneg = s[i] == 45;
      i += 1;
    }
    let mut ev: i64 = 0;
    while i < len(s) && s[i] >= 48 && s[i] <= 57 {
      ev = ev * 10 + (s[i] - 48) as i64;
      i += 1;
    }
    if eneg {
      e10 -= ev;
    } else {
      e10 += ev;
    }
  }
  if !seen || (d.n == 1 && d.w[0] == 0) {
    return 0.0;
  }
  let dl: i64 = (d.n as i64 - 1) * 9 + u32_digits(d.w[d.n - 1]);
  let approx: i64 = dl - 1 + e10;
  if approx > 309 {
    // beyond the max double; x10 overflows to inf without a literal trap
    let mut big: f64 = 1e308;
    big = big * 10.0;
    return big;
  }
  if approx + 331 < 0 {
    return 0.0;
  }
  // value = N / M, both exact big-ints (big_new is the zero value; seed
  // M with 1 so the 10^k scaling below has something to scale)
  let n2: *Big = big_clone(d);
  let m2: *Big = big_new();
  big_add_u32(m2, 1);
  if e10 >= 0 {
    let mut k: i64 = e10;
    while k >= 9 {
      big_mul_u32(n2, 1000000000);
      k -= 9;
    }
    if k > 0 {
      big_mul_u32(n2, p10_u64(k as usize) as u32);
    }
  } else {
    let mut k: i64 = 0 - e10;
    while k >= 9 {
      big_mul_u32(m2, 1000000000);
      k -= 9;
    }
    if k > 0 {
      big_mul_u32(m2, p10_u64(k as usize) as u32);
    }
  }
  // normalize the fraction n2/m2 into (1/2, 1): scale N up until N >= M,
  // then M up until M > N — sN and cc track the exact power-of-two drift
  let mut sN: i64 = 0;
  while big_cmp(n2, m2) < 0 {
    big_mul_u32(n2, 2);
    sN += 1;
  }
  let mut cc: i64 = 0;
  while big_cmp(n2, m2) >= 0 {
    big_mul_u32(m2, 2);
    cc += 1;
  }
  // value = fraction * 2^e2v with fraction in (1/2, 1)
  let mut e2v: i64 = cc - sN;
  let mut q: u64 = 0;
  if e2v + 1021 >= 0 {
    // normal: extract 53 mantissa bits, round half-even on the remainder
    q = big_div_bits(n2, m2, 53);
    if q >= 9007199254740992 {
      // carry re-normalizes: 2^53 -> 2^52 one exponent step higher
      q = 4503599627370496;
      e2v += 1;
    }
    let mut result: f64 = q as i64 as f64;
    // value = fraction * 2^e2v and q = fraction * 2^53
    let mut t: i64 = e2v - 53;
    while t > 0 {
      result = result * 2.0;
      t -= 1;
    }
    while t < 0 {
      result = result / 2.0;
      t += 1;
    }
    return result;
  }
  // subnormal: m = round(value * 2^1074), one exact power-of-two scale.
  // e2v <= -1022 keeps k <= 52, so the quotient cannot overflow.
  let mut k: i64 = e2v + 1074;
  if k < 1 {
    k = 1;
  }
  q = big_div_bits(n2, m2, k);
  let mut result: f64 = q as i64 as f64;
  let mut t: i64 = 1074;
  while t > 0 {
    result = result / 2.0;
    t -= 1;
  }
  return result;
}

// scan a string literal (the opening quote is at lx.t.pos)
fn lex_string(lx: *Lexer, start: usize) {
  lx.t.pos += 1;
  let sb: *Vec[u8] = new Vec[u8] { items: make([]u8, 32), n: 0 };
  loop {
    if lx.t.pos >= len(lx.src) || lx.src[lx.t.pos] == 10 {
      lex_error(lx, "unterminated string literal");
      break;
    }
    let d: u8 = lx.src[lx.t.pos];
    if d == 34 {
      lx.t.pos += 1;
      break;
    }
    if d == 92 {
      lx.t.pos += 1;
      if lx.t.pos >= len(lx.src) {
        lex_error(lx, "unterminated escape");
        break;
      }
      let e: u8 = lx.src[lx.t.pos];
      lx.t.pos += 1;
      if e == 110 {
        sb.push(10);
      } else if e == 116 {
        sb.push(9);
      } else if e == 114 {
        sb.push(13);
      } else if e == 92 {
        sb.push(92);
      } else if e == 34 {
        sb.push(34);
      } else if e == 48 {
        sb.push(0);
      } else if e == 120 {
        if is_hex(ch_at(lx, 0)) && is_hex(ch_at(lx, 1)) {
          sb.push((hex_val(ch_at(lx, 0)) * 16 + hex_val(ch_at(lx, 1))) as u8);
          lx.t.pos += 2;
        } else {
          lex_error(lx, "malformed \\x escape");
        }
      } else {
        lex_error(lx, "unknown escape");
        sb.push(e);
      }
      continue;
    }
    sb.push(d);
    lx.t.pos += 1;
  }
  emit_tok(lx, Tok.TkStr, start);
  lx.out.last().text = intrinsics.slice_string(sb.items[0..sb.n]);
  lx.t.col2 += (lx.t.pos - start) as i32;
}

// scan a triple-quoted multiline string literal (the opening """ is at
// lx.t.pos). The literal is fully literal: every byte between the
// opening """ and the closing """ enters the value unchanged — the
// newline right after the opening """ is content like any byte, and
// indentation is content too. Escapes decode exactly like single-line
// strings (so \" embeds a quote and \"""" three of them); an unescaped
// """ run closes the literal, mid-line included; reaching the end of
// the file before the closing """ is an error.
fn lex_multiline_string(lx: *Lexer, start: usize) {
  let open_line: i32 = lx.t.line2;
  let open_col: i32 = lx.t.col2;
  lx.t.pos += 3;
  let sb: *Vec[u8] = new Vec[u8] { items: make([]u8, 32), n: 0 };
  let mut line: i32 = open_line;
  let mut col: i32 = open_col + 3;
  loop {
    if lx.t.pos >= len(lx.src) {
      err_at(lx.file, line, 1, "unterminated multiline string literal");
      break;
    }
    let d: u8 = lx.src[lx.t.pos];
    if d == 34 && lx.t.pos + 2 < len(lx.src) && lx.src[lx.t.pos + 1] == 34 && lx.src[lx.t.pos + 2] == 34 {
      lx.t.pos += 3;
      col += 3;
      break;
    }
    if d == 92 {
      lx.t.pos += 1;
      col += 1;
      if lx.t.pos < len(lx.src) {
        let e: u8 = lx.src[lx.t.pos];
        lx.t.pos += 1;
        col += 1;
        if e == 110 {
          sb.push(10);
        } else if e == 116 {
          sb.push(9);
        } else if e == 114 {
          sb.push(13);
        } else if e == 92 {
          sb.push(92);
        } else if e == 34 {
          sb.push(34);
        } else if e == 48 {
          sb.push(0);
        } else if e == 120 {
          if is_hex(ch_at(lx, 0)) && is_hex(ch_at(lx, 1)) {
            sb.push((hex_val(ch_at(lx, 0)) * 16 + hex_val(ch_at(lx, 1))) as u8);
            lx.t.pos += 2;
            col += 2;
          } else {
            err_at(lx.file, line, col, "malformed \\x escape");
          }
        } else {
          err_at(lx.file, line, col, "unknown escape");
          sb.push(e);
        }
      }
      continue;
    }
    if d == 10 {
      lx.t.pos += 1;
      line += 1;
      col = 1;
      sb.push(10);
      continue;
    }
    sb.push(d);
    lx.t.pos += 1;
    col += 1;
  }
  // the token records the literal's opening position; the lexer's cursor
  // parks after the closing delimiter
  lx.t.line2 = open_line;
  lx.t.col2 = open_col;
  emit_tok(lx, Tok.TkStr, start);
  lx.out.last().text = intrinsics.slice_string(sb.items[0..sb.n]);
  lx.t.line2 = line;
  lx.t.col2 = col;
}

fn lex_file(file: string, src: string, out: *Vec[*Token]) {
  let lx: *Lexer = new Lexer {
    file: file,
    src: src,
    t: *new Token {
      kind: Tok.TkEof,
      text: "",
      file: file,
      line: 1,
      col: 1,
      iv: 0,
      fv: 0.0,
      pre: new Vec[string] { items: make([]string, 8), n: 0 },
      pending: new Vec[string] { items: make([]string, 8), n: 0 },
      pos: 0,
      line2: 1,
      col2: 1,
    },
    out: out,
  };
  lx.t.pending = new Vec[string] { items: make([]string, 8), n: 0 };
  loop {
    if lx.t.pos >= len(src) {
      break;
    }
    let c: u8 = src[lx.t.pos];
    let start: usize = lx.t.pos;
    let start_line: i32 = lx.t.line2;
    let start_col: i32 = lx.t.col2;

    if c == 10 {
      lx.t.pos += 1;
      lx.t.line2 += 1;
      lx.t.col2 = 1;
      continue;
    }
    if is_ws(c) {
      lx.t.pos += 1;
      lx.t.col2 += 1;
      continue;
    }
    if c == 47 && ch_at(lx, 1) == 47 {
      // line comment: trivia riding on the next token
      lx.t.pos += 2;
      let cs: usize = lx.t.pos;
      loop {
        if lx.t.pos >= len(src) || src[lx.t.pos] == 10 {
          break;
        }
        lx.t.pos += 1;
      }
      lx.t.pending.push(src[cs..lx.t.pos]);
      continue;
    }

    // identifiers & keywords
    if is_ident_start(c) {
      loop {
        if lx.t.pos >= len(src) || !is_ident_char(src[lx.t.pos]) {
          break;
        }
        lx.t.pos += 1;
      }
      emit_tok(lx, ident_or_keyword(src[start..lx.t.pos]), start);
      lx.t.col2 += (lx.t.pos - start) as i32;
      continue;
    }

    // numbers (int / float / hex / bin)
    if is_digit(c) {
      let mut is_float: bool = false;
      let mut base: u64 = 10;
      if c == 48 && (ch_at(lx, 1) == 120 || ch_at(lx, 1) == 98) {
        base = if ch_at(lx, 1) == 120 { 16 } else { 2 };
        lx.t.pos += 2;
      }
      let digits: usize = lx.t.pos;
      loop {
        if lx.t.pos >= len(src) {
          break;
        }
        let d: u8 = src[lx.t.pos];
        if d != 95 && digit_val(d, base) < 0 {
          break;
        }
        lx.t.pos += 1;
      }
      if base == 10 && ch_at(lx, 0) == 46 && is_digit(ch_at(lx, 1)) {
        is_float = true;
        lx.t.pos += 1;
        loop {
          if lx.t.pos >= len(src) {
            break;
          }
          let d: u8 = src[lx.t.pos];
          if !is_digit(d) && d != 95 {
            break;
          }
          lx.t.pos += 1;
        }
      }
      if base == 10 && lx.t.pos < len(src) && (src[lx.t.pos] == 101 || src[lx.t.pos] == 69) {
        let save: usize = lx.t.pos;
        lx.t.pos += 1;
        if lx.t.pos < len(src) && (src[lx.t.pos] == 43 || src[lx.t.pos] == 45) {
          lx.t.pos += 1;
        }
        if lx.t.pos < len(src) && is_digit(src[lx.t.pos]) {
          is_float = true;
          loop {
            if lx.t.pos >= len(src) || !is_digit(src[lx.t.pos]) {
              break;
            }
            lx.t.pos += 1;
          }
        } else {
          lx.t.pos = save;
        }
      }
      if lx.t.pos == digits {
        lex_error(lx, "malformed number");
        lx.t.pos += 1;
        lx.t.col2 += 1;
        continue;
      }
      emit_tok(lx, if is_float { Tok.TkFloat } else { Tok.TkInt }, start);
      let mut i: usize = start;
      if is_float {
        let clean: *Vec[u8] = new Vec[u8] { items: make([]u8, 64), n: 0 };
        while i < lx.t.pos {
          if src[i] != 95 {
            clean.push(src[i]);
          }
          i += 1;
        }
        lx.out.last().fv = parse_float(intrinsics.slice_string(clean.items[0..clean.n]));
      } else {
        let mut v: u64 = 0;
        let mut overflow: bool = false;
        if base != 10 {
          i += 2; // skip the 0x/0b prefix: the value digits start after it
        }
        while i < lx.t.pos {
          let d: u8 = src[i];
          i += 1;
          if d == 95 {
            continue;
          }
          let dv: i32 = digit_val(d, base);
          if dv < 0 {
            err_at(file, start_line, start_col, "invalid digit for this base");
            break;
          }
          let next: u64 = v * base + dv as u64;
          if next < v {
            overflow = true;
          }
          v = next;
        }
        if overflow {
          err_at(file, start_line, start_col, "integer literal too large");
        }
        lx.out.last().iv = v;
      }
      lx.t.col2 += (lx.t.pos - start) as i32;
      continue;
    }

    // strings
    if c == 34 {
      if ch_at(lx, 1) == 34 && ch_at(lx, 2) == 34 {
        lex_multiline_string(lx, start);
      } else {
        lex_string(lx, start);
      }
      continue;
    }

    // two-char operators
    if op2(lx, c, 61, 61, Tok.PEq) { continue; }
    if op2(lx, c, 33, 61, Tok.PNe) { continue; }
    if op2(lx, c, 60, 61, Tok.PLe) { continue; }
    if op2(lx, c, 62, 61, Tok.PGe) { continue; }
    if op2(lx, c, 38, 38, Tok.PAndand) { continue; }
    if op2(lx, c, 124, 124, Tok.POror) { continue; }
    if op2(lx, c, 38, 61, Tok.PAmpeq) { continue; }
    if op2(lx, c, 124, 61, Tok.PPipeeq) { continue; }
    if op2(lx, c, 94, 61, Tok.PCareteq) { continue; }
    if op2(lx, c, 43, 61, Tok.PPluseq) { continue; }
    if op2(lx, c, 45, 61, Tok.PMinuseq) { continue; }
    if op2(lx, c, 42, 61, Tok.PStareq) { continue; }
    if op2(lx, c, 47, 61, Tok.PSlasheq) { continue; }
    if op2(lx, c, 37, 61, Tok.PPercenteq) { continue; }
    if op2(lx, c, 61, 62, Tok.PFatarrow) { continue; }
    if op2(lx, c, 45, 62, Tok.PArrow) { continue; }
    if op3(lx, c, 46, 46, 46, Tok.PEllipsis3) { continue; }
    if op2(lx, c, 46, 46, Tok.PEllipsis2) { continue; }
    if op2(lx, c, 60, 60, Tok.PShl) { continue; }
    if op2(lx, c, 62, 62, Tok.PShr) { continue; }

    // single-char operators
    let mut kind: Tok = Tok.TkEof;
    if c == 40 { kind = Tok.PLparen; }
    else if c == 41 { kind = Tok.PRparen; }
    else if c == 123 { kind = Tok.PLbrace; }
    else if c == 125 { kind = Tok.PRbrace; }
    else if c == 91 { kind = Tok.PLbracket; }
    else if c == 93 { kind = Tok.PRbracket; }
    else if c == 44 { kind = Tok.PComma; }
    else if c == 58 { kind = Tok.PColon; }
    else if c == 59 { kind = Tok.PSemi; }
    else if c == 46 { kind = Tok.PDot; }
    else if c == 43 { kind = Tok.PPlus; }
    else if c == 45 { kind = Tok.PMinus; }
    else if c == 42 { kind = Tok.PStar; }
    else if c == 47 { kind = Tok.PSlash; }
    else if c == 37 { kind = Tok.PPercent; }
    else if c == 33 { kind = Tok.PBang; }
    else if c == 126 { kind = Tok.PTilde; }
    else if c == 38 { kind = Tok.PAmp; }
    else if c == 124 { kind = Tok.PPipe; }
    else if c == 94 { kind = Tok.PCaret; }
    else if c == 60 { kind = Tok.PLt; }
    else if c == 62 { kind = Tok.PGt; }
    else if c == 61 { kind = Tok.PAssign; }
    else if c == 63 { kind = Tok.PQmark; }
    else {
      lex_error(lx, "unexpected character");
      lx.t.pos += 1;
      lx.t.col2 += 1;
      continue;
    }
    lx.t.pos += 1;
    lx.t.col2 += 1;
    emit_tok(lx, kind, start);
  }
  let eof: *Token = new Token {
    kind: Tok.TkEof,
    text: "",
    file: file,
    line: lx.t.line2,
    col: lx.t.col2,
    iv: 0,
    fv: 0.0,
    pre: new Vec[string] { items: make([]string, 8), n: 0 },
    pending: new Vec[string] { items: make([]string, 8), n: 0 },
    pos: 0,
    line2: 1,
    col2: 1,
  };
  eof.pre = lx.t.pending;
  out.push(eof);
}

fn op3(lx: *Lexer, c: u8, a: u8, b: u8, d: u8, kind: Tok) -> bool {
  if c == a && lx.t.pos + 2 < len(lx.src) && lx.src[lx.t.pos + 1] == b && lx.src[lx.t.pos + 2] == d {
    lx.t.pos += 3;
    lx.t.col2 += 3;
    emit_tok(lx, kind, 0);
    return true;
  }
  return false;
}

fn op2(lx: *Lexer, c: u8, a: u8, b: u8, kind: Tok) -> bool {
  if c != a || ch_at(lx, 1) != b {
    return false;
  }
  let start: usize = lx.t.pos;
  lx.t.pos += 2;
  lx.t.col2 += 2;
  emit_tok(lx, kind, start);
  return true;
}


// ---------------------------------------------------------------- ast -----

enum ExprKind {
  ExInt, ExFloat, ExStr, ExBool, ExNull, ExName, ExType,
  ExBin, ExUn, ExCall, ExIndex, ExSlice, ExField, ExMethod, ExDynbox,
  ExCast, ExNew, ExMake, ExClosure, ExMatch, ExQmark, ExEnumCtor,
  ExIf, ExBlock,
}

enum PatKind {
  PatWildcard, PatInt, PatStr, PatUnit, PatTuple, PatStruct,
}

enum VarKind {
  VarUnit, VarTuple, VarStruct,
}

enum StmtKind {
  StLet, StAssign, StExpr, StReturn, StBreak, StContinue, StDefer,
  StWhile, StLoop, StBlock,
}

enum DeclKind {
  DkFn, DkStruct, DkEnum, DkStatic, DkConst, DkUse, DkExtern,
  DkTrait, DkImpl,
}

enum TypeAstKind {
  TaPrim, TaNamed, TaPtr, TaWeak, TaArray, TaFn,
  TaDyn,
}

struct TypeAst {
  kind: TypeAstKind,
  prim: i32,           // TaPrim: index into the primitive name table
  path: *Vec[string],   // TaNamed: segments
  targs: *Vec[*TypeAst],// TaNamed: type arguments
  elem: *TypeAst,      // Ptr/Weak/Array
  params: *Vec[*TypeAst], // Fn
  ret: *TypeAst,       // Fn
  size: *Expr,         // Array: constant length expression
  file: string,
  line: i32,
  col: i32,
}

struct Param {
  name: string,
  ty: *TypeAst,
  is_self: bool,
  is_variadic: bool, // `rest: T...` — the body sees a []T, last parameter only
  file: string,
  line: i32,
  col: i32,
}

struct FieldAst {
  name: string,
  ty: *TypeAst,
  file: string,
  line: i32,
  col: i32,
}

struct VariantAst {
  name: string,
  vkind: VarKind,
  types: *Vec[*TypeAst],  // VarTuple
  fields: *Vec[*FieldAst],// VarStruct
  has_disc: bool,
  disc: u64,
  file: string,
  line: i32,
  col: i32,
}

struct MatchArm {
  pk: PatKind,
  pat_path: *Vec[string],
  pat_int: u64,
  variant_index: i32,
  disc: u64,
  pat_str: string,
  pat_names: *Vec[string],
  pat_fields: *Vec[*FieldAst],
  body: *Expr,
  file: string,
  line: i32,
  col: i32,
  bind_syms: []*Sym,   // pattern bindings (check)
  bind_fidx: []i64,    // variant field index per binding (check)
}

struct Expr {
  kind: ExprKind,
  file: string,
  line: i32,
  col: i32,
  iv: u64,
  fv: f64,
  sv: string,
  bv: bool,
  a: *Expr,
  b: *Expr,
  c: *Expr,
  binop: Tok,
  unop: Tok,
  args: *Vec[*Expr],
  arg_names: *Vec[string], // "" = positional
  items: *Vec[*Stmt],      // Block stmts / If arms / New field names unused
  ty: *TypeAst,
  arms: *Vec[*MatchArm],
  params: *Vec[*Param],    // Closure
  ret: *TypeAst,          // Closure
  q_ok: i32,
  q_err: i32,
  else_if: *Expr, // ExIf: the else-if chain (null = else is items[1] or none)
  fnval: bool,
  caps: []*Sym, // CLOSURE: copy-captured outer locals (check)
  typed: *Type, // semantic type (check)
  sym: *Sym, // resolved name (check)
  spread: bool, // CALL: this argument is `xs...` — passes a slice whole
}

struct Stmt {
  kind: StmtKind,
  file: string,
  line: i32,
  col: i32,
  pre: *Vec[string],
  mut_: bool,
  tail: bool,
  name: string,
  ty: *TypeAst,
  a: *Expr,
  b: *Expr,
  assign_op: Tok,
  stmts: *Vec[*Stmt],
  cond: *Expr,
  body: *Vec[*Stmt],
}

struct TypeEnt { key: string, val: *Type }
struct TypeMap { items: []*TypeEnt, n: usize }

fn tm_new() -> *TypeMap {
  return new TypeMap { items: make([]*TypeEnt, 65536), n: 0 };
}

// interning: same mangled key always yields the identical *Type
fn tm_intern(m: *TypeMap, key: string, val: *Type) -> *Type {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  let e: *TypeEnt = new TypeEnt { key: key, val: val };
  m.items[m.n] = e;
  m.n += 1;
  return val;
}

fn tm_lookup(m: *TypeMap, key: string) -> *Type {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return null;
}

fn tm_put(m: *TypeMap, key: string, val: *Type) {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      m.items[i].val = val;
      return;
    }
    i += 1;
  }
  let e: *TypeEnt = new TypeEnt { key: key, val: val };
  m.items[m.n] = e;
  m.n += 1;
}

fn tm_get(m: *TypeMap, key: string) -> *Type {
  return tm_lookup(m, key);
}

struct RecType {
  decl: *Decl,
  is_prelude: bool,
  targs: []*Type,
  mangled: string,
  field_types: []*Type,
  fields_done: bool,
  resolving: bool,
  is_template: bool,
  offsets: []i64,
  var_offsets: []*I64Vec, // per variant: field offsets
  var_poff: []i64,        // per variant: payload start
  size: i64,
  align: i64,
  env_tenv: *TypeMap,
  owner_mod: *Module,
  methods: []*Sym,
  is_trait: bool, // trait requirement carrier (the order IS the vtable layout)
}

struct I64Vec { items: []i64 }

struct Type {
  kind: TypeKind,
  elem: *Type,
  len: u64,
  rec: *RecType,
  params: []*Type,
  ret: *Type,
  mangled: string,
}

struct Decl {
  kind: DeclKind,
  file: string,
  line: i32,
  col: i32,
  pre: *Vec[string],
  pub_: bool,
  is_mut: bool,
  name: string,
  path: *Vec[string],      // Use
  params: *Vec[*Param],    // Fn/Extern
  ret: *TypeAst,
  fields: *Vec[*FieldAst], // Struct
  variants: *Vec[*VariantAst], // Enum
  init: *Expr,            // Static/Const
  body: *Vec[*Stmt],       // Fn
  tparams: *Vec[string],
  is_method: bool,
  recv: string,
  target: *TypeAst,         // Impl: the type after `for`
  decls: *Vec[*Decl],       // module root
  tparam_bounds: *Vec[*TypeAst], // [T: Bound] — parallel to tparams (check)
  templ: *RecType,         // generic definition's RecType (check)
  templated: bool,         // generic template: never lowered directly
  tenv: *TypeMap,          // instantiation env (clones)
  owner: *Module,          // owning module (decl registration)
  ceval_ok: bool,
  ceval_is_int: bool,
  ceval_i: u64,
  ceval_f: f64,
}

// ------------------------------------------------------------- parser -----

struct Parser {
  toks: []*Token,
  i: usize,
  bare_self_ok: bool, // inside a trait: requirement receivers have no type
}

fn pk(p: *Parser) -> *Token {
  return p.toks[p.i];
}

fn peek2(p: *Parser) -> *Token {
  if p.i + 1 < len(p.toks) {
    return p.toks[p.i + 1];
  }
  return p.toks[p.i];
}

fn at(p: *Parser, k: Tok) -> bool {
  return pk(p).kind == k;
}

fn at_eof(p: *Parser) -> bool {
  return pk(p).kind == Tok.TkEof;
}

fn advance(p: *Parser) -> *Token {
  let t: *Token = pk(p);
  if p.i + 1 < len(p.toks) {
    p.i += 1;
  }
  return t;
}

fn accept(p: *Parser, k: Tok) -> bool {
  if at(p, k) {
    advance(p);
    return true;
  }
  return false;
}

fn expect_tok(p: *Parser, k: Tok, what: string) -> *Token {
  if at(p, k) {
    return advance(p);
  }
  let t: *Token = pk(p);
  err_at(t.file, t.line, t.col, cat5("expected ", what, cat(" (", tok_name(k)), "), found ", tok_name(t.kind)));
  return t;
}

fn at_ident(p: *Parser, s: string) -> bool {
  return at(p, Tok.TkIdent) && streq(pk(p).text, s);
}

fn expect_ident(p: *Parser, what: string) -> *Token {
  if at(p, Tok.TkIdent) {
    return advance(p);
  }
  let t: *Token = pk(p);
  err_at(t.file, t.line, t.col, cat3("expected ", what, cat3(", found ", tok_name(t.kind), "")));
  return t;
}

fn prim_from_name(s: string) -> i32 {
  if streq(s, "bool") { return 0; }
  if streq(s, "i8") { return 1; }
  if streq(s, "i16") { return 2; }
  if streq(s, "i32") { return 3; }
  if streq(s, "i64") { return 4; }
  if streq(s, "u8") { return 5; }
  if streq(s, "u16") { return 6; }
  if streq(s, "u32") { return 7; }
  if streq(s, "u64") { return 8; }
  if streq(s, "f32") { return 9; }
  if streq(s, "f64") { return 10; }
  if streq(s, "string") { return 11; }
  if streq(s, "usize") { return 12; }
  if streq(s, "isize") { return 13; }
  if streq(s, "void") { return 14; }
  return 0 - 1;
}

// ---- type grammar

fn parse_type(p: *Parser) -> *TypeAst {
  let start: *Token = pk(p);
  let mut t: *TypeAst = null;
  if accept(p, Tok.PLbracket) {
    // []T slice or [N]T array — `[*` can only start the element type
    t = new TypeAst { kind: TypeAstKind.TaArray, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null, file: start.file, line: start.line, col: start.col };
    if at(p, Tok.PStar) {
      // [*T] — slice of pointer: the `*` starts the element type
      t.elem = parse_type(p);
      expect_tok(p, Tok.PRbracket, "`]`");
      return t;
    }
    if !at(p, Tok.PRbracket) {
      t.size = parse_expr(p);
    }
    expect_tok(p, Tok.PRbracket, "`]`");
    t.elem = parse_type(p);
    return t;
  }
  if accept(p, Tok.PStar) {
    t = new TypeAst { kind: TypeAstKind.TaPtr, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null, file: start.file, line: start.line, col: start.col };
    t.elem = parse_type(p);
    return t;
  }
  if at(p, Tok.KwWeak) {
    advance(p);
    t = new TypeAst { kind: TypeAstKind.TaWeak, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null, file: start.file, line: start.line, col: start.col };
    expect_tok(p, Tok.PLbracket, "`[`");
    t.elem = parse_type(p);
    expect_tok(p, Tok.PRbracket, "`]`");
    return t;
  }
  if at(p, Tok.KwDyn) {
    advance(p);
    t = new TypeAst { kind: TypeAstKind.TaDyn, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null, file: start.file, line: start.line, col: start.col };
    let id: *Token = expect_ident(p, "trait name");
    t.path.push(id.text);
    while accept(p, Tok.PDot) {
      let seg: *Token = expect_ident(p, "trait name");
      t.path.push(seg.text);
    }
    return t;
  }
  if at(p, Tok.KwFn) {
    advance(p);
    t = new TypeAst { kind: TypeAstKind.TaFn, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null, file: start.file, line: start.line, col: start.col };
    expect_tok(p, Tok.PLparen, "`(`");
    if !at(p, Tok.PRparen) {
      loop {
        t.params.push(parse_type(p));
        if !accept(p, Tok.PComma) {
          break;
        }
      }
    }
    expect_tok(p, Tok.PRparen, "`)`");
    if accept(p, Tok.PArrow) {
      t.ret = parse_type(p);
    }
    return t;
  }
  if at(p, Tok.TkIdent) {
    let id: *Token = advance(p);
    let prim: i32 = prim_from_name(id.text);
    if prim >= 0 {
      t = new TypeAst { kind: TypeAstKind.TaPrim, prim: prim, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null, file: start.file, line: start.line, col: start.col };
      return t;
    }
    t = new TypeAst { kind: TypeAstKind.TaNamed, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null, file: start.file, line: start.line, col: start.col };
    t.path.push(id.text);
    while accept(p, Tok.PDot) {
      let seg: *Token = expect_ident(p, "type name");
      t.path.push(seg.text);
    }
    if accept(p, Tok.PLbracket) {
      if !at(p, Tok.PRbracket) {
        loop {
          t.targs.push(parse_type(p));
          if !accept(p, Tok.PComma) {
            break;
          }
        }
      }
      expect_tok(p, Tok.PRbracket, "`]`");
    }
    return t;
  }
  err_at(start.file, start.line, start.col, cat3("expected a type, found ", tok_name(start.kind), ""));
  t = new TypeAst { kind: TypeAstKind.TaPrim, prim: 0, path: fresh_str_vec(), targs: fresh_type_vec(), elem: null, params: fresh_type_vec(), ret: null, size: null, file: start.file, line: start.line, col: start.col };
  return t;
}

fn type_as_expr(p: *Parser) -> *Expr {
  let start: *Token = pk(p);
  let e: *Expr = new Expr {
    kind: ExprKind.ExType, file: start.file, line: start.line, col: start.col,
    iv: 0, fv: 0.0, sv: "", bv: false, a: null, b: null, c: null,
    binop: Tok.TkEof, unop: Tok.TkEof,
    args: fresh_expr_vec(), arg_names: fresh_str_vec(), items: fresh_stmt_vec(),
    ty: parse_type(p), arms: fresh_arm_vec(), params: fresh_param_vec(), ret: null,
    q_ok: 0, q_err: 0, else_if: null, fnval: false, caps: make([]*Sym, 0), typed: null, sym: null, spread: false,
  };
  return e;
}

// fresh empty containers (no zero values in rho)
fn fresh_str_vec() -> *Vec[string] {
  return new Vec[string] { items: make([]string, 4), n: 0 };
}
fn fresh_expr_vec() -> *Vec[*Expr] {
  return new Vec[*Expr] { items: make([*Expr], 4), n: 0 };
}
fn fresh_stmt_vec() -> *Vec[*Stmt] {
  return new Vec[*Stmt] { items: make([*Stmt], 4), n: 0 };
}
fn fresh_type_vec() -> *Vec[*TypeAst] {
  return new Vec[*TypeAst] { items: make([*TypeAst], 4), n: 0 };
}
fn fresh_param_vec() -> *Vec[*Param] {
  return new Vec[*Param] { items: make([*Param], 4), n: 0 };
}
fn fresh_arm_vec() -> *Vec[*MatchArm] {
  return new Vec[*MatchArm] { items: make([*MatchArm], 4), n: 0 };
}
fn fresh_field_vec() -> *Vec[*FieldAst] {
  return new Vec[*FieldAst] { items: make([*FieldAst], 4), n: 0 };
}
fn fresh_variant_vec() -> *Vec[*VariantAst] {
  return new Vec[*VariantAst] { items: make([*VariantAst], 4), n: 0 };
}
fn fresh_decl_vec() -> *Vec[*Decl] {
  return new Vec[*Decl] { items: make([*Decl], 16), n: 0 };
}
fn fresh_token_vec() -> *Vec[*Token] {
  return new Vec[*Token] { items: make([*Token], 256), n: 0 };
}



fn mkexpr(kind: ExprKind, file: string, line: i32, col: i32) -> *Expr {
  return new Expr {
    kind: kind, file: file, line: line, col: col,
    iv: 0, fv: 0.0, sv: "", bv: false, a: null, b: null, c: null,
    binop: Tok.TkEof, unop: Tok.TkEof,
    args: fresh_expr_vec(), arg_names: fresh_str_vec(), items: fresh_stmt_vec(),
    ty: null, arms: fresh_arm_vec(), params: fresh_param_vec(), ret: null,
    q_ok: 0, q_err: 0, else_if: null, fnval: false, caps: make([]*Sym, 0), typed: null, sym: null, spread: false,
  };
}

fn parse_param(p: *Parser) -> *Param {
  let start: *Token = pk(p);
  let pa: *Param = new Param { name: "", ty: null, is_self: false, is_variadic: false, file: start.file, line: start.line, col: start.col };
  if at(p, Tok.KwSelf) {
    advance(p);
    pa.is_self = true;
    pa.name = "self";
    // inside a trait, the receiver has no type yet — the impl decides it
    if p.bare_self_ok && !at(p, Tok.PColon) {
      return pa;
    }
  } else {
    let id: *Token = expect_ident(p, "parameter name");
    pa.name = id.text;
  }
  expect_tok(p, Tok.PColon, "`:`");
  pa.ty = parse_type(p);
  if accept(p, Tok.PEllipsis3) {
    pa.is_variadic = true;
  }
  return pa;
}

// a full `(params)` list for externs and closures: no variadic parameter
fn parse_param_list_raw(p: *Parser, out: *Vec[*Param], allow_variadic: bool) {
  expect_tok(p, Tok.PLparen, "`(`");
  if !at(p, Tok.PRparen) {
    loop {
      let pa: *Param = parse_param(p);
      if out.n > 0 && out.items[out.n - 1].is_variadic {
        err_at(pa.file, pa.line, pa.col, "only the last parameter can be variadic");
      }
      if pa.is_variadic && !allow_variadic {
        err_at(pa.file, pa.line, pa.col, "variadic parameters are only for named `fn` declarations");
      }
      out.push(pa);
      if !accept(p, Tok.PComma) {
        break;
      }
    }
  }
  expect_tok(p, Tok.PRparen, "`)`");
}

// one call argument; `xs...` (spread) is only legal as the final argument
fn parse_arg_expr(p: *Parser) -> *Expr {
  let arg: *Expr = parse_expr(p);
  if accept(p, Tok.PEllipsis3) {
    arg.spread = true;
    if !at(p, Tok.PRparen) {
      let t: *Token = pk(p);
      err_at(t.file, t.line, t.col, "`...` spread must be the last argument");
    }
  }
  return arg;
}

fn parse_tparams(p: *Parser, out: *Vec[string], bounds: *Vec[*TypeAst]) {
  if !accept(p, Tok.PLbracket) {
    return;
  }
  if !at(p, Tok.PRbracket) {
    loop {
      let id: *Token = expect_ident(p, "type parameter name");
      out.push(id.text);
      bounds.push(null);
      if accept(p, Tok.PColon) {
        bounds.items[bounds.n - 1] = parse_type(p);
      }
      if !accept(p, Tok.PComma) {
        break;
      }
    }
  }
  expect_tok(p, Tok.PRbracket, "`]`");
}

fn parse_block_stmts(p: *Parser, end: Tok) -> *Stmt {
  let start: *Token = pk(p);
  let s: *Stmt = mkstmt(StmtKind.StBlock, start.file, start.line, start.col);
  while !at(p, end) && !at_eof(p) {
    let before: usize = p.i;
    let inner: *Stmt = parse_stmt(p);
    if inner != null {
      s.stmts.push(inner);
    }
    if p.i == before {
      advance(p);
    }
  }
  return s;
}

fn parse_block(p: *Parser) -> *Vec[*Stmt] {
  expect_tok(p, Tok.PLbrace, "`{`");
  let s: *Stmt = parse_block_stmts(p, Tok.PRbrace);
  expect_tok(p, Tok.PRbrace, "`}`");
  return s.stmts;
}

fn level_of(k: Tok) -> i32 {
  if k == Tok.POror { return 2; }
  if k == Tok.PAndand { return 3; }
  if k == Tok.PEq { return 4; }
  if k == Tok.PNe { return 4; }
  if k == Tok.PLt { return 5; }
  if k == Tok.PGt { return 5; }
  if k == Tok.PLe { return 5; }
  if k == Tok.PGe { return 5; }
  if k == Tok.PPipe { return 6; }
  if k == Tok.PCaret { return 7; }
  if k == Tok.PAmp { return 8; }
  if k == Tok.PShl { return 9; }
  if k == Tok.PShr { return 9; }
  if k == Tok.PPlus { return 10; }
  if k == Tok.PMinus { return 10; }
  if k == Tok.PStar { return 11; }
  if k == Tok.PSlash { return 11; }
  if k == Tok.PPercent { return 11; }
  return 0 - 1;
}

fn parse_if_body(p: *Parser) -> *Expr {
  let start: *Token = pk(p);
  let e: *Expr = mkexpr(ExprKind.ExIf, start.file, start.line, start.col);
  e.a = parse_expr_bp(p, 0);
  expect_tok(p, Tok.PLbrace, "`{`");
  let then: *Stmt = parse_block_stmts(p, Tok.PRbrace);
  expect_tok(p, Tok.PRbrace, "`}`");
  e.items.push(then);
  if accept(p, Tok.KwElse) {
    if at(p, Tok.KwIf) {
      advance(p);
      e.else_if = parse_if_body(p);
    } else {
      expect_tok(p, Tok.PLbrace, "`{`");
      let els: *Stmt = parse_block_stmts(p, Tok.PRbrace);
      expect_tok(p, Tok.PRbrace, "`}`");
      e.items.push(els);
    }
  }
  return e;
}

fn parse_primary(p: *Parser) -> *Expr {
  let start: *Token = pk(p);
  let k: Tok = start.kind;
  if k == Tok.TkInt {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExInt, start.file, start.line, start.col);
    e.iv = start.iv;
    return e;
  }
  if k == Tok.TkFloat {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExFloat, start.file, start.line, start.col);
    e.fv = start.fv;
    return e;
  }
  if k == Tok.TkStr {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExStr, start.file, start.line, start.col);
    e.sv = start.text;
    return e;
  }
  if k == Tok.KwTrue || k == Tok.KwFalse {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExBool, start.file, start.line, start.col);
    e.bv = k == Tok.KwTrue;
    return e;
  }
  if k == Tok.KwNull {
    advance(p);
    return mkexpr(ExprKind.ExNull, start.file, start.line, start.col);
  }
  if k == Tok.KwSelf {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExName, start.file, start.line, start.col);
    e.sv = start.text;
    return e;
  }
  if k == Tok.KwWeak {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExName, start.file, start.line, start.col);
    e.sv = "weak";
    return e;
  }
  if k == Tok.TkIdent {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExName, start.file, start.line, start.col);
    e.sv = start.text;
    return e;
  }
  if k == Tok.PLparen {
    advance(p);
    let e: *Expr = parse_expr(p);
    expect_tok(p, Tok.PRparen, "`)`");
    return e;
  }
  if k == Tok.KwIf {
    advance(p);
    return parse_if_body(p);
  }
  if k == Tok.KwMatch {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExMatch, start.file, start.line, start.col);
    e.a = parse_expr_bp(p, 0);
    expect_tok(p, Tok.PLbrace, "`{`");
    while !at(p, Tok.PRbrace) && !at_eof(p) {
      let pt: *Token = pk(p);
      let arm: *MatchArm = new MatchArm {
        pk: PatKind.PatWildcard, pat_path: fresh_str_vec(), pat_int: 0,
        variant_index: 0, disc: 0, pat_str: "", pat_names: fresh_str_vec(),
        pat_fields: fresh_field_vec(), body: null,
        file: pt.file, line: pt.line, col: pt.col,
       bind_syms: make([]*Sym, 0), bind_fidx: make([]i64, 0),
  };
      if at(p, Tok.TkInt) {
        advance(p);
        arm.pk = PatKind.PatInt;
        arm.pat_int = pt.iv;
      } else if at(p, Tok.TkStr) {
        advance(p);
        arm.pk = PatKind.PatStr;
        arm.pat_str = pt.text;
      } else if at_ident(p, "_") {
        advance(p);
        arm.pk = PatKind.PatWildcard;
      } else if at(p, Tok.TkIdent) {
        advance(p);
        arm.pat_path.push(pt.text);
        while accept(p, Tok.PDot) {
          let seg: *Token = expect_ident(p, "variant name");
          arm.pat_path.push(seg.text);
        }
        if accept(p, Tok.PLparen) {
          arm.pk = PatKind.PatTuple;
          if !at(p, Tok.PRparen) {
            loop {
              let b: *Token = pk(p);
              if at(p, Tok.TkIdent) {
                advance(p);
                arm.pat_names.push(b.text);
              } else {
                err_at(b.file, b.line, b.col, "expected binding name");
                advance(p);
                arm.pat_names.push("_");
              }
              if !accept(p, Tok.PComma) {
                break;
              }
            }
          }
          expect_tok(p, Tok.PRparen, "`)`");
        } else if accept(p, Tok.PLbrace) {
          arm.pk = PatKind.PatStruct;
          while !at(p, Tok.PRbrace) && !at_eof(p) {
            let fn_tok: *Token = expect_ident(p, "field name");
            let fa: *FieldAst = new FieldAst { name: fn_tok.text, ty: null, file: fn_tok.file, line: fn_tok.line, col: fn_tok.col };
            if accept(p, Tok.PColon) {
              let b: *Token = expect_ident(p, "binding name");
              arm.pat_names.push(b.text);
            } else {
              arm.pat_names.push(fn_tok.text);
            }
            arm.pat_fields.push(fa);
            if !accept(p, Tok.PComma) {
              break;
            }
          }
          expect_tok(p, Tok.PRbrace, "`}`");
        } else {
          arm.pk = PatKind.PatUnit;
        }
      } else {
        err_at(pt.file, pt.line, pt.col, cat3("expected a pattern, found ", tok_name(pt.kind), ""));
        advance(p);
        continue;
      }
      expect_tok(p, Tok.PFatarrow, "`=>`");
      if at(p, Tok.PLbrace) {
        advance(p);
        let blk: *Expr = mkexpr(ExprKind.ExBlock, pt.file, pt.line, pt.col);
        let body: *Stmt = parse_block_stmts(p, Tok.PRbrace);
        expect_tok(p, Tok.PRbrace, "`}`");
        blk.items = body.stmts;
        arm.body = blk;
      } else {
        arm.body = parse_expr(p);
      }
      e.arms.push(arm);
      if !accept(p, Tok.PComma) {
        break;
      }
    }
    expect_tok(p, Tok.PRbrace, "`}`");
    return e;
  }
  if k == Tok.KwNew {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExNew, start.file, start.line, start.col);
    e.ty = parse_type(p);
    expect_tok(p, Tok.PLbrace, "`{`");
    while !at(p, Tok.PRbrace) && !at_eof(p) {
      let fn_tok: *Token = expect_ident(p, "field name");
      expect_tok(p, Tok.PColon, "`:`");
      let fa: *FieldAst = new FieldAst { name: fn_tok.text, ty: null, file: fn_tok.file, line: fn_tok.line, col: fn_tok.col };
      e.args.push(parse_expr(p));
      let name_entry: *Stmt = mkstmt(StmtKind.StBlock, fa.file, fa.line, fa.col);
      name_entry.name = fa.name;
      e.items.push(name_entry);
      if !accept(p, Tok.PComma) {
        break;
      }
    }
    expect_tok(p, Tok.PRbrace, "`}`");
    return e;
  }
  if k == Tok.KwFn {
    advance(p);
    let e: *Expr = mkexpr(ExprKind.ExClosure, start.file, start.line, start.col);
    expect_tok(p, Tok.PLparen, "`(`");
    if !at(p, Tok.PRparen) {
      loop {
        e.params.push(parse_param(p));
        if !accept(p, Tok.PComma) {
          break;
        }
      }
    }
    expect_tok(p, Tok.PRparen, "`)`");
    if accept(p, Tok.PArrow) {
      e.ret = parse_type(p);
    }
    e.items = parse_block(p);
    return e;
  }
  err_at(start.file, start.line, start.col, cat3("expected an expression, found ", tok_name(start.kind), ""));
  advance(p);
  return mkexpr(ExprKind.ExInt, start.file, start.line, start.col);
}

fn parse_postfix(p: *Parser) -> *Expr {
  let mut e: *Expr = parse_primary(p);
  loop {
    let start: *Token = pk(p);
    if accept(p, Tok.PLparen) {
      let call: *Expr = mkexpr(ExprKind.ExCall, start.file, start.line, start.col);
      call.a = e;
      if !at(p, Tok.PRparen) {
        if at(p, Tok.TkIdent) && peek2(p).kind == Tok.PColon {
          let nm: *Token = advance(p);
          advance(p);
          call.arg_names.push(nm.text);
          call.args.push(parse_arg_expr(p));
        } else if e.kind == ExprKind.ExName && streq(e.sv, "make") && at(p, Tok.PLbracket) {
          call.arg_names.push("");
          call.args.push(type_as_expr(p));
        } else {
          call.arg_names.push("");
          call.args.push(parse_arg_expr(p));
        }
        while accept(p, Tok.PComma) {
          if at(p, Tok.TkIdent) && peek2(p).kind == Tok.PColon {
            let nm: *Token = advance(p);
            advance(p);
            call.arg_names.push(nm.text);
            call.args.push(parse_arg_expr(p));
          } else if e.kind == ExprKind.ExName && streq(e.sv, "make") && at(p, Tok.PLbracket) {
            call.arg_names.push("");
            call.args.push(type_as_expr(p));
          } else {
            call.arg_names.push("");
            call.args.push(parse_arg_expr(p));
          }
        }
      }
      expect_tok(p, Tok.PRparen, "`)`");
      e = call;
      continue;
    }
    if accept(p, Tok.PLbracket) {
      if at(p, Tok.PEllipsis2) {
        err_at(start.file, start.line, start.col, "slice needs a start");
        advance(p);
        parse_expr(p);
        expect_tok(p, Tok.PRbracket, "`]`");
        continue;
      }
      let idx: *Expr = parse_expr(p);
      if accept(p, Tok.PEllipsis2) {
        let sl: *Expr = mkexpr(ExprKind.ExSlice, start.file, start.line, start.col);
        sl.a = e;
        sl.b = idx;
        sl.c = parse_expr(p);
        expect_tok(p, Tok.PRbracket, "`]`");
        e = sl;
        continue;
      }
      expect_tok(p, Tok.PRbracket, "`]`");
      let ix: *Expr = mkexpr(ExprKind.ExIndex, start.file, start.line, start.col);
      ix.a = e;
      ix.b = idx;
      e = ix;
      continue;
    }
    if accept(p, Tok.PDot) {
      let name: *Token = expect_ident(p, "field or method name");
      let f: *Expr = mkexpr(ExprKind.ExField, start.file, start.line, start.col);
      f.a = e;
      f.sv = name.text;
      e = f;
      continue;
    }
    if accept(p, Tok.PQmark) {
      let q: *Expr = mkexpr(ExprKind.ExQmark, start.file, start.line, start.col);
      q.a = e;
      e = q;
      continue;
    }
    if at(p, Tok.KwAs) {
      advance(p);
      let c: *Expr = mkexpr(ExprKind.ExCast, start.file, start.line, start.col);
      c.a = e;
      c.ty = parse_type(p);
      e = c;
      continue;
    }
    break;
  }
  return e;
}

fn parse_expr_bp(p: *Parser, min_bp: i32) -> *Expr {
  let start: *Token = pk(p);
  let mut left: *Expr = null;
  let unary_bp: i32 = 12;
  if min_bp <= unary_bp && (at(p, Tok.PBang) || at(p, Tok.PMinus) || at(p, Tok.PTilde) || at(p, Tok.PStar)) {
    let op: *Token = advance(p);
    let operand: *Expr = parse_expr_bp(p, unary_bp);
    let u: *Expr = mkexpr(ExprKind.ExUn, start.file, start.line, start.col);
    u.unop = op.kind;
    u.a = operand;
    left = u;
  } else {
    left = parse_postfix(p);
  }
  loop {
    let bp: i32 = level_of(pk(p).kind);
    if bp < 0 || bp < min_bp {
      break;
    }
    let op: *Token = advance(p);
    let right: *Expr = parse_expr_bp(p, bp + 1);
    let bin: *Expr = mkexpr(ExprKind.ExBin, start.file, start.line, start.col);
    bin.binop = op.kind;
    bin.a = left;
    bin.b = right;
    left = bin;
  }
  return left;
}

fn parse_expr(p: *Parser) -> *Expr {
  return parse_expr_bp(p, 0);
}

fn at_assign_start(p: *Parser) -> bool {
  let k: Tok = pk(p).kind;
  return k == Tok.PAssign || k == Tok.PPluseq || k == Tok.PMinuseq || k == Tok.PStareq
      || k == Tok.PSlasheq || k == Tok.PPercenteq || k == Tok.PAmpeq
      || k == Tok.PPipeeq || k == Tok.PCareteq || k == Tok.PShleq || k == Tok.PShreq;
}

fn mkstmt(kind: StmtKind, file: string, line: i32, col: i32) -> *Stmt {
  return new Stmt {
    kind: kind, file: file, line: line, col: col,
    pre: fresh_str_vec(), mut_: false, tail: false, name: "", ty: null,
    a: null, b: null, assign_op: Tok.TkEof, stmts: fresh_stmt_vec(),
    cond: null, body: fresh_stmt_vec(),
  };
}

fn parse_stmt(p: *Parser) -> *Stmt {
  let start: *Token = pk(p);
  let s: *Stmt = parse_stmt_raw(p);
  if s != null {
    s.pre = start.pre;
  }
  return s;
}

fn parse_stmt_raw(p: *Parser) -> *Stmt {
  let start: *Token = pk(p);
  let k: Tok = start.kind;
  if k == Tok.KwLet {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StLet, start.file, start.line, start.col);
    s.mut_ = accept(p, Tok.KwMut);
    let id: *Token = expect_ident(p, "binding name");
    s.name = id.text;
    if accept(p, Tok.PColon) {
      s.ty = parse_type(p);
    }
    expect_tok(p, Tok.PAssign, "`=` (bindings need an initializer)");
    s.a = parse_expr(p);
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  if k == Tok.KwReturn {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StReturn, start.file, start.line, start.col);
    if !at(p, Tok.PSemi) {
      s.a = parse_expr(p);
    }
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  if k == Tok.KwBreak {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StBreak, start.file, start.line, start.col);
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  if k == Tok.KwContinue {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StContinue, start.file, start.line, start.col);
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  if k == Tok.KwDefer {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StDefer, start.file, start.line, start.col);
    if at(p, Tok.PLbrace) {
      let blk: *Stmt = mkstmt(StmtKind.StBlock, start.file, start.line, start.col);
      blk.stmts = parse_block(p);
      s.stmts.push(blk);
    } else {
      let one: *Stmt = parse_stmt(p);
      s.stmts.push(one);
    }
    return s;
  }
  if k == Tok.KwWhile {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StWhile, start.file, start.line, start.col);
    s.cond = parse_expr(p);
    s.body = parse_block(p);
    return s;
  }
  if k == Tok.KwLoop {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StLoop, start.file, start.line, start.col);
    s.body = parse_block(p);
    return s;
  }
  if k == Tok.PLbrace {
    advance(p);
    let s: *Stmt = mkstmt(StmtKind.StBlock, start.file, start.line, start.col);
    s.stmts = parse_block_stmts(p, Tok.PRbrace).stmts;
    expect_tok(p, Tok.PRbrace, "`}`");
    return s;
  }
  let e: *Expr = parse_expr(p);
  if at_assign_start(p) {
    let op: *Token = advance(p);
    let s: *Stmt = mkstmt(StmtKind.StAssign, start.file, start.line, start.col);
    s.assign_op = op.kind;
    s.a = e;
    s.b = parse_expr(p);
    expect_tok(p, Tok.PSemi, "`;`");
    return s;
  }
  let s: *Stmt = mkstmt(StmtKind.StExpr, start.file, start.line, start.col);
  s.a = e;
  let blocky: bool = e.kind == ExprKind.ExIf || e.kind == ExprKind.ExMatch || e.kind == ExprKind.ExBlock;
  if accept(p, Tok.PSemi) {
    s.tail = false;
  } else if at(p, Tok.PRbrace) {
    s.tail = true;
  } else if blocky {
    s.tail = false;
  } else {
    s.tail = false;
    let t: *Token = pk(p);
    err_at(t.file, t.line, t.col, cat3("expected `;`, found ", tok_name(t.kind), ""));
  }
  return s;
}

fn parse_file(path: string, src: string) -> *Decl {
  let toks: *Vec[*Token] = fresh_token_vec();
  lex_file(path, src, toks);
  let p: *Parser = new Parser { toks: toks.items, i: 0, bare_self_ok: false };
  let module: *Decl = new Decl {
    kind: DeclKind.DkFn, file: path, line: 0, col: 0, pre: fresh_str_vec(),
    pub_: false, is_mut: false, name: "", path: fresh_str_vec(),
    params: fresh_param_vec(), ret: null, fields: fresh_field_vec(),
    variants: fresh_variant_vec(), init: null, body: fresh_stmt_vec(),
    tparams: fresh_str_vec(), is_method: false, recv: "", decls: fresh_decl_vec(),
    target: null, tparam_bounds: fresh_type_vec(),
    templ: null,
    templated: false, tenv: null, owner: null, ceval_ok: false, ceval_is_int: false, ceval_i: 0, ceval_f: 0.0,
  };
  while !at_eof(p) {
    let start: *Token = pk(p);
    let is_pub: bool = accept(p, Tok.KwPub);
    let d: *Decl = new Decl {
      kind: DeclKind.DkFn, file: start.file, line: start.line, col: start.col,
      pre: start.pre, pub_: is_pub, is_mut: false, name: "",
      path: fresh_str_vec(), params: fresh_param_vec(), ret: null,
      fields: fresh_field_vec(), variants: fresh_variant_vec(), init: null,
      body: fresh_stmt_vec(), tparams: fresh_str_vec(), is_method: false,
      recv: "", decls: fresh_decl_vec(), target: null,
      tparam_bounds: fresh_type_vec(), templ: null,
    templated: false, tenv: null, owner: null, ceval_ok: false, ceval_is_int: false, ceval_i: 0, ceval_f: 0.0,
    };
    if accept(p, Tok.KwUse) {
      d.kind = DeclKind.DkUse;
      loop {
        let seg: *Token = expect_ident(p, "module path segment");
        d.path.push(seg.text);
        if !accept(p, Tok.PSlash) {
          break;
        }
      }
      expect_tok(p, Tok.PSemi, "`;`");
    } else if accept(p, Tok.KwExtern) {
      d.kind = DeclKind.DkExtern;
      if at(p, Tok.TkStr) {
        advance(p);
      }
      expect_tok(p, Tok.KwFn, "`fn`");
      let id: *Token = expect_ident(p, "function name");
      d.name = id.text;
      parse_param_list_raw(p, d.params, false);
      if accept(p, Tok.PArrow) {
        d.ret = parse_type(p);
      }
      expect_tok(p, Tok.PSemi, "`;`");
    } else if accept(p, Tok.KwFn) {
      d.kind = DeclKind.DkFn;
      let id: *Token = expect_ident(p, "function name");
      d.name = id.text;
      if accept(p, Tok.PDot) {
        d.recv = id.text;
        let m: *Token = expect_ident(p, "method name");
        d.name = m.text;
      }
      parse_tparams(p, d.tparams, d.tparam_bounds);
      expect_tok(p, Tok.PLparen, "`(`");
      if !at(p, Tok.PRparen) {
        loop {
          let pa: *Param = parse_param(p);
          if d.params.n > 0 && d.params.items[d.params.n - 1].is_variadic {
            err_at(pa.file, pa.line, pa.col, "only the last parameter can be variadic");
          }
          d.params.push(pa);
          if !accept(p, Tok.PComma) {
            break;
          }
        }
      }
      expect_tok(p, Tok.PRparen, "`)`");
      if accept(p, Tok.PArrow) {
        d.ret = parse_type(p);
      }
      if d.params.n > 0 {
        if d.params.items[0].is_self {
          d.is_method = true;
        }
      }
      d.body = parse_block(p);
    } else if accept(p, Tok.KwTrait) {
      d.kind = DeclKind.DkTrait;
      let id: *Token = expect_ident(p, "trait name");
      d.name = id.text;
      expect_tok(p, Tok.PLbrace, "`{`");
      p.bare_self_ok = true;
      while at(p, Tok.KwFn) {
        let m: *Decl = new Decl {
          kind: DeclKind.DkFn, file: pk(p).file, line: pk(p).line, col: pk(p).col,
          pre: fresh_str_vec(), pub_: false, is_mut: false, name: "",
          path: fresh_str_vec(), params: fresh_param_vec(), ret: null,
          fields: fresh_field_vec(), variants: fresh_variant_vec(), init: null,
          body: fresh_stmt_vec(), tparams: fresh_str_vec(), is_method: false,
          recv: "", target: null, tparam_bounds: fresh_type_vec(), decls: fresh_decl_vec(),
          templ: null, templated: false, tenv: null, owner: null,
          ceval_ok: false, ceval_is_int: false, ceval_i: 0, ceval_f: 0.0,
        };
        expect_tok(p, Tok.KwFn, "`fn`");
        let mn: *Token = expect_ident(p, "trait method name");
        m.name = mn.text;
        parse_param_list_raw(p, m.params, true);
        if accept(p, Tok.PArrow) {
          m.ret = parse_type(p);
        }
        if m.params.n > 0 && m.params.items[0].is_self {
          m.is_method = true;
        }
        d.decls.push(m);
        // requirements separate by `,` or `;` (either reads well)
        if accept(p, Tok.PComma) || accept(p, Tok.PSemi) {
          continue;
        }
        break;
      }
      p.bare_self_ok = false;
      expect_tok(p, Tok.PRbrace, "`}`");
    } else if accept(p, Tok.KwImpl) {
      d.kind = DeclKind.DkImpl;
      let id: *Token = expect_ident(p, "trait name");
      d.name = id.text;
      expect_tok(p, Tok.KwFor, "`for`");
      d.target = parse_type(p);
      expect_tok(p, Tok.PLbrace, "`{`");
      while at(p, Tok.KwFn) {
        let m: *Decl = new Decl {
          kind: DeclKind.DkFn, file: pk(p).file, line: pk(p).line, col: pk(p).col,
          pre: fresh_str_vec(), pub_: false, is_mut: false, name: "",
          path: fresh_str_vec(), params: fresh_param_vec(), ret: null,
          fields: fresh_field_vec(), variants: fresh_variant_vec(), init: null,
          body: fresh_stmt_vec(), tparams: fresh_str_vec(), is_method: false,
          recv: "", target: null, tparam_bounds: fresh_type_vec(), decls: fresh_decl_vec(),
          templ: null, templated: false, tenv: null, owner: null,
          ceval_ok: false, ceval_is_int: false, ceval_i: 0, ceval_f: 0.0,
        };
        expect_tok(p, Tok.KwFn, "`fn`");
        let mn: *Token = expect_ident(p, "method name");
        m.name = mn.text;
        parse_param_list_raw(p, m.params, true);
        if accept(p, Tok.PArrow) {
          m.ret = parse_type(p);
        }
        if m.params.n > 0 && m.params.items[0].is_self {
          m.is_method = true;
        }
        m.body = parse_block(p);
        d.decls.push(m);
      }
      expect_tok(p, Tok.PRbrace, "`}`");
    } else if accept(p, Tok.KwStruct) {
      d.kind = DeclKind.DkStruct;
      let id: *Token = expect_ident(p, "struct name");
      d.name = id.text;
      parse_tparams(p, d.tparams, d.tparam_bounds);
      expect_tok(p, Tok.PLbrace, "`{`");
      while !at(p, Tok.PRbrace) && !at_eof(p) {
        let fn_tok: *Token = expect_ident(p, "field name");
        expect_tok(p, Tok.PColon, "`:`");
        let fa: *FieldAst = new FieldAst { name: fn_tok.text, ty: parse_type(p), file: fn_tok.file, line: fn_tok.line, col: fn_tok.col };
        d.fields.push(fa);
        if !accept(p, Tok.PComma) {
          break;
        }
      }
      expect_tok(p, Tok.PRbrace, "`}`");
    } else if accept(p, Tok.KwEnum) {
      d.kind = DeclKind.DkEnum;
      let id: *Token = expect_ident(p, "enum name");
      d.name = id.text;
      parse_tparams(p, d.tparams, d.tparam_bounds);
      expect_tok(p, Tok.PLbrace, "`{`");
      let mut next_disc: u64 = 0;
      while !at(p, Tok.PRbrace) && !at_eof(p) {
        let vn: *Token = expect_ident(p, "variant name");
        let v: *VariantAst = new VariantAst { name: vn.text, vkind: VarKind.VarUnit, types: fresh_type_vec(), fields: fresh_field_vec(), has_disc: false, disc: 0, file: vn.file, line: vn.line, col: vn.col };
        if accept(p, Tok.PLparen) {
          v.vkind = VarKind.VarTuple;
          if !at(p, Tok.PRparen) {
            loop {
              v.types.push(parse_type(p));
              if !accept(p, Tok.PComma) {
                break;
              }
            }
          }
          expect_tok(p, Tok.PRparen, "`)`");
        } else if accept(p, Tok.PLbrace) {
          v.vkind = VarKind.VarStruct;
          while !at(p, Tok.PRbrace) && !at_eof(p) {
            let fn_tok: *Token = expect_ident(p, "field name");
            expect_tok(p, Tok.PColon, "`:`");
            let fa: *FieldAst = new FieldAst { name: fn_tok.text, ty: parse_type(p), file: fn_tok.file, line: fn_tok.line, col: fn_tok.col };
            v.fields.push(fa);
            if !accept(p, Tok.PComma) {
              break;
            }
          }
          expect_tok(p, Tok.PRbrace, "`}`");
        } else {
          v.vkind = VarKind.VarUnit;
        }
        if accept(p, Tok.PAssign) {
          if v.vkind != VarKind.VarUnit {
            err_at(vn.file, vn.line, vn.col, "only unit variants take explicit discriminants");
          }
          let iv: *Token = expect_tok(p, Tok.TkInt, "discriminant");
          v.has_disc = true;
          v.disc = iv.iv;
          next_disc = iv.iv + 1;
        } else {
          v.disc = next_disc;
          next_disc += 1;
        }
        d.variants.push(v);
        if !accept(p, Tok.PComma) {
          break;
        }
      }
      expect_tok(p, Tok.PRbrace, "`}`");
    } else if at(p, Tok.KwStatic) || at(p, Tok.KwConst) {
      let is_static: bool = at(p, Tok.KwStatic);
      advance(p);
      if is_static {
        d.kind = DeclKind.DkStatic;
      } else {
        d.kind = DeclKind.DkConst;
      }
      d.is_mut = is_static && accept(p, Tok.KwMut);
      let id: *Token = expect_ident(p, "name");
      d.name = id.text;
      expect_tok(p, Tok.PColon, "`:`");
      d.ret = parse_type(p);
      expect_tok(p, Tok.PAssign, "`=`");
      d.init = parse_expr(p);
      expect_tok(p, Tok.PSemi, "`;`");
    } else {
      err_at(start.file, start.line, start.col, cat3("expected a declaration (fn/struct/enum/static/const/use), found ", tok_name(start.kind), ""));
      advance(p);
      continue;
    }
      module.decls.push(d);
  }
  module.pre = p.toks[toks.n - 1].pre;
  return module;
}


// ---------------------------------------------------------------- driver ---

struct Diag {
  file: string,
  line: i32,
  col: i32,
  msg: string,
}

static mut diags: *Vec[*Diag] = 0 as *Vec[*Diag];

fn err_at(file: string, line: i32, col: i32, msg: string) {
  if diags == null {
    diags = new Vec[*Diag] { items: make([*Diag], 8), n: 0 };
  }
  diags.push(new Diag { file: file, line: line, col: col, msg: msg });
}

fn diag_count() -> i32 {
  if diags == null {
    return 0;
  }
  return diags.n as i32;
}

fn usage() -> i32 {
  eprintf("{}", "rho 0.4.0\n");
  eprintf("{}", "usage: rho <command> [args]\n");
  eprintf("{}", "  check  <file>              parse + typecheck\n");
  eprintf("{}", "  fmt    [-w] <file>         print canonical formatting\n");
  eprintf("{}", "  build  <file> [-o out]     compile (default target arm64-mac)\n");
  eprintf("{}", "  run    <file> [-- args]    build and run\n");
  eprintf("{}", "  test   [dir] [--target t]  run corpus-style tests\n");
  eprintf("{}", "  selftest [--update-goldens] [--fmt]\n");
  eprintf("{}", "  --version                  print version\n");
  return 2;
}

// ------------------------------------------------------------- dump ------
//
// Canonical s-expression dump of a parsed module (port of boot's dump.c).
// This is the AST's fingerprint: golden-pinned in tests and compared
// byte-for-byte against boot's dumper by the selftest.

fn d_str_lit(s: string) {
  f_strlit(s);
}

fn d_type(t: *TypeAst) {
  if t == null {
    sb_s("void");
    return;
  }
  if t.kind == TypeAstKind.TaPrim {
    sb_s(prim_name(t.prim));
    return;
  }
  if t.kind == TypeAstKind.TaArray {
    if t.size != null {
      sb_c(91);
      d_expr(t.size);
      sb_c(93);
    } else {
      sb_s("[]");
    }
    d_type(t.elem);
    return;
  }
  if t.kind == TypeAstKind.TaPtr {
    sb_c(42);
    d_type(t.elem);
    return;
  }
  if t.kind == TypeAstKind.TaWeak {
    sb_s("weak[");
    d_type(t.elem);
    sb_c(93);
    return;
  }
  if t.kind == TypeAstKind.TaNamed {
    let mut i: usize = 0;
    while i < t.path.n {
      if i > 0 {
        sb_c(46);
      }
      sb_s(t.path.items[i]);
      i += 1;
    }
    if t.targs.n > 0 {
      sb_c(91);
      let mut j: usize = 0;
      while j < t.targs.n {
        if j > 0 {
          sb_s(", ");
        }
        d_type(t.targs.items[j]);
        j += 1;
      }
      sb_c(93);
    }
    return;
  }
  // TaFn
  sb_s("fn(");
  let mut i: usize = 0;
  while i < t.params.n {
    if i > 0 {
      sb_s(", ");
    }
    d_type(t.params.items[i]);
    i += 1;
  }
  sb_s(") -> ");
  d_type(t.ret);
}

fn d_expr(e: *Expr) {
  if e == null {
    sb_s("(void)");
    return;
  }
  if e.kind == ExprKind.ExInt {
    sb_s(cat3("(int ", utoa(e.iv), ")"));
    return;
  }
  if e.kind == ExprKind.ExFloat {
    // canonical float printing: exact for the golden file
    sb_s(cat3("(float ", g_digits(e.fv, 17), ")"));
    return;
  }
  if e.kind == ExprKind.ExStr {
    sb_s("(str ");
    d_str_lit(e.sv);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExBool {
    if e.bv { sb_s("(bool true)"); } else { sb_s("(bool false)"); }
    return;
  }
  if e.kind == ExprKind.ExNull {
    sb_s("(null)");
    return;
  }
  if e.kind == ExprKind.ExName {
    sb_s("(name ");
    sb_s(e.sv);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExType {
    sb_s("(ty ");
    d_type(e.ty);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExBin {
    sb_s(cat3("(bin ", spell_op(e.binop), " "));
    d_expr(e.a);
    sb_c(32);
    d_expr(e.b);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExUn {
    sb_s(cat3("(un ", spell_op(e.unop), " "));
    d_expr(e.a);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExCall {
    sb_s("(call ");
    d_expr(e.a);
    let mut i: usize = 0;
    while i < e.args.n {
      sb_c(32);
      if e.arg_names != null && i < e.arg_names.n && e.arg_names.items[i] != "" {
        sb_s(e.arg_names.items[i]);
        sb_s(": ");
      }
      d_expr(e.args.items[i]);
      i += 1;
    }
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExIndex {
    sb_s("(index ");
    d_expr(e.a);
    sb_c(32);
    d_expr(e.b);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExSlice {
    sb_s("(slice ");
    d_expr(e.a);
    sb_c(32);
    d_expr(e.b);
    sb_c(32);
    d_expr(e.c);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExField {
    sb_s("(field ");
    d_expr(e.a);
    sb_c(32);
    sb_s(e.sv);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExCast {
    sb_s("(cast ");
    d_type(e.ty);
    sb_c(32);
    d_expr(e.a);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExNew {
    sb_s("(new ");
    d_type(e.ty);
    let mut i: usize = 0;
    while i < e.args.n {
      sb_c(32);
      sb_c(40);
      sb_s(e.items.items[i].name);
      sb_c(32);
      d_expr(e.args.items[i]);
      sb_c(41);
      i += 1;
    }
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExMake {
    sb_s("(make ");
    d_type(e.ty);
    sb_c(32);
    d_expr(e.c);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExClosure {
    sb_s("(closure (params");
    let mut i: usize = 0;
    while i < e.params.n {
      sb_c(32);
      sb_c(40);
      sb_s(e.params.items[i].name);
      sb_c(32);
      d_type(e.params.items[i].ty);
      sb_c(41);
      i += 1;
    }
    sb_s(") -> ");
    d_type(e.ret);
    let mut j: usize = 0;
    while j < e.items.n {
      d_stmt(e.items.items[j]);
      j += 1;
    }
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExMatch {
    sb_s("(match ");
    d_expr(e.a);
    let mut i: usize = 0;
    while i < e.arms.n {
      let arm: *MatchArm = e.arms.items[i];
      sb_s(" (arm ");
      if arm.pk == PatKind.PatWildcard {
        sb_s("_");
      } else if arm.pk == PatKind.PatInt {
        sb_s(utoa(arm.pat_int));
      } else if arm.pk == PatKind.PatStr {
        d_str_lit(arm.pat_str);
      } else {
        let mut j: usize = 0;
        while j < arm.pat_path.n {
          if j > 0 {
            sb_c(46);
          }
          sb_s(arm.pat_path.items[j]);
          j += 1;
        }
        if arm.pk == PatKind.PatTuple {
          sb_c(40);
          let mut k: usize = 0;
          while k < arm.pat_names.n {
            if k > 0 {
              sb_c(32);
            }
            sb_s(arm.pat_names.items[k]);
            k += 1;
          }
          sb_c(41);
        } else if arm.pk == PatKind.PatStruct {
          sb_c(123);
          let mut k: usize = 0;
          while k < arm.pat_fields.n {
            if k > 0 {
              sb_c(32);
            }
            sb_s(arm.pat_fields.items[k].name);
            sb_c(32);
            sb_s(arm.pat_names.items[k]);
            k += 1;
          }
          sb_c(125);
        }
      }
      sb_c(32);
      d_expr(arm.body);
      sb_c(41);
      i += 1;
    }
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExQmark {
    sb_s("(qmark ");
    d_expr(e.a);
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExIf {
    sb_s("(if ");
    d_expr(e.a);
    sb_s(" (block");
    if e.items.n > 0 {
      let then: *Stmt = e.items.items[0];
      let mut i: usize = 0;
      while i < then.stmts.n {
        d_stmt(then.stmts.items[i]);
        i += 1;
      }
    }
    sb_c(41);
    if e.else_if != null {
      sb_c(32);
      d_expr(e.else_if);
    } else if e.items.n > 1 {
      sb_s(" (block");
      let else_blk: *Stmt = e.items.items[1];
      let mut i: usize = 0;
      while i < else_blk.stmts.n {
        d_stmt(else_blk.stmts.items[i]);
        i += 1;
      }
      sb_c(41);
    }
    sb_c(41);
    return;
  }
  if e.kind == ExprKind.ExBlock {
    sb_s("(block");
    let mut i: usize = 0;
    while i < e.items.n {
      d_stmt(e.items.items[i]);
      i += 1;
    }
    sb_c(41);
    return;
  }
}

fn d_stmt(s: *Stmt) {
  if s.kind == StmtKind.StLet {
    sb_s(" (let");
    if s.mut_ {
      sb_s(" mut");
    }
    sb_c(32);
    sb_s(s.name);
    sb_c(32);
    d_type(s.ty);
    sb_c(32);
    d_expr(s.a);
    sb_c(41);
    return;
  }
  if s.kind == StmtKind.StAssign {
    sb_s(cat3(" (assign ", spell_op(s.assign_op), " "));
    d_expr(s.a);
    sb_c(32);
    d_expr(s.b);
    sb_c(41);
    return;
  }
  if s.kind == StmtKind.StExpr {
    if s.tail {
      sb_s(" (tail ");
    } else {
      sb_s(" (expr ");
    }
    d_expr(s.a);
    sb_c(41);
    return;
  }
  if s.kind == StmtKind.StReturn {
    sb_s(" (return");
    if s.a != null {
      sb_c(32);
      d_expr(s.a);
    }
    sb_c(41);
    return;
  }
  if s.kind == StmtKind.StBreak {
    sb_s(" (break)");
    return;
  }
  if s.kind == StmtKind.StContinue {
    sb_s(" (continue)");
    return;
  }
  if s.kind == StmtKind.StDefer {
    sb_s(" (defer");
    let mut i: usize = 0;
    while i < s.stmts.n {
      d_stmt(s.stmts.items[i]);
      i += 1;
    }
    sb_c(41);
    return;
  }
  if s.kind == StmtKind.StWhile {
    sb_s(" (while ");
    d_expr(s.cond);
    sb_s(" (block");
    let mut i: usize = 0;
    while i < s.body.n {
      d_stmt(s.body.items[i]);
      i += 1;
    }
    sb_s("))");
    return;
  }
  if s.kind == StmtKind.StLoop {
    sb_s(" (loop (block");
    let mut i: usize = 0;
    while i < s.body.n {
      d_stmt(s.body.items[i]);
      i += 1;
    }
    sb_s("))");
    return;
  }
  // StBlock
  sb_s(" (block");
  let mut i: usize = 0;
  while i < s.stmts.n {
    d_stmt(s.stmts.items[i]);
    i += 1;
  }
  sb_c(41);
}

fn d_decl(d: *Decl) {
  if d.kind == DeclKind.DkFn {
    sb_s(" (fn");
    if d.pub_ {
      sb_s(" pub");
    }
    sb_c(32);
    sb_s(d.name);
    sb_s(" (params");
    let mut i: usize = 0;
    while i < d.params.n {
      sb_c(32);
      sb_c(40);
      sb_s(d.params.items[i].name);
      sb_c(32);
      d_type(d.params.items[i].ty);
      sb_c(41);
      i += 1;
    }
    sb_c(41);
    if d.ret != null {
      sb_s(" (ret ");
      d_type(d.ret);
      sb_c(41);
    }
    let mut j: usize = 0;
    while j < d.body.n {
      d_stmt(d.body.items[j]);
      j += 1;
    }
    sb_c(41);
    return;
  }
  if d.kind == DeclKind.DkExtern {
    sb_s(" (extern ");
    sb_s(d.name);
    sb_s(" (params");
    let mut i: usize = 0;
    while i < d.params.n {
      sb_c(32);
      sb_c(40);
      sb_s(d.params.items[i].name);
      sb_c(32);
      d_type(d.params.items[i].ty);
      sb_c(41);
      i += 1;
    }
    sb_c(41);
    if d.ret != null {
      sb_s(" (ret ");
      d_type(d.ret);
      sb_c(41);
    }
    sb_c(41);
    return;
  }
  if d.kind == DeclKind.DkStruct {
    sb_s(" (struct");
    if d.pub_ {
      sb_s(" pub");
    }
    sb_c(32);
    sb_s(d.name);
    let mut i: usize = 0;
    while i < d.fields.n {
      sb_c(32);
      sb_c(40);
      sb_s(d.fields.items[i].name);
      sb_c(32);
      d_type(d.fields.items[i].ty);
      sb_c(41);
      i += 1;
    }
    sb_c(41);
    return;
  }
  if d.kind == DeclKind.DkEnum {
    sb_s(" (enum");
    if d.pub_ {
      sb_s(" pub");
    }
    sb_c(32);
    sb_s(d.name);
    let mut i: usize = 0;
    while i < d.variants.n {
      let v: *VariantAst = d.variants.items[i];
      sb_c(32);
      sb_c(40);
      sb_s(v.name);
      sb_c(32);
      sb_s(utoa(v.disc));
      if v.vkind == VarKind.VarTuple {
        let mut j: usize = 0;
        while j < v.types.n {
          sb_c(32);
          d_type(v.types.items[j]);
          j += 1;
        }
      } else if v.vkind == VarKind.VarStruct {
        let mut j: usize = 0;
        while j < v.fields.n {
          sb_c(32);
          sb_c(40);
          sb_s(v.fields.items[j].name);
          sb_c(32);
          d_type(v.fields.items[j].ty);
          sb_c(41);
          j += 1;
        }
      }
      sb_c(41);
      i += 1;
    }
    sb_c(41);
    return;
  }
  if d.kind == DeclKind.DkStatic || d.kind == DeclKind.DkConst {
    if d.kind == DeclKind.DkConst {
      sb_s(" (const");
    } else {
      sb_s(" (static");
    }
    if d.is_mut {
      sb_s(" mut");
    }
    sb_c(32);
    sb_s(d.name);
    sb_c(32);
    d_type(d.ret);
    sb_c(32);
    d_expr(d.init);
    sb_c(41);
    return;
  }
  // DkUse
  sb_s(" (use");
  let mut i: usize = 0;
  while i < d.path.n {
    sb_c(32);
    sb_s(d.path.items[i]);
    i += 1;
  }
  sb_c(41);
}

fn dump_module(module: *Decl) -> string {
  g_sb = new Vec[u8] { items: make([]u8, 65536), n: 0 };
  sb_s("(module");
  let mut i: usize = 0;
  while i < module.decls.n {
    d_decl(module.decls.items[i]);
    i += 1;
  }
  sb_s(")\n");
  return intrinsics.slice_string(g_sb.items[0..g_sb.n]);
}

// ---------------------------------------------------------- selftest -----
//
// Port of boot's selftest: AST goldens for tests/frontend, fmt roundtrip +
// idempotence + AST preservation, and diagnostic goldens for tests/diag.
// All goldens are files under tests/golden/ — nothing embedded.

static mut g_st_failures: i32 = 0;

fn st_fail(name: string, msg: string) {
  printf("{}", cat5("FAIL ", name, ": ", msg, "\n"));
  g_st_failures += 1;
}

// the diagnostics vec rendered exactly as print_diags would print it
fn render_diags_str() -> string {
  if diags == null {
    return "";
  }
  g_sb = new Vec[u8] { items: make([]u8, 4096), n: 0 };
  let mut i: usize = 0;
  while i < diags.n {
    let d: *Diag = diags.items[i];
    sb_s(d.file);
    sb_c(58);
    sb_s(itoa(d.line as i64));
    sb_c(58);
    sb_s(itoa(d.col as i64));
    sb_s(": error: ");
    sb_s(d.msg);
    sb_c(10);
    i += 1;
  }
  return intrinsics.slice_string(g_sb.items[0..g_sb.n]);
}

fn golden_check(got: string, golden_path: string, name: string, update: bool) {
  if update {
    if !write_file(golden_path, got) {
      st_fail(name, cat("cannot write golden ", golden_path));
    }
    return;
  }
  let r: Result[string, string] = read_file(golden_path);
  if r.is_err() {
    st_fail(name, cat("missing golden ", golden_path));
    return;
  }
  if !streq(got, r.get_ok()) {
    let tmp: string = cat("build/", cat(name, ".got"));
    write_file(tmp, got);
    st_fail(name, cat5("output differs from ", golden_path, " (wrote ", tmp, ")"));
  }
}

// ---- embedded prelude (generated by tools/embed-prelude.py) ------
fn prelude_core_src() -> string { return """// The rho prelude core — pure, target-independent, prepended to every
// target's tail (hosted / wasi) at embed time. The tails provide
// the four per-target hooks this core builds on:
//
//   __print_str(s: string)   stdout bytes
//   __eprint_str(s: string)  stderr bytes
//   __exit(code: i32)        terminal exit
//   __alloc / __free         allocator hooks
//
// Printing is the to_str protocol (spec §10.1): a type is printable when
// it has a method `to_str(self) -> string`; printf/eprintf fill each `{}`
// in a literal format with the next value's to_str. Every primitive gets
// to_str here; floats go through an exact bigint formatter (the same
// algorithm the self-hosted compiler uses for its canonical goldens) so
// the digits are identical on every target, soft-float included.

// The print protocol as a named trait (0.4.0): satisfaction is computed
// from the method tables, so every primitive's to_str below already
// implements it, and a user type joins by defining to_str — no impl
// block needed unless you want the eager check.
pub trait Show {
  fn to_str(self) -> string,
}

pub enum Option[T] {
  Some(T),
  None,
}

pub enum Result[T, E] {
  Ok(T),
  Err(E),
}

fn Option.is_some(self: Option) -> bool {
  return match self {
    Option.Some(_) => true,
    Option.None => false,
  };
}

fn Option.is_none(self: Option) -> bool {
  return match self {
    Option.Some(_) => false,
    Option.None => true,
  };
}

fn Result.is_ok(self: Result) -> bool {
  return match self {
    Result.Ok(_) => true,
    Result.Err(_) => false,
  };
}

fn Result.is_err(self: Result) -> bool {
  return match self {
    Result.Ok(_) => false,
    Result.Err(_) => true,
  };
}

// ------------------------------------------------------------ panics --

fn panic(msg: string) {
  eprintf("panic: {}\\n", msg);
  __exit(101);
}

fn assert(cond: bool) {
  if !cond {
    panic("assertion failed");
  }
}

fn assert_eq[T: Show](a: T, b: T) {
  if !(a == b) {
    panic(cat(cat("assert_eq failed: ", a.to_str()), cat(" != ", b.to_str())));
  }
}

fn __panic_div() {
  panic("division by zero");
}

fn __panic_oob() {
  panic("index out of bounds");
}

fn __panic_null() {
  panic("null dereference");
}

fn __streq(a: string, b: string) -> bool {
  if len(a) != len(b) {
    return false;
  }
  let mut i: usize = 0;
  while i < len(a) {
    if a[i] != b[i] {
      return false;
    }
    i += 1;
  }
  return true;
}

// --------------------------------------------------------- strings --

fn cat(a: string, b: string) -> string {
  let buf: []u8 = make([]u8, len(a) + len(b));
  let mut i: usize = 0;
  while i < len(a) {
    buf[i] = a[i];
    i += 1;
  }
  let mut j: usize = 0;
  while j < len(b) {
    buf[i + j] = b[j];
    j += 1;
  }
  return intrinsics.slice_string(buf);
}

fn __cat3(a: string, b: string, c: string) -> string {
  return cat(a, cat(b, c));
}

fn __substr(s: string, a: usize, b: usize) -> string {
  let buf: []u8 = make([]u8, b - a);
  let mut i: usize = a;
  while i < b {
    buf[i - a] = s[i];
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

fn __rep0(cnt: usize) -> string {
  let buf: []u8 = make([]u8, cnt);
  let mut i: usize = 0;
  while i < cnt {
    buf[i] = 48;
    i += 1;
  }
  return intrinsics.slice_string(buf);
}

// ------------------------------------------------------ integers --

fn u64.to_str(self: u64) -> string {
  return __fmt_u64(self);
}

fn i64.to_str(self: i64) -> string {
  return __fmt_i64(self);
}

fn __fmt_u64(v: u64) -> string {
  if v == 0 {
    return "0";
  }
  let buf: []u8 = make([]u8, 24);
  let mut n: usize = 24;
  let mut x: u64 = v;
  while x > 0 {
    n -= 1;
    buf[n] = 48 + (x % 10) as u8;
    x /= 10;
  }
  return intrinsics.slice_string(buf[n..24]);
}

fn __fmt_i64(v: i64) -> string {
  if v < 0 {
    // wrapping negation: 0 - MIN is MIN again, whose u64 pattern is exactly
    // the magnitude — correct at the edge where a plain negate would stay
    // negative and corrupt every digit (the 0.2 print_int bug)
    let mag: u64 = (0 - v) as u64;
    return __cat3("-", __fmt_u64(mag), "");
  }
  return __fmt_u64(v as u64);
}

fn u8.to_str(self: u8) -> string {
  return __fmt_u64(self as u64);
}

fn u16.to_str(self: u16) -> string {
  return __fmt_u64(self as u64);
}

fn u32.to_str(self: u32) -> string {
  return __fmt_u64(self as u64);
}

fn usize.to_str(self: usize) -> string {
  return __fmt_u64(self as u64);
}

fn i8.to_str(self: i8) -> string {
  return __fmt_i64(self as i64);
}

fn i16.to_str(self: i16) -> string {
  return __fmt_i64(self as i64);
}

fn i32.to_str(self: i32) -> string {
  return __fmt_i64(self as i64);
}

fn isize.to_str(self: isize) -> string {
  return __fmt_i64(self as i64);
}

fn bool.to_str(self: bool) -> string {
  if self {
    return "true";
  }
  return "false";
}

fn string.to_str(self: string) -> string {
  return self;
}

// --------------------------------------------------------- floats --
//
// Exact decimal formatting: the f64's exact value (m2 * 2^e2) is expanded
// as a base-10^9 bigint, then correctly rounded (half to even) to D
// significant digits — D = 17 for f64, 9 for f32, the counts that always
// round-trip. Pure integer arithmetic; only f64_bits inspects the value.

struct __Big {
  w: []u32,
  n: usize,
}

fn __big_new() -> *__Big {
  return new __Big { w: make([]u32, 160), n: 1 };
}

fn __big_trim(b: *__Big) {
  while b.n > 1 && b.w[b.n - 1] == 0 {
    b.n -= 1;
  }
}

fn __big_set_u64(b: *__Big, v: u64) {
  b.w[0] = (v % 1000000000) as u32;
  b.w[1] = ((v / 1000000000) % 1000000000) as u32;
  b.w[2] = (v / 1000000000000000000) as u32;
  b.n = 3;
  __big_trim(b);
}

// schoolbook multiply by a factor < 1e9; products stay under 2^63
fn __big_mul_u32(b: *__Big, m: u32) {
  let mut carry: u64 = 0;
  let mut i: usize = 0;
  while i < b.n {
    let cur: u64 = b.w[i] as u64 * m as u64 + carry;
    b.w[i] = (cur % 1000000000) as u32;
    carry = cur / 1000000000;
    i += 1;
  }
  while carry > 0 {
    b.w[b.n] = (carry % 1000000000) as u32;
    carry = carry / 1000000000;
    b.n += 1;
  }
}

fn __big_get_u64(b: *__Big) -> u64 {
  let mut v: u64 = 0;
  let mut i: usize = b.n;
  while i > 0 {
    i -= 1;
    v = v * 1000000000 + b.w[i] as u64;
  }
  return v;
}

fn __big_add_one(b: *__Big) {
  let mut i: usize = 0;
  loop {
    if i >= b.n {
      b.w[i] = 1;
      b.n += 1;
      return;
    }
    b.w[i] = b.w[i] + 1;
    if b.w[i] < 1000000000 {
      return;
    }
    b.w[i] = 0;
    i += 1;
  }
}

fn __big_cmp(a: *__Big, b: *__Big) -> i32 {
  if a.n != b.n {
    if a.n < b.n {
      return 0 - 1;
    }
    return 1;
  }
  let mut i: usize = a.n;
  while i > 0 {
    i -= 1;
    if a.w[i] != b.w[i] {
      if a.w[i] < b.w[i] {
        return 0 - 1;
      }
      return 1;
    }
  }
  return 0;
}

fn __p10_u64(r: usize) -> u64 {
  let mut v: u64 = 1;
  let mut i: usize = 0;
  while (i as i64) < r as i64 {
    v = v * 10;
    i += 1;
  }
  return v;
}

fn __pow2_u32(k: i64) -> u32 {
  let mut v: u32 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 2;
    i += 1;
  }
  return v;
}

fn __pow5_u32(k: i64) -> u32 {
  let mut v: u32 = 1;
  let mut i: i64 = 0;
  while i < k {
    v = v * 5;
    i += 1;
  }
  return v;
}

// strip trailing '0's ("1000" -> "1", "000" -> "")
fn __strip0(fr: string) -> string {
  let mut k: usize = len(fr);
  while k > 0 && fr[k - 1] == 48 {
    k -= 1;
  }
  return __substr(fr, 0, k);
}

fn __u32_digits(v: u32) -> i64 {
  let mut d: i64 = 1;
  let mut x: u32 = v;
  while x >= 10 {
    x = x / 10;
    d += 1;
  }
  return d;
}

// 5 * 10^(cut-1): half of the divisor 10^cut
fn __big_half(cut: usize) -> *__Big {
  let h: *__Big = __big_new();
  let pos: usize = cut - 1;
  let l: usize = pos / 9;
  let r: usize = pos % 9;
  h.w[l] = (5 * __p10_u64(r)) as u32;
  h.n = l + 1;
  return h;
}

// Q = N div 10^cut (returned); N becomes N mod 10^cut
fn __big_divmod_pow10(b: *__Big, cut: usize) -> *__Big {
  let l: usize = cut / 9;
  let r: usize = cut % 9;
  let q: *__Big = __big_new();
  if b.n <= l {
    return q;
  }
  let qn: usize = b.n - l;
  let p: u64 = __p10_u64(r);
  let mut rem: u64 = 0;
  let mut i: usize = qn;
  while i > 0 {
    i -= 1;
    let cur: u64 = rem * 1000000000 + b.w[l + i] as u64;
    q.w[i] = (cur / p) as u32;
    rem = cur % p;
  }
  q.n = qn;
  __big_trim(q);
  if r > 0 {
    b.w[l] = rem as u32;
    b.n = l + 1;
  } else {
    b.n = l;
  }
  if b.n == 0 {
    b.w[0] = 0;
    b.n = 1;
  }
  __big_trim(b);
  return q;
}

// sign prefix helper: the digits body works on the magnitude
fn __sfmt(neg: bool, s: string) -> string {
  if neg {
    return __cat3("-", s, "");
  }
  return s;
}

fn __fmt_digits(x: f64, prec: i64) -> string {
  let bits: u64 = intrinsics.f64_bits(x);
  // everything below works on the magnitude bits: the sign of a NaN is
  // hardware-defined (x86 invalid ops produce a negative "indefinite" NaN,
  // arm64 a positive default one), so it is stripped here, reattached as
  // text where it is meaningful, and NaN prints canonically unsigned
  let neg: bool = (bits >> 63) == 1;
  let m: u64 = bits & 9223372036854775807;
  let be: u64 = (m >> 52) & 2047;
  if be == 2047 {
    if (m & 4503599627370495) == 0 {
      if neg {
        return "-inf";
      }
      return "inf";
    }
    return "nan";
  }
  if (m << 1) == 0 {
    if neg {
      return "-0.0";
    }
    return "0.0";
  }
  let mut m2: u64 = 0;
  let mut e2: i64 = 0;
  if be == 0 {
    m2 = m & 4503599627370495;
    e2 = (0 - 1074) as i64;
  } else {
    m2 = (m & 4503599627370495) | 4503599627370496;
    e2 = be as i64 - 1075;
  }
  // exact integer N with x == N / 10^s
  let b: *__Big = __big_new();
  __big_set_u64(b, m2);
  let mut s: i64 = 0;
  if e2 >= 0 {
    let mut k: i64 = e2;
    while k >= 29 {
      __big_mul_u32(b, 536870912);
      k -= 29;
    }
    if k > 0 {
      __big_mul_u32(b, __pow2_u32(k));
    }
  } else {
    // x = m2 * 2^-k = (m2 * 5^k) / 10^k — powers of FIVE: multiplying by
    // powers of ten here would smuggle extra factors of two into N
    let mut k: i64 = 0 - e2;
    while k >= 9 {
      __big_mul_u32(b, 1953125);
      s += 9;
      k -= 9;
    }
    if k > 0 {
      __big_mul_u32(b, __pow5_u32(k));
      s += k;
    }
  }
  // n: x = 0.<digits> * 10^n; cut at `prec` significant digits
  let topd: i64 = __u32_digits(b.w[b.n - 1]);
  let mut n: i64 = (b.n as i64 - 1) * 9 + topd - s;
  let cut: i64 = s + n - prec;
  let mut qv: u64 = 0;
  if cut > 0 {
    let q: *__Big = __big_divmod_pow10(b, cut as usize);
    // round half to even on the exact remainder
    let c: i32 = __big_cmp(b, __big_half(cut as usize));
    if c > 0 || (c == 0 && (q.w[0] & 1) == 1) {
      __big_add_one(q);
    }
    qv = __big_get_u64(q);
  } else if cut == 0 {
    qv = __big_get_u64(b);
  } else {
    let mut k: i64 = 0 - cut;
    while k >= 9 {
      __big_mul_u32(b, 1000000000);
      k -= 9;
    }
    if k > 0 {
      __big_mul_u32(b, __p10_u64(k as usize) as u32);
    }
    qv = __big_get_u64(b);
  }
  // round-up carry: 999...9.7 -> 10^prec -> re-exponent
  if qv >= __p10_u64(prec as usize) {
    qv = qv / 10;
    n += 1;
  }
  let e10: i64 = n - 1;
  let ds: string = __fmt_u64(qv);
  if e10 >= (0 - 4) as i64 && e10 < prec {
    if e10 >= 0 {
      let ip: usize = e10 as usize + 1;
      let frac: string = __strip0(__substr(ds, ip, prec as usize));
      if len(frac) == 0 {
        return __sfmt(neg, __substr(ds, 0, ip));
      }
      return __sfmt(neg, __cat3(__substr(ds, 0, ip), __cat3(".", frac, ""), ""));
    }
    let all: string = __strip0(__cat3(__rep0((0 - e10 - 1) as usize), ds, ""));
    if len(all) == 0 {
      return __sfmt(neg, "0");
    }
    return __sfmt(neg, __cat3("0.", all, ""));
  }
  let mut out: string = __substr(ds, 0, 1);
  let frac: string = __strip0(__substr(ds, 1, prec as usize));
  if len(frac) > 0 {
    out = __cat3(out, __cat3(".", frac, ""), "");
  }
  let mut ae: i64 = e10;
  if ae < 0 {
    ae = 0 - ae;
  }
  let mut es: string = __fmt_i64(ae);
  if ae < 10 {
    es = __cat3("0", es, "");
  }
  if e10 < 0 {
    return __sfmt(neg, __cat3(out, __cat3("e-", es, ""), ""));
  }
  return __sfmt(neg, __cat3(out, __cat3("e+", es, ""), ""));
}

// integral float results keep a visible fraction ("4" -> "4.0") so a float
// never reads as an integer; inf/nan are complete as printed
fn __with_frac(s: string) -> string {
  if s == "inf" || s == "nan" || s == "-inf" || s == "-nan" {
    return s;
  }
  let mut i: usize = 0;
  while i < len(s) {
    if s[i] == 46 || s[i] == 101 {
      return s;
    }
    i += 1;
  }
  return cat(s, ".0");
}

fn f64.to_str(self: f64) -> string {
  return __with_frac(__fmt_digits(self, 17));
}

fn f32.to_str(self: f32) -> string {
  // f32 values are exact in f64; 9 significant digits round-trip f32
  return __with_frac(__fmt_digits(self as f64, 9));
}

// --------------------------------------------------------- print --
//
// printf/eprintf/format are compiler builtins: each `{}` in the literal
// format takes the next value's to_str (spec §10.1). A printing call
// desugars into the variadic sinks below — one string run per
// placeholder, one to_str call per value — so printing rides the same
// slice plumbing user variadics do; format desugars into __fmt_build and
// returns the joined string as a value.

fn __fmt_print(parts: string...) {
  let mut i: usize = 0;
  while i < len(parts) {
    __print_str(parts[i]);
    i += 1;
  }
}

fn __fmt_eprint(parts: string...) {
  let mut i: usize = 0;
  while i < len(parts) {
    __eprint_str(parts[i]);
    i += 1;
  }
}

fn __fmt_build(parts: string...) -> string {
  let mut n: usize = 0;
  let mut i: usize = 0;
  while i < len(parts) {
    n += len(parts[i]);
    i += 1;
  }
  let buf: []u8 = make([]u8, n);
  let mut o: usize = 0;
  i = 0;
  while i < len(parts) {
    let p: string = parts[i];
    let mut j: usize = 0;
    while j < len(p) {
      buf[o] = p[j];
      o += 1;
      j += 1;
    }
    i += 1;
  }
  return intrinsics.slice_string(buf);
}
"""; }
fn prelude_mac_src() -> string { return """// arm64-mac prelude tail: freestanding — the runtime stubs (_write, _exit)
// ride in the image (assembled by rho's own assembler), and __alloc is a
// bump allocator over the image heap (zero-filled __DATA tail, initialized
// by _rho_rt_start before main). No libc anywhere.

extern fn write(fd: i32, buf: *u8, n: usize) -> isize;

extern fn exit(code: i32) -> void;

// ---- allocator (0.4.2): size-bucket recycling over the bump heap --------
// six stride classes with a chunk registry (mirrors the wasi tail)

static mut HEAP: usize = 65536;

fn bump_big(n: usize) -> *u8 {
  let p: usize = HEAP;
  let mut end: usize = p + n;
  end = (end + 15) & 18446744073709551600;
  HEAP = end;
  return p as *u8;
}

fn zero_bytes(from: usize, count: usize) {
  let mut k: usize = 0;
  while k + 8 <= count {
    intrinsics.store_u64((from + k) as *u8, 0);
    k += 8;
  }
  while k < count {
    intrinsics.store_u8((from + k) as *u8, 0);
    k += 1;
  }
}

fn dead_mark() -> usize {
  return 6510615555426900570;
}

static mut FL0: usize = 0;
static mut FL1: usize = 0;
static mut FL2: usize = 0;
static mut FL3: usize = 0;
static mut FL4: usize = 0;
static mut FL5: usize = 0;
static mut C0: usize = 0;
static mut E0: usize = 0;
static mut C1: usize = 0;
static mut E1: usize = 0;
static mut C2: usize = 0;
static mut E2: usize = 0;
static mut C3: usize = 0;
static mut E3: usize = 0;
static mut C4: usize = 0;
static mut E4: usize = 0;
static mut C5: usize = 0;
static mut E5: usize = 0;
static mut LO0: usize = 0;
static mut HI0: usize = 0;
static mut LO1: usize = 0;
static mut HI1: usize = 0;
static mut LO2: usize = 0;
static mut HI2: usize = 0;
static mut LO3: usize = 0;
static mut HI3: usize = 0;
static mut LO4: usize = 0;
static mut HI4: usize = 0;
static mut LO5: usize = 0;
static mut HI5: usize = 0;

// chunk registry: every bucket chunk ever carved, as (base, end, class)
// triples in raw bump storage. The per-class LO/HI pair only covers the
// CURRENT chunk — without the registry, a block handed out from an older
// chunk fails the region test when it dies and leaks, the freelist
// starves, and a long compile grinds through chunks it never reuses (the
// emit-phase treadmill: freelists empty while the cursor climbs).
static mut CT: usize = 0;
static mut CTN: usize = 0;
static mut CTC: usize = 0;

fn as_class_stride(k: usize) -> usize {
  if k == 0 { return 64; }
  if k == 1 { return 128; }
  if k == 2 { return 256; }
  if k == 3 { return 512; }
  if k == 4 { return 1024; }
  return 4096;
}

fn as_note_chunk(base: usize, end_: usize, k: usize) {
  if CTN == CTC {
    let mut newcap: usize = 16;
    if CTC != 0 {
      newcap = CTC * 2;
    }
    let p: usize = bump_big(newcap * 24) as usize;
    let mut i: usize = 0;
    while i < CTN * 3 {
      intrinsics.store_u64((p + i * 8) as *u8,
                           intrinsics.load_u64((CT + i * 8) as *u8));
      i += 1;
    }
    CT = p;
    CTC = newcap;
  }
  intrinsics.store_u64((CT + CTN * 24) as *u8, base as u64);
  intrinsics.store_u64((CT + CTN * 24 + 8) as *u8, end_ as u64);
  intrinsics.store_u64((CT + CTN * 24 + 16) as *u8, k as u64);
  CTN += 1;
}

fn __alloc(n: usize) -> *u8 {
  if n <= 64 {
    if FL0 != 0 {
      let h: usize = FL0;
      FL0 = intrinsics.load_u64((h + 16) as *u8) as usize;
      zero_bytes(h + 24, 40);
      return h as *u8;
    }
    if C0 == E0 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 0);
      LO0 = chunk;
      HI0 = chunk + 16777216;
      C0 = chunk + 64;
      E0 = chunk + 16777216;
      zero_bytes(chunk + 24, 40);
      return chunk as *u8;
    }
    let h2: usize = C0;
    C0 = C0 + 64;
    zero_bytes(h2 + 24, 40);
    return h2 as *u8;
  }
  if n <= 128 {
    if FL1 != 0 {
      let h3: usize = FL1;
      FL1 = intrinsics.load_u64((h3 + 16) as *u8) as usize;
      zero_bytes(h3 + 24, 104);
      return h3 as *u8;
    }
    if C1 == E1 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 1);
      LO1 = chunk;
      HI1 = chunk + 16777216;
      C1 = chunk + 128;
      E1 = chunk + 16777216;
      zero_bytes(chunk + 24, 104);
      return chunk as *u8;
    }
    let h4: usize = C1;
    C1 = C1 + 128;
    zero_bytes(h4 + 24, 104);
    return h4 as *u8;
  }
  if n <= 256 {
    if FL2 != 0 {
      let h5: usize = FL2;
      FL2 = intrinsics.load_u64((h5 + 16) as *u8) as usize;
      zero_bytes(h5 + 24, 232);
      return h5 as *u8;
    }
    if C2 == E2 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 2);
      LO2 = chunk;
      HI2 = chunk + 16777216;
      C2 = chunk + 256;
      E2 = chunk + 16777216;
      zero_bytes(chunk + 24, 232);
      return chunk as *u8;
    }
    let h6: usize = C2;
    C2 = C2 + 256;
    zero_bytes(h6 + 24, 232);
    return h6 as *u8;
  }
  if n <= 512 {
    if FL3 != 0 {
      let h7: usize = FL3;
      FL3 = intrinsics.load_u64((h7 + 16) as *u8) as usize;
      zero_bytes(h7 + 24, 488);
      return h7 as *u8;
    }
    if C3 == E3 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 3);
      LO3 = chunk;
      HI3 = chunk + 16777216;
      C3 = chunk + 512;
      E3 = chunk + 16777216;
      zero_bytes(chunk + 24, 488);
      return chunk as *u8;
    }
    let h8: usize = C3;
    C3 = C3 + 512;
    zero_bytes(h8 + 24, 488);
    return h8 as *u8;
  }
  if n <= 1024 {
    if FL4 != 0 {
      let h9: usize = FL4;
      FL4 = intrinsics.load_u64((h9 + 16) as *u8) as usize;
      zero_bytes(h9 + 24, 1000);
      return h9 as *u8;
    }
    if C4 == E4 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 4);
      LO4 = chunk;
      HI4 = chunk + 16777216;
      C4 = chunk + 1024;
      E4 = chunk + 16777216;
      zero_bytes(chunk + 24, 1000);
      return chunk as *u8;
    }
    let h10: usize = C4;
    C4 = C4 + 1024;
    zero_bytes(h10 + 24, 1000);
    return h10 as *u8;
  }
  if n <= 4096 {
    if FL5 != 0 {
      let h11: usize = FL5;
      FL5 = intrinsics.load_u64((h11 + 16) as *u8) as usize;
      zero_bytes(h11 + 24, 4072);
      return h11 as *u8;
    }
    if C5 == E5 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 5);
      LO5 = chunk;
      HI5 = chunk + 16777216;
      C5 = chunk + 4096;
      E5 = chunk + 16777216;
      zero_bytes(chunk + 24, 4072);
      return chunk as *u8;
    }
    let h12: usize = C5;
    C5 = C5 + 4096;
    zero_bytes(h12 + 24, 4072);
    return h12 as *u8;
  }
  return bump_big(n);
}

static mut BADFREE: usize = 0;

fn __free(p: *u8) {
  let a: usize = p as usize;
  if intrinsics.load_u64(a as *u8) == dead_mark() {
    return;
  }
  // the release path frees only after its dec brought the count to zero;
  // a nonzero count here means a stale owner released a block that has
  // since been reused — refuse it (a leak, never a corruption) and say so
  if intrinsics.load_u64(a as *u8) != 0 {
    BADFREE += 1;
    if BADFREE < 8 {
      __eprint_str(__cat3("BADFREE a=", __fmt_u64(a as u64), " rc="));
      __eprint_str(__cat3("", __fmt_u64(intrinsics.load_u64(a as *u8)), "\\n"));
    }
    return;
  }
  if a >= LO0 && a < HI0 && (a - LO0) % 64 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL0 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL0 = a;
    return;
  }
  if a >= LO1 && a < HI1 && (a - LO1) % 128 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL1 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL1 = a;
    return;
  }
  if a >= LO2 && a < HI2 && (a - LO2) % 256 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL2 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL2 = a;
    return;
  }
  if a >= LO3 && a < HI3 && (a - LO3) % 512 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL3 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL3 = a;
    return;
  }
  if a >= LO4 && a < HI4 && (a - LO4) % 1024 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL4 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL4 = a;
    return;
  }
  if a >= LO5 && a < HI5 && (a - LO5) % 4096 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL5 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL5 = a;
    return;
  }
  // exhausted chunks: the block's chunk is in the registry, not in LO/HI
  let mut t: usize = 0;
  while t < CTN {
    let base: usize = intrinsics.load_u64((CT + t * 24) as *u8) as usize;
    let hi: usize = intrinsics.load_u64((CT + t * 24 + 8) as *u8) as usize;
    if a >= base && a < hi {
      let k: usize = intrinsics.load_u64((CT + t * 24 + 16) as *u8) as usize;
      let s: usize = as_class_stride(k);
      if (a - base) % s == 0 {
        if k == 0 {
          intrinsics.store_u64((a + 16) as *u8, FL0 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL0 = a;
          return;
        }
        if k == 1 {
          intrinsics.store_u64((a + 16) as *u8, FL1 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL1 = a;
          return;
        }
        if k == 2 {
          intrinsics.store_u64((a + 16) as *u8, FL2 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL2 = a;
          return;
        }
        if k == 3 {
          intrinsics.store_u64((a + 16) as *u8, FL3 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL3 = a;
          return;
        }
        if k == 4 {
          intrinsics.store_u64((a + 16) as *u8, FL4 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL4 = a;
          return;
        }
        intrinsics.store_u64((a + 16) as *u8, FL5 as u64);
        intrinsics.store_u64(a as *u8, dead_mark() as u64);
        FL5 = a;
        return;
      }
    }
    t += 1;
  }
}

fn __fl_count6(head: usize) -> usize {
  let mut n: usize = 0;
  let mut p: usize = head;
  while p != 0 {
    n += 1;
    p = intrinsics.load_u64((p + 16) as *u8) as usize;
  }
  return n;
}

fn __alloc_dbg() -> usize {
  return __fl_count6(FL0) * 64 + __fl_count6(FL1) * 128 + __fl_count6(FL2) * 256
       + __fl_count6(FL3) * 512 + __fl_count6(FL4) * 1024 + __fl_count6(FL5) * 4096;
}

fn __heap_ptr() -> usize {
  return HEAP;
}


fn __print_str(s: string) {
  write(1, s.ptr, s.len);
}

fn __eprint_str(s: string) {
  write(2, s.ptr, s.len);
}

fn __exit(code: i32) {
  exit(code);
}

// ---- toolchain host hooks (0.3.x): args + file io over the RT blob -------
// The externs below are bound by the runtime blob the image builder ships
// (raw BSD syscalls; argv captured from the LC_MAIN entry registers).
extern fn open(path: *u8, flags: i32, mode: i32) -> i32;
extern fn read(fd: i32, buf: *u8, n: usize) -> isize;
extern fn close(fd: i32) -> i32;
extern fn rename(old_path: *u8, new_path: *u8) -> i32;
extern fn _NSGetArgc() -> *i32;
extern fn _NSGetArgv() -> **u8;

fn __open(path: *u8, flags: i32, mode: i32) -> i32 {
  return open(path, flags, mode);
}

fn __read(fd: i32, buf: *u8, n: usize) -> isize {
  return read(fd, buf, n);
}

fn __write(fd: i32, buf: *u8, n: usize) -> isize {
  return write(fd, buf, n);
}

fn __close(fd: i32) -> i32 {
  return close(fd);
}

// images must land on a fresh vnode: an in-place rewrite of an ad-hoc-signed
// executable leaves the kernel's cached page-hash validation stale and the
// next exec wedges in kernel space. write-to-tmp + __rename is the law for
// every image-producing path on this target.
fn __rename(old_path: *u8, new_path: *u8) -> i32 {
  return rename(old_path, new_path);
}

fn __can_spawn() -> bool {
  return true;
}

fn __program_args() -> []string {
  let count: usize = (*_NSGetArgc()) as usize;
  let raw: *u8 = *_NSGetArgv(); // char**
  let args: []string = make([]string, count);
  let mut i: usize = 0;
  while i < count {
    let s: *u8 = (intrinsics.load_u64((raw as usize + i * 8) as *u8) as usize) as *u8;
    args[i] = __str_from_c(s);
    i += 1;
  }
  return args;
}

// read a NUL-terminated C string out of foreign memory
fn __str_from_c(p: *u8) -> string {
  let mut n: usize = 0;
  loop {
    if intrinsics.load_u8(((p as usize) + n) as *u8) == 0 {
      break;
    }
    n += 1;
  }
  let raw: []u8 = make([]u8, n);
  let mut i: usize = 0;
  while i < n {
    raw[i] = intrinsics.load_u8(((p as usize) + i) as *u8);
    i += 1;
  }
  return intrinsics.slice_string(raw);
}
"""; }
fn prelude_wasi_src() -> string { return """// wasm32-wasi prelude tail: fd_write/proc_write imports, a bump allocator
// over the linear-memory heap, and the per-target hooks the core builds on.

extern fn fd_write(fd: i32, iovs: i32, count: i32, nwritten: i32) -> i32;

extern fn proc_exit(code: i32);

extern fn system(cmd: *u8) -> i32;

extern fn chmod(path: *u8, mode: i32) -> i32;

struct Iov {
  p: i32,
  l: i32,
}

// ---- allocator (0.4.2): size-bucket recycling over the bump heap --------
// SIX-CLASS interim version (fixed convention; no big-class recycling)

static mut HEAP: usize = 65536;

fn bump_big(n: usize) -> *u8 {
  let p: usize = HEAP;
  let mut end: usize = p + n;
  end = (end + 7) & 4294967288;
  if end > 4278190080 {
    __eprint_str("rho: wasm32 heap exhausted\\n");
    __exit(101);
  }
  let cur: usize = intrinsics.mem_size() * 65536;
  if end > cur {
    let pages: usize = (end - cur + 65535) / 65536;
    if intrinsics.mem_grow(pages) == 4294967295 {
      __eprint_str("rho: out of linear memory\\n");
      __exit(101);
    }
  }
  HEAP = end;
  return p as *u8;
}

fn zero_bytes(from: usize, count: usize) {
  let mut k: usize = 0;
  while k + 8 <= count {
    intrinsics.store_u64((from + k) as *u8, 0);
    k += 8;
  }
  while k < count {
    intrinsics.store_u8((from + k) as *u8, 0);
    k += 1;
  }
}

fn dead_mark() -> usize {
  return 6510615555426900570;
}

static mut FL0: usize = 0;
static mut FL1: usize = 0;
static mut FL2: usize = 0;
static mut FL3: usize = 0;
static mut FL4: usize = 0;
static mut FL5: usize = 0;
static mut C0: usize = 0;
static mut E0: usize = 0;
static mut C1: usize = 0;
static mut E1: usize = 0;
static mut C2: usize = 0;
static mut E2: usize = 0;
static mut C3: usize = 0;
static mut E3: usize = 0;
static mut C4: usize = 0;
static mut E4: usize = 0;
static mut C5: usize = 0;
static mut E5: usize = 0;
static mut LO0: usize = 0;
static mut HI0: usize = 0;
static mut LO1: usize = 0;
static mut HI1: usize = 0;
static mut LO2: usize = 0;
static mut HI2: usize = 0;
static mut LO3: usize = 0;
static mut HI3: usize = 0;
static mut LO4: usize = 0;
static mut HI4: usize = 0;
static mut LO5: usize = 0;
static mut HI5: usize = 0;

// chunk registry: every bucket chunk ever carved, as (base, end, class)
// triples in raw bump storage. The per-class LO/HI pair only covers the
// CURRENT chunk — without the registry, a block handed out from an older
// chunk fails the region test when it dies and leaks, the freelist
// starves, and a long compile grinds through chunks it never reuses (the
// emit-phase treadmill: freelists empty while the cursor climbs).
static mut CT: usize = 0;
static mut CTN: usize = 0;
static mut CTC: usize = 0;

fn as_class_stride(k: usize) -> usize {
  if k == 0 { return 64; }
  if k == 1 { return 128; }
  if k == 2 { return 256; }
  if k == 3 { return 512; }
  if k == 4 { return 1024; }
  return 4096;
}

fn as_note_chunk(base: usize, end_: usize, k: usize) {
  if CTN == CTC {
    let mut newcap: usize = 16;
    if CTC != 0 {
      newcap = CTC * 2;
    }
    let p: usize = bump_big(newcap * 24) as usize;
    let mut i: usize = 0;
    while i < CTN * 3 {
      intrinsics.store_u64((p + i * 8) as *u8,
                           intrinsics.load_u64((CT + i * 8) as *u8));
      i += 1;
    }
    CT = p;
    CTC = newcap;
  }
  intrinsics.store_u64((CT + CTN * 24) as *u8, base as u64);
  intrinsics.store_u64((CT + CTN * 24 + 8) as *u8, end_ as u64);
  intrinsics.store_u64((CT + CTN * 24 + 16) as *u8, k as u64);
  CTN += 1;
}

fn __alloc(n: usize) -> *u8 {
  if n <= 64 {
    if FL0 != 0 {
      let h: usize = FL0;
      FL0 = intrinsics.load_u64((h + 16) as *u8) as usize;
      zero_bytes(h + 24, 40);
      return h as *u8;
    }
    if C0 == E0 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 0);
      LO0 = chunk;
      HI0 = chunk + 16777216;
      C0 = chunk + 64;
      E0 = chunk + 16777216;
      zero_bytes(chunk + 24, 40);
      return chunk as *u8;
    }
    let h2: usize = C0;
    C0 = C0 + 64;
    zero_bytes(h2 + 24, 40);
    return h2 as *u8;
  }
  if n <= 128 {
    if FL1 != 0 {
      let h3: usize = FL1;
      FL1 = intrinsics.load_u64((h3 + 16) as *u8) as usize;
      zero_bytes(h3 + 24, 104);
      return h3 as *u8;
    }
    if C1 == E1 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 1);
      LO1 = chunk;
      HI1 = chunk + 16777216;
      C1 = chunk + 128;
      E1 = chunk + 16777216;
      zero_bytes(chunk + 24, 104);
      return chunk as *u8;
    }
    let h4: usize = C1;
    C1 = C1 + 128;
    zero_bytes(h4 + 24, 104);
    return h4 as *u8;
  }
  if n <= 256 {
    if FL2 != 0 {
      let h5: usize = FL2;
      FL2 = intrinsics.load_u64((h5 + 16) as *u8) as usize;
      zero_bytes(h5 + 24, 232);
      return h5 as *u8;
    }
    if C2 == E2 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 2);
      LO2 = chunk;
      HI2 = chunk + 16777216;
      C2 = chunk + 256;
      E2 = chunk + 16777216;
      zero_bytes(chunk + 24, 232);
      return chunk as *u8;
    }
    let h6: usize = C2;
    C2 = C2 + 256;
    zero_bytes(h6 + 24, 232);
    return h6 as *u8;
  }
  if n <= 512 {
    if FL3 != 0 {
      let h7: usize = FL3;
      FL3 = intrinsics.load_u64((h7 + 16) as *u8) as usize;
      zero_bytes(h7 + 24, 488);
      return h7 as *u8;
    }
    if C3 == E3 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 3);
      LO3 = chunk;
      HI3 = chunk + 16777216;
      C3 = chunk + 512;
      E3 = chunk + 16777216;
      zero_bytes(chunk + 24, 488);
      return chunk as *u8;
    }
    let h8: usize = C3;
    C3 = C3 + 512;
    zero_bytes(h8 + 24, 488);
    return h8 as *u8;
  }
  if n <= 1024 {
    if FL4 != 0 {
      let h9: usize = FL4;
      FL4 = intrinsics.load_u64((h9 + 16) as *u8) as usize;
      zero_bytes(h9 + 24, 1000);
      return h9 as *u8;
    }
    if C4 == E4 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 4);
      LO4 = chunk;
      HI4 = chunk + 16777216;
      C4 = chunk + 1024;
      E4 = chunk + 16777216;
      zero_bytes(chunk + 24, 1000);
      return chunk as *u8;
    }
    let h10: usize = C4;
    C4 = C4 + 1024;
    zero_bytes(h10 + 24, 1000);
    return h10 as *u8;
  }
  if n <= 4096 {
    if FL5 != 0 {
      let h11: usize = FL5;
      FL5 = intrinsics.load_u64((h11 + 16) as *u8) as usize;
      zero_bytes(h11 + 24, 4072);
      return h11 as *u8;
    }
    if C5 == E5 {
      let chunk: usize = bump_big(16777216) as usize;
      as_note_chunk(chunk, chunk + 16777216, 5);
      LO5 = chunk;
      HI5 = chunk + 16777216;
      C5 = chunk + 4096;
      E5 = chunk + 16777216;
      zero_bytes(chunk + 24, 4072);
      return chunk as *u8;
    }
    let h12: usize = C5;
    C5 = C5 + 4096;
    zero_bytes(h12 + 24, 4072);
    return h12 as *u8;
  }
  return bump_big(n);
}

static mut BADFREE: usize = 0;

fn __free(p: *u8) {
  let a: usize = p as usize;
  if intrinsics.load_u64(a as *u8) == dead_mark() {
    return;
  }
  // the release path frees only after its dec brought the count to zero;
  // a nonzero count here means a stale owner released a block that has
  // since been reused — refuse it (a leak, never a corruption) and say so
  if intrinsics.load_u64(a as *u8) != 0 {
    BADFREE += 1;
    if BADFREE < 8 {
      __eprint_str(__cat3("BADFREE a=", __fmt_u64(a as u64), " rc="));
      __eprint_str(__cat3("", __fmt_u64(intrinsics.load_u64(a as *u8)), "\\n"));
    }
    return;
  }
  if a >= LO0 && a < HI0 && (a - LO0) % 64 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL0 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL0 = a;
    return;
  }
  if a >= LO1 && a < HI1 && (a - LO1) % 128 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL1 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL1 = a;
    return;
  }
  if a >= LO2 && a < HI2 && (a - LO2) % 256 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL2 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL2 = a;
    return;
  }
  if a >= LO3 && a < HI3 && (a - LO3) % 512 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL3 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL3 = a;
    return;
  }
  if a >= LO4 && a < HI4 && (a - LO4) % 1024 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL4 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL4 = a;
    return;
  }
  if a >= LO5 && a < HI5 && (a - LO5) % 4096 == 0 {
    intrinsics.store_u64((a + 16) as *u8, FL5 as u64);
    intrinsics.store_u64(a as *u8, dead_mark() as u64);
    FL5 = a;
    return;
  }
  // exhausted chunks: the block's chunk is in the registry, not in LO/HI
  let mut t: usize = 0;
  while t < CTN {
    let base: usize = intrinsics.load_u64((CT + t * 24) as *u8) as usize;
    let hi: usize = intrinsics.load_u64((CT + t * 24 + 8) as *u8) as usize;
    if a >= base && a < hi {
      let k: usize = intrinsics.load_u64((CT + t * 24 + 16) as *u8) as usize;
      let s: usize = as_class_stride(k);
      if (a - base) % s == 0 {
        if k == 0 {
          intrinsics.store_u64((a + 16) as *u8, FL0 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL0 = a;
          return;
        }
        if k == 1 {
          intrinsics.store_u64((a + 16) as *u8, FL1 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL1 = a;
          return;
        }
        if k == 2 {
          intrinsics.store_u64((a + 16) as *u8, FL2 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL2 = a;
          return;
        }
        if k == 3 {
          intrinsics.store_u64((a + 16) as *u8, FL3 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL3 = a;
          return;
        }
        if k == 4 {
          intrinsics.store_u64((a + 16) as *u8, FL4 as u64);
          intrinsics.store_u64(a as *u8, dead_mark() as u64);
          FL4 = a;
          return;
        }
        intrinsics.store_u64((a + 16) as *u8, FL5 as u64);
        intrinsics.store_u64(a as *u8, dead_mark() as u64);
        FL5 = a;
        return;
      }
    }
    t += 1;
  }
}

fn __fl_count6(head: usize) -> usize {
  let mut n: usize = 0;
  let mut p: usize = head;
  while p != 0 {
    n += 1;
    p = intrinsics.load_u64((p + 16) as *u8) as usize;
  }
  return n;
}

fn __alloc_dbg() -> usize {
  return __fl_count6(FL0) * 64 + __fl_count6(FL1) * 128 + __fl_count6(FL2) * 256
       + __fl_count6(FL3) * 512 + __fl_count6(FL4) * 1024 + __fl_count6(FL5) * 4096;
}

fn __heap_ptr() -> usize {
  return HEAP;
}


// TEMP instrumentation (strip before release): walk every bucket freelist
// and report how many blocks are parked — carved minus parked minus the
// per-class residue is the live estimate
fn __print_str(s: string) {
  let iov = new Iov { p: (s.ptr as usize) as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(1, iov as usize as i32, 1, nw as usize as i32);
}

fn __eprint_str(s: string) {
  let iov = new Iov { p: (s.ptr as usize) as i32, l: s.len as i32 };
  let nw = new Iov { p: 0, l: 0 };
  fd_write(2, iov as usize as i32, 1, nw as usize as i32);
}

fn __exit(code: i32) {
  proc_exit(code);
}

// ---- toolchain host hooks (0.3.x): args + file io over raw wasi ----------
// The self-hosted compiler body calls these per-target hooks; this tail
// implements them over wasi_snapshot_preview1. fd 3 is the preopened
// working directory wasmtime hands the guest.

extern fn args_sizes_get(count: i32, buf: i32) -> i32;
extern fn args_get(argv: i32, buf: i32) -> i32;
extern fn path_open(fd: i32, dirflags: i32, path: i32, path_len: i32,
                    oflags: i32, rights_base: u64, rights_inheriting: u64,
                    fdflags: i32, opened: i32) -> i32;
extern fn fd_read(fd: i32, iovs: i32, iovs_len: i32, nread: i32) -> i32;
extern fn fd_close(fd: i32) -> i32;
// wasmtime 40's preview1 adapter takes the two-directory form:
// (old_fd, old_path, old_len, new_fd, new_path, new_len)
extern fn path_rename(old_fd: i32, old_path: i32, old_path_len: i32,
                      new_fd: i32, new_path: i32, new_path_len: i32) -> i32;

fn __c_len(p: *u8) -> i32 {
  let mut n: i32 = 0;
  loop {
    if intrinsics.load_u8(((p as usize) + (n as usize)) as *u8) == 0 {
      break;
    }
    n += 1;
  }
  return n;
}

// flags: 0 = read-only, nonzero = create/truncate + write
fn __open(path: *u8, flags: i32, mode: i32) -> i32 {
  let plen: i32 = __c_len(path);
  let mut oflags: i32 = 0;
  let mut rights: u64 = 2; // FD_READ
  if flags != 0 {
    oflags = 1 | 8; // CREAT | TRUNC
    rights = (2 | 4) as u64; // FD_READ | FD_WRITE
  }
  let out: *u8 = __alloc(4);
  let err: i32 = path_open(3, 0, path as usize as i32, plen, oflags,
                           rights, rights, 0, out as usize as i32);
  if err != 0 {
    return -1;
  }
  return intrinsics.load_u64(out) as i32;
}

fn __read(fd: i32, buf: *u8, n: usize) -> isize {
  let iov = new Iov { p: buf as usize as i32, l: n as i32 };
  let nr = new Iov { p: 0, l: 0 };
  if fd_read(fd, iov as usize as i32, 1, nr as usize as i32) != 0 {
    return -1;
  }
  // the out-param address IS &nr (the struct base): the count lands in .p
  return nr.p as isize;
}

fn __write(fd: i32, buf: *u8, n: usize) -> isize {
  let iov = new Iov { p: buf as usize as i32, l: n as i32 };
  let nw = new Iov { p: 0, l: 0 };
  if fd_write(fd, iov as usize as i32, 1, nw as usize as i32) != 0 {
    return -1;
  }
  // the out-param address IS &nw (the struct base): the count lands in .p
  return nw.p as isize;
}

fn __close(fd: i32) -> i32 {
  return fd_close(fd);
}

// tmp+rename keeps every write on a fresh path; over WASI it rides the
// preopened cwd (fd 3), so both paths must be relative to it
fn __rename(old_path: *u8, new_path: *u8) -> i32 {
  return path_rename(3, old_path as usize as i32, __c_len(old_path),
                     3, new_path as usize as i32, __c_len(new_path));
}

fn __can_spawn() -> bool {
  return false;
}

fn __program_args() -> []string {
  let info: *u8 = __alloc(8); // [count: i32][bufsize: i32]
  if args_sizes_get(info as usize as i32, ((info as usize) + 4) as i32) != 0 {
    return make([]string, 0);
  }
  let count: usize = intrinsics.load_u32(info) as usize;
  let bufsize: usize = intrinsics.load_u32(((info as usize) + 4) as *u8) as usize;
  if count == 0 {
    return make([]string, 0);
  }
  let argv: *u8 = __alloc(count * 4 + 8);
  let buf: *u8 = __alloc(bufsize + 8);
  if args_get(argv as usize as i32, buf as usize as i32) != 0 {
    return make([]string, 0);
  }
  let args: []string = make([]string, count);
  let mut i: usize = 0;
  while i < count {
    let p: usize = intrinsics.load_u32(((argv as usize) + (i * 4)) as *u8) as usize;
    let n: usize = __c_len(p as *u8) as usize;
    let raw: []u8 = make([]u8, n);
    let mut k: usize = 0;
    while k < n {
      raw[k] = intrinsics.load_u8(((p as usize) + k) as *u8);
      k += 1;
    }
    args[i] = intrinsics.slice_string(raw);
    i += 1;
  }
  return args;
}
"""; }
fn prelude_hosted_src() -> string { return """// hosted prelude tail (amd64-linux / arm64-mac): libc externs, the four
// per-target hooks the core builds on (__print_str / __eprint_str / __exit
// / __alloc / __free), and the cc-runner externs the toolchain itself uses.

extern fn malloc(n: usize) -> *u8;

extern fn calloc(nm: usize, sz: usize) -> *u8;

extern fn free(p: *u8);

extern fn system(cmd: *u8) -> i32;

extern fn chmod(path: *u8, mode: i32) -> i32;

extern fn write(fd: i32, buf: *u8, n: usize) -> isize;

extern fn exit(code: i32) -> void;

fn __alloc(n: usize) -> *u8 {
  // zeroed: fresh element slots read as null references, so the first
  // assignment into a slot releases null (a no-op) instead of stale heap
  // bytes reinterpreted as a reference count
  return calloc(1, n);
}

fn __free(p: *u8) {
  free(p);
}
fn __heap_ptr() -> usize {
  return 0; // hosted allocates through libc; there is no bump pointer
}


fn __print_str(s: string) {
  write(1, s.ptr, s.len);
}

fn __eprint_str(s: string) {
  write(2, s.ptr, s.len);
}

fn __exit(code: i32) {
  exit(code);
}

// ---- toolchain host hooks (0.3.x): args + file io over libc --------------
extern fn open(path: *u8, flags: i32, mode: i32) -> i32;
extern fn read(fd: i32, buf: *u8, n: usize) -> isize;
extern fn close(fd: i32) -> i32;
extern fn _NSGetArgc() -> *i32;
extern fn _NSGetArgv() -> **u8;

fn __open(path: *u8, flags: i32, mode: i32) -> i32 {
  return open(path, flags, mode);
}

fn __read(fd: i32, buf: *u8, n: usize) -> isize {
  return read(fd, buf, n);
}

fn __write(fd: i32, buf: *u8, n: usize) -> isize {
  return write(fd, buf, n);
}

fn __close(fd: i32) -> i32 {
  return close(fd);
}

fn __can_spawn() -> bool {
  return true;
}

fn __program_args() -> []string {
  let count: usize = (*_NSGetArgc()) as usize;
  let raw: *u8 = *_NSGetArgv(); // char**
  let args: []string = make([]string, count);
  let mut i: usize = 0;
  while i < count {
    let s: *u8 = (intrinsics.load_u64((raw as usize + i * 8) as *u8) as usize) as *u8;
    args[i] = __str_from_c(s);
    i += 1;
  }
  return args;
}

// read a NUL-terminated C string out of foreign memory
fn __str_from_c(p: *u8) -> string {
  let mut n: usize = 0;
  loop {
    if intrinsics.load_u8(((p as usize) + n) as *u8) == 0 {
      break;
    }
    n += 1;
  }
  let raw: []u8 = make([]u8, n);
  let mut i: usize = 0;
  while i < n {
    raw[i] = intrinsics.load_u8(((p as usize) + i) as *u8);
    i += 1;
  }
  return intrinsics.slice_string(raw);
}
"""; }
// core + per-target tail, concatenated exactly as tools/embed.py
// does for the boot compiler — the image is standalone (no boot/
// tree, no CWD dependence)
fn read_prelude(tail: string) -> Result[string, string] {
  if streq(tail, "mac.rho") {
    return Result.Ok(cat(prelude_core_src(), prelude_mac_src()));
  }
  if streq(tail, "wasi.rho") {
    return Result.Ok(cat(prelude_core_src(), prelude_wasi_src()));
  }
  if streq(tail, "hosted.rho") {
    return Result.Ok(cat(prelude_core_src(), prelude_hosted_src()));
  }
  return Result.Ok(prelude_core_src());
}
// ---- end embedded prelude -----------------------------------------

fn st_reset_with_prelude() {
  reset_compiler_state();
  let pr: Result[string, string] = read_prelude("hosted.rho");
  if pr.is_err() {
    return;
  }
  let pparse: *Decl = parse_file("<prelude>", pr.get_ok());
  let pmod: *Module = new Module {
    path: "<prelude>", ns: "", root: pparse,
    syms: sm_new(), is_prelude: true, checked: false,
  };
  check_all(pmod);
  prelude_module = pmod;
}

fn cmd_selftest(args: []string) -> i32 {
  let mut update: bool = false;
  let mut fmt_only: bool = false;
  let mut ai: usize = 2;
  while ai < len(args) {
    if streq(args[ai], "--update-goldens") {
      update = true;
    } else if streq(args[ai], "--fmt") {
      fmt_only = true;
    }
    ai += 1;
  }
  g_st_failures = 0;
  // 1. AST goldens + 2. fmt roundtrip: tests/frontend/*.rho
  let fe: *Vec[string] = list_dir_rho("tests/frontend");
  let mut fi: usize = 0;
  while fi < fe.n {
    let path: string = fe.items[fi];
    let name: string = basename_no_ext(path);
    if !fmt_only {
      st_reset_with_prelude();
      let src_r: Result[string, string] = read_file(path);
      if src_r.is_err() {
        st_fail(name, cat("cannot read ", path));
        fi += 1;
        continue;
      }
      let root: *Decl = parse_file(path, src_r.get_ok());
      golden_check(dump_module(root), cat("tests/golden/ast/", cat(name, ".dump")), name, update);
      if diag_count() > 0 {
        golden_check(render_diags_str(), cat("tests/golden/diag/", cat(name, "_parse.err")), cat(name, " parse"), update);
      }
      let m: *Module = new Module {
        path: path, ns: "", root: root, syms: sm_new(),
        is_prelude: false, checked: false,
      };
      check_all(m);
      if diag_count() > 0 {
        golden_check(render_diags_str(), cat("tests/golden/diag/", cat(name, "_check.err")), cat(name, " check"), update);
      }
    }
    // fmt roundtrip + idempotence (parse errors naturally skip via check)
    st_reset_with_prelude();
    let src2: Result[string, string] = read_file(path);
    if src2.is_err() {
      fi += 1;
      continue;
    }
    let root2: *Decl = parse_file(path, src2.get_ok());
    if diag_count() == 0 {
      let once: string = fmt_module(root2);
      let reparsed: *Decl = parse_file(path, once);
      if diag_count() > 0 {
        st_fail(cat(name, " fmt"), cat("fmt output does not reparse:\n", render_diags_str()));
      } else {
        let twice: string = fmt_module(reparsed);
        if !streq(once, twice) {
          st_fail(cat(name, " fmt"), "fmt is not idempotent");
        }
        // strongest pin: reformatting must preserve the AST exactly
        if !streq(dump_module(root2), dump_module(reparsed)) {
          st_fail(cat(name, " fmt"), "fmt changed the AST");
        }
        // and the reformatted source must still typecheck the same
        st_reset_with_prelude();
        let m2: *Module = new Module {
          path: path, ns: "", root: reparsed, syms: sm_new(),
          is_prelude: false, checked: false,
        };
        check_module(m2);
        if diag_count() > 0 {
          st_fail(cat(name, " fmt"), cat("fmt output fails check:\n", render_diags_str()));
        }
      }
    }
    fi += 1;
  }
  // 3. diagnostic goldens: tests/diag/*.rho -> tests/golden/diag/<name>.err
  if !fmt_only {
    let dg: *Vec[string] = list_dir_rho("tests/diag");
    let mut di: usize = 0;
    while di < dg.n {
      let path: string = dg.items[di];
      let name: string = basename_no_ext(path);
      st_reset_with_prelude();
      let src_r: Result[string, string] = read_file(path);
      if src_r.is_err() {
        st_fail(name, cat("cannot read ", path));
        di += 1;
        continue;
      }
      let root: *Decl = parse_file(path, src_r.get_ok());
      let m: *Module = new Module {
        path: path, ns: "", root: root, syms: sm_new(),
        is_prelude: false, checked: false,
      };
      check_all(m);
      golden_check(render_diags_str(), cat("tests/golden/diag/", cat(name, ".err")), name, update);
      di += 1;
    }
  }
  if g_st_failures == 0 {
    printf("{}", "selftest ok\n");
  } else {
    printf("{}", cat("selftest: ", cat(itoa(g_st_failures as i64), " failure(s)\n")));
  }
  if g_st_failures > 0 {
    return 1;
  }
  return 0;
}

// list *.rho files under dir (boot: `find <dir> -name '*.rho' | sort`)
fn list_dir_rho(dir: string) -> *Vec[string] {
  // directory listing needs a spawn-capable host (boot's wasm build lists
  // nothing); freestanding images have no popen, so this stays empty there
  let out: *Vec[string] = new Vec[string] { items: make([]string, 64), n: 0 };
  if !__can_spawn() {
    return out;
  }
  return list_dir_rho_hosted(dir, out);
}

// the hosted listing: `find | sort` one line at a time over the prelude's
// spawn hook when the target provides one, else empty
fn list_dir_rho_hosted(dir: string, out: *Vec[string]) -> *Vec[string] {
  if !__can_spawn() {
    return out;
  }
  eprintf("{}", cat3("rho: directory listing of `", dir, "` is unavailable on this target\n"));
  return out;
}

fn basename_no_ext(path: string) -> string {
  let mut start: usize = 0;
  let mut i: usize = 0;
  while i < len(path) {
    if path[i] == 47 {
      start = i + 1;
    }
    i += 1;
  }
  let mut end: usize = len(path);
  let mut j: usize = len(path);
  while j > start {
    if path[j - 1] == 46 {
      end = j - 1;
      break;
    }
    j -= 1;
  }
  return substr(path, start, end);
}

// `// exit: N` on the source's first line pins the expected exit code
fn expected_exit(src: string) -> i32 {
  let mut n: usize = 0;
  while n < len(src) && src[n] != 10 {
    n += 1;
  }
  let mut i: usize = 0;
  while i + 5 <= n {
    if src[i] == 101 && src[i + 1] == 120 && src[i + 2] == 105 && src[i + 3] == 116 && src[i + 4] == 58 {
      let mut k: usize = i + 5;
      let mut neg: bool = false;
      while k < n && (src[k] == 32 || src[k] == 9) {
        k += 1;
      }
      if k < n && src[k] == 45 {
        neg = true;
        k += 1;
      }
      let mut v: i32 = 0;
      while k < n && src[k] >= 48 && src[k] <= 57 {
        v = v * 10 + (src[k] - 48) as i32;
        k += 1;
      }
      if neg {
        return 0 - v;
      }
      return v;
    }
    i += 1;
  }
  return 0;
}

fn read_file_or_empty(path: string) -> string {
  let r: Result[string, string] = read_file(path);
  if r.is_err() {
    return "";
  }
  return r.get_ok();
}

fn parse_target_name(s: string) -> i32 {
  // 0 = amd64-linux, 1 = amd64-mac, 2 = arm64-mac (default), 3 = wasm32-wasi,
  // 4 = arm64-linux
  if streq(s, "wasm32-wasi") {
    return 3;
  }
  if streq(s, "amd64-linux") {
    return 0;
  }
  if streq(s, "amd64-mac") {
    return 1;
  }
  if streq(s, "arm64-linux") {
    return 4;
  }
  return 2;
}

// boot runs one compile per check_reset(): every compile starts from the
// zero state, so `test` driving many builds in one process cannot leak
// interned types, scopes, or IR between files
fn reset_compiler_state() {
  diags = null;
  g_types = null;
  g_recs = null;
  g_module_type = null;
  cur_scope = null;
  cur_ret = null;
  cur_fn_sym = null;
  next_local_id = 0;
  g_cap_list = null;
  g_cap_boundary = 0;
  cur_module = null;
  prelude_module = null;
  g_aux_modules = null;
  g_prim_methods = null;
  g_tenv = null;
  in_defer = false;
  loop_depth = 0;
  g_ir_fns = null;
  g_ir_uid = 0;
  g_ir_globals = null;
  g_reach_all = null;
  g_reach_keep = null;
  g_reach_work = null;
  g_main_cell = null;
  g_root_module = null;
  g_panic_site = 0;
  g_lit_counter = 0;
  g_closure_counter = 0;
  g_eq_fns = null;
  g_rel_fns = null;
  g_ret_fns = null;
  g_shims = null;
  W = null;
  fb_ctx = null;
  g_label64 = 0;
  g_uid64 = 0;
  g_label_amd = 0;
  g_fconsts = null;
  g_fn_uid = 0;
  g_instantiations = null;
  g_instantiated_names = null;
  g_instantiated_syms = null;
  g_instantiation_depth = 0;
}

// compile one file end to end; silent on success (the caller prints)
static mut g_target_wasm: bool = false;

fn build_to(path: string, target: i32, out_path: string, check_only: bool) -> i32 {
  reset_compiler_state();
  g_target_wasm = target == 3;
  eprintf("{}", cat3("HEAP@start ", itoa(__heap_ptr() as i64), "\n"));
  let src_result: Result[string, string] = read_file(path);
  if src_result.is_err() {
    eprintf("{}", cat3("rho: ", src_result.get_err(), "\n"));
    return 2;
  }
  let module: *Decl = parse_file(path, src_result.get_ok());
  if diag_count() > 0 {
    print_diags();
    return 1;
  }
  let m: *Module = new Module {
    path: path, ns: "", root: module, syms: sm_new(),
    is_prelude: false, checked: false,
  };
  // per-target tail: wasi for wasm32-wasi, the mac tail for every native
  // image (boot: g_prelude_wasm / g_prelude_native)
  let mut prelude_tail: string = "mac.rho";
  if target == 3 {
    prelude_tail = "wasi.rho";
  }
  let prelude_r: Result[string, string] = read_prelude(prelude_tail);
  if !prelude_r.is_err() {
    let pparse: *Decl = parse_file("<prelude>", prelude_r.get_ok());
    let pmod: *Module = new Module {
      path: "<prelude>", ns: "", root: pparse,
      syms: sm_new(), is_prelude: true, checked: false,
    };
    check_all(pmod);
    prelude_module = pmod;
    // registration happens once, inside check_all's own check_module call
  }
  let diags_before: i32 = diag_count();
  let nd: i32 = check_all(m);
  if nd > diags_before {
    print_diags();
    return 1;
  }
  if check_only {
    // check stops here: parse + typecheck ok (boot prints "ok <file>")
    printf("{}", cat4("ok ", path, "\n", ""));
    return 0;
  }
  g_root_module = m;
  eprintf("{}", cat3("HEAP@check-done ", itoa(__heap_ptr() as i64), "\n"));
  lower_program();
  if g_dump_ir {
    lower_dump_ir();
  }
  eprintf("{}", cat3("HEAP@lower-done ", itoa(__heap_ptr() as i64), "\n"));
  if target == 3 {
    let bytes: []u8 = emit_wasm();
    if !write_file(out_path, bytes_as_string(bytes)) {
      eprintf("{}", cat3("rho: cannot write ", out_path, "\n"));
      return 1;
    }
    return 0;
  }
  // native: emit assembly through the target backend, then finish with the
  // in-tree assembler + image writer (or .s only for amd64-mac)
  let mut bytes: []u8 = make([]u8, 0);
  if target == 2 || target == 4 {
    bytes = emit_arm64_text(target);
    eprintf("{}", cat3("HEAP@arm64-text ", itoa(__heap_ptr() as i64), "\n"));
  } else {
    bytes = emit_amd64_text(target);
  }
  if target == 0 || target == 2 || target == 4 {
    eprintf("{}", cat3("HEAP@pre-asm ", itoa(__heap_ptr() as i64), "\n"));
    let rc: i32 = build_native_image(target, bytes, out_path);
    if rc != 0 {
      return 1;
    }
    return 0;
  }
  // shared native tail (amd64-mac): write the assembly text and stop.
  // The toolchain does not shell out to an assembler/linker.
  let s_path: string = cat3(out_path, ".s", "");
  write_file(s_path, bytes_as_string(bytes));
  return 0;
}

// rho test [dir] [--target t]: corpus-style expected-exit/stdout runner
fn cmd_test(args: []string) -> i32 {
  let mut dir: string = "corpus";
  let mut target: i32 = 3; // boot's test defaults to wasm32-wasi
  let mut i: usize = 2;
  while i < len(args) {
    if streq(args[i], "--target") && i + 1 < len(args) {
      target = parse_target_name(args[i + 1]);
      i += 2;
    } else {
      dir = args[i];
      i += 1;
    }
  }
  if !__can_spawn() {
    // driving a corpus spawns wasmtime (wasm) or the built image (native);
    // a compiler image can do neither — boot's wasm build lists nothing
    // and reports an empty run for the same reason
    eprintf("{}", "rho: test needs a spawn-capable host\n");
    return 2;
  }
  let files: *Vec[string] = list_dir_rho(dir);
  let mut failures: i32 = 0;
  let mut ran: i32 = 0;
  // the mirror carries no spawn primitive, so the per-file build+run loop
  // of a hosted toolchain cannot execute here; on a spawn-capable host the
  // listing is what bounds the run
  ran = files.n as i32;
  let mut fi: usize = 0;
  while fi < files.n {
    printf("{}", cat("SKIP ", cat3(basename_no_ext(files.items[fi]), " (no spawn on this target)\n", "")));
    fi += 1;
  }
  let mut verdict: string = "corpus ok";
  if failures > 0 {
    verdict = "corpus FAIL";
  }
  printf("{}", cat5(verdict, ": ", itoa(ran as i64), " ran, ", cat(itoa(failures as i64), " failed\n")));
  if failures > 0 {
    return 1;
  }
  return 0;
}

fn main() -> i32 {
  let args: []string = program_args();
  if len(args) < 2 {
    return usage();
  }
  let cmd: string = args[1];
  if streq(cmd, "--version") || streq(cmd, "version") {
    printf("{}", "rho 0.4.0\n");
    return 0;
  }
  if streq(cmd, "selftest") {
    return cmd_selftest(args);
  }
  if streq(cmd, "fmt") {
    // rho fmt [-w] <file>: parse + canonical print; no check, no prelude
    let mut inplace: bool = false;
    let mut file: string = "";
    let mut fi: usize = 2;
    while fi < len(args) {
      if streq(args[fi], "-w") {
        inplace = true;
      } else {
        file = args[fi];
      }
      fi += 1;
    }
    if streq(file, "") {
      return usage();
    }
    let r: Result[string, string] = read_file(file);
    if r.is_err() {
      eprintf("{}", cat3("rho: ", r.get_err(), "\n"));
      return 2;
    }
    let root: *Decl = parse_file(file, r.get_ok());
    if diag_count() > 0 {
      print_diags();
      return 1;
    }
    let out: string = fmt_module(root);
    if inplace {
      if !write_file(file, out) {
        eprintf("{}", cat3("rho: cannot write ", file, "\n"));
        return 2;
      }
    } else {
      printf("{}", out);
    }
    return 0;
  }
  if streq(cmd, "test") {
    return cmd_test(args);
  }
  if streq(cmd, "run") {
    let mut file: string = "";
    let mut target: i32 = 3;
    let mut ri: usize = 2;
    while ri < len(args) {
      if streq(args[ri], "--target") && ri + 1 < len(args) {
        target = parse_target_name(args[ri + 1]);
        ri += 2;
      } else {
        file = args[ri];
        ri += 1;
      }
    }
    if streq(file, "") {
      return usage();
    }
    let brc: i32 = build_to(file, target, "/tmp/rho_run", false);
    if brc != 0 {
      return brc;
    }
    // a compiler image cannot spawn processes: wasmtime (wasm) and the
    // native image itself must be invoked by the caller
    eprintf("{}", cat3("rho: built /tmp/rho_run", "; invoke it directly (run needs a spawn-capable host)\n", ""));
    return 2;
  }
  if !streq(cmd, "build") && !streq(cmd, "check") {
    return usage();
  }
  let path: string = args[2];
  let mut out_path: string = "a.out";
  // 0 = amd64-linux, 1 = amd64-mac, 2 = arm64-mac, 3 = wasm32-wasi (default)
  let mut target: i32 = 3;
  let mut ai: usize = 3;
  while ai < len(args) {
    if streq(args[ai], "-o") && ai + 1 < len(args) {
      out_path = args[ai + 1];
      ai += 2;
    } else if streq(args[ai], "--target") && ai + 1 < len(args) {
      target = parse_target_name(args[ai + 1]);
      ai += 2;
    } else if streq(args[ai], "--dump-ir") {
      g_dump_ir = true;
      ai += 1;
    } else {
      ai += 1;
    }
  }
  let rc: i32 = build_to(path, target, out_path, streq(cmd, "check"));
  if rc != 0 {
    return rc;
  }
  if streq(cmd, "build") {
    printf("{}", cat5("built ", out_path, "\n", "", ""));
  }
  return 0;
}

fn print_diags() {
  let mut i: usize = 0;
  while i < diags.n {
    let d: *Diag = diags.items[i];
    eprintf("{}", d.file);
    eprintf("{}", ":");
    eprintf("{}", itoa(d.line as i64));
    eprintf("{}", ":");
    eprintf("{}", itoa(d.col as i64));
    eprintf("{}", ": error: ");
    eprintf("{}", d.msg);
    eprintf("{}", "\n");
    i += 1;
  }
}


// ======================== semantic types (check.c port L1) =================
//
// Types are interned by their mangled name: identical types are pointer-
// identical, which is what `ty_eq` (pointer ==) relies on everywhere.

enum TypeKind {
  TyVoid, TyBool, TyI8, TyI16, TyI32, TyI64, TyU8, TyU16, TyU32,
  TyU64, TyF32, TyF64, TyStringK, TyUsize, TyIsize,
  TyIntLit, TyFloatLit, TyNull,
  TyArray, TySlice, TyPtr, TyWeak, TyFn, TyStruct, TyEnum, TyErr, TyDyn,
  TyModule, TyParam,
}

static mut g_types: *TypeMap = 0 as *TypeMap;
static mut g_recs: *TypeMap = 0 as *TypeMap;

fn type_map() -> *TypeMap {
  if g_types == null {
    g_types = tm_new();
  }
  return g_types;
}

fn rec_map() -> *TypeMap {
  if g_recs == null {
    g_recs = tm_new();
  }
  return g_recs;
}

fn ty_intern2(key: string, t: *Type) -> *Type {
  let found: *Type = tm_lookup(type_map(), key);
  if found != null {
    return found;
  }
  t.mangled = key;
  return tm_intern(type_map(), key, t);
}

// friendly type name for diagnostics (boot: ty_name(t) = t->mangled)
fn ty_name(t: *Type) -> string {
  if t == null {
    return "<null>";
  }
  return t.mangled;
}

fn prim_kind(prim: i32) -> TypeKind {
  if prim == 0 { return TypeKind.TyBool; }
  if prim == 1 { return TypeKind.TyI8; }
  if prim == 2 { return TypeKind.TyI16; }
  if prim == 3 { return TypeKind.TyI32; }
  if prim == 4 { return TypeKind.TyI64; }
  if prim == 5 { return TypeKind.TyU8; }
  if prim == 6 { return TypeKind.TyU16; }
  if prim == 7 { return TypeKind.TyU32; }
  if prim == 8 { return TypeKind.TyU64; }
  if prim == 9 { return TypeKind.TyF32; }
  if prim == 10 { return TypeKind.TyF64; }
  if prim == 11 { return TypeKind.TyStringK; }
  if prim == 12 { return TypeKind.TyUsize; }
  if prim == 13 { return TypeKind.TyIsize; }
  return TypeKind.TyVoid;
}

fn prim_name(prim: i32) -> string {
  if prim == 0 { return "bool"; }
  if prim == 1 { return "i8"; }
  if prim == 2 { return "i16"; }
  if prim == 3 { return "i32"; }
  if prim == 4 { return "i64"; }
  if prim == 5 { return "u8"; }
  if prim == 6 { return "u16"; }
  if prim == 7 { return "u32"; }
  if prim == 8 { return "u64"; }
  if prim == 9 { return "f32"; }
  if prim == 10 { return "f64"; }
  if prim == 11 { return "string"; }
  if prim == 12 { return "usize"; }
  if prim == 13 { return "isize"; }
  return "void";
}

fn ty_prim(prim: i32) -> *Type {
  return ty_intern2(prim_name(prim), new Type {
    kind: prim_kind(prim), elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_ptr(elem: *Type) -> *Type {
  return ty_intern2(cat("*", elem.mangled), new Type {
    kind: TypeKind.TyPtr, elem: elem, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_weak(elem: *Type) -> *Type {
  return ty_intern2(cat3("weak[", elem.mangled, "]"), new Type {
    kind: TypeKind.TyWeak, elem: elem, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_slice(elem: *Type) -> *Type {
  return ty_intern2(cat("[]", elem.mangled), new Type {
    kind: TypeKind.TySlice, elem: elem, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_array(elem: *Type, len: u64) -> *Type {
  return ty_intern2(cat3(cat3("[", itoa(len as i64), "]"), elem.mangled, ""), new Type {
    kind: TypeKind.TyArray, elem: elem, len: len, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "",
  });
}

fn ty_fn(params: []*Type, ret: *Type) -> *Type {
  let mut key: string = "fn(";
  let mut i: usize = 0;
  while i < len(params) {
    if i > 0 {
      key = cat(key, ";");
    }
    key = cat(key, params[i].mangled);
    i += 1;
  }
  key = cat3(key, ")->", ret.mangled);
  return ty_intern2(key, new Type {
    kind: TypeKind.TyFn, elem: null, len: 0, rec: null,
    params: params, ret: ret, mangled: "",
  });
}

fn ty_err() -> *Type {
  return ty_intern2("<error>", new Type {
    kind: TypeKind.TyErr, elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "<error>",
  });
}

static mut g_module_type: *Type = 0 as *Type;

fn ty_module() -> *Type {
  if g_module_type == null {
    g_module_type = new Type {
      kind: TypeKind.TyModule, elem: null, len: 0, rec: null,
      params: fresh_type_vec2(), ret: null, mangled: "<module>",
    };
  }
  return g_module_type;
}

fn ty_param_(name: string) -> *Type {
  let t: *Type = new Type {
    kind: TypeKind.TyParam, elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: name,
  };
  return t;
}

fn fresh_type_vec2() -> []*Type {
  return make([]*Type, 0); // empty: push_type appends
}


// ============== symbols & scopes (check.c port L2) ========================

enum SymKind {
  SyLocal, SyParam, SyFn, SyStruct, SyEnum, SyStatic, SyConst,
  SyModule, SyExtern, SyVariant, SyTrait, SyImpl, SyTraitMethod,
}

struct Sym {
  kind: SymKind,
  name: string,
  type: *Type,
  decl: *Decl,
  mutable: bool,
  variant_index: i32,
  local_id: i32,
  symbol: string,
  owner: *Module,
  module: *Module, // SY_MODULE: the referenced module
  trait_rec: *RecType, // SY_TRAIT: the ordered requirement carrier
}

struct Binding { name: string, sym: *Sym, next: *Binding }
struct CScope { bindings: *Binding, parent: *CScope }

static mut cur_scope: *CScope = 0 as *CScope;
static mut cur_ret: *Type = 0 as *Type;
static mut cur_fn_sym: *Sym = 0 as *Sym;
static mut next_local_id: i32 = 0;
static mut g_cap_list: *Vec[*Sym] = 0 as *Vec[*Sym];
static mut g_cap_boundary: i32 = 0;

fn scope_push() {
  let s: *CScope = new CScope { bindings: null, parent: cur_scope };
  cur_scope = s;
}

fn scope_pop() {
  cur_scope = cur_scope.parent;
}

fn scope_decl(name: string, sym: *Sym) {
  if scope_lookup_local(cur_scope, name) != null {
    if cur_fn_sym != null {
      err_at(cur_fn_sym.decl.file, 0, 0, cat3("duplicate name `", name, "`"));
    } else {
      err_at(cur_module.path, 0, 0, cat3("duplicate name `", name, "`"));
    }
    return;
  }
  let b: *Binding = new Binding { name: name, sym: sym, next: cur_scope.bindings };
  cur_scope.bindings = b;
}

fn scope_lookup_local(s: *CScope, name: string) -> *Sym {
  let mut b: *Binding = s.bindings;
  while b != null {
    if streq(b.name, name) {
      return b.sym;
    }
    b = b.next;
  }
  return null;
}

fn scope_lookup(name: string) -> *Sym {
  let mut s: *CScope = cur_scope;
  while s != null {
    let sym: *Sym = scope_lookup_local(s, name);
    if sym != null {
      return sym;
    }
    s = s.parent;
  }
  return null;
}

fn lookup(name: string) -> *Sym {
  let mut s: *CScope = cur_scope;
  while s != null {
    let sym: *Sym = scope_lookup_local(s, name);
    if sym != null {
      return sym;
    }
    s = s.parent;
  }
  if cur_module != null {
    let msym: *Sym = sm_get(cur_module.syms, name);
    if msym != null {
      return msym;
    }
  }
  if prelude_module != null && prelude_module != cur_module {
    return sm_get(prelude_module.syms, name);
  }
  return null;
}


// ============== module walk (check.c port L3) =============================

struct SymMapEnt { key: string, val: *Sym }
struct SymMap { items: []*SymMapEnt, n: usize }

fn sm_new() -> *SymMap {
  return new SymMap { items: make([]*SymMapEnt, 4096), n: 0 };
}

fn sm_put(m: *SymMap, key: string, val: *Sym) {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      m.items[i].val = val;
      return;
    }
    i += 1;
  }
  let e: *SymMapEnt = new SymMapEnt { key: key, val: val };
  m.items[m.n] = e;
  m.n += 1;
}

fn sm_get(m: *SymMap, key: string) -> *Sym {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return null;
}

struct Module {
  path: string,
  ns: string,
  root: *Decl,
  syms: *SymMap,
  is_prelude: bool,
  checked: bool,
}

static mut cur_module: *Module = 0 as *Module;
static mut prelude_module: *Module = 0 as *Module;
static mut g_aux_modules: *Vec[*Module] = 0 as *Vec[*Module];

// a primitive in the spec sense (§2.1): any named builtin type a method can
// anchor to — every integer width, bool, the two floats, and string
fn ty_is_primitive(t: *Type) -> bool {
  if t.kind == TypeKind.TyBool || t.kind == TypeKind.TyI8 ||
     t.kind == TypeKind.TyI16 || t.kind == TypeKind.TyI32 ||
     t.kind == TypeKind.TyI64 || t.kind == TypeKind.TyU8 ||
     t.kind == TypeKind.TyU16 || t.kind == TypeKind.TyU32 ||
     t.kind == TypeKind.TyU64 || t.kind == TypeKind.TyF32 ||
     t.kind == TypeKind.TyF64 || t.kind == TypeKind.TyStringK ||
     t.kind == TypeKind.TyUsize || t.kind == TypeKind.TyIsize {
    return true;
  }
  return false;
}

// Methods on primitive types (`fn i32.to_str(self: i32)`). Struct and enum
// methods hang off the RecType; primitives are interned singletons without
// one, so their methods live here, keyed by the primitive's mangled name.
// The table is GLOBAL: a duplicate primitive method anywhere — prelude
// included — is an error, so a prelude method can never be silently
// shadowed from user code.
struct PrimMethods {
  key: string,
  syms: []*Sym,
}

static mut g_prim_methods: *Vec[*PrimMethods] = 0 as *Vec[*PrimMethods];

fn prim_method_find(prim: *Type, name: string) -> *Sym {
  if g_prim_methods == null {
    return null;
  }
  let mut i: usize = 0;
  while i < g_prim_methods.n {
    let v: *PrimMethods = g_prim_methods.items[i];
    if streq(v.key, prim.mangled) {
      let mut k: usize = 0;
      while k < len(v.syms) {
        if streq(v.syms[k].name, name) {
          return v.syms[k];
        }
        k += 1;
      }
      return null;
    }
    i += 1;
  }
  return null;
}

// ---- traits, impls, dyn (0.4.0; boot check.c port) ------------------------

static mut g_dyn_types: *TypeMap = 0 as *TypeMap;

fn ty_void() -> *Type {
  return ty_intern2("void", new Type {
    kind: TypeKind.TyVoid, elem: null, len: 0, rec: null,
    params: fresh_type_vec2(), ret: null, mangled: "void",
  });
}

// register an impl block's methods as `Type.name` symbols on the module and
// add an `impl$Trait$Type` symbol so the eager satisfaction check runs once
// every type exists (boot: register_impl_methods)
fn register_impl_methods(m: *Module, d: *Decl) {
  let mut tgt: *TypeAst = d.target;
  while tgt != null && tgt.kind == TypeAstKind.TaPtr {
    tgt = tgt.elem;
  }
  if tgt == null || tgt.kind != TypeAstKind.TaNamed || tgt.path.n != 1 {
    err_at(d.file, d.line, d.col, "impl targets a named type (module-qualified or local)");
    return;
  }
  let tname: string = tgt.path.items[0];
  let mut i: usize = 0;
  while i < d.decls.n {
    let md: *Decl = d.decls.items[i];
    md.recv = tname;
    let sym: *Sym = new Sym {
      kind: SymKind.SyFn, name: md.name, type: null, decl: md,
      mutable: false, variant_index: 0, local_id: 0, symbol: "",
      owner: m, module: null, trait_rec: null,
    };
    let key: string = cat3(tname, cat3(".", md.name, ""), "");
    if sm_get(m.syms, key) != null {
      err_at(md.file, md.line, md.col, cat("duplicate method `", cat3(key, "`", "")));
      i += 1;
      continue;
    }
    sm_put(m.syms, key, sym);
    i += 1;
  }
  let isym: *Sym = new Sym {
    kind: SymKind.SyImpl, name: cat("impl$", cat3(d.name, cat3("$", tname, ""), "")),
    type: null, decl: d, mutable: false, variant_index: 0, local_id: 0,
    symbol: "", owner: m, module: null, trait_rec: null,
  };
  sm_put(m.syms, isym.name, isym);
}

// the dyn type is interned per trait (ty_eq is pointer equality): one Type
// per trait carrier, mangled `dyn$Name`
fn dyn_type_for(trait_sym: *Sym) -> *Type {
  let rec: *RecType = trait_sym.trait_rec;
  if rec == null {
    return ty_err();
  }
  if g_dyn_types == null {
    g_dyn_types = tm_new();
  }
  let hit: *Type = tm_lookup(g_dyn_types, rec.mangled);
  if hit != null {
    return hit;
  }
  let t: *Type = new Type {
    kind: TypeKind.TyDyn, elem: null, len: 0, rec: rec,
    params: fresh_type_vec2(), ret: null, mangled: cat3("dyn$", rec.mangled, ""),
  };
  tm_intern(g_dyn_types, rec.mangled, t);
  return t;
}

// one method on `t` by name: struct/enum method tables (template methods
// included) or the global primitive table
fn method_on_type(t: *Type, name: string) -> *Sym {
  if t == null {
    return null;
  }
  if t.kind == TypeKind.TyPtr {
    t = t.elem;
  }
  if t == null {
    return null;
  }
  if t.kind == TypeKind.TyStruct || t.kind == TypeKind.TyEnum {
    let mut i: usize = 0;
    while i < len(t.rec.methods) {
      let m: *Sym = t.rec.methods[i];
      if streq(m.name, name) {
        return m;
      }
      i += 1;
    }
    if !t.rec.is_template && t.rec.decl.templ != null {
      let tmpl: *RecType = t.rec.decl.templ;
      let mut j: usize = 0;
      while j < len(tmpl.methods) {
        let m: *Sym = tmpl.methods[j];
        if streq(m.name, name) {
          return m;
        }
        j += 1;
      }
    }
    return null;
  }
  if t.kind == TypeKind.TyIntLit {
    t = ty_prim(3);
  } else if t.kind == TypeKind.TyFloatLit {
    t = ty_prim(10);
  }
  if ty_is_primitive(t) {
    return prim_method_find(t, name);
  }
  return null;
}

// does `m` satisfy the requirement `req`? receiver aside, the signatures
// must agree exactly (param count, each ty_eq, return ty_eq)
fn method_satisfies(m: *Sym, req: *Sym) -> bool {
  let mt: *Type = m.type;     // fn(self, rest...) -> R
  let rt: *Type = req.type;   // fn(rest...) -> R (receiver implicit)
  if mt == null || rt == null || mt.kind != TypeKind.TyFn || rt.kind != TypeKind.TyFn {
    return false;
  }
  if len(mt.params) != len(rt.params) + 1 {
    return false;
  }
  let mut i: usize = 0;
  while i < len(rt.params) {
    if mt.params[i + 1] != rt.params[i] {
      return false;
    }
    i += 1;
  }
  return mt.ret == rt.ret;
}

// the missing requirement named by the last trait_satisfied call
static mut g_missing_idx: i32 = 0; // index into the trait's method list

// the whole satisfaction relation, computed from the method tables
fn trait_satisfied(tr: *RecType, t: *Type) -> bool {
  let mut i: usize = 0;
  while i < len(tr.methods) {
    let req: *Sym = tr.methods[i];
    let m: *Sym = method_on_type(t, req.name);
    if m == null || !method_satisfies(m, req) {
      g_missing_idx = i as i32;
      return false;
    }
    i += 1;
  }
  return true;
}

// *T -> dyn Trait, in place: the expr node becomes an EX_DYNBOX wrapping
// a shallow copy of itself, so every caller holding the pointer sees the box
fn try_dyn_coerce(e: *Expr, got: *Type, expected: *Type) -> bool {
  if e == null || expected == null || expected.kind != TypeKind.TyDyn || got == null {
    return false;
  }
  if got.kind != TypeKind.TyPtr || got.elem == null ||
     (got.elem.kind != TypeKind.TyStruct && got.elem.kind != TypeKind.TyEnum) {
    return false; // dyn rides new-allocated struct pointers only
  }
  if !trait_satisfied(expected.rec, got.elem) {
    err_at(e.file, e.line, e.col, cat("`", cat3(ty_name(got.elem), cat("` does not implement `", cat3(expected.rec.mangled, cat("`: missing or mismatched `", cat3(expected.rec.methods[g_missing_idx as usize].name, "`", "")), "")), "")));
    e.typed = ty_err();
    return true; // handled (as an error) — don't double-report below
  }
  let inner: *Expr = new Expr {
    kind: e.kind, file: e.file, line: e.line, col: e.col,
    iv: e.iv, fv: e.fv, sv: e.sv, bv: e.bv, a: e.a, b: e.b, c: e.c,
    binop: e.binop, unop: e.unop, args: e.args, arg_names: e.arg_names,
    items: e.items, ty: e.ty, arms: e.arms, params: e.params, ret: e.ret,
    q_ok: e.q_ok, q_err: e.q_err, else_if: e.else_if, fnval: e.fnval,
    caps: e.caps, typed: e.typed, sym: e.sym, spread: e.spread,
  };
  e.kind = ExprKind.ExDynbox;
  e.a = inner;
  e.b = null;
  e.args = fresh_expr_vec();
  e.arg_names = fresh_str_vec();
  e.typed = expected;
  return true;
}

// resolve the trait carriers and run the impl blocks' eager satisfaction
// checks; runs once struct/enum method tables are wired (boot phase 2)
fn resolve_traits_and_impls(m: *Module) {
  let saved: *Module = cur_module;
  cur_module = m;
  let mut i: usize = 0;
  while i < m.syms.n {
    let sym: *Sym = m.syms.items[i].val;
    if sym.kind == SymKind.SyTrait && sym.type == null {
      // the carrier: methods are the ordered requirement list; the order IS
      // the vtable layout. Method types exclude the receiver.
      let rec: *RecType = new RecType {
        decl: sym.decl, is_prelude: false, targs: make([]*Type, 0),
        mangled: sym.decl.name, field_types: make([]*Type, 0), fields_done: false,
        resolving: false, is_template: false, offsets: make([]i64, 0),
        var_offsets: make([]*I64Vec, 0), var_poff: make([]i64, 0),
        size: 0, align: 0, env_tenv: null, owner_mod: sym.owner,
        methods: make([]*Sym, 0), is_trait: true,
      };
      sym.trait_rec = rec;
      sym.type = ty_err(); // a trait is not a value type; dyn_type_for builds it
      let mut k: usize = 0;
      while k < sym.decl.decls.n {
        let md: *Decl = sym.decl.decls.items[k];
        let ms: *Sym = new Sym {
          kind: SymKind.SyTraitMethod, name: md.name, type: null, decl: md,
          mutable: false, variant_index: 0, local_id: 0, symbol: "",
          owner: sym.owner, module: null, trait_rec: null,
        };
        let mut ps: []*Type = fresh_type_vec2();
        let mut j: usize = 1;
        while j < md.params.n { // skip the receiver
          ps = push_type(ps, resolve_type_in_module(sym.owner, md.params.items[j].ty));
          j += 1;
        }
        let mut ret: *Type = ty_void();
        if md.ret != null {
          ret = resolve_type_in_module(sym.owner, md.ret);
        }
        ms.type = ty_fn(ps, ret);
        rec.methods = push_sym(rec.methods, ms);
        k += 1;
      }
    }
    i += 1;
  }
  i = 0;
  while i < m.syms.n {
    let sym: *Sym = m.syms.items[i].val;
    if sym.kind == SymKind.SyImpl && sym.decl != null {
      let d: *Decl = sym.decl;
      let mut tsym: *Sym = sm_get(m.syms, d.name);
      if tsym == null && prelude_module != null && prelude_module != m {
        tsym = sm_get(prelude_module.syms, d.name);
      }
      if tsym == null || tsym.kind != SymKind.SyTrait {
        err_at(d.file, d.line, d.col, cat("unknown trait `", cat3(d.name, "` in impl", "")));
        i += 1;
        continue;
      }
      let tt: *Type = resolve_type_in_module(m, d.target);
      if !trait_satisfied(tsym.trait_rec, tt) {
        err_at(d.file, d.line, d.col, cat("`", cat3(ty_name(tt), cat("` does not implement `", cat3(d.name, cat("`: missing or mismatched `", cat3(tsym.trait_rec.methods[g_missing_idx as usize].name, "`", "")), "")), "")));
      }
    }
    i += 1;
  }
  cur_module = saved;
}

// register one declaration into the module's symbol table
fn declare_sym(m: *Module, d: *Decl) {
  let sym: *Sym = new Sym {
    kind: SymKind.SyFn, name: d.name, type: null, decl: d,
    mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: m,
    module: null,
  trait_rec: null,
  };
  if d.kind == DeclKind.DkImpl {
    register_impl_methods(m, d);
    return;
  }
  if d.kind == DeclKind.DkTrait {
    sym.kind = SymKind.SyTrait;
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == DeclKind.DkFn {
    sym.kind = SymKind.SyFn;
    if d.is_method {
      // methods live under `Recv.name`, mirroring the boot registration
      sm_put(m.syms, cat3(d.recv, ".", d.name), sym);
      return;
    }
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == DeclKind.DkStruct {
    sym.kind = SymKind.SyStruct;
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == DeclKind.DkEnum {
    sym.kind = SymKind.SyEnum;
    sm_put(m.syms, d.name, sym);
    let mut vi: i32 = 0;
    let mut viu: usize = 0;
    while viu < d.variants.n {
      let v: *VariantAst = d.variants.items[viu];
      let vsym: *Sym = new Sym {
        kind: SymKind.SyVariant, name: v.name, type: null, decl: d,
        mutable: false, variant_index: vi, local_id: 0, symbol: "",
    owner: m,
    module: null,
      trait_rec: null,
      };
      sm_put(m.syms, v.name, vsym);
      vi += 1;
      viu += 1;
    }
    return;
  }
  if d.kind == DeclKind.DkStatic || d.kind == DeclKind.DkConst {
    sym.kind = SymKind.SyStatic;
    if d.kind == DeclKind.DkConst {
      sym.kind = SymKind.SyConst;
    }
    sym.mutable = d.is_mut;
    sm_put(m.syms, d.name, sym);
    return;
  }
  if d.kind == DeclKind.DkExtern {
    sym.kind = SymKind.SyExtern;
    sm_put(m.syms, d.name, sym);
    return;
  }
}

// walk all decls of a parsed module and populate its symbol table
fn check_module(m: *Module) {
  cur_module = m;
  let d: *Decl = m.root;
  let mut i: usize = 0;
  while i < d.decls.n {
    let ud: *Decl = d.decls.items[i];
    if ud.kind == DeclKind.DkUse && ud.path.n > 0 {
      // load the used module (relative to this file), register it under its
      // namespace, and check it before the using module
      let ns_name: string = ud.path.items[ud.path.n - 1];
      let aux: *Module = load_use_module(m.path, ud.path.items[0]);
      if aux != null {
        if sm_get(m.syms, ns_name) == null {
          let msym: *Sym = new Sym {
            kind: SymKind.SyModule, name: ns_name, type: null,
            decl: null, mutable: false, variant_index: 0, local_id: 0,
            symbol: "", owner: m, module: aux, trait_rec: null,
          };
          sm_put(m.syms, ns_name, msym);
        }
        if !aux.checked {
          check_all(aux);
        }
      }
      i += 1;
      continue;
    }
    declare_sym(m, ud);
    i += 1;
  }
}


// ============== generics core (check.c port L4) ===========================

static mut g_tenv: *TypeMap = 0 as *TypeMap;

fn tenv() -> *TypeMap {
  if g_tenv == null {
    g_tenv = tm_new();
  }
  return g_tenv;
}

fn rec_intern(decl: *Decl, owner: *Module, mangled: string) -> *RecType {
  let t: *Type = tm_lookup(rec_map(), mangled);
  if t != null {
    return t.rec;
  }
  let r: *RecType = new RecType {
    decl: decl, is_prelude: owner.is_prelude, targs: fresh_type_vec2(),
    mangled: mangled, field_types: fresh_type_vec2(), fields_done: false,
    resolving: false, is_template: false, offsets: make([]i64, 0),
    var_offsets: make([]*I64Vec, 0), var_poff: make([]i64, 0),
    size: 0, align: 0, env_tenv: null, owner_mod: owner,
    methods: make([]*Sym, 0), is_trait: false,
  };
  tm_intern(rec_map(), mangled, new Type {
    kind: TypeKind.TyStruct, elem: null, len: 0, rec: r,
    params: fresh_type_vec2(), ret: null, mangled: mangled,
  });
  return r;
}

fn template_env_of(d: *Decl) -> *TypeMap {
  let env: *TypeMap = tm_new();
  let mut i: usize = 0;
  while i < d.tparams.n {
    tm_put(env, d.tparams.items[i], ty_param_(d.tparams.items[i]));
    i += 1;
  }
  return env;
}

fn push_type(items: []*Type, t: *Type) -> []*Type {
  let out: []*Type = make([]*Type, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = t;
  return out;
}

fn ensure_template(d: *Decl, owner: *Module) -> *RecType {
  if d.templ != null {
    return d.templ;
  }
  let base: string = cat3(owner.path, ".", d.name);
  let rec: *RecType = rec_intern(d, owner, cat(base, "[]"));
  rec.is_template = true;
  rec.targs = fresh_type_vec2();
  let env: *TypeMap = template_env_of(d);
  rec.env_tenv = env;
  let mut i: usize = 0;
  while i < d.tparams.n {
    let tv: *Type = tm_get(env, d.tparams.items[i]);
    rec.targs = push_type(rec.targs, tv);
    i += 1;
  }
  d.templ = rec;
  return rec;
}

fn rec_type_env(rec: *RecType) -> *TypeMap {
  if rec.env_tenv == null {
    rec.env_tenv = tm_new();
  }
  return rec.env_tenv;
}

fn inst_from_targs(sym: *Sym, owner: *Module, targs: []*Type) -> *Type {
  let d: *Decl = sym.decl;
  let base: string = cat3(owner.path, ".", d.name);
  let mut mangled: string = cat(base, "[");
  let mut i: usize = 0;
  while i < len(targs) {
    if i > 0 {
      mangled = cat(mangled, ",");
    }
    mangled = cat(mangled, targs[i].mangled);
    i += 1;
  }
  mangled = cat(mangled, "]");
  let rec: *RecType = rec_intern(d, owner, mangled);
  if len(rec.targs) == 0 && d.tparams.n > 0 {
    let mut j: usize = 0;
    while j < d.tparams.n {
      tm_put(rec_type_env(rec), d.tparams.items[j], targs[j]);
      j += 1;
    }
    rec.targs = targs;
  }
  let t: *Type = new Type {
    kind: TypeKind.TyStruct, elem: null, len: 0, rec: rec,
    params: fresh_type_vec2(), ret: null, mangled: mangled,
  };
  if sym.kind == SymKind.SyEnum {
    t.kind = TypeKind.TyEnum;
  }
  return ty_intern2(mangled, t);
}


// ============== type substitution & resolution (check.c port L5) =========

fn subst_type(t: *Type, env: *TypeMap) -> *Type {
  if t == null {
    return t;
  }
  if t.kind == TypeKind.TyParam {
    let r: *Type = tm_get(env, t.mangled);
    if r != null {
      return r;
    }
    return t;
  }
  if t.kind == TypeKind.TyPtr {
    return ty_ptr(subst_type(t.elem, env));
  }
  if t.kind == TypeKind.TyWeak {
    return ty_weak(subst_type(t.elem, env));
  }
  if t.kind == TypeKind.TySlice {
    return ty_slice(subst_type(t.elem, env));
  }
  if t.kind == TypeKind.TyArray {
    return ty_array(subst_type(t.elem, env), t.len);
  }
  if t.kind == TypeKind.TyFn {
    let mut ps: []*Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < len(t.params) {
      ps = push_type(ps, subst_type(t.params[i], env));
      i += 1;
    }
    return ty_fn(ps, subst_type(t.ret, env));
  }
  return t;
}

// bind type parameters by structural matching of a template type against
// the argument's concrete type
fn infer_targs(tmpl: *Type, arg: *Type, env: *TypeMap) {
  if tmpl == null || arg == null || tmpl.kind != TypeKind.TyParam {
    if tmpl == null || arg == null {
      return;
    }
    if tmpl.kind == TypeKind.TyPtr {
      if arg.kind == TypeKind.TyPtr {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyWeak {
      if arg.kind == TypeKind.TyWeak {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TySlice {
      if arg.kind == TypeKind.TySlice {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyArray {
      if arg.kind == TypeKind.TyArray && arg.len == tmpl.len {
        infer_targs(tmpl.elem, arg.elem, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyFn {
      if arg.kind == TypeKind.TyFn && len(arg.params) == len(tmpl.params) {
        let mut i: usize = 0;
        while i < len(tmpl.params) {
          infer_targs(tmpl.params[i], arg.params[i], env);
          i += 1;
        }
        infer_targs(tmpl.ret, arg.ret, env);
      }
      return;
    }
    if tmpl.kind == TypeKind.TyStruct || tmpl.kind == TypeKind.TyEnum {
      if arg.kind == tmpl.kind && arg.rec != null && tmpl.rec != null &&
         arg.rec.decl == tmpl.rec.decl {
        let n: usize = if len(tmpl.rec.targs) < len(arg.rec.targs) {
          len(tmpl.rec.targs)
        } else {
          len(arg.rec.targs)
        };
        let mut i: usize = 0;
        while i < n {
          infer_targs(tmpl.rec.targs[i], arg.rec.targs[i], env);
          i += 1;
        }
      }
      return;
    }
    return;
  }
  let bound: *Type = tm_get(env, tmpl.mangled);
  if bound == null {
    tm_put(env, tmpl.mangled, arg);
  } else if bound != arg && bound.kind != TypeKind.TyErr && arg.kind != TypeKind.TyErr {
    // conflicting bindings: prefer the concrete over a literal
    if bound.kind == TypeKind.TyIntLit || arg.kind == TypeKind.TyIntLit ||
       bound.kind == TypeKind.TyFloatLit || arg.kind == TypeKind.TyFloatLit {
      if bound.kind == TypeKind.TyIntLit || bound.kind == TypeKind.TyFloatLit {
        if arg.kind != TypeKind.TyIntLit && arg.kind != TypeKind.TyFloatLit {
          tm_put(env, tmpl.mangled, arg);
        }
      } else {
        tm_put(env, tmpl.mangled, bound);
      }
    }
  }
}

fn type_has_param(t: *Type) -> bool {
  if t == null {
    return false;
  }
  if t.kind == TypeKind.TyParam {
    return true;
  }
  if t.elem != null && type_has_param(t.elem) {
    return true;
  }
  if t.kind == TypeKind.TyFn {
    let mut i: usize = 0;
    while i < len(t.params) {
      if type_has_param(t.params[i]) {
        return true;
      }
      i += 1;
    }
    if type_has_param(t.ret) {
      return true;
    }
  }
  if t.rec != null {
    let mut i: usize = 0;
    while i < len(t.rec.targs) {
      if type_has_param(t.rec.targs[i]) {
        return true;
      }
      i += 1;
    }
  }
  return false;
}

// resolve a named struct/enum type (non-generic path; generics with explicit
// targs arrive through inst_from_targs via resolve_named)
fn named_type_simple(sym: *Sym, owner: *Module) -> *Type {
  let d: *Decl = sym.decl;
  let base: string = cat3(owner.path, ".", d.name);
  let rec: *RecType = rec_intern(d, owner, base);
  let t: *Type = new Type {
    kind: TypeKind.TyStruct, elem: null, len: 0, rec: rec,
    params: fresh_type_vec2(), ret: null, mangled: base,
  };
  if sym.kind == SymKind.SyEnum {
    t.kind = TypeKind.TyEnum;
  }
  return ty_intern2(base, t);
}

// resolve a TypeAst into a semantic Type within a module
fn resolve_type_in_module(m: *Module, ta: *TypeAst) -> *Type {
  if ta == null {
    return ty_prim(14); // void
  }
  let saved: *Module = cur_module;
  cur_module = m;
  let mut result: *Type = ty_err();
  if ta.kind == TypeAstKind.TaPrim {
    result = ty_prim(ta.prim);
  } else if ta.kind == TypeAstKind.TaPtr {
    result = ty_ptr(resolve_type_in_module(m, ta.elem));
  } else if ta.kind == TypeAstKind.TaWeak {
    result = ty_weak(resolve_type_in_module(m, ta.elem));
  } else if ta.kind == TypeAstKind.TaDyn {
    // dyn Trait: intern one aggregate type per trait carrier
    let last: string = ta.path.items[ta.path.n - 1];
    let mut tsym: *Sym = sm_get(m.syms, last);
    if tsym == null || tsym.kind != SymKind.SyTrait {
      if prelude_module != null && prelude_module != m {
        let ps: *Sym = sm_get(prelude_module.syms, last);
        if ps != null && ps.kind == SymKind.SyTrait {
          tsym = ps;
        }
      }
    }
    if tsym == null || tsym.kind != SymKind.SyTrait {
      err_at(ta.file, ta.line, ta.col, cat("unknown trait `", cat3(last, "`", "")));
    } else {
      result = dyn_type_for(tsym);
    }
  } else if ta.kind == TypeAstKind.TaArray {
    let elem: *Type = resolve_type_in_module(m, ta.elem);
    if ta.size == null {
      result = ty_slice(elem);
    } else {
      // TODO(check L6): const-evaluated array sizes land with const_eval
      result = ty_slice(elem);
    }
  } else if ta.kind == TypeAstKind.TaNamed {
    let last: string = ta.path.items[ta.path.n - 1];
    if ta.path.n == 1 {
      if g_tenv != null && ta.targs.n == 0 {
        let tv: *Type = tm_get(g_tenv, last);
        if tv != null {
          cur_module = saved;
          return tv;
        }
      }
      let mut sym: *Sym = sm_get(m.syms, last);
      if sym == null || (sym.kind != SymKind.SyStruct && sym.kind != SymKind.SyEnum) {
        if prelude_module != null && prelude_module != m {
          sym = sm_get(prelude_module.syms, last);
          if sym != null && (sym.kind == SymKind.SyStruct || sym.kind == SymKind.SyEnum) {
            cur_module = saved;
            return named_type_full(sym, prelude_module, ta);
          }
        }
        err_at(ta.file, ta.line, ta.col, cat3("unknown type `", last, "`"));
        cur_module = saved;
        return ty_err();
      }
      cur_module = saved;
      return named_type_full(sym, m, ta);
    }
    err_at(ta.file, ta.line, ta.col, "type paths are `module.Type` at most");
    cur_module = saved;
    return ty_err();
  } else if ta.kind == TypeAstKind.TaFn {
    let mut ps: []*Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < ta.params.n {
      ps = push_type(ps, resolve_type_in_module(m, ta.params.items[i]));
      i += 1;
    }
    let r: *Type = resolve_type_in_module(m, ta.ret);
    result = ty_fn(ps, r);
  }
  cur_module = saved;
  return result;
}

// full named-type resolution: non-generic, bare-generic (template or bound
// instance), and explicit-targs paths
fn named_type_full(sym: *Sym, owner: *Module, ta: *TypeAst) -> *Type {
  let d: *Decl = sym.decl;
  let nparams: usize = d.tparams.n;
  let ntargs: usize = ta.targs.n;
  if nparams == 0 && ntargs == 0 {
    return named_type_simple(sym, owner);
  }
  if ntargs == 0 {
    let mut targs: []*Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < nparams {
      let mut tv: *Type = null;
      if g_tenv != null {
        tv = tm_get(g_tenv, d.tparams.items[i]);
      }
      if tv == null || tv.kind == TypeKind.TyErr {
        err_at(ta.file, ta.line, ta.col, cat3("generic type `", d.name, "` needs type arguments"));
        return ty_err();
      }
      targs = push_type(targs, tv);
      i += 1;
    }
    let mut anyp: bool = false;
    let mut k: usize = 0;
    while k < len(targs) {
      if targs[k].kind == TypeKind.TyParam {
        anyp = true;
      }
      k += 1;
    }
    if !anyp {
      return inst_from_targs(sym, owner, targs);
    }
    if anyp {
      let rt: *RecType = ensure_template(d, owner);
      let t: *Type = new Type {
        kind: TypeKind.TyStruct, elem: null, len: 0, rec: rt,
        params: fresh_type_vec2(), ret: null, mangled: rt.mangled,
      };
      if sym.kind == SymKind.SyEnum {
        t.kind = TypeKind.TyEnum;
      }
      return ty_intern2(rt.mangled, t);
    }
    return ty_err();
  }
  if nparams != ntargs {
    err_at(ta.file, ta.line, ta.col, cat5("`", d.name, "` takes ", itoa(nparams as i64), cat3(" type arguments, got ", itoa(ntargs as i64), "")));
    return ty_err();
  }
  let mut targs: []*Type = fresh_type_vec2();
  let mut i: usize = 0;
  while i < ntargs {
    let mut targ: *Type = resolve_type_in_module(owner, ta.targs.items[i]);
    if targ.kind == TypeKind.TyIntLit {
      targ = ty_prim(3); // i32
    }
    if targ.kind == TypeKind.TyFloatLit {
      targ = ty_prim(10); // f64
    }
    if targ.kind == TypeKind.TyErr {
      return ty_err();
    }
    targs = push_type(targs, targ);
    i += 1;
  }
  return inst_from_targs(sym, owner, targs);
}


// ============== expression checking (check.c port L6a) ====================

fn ty_is_int(t: *Type) -> bool {
  return t.kind == TypeKind.TyI8 || t.kind == TypeKind.TyI16 ||
         t.kind == TypeKind.TyI32 || t.kind == TypeKind.TyI64 ||
         t.kind == TypeKind.TyU8 || t.kind == TypeKind.TyU16 ||
         t.kind == TypeKind.TyU32 || t.kind == TypeKind.TyU64 ||
         t.kind == TypeKind.TyUsize || t.kind == TypeKind.TyIsize ||
         t.kind == TypeKind.TyIntLit;
}

fn ty_is_flt(t: *Type) -> bool {
  return t.kind == TypeKind.TyF32 || t.kind == TypeKind.TyF64 ||
         t.kind == TypeKind.TyFloatLit;
}

fn types_compatible(got: *Type, expected: *Type) -> bool {
  return got == expected;
}

fn require(got_in: *Type, expected: *Type, e: *Expr, what: string) {
  // mirror boot: adapt literals to the expected type AND rewrite the
  // expression's semantic type, so lowering sees the concrete width
  let got: *Type = adapt_literal(got_in, expected);
  if e != null && e.kind != ExprKind.ExDynbox && expected != null &&
     expected.kind == TypeKind.TyDyn && got.kind != TypeKind.TyDyn &&
     !ty_is_or_has_err(got) {
    if try_dyn_coerce(e, got, expected) {
      return; // rewritten in place (or already diagnosed inside)
    }
  }
  e.typed = got;
  if !types_compatible(got, expected) {
    err_at(e.file, e.line, e.col, cat5(what, ": expected `", ty_name(expected), "`, found `", cat3(ty_name(got), "`", "")));
  }
}

fn adapt_literal(got: *Type, expected: *Type) -> *Type {
  if got == null {
    return got;
  }
  if got.kind == TypeKind.TyIntLit && expected != null && ty_is_int(expected) &&
     expected.kind != TypeKind.TyIntLit {
    return expected;
  }
  if got.kind == TypeKind.TyFloatLit && expected != null &&
     (expected.kind == TypeKind.TyF32 || expected.kind == TypeKind.TyF64) {
    return expected;
  }
  // `null` adapts to any pointer/weak context: an if/else arm or a match
  // arm may read `null` against `*T` (boot: TY_NULL + TY_PTR/TY_WEAK)
  if got.kind == TypeKind.TyNull && expected != null &&
     (expected.kind == TypeKind.TyPtr || expected.kind == TypeKind.TyWeak) {
    return expected;
  }
  return got;
}

fn check_expr(e: *Expr, expected: *Type) -> *Type {
  if e.kind == ExprKind.ExDynbox {
    // created by try_dyn_coerce: the box already carries its type
    if e.typed == null {
      e.typed = ty_err();
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExInt {
    if expected != null && ty_is_int(expected) && expected.kind != TypeKind.TyIntLit {
      e.typed = expected;
    } else {
      e.typed = ty_intern2("int_lit", new Type { kind: TypeKind.TyIntLit, elem: null, len: 0, rec: null, params: fresh_type_vec2(), ret: null, mangled: "int_lit" });
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExFloat {
    if expected != null && (expected.kind == TypeKind.TyF32 || expected.kind == TypeKind.TyF64) {
      e.typed = expected;
    } else {
      e.typed = ty_intern2("float_lit", new Type { kind: TypeKind.TyFloatLit, elem: null, len: 0, rec: null, params: fresh_type_vec2(), ret: null, mangled: "float_lit" });
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExStr {
    e.typed = ty_prim(11);
    return e.typed;
  }
  if e.kind == ExprKind.ExBool {
    e.typed = ty_prim(0);
    return e.typed;
  }
  if e.kind == ExprKind.ExNull {
    if expected != null && (expected.kind == TypeKind.TyPtr || expected.kind == TypeKind.TyWeak) {
      e.typed = expected;
    } else {
      e.typed = ty_intern2("null", new Type { kind: TypeKind.TyNull, elem: null, len: 0, rec: null, params: fresh_type_vec2(), ret: null, mangled: "null" });
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExName {
    let mut sym: *Sym = lookup(e.sv);
    if sym == null && cur_module != null {
      sym = sm_get(cur_module.syms, e.sv);
    }
    if sym == null {
      err_at(e.file, e.line, e.col, cat3("unknown name `", e.sv, "`"));
      e.typed = ty_err();
      return e.typed;
    }
    e.sym = sym;
    if sym.kind == SymKind.SyModule {
      e.typed = ty_module();
    } else {
      e.typed = sym.type;
    }
    // a fn name in value position makes a closure value
    if sym.kind == SymKind.SyFn || sym.kind == SymKind.SyExtern {
      e.fnval = true;
    }
    if sym.kind == SymKind.SyFn && sym.decl != null && sym.decl.params.n > 0 &&
       sym.decl.params.items[sym.decl.params.n - 1].is_variadic {
      err_at(e.file, e.line, e.col,
             "a variadic function cannot be used as a value (fn types have no `...` spelling)");
      e.typed = ty_err();
      return e.typed;
    }
    // copy-capture: a closure body naming an outer local records it
    if g_cap_list != null &&
       (sym.kind == SymKind.SyLocal || sym.kind == SymKind.SyParam) &&
       sym.local_id < g_cap_boundary {
      let mut dup: bool = false;
      let mut ci: usize = 0;
      while ci < g_cap_list.n {
        if streq(g_cap_list.items[ci].name, sym.name) {
          dup = true;
        }
        ci += 1;
      }
      if !dup {
        g_cap_list.push(sym);
      }
    }
    e.typed = sym.type;
    return e.typed;
  }
  if e.kind == ExprKind.ExUn {
    let a: *Type = check_expr(e.a, null);
    if e.unop == Tok.PBang {
      if a.kind != TypeKind.TyBool {
        err_at(e.file, e.line, e.col, "`!` needs a bool");
      }
      e.typed = ty_prim(0);
      return e.typed;
    }
    if e.unop == Tok.PTilde {
      if !ty_is_int(a) {
        err_at(e.file, e.line, e.col, "`~` needs an integer");
      }
      e.typed = a;
      return e.typed;
    }
    if e.unop == Tok.PMinus {
      if !ty_is_int(a) && !ty_is_flt(a) {
        err_at(e.file, e.line, e.col, "`-` needs a number");
      }
      e.typed = a;
      return e.typed;
    }
    if e.unop == Tok.PStar {
      if a.kind != TypeKind.TyPtr {
        err_at(e.file, e.line, e.col, cat3("`*` dereference needs a pointer, found `", ty_name(a), "`"));
        e.typed = ty_err();
      } else {
        e.typed = a.elem;
      }
      return e.typed;
    }
    e.typed = ty_err();
    return e.typed;
  }
  if e.kind == ExprKind.ExCast {
    check_expr(e.a, null);
    let target: *Type = resolve_type_in_module(cur_module, e.ty);
    // untyped literals retype to the cast's target at full width — leaving
    // them INT_LIT (i32) truncates constants like (0x1000000000000 as u64)
    if e.a.typed != null && (e.a.typed.kind == TypeKind.TyIntLit ||
                             e.a.typed.kind == TypeKind.TyFloatLit) {
      e.a.typed = target;
    }
    let srct: *Type = e.a.typed;
    let mut ok: bool = (ty_is_int(target) || ty_is_flt(target)) &&
        (ty_is_int(srct) || ty_is_flt(srct) || srct.kind == TypeKind.TyEnum ||
         srct.kind == TypeKind.TyIntLit || srct.kind == TypeKind.TyFloatLit ||
         srct.kind == TypeKind.TyParam || target.kind == TypeKind.TyParam);
    if srct.kind == TypeKind.TyBool || target.kind == TypeKind.TyBool {
      ok = false;
    }
    if (srct.kind == TypeKind.TyPtr || target.kind == TypeKind.TyPtr) &&
       (target.kind == TypeKind.TyUsize || target.kind == TypeKind.TyI64 ||
        srct.kind == TypeKind.TyUsize || srct.kind == TypeKind.TyI64) {
      ok = true;
    }
    if !ok {
      err_at(e.file, e.line, e.col, cat5("cannot cast `", ty_name(srct), "` to `", ty_name(target), "`"));
    }
    e.typed = target;
    return e.typed;
  }
  if e.kind == ExprKind.ExBin {
    let op: Tok = e.binop;
    let mut l: *Type = check_expr(e.a, null);
    let mut r: *Type = null;
    if op == Tok.PAndand || op == Tok.POror {
      if l.kind != TypeKind.TyBool {
        err_at(e.a.file, e.a.line, e.a.col, cat3("left of `", spell_op(op), "` must be bool"));
      }
      r = check_expr(e.b, ty_prim(0));
      if r.kind == TypeKind.TyIntLit || r.kind == TypeKind.TyFloatLit {
        r = ty_prim(0);
        e.b.typed = r;
      }
      if r.kind != TypeKind.TyBool {
        err_at(e.b.file, e.b.line, e.b.col, cat3("right of `", spell_op(op), "` must be bool"));
      }
      e.typed = ty_prim(0);
      return e.typed;
    }
    if l.kind == TypeKind.TyIntLit || l.kind == TypeKind.TyFloatLit || l.kind == TypeKind.TyNull {
      let r2: *Type = check_expr(e.b, null);
      l = adapt_literal(l, r2);
      e.a.typed = l;
      r = r2;
    } else {
      r = adapt_literal(check_expr(e.b, l), l);
      e.b.typed = r;
    }
    let cmp: bool = op == Tok.PEq || op == Tok.PNe || op == Tok.PLt ||
                    op == Tok.PGt || op == Tok.PLe || op == Tok.PGe;
    if cmp {
      let mut ok: bool = false;
      if op == Tok.PEq || op == Tok.PNe {
        ok = (ty_is_int(l) && ty_is_int(r)) || (ty_is_flt(l) && ty_is_flt(r)) ||
             (l.kind == TypeKind.TyBool && r.kind == TypeKind.TyBool) ||
             ((l.kind == TypeKind.TyPtr || l.kind == TypeKind.TyNull) && (r.kind == TypeKind.TyPtr || r.kind == TypeKind.TyNull)) ||
             (l.kind == TypeKind.TyWeak && (r.kind == TypeKind.TyWeak || r.kind == TypeKind.TyNull)) ||
             (l.kind == TypeKind.TyStringK && r.kind == TypeKind.TyStringK);
        if l.kind == TypeKind.TyEnum && l == r {
          ok = true;
        } else if l.kind == TypeKind.TyStruct || r.kind == TypeKind.TyStruct || l.kind == TypeKind.TyArray {
          ok = false;
        }
      } else {
        ok = (ty_is_int(l) && ty_is_int(r)) || (ty_is_flt(l) && ty_is_flt(r));
      }
      if !ok {
        err_at(e.file, e.line, e.col, cat5("cannot compare `", ty_name(l), "` and `", ty_name(r), "`"));
        return ty_err();
      }
      e.typed = ty_prim(0);
      return e.typed;
    }
    if op == Tok.PShl || op == Tok.PShr {
      if !ty_is_int(l) {
        err_at(e.file, e.line, e.col, "shift needs an integer left side");
      }
      if !ty_is_int(r) {
        err_at(e.file, e.line, e.col, "shift needs an integer right side");
      }
      e.typed = l;
      return e.typed;
    }
    if l != r {
      err_at(e.file, e.line, e.col, cat3(cat3("type mismatch in `", spell_op(op), "`: `"), cat3(ty_name(l), "` vs `", ty_name(r)), "`"));
      e.typed = ty_err();
      return e.typed;
    }
    if op == Tok.PPlus || op == Tok.PMinus || op == Tok.PStar || op == Tok.PSlash || op == Tok.PPercent {
      if (!ty_is_int(l) && !ty_is_flt(l)) && l.kind != TypeKind.TyParam {
        err_at(e.file, e.line, e.col, cat3("arithmetic needs numbers, found `", ty_name(l), "`"));
      }
    } else if op == Tok.PAmp || op == Tok.PPipe || op == Tok.PCaret {
      if !ty_is_int(l) {
        err_at(e.file, e.line, e.col, cat3("bitwise needs integers, found `", ty_name(l), "`"));
      }
    }
    if l.kind == TypeKind.TyIntLit {
      l = ty_prim(3);
    }
    if l.kind == TypeKind.TyFloatLit {
      // float literals default to f64 (spec §1), or follow the context;
      // retype the operand nodes too so the lowerer sees settled types
      if expected != null && expected.kind == TypeKind.TyF32 {
        l = ty_prim(9);
      } else {
        l = ty_prim(10);
      }
      if e.a.typed.kind == TypeKind.TyFloatLit {
        e.a.typed = l;
      }
      if e.b.typed.kind == TypeKind.TyFloatLit {
        e.b.typed = l;
      }
    }
    e.typed = l;
    return e.typed;
  }
  if e.kind == ExprKind.ExIndex {
    let base: *Type = check_expr(e.a, null);
    let mut idx: *Type = check_expr(e.b, null);
    if idx.kind == TypeKind.TyIntLit {
      idx = ty_prim(12);
      e.b.typed = idx;
    }
    if !ty_is_int(idx) {
      err_at(e.b.file, e.b.line, e.b.col, cat3("index must be an integer, found `", ty_name(idx), "`"));
    }
    if base.kind == TypeKind.TyArray || base.kind == TypeKind.TySlice {
      e.typed = base.elem;
    } else if base.kind == TypeKind.TyStringK {
      e.typed = ty_prim(5);
    } else {
      err_at(e.file, e.line, e.col, cat3("cannot index `", ty_name(base), "`"));
      e.typed = ty_err();
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExSlice {
    let base: *Type = check_expr(e.a, null);
    let mut lo: *Type = check_expr(e.b, null);
    let mut hi: *Type = check_expr(e.c, null);
    if lo.kind == TypeKind.TyIntLit {
      lo = ty_prim(12);
      e.b.typed = lo;
    }
    if hi.kind == TypeKind.TyIntLit {
      hi = ty_prim(12);
      e.c.typed = hi;
    }
    if !ty_is_int(lo) || !ty_is_int(hi) {
      err_at(e.file, e.line, e.col, "slice bounds must be integers");
    }
    if base.kind == TypeKind.TyArray || base.kind == TypeKind.TySlice {
      e.typed = ty_slice(base.elem);
    } else if base.kind == TypeKind.TyStringK {
      e.typed = ty_prim(11);
    } else {
      err_at(e.file, e.line, e.col, cat3("cannot slice `", ty_name(base), "`"));
      e.typed = ty_err();
    }
    return e.typed;
  }
  if e.kind == ExprKind.ExIf {
    return check_if_expr(e, expected);
  }
  if e.kind == ExprKind.ExBlock {
    // a `{ ... }` in value position (a match arm block): the block's value
    // is its trailing tail expression's type, void when it has none
    scope_push();
    let mut result: *Type = ty_prim(14);
    let mut i: usize = 0;
    while i < e.items.n {
      let s: *Stmt = e.items.items[i];
      check_stmt(s);
      if i + 1 == e.items.n && s.kind == StmtKind.StExpr && s.tail {
        result = s.a.typed;
      }
      i += 1;
    }
    scope_pop();
    e.typed = result;
    return result;
  }
  if e.kind == ExprKind.ExQmark {
    // expr? : expr must be a Result or Option; yields the Ok/Some payload
    let operand: *Type = check_expr(e.a, null);
    if operand.kind != TypeKind.TyEnum {
      let mut what: string = ty_name(operand);
      if operand.kind == TypeKind.TyIntLit || operand.kind == TypeKind.TyFloatLit {
        what = "an untyped literal";
      }
      err_at(e.file, e.line, e.col, cat3("`?` needs a Result or Option, found `", what, "`"));
      e.typed = ty_err();
      return e.typed;
    }
    let ed: *Decl = operand.rec.decl;
    let mut ok_i: i32 = 0 - 1;
    let mut err_i: i32 = 0 - 1;
    let mut none_i: i32 = 0 - 1;
    let mut some_i: i32 = 0 - 1;
    let mut vi: usize = 0;
    while vi < ed.variants.n {
      let vn: string = ed.variants.items[vi].name;
      if streq(vn, "Ok") {
        ok_i = vi as i32;
      }
      if streq(vn, "Err") {
        err_i = vi as i32;
      }
      if streq(vn, "Some") {
        some_i = vi as i32;
      }
      if streq(vn, "None") {
        none_i = vi as i32;
      }
      vi += 1;
    }
    let result_like: bool = ok_i >= 0 && err_i >= 0;
    let option_like: bool = some_i >= 0 && none_i >= 0;
    if !result_like && !option_like {
      err_at(e.file, e.line, e.col, cat3("`?` needs a Result or Option, found `", ty_name(operand), "`"));
      e.typed = ty_err();
      return e.typed;
    }
    let mut qv: i32 = some_i;
    let mut qe: i32 = none_i;
    if result_like {
      qv = ok_i;
      qe = err_i;
    }
    expr_set_q(e, qv, qe);
    // the enclosing function must return the same family, with a
    // compatible error payload for Results
    let mut rn: *Type = cur_ret;
    if rn == null {
      rn = ty_prim(14);
    }
    if cur_ret == null || cur_ret.kind != TypeKind.TyEnum || cur_ret.rec.decl != ed {
      let mut fam: string = "Result";
      if !result_like {
        fam = "Option";
      }
      err_at(e.file, e.line, e.col, cat5("`?` propagates into `", fam, "`, but this function returns `", ty_name(rn), "`"));
      e.typed = ty_err();
      return e.typed;
    }
    if result_like {
      let e_op: *Type = variant_field_type(operand, err_i, 0);
      let e_ret: *Type = variant_field_type(cur_ret, err_i, 0);
      if !types_compatible(e_op, e_ret) {
        err_at(e.file, e.line, e.col, cat5("error payload mismatch: function propagates `", ty_name(e_ret), "`, operand carries `", ty_name(e_op), "`"));
        e.typed = ty_err();
        return e.typed;
      }
    }
    e.typed = variant_field_type(operand, e.q_ok, 0);
    return e.typed;
  }
  if e.kind == ExprKind.ExClosure {
    // copy-capture closures: outer locals the body names are snapshotted
    let saved_caps: *Vec[*Sym] = g_cap_list;
    let saved_boundary: i32 = g_cap_boundary;
    let caps: *Vec[*Sym] = new Vec[*Sym] { items: make([]*Sym, 8), n: 0 };
    g_cap_list = caps;
    g_cap_boundary = next_local_id;
    // params: type ASTs resolve now; body checked in a nested scope
    scope_push();
    let mut ps: []*Type = fresh_type_vec2();
    let mut i: usize = 0;
    while i < e.params.n {
      let p: *Param = e.params.items[i];
      let pt: *Type = resolve_type_in_module(cur_module, p.ty);
      ps = push_type(ps, pt);
      let psym: *Sym = new Sym {
        kind: SymKind.SyParam, name: p.name, type: pt, decl: null,
        mutable: true, variant_index: 0, local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
      trait_rec: null,
      };
      next_local_id += 1;
      scope_decl(p.name, psym);
      i += 1;
    }
    let mut rt: *Type = ty_prim(14);
    if e.ret != null {
      rt = resolve_type_in_module(cur_module, e.ret);
    }
    // return statements inside check against the closure's return type
    let saved_ret: *Type = cur_ret;
    cur_ret = rt;
    let bt: *Type = check_block_value2(e.items);
    cur_ret = saved_ret;
    if rt.kind != TypeKind.TyVoid && !block_returns(e.items) {
      err_at(e.file, e.line, e.col, cat3("missing return: closure body must produce `", ty_name(rt), "`"));
    }
    scope_pop();
    g_cap_list = saved_caps;
    g_cap_boundary = saved_boundary;
    let mut ci: usize = 0;
    while ci < caps.n {
      let cap: *Sym = caps.items[ci];
      if cap.kind == SymKind.SyLocal && cap.mutable {
        err_at(e.file, e.line, e.col, cat3("cannot capture mutable `", cap.name, "` (boot-era closures copy; box it in a struct instead)"));
      }
      ci += 1;
    }
    e.caps = caps.items[0..caps.n];
    e.typed = ty_fn(ps, rt);
    return e.typed;
  }
  if e.kind == ExprKind.ExField {
    return check_field_access(e, expected);
  }
  if e.kind == ExprKind.ExCall {
    return check_call(e, expected);
  }
  if e.kind == ExprKind.ExNew {
    return check_new(e);
  }
  if e.kind == ExprKind.ExMatch {
    return check_match(e, expected);
  }
  err_at(e.file, e.line, e.col, "internal: unexpected expression form");
  e.typed = ty_err();
  return e.typed;
}


// ============== field access & new (check.c port L6b) =====================

fn struct_field_type(rec: *RecType, i: usize) -> *Type {
  if !rec.fields_done {
    if rec.resolving {
      return ty_err(); // self-containing struct; layout phase reports it
    }
    rec.resolving = true;
    let d: *Decl = rec.decl;
    let saved: *Module = cur_module;
    let saved_env: *TypeMap = g_tenv;
    // owner module of the rec is approximated by cur_module's prelude flag:
    // the self compiler checks one module at a time
    if prelude_module != null && rec.is_prelude {
      cur_module = prelude_module;
    }
    g_tenv = rec.env_tenv;
    let mut j: usize = 0;
    while j < d.fields.n {
      let fa: *FieldAst = d.fields.items[j];
      rec.field_types = push_type(rec.field_types, resolve_type_in_module(rec.owner_module(), fa.ty));
      j += 1;
    }
    g_tenv = saved_env;
    rec.resolving = false;
    rec.fields_done = true;
    cur_module = saved;
  }
  if len(rec.field_types) > i {
    return rec.field_types[i];
  }
  return ty_err();
}

// RecType keeps the owning module (needed to resolve field types in the
// right namespace); rho port stores it directly
fn RecType.owner_module(self: *RecType) -> *Module {
  if self.owner_mod != null {
    return self.owner_mod;
  }
  return cur_module;
}

fn check_field_access(e: *Expr, expected: *Type) -> *Type {
  // module access: statics/consts (functions go through call resolution)
  if e.a.kind == ExprKind.ExName && e.a.sym == null {
    check_expr(e.a, null);
  }
  if e.a.kind == ExprKind.ExName && e.a.sym != null &&
     e.a.sym.kind == SymKind.SyModule && e.a.sym.module != null {
    let item: *Sym = sm_get(e.a.sym.module.syms, e.sv);
    if item == null {
      let msg: string = cat3("module `", cat3(e.a.sv, "` has no item `", ""), "");
      err_at("", 0, 0, cat3(msg, cat3(e.sv, "`", ""), ""));
      e.typed = ty_err();
      return e.typed;
    }
    if item.kind == SymKind.SyStatic || item.kind == SymKind.SyConst {
      if !item.decl.pub_ && !item.owner.is_prelude {
        let msg: string = cat3(e.a.sv, ".", "");
        err_at("", 0, 0, cat3(msg, cat3(e.sv, "` is not public", ""), ""));
      }
      e.sym = item;
      e.typed = item.type;
      return e.typed;
    }
    if item.kind == SymKind.SyFn || item.kind == SymKind.SyExtern {
      e.sym = item;
      e.typed = item.type;
      e.fnval = true;
      return e.typed;
    }
    let msg: string = cat3(e.a.sv, ".", "");
    err_at("", 0, 0, cat3(msg, cat3(e.sv, "` is a type; types are not values", ""), ""));
    e.typed = ty_err();
    return e.typed;
  }
  let base: *Type = check_expr(e.a, null);
  if base.kind == TypeKind.TySlice || base.kind == TypeKind.TyStringK {
    if streq(e.sv, "len") {
      e.typed = ty_prim(12);
      return e.typed;
    }
    if streq(e.sv, "ptr") {
      if base.kind == TypeKind.TyStringK {
        e.typed = ty_ptr(ty_prim(5));
      } else {
        e.typed = ty_ptr(base.elem);
      }
      return e.typed;
    }
    err_at(e.file, e.line, e.col, cat3("slices have `len` and `ptr`, not `", e.sv, "`"));
    e.typed = ty_err();
    return e.typed;
  }
  if base.kind == TypeKind.TyPtr {
    let deref: *Type = base.elem;
    if deref.kind == TypeKind.TyStruct {
      let rec: *RecType = deref.rec;
      let d: *Decl = rec.decl;
      let mut i: usize = 0;
      while i < d.fields.n {
        let fa: *FieldAst = d.fields.items[i];
        if streq(fa.name, e.sv) {
          e.typed = struct_field_type(rec, i);
          return e.typed;
        }
        i += 1;
      }
      err_at(e.file, e.line, e.col, cat5("no field `", e.sv, "` on `", ty_name(deref), "`"));
      e.typed = ty_err();
      return e.typed;
    }
    err_at(e.file, e.line, e.col, cat3("`", ty_name(deref), "` has no fields (auto-deref only works on struct pointers)"));
    e.typed = ty_err();
    return e.typed;
  }
  if base.kind == TypeKind.TyStruct {
    let rec: *RecType = base.rec;
    let d: *Decl = rec.decl;
    let mut i: usize = 0;
    while i < d.fields.n {
      let fa: *FieldAst = d.fields.items[i];
      if streq(fa.name, e.sv) {
        e.typed = struct_field_type(rec, i);
        return e.typed;
      }
      i += 1;
    }
    err_at(e.file, e.line, e.col, cat5("no field `", e.sv, "` on `", ty_name(base), "`"));
    e.typed = ty_err();
    return e.typed;
  }
  if e.a.kind == ExprKind.ExName {
    let sym: *Sym = e.a.sym;
    if sym != null && sym.kind == SymKind.SyEnum {
      let d: *Decl = sym.decl;
      let mut i: usize = 0;
      while i < d.variants.n {
        let v: *VariantAst = d.variants.items[i];
        if streq(v.name, e.sv) {
          if v.vkind != VarKind.VarUnit {
            err_at("", 0, 0, "variant carries a payload; call it to construct");
            e.typed = ty_err();
            return e.typed;
          }
          let mut vtype: *Type = sym.type;
          // unit variant of a generic enum: take the expected instantiation
          // when the context pins one (`let x: Option[i32] = Option.None`)
          if vtype != null && vtype.rec != null && vtype.rec.is_template &&
             expected != null && expected.kind == TypeKind.TyEnum &&
             expected.rec != null && expected.rec.decl == d {
            vtype = expected;
          }
          let vs: *Sym = new Sym {
            kind: SymKind.SyVariant, name: e.sv, type: vtype, decl: d,
            mutable: false, variant_index: i as i32, local_id: 0, symbol: "",
    owner: cur_module,
    module: null,
          trait_rec: null,
          };
          e.sym = vs;
          e.typed = vs.type;
          return e.typed;
        }
        i += 1;
      }
      err_at("", 0, 0, "enum has no such variant");
      e.typed = ty_err();
      return e.typed;
    }
  }
  err_at("", 0, 0, "cannot access field");
  e.typed = ty_err();
  return e.typed;
}

fn check_new(e: *Expr) -> *Type {
  let t: *Type = resolve_type_in_module(cur_module, e.ty);
  if t.kind != TypeKind.TyStruct {
    err_at("", 0, 0, "`new` takes a struct type");
    e.typed = ty_err();
    return e.typed;
  }
  let rec: *RecType = t.rec;
  let d: *Decl = rec.decl;
  struct_field_type(rec, if d.fields.n > 0 { d.fields.n - 1 } else { 0 });
  if e.items.n != d.fields.n {
    err_at("", 0, 0, "struct initializer count mismatch");
  }
  let mut i: usize = 0;
  while i < e.items.n {
    let entry: *Stmt = e.items.items[i];
    let fname: string = entry.name;
    let argi: *Expr = e.args.items[i];
    let mut found: bool = false;
    let mut j: usize = 0;
    while j < d.fields.n {
      let df: *FieldAst = d.fields.items[j];
      if streq(df.name, fname) {
        let ft: *Type = struct_field_type(rec, j);
        require(check_expr(argi, ft), ft, argi, "field initializer");
        found = true;
        break;
      }
      j += 1;
    }
    if !found {
      err_at(argi.file, argi.line, argi.col, cat5("no field `", fname, "` on `", d.name, "`"));
    }
    i += 1;
  }
  e.typed = ty_ptr(t);
  return e.typed;
}


// ============== match checking (check.c port L6c, compact) ===============



// resolve a payload field type of an enum variant against the enum's own
// tparam environment (simplified variant_field_type: no layout needed for
// checking, only for lowering — the layout port arrives with L6d)
fn variant_field_type(enum_t: *Type, variant: i32, field: i32) -> *Type {
  let rec: *RecType = enum_t.rec;
  let d: *Decl = rec.decl;
  if variant < 0 || variant >= d.variants.n as i32 {
    return ty_err();
  }
  let v: *VariantAst = d.variants.items[variant];
  let mut ta: *TypeAst = null;
  if v.vkind == VarKind.VarTuple {
    if field < 0 || field >= v.types.n as i32 {
      return ty_err();
    }
    ta = v.types.items[field];
  } else if v.vkind == VarKind.VarStruct {
    if field < 0 || field >= v.fields.n as i32 {
      return ty_err();
    }
    ta = v.fields.items[field].ty;
  } else {
    return ty_err();
  }
  let saved: *Module = cur_module;
  let saved_env: *TypeMap = g_tenv;
  if rec.is_prelude && prelude_module != null {
    cur_module = prelude_module;
  }
  g_tenv = rec.env_tenv;
  let t: *Type = resolve_type_in_module(cur_module, ta);
  g_tenv = saved_env;
  cur_module = saved;
  return t;
}

// does this expression's if-chain guarantee a return on both sides?
fn if_expr_returns(ifx: *Expr) -> bool {
  let then: *Stmt = ifx.items.items[0];
  if !block_returns(then.stmts) {
    return false;
  }
  if ifx.else_if != null {
    return if_expr_returns(ifx.else_if);
  }
  if ifx.items.n < 2 {
    return false;
  }
  return block_returns(ifx.items.items[1].stmts);
}

fn loop_has_break(stmts: *Vec[*Stmt]) -> bool {
  let mut i: usize = 0;
  while i < stmts.n {
    let s: *Stmt = stmts.items[i];
    if s.kind == StmtKind.StBreak {
      return true;
    }
    if s.kind == StmtKind.StWhile || s.kind == StmtKind.StLoop {
      // an inner loop's break belongs to the inner loop
      i += 1;
      continue;
    }
    if s.stmts.n > 0 && loop_has_break(s.stmts) {
      return true;
    }
    if s.kind == StmtKind.StExpr {
      if s.a.kind == ExprKind.ExIf && if_arms_have_break(s.a) {
        return true;
      }
      if s.a.kind == ExprKind.ExMatch {
        let mut j: usize = 0;
        while j < s.a.arms.n {
          let arm: *MatchArm = s.a.arms.items[j];
          if arm.body.kind == ExprKind.ExBlock && arm.body.items.n > 0 &&
             loop_has_break(arm.body.items) {
            return true;
          }
          j += 1;
        }
      }
    }
    i += 1;
  }
  return false;
}

fn if_arms_have_break(ifx: *Expr) -> bool {
  let then: *Stmt = ifx.items.items[0];
  if then.stmts.n > 0 && loop_has_break(then.stmts) {
    return true;
  }
  if ifx.else_if != null {
    return if_arms_have_break(ifx.else_if);
  }
  if ifx.items.n > 1 {
    let blk: *Stmt = ifx.items.items[1];
    if blk.stmts.n > 0 && loop_has_break(blk.stmts) {
      return true;
    }
  }
  return false;
}

fn stmt_returns(s: *Stmt) -> bool {
  if s.kind == StmtKind.StReturn {
    return true;
  }
  if s.kind == StmtKind.StExpr && s.a.kind == ExprKind.ExIf {
    return if_expr_returns(s.a);
  }
  if s.kind == StmtKind.StExpr && s.a.kind == ExprKind.ExMatch {
    if s.a.arms.n == 0 {
      return false;
    }
    let mut i: usize = 0;
    while i < s.a.arms.n {
      let arm: *MatchArm = s.a.arms.items[i];
      if arm.body.kind != ExprKind.ExBlock {
        // expression arms produce values, they do not return
        i += 1;
        continue;
      }
      let mut any: bool = false;
      let mut j: usize = 0;
      while j < arm.body.items.n {
        if stmt_returns(arm.body.items.items[j]) {
          any = true;
        }
        j += 1;
      }
      if !any {
        return false;
      }
      i += 1;
    }
    return true;
  }
  if s.kind == StmtKind.StLoop {
    return !loop_has_break(s.body);
  }
  if s.kind == StmtKind.StBlock {
    return block_returns(s.stmts);
  }
  return false;
}

fn block_returns(stmts: *Vec[*Stmt]) -> bool {
  if stmts.n == 0 {
    return false;
  }
  return stmt_returns(stmts.items[stmts.n - 1]);
}

fn check_match(e: *Expr, expected: *Type) -> *Type {
  let scrut: *Type = check_expr(e.a, null);
  let mut ed: *Decl = null;
  let int_match: bool = ty_is_int(scrut) || scrut.kind == TypeKind.TyIntLit;
  if scrut.kind == TypeKind.TyEnum {
    ed = scrut.rec.decl;
  } else if !int_match {
    err_at(e.file, e.line, e.col, cat3("match scrutinee must be an enum or integer, found `", ty_name(scrut), "`"));
    e.typed = ty_err();
    return e.typed;
  }
  let covered: []bool = make([]bool, 256);
  let mut wildcard: bool = false;
  let mut result: *Type = null;
  let mut i: usize = 0;
  while i < e.arms.n {
    let arm: *MatchArm = e.arms.items[i];
    if ed != null {
      if arm.pk == PatKind.PatWildcard {
        wildcard = true;
      } else if arm.pk == PatKind.PatUnit || arm.pk == PatKind.PatTuple || arm.pk == PatKind.PatStruct {
        let vn: string = arm.pat_path.items[arm.pat_path.n - 1];
        let mut found: bool = false;
        let mut j: usize = 0;
        while j < ed.variants.n {
          let v: *VariantAst = ed.variants.items[j];
          if !streq(v.name, vn) {
            j += 1;
            continue;
          }
          if arm.pk == PatKind.PatUnit && v.vkind != VarKind.VarUnit {
            err_at(arm.file, arm.line, arm.col, cat5("variant `", vn, "` carries a payload; bind it: `", vn, "(..)`"));
          } else if arm.pk != PatKind.PatUnit && v.vkind == VarKind.VarUnit {
            err_at(arm.file, arm.line, arm.col, cat3("variant `", vn, "` has no payload to bind"));
          }
          covered[j] = true;
          arm.variant_index = j as i32;
          arm.disc = v.disc;
          found = true;
          break;
        }
        if !found {
          err_at(arm.file, arm.line, arm.col, cat5("no variant `", vn, "` on `", ty_name(scrut), "`"));
        } else {
          let v: *VariantAst = ed.variants.items[arm.variant_index as usize];
          let mut nfields: usize = 0;
          if v.vkind == VarKind.VarTuple {
            nfields = v.types.n;
          } else if v.vkind == VarKind.VarStruct {
            nfields = v.fields.n;
          }
          let mut nbinds: usize = 0;
          if arm.pk == PatKind.PatTuple {
            nbinds = arm.pat_names.n;
          } else if arm.pk == PatKind.PatStruct {
            nbinds = arm.pat_fields.n;
          }
          if arm.pk != PatKind.PatUnit && nbinds != nfields {
            err_at(arm.file, arm.line, arm.col, cat5("pattern `", vn, "` binds ", itoa(nbinds as i64), cat3(" values, variant has ", itoa(nfields as i64), "")));
          } else if arm.pk == PatKind.PatTuple && v.vkind == VarKind.VarTuple {
            let mut b: usize = 0;
            while b < nbinds && b < nfields {
              let nm: string = arm.pat_names.items[b];
              if !streq(nm, "_") {
                let bs: *Sym = new Sym {
                  kind: SymKind.SyLocal, name: nm,
                  type: variant_field_type(scrut, arm.variant_index, b as i32),
                  decl: null, mutable: false, variant_index: 0,
                  local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
                trait_rec: null,
                };
                next_local_id += 1;
                arm.bind_syms = push_sym(arm.bind_syms, bs);
                arm.bind_fidx = push_i64(arm.bind_fidx, b as i64);
              } else {
                arm.bind_syms = push_sym(arm.bind_syms, null);
                arm.bind_fidx = push_i64(arm.bind_fidx, b as i64);
              }
              b += 1;
            }
          } else if arm.pk == PatKind.PatStruct && v.vkind == VarKind.VarStruct {
            // every pattern field must exist on the variant; bindings in
            // pattern order, types from the matched variant field
            let mut b: usize = 0;
            while b < nbinds {
              let fa: *FieldAst = arm.pat_fields.items[b];
              let mut hit: bool = false;
              let mut j2: usize = 0;
              while j2 < v.fields.n {
                let vf: *FieldAst = v.fields.items[j2];
                if streq(vf.name, fa.name) {
                  hit = true;
                  let nm: string = arm.pat_names.items[b];
                  if !streq(nm, "_") {
                    let bs: *Sym = new Sym {
                      kind: SymKind.SyLocal, name: nm,
                      type: variant_field_type(scrut, arm.variant_index, j2 as i32),
                      decl: null, mutable: false, variant_index: 0,
                      local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
                    trait_rec: null,
                    };
                    next_local_id += 1;
                    arm.bind_syms = push_sym(arm.bind_syms, bs);
                    arm.bind_fidx = push_i64(arm.bind_fidx, j2 as i64);
                  } else {
                    arm.bind_syms = push_sym(arm.bind_syms, null);
                    arm.bind_fidx = push_i64(arm.bind_fidx, j2 as i64);
                  }
                  break;
                }
                j2 += 1;
              }
              if !hit {
                err_at(fa.file, fa.line, fa.col, cat5("variant `", vn, "` has no field `", fa.name, "`"));
              }
              b += 1;
            }
            if nbinds != 0 && len(arm.bind_syms) != v.fields.n {
              err_at(arm.file, arm.line, arm.col, cat5("pattern `", vn, " { .. }` must bind every field", "", ""));
            }
          }
        }
      } else {
        err_at(arm.file, arm.line, arm.col, "this pattern does not match an enum");
      }
    } else {
      if arm.pk == PatKind.PatWildcard {
        wildcard = true;
      } else if arm.pk == PatKind.PatInt {
        // literal match
      } else {
        err_at(arm.file, arm.line, arm.col, "integer match arms must be literals or `_`");
      }
    }
    scope_push();
    let mut bi: usize = 0;
    while bi < len(arm.bind_syms) {
      let bs: *Sym = arm.bind_syms[bi];
      if bs != null {
        if scope_lookup(bs.name) != null {
          err_at(arm.file, arm.line, arm.col, cat3("`", bs.name, "` shadows an existing binding"));
        }
        scope_decl(bs.name, bs);
      }
      bi += 1;
    }
    let bt: *Type = check_expr(arm.body, expected);
    if result == null {
      result = bt;
    } else {
      let u: *Type = unify2(result, bt, arm.body);
      if u.kind != TypeKind.TyErr {
        result = u;
      }
    }
    scope_pop();
    i += 1;
  }
  if ed != null && !wildcard {
    let mut j: usize = 0;
    while j < ed.variants.n {
      if !covered[j] {
        err_at(e.file, e.line, e.col, cat3("match is not exhaustive: missing `", ed.variants.items[j].name, "`"));
        break;
      }
      j += 1;
    }
  }
  if int_match && !wildcard && e.arms.n == 0 {
    err_at(e.file, e.line, e.col, "match needs at least one arm");
  }
  if result == null {
    result = ty_prim(14);
  }
  e.typed = result;
  return e.typed;
}

fn push_sym(items: []*Sym, s: *Sym) -> []*Sym {
  let out: []*Sym = make([]*Sym, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = s;
  return out;
}


// ============== callee resolution (check.c port L6d-1) ====================

enum CtKind { CtNone, CtFn, CtExtern, CtVariant, CtIndirect }

struct CallTarget {
  kind: CtKind,
  sym: *Sym,
  fn_type: *Type,
  variant: i32,
  enum_type: *Type,
  is_method: bool,
  is_ctor: bool,
  inst_rec: *RecType,
}

fn deref_to_struct(t: *Type) -> *Type {
  let mut cur: *Type = t;
  while cur != null && cur.kind == TypeKind.TyPtr {
    cur = cur.elem;
  }
  if cur != null && (cur.kind == TypeKind.TyStruct || cur.kind == TypeKind.TyEnum) {
    return cur;
  }
  return null;
}

fn resolve_callee(callee: *Expr) -> *CallTarget {
  let ct: *CallTarget = new CallTarget {
    kind: CtKind.CtNone, sym: null, fn_type: null, variant: 0,
    enum_type: null, is_method: false, is_ctor: false, inst_rec: null,
  };
  if callee.kind == ExprKind.ExName {
    let mut sym: *Sym = lookup(callee.sv);
    if sym == null && cur_module != null {
      sym = sm_get(cur_module.syms, callee.sv);
    }
    if sym == null {
      if cur_fn_sym != null { eprintf("{}", cur_fn_sym.name); }
      eprintf("{}", "\n");
      err_at("", 0, 0, cat("unknown function `", cat(callee.sv, "`")));
      return ct;
    }
    if sym.kind == SymKind.SyFn || sym.kind == SymKind.SyExtern {
      ct.kind = CtKind.CtFn;
      if sym.kind == SymKind.SyExtern {
        ct.kind = CtKind.CtExtern;
      }
      ct.sym = sym;
      ct.fn_type = sym.type;
      callee.sym = sym;
      return ct;
    }
    if sym.type != null && sym.type.kind == TypeKind.TyFn {
      ct.kind = CtKind.CtIndirect;
      ct.fn_type = sym.type;
      callee.sym = sym;
      callee.typed = sym.type;
      return ct;
    }
    err_at("", 0, 0, "this name is not a function");
    return ct;
  }
  if callee.kind == ExprKind.ExField {
    if callee.a.kind == ExprKind.ExName {
      let base: *Sym = lookup(callee.a.sv);
      if base != null && base.kind == SymKind.SyModule {
        let item: *Sym = sm_get(base.module.syms, callee.sv);
        if item != null && (item.kind == SymKind.SyFn || item.kind == SymKind.SyExtern) {
          if !item.decl.pub_ && !item.owner.is_prelude {
            err_at("", 0, 0, cat3(callee.a.sv, cat3(".", callee.sv, ""), " is not public"));
          }
          if item.kind == SymKind.SyFn {
            ct.kind = CtKind.CtFn;
          } else {
            ct.kind = CtKind.CtExtern;
          }
          ct.sym = item;
          ct.fn_type = item.type;
          callee.sym = item;
          return ct;
        }
        err_at("", 0, 0, cat3("module `", cat3(callee.a.sv, cat3("` has no function `", cat3(callee.sv, "`", ""), ""), ""), ""));
        return ct;
      }
      if base != null && base.kind == SymKind.SyEnum {
        let d: *Decl = base.decl;
        let mut i: usize = 0;
        while i < d.variants.n {
          let v: *VariantAst = d.variants.items[i];
          if streq(v.name, callee.sv) {
            ct.kind = CtKind.CtVariant;
            ct.variant = i as i32;
            ct.enum_type = base.type;
            ct.is_ctor = v.vkind == VarKind.VarStruct;
            let vs: *Sym = new Sym {
              kind: SymKind.SyVariant, name: callee.sv, type: base.type,
              decl: d, mutable: false, variant_index: i as i32,
              local_id: 0, symbol: "",
    owner: cur_module,
    module: null,
            trait_rec: null,
            };
            callee.sym = vs;
            return ct;
          }
          i += 1;
        }
      }
      if base != null && (base.kind == SymKind.SyStruct || base.kind == SymKind.SyEnum) {
        // associated function `Type.make(...)` lives under `Type.make`
        let fn_sym: *Sym = sm_get(cur_module.syms, callee.sv);
        if fn_sym != null && fn_sym.kind == SymKind.SyFn && !fn_sym.decl.is_method {
          ct.kind = CtKind.CtFn;
          ct.sym = fn_sym;
          ct.fn_type = fn_sym.type;
          callee.sym = fn_sym;
          return ct;
        }
        err_at("", 0, 0, "type has no such associated function");
        return ct;
      }
    }
    // method call: `receiver.name(...)`
    let bt: *Type = check_expr(callee.a, null);
    // 4z) dyn receiver: the name must be one of the trait's requirements;
    // the callee sym is the requirement itself (SY_TRAIT_METHOD) and the
    // receiver stays the fat value — lowering emits the virtual call
    if bt != null && bt.kind == TypeKind.TyDyn {
      let mut i4z: usize = 0;
      let found: bool = false;
      while i4z < len(bt.rec.methods) {
        let m: *Sym = bt.rec.methods[i4z];
        if streq(m.name, callee.sv) {
          ct.kind = CtKind.CtFn;
          ct.sym = m;
          ct.fn_type = m.type;
          ct.is_method = true;
          callee.sym = m;
          callee.typed = m.type.ret;
          callee.a.typed = bt;
          return ct;
        }
        i4z += 1;
      }
      if !found {
        err_at(callee.file, callee.line, callee.col, cat("trait `", cat(bt.rec.mangled, cat("` has no method `", cat3(callee.sv, "`", "")))));
        return ct;
      }
    }
    let rec_t: *Type = deref_to_struct(bt);
    if rec_t != null {
      let rec: *RecType = rec_t.rec;
      let mut i: usize = 0;
      while i < len(rec.methods) {
        let m: *Sym = rec.methods[i];
        if streq(m.name, callee.sv) {
          ct.kind = CtKind.CtFn;
          ct.sym = m;
          ct.fn_type = m.type;
          ct.is_method = true;
          callee.sym = m;
          callee.a.typed = bt;
          return ct;
        }
        i += 1;
      }
      if !rec.is_template && rec.decl.templ != null {
        let tmpl: *RecType = rec.decl.templ;
        let mut j: usize = 0;
        while j < len(tmpl.methods) {
          let m: *Sym = tmpl.methods[j];
          if streq(m.name, callee.sv) {
            ct.kind = CtKind.CtFn;
            ct.sym = m;
            ct.fn_type = m.type;
            ct.is_method = true;
            ct.inst_rec = rec;
            callee.sym = m;
            callee.a.typed = bt;
            return ct;
          }
          j += 1;
        }
      }
    }
    // 4b) primitive receiver (`n.to_str()`): auto-deref through pointers,
    // then the global primitive method table. Untyped literals resolve as
    // their default width (i32 / f64); the method-arg adapter materializes
    // the constant at `self`'s width below
    if rec_t == null {
      let mut pt: *Type = bt;
      while pt != null && pt.kind == TypeKind.TyPtr {
        pt = pt.elem;
      }
      if pt != null && pt.kind == TypeKind.TyIntLit {
        pt = ty_prim(3);
      } else if pt != null && pt.kind == TypeKind.TyFloatLit {
        pt = ty_prim(10);
      }
      if pt != null && ty_is_primitive(pt) {
        let pm: *Sym = prim_method_find(pt, callee.sv);
        if pm != null {
          ct.kind = CtKind.CtFn;
          ct.sym = pm;
          ct.fn_type = pm.type;
          ct.is_method = true;
          callee.sym = pm;
          callee.a.typed = bt;
          return ct;
        }
      }
    }
    // fall-through (boot check.c: the dotted path always resolves, errors,
    // or returns): no method anywhere on this receiver
    err_at(callee.file, callee.line, callee.col, cat("no method `", cat3(callee.sv, "` for `", cat(ty_name(bt), "`"))));
    return ct;
  }
  let t: *Type = check_expr(callee, null);
  if t.kind == TypeKind.TyFn {
    ct.kind = CtKind.CtIndirect;
    ct.fn_type = t;
    return ct;
  }
  err_at("", 0, 0, "cannot call this expression");
  return ct;
}


// ============== check_call: builtins (check.c port L6d-2) =================

// printf/eprintf/format format strings: split the literal into runs between
// `{}` placeholders; `{{` and `}}` are literal braces. Returns false on a
// stray brace (already diagnosed); the runs land in parts, the hole count
// in holes.
static mut g_fmt_holes: i32 = 0;
static mut g_fmt_bad: i32 = 0; // the stray brace character, 0 when clean

fn split_format(fmt: string, parts: *Vec[string]) -> bool {
  g_fmt_holes = 0;
  let mut cur: []u8 = make([]u8, 0);
  let mut i: usize = 0;
  let n: usize = len(fmt);
  while i < n {
    let ch: u8 = fmt[i];
    if ch == 123 || ch == 125 { // '{' '}'
      if i + 1 < n && fmt[i + 1] == ch { // `{{` / `}}`
        cur = push_u8(cur, ch);
        i += 2;
        continue;
      }
      if ch == 123 && i + 1 < n && fmt[i + 1] == 125 { // `{}` hole
        parts.push(intrinsics.slice_string(cur));
        cur = make([]u8, 0);
        g_fmt_holes += 1;
        i += 2;
        continue;
      }
      g_fmt_bad = ch as i32;
      return false;
    }
    cur = push_u8(cur, ch);
    i += 1;
  }
  parts.push(intrinsics.slice_string(cur));
  return true;
}

fn mk_str_lit(sv: string, file: string, line: i32, col: i32) -> *Expr {
  let lit: *Expr = mkexpr(ExprKind.ExStr, file, line, col);
  lit.sv = sv;
  return lit;
}

fn check_call(e: *Expr, expected: *Type) -> *Type {
  // printf/eprintf/format builtins: each `{}` takes the next value's
  // to_str. The printing pair desugars here into `__fmt_print("...",
  // x.to_str(), ...)` — a variadic string join in the prelude — or, with
  // no placeholders, into the raw byte sink; format desugars the same way
  // into `__fmt_build(...) -> string` (no placeholders: the literal
  // itself); then the regular path checks the rewritten call
  if e.a.kind == ExprKind.ExName && (streq(e.a.sv, "printf") || streq(e.a.sv, "eprintf") || streq(e.a.sv, "format")) {
    let err_sink: bool = streq(e.a.sv, "eprintf");
    let to_value: bool = streq(e.a.sv, "format");
    let mut verb: string = "printf";
    if err_sink {
      verb = "eprintf";
    } else if to_value {
      verb = "format";
    }
    if e.args.n == 0 {
      err_at(e.file, e.line, e.col, cat("a call to ", cat3(verb, " needs a format string", "")));
      e.typed = ty_err();
      return e.typed;
    }
    let fmt: *Expr = e.args.items[0];
    if fmt.kind != ExprKind.ExStr {
      err_at(fmt.file, fmt.line, fmt.col, cat("the format string passed to ", cat3(verb, " must be a string literal", "")));
      e.typed = ty_err();
      return e.typed;
    }
    let parts: *Vec[string] = new Vec[string] { items: make([]string, 8), n: 0 };
    if !split_format(fmt.sv, parts) {
      let b1: []u8 = push_u8(make([]u8, 0), g_fmt_bad as u8);
      let b2: []u8 = push_u8(push_u8(make([]u8, 0), g_fmt_bad as u8), g_fmt_bad as u8);
      err_at(fmt.file, fmt.line, fmt.col,
             cat4("stray `", bytes_as_string(b1), "` in the format string (escape it as `", cat(bytes_as_string(b2), "`)")));
      e.typed = ty_err();
      return e.typed;
    }
    if g_fmt_holes as usize != e.args.n - 1 {
      err_at(e.file, e.line, e.col, cat("the format string has ", cat(itoa(g_fmt_holes as i64), cat(" `{}` but ", cat3(itoa((e.args.n - 1) as i64), " values were given", "")))));
      e.typed = ty_err();
      return e.typed;
    }
    let nargs: *Vec[*Expr] = fresh_expr_vec();
    if g_fmt_holes == 0 && to_value {
      // format with no placeholders is the literal itself: no call, no copy
      e.kind = ExprKind.ExStr;
      e.sv = parts.items[0];
      return check_expr(e, null);
    }
    if g_fmt_holes == 0 {
      nargs.push(mk_str_lit(parts.items[0], fmt.file, fmt.line, fmt.col));
      if err_sink {
        e.a.sv = "__eprint_str";
      } else {
        e.a.sv = "__print_str";
      }
    } else {
      let mut k: usize = 0;
      while k <= g_fmt_holes as usize {
        nargs.push(mk_str_lit(parts.items[k], fmt.file, fmt.line, fmt.col));
        if k == g_fmt_holes as usize {
          break;
        }
        let recv: *Expr = e.args.items[k + 1];
        let field: *Expr = mkexpr(ExprKind.ExField, recv.file, recv.line, recv.col);
        field.a = recv;
        field.sv = "to_str";
        let call: *Expr = mkexpr(ExprKind.ExCall, recv.file, recv.line, recv.col);
        call.a = field;
        nargs.push(call);
        k += 1;
      }
      if to_value {
        e.a.sv = "__fmt_build";
      } else if err_sink {
        e.a.sv = "__fmt_eprint";
      } else {
        e.a.sv = "__fmt_print";
      }
    }
    e.args = nargs;
    e.arg_names = fresh_str_vec();
    e.a.sym = null;
    // fall through: the sink is variadic, so each value is checked
    // against string; a value without to_str reports its own error there
  }
  // make(T, n)
  if e.a.kind == ExprKind.ExName && streq(e.a.sv, "make") {
    if e.args.n != 2 {
      err_at("", 0, 0, "make takes (type, length)");
      e.typed = ty_err();
      return e.typed;
    }
    let tye: *Expr = e.args.items[0];
    if tye.kind != ExprKind.ExType || tye.ty.kind != TypeAstKind.TaArray || tye.ty.size != null {
      err_at("", 0, 0, "make takes a slice type like `[]i32`");
      e.typed = ty_err();
      return e.typed;
    }
    let elem: *Type = resolve_type_in_module(cur_module, tye.ty.elem);
    let mut ln: *Type = check_expr(e.args.items[1], null);
    if ln.kind == TypeKind.TyIntLit {
      ln = ty_prim(12);
      e.args.items[1].typed = ln;
    }
    if !ty_is_int(ln) {
      err_at("", 0, 0, "make length must be an integer");
    }
    e.typed = ty_slice(elem);
    return e.typed;
  }
  // len(x)
  if e.a.kind == ExprKind.ExName && streq(e.a.sv, "len") {
    if e.args.n != 1 {
      err_at("", 0, 0, "len takes one argument");
      e.typed = ty_err();
      return e.typed;
    }
    let t: *Type = check_expr(e.args.items[0], null);
    if t.kind != TypeKind.TySlice && t.kind != TypeKind.TyStringK && t.kind != TypeKind.TyArray {
      err_at("", 0, 0, "len needs an array, slice or string");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = ty_prim(12);
    return e.typed;
  }
  // weak.from(p)
  if e.a.kind == ExprKind.ExField && e.a.a.kind == ExprKind.ExName &&
     streq(e.a.a.sv, "weak") && streq(e.a.sv, "from") {
    if e.args.n != 1 {
      err_at("", 0, 0, "weak.from takes one argument");
      e.typed = ty_err();
      return e.typed;
    }
    let t: *Type = check_expr(e.args.items[0], null);
    if t.kind != TypeKind.TyPtr ||
       (t.elem.kind != TypeKind.TyStruct && t.elem.kind != TypeKind.TyEnum) {
      err_at("", 0, 0, "weak.from needs a pointer to a new object");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = ty_weak(t.elem);
    return e.typed;
  }
  // w.get()
  if e.a.kind == ExprKind.ExField && streq(e.a.sv, "get") {
    let mut bt: *Type = e.a.a.typed;
    if bt == null {
      bt = check_expr(e.a.a, null);
    }
    if bt != null && bt.kind == TypeKind.TyWeak {
      if e.args.n != 0 {
        err_at("", 0, 0, "get takes no arguments");
      }
      e.typed = ty_ptr(bt.elem);
      return e.typed;
    }
  }
  // intrinsics.*
  if e.a.kind == ExprKind.ExField && e.a.a.kind == ExprKind.ExName &&
     streq(e.a.a.sv, "intrinsics") {
    let name: string = e.a.sv;
    let is_load: bool = streq(name, "load_u8") || streq(name, "load_u32") ||
                        streq(name, "load_u64") || streq(name, "load_i64");
    let is_store: bool = streq(name, "store_u8") || streq(name, "store_u32") ||
                         streq(name, "store_u64") || streq(name, "store_i64");
    let is_memcpy: bool = streq(name, "memcpy");
    let is_slice_str: bool = streq(name, "slice_string");
    let is_bits: bool = streq(name, "f64_bits") || streq(name, "f32_bits");
    let is_mem: bool = streq(name, "mem_size") || streq(name, "mem_grow");
    if !is_load && !is_store && !is_memcpy && !is_slice_str && !is_bits &&
       !is_mem {
      err_at("", 0, 0, cat("unknown intrinsic `", cat(name, "`")));
      e.typed = ty_err();
      return e.typed;
    }
    if is_mem {
      // linear-memory introspection (spec 10): the wasi prelude's bump
      // allocator grows memory on demand with these — both yield usize
      if streq(name, "mem_grow") {
        if e.args.n != 1 {
          err_at("", 0, 0, "intrinsics.mem_grow takes one argument");
          e.typed = ty_err();
          return e.typed;
        }
        let gt: *Type = check_expr(e.args.items[0], null);
        if gt.kind != TypeKind.TyUsize {
          err_at("", 0, 0, "intrinsics.mem_grow needs usize pages");
          e.typed = ty_err();
          return e.typed;
        }
      } else {
        if e.args.n != 0 {
          err_at("", 0, 0, "intrinsics.mem_size takes no arguments");
          e.typed = ty_err();
          return e.typed;
        }
      }
      e.typed = ty_prim(12); // usize
      return e.typed;
    }
    if is_bits {
      if e.args.n != 1 {
        err_at("", 0, 0, cat("unknown intrinsic `", cat(name, "`")));
        e.typed = ty_err();
        return e.typed;
      }
      let t: *Type = check_expr(e.args.items[0], null);
      let wantf64: bool = streq(name, "f64_bits");
      if wantf64 && t.kind != TypeKind.TyF64 {
        err_at("", 0, 0, "intrinsics.f64_bits needs f64");
        e.typed = ty_err();
        return e.typed;
      }
      if !wantf64 && t.kind != TypeKind.TyF32 {
        err_at("", 0, 0, "intrinsics.f32_bits needs f32");
        e.typed = ty_err();
        return e.typed;
      }
      if wantf64 {
        e.typed = ty_prim(8); // u64
      } else {
        e.typed = ty_prim(7); // u32
      }
      return e.typed;
    }
    if is_load {
      if e.args.n != 1 {
        err_at("", 0, 0, "intrinsics load takes one pointer");
        e.typed = ty_err();
        return e.typed;
      }
      let t: *Type = check_expr(e.args.items[0], null);
      if t.kind != TypeKind.TyPtr {
        err_at("", 0, 0, "intrinsics load needs a pointer");
        e.typed = ty_err();
        return e.typed;
      }
      let mut k: i32 = 8; // u32 default falls out below
      if streq(name, "load_u8") { k = 5; }
      if streq(name, "load_u32") { k = 7; }
      if streq(name, "load_u64") { k = 8; }
      if streq(name, "load_i64") { k = 4; }
      e.typed = ty_prim(k);
      return e.typed;
    }
    if is_store {
      if e.args.n != 2 {
        err_at("", 0, 0, "intrinsics store takes pointer and value");
        e.typed = ty_err();
        return e.typed;
      }
      let t: *Type = check_expr(e.args.items[0], null);
      if t.kind != TypeKind.TyPtr {
        err_at("", 0, 0, "intrinsics store needs a pointer");
        e.typed = ty_err();
        return e.typed;
      }
      check_expr(e.args.items[1], null);
      e.typed = ty_prim(14);
      return e.typed;
    }
    if is_memcpy {
      if e.args.n != 3 {
        err_at("", 0, 0, "memcpy takes dst, src and count");
        e.typed = ty_err();
        return e.typed;
      }
      check_expr(e.args.items[0], null);
      check_expr(e.args.items[1], null);
      check_expr(e.args.items[2], null);
      e.typed = ty_prim(14);
      return e.typed;
    }
    // slice_string
    if e.args.n != 1 {
      err_at("", 0, 0, "slice_string takes one []u8");
      e.typed = ty_err();
      return e.typed;
    }
    let t: *Type = check_expr(e.args.items[0], null);
    if t.kind != TypeKind.TySlice {
      err_at("", 0, 0, "slice_string takes a []u8");
      e.typed = ty_err();
      return e.typed;
    }
    e.typed = ty_prim(11);
    return e.typed;
  }
  // general call path (L6e): resolve_callee + arg checking + generics
  let ct: *CallTarget = resolve_callee(e.a);
  if ct.kind == CtKind.CtNone {
    e.typed = ty_err();
    return e.typed;
  }
  if ct.kind == CtKind.CtVariant {
    // variant construction: if the context pins an instantiation of the same
    // enum, use it; payloads resolve under the enum's template env
    if expected != null && expected.kind == TypeKind.TyEnum &&
       expected.rec != null && expected.rec.decl == ct.enum_type.rec.decl {
      ct.enum_type = expected;
    }
    let d: *Decl = ct.enum_type.rec.decl;
    let v: *VariantAst = d.variants.items[ct.variant];
    let saved_env: *TypeMap = g_tenv;
    if ct.enum_type.rec.env_tenv != null {
      g_tenv = ct.enum_type.rec.env_tenv;
    }
    if ct.is_ctor {
      let mut i: usize = 0;
      while i < e.args.n {
        let init: *Expr = e.args.items[i];
        let mut ft: *Type = null;
        if v.vkind == VarKind.VarStruct && i < v.fields.n {
          // named field: find the payload type by name
          let mut nm: string = "";
          if i < e.arg_names.n {
            nm = e.arg_names.items[i];
          }
          let mut j2: usize = 0;
          while j2 < v.fields.n {
            if streq(v.fields.items[j2].name, nm) {
              ft = variant_field_type(ct.enum_type, ct.variant, j2 as i32);
              j2 = v.fields.n;
            } else {
              j2 += 1;
            }
          }
        }
        let got: *Type = check_expr(init, ft);
        if ft != null {
          init.typed = adapt_literal(got, ft);
        }
        i += 1;
      }
    } else {
      let mut i: usize = 0;
      while i < e.args.n {
        let mut at: *Type = null;
        if i < v.types.n {
          at = resolve_type_in_module(cur_module, v.types.items[i]);
        }
        check_expr(e.args.items[i], at);
        i += 1;
      }
    }
    g_tenv = saved_env;
    e.typed = ct.enum_type;
    return e.typed;
  }
  // generic call: infer the type arguments and specialize
  if ct.kind == CtKind.CtFn &&
     (ct.inst_rec != null || (ct.sym.decl.templated && ct.sym.decl.tparams.n > 0)) {
    let env: *TypeMap = tm_new();
    let names: *Vec[string] = make_str_vec();
    if ct.inst_rec != null {
      let rd: *Decl = ct.inst_rec.decl;
      let mut ri: usize = 0;
      while ri < rd.tparams.n && ri < len(ct.inst_rec.targs) {
        names.push(rd.tparams.items[ri]);
        tm_put(env, rd.tparams.items[ri], ct.inst_rec.targs[ri]);
        ri += 1;
      }
    }
    let mut ni: usize = 0;
    while ni < ct.sym.decl.tparams.n {
      names.push(ct.sym.decl.tparams.items[ni]);
      ni += 1;
    }
    let fn_t: *Type = ct.fn_type; // template signature
    let nparams0: usize = len(fn_t.params);
    let first: usize = if ct.is_method { 1 } else { 0 };
    if ct.is_method {
      let mut recv: *Type = e.a.a.typed;
      if recv == null {
        recv = check_expr(e.a.a, null);
      }
      infer_targs(fn_t.params[0], recv, env);
    }
    if e.args.n + first != nparams0 {
      err_at(e.file, e.line, e.col, cat5("function takes ", itoa((nparams0 - first) as i64), " arguments, got ", itoa(e.args.n as i64), ""));
    }
    let mut gi: usize = 0;
    while gi < e.args.n {
      let at: *Type = check_expr(e.args.items[gi], null);
      infer_targs(fn_t.params[first + gi], at, env);
      gi += 1;
    }
    // untyped literals adapt through a direct `-> T` return
    if expected != null && fn_t.ret != null && fn_t.ret.kind == TypeKind.TyParam {
      let targ: *Type = tm_get(env, fn_t.ret.mangled);
      if targ != null && targ.kind == TypeKind.TyIntLit && ty_is_int(expected) {
        tm_put(env, fn_t.ret.mangled, expected);
      } else if targ != null && targ.kind == TypeKind.TyFloatLit && ty_is_flt(expected) {
        tm_put(env, fn_t.ret.mangled, expected);
      }
    }
    let inst: *Sym = instantiate_fn(ct.sym, names.items[0..names.n], env, e);
    ct.sym = inst;
    ct.fn_type = inst.type;
    ct.inst_rec = null;
    e.a.sym = inst; // lower emits the call against the instantiation
  }
  // fn/extern/indirect: check args against the signature
  let ft: *Type = ct.fn_type;
  let nparams: usize = len(ft.params);
  // variadic callee: the trailing `rest: T...` parameter is a []T the call
  // site builds from the extra arguments (or takes whole from `xs...`)
  let variadic: bool = ct.sym != null && ct.sym.kind == SymKind.SyFn &&
                       ct.sym.decl != null && ct.sym.decl.kind == DeclKind.DkFn &&
                       ct.sym.decl.params.n > 0 &&
                       ct.sym.decl.params.items[ct.sym.decl.params.n - 1].is_variadic;
  let spread: bool = e.args.n > 0 && e.args.items[e.args.n - 1].spread;
  if spread && !variadic {
    err_at(e.args.items[e.args.n - 1].file, e.args.items[e.args.n - 1].line,
           e.args.items[e.args.n - 1].col, "`...` spread needs a variadic parameter to fill");
  }
  // a dyn call's signature already excludes the receiver — the virtual
  // call passes the object as the hidden env, so args align with params
  let dyn_call: bool = ct.sym != null && ct.sym.kind == SymKind.SyTraitMethod;
  let mut arg_off: usize = 0;
  if ct.is_method && dyn_call {
    if !variadic || spread {
      if e.args.n != nparams {
        err_at(e.file, e.line, e.col, cat3("method takes ", cat(itoa(nparams as i64), cat(" arguments, got ", cat3(itoa(e.args.n as i64), "", ""))), ""));
      }
    } else {
      if e.args.n < nparams {
        err_at(e.file, e.line, e.col, cat3("method takes at least ", cat(itoa(nparams as i64), cat(" arguments, got ", cat3(itoa(e.args.n as i64), "", ""))), ""));
      }
    }
  } else if ct.is_method {
    if !variadic || spread {
      if e.args.n + 1 != nparams {
        err_at(e.file, e.line, e.col, cat5("method takes ", itoa((nparams - 1) as i64), " arguments, got ", itoa(e.args.n as i64), ""));
      }
    } else {
      if e.args.n + 1 < nparams {
        err_at(e.file, e.line, e.col, cat5("method takes at least ", itoa((nparams - 1) as i64), " arguments, got ", itoa(e.args.n as i64), ""));
      }
    }
    let self_param: *Type = ft.params[0];
    let mut recv: *Type = e.a.a.typed;
    if recv == null || recv.kind == TypeKind.TyErr {
      recv = check_expr(e.a.a, null);
    }
    // accept receiver by value or pointer when self matches the other form
    let mut ok: bool = types_compatible(recv, self_param);
    let literal_recv: bool = recv != null &&
      (recv.kind == TypeKind.TyIntLit || recv.kind == TypeKind.TyFloatLit);
    if !ok && recv != null && recv.kind == TypeKind.TyPtr && self_param.kind != TypeKind.TyPtr &&
       types_compatible(recv.elem, self_param) {
      ok = true; // self: T, receiver *T: auto-deref (no auto-ref; there is no &)
    }
    if !ok && literal_recv && self_param != null &&
       ((recv.kind == TypeKind.TyIntLit && ty_is_int(self_param)) ||
        (recv.kind == TypeKind.TyFloatLit && ty_is_flt(self_param))) {
      ok = true; // untyped literal receiver adapts to self (`5.to_str()`)
    }
    if !ok {
      err_at(e.a.file, e.a.line, e.a.col, cat5("method `", e.a.sv, "` expects self as `", ty_name(self_param), cat3("`, receiver is `", ty_name(recv), "`")));
    } else if literal_recv {
      // adapt it so lowering materializes the constant at self's width
      require(recv, self_param, e.a.a, "method receiver");
    }
    arg_off = 1;
  } else if variadic && !spread {
    if e.args.n < nparams - 1 {
      err_at(e.file, e.line, e.col, cat3("function takes at least ", cat(itoa((nparams - 1) as i64), cat(" arguments, got ", cat3(itoa(e.args.n as i64), "", ""))), ""));
    }
  } else if variadic && spread {
    if e.args.n != nparams {
      err_at(e.file, e.line, e.col, cat3("function takes exactly ", cat(itoa((nparams - 1) as i64), cat(" arguments before the spread, got ", cat3(itoa(e.args.n as i64), "", ""))), ""));
    }
  } else if e.args.n != nparams {
    err_at(e.file, e.line, e.col, cat5("function takes ", itoa(nparams as i64), " arguments, got ", itoa(e.args.n as i64), ""));
  }
  let mut i: usize = arg_off;
  while i < nparams {
    let ai: usize = i - arg_off;
    if ai >= e.args.n {
      break;
    }
    let last: bool = i + 1 == nparams;
    let pt: *Type = ft.params[i];
    if variadic && last {
      // the slice param: a spread arg passes its value whole; otherwise the
      // remaining args are checked element-wise against T
      if spread {
        let at: *Type = check_expr(e.args.items[ai], pt);
        if at.kind != TypeKind.TyErr && at != pt {
          err_at(e.args.items[ai].file, e.args.items[ai].line, e.args.items[ai].col,
                 cat("spread needs `", cat(ty_name(pt), cat("`, found `", cat3(ty_name(at), "`", "")))));
        }
        i += 1;
        continue;
      }
      let elem: *Type = pt.elem;
      let mut k: usize = ai;
      while k < e.args.n {
        let at2: *Type = check_expr(e.args.items[k], elem);
        require(at2, elem, e.args.items[k], "argument");
        k += 1;
      }
      break;
    }
    let at3: *Type = check_expr(e.args.items[ai], pt);
    if !(e.args.items[ai].spread && !variadic) {
      require(at3, pt, e.args.items[ai], "argument");
    }
    i += 1;
  }
  e.typed = ft.ret;
  // never coercion: panic never returns, so a call to it is compatible with
  // any expected type (match arms like `Result.Err(_) => panic("...")`)
  if expected != null && expected.kind != TypeKind.TyErr &&
     expected.kind != TypeKind.TyVoid && ft.ret != null &&
     ft.ret.kind == TypeKind.TyVoid && ct.sym != null && ct.sym.owner != null &&
     streq(ct.sym.name, "panic") &&
     (ct.sym.owner == prelude_module || ct.sym.owner.is_prelude) {
    e.typed = expected;
  }
  return e.typed;
}


// ============== statement checking (check.c port L6e) =====================

static mut in_defer: bool = false;
static mut loop_depth: i32 = 0;

fn ty_is_or_has_err(t: *Type) -> bool {
  if t == null {
    return false;
  }
  if t.kind == TypeKind.TyErr {
    return true;
  }
  if t.elem != null && ty_is_or_has_err(t.elem) {
    return true;
  }
  if t.ret != null && ty_is_or_has_err(t.ret) {
    return true;
  }
  return false;
}

fn lvalue_mutable(e: *Expr) -> bool {
  if e.kind == ExprKind.ExName {
    let sym: *Sym = e.sym;
    if sym == null {
      return false;
    }
    if sym.kind == SymKind.SyLocal || sym.kind == SymKind.SyParam ||
       sym.kind == SymKind.SyStatic {
      return sym.mutable;
    }
    return false;
  }
  if e.kind == ExprKind.ExUn && e.unop == Tok.PStar {
    return true; // *p — the pointer decides
  }
  if e.kind == ExprKind.ExField {
    let bt: *Type = e.a.typed;
    if bt != null && bt.kind == TypeKind.TyPtr {
      return true; // heap object
    }
    return lvalue_mutable(e.a);
  }
  if e.kind == ExprKind.ExIndex {
    let bt: *Type = e.a.typed;
    if bt != null && bt.kind == TypeKind.TySlice {
      return true; // heap buffer shared by reference
    }
    return lvalue_mutable(e.a);
  }
  return false;
}

fn check_stmt(s: *Stmt) {
  if s.kind == StmtKind.StLet {
    let mut ann: *Type = null;
    if s.ty != null {
      ann = resolve_type_in_module(cur_module, s.ty);
    }
    let mut t: *Type = check_expr(s.a, ann);
    if ann != null {
      // the annotation pins the binding's type; literals adapt, anything
      // else must genuinely match. An error type already has its own
      // diagnostic — don't pile a second one onto it
      if !ty_is_or_has_err(ann) && !ty_is_or_has_err(t) {
        require(t, ann, s.a, "initializer");
      }
      t = ann;
      if s.a.kind != ExprKind.ExDynbox && t.kind == TypeKind.TyDyn &&
         s.a.typed != null && s.a.typed.kind != TypeKind.TyDyn &&
         !ty_is_or_has_err(s.a.typed) {
        try_dyn_coerce(s.a, s.a.typed, t);
        s.a.typed = t;
      }
    } else {
      if t.kind == TypeKind.TyIntLit {
        t = ty_prim(3);
      } else if t.kind == TypeKind.TyFloatLit {
        t = ty_prim(10);
      } else if t.kind == TypeKind.TyNull {
        err_at(s.file, s.line, s.col, "`null` needs a type annotation");
        t = ty_err();
      } else if t.kind == TypeKind.TyErr {
        t = ty_err();
      } else if t.kind == TypeKind.TyVoid {
        err_at(s.file, s.line, s.col, "cannot bind void");
        t = ty_err();
      }
    }
    let sym: *Sym = new Sym {
      kind: SymKind.SyLocal, name: s.name, type: t, decl: null,
      mutable: s.mut_, variant_index: 0, local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
    trait_rec: null,
    };
    next_local_id += 1;
    if scope_lookup(s.name) != null {
      err_at(s.file, s.line, s.col, cat("`", cat3(s.name, "` shadows an existing binding", "")));
    }
    scope_decl(s.name, sym);
    s.a.typed = t;
    return;
  }
  if s.kind == StmtKind.StAssign {
    let target: *Type = check_expr(s.a, null);
    let compound: bool = s.assign_op != Tok.PAssign;
    let mut value: *Type = null;
    if compound {
      value = adapt_literal(check_expr(s.b, target), target);
      s.b.typed = value;
      // target op value must be well-formed and equal target's type
      if s.assign_op == Tok.PShleq || s.assign_op == Tok.PShreq {
        if !ty_is_int(target) || !ty_is_int(value) {
          err_at(s.file, s.line, s.col, "shift assignment needs integers");
        }
      } else {
        if !types_compatible(target, value) && !(ty_is_int(target) && ty_is_int(value)) &&
           !(ty_is_flt(target) && ty_is_flt(value)) {
          err_at(s.file, s.line, s.col, cat5("type mismatch in assignment: `", ty_name(target), "` vs `", ty_name(value), "`"));
        }
      }
    } else {
      value = adapt_literal(check_expr(s.b, target), target);
      if value != target && target.kind == TypeKind.TyDyn &&
         value.kind != TypeKind.TyDyn && !ty_is_or_has_err(value) {
        try_dyn_coerce(s.b, value, target);
        value = target;
      }
      s.b.typed = value;
      if !types_compatible(target, value) {
        err_at(s.file, s.line, s.col, cat5("cannot assign `", ty_name(value), "` to `", ty_name(target), "`"));
      }
    }
    if !lvalue_mutable(s.a) {
      err_at(s.file, s.line, s.col, "cannot assign to an immutable binding (declare it `let mut`)");
    }
    return;
  }
  if s.kind == StmtKind.StExpr {
    check_expr(s.a, null);
    return;
  }
  if s.kind == StmtKind.StReturn {
    if in_defer {
      err_at(s.file, s.line, s.col, "`return` is not allowed in defer");
      return;
    }
    if cur_ret == null || cur_ret.kind == TypeKind.TyVoid {
      if s.a != null {
        err_at(s.file, s.line, s.col, "this function returns nothing");
      }
    } else {
      if s.a == null {
        err_at(s.file, s.line, s.col, "missing return value");
      } else {
        require(check_expr(s.a, cur_ret), cur_ret, s.a, "return value");
      }
    }
    return;
  }
  if s.kind == StmtKind.StBreak || s.kind == StmtKind.StContinue {
    let mut w: string = "break";
    if s.kind == StmtKind.StContinue {
      w = "continue";
    }
    if in_defer {
      err_at(s.file, s.line, s.col, cat3("`", w, "` is not allowed in defer"));
    } else if loop_depth == 0 {
      err_at(s.file, s.line, s.col, cat3("`", w, "` outside of a loop"));
    }
    return;
  }
  if s.kind == StmtKind.StDefer {
    let saved: bool = in_defer;
    in_defer = true;
    scope_push();
    let mut i: usize = 0;
    while i < s.stmts.n {
      check_stmt(s.stmts.items[i]);
      i += 1;
    }
    scope_pop();
    in_defer = saved;
    return;
  }
  if s.kind == StmtKind.StWhile {
    let saved_depth: i32 = loop_depth;
    loop_depth += 1;
    let cond: *Type = check_expr(s.cond, null);
    if cond.kind != TypeKind.TyBool {
      err_at("", 0, 0, "while condition must be bool");
    }
    scope_push();
    let mut i: usize = 0;
    while i < s.body.n {
      check_stmt(s.body.items[i]);
      i += 1;
    }
    scope_pop();
    loop_depth = saved_depth;
    return;
  }
  if s.kind == StmtKind.StLoop {
    let saved_depth: i32 = loop_depth;
    loop_depth += 1;
    scope_push();
    let mut i: usize = 0;
    while i < s.body.n {
      check_stmt(s.body.items[i]);
      i += 1;
    }
    scope_pop();
    loop_depth = saved_depth;
    return;
  }
  if s.kind == StmtKind.StBlock {
    scope_push();
    let mut i: usize = 0;
    while i < s.stmts.n {
      check_stmt(s.stmts.items[i]);
      i += 1;
    }
    scope_pop();
    return;
  }
}

fn check_fn_body(d: *Decl, sym: *Sym, m: *Module) {
  if d.tparams.n > 0 {
    // generic template: check once under TY_PARAM placeholders
    g_tenv = template_env_of(d);
  } else if len(d.recv) > 0 {
    let mut struct_sym: *Sym = sm_get(m.syms, d.recv);
    if struct_sym == null && prelude_module != null && prelude_module != m {
      struct_sym = sm_get(prelude_module.syms, d.recv);
    }
    if struct_sym != null && struct_sym.decl.tparams.n > 0 {
      let tmpl: *RecType = ensure_template(struct_sym.decl, m);
      g_tenv = tmpl.env_tenv;
    }
  }
  cur_ret = sym.type.ret;
  scope_push();
  let mut i: usize = 0;
  while i < d.params.n {
    let p: *Param = d.params.items[i];
    // use the symbol's resolved signature: instantiation clones carry
    // concrete param types the AST re-resolution would clobber
    let pt: *Type = if i < len(sym.type.params) {
      sym.type.params[i]
    } else {
      resolve_type_in_module(cur_module, p.ty)
    };
    let ps: *Sym = new Sym {
      kind: SymKind.SyParam, name: p.name, type: pt, decl: null,
      mutable: true, variant_index: 0, local_id: next_local_id, symbol: "",
    owner: cur_module,
    module: null,
    trait_rec: null,
    };
    next_local_id += 1;
    scope_decl(p.name, ps);
    i += 1;
  }
  let mut k: usize = 0;
  while k < d.body.n {
    check_stmt(d.body.items[k]);
    k += 1;
  }
  if cur_ret != null && cur_ret.kind != TypeKind.TyVoid && !block_returns(d.body) {
    err_at(d.file, d.line, d.col, cat5("missing return: `", d.name, "` is `", ty_name(cur_ret), "`"));
  }
  scope_pop();
  g_tenv = null;
}


// ============== check driver (check.c port L6f) ===========================

// attach a method to its receiver struct's RecType — or, for a primitive
// receiver (`fn i32.to_str`), to the global primitive table — and build the
// fn type
fn wire_method(m: *Module, d: *Decl) -> *Type {
  let mut struct_sym: *Sym = sm_get(m.syms, d.recv);
  if struct_sym == null && prelude_module != null && prelude_module != m {
    struct_sym = sm_get(prelude_module.syms, d.recv);
  }
  // resolve the signature under the RECEIVER type's template env, so bare
  // generic references (`self: Option`) name the template
  let saved_env: *TypeMap = g_tenv;
  if struct_sym != null && struct_sym.decl.tparams.n > 0 {
    let tmpl: *RecType = ensure_template(struct_sym.decl, m);
    g_tenv = tmpl.env_tenv;
  }
  let nparams: usize = d.params.n;
  let mut ps: []*Type = fresh_type_vec2();
  let mut i: usize = 0;
  while i < nparams {
    ps = push_type(ps, resolve_type_in_module(m, d.params.items[i].ty));
    i += 1;
  }
  let ret: *Type = resolve_type_in_module(m, d.ret);
  let ft: *Type = ty_fn(ps, ret);
  let msym: *Sym = new Sym {
    kind: SymKind.SyFn, name: d.name, type: ft, decl: d,
    mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: cur_module,
    module: null,
  trait_rec: null,
  };
  // attach the method to the receiver's own rec (deref through *self) — or
  // to the global per-primitive table when self anchors a builtin type
  if len(ps) > 0 {
    let mut rec_t: *Type = ps[0];
    if rec_t.kind == TypeKind.TyPtr {
      rec_t = rec_t.elem;
    }
    if rec_t.kind == TypeKind.TyStruct || rec_t.kind == TypeKind.TyEnum {
      if rec_t.rec != null {
        rec_t.rec.methods = push_sym(rec_t.rec.methods, msym);
      }
    } else if ty_is_primitive(rec_t) {
      if prim_method_find(rec_t, d.name) != null {
        err_at(d.file, d.line, d.col, cat4("duplicate method `", d.name,
          "` for primitive `", cat3(rec_t.mangled, "` (primitive methods are global)", "")));
      } else {
        if g_prim_methods == null {
          g_prim_methods = new Vec[*PrimMethods] { items: make([]*PrimMethods, 8), n: 0 };
        }
        let mut list: *PrimMethods = null;
        let mut li: usize = 0;
        while li < g_prim_methods.n {
          if streq(g_prim_methods.items[li].key, rec_t.mangled) {
            list = g_prim_methods.items[li];
          }
          li += 1;
        }
        if list == null {
          list = new PrimMethods { key: rec_t.mangled, syms: make([]*Sym, 0) };
          g_prim_methods.push(list);
        }
        list.syms = push_sym(list.syms, msym);
      }
    } else {
      err_at(d.file, d.line, d.col, "`self` must be a struct, enum, or primitive");
    }
  }
  g_tenv = saved_env;
  return ft;
}

// one fn parameter's resolved type: `rest: T...` is `[]T` to every caller
// (the call site decides how the slice is built)
fn variadic_param_type(m: *Module, d: *Decl, idx: usize) -> *Type {
  let pt: *Type = resolve_type_in_module(m, d.params.items[idx].ty);
  if d.params.items[idx].is_variadic {
    if type_has_param(pt) {
      err_at(d.params.items[idx].file, d.params.items[idx].line, d.params.items[idx].col,
             "a variadic parameter needs a concrete element type");
    }
    return ty_slice(pt);
  }
  return pt;
}

// resolve one fn/method decl's signature into its symbol (pass 2a body,
// shared with impl-block methods)
fn resolve_fn_signature(m: *Module, decl: *Decl) {
  let nparams: usize = decl.params.n;
  let mut ps: []*Type = fresh_type_vec2();
  let mut j: usize = 0;
  while j < nparams {
    if len(decl.recv) > 0 {
      let mut rsym: *Sym = sm_get(m.syms, decl.recv);
      if rsym == null && prelude_module != null && prelude_module != m {
        rsym = sm_get(prelude_module.syms, decl.recv);
      }
      if rsym != null && rsym.decl.tparams.n > 0 {
        let tmpl: *RecType = ensure_template(rsym.decl, m);
        g_tenv = tmpl.env_tenv;
        ps = push_type(ps, variadic_param_type(m, decl, j));
        g_tenv = null;
        j += 1;
        continue;
      }
    }
    if decl.tparams.n > 0 {
      let saved_env: *TypeMap = g_tenv;
      g_tenv = template_env_of(decl);
      ps = push_type(ps, variadic_param_type(m, decl, j));
      g_tenv = saved_env;
      j += 1;
      continue;
    }
    ps = push_type(ps, variadic_param_type(m, decl, j));
    j += 1;
  }
  let mut ret: *Type = null;
  if decl.tparams.n > 0 {
    let saved_env1: *TypeMap = g_tenv;
    g_tenv = template_env_of(decl);
    ret = resolve_type_in_module(m, decl.ret);
    g_tenv = saved_env1;
  } else {
    ret = resolve_type_in_module(m, decl.ret);
  }
  let ft: *Type = ty_fn(ps, ret);
  let mut tsym: *Sym = sm_get(m.syms, decl.name);
  if decl.is_method {
    tsym = sm_get(m.syms, cat3(decl.recv, cat3(".", decl.name, ""), ""));
  }
  if tsym != null {
    tsym.type = ft;
  }
}

// full semantic check of a parsed module; returns the diag count
// load one `use` target: read + parse + register syms; the caller checks it
fn load_use_module(user_path: string, rel: string) -> *Module {
  // relative to the user file's directory
  let mut dir: string = "";
  let mut i: usize = 0;
  let mut last: usize = 0;
  while i < len(user_path) {
    if user_path[i] == 47 { // '/'
      last = i;
    }
    i += 1;
  }
  if last > 0 {
    dir = user_path[0..last + 1];
  }
  let aux_path: string = cat3(dir, rel, ".rho");
  // cache by resolved path (boot: modules_by_path) — several `use` sites in
  // one compile must share one module instance
  if g_aux_modules != null {
    let mut ci: usize = 0;
    while ci < g_aux_modules.n {
      if streq(g_aux_modules.items[ci].path, aux_path) {
        return g_aux_modules.items[ci];
      }
      ci += 1;
    }
  }
  let r: Result[string, string] = read_file(aux_path);
  if r.is_err() {
    err_at(user_path, 1, 1, cat3("cannot read `", cat3(rel, ".rho`", ""), ""));
    return null;
  }
  let aux_root: *Decl = parse_file(aux_path, r.get_ok());
  if diag_count() > 0 {
    return null;
  }
  // ns = last path segment of the use
  let ns: string = rel;
  let aux: *Module = new Module {
    path: aux_path, ns: ns, root: aux_root, syms: sm_new(),
    is_prelude: false, checked: false,
  };
  check_module(aux);
  if g_aux_modules == null {
    g_aux_modules = new Vec[*Module] { items: make([]*Module, 8), n: 0 };
  }
  g_aux_modules.push(aux);
  return aux;
}

fn scope_decl_module(m: *Module) {
  // boot parity: module-level fns are NOT in the lexical scope — call/name
  // resolution falls back to the module table (lets named like fns, e.g.
  // `let at`, would otherwise false-positive as shadowing)
  let d: *Decl = m.root;
  let mut i: usize = 0;
  while i < d.decls.n {
    let decl: *Decl = d.decls.items[i];
    if decl.kind == DeclKind.DkFn || decl.kind == DeclKind.DkImpl {
      // impl blocks carry no module-scope name of their own (their methods
      // register under `Type.name`; the block's `name` is the trait's)
      i += 1;
      continue;
    }
    let sym: *Sym = sm_get(m.syms, decl.name);
    if sym != null {
      scope_decl(decl.name, sym);
    }
    i += 1;
  }
}

fn check_all(m: *Module) -> i32 {
  m.checked = true;
  cur_module = m;
  check_module(m);
  scope_push();
    scope_decl_module(m);
  // module symbols (`use mod_aux;`) into the top scope
  {
    let mut si: usize = 0;
    while si < m.syms.n {
      let ms: *Sym = m.syms.items[si].val;
      if ms.kind == SymKind.SyModule {
        scope_decl(m.syms.items[si].key, ms);
      }
      si += 1;
    }
  }
  let d: *Decl = m.root;
  // pass 1: resolve struct/enum types, wire methods
  let mut i: usize = 0;
  while i < d.decls.n {
    let decl: *Decl = d.decls.items[i];
    if decl.kind == DeclKind.DkStruct || decl.kind == DeclKind.DkEnum {
      let ssym: *Sym = sm_get(m.syms, decl.name);
      if ssym != null && ssym.type == null {
        if decl.tparams.n > 0 {
          let tmpl: *RecType = ensure_template(decl, m);
          let t: *Type = new Type {
            kind: TypeKind.TyStruct, elem: null, len: 0, rec: tmpl,
            params: fresh_type_vec2(), ret: null, mangled: tmpl.mangled,
          };
          if decl.kind == DeclKind.DkEnum {
            t.kind = TypeKind.TyEnum;
          }
          ssym.type = t;
        } else {
          ssym.type = named_type_simple(ssym, m);
        }
      }
    }
    if decl.kind == DeclKind.DkFn {
      if len(decl.recv) > 0 {
        wire_method(m, decl);
      }
    }
    if decl.kind == DeclKind.DkImpl {
      let mut ii: usize = 0;
      while ii < decl.decls.n {
        let md: *Decl = decl.decls.items[ii];
        if len(md.recv) > 0 {
          wire_method(m, md);
        }
        ii += 1;
      }
    }
    i += 1;
  }
  // pass 2a: resolve fn signatures (and templated flags) for every decl —
  // before any body checks, so calls see concrete templates
  i = 0;
  while i < d.decls.n {
    let decl: *Decl = d.decls.items[i];
    if decl.kind == DeclKind.DkFn {
      if len(decl.recv) > 0 {
        let mut rsym: *Sym = sm_get(m.syms, decl.recv);
        if rsym == null && prelude_module != null && prelude_module != m {
          rsym = sm_get(prelude_module.syms, decl.recv);
        }
        if rsym != null && rsym.decl.tparams.n > 0 {
          decl.templated = true;
        }
      }
      if decl.tparams.n > 0 {
        decl.templated = true;
      }
      let nparams0: usize = decl.params.n;
      let mut ps0: []*Type = fresh_type_vec2();
      let mut j0: usize = 0;
      while j0 < nparams0 {
        if len(decl.recv) > 0 {
          let mut rsym2: *Sym = sm_get(m.syms, decl.recv);
          if rsym2 == null && prelude_module != null && prelude_module != m {
            rsym2 = sm_get(prelude_module.syms, decl.recv);
          }
          if rsym2 != null && rsym2.decl.tparams.n > 0 {
            let tmpl0: *RecType = ensure_template(rsym2.decl, m);
            g_tenv = tmpl0.env_tenv;
            ps0 = push_type(ps0, variadic_param_type(m, decl, j0));
            g_tenv = null;
            j0 += 1;
            continue;
          }
        }
        if decl.tparams.n > 0 {
          let saved_env0: *TypeMap = g_tenv;
          g_tenv = template_env_of(decl);
          ps0 = push_type(ps0, variadic_param_type(m, decl, j0));
          g_tenv = saved_env0;
          j0 += 1;
          continue;
        }
        ps0 = push_type(ps0, variadic_param_type(m, decl, j0));
        j0 += 1;
      }
      let mut ret0: *Type = null;
      if decl.tparams.n > 0 {
        let saved_env1: *TypeMap = g_tenv;
        g_tenv = template_env_of(decl);
        ret0 = resolve_type_in_module(m, decl.ret);
        g_tenv = saved_env1;
      } else if len(decl.recv) > 0 {
        let mut rsym3: *Sym = sm_get(m.syms, decl.recv);
        if rsym3 == null && prelude_module != null && prelude_module != m {
          rsym3 = sm_get(prelude_module.syms, decl.recv);
        }
        if rsym3 != null && rsym3.decl.tparams.n > 0 {
          let tmpl1: *RecType = ensure_template(rsym3.decl, m);
          g_tenv = tmpl1.env_tenv;
          ret0 = resolve_type_in_module(m, decl.ret);
          g_tenv = null;
        } else {
          ret0 = resolve_type_in_module(m, decl.ret);
        }
      } else {
        ret0 = resolve_type_in_module(m, decl.ret);
      }
      let ft0: *Type = ty_fn(ps0, ret0);
      let mut tsym0: *Sym = sm_get(m.syms, decl.name);
      if decl.is_method {
        tsym0 = sm_get(m.syms, cat3(decl.recv, ".", decl.name));
      }
      if tsym0 != null {
        tsym0.type = ft0;
      }
    }
    if decl.kind == DeclKind.DkImpl {
      // an impl block's methods resolve through the same machinery
      let mut ii0: usize = 0;
      while ii0 < decl.decls.n {
        resolve_fn_signature(m, decl.decls.items[ii0]);
        ii0 += 1;
      }
    }
    if decl.kind == DeclKind.DkExtern {
      let esym: *Sym = sm_get(m.syms, decl.name);
      if esym != null && esym.type == null {
        let mut ps1: []*Type = fresh_type_vec2();
        let mut j1: usize = 0;
        while j1 < decl.params.n {
          ps1 = push_type(ps1, resolve_type_in_module(m, decl.params.items[j1].ty));
          j1 += 1;
        }
        esym.type = ty_fn(ps1, resolve_type_in_module(m, decl.ret));
      }
    }
    if decl.kind == DeclKind.DkStatic || decl.kind == DeclKind.DkConst {
      let ann: *Type = resolve_type_in_module(m, decl.ret);
      let ssym: *Sym = sm_get(m.syms, decl.name);
      if ssym != null {
        ssym.type = ann;
      }
      if decl.init != null {
        let v: *CV = const_eval(decl.init, m);
        if !v.ok {
          err_at(decl.file, decl.line, decl.col, cat3(decl.name, ": initializer must be a compile-time constant", ""));
        } else {
          decl.ceval_ok = true;
          decl.ceval_is_int = v.is_int;
          decl.ceval_i = v.i;
          decl.ceval_f = v.f;
        }
        decl.init.typed = ann;
      }
    }
    i += 1;
  }
  // trait carriers + impl eager satisfaction, once signatures exist (boot
  // resolves the whole sym table in phase 2; self's 2a is the equivalent)
  resolve_traits_and_impls(m);
  // pass 2b: check fn bodies (plain fns and methods alike; generics once)
  i = 0;
  while i < d.decls.n {
    let decl: *Decl = d.decls.items[i];
    if decl.kind == DeclKind.DkFn {
      // build the fn symbol's signature type on the fly (methods resolve
      // under the receiver type's template env)
      if len(decl.recv) > 0 {
        let mut rsym: *Sym = sm_get(m.syms, decl.recv);
        if rsym == null && prelude_module != null && prelude_module != m {
          rsym = sm_get(prelude_module.syms, decl.recv);
        }
        if rsym != null && rsym.decl.tparams.n > 0 {
          let tmpl: *RecType = ensure_template(rsym.decl, m);
          g_tenv = tmpl.env_tenv;
          decl.templated = true;
        }
      }
      if decl.tparams.n > 0 {
        g_tenv = template_env_of(decl);
        decl.templated = true;
      }
      let mut tsym: *Sym = sm_get(m.syms, decl.name);
      if decl.is_method {
        tsym = sm_get(m.syms, cat3(decl.recv, ".", decl.name));
      }
      let mut ft: *Type = null;
      if tsym != null && tsym.type != null {
        // pass 2a resolved the signature already; re-resolving would
        // re-emit diagnostics for names that failed to resolve
        ft = tsym.type;
      } else {
        let nparams: usize = decl.params.n;
        let mut ps: []*Type = fresh_type_vec2();
        let mut j: usize = 0;
        while j < nparams {
          ps = push_type(ps, variadic_param_type(m, decl, j));
          j += 1;
        }
        ft = ty_fn(ps, resolve_type_in_module(m, decl.ret));
        if tsym != null {
          tsym.type = ft;
        }
      }
      g_tenv = null;
      let fsym: *Sym = new Sym {
        kind: SymKind.SyFn, name: decl.name, type: ft, decl: decl,
        mutable: false, variant_index: 0, local_id: 0, symbol: "",
    owner: cur_module,
    module: null,
      trait_rec: null,
      };
      cur_fn_sym = fsym;
      // generic templates are checked per instantiation, never directly
      if !decl.templated {
        check_fn_body(decl, fsym, m);
      }
    }
    if decl.kind == DeclKind.DkExtern {
      // resolve the extern signature into its symbol
      let esym: *Sym = sm_get(m.syms, decl.name);
      if esym != null && esym.type == null {
        let mut ps: []*Type = fresh_type_vec2();
        let mut j: usize = 0;
        while j < decl.params.n {
          ps = push_type(ps, resolve_type_in_module(m, decl.params.items[j].ty));
          j += 1;
        }
        esym.type = ty_fn(ps, resolve_type_in_module(m, decl.ret));
      }
    }
    if decl.kind == DeclKind.DkStatic || decl.kind == DeclKind.DkConst {
      let ann: *Type = resolve_type_in_module(m, decl.ret);
      let ssym: *Sym = sm_get(m.syms, decl.name);
      if ssym != null {
        ssym.type = ann;
      }
      if decl.init != null {
        let v: *CV = const_eval(decl.init, m);
        if !v.ok {
          err_at(decl.file, decl.line, decl.col, cat3(decl.name, ": initializer must be a compile-time constant", ""));
        } else {
          decl.ceval_ok = true;
          decl.ceval_is_int = v.is_int;
          decl.ceval_i = v.i;
          decl.ceval_f = v.f;
        }
        decl.init.typed = ann;
      }
    }
    i += 1;
  }
  // impl-block method bodies (boot phase 3 catches them through the sym
  // table; self's passes are decl-driven, so walk the impl decls here)
  i = 0;
  while i < d.decls.n {
    let decl: *Decl = d.decls.items[i];
    if decl.kind == DeclKind.DkImpl {
      let mut ii: usize = 0;
      while ii < decl.decls.n {
        let md: *Decl = decl.decls.items[ii];
        if !md.templated {
          let msym: *Sym = sm_get(m.syms, cat3(md.recv, cat3(".", md.name, ""), ""));
          if msym != null {
            let fsym: *Sym = new Sym {
              kind: SymKind.SyFn, name: md.name, type: msym.type, decl: md,
              mutable: false, variant_index: 0, local_id: 0, symbol: "",
              owner: cur_module, module: null, trait_rec: null,
            };
            cur_fn_sym = fsym;
            check_fn_body(md, fsym, m);
          }
        }
        ii += 1;
      }
    }
    i += 1;
  }
  // instantiation worklist: each clone's body re-checked under its concrete
  // environment; checking may discover further instantiations, so the loop
  // runs until the queue settles
  if g_instantiations != null {
    let mut wl: usize = 0;
    while wl < g_instantiations.n {
      let isym: *Sym = g_instantiations.items[wl];
      wl += 1;
      let saved_env: *TypeMap = g_tenv;
      g_tenv = isym.decl.tenv;
      cur_fn_sym = isym;
      // bounds: each `[T: Trait]` is verified against the concrete type this
      // clone was instantiated with, anchored at the instantiation
      if isym.decl.tparam_bounds != null {
        let cd: *Decl = isym.decl;
        let mut bi: usize = 0;
        while bi < cd.tparams.n && bi < cd.tparam_bounds.n {
          let ba: *TypeAst = cd.tparam_bounds.items[bi];
          if ba == null {
            bi += 1;
            continue;
          }
          // a bound is written as the bare trait name — resolve it as a
          // trait, not through the general type path
          let mut tr: *RecType = null;
          if ba.kind == TypeAstKind.TaNamed && ba.path.n == 1 {
            let bname: string = ba.path.items[0];
            let mut tsym: *Sym = sm_get(m.syms, bname);
            if tsym == null && prelude_module != null && prelude_module != m {
              tsym = sm_get(prelude_module.syms, bname);
            }
            if tsym != null && tsym.kind == SymKind.SyTrait {
              tr = tsym.trait_rec;
            }
          } else if ba.kind == TypeAstKind.TaDyn {
            let bname: string = ba.path.items[ba.path.n - 1];
            let mut tsym: *Sym = sm_get(m.syms, bname);
            if tsym == null && prelude_module != null && prelude_module != m {
              tsym = sm_get(prelude_module.syms, bname);
            }
            if tsym != null && tsym.kind == SymKind.SyTrait {
              tr = tsym.trait_rec;
            }
          }
          if tr == null {
            bi += 1;
            continue;
          }
          let conc: *Type = tm_get(g_tenv, cd.tparams.items[bi]);
          if conc == null || conc.kind == TypeKind.TyParam {
            bi += 1;
            continue;
          }
          if !trait_satisfied(tr, conc) {
            let m1: string = cat("` does not implement `", tr.mangled);
            let m2: string = cat(m1, "` (bound at instantiation): missing or mismatched `");
            let msg: string = cat(cat("`", cat(ty_name(conc), m2)), cat3(tr.methods[g_missing_idx as usize].name, "`", ""));
            err_at(cd.file, cd.line, cd.col, msg);
          }
          bi += 1;
        }
      }
      check_fn_body(isym.decl, isym, m);
      g_tenv = saved_env;
    }
  }
  scope_pop();
  return diag_count();
}


// ============== if-expressions (check.c port L6f-b) =======================

fn check_block_value2(stmts: *Vec[*Stmt]) -> *Type {
  scope_push();
  let mut result: *Type = ty_prim(14);
  let mut i: usize = 0;
  while i < stmts.n {
    let s: *Stmt = stmts.items[i];
    if i + 1 == stmts.n && s.kind == StmtKind.StExpr && s.tail {
      result = check_expr(s.a, null);
    } else {
      check_stmt(s);
    }
    i += 1;
  }
  scope_pop();
  return result;
}

// store the qmark family fields (kept in one place; the two consecutive
// scalar stores through the pointer confuse no one)
fn expr_set_q(e: *Expr, ok: i32, err: i32) {
  e.q_ok = ok;
  e.q_err = err;
}

fn is_panic_call(e: *Expr) -> bool {
  if e == null || e.kind != ExprKind.ExCall || e.a == null || e.a.sym == null {
    return false;
  }
  let s: *Sym = e.a.sym;
  if !streq(s.name, "panic") || s.owner == null {
    return false;
  }
  return s.owner == prelude_module || s.owner.is_prelude;
}

fn unify2(a: *Type, b: *Type, at: *Expr) -> *Type {
  if a == null || a.kind == TypeKind.TyErr {
    return b;
  }
  if b == null || b.kind == TypeKind.TyErr {
    return a;
  }
  // panic never returns: its arm coerces to the other branch's type
  if a.kind == TypeKind.TyVoid && b.kind != TypeKind.TyVoid && is_panic_call(at) {
    return b;
  }
  if b.kind == TypeKind.TyVoid && a.kind != TypeKind.TyVoid && is_panic_call(at) {
    return a;
  }
  if a != null && a.kind == TypeKind.TyParam {
    return b;
  }
  if b != null && b.kind == TypeKind.TyParam {
    return a;
  }
  if a.kind == TypeKind.TyErr {
    return b;
  }
  if b.kind == TypeKind.TyErr {
    return a;
  }
  // untyped literals adapt to the other side's type
  let u: *Type = adapt_literal(a, b);
  let v: *Type = adapt_literal(b, a);
  if u.kind == TypeKind.TyVoid && v.kind == TypeKind.TyVoid {
    return u;
  }
  if types_compatible(u, v) {
    return u;
  }
  err_at(at.file, at.line, at.col, cat5("branches have different types: `", ty_name(a), "` vs `", ty_name(b), "`"));
  return ty_err();
}

fn check_if_expr(e: *Expr, expected: *Type) -> *Type {
  let cond: *Type = check_expr(e.a, null);
  if cond.kind != TypeKind.TyBool {
    err_at(e.a.file, e.a.line, e.a.col, cat3("if condition must be bool, found `", ty_name(cond), "`"));
  }
  let then_blk: *Stmt = e.items.items[0];
  let t: *Type = check_block_value2(then_blk.stmts);
  let mut result: *Type = ty_prim(14);
  if e.else_if != null {
    let et: *Type = check_expr(e.else_if, if expected != null { expected } else { t });
    result = unify2(t, et, e.else_if);
  } else if e.items.n > 1 {
    let else_blk: *Stmt = e.items.items[1];
    let et: *Type = check_block_value2(else_blk.stmts);
    result = unify2(t, et, e);
  }
  e.typed = result;
  return result;
}


// ================= IR structures (lower.c port LOW-1) ======================

enum IRType {
  ItI8, ItI16, ItI32, ItI64,
  ItU8, ItU16, ItU32, ItU64, ItUsize,
  ItF32, ItF64,
  ItPtr,
}

struct IRSlot {
  id: i32,
  size: i64,
  align: i64,
  name: string,
}

struct IRVreg {
  id: i32,
  ty: IRType,
}

enum IROp {
  IrConst, IrFconst,
  IrAdd, IrSub, IrMul, IrDiv, IrMod, IrAnd, IrOr, IrXor, IrShl, IrShr,
  IrCmp,
  IrLoad,
  IrStore,
  IrAddrc,
  IrAddi,
  IrCall,
  IrCast,
  IrCopymem,
  IrZero,
  IrLitaddr,
  IrMemsize,
  IrMemgrow,
}

enum IRCC { CcEq, CcNe, CcLt, CcLe, CcGt, CcGe }

enum IRCastKind {
  CastTrunc, CastSext, CastZext, CastI2f, CastF2i, CastF32F64,
  CastF64F32, CastBitcopy, CastReinterp,
}

struct IRArg {
  vreg: *IRVreg,
}

struct IRPhi {
  dst: *IRVreg,
  args: []*IRVreg,
  preds: []*IRBlock,
}

struct IRIns {
  op: IROp,
  dst: *IRVreg,
  a: *IRVreg,
  b: *IRVreg,
  slot: *IRSlot,
  imm: i64,
  fimm: f64,
  size: i64,
  is_float: bool,
  signed_ops: bool,
  cc: IRCC,
  cast: IRCastKind,
  cast_from: IRType,
  cast_to: IRType,
  callee: string,
  callee_vreg: *IRVreg,
  args: []*IRVreg,
  addr: *IRVreg,
  lit: i32,
  join_hint: *IRBlock,
}

struct IRBlock {
  id: i32,
  phis: []*IRPhi,
  ins: []*IRIns,
  term_op: i32,      // 0 = none, 100 = br, 101 = cbr, 102 = ret
  br_true: *IRBlock,
  br_false: *IRBlock,
  ret_val: *IRVreg,
  cbr_cond: *IRVreg,
  join_hint: *IRBlock,
  loop_header: bool,
  loop_exit: *IRBlock,
  emitted: bool,     // wasm: control-flow re-nesting marks blocks as it goes
}

struct IRLit {
  label: string,
  bytes: []u8,
}

struct IRFn {
  uid: i32,
  symbol: string,
  ret_is_void: bool,
  ret: *Type,            // null for synthesized (rc) helpers
  returns_aggregate: bool,
  params: []*IRSlot,
  param_types: []*Type,  // parallel to params (null = opaque machine word)
  out_slot: *IRSlot,
  slots: []*IRSlot,
  blocks: []*IRBlock,
  entry: *IRBlock,
  cur: *IRBlock,
  literals: []*IRLit,
  next_vreg: i32,
  next_block: i32,
  next_slot: i32,
  vreg_base: i32, // vreg slot offset base = named slot count at layout
}

static mut g_ir_fns: *Vec[*IRFn] = 0 as *Vec[*IRFn];
static mut g_ir_uid: i32 = 0;

struct IRGlobal {
  symbol: string,
  size: i64,
  align: i64,
  init: []u8,        // empty => zero-initialized
  relocs: []string,  // per-8-byte-word relocation labels ("" = none)
  static_lit: *IRLit, // static string literal block (null = none)
  is_extern: bool,
}

static mut g_ir_globals: *Vec[*IRGlobal] = 0 as *Vec[*IRGlobal];
static mut g_main_cell: *Vec[string] = 0 as *Vec[string]; // [main symbol]
static mut g_root_module: *Module = 0 as *Module;
static mut g_panic_site: i32 = 0;
static mut g_lit_counter: i32 = 0;
static mut g_closure_counter: i32 = 0;
static mut g_eq_fns: *TypeMap2 = 0 as *TypeMap2;

fn ir_size_of(t: IRType) -> i64 {
  if t == IRType.ItI8 || t == IRType.ItU8 { return 1; }
  if t == IRType.ItI16 || t == IRType.ItU16 { return 2; }
  if t == IRType.ItI32 || t == IRType.ItU32 || t == IRType.ItF32 { return 4; }
  return 8;
}

fn ir_is_float_t(t: IRType) -> bool {
  return t == IRType.ItF32 || t == IRType.ItF64;
}


// ================= lowering context & builders (LOW-2) =====================

struct OwnedBind { slot: *IRSlot, ty: *Type }
struct BindEnt { name: string, slot: *IRSlot, next: *BindEnt }
struct LScope {
  bindings: *BindEnt,
  owned: []*OwnedBind,
  defers: []*Stmt,
  parent: *LScope,
  break_to: *IRBlock,
  continue_to: *IRBlock,
  is_loop: bool,
}
struct LCtx {
  f: *IRFn,
  scope: *LScope,
}

fn rc_new_fn(symbol: string) -> *IRFn {
  let f: *IRFn = new IRFn {
    uid: 0, symbol: symbol, ret_is_void: true, ret: null,
    returns_aggregate: false, params: make([]*IRSlot, 0),
    param_types: fresh_type_vec2(),
    out_slot: null, slots: make([]*IRSlot, 0), blocks: make([]*IRBlock, 0),
    entry: null, cur: null, literals: make([]*IRLit, 0),
    next_vreg: 0, next_block: 0, next_slot: 0, vreg_base: 0,
  };
  let cc: *LCtx = rc_ctx(f);
  f.entry = new_block(cc);
  use_block(cc, f.entry);
  return f;
}

fn push_islot(items: []*IRSlot, s: *IRSlot) -> []*IRSlot {
  let out: []*IRSlot = make([]*IRSlot, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = s;
  return out;
}

fn rc_ctx(f: *IRFn) -> *LCtx {
  let c: *LCtx = new LCtx { f: f, scope: null };
  return c;
}

fn new_block(c: *LCtx) -> *IRBlock {
  let b: *IRBlock = new IRBlock {
    id: c.f.next_block, phis: make([]*IRPhi, 0), ins: make([]*IRIns, 0),
    term_op: 0, br_true: null, br_false: null, ret_val: null,
    cbr_cond: null, join_hint: null, loop_header: false, loop_exit: null,
    emitted: false,
  };
  c.f.next_block += 1;
  c.f.blocks = push_ptr(c.f.blocks, b);
  return b;
}

fn push_ptr(items: []*IRBlock, b: *IRBlock) -> []*IRBlock {
  let out: []*IRBlock = make([]*IRBlock, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = b;
  return out;
}

fn use_block(c: *LCtx, b: *IRBlock) {
  c.f.cur = b;
}

fn emit(c: *LCtx, op: IROp) -> *IRIns {
  let i: *IRIns = new IRIns {
    op: op, dst: null, a: null, b: null, slot: null, imm: 0, fimm: 0.0,
    size: 0, is_float: false, signed_ops: true, cc: IRCC.CcEq,
    cast: IRCastKind.CastBitcopy, cast_from: IRType.ItPtr,
    cast_to: IRType.ItPtr, callee: "", callee_vreg: null,
    args: make([]*IRVreg, 0), addr: null, lit: 0, join_hint: null,
  };
  c.f.cur.ins = push_ins(c.f.cur.ins, i);
  return i;
}

fn push_ins(items: []*IRIns, i: *IRIns) -> []*IRIns {
  let out: []*IRIns = make([]*IRIns, len(items) + 1);
  let mut k: usize = 0;
  while k < len(items) {
    out[k] = items[k];
    k += 1;
  }
  out[len(items)] = i;
  return out;
}

fn new_vreg(c: *LCtx, ty: IRType) -> *IRVreg {
  let v: *IRVreg = new IRVreg { id: c.f.next_vreg, ty: ty };
  c.f.next_vreg += 1;
  return v;
}

fn new_slot(c: *LCtx, size: i64, align: i64, name: string) -> *IRSlot {
  // scalars get 8-byte slots: the register spill stores full 64-bit slots
  // and narrower accesses simply use the low bytes
  let mut sz: i64 = size;
  if sz == 0 {
    sz = 8;
  }
  if sz < 8 {
    sz = 8;
  }
  let mut al: i64 = align;
  if al == 0 {
    al = 8;
  }
  let s: *IRSlot = new IRSlot { id: c.f.next_slot, size: sz, align: al, name: name };
  c.f.next_slot += 1;
  c.f.slots = push_slot(c.f.slots, s);
  return s;
}

fn push_slot(items: []*IRSlot, s: *IRSlot) -> []*IRSlot {
  let out: []*IRSlot = make([]*IRSlot, len(items) + 1);
  let mut k: usize = 0;
  while k < len(items) {
    out[k] = items[k];
    k += 1;
  }
  out[len(items)] = s;
  return out;
}

fn v_slotaddr(c: *LCtx, s: *IRSlot) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, IRType.ItPtr);
  let i: *IRIns = emit(c, IROp.IrAddrc);
  i.dst = v;
  i.slot = s;
  return v;
}

fn v_const(c: *LCtx, val: i64, ty: IRType) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, ty);
  let i: *IRIns = emit(c, IROp.IrConst);
  i.dst = v;
  i.imm = val;
  return v;
}

fn v_load(c: *LCtx, addr: *IRVreg, ty: IRType) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, ty);
  let i: *IRIns = emit(c, IROp.IrLoad);
  i.dst = v;
  i.addr = addr;
  i.size = ir_size_of(ty);
  i.is_float = ir_is_float_t(ty);
  return v;
}

fn v_store(c: *LCtx, addr: *IRVreg, val: *IRVreg) {
  let i: *IRIns = emit(c, IROp.IrStore);
  i.addr = addr;
  i.a = val;
  i.size = ir_size_of(val.ty);
  i.is_float = ir_is_float_t(val.ty);
}

fn v_addi(c: *LCtx, a: *IRVreg, imm: i64) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, IRType.ItPtr);
  let i: *IRIns = emit(c, IROp.IrAddi);
  i.dst = v;
  i.a = a;
  i.imm = imm;
  return v;
}

fn v_binop(c: *LCtx, op: IROp, a: *IRVreg, b: *IRVreg, ty: IRType, signed_ops: bool) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, ty);
  let i: *IRIns = emit(c, op);
  i.dst = v;
  i.a = a;
  i.b = b;
  i.is_float = ir_is_float_t(ty);
  i.signed_ops = signed_ops;
  return v;
}

fn v_cmp(c: *LCtx, cc: IRCC, a: *IRVreg, b: *IRVreg, is_float: bool) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, IRType.ItU8);
  let i: *IRIns = emit(c, IROp.IrCmp);
  i.dst = v;
  i.a = a;
  i.b = b;
  i.cc = cc;
  i.is_float = is_float;
  // signedness follows the operand: usize/u64 counters with the top bit
  // set must compare unsigned
  i.signed_ops = ty_is_signed_int(a.ty);
  return v;
}

// unsigned >= : rc plausibility guards compare counts, not signs
fn v_cmp_uge(c: *LCtx, a: *IRVreg, b: *IRVreg) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, IRType.ItU8);
  let i: *IRIns = emit(c, IROp.IrCmp);
  i.dst = v;
  i.a = a;
  i.b = b;
  i.cc = IRCC.CcGe;
  i.is_float = false;
  i.signed_ops = false;
  return v;
}

fn emit_br(c: *LCtx, to: *IRBlock) {
  let b: *IRBlock = c.f.cur;
  b.term_op = 100;
  b.br_true = to;
}

fn emit_cbr(c: *LCtx, cond: *IRVreg, tt: *IRBlock, ff: *IRBlock, join: *IRBlock) {
  let b: *IRBlock = c.f.cur;
  b.term_op = 101;
  b.cbr_cond = cond;
  b.br_true = tt;
  b.br_false = ff;
  b.join_hint = join;
}

fn emit_ret(c: *LCtx, v: *IRVreg) {
  let b: *IRBlock = c.f.cur;
  b.term_op = 102;
  b.ret_val = v;
}


// ================= expression lowering (LOW-3) =============================

fn fconst(c: *LCtx, v: f64, ty: IRType) -> *IRVreg {
  let d: *IRVreg = new_vreg(c, ty);
  let i: *IRIns = emit(c, IROp.IrFconst);
  i.dst = d;
  i.fimm = v;
  return d;
}

fn rc_call1(c: *LCtx, helper: string, arg: *IRVreg) {
  let i: *IRIns = emit(c, IROp.IrCall);
  i.callee = helper;
  let a: *IRVreg = arg;
  i.args = push_vreg(i.args, a);
}

fn push_vreg(items: []*IRVreg, v: *IRVreg) -> []*IRVreg {
  let out: []*IRVreg = make([]*IRVreg, len(items) + 1);
  let mut k: usize = 0;
  while k < len(items) {
    out[k] = items[k];
    k += 1;
  }
  out[len(items)] = v;
  return out;
}

fn rc_inc_v(c: *LCtx, p: *IRVreg) { rc_call1(c, "rho__rc_inc", p); }
fn rc_dec_v(c: *LCtx, p: *IRVreg) { rc_call1(c, "rho__rc_dec", p); }

// bind a name to a slot in the current scope
fn lbind(c: *LCtx, name: string, slot: *IRSlot) {
  let b: *BindEnt = new BindEnt { name: name, slot: slot, next: c.scope.bindings };
  c.scope.bindings = b;
}

fn lookup_slot(c: *LCtx, name: string) -> *IRSlot {
  let mut s: *LScope = c.scope;
  while s != null {
    let mut b: *BindEnt = s.bindings;
    while b != null {
      if streq(b.name, name) {
        return b.slot;
      }
      b = b.next;
    }
    s = s.parent;
  }
  return null;
}

// address of a name binding (slot address)
fn addr_of_name(c: *LCtx, name: string) -> *IRVreg {
  let slot: *IRSlot = lookup_slot(c, name);
  if slot == null {
    return null;
  }
  return v_slotaddr(c, slot);
}


// ================= scope/ownership (LOW-4) =================================

fn own_slot(c: *LCtx, slot: *IRSlot, t: *Type) {
  let ob: *OwnedBind = new OwnedBind { slot: slot, ty: t };
  c.scope.owned = push_owned(c.scope.owned, ob);
}

fn push_owned(items: []*OwnedBind, ob: *OwnedBind) -> []*OwnedBind {
  let out: []*OwnedBind = make([]*OwnedBind, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = ob;
  return out;
}

fn release_addr(c: *LCtx, t: *Type, addr: *IRVreg) {
  let fnn: string = value_fn_for(t, false);
  if fnn != "" {
    rc_call1(c, fnn, addr);
  }
}

fn retain_addr(c: *LCtx, t: *Type, addr: *IRVreg) {
  let fnn: string = value_fn_for(t, true);
  if fnn != "" {
    rc_call1(c, fnn, addr);
  }
}

fn release_scope_only(c: *LCtx) {
  let owned: []*OwnedBind = c.scope.owned;
  let mut k: usize = len(owned);
  while k > 0 {
    let ob: *OwnedBind = owned[k - 1];
    release_addr(c, ob.ty, v_slotaddr(c, ob.slot));
    k -= 1;
  }
}

fn scope_pop_release(c: *LCtx) {
  release_scope_only(c);
  c.scope = c.scope.parent;
}

fn owned_empty() -> []*OwnedBind {
  return make([]*OwnedBind, 0);
}

fn scope_push_l(c: *LCtx) {
  let s: *LScope = new LScope {
    bindings: null, owned: owned_empty(), defers: make([]*Stmt, 0),
    parent: c.scope,
    break_to: null, continue_to: null, is_loop: false,
  };
  c.scope = s;
}


// ================= glue synthesis (LOW-5) ==================================

struct TypeEnt2 { key: string, val: string }
struct TypeMap2 { items: []*TypeEnt2, n: usize }

fn tm2_new() -> *TypeMap2 {
  return new TypeMap2 { items: make([]*TypeEnt2, 4096), n: 0 };
}

static mut g_rel_fns: *TypeMap2 = 0 as *TypeMap2;
static mut g_ret_fns: *TypeMap2 = 0 as *TypeMap2;

fn ty_is_managed(t: *Type) -> bool {
  if t == null {
    return false;
  }
  // raw byte pointers carry no rc header; a pointer is reference-counted
  // exactly when it points at a `new` object
  if t.kind == TypeKind.TyPtr {
    return t.elem != null &&
           (t.elem.kind == TypeKind.TyStruct || t.elem.kind == TypeKind.TyEnum);
  }
  if t.kind == TypeKind.TyWeak || t.kind == TypeKind.TySlice ||
     t.kind == TypeKind.TyStringK || t.kind == TypeKind.TyFn ||
     t.kind == TypeKind.TyDyn {
    return true;
  }
  if t.kind == TypeKind.TyArray {
    return ty_is_managed(t.elem);
  }
  if t.kind == TypeKind.TyStruct {
    struct_field_type(t.rec, 0);
    let mut i: usize = 0;
    while i < len(t.rec.field_types) {
      if ty_is_managed(t.rec.field_types[i]) {
        return true;
      }
      i += 1;
    }
    return false;
  }
  if t.kind == TypeKind.TyEnum {
    let d: *Decl = t.rec.decl;
    let mut i: usize = 0;
    while i < d.variants.n {
      let v: *VariantAst = d.variants.items[i];
      if v.vkind != VarKind.VarUnit {
        return true;
      }
      i += 1;
    }
    return false;
  }
  return false;
}

fn rho_sanitize(s: string) -> string {
  let out: []u8 = make([]u8, len(s));
  let mut i: usize = 0;
  while i < len(s) {
    let ch: u8 = s[i];
    let ok: bool = (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) ||
                   (ch >= 48 && ch <= 57) || ch == 95;
    if ok {
      out[i] = ch;
    } else {
      out[i] = 95;
    }
    i += 1;
  }
  return intrinsics.slice_string(out);
}

fn tm2_get(m: *TypeMap2, key: string) -> string {
  let mut i: usize = 0;
  while i < m.n {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return "";
}

fn tm2_put(m: *TypeMap2, key: string, val: string) {
  let e: *TypeEnt2 = new TypeEnt2 { key: key, val: val };
  m.items[m.n] = e;
  m.n += 1;
}

// lazily synthesize rho__rel$<t> / rho__ret$<t>: walk the value of type t at
// the sole pointer parameter. Returns "" for unmanaged types.
fn value_fn_for(t: *Type, retain: bool) -> string {
  if t == null || !ty_is_managed(t) {
    return "";
  }
  let mut cache: *TypeMap2 = rel_cache();
  if retain {
    cache = ret_cache();
  }
  let found: string = tm2_get(cache, t.mangled);
  if found != "" {
    return found;
  }
  // kind prefix keeps the symbol unique: `[]*T` and `*[]T` would sanitize
  // to the same name
  let mut kindp: string = "x_";
  if t.kind == TypeKind.TyPtr { kindp = "p_"; }
  if t.kind == TypeKind.TySlice { kindp = "s_"; }
  if t.kind == TypeKind.TyStringK { kindp = "g_"; }
  if t.kind == TypeKind.TyArray { kindp = "a_"; }
  if t.kind == TypeKind.TyEnum { kindp = "e_"; }
  if t.kind == TypeKind.TyStruct { kindp = "r_"; }
  if t.kind == TypeKind.TyFn { kindp = "f_"; }
  if t.kind == TypeKind.TyWeak { kindp = "w_"; }
  if t.kind == TypeKind.TyDyn { kindp = "y_"; }
  let sym: string = cat3("rho__", cat3(retain_which(retain), cat3("$", kindp, ""), ""),
                         rho_sanitize(t.mangled));
  tm2_put(cache, t.mangled, sym);
  // synthesize the walker body
  let lf: *IRFn = rc_new_fn(sym);
  let c: *LCtx = rc_ctx(lf);
  let as_: *IRSlot = new_slot(c, 8, 8, "addr");
  lf.params = push_islot(lf.params, as_);
  let addr: *IRVreg = v_load(c, v_slotaddr(c, as_), IRType.ItPtr);
  value_walk(c, t, addr, retain);
  finish_fn_c(c);
  return sym;
}

// close a synthesized fn: seal with a void return when still open, register
// it in the program's fn list
fn finish_fn_c(c: *LCtx) {
  let b: *IRBlock = c.f.cur;
  if b.term_op == 0 {
    emit_ret(c, null);
  }
  if g_ir_fns == null {
    g_ir_fns = new Vec[*IRFn] { items: make([]*IRFn, 256), n: 0 };
  }
  g_ir_fns.push(c.f);
}

fn value_walk(c: *LCtx, t: *Type, addr: *IRVreg, retain: bool) {
  if t == null {
    return;
  }
  if t.kind == TypeKind.TyPtr {
    let p: *IRVreg = v_load(c, addr, IRType.ItPtr);
    if retain {
      rc_inc_v(c, p);
    } else {
      rc_dec_v(c, p);
    }
    return;
  }
  if t.kind == TypeKind.TyWeak {
    let h: *IRVreg = v_load(c, addr, IRType.ItPtr);
    if retain {
      rc_call1(c, "rho__rc_winc", h);
    } else {
      rc_call1(c, "rho__rc_wdec", h);
    }
    return;
  }
  if t.kind == TypeKind.TyFn {
    let e2: *IRVreg = v_load(c, v_addi(c, addr, 8), IRType.ItPtr);
    if retain {
      rc_inc_v(c, e2);
    } else {
      rc_dec_v(c, e2);
    }
    return;
  }
  if t.kind == TypeKind.TyDyn {
    // the object's RC header carries its own drop glue — plain count ops
    let o: *IRVreg = v_load(c, v_addi(c, addr, 8), IRType.ItPtr);
    if retain {
      rc_inc_v(c, o);
    } else {
      rc_dec_v(c, o);
    }
    return;
  }
  if t.kind == TypeKind.TySlice || t.kind == TypeKind.TyStringK {
    if t.kind == TypeKind.TySlice && ty_is_managed(t.elem) {
      // walk elements: buf at +8, elem stride at +8, count at +16
      let ptr: *IRVreg = v_load(c, v_addi(c, addr, 8), IRType.ItPtr);
      let n: *IRVreg = v_load(c, v_addi(c, addr, 16), IRType.ItUsize);
      let esz: i64 = type_size(t.elem);
      let islot: *IRSlot = new_slot(c, 8, 8, "i");
      v_store(c, v_slotaddr(c, islot), v_const(c, 0, IRType.ItUsize));
      let hdr: *IRBlock = new_block(c);
      let bodyb: *IRBlock = new_block(c);
      let done: *IRBlock = new_block(c);
      emit_br(c, hdr);
      use_block(c, hdr);
      let i: *IRVreg = v_load(c, v_slotaddr(c, islot), IRType.ItUsize);
      let more: *IRVreg = v_cmp(c, IRCC.CcLt, i, n, false);
      emit_cbr(c, more, bodyb, done, done);
      use_block(c, bodyb);
      let scaled: *IRVreg = v_binop(c, IROp.IrMul, i, v_const(c, esz, IRType.ItUsize), IRType.ItUsize, false);
      let ep: *IRVreg = v_binop(c, IROp.IrAdd, ptr, scaled, IRType.ItPtr, false);
      let efnn: string = value_fn_for(t.elem, retain);
      if efnn != "" {
        rc_call1(c, efnn, ep);
      }
      let i2: *IRVreg = v_binop(c, IROp.IrAdd, i, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
      v_store(c, v_slotaddr(c, islot), i2);
      emit_br(c, hdr);
      use_block(c, done);
    }
    let buf: *IRVreg = v_load(c, addr, IRType.ItPtr);
    if retain {
      rc_call1(c, "rho__rc_inch", buf);
    } else {
      rc_call1(c, "rho__rc_dech", buf);
    }
    return;
  }
  if t.kind == TypeKind.TyArray {
    if !ty_is_managed(t.elem) {
      return;
    }
    let esz: i64 = type_size(t.elem);
    let mut i: u64 = 0;
    while i < t.len {
      let efnn: string = value_fn_for(t.elem, retain);
      if efnn != "" {
        rc_call1(c, efnn, v_addi(c, addr, (esz * i as i64)));
      }
      i += 1;
    }
    return;
  }
  if t.kind == TypeKind.TyStruct {
    let rec: *RecType = t.rec;
    let dcl: *Decl = rec.decl;
    let mut i: usize = 0;
    while i < dcl.fields.n {
      let off: i64 = struct_field_offset(rec, i);
      let ft: *Type = struct_field_type(rec, i);
      if ty_is_managed(ft) {
        let efnn: string = value_fn_for(ft, retain);
        if efnn != "" {
          rc_call1(c, efnn, v_addi(c, addr, off));
        }
      }
      i += 1;
    }
    return;
  }
  if t.kind == TypeKind.TyEnum {
    let dcl: *Decl = t.rec.decl;
    let tag: *IRVreg = v_load(c, addr, IRType.ItI32);
    let done: *IRBlock = new_block(c);
    let mut any: bool = false;
    let mut vi: usize = 0;
    while vi < dcl.variants.n {
      let v: *VariantAst = dcl.variants.items[vi];
      let mut nf: usize = 0;
      if v.vkind == VarKind.VarTuple {
        nf = v.types.n;
      } else if v.vkind == VarKind.VarStruct {
        nf = v.fields.n;
      }
      let mut managed: bool = false;
      let mut chk: usize = 0;
      while chk < nf && !managed {
        managed = ty_is_managed(variant_field_type(t, vi as i32, chk as i32));
        chk += 1;
      }
      if !managed {
        vi += 1;
        continue;
      }
      let body: *IRBlock = new_block(c);
      let next: *IRBlock = new_block(c);
      let is: *IRVreg = v_cmp(c, IRCC.CcEq, tag, v_const(c, v.disc as i64, IRType.ItI32), false);
      emit_cbr(c, is, body, next, done);
      use_block(c, body);
      let mut fi: usize = 0;
      while fi < nf {
        let ft: *Type = variant_field_type(t, vi as i32, fi as i32);
        if ty_is_managed(ft) {
          let off: i64 = variant_field_offset(t, vi as i32, fi as i32);
          let efnn: string = value_fn_for(ft, retain);
          if efnn != "" {
            rc_call1(c, efnn, v_addi(c, addr, off));
          }
        }
        fi += 1;
      }
      emit_br(c, done);
      use_block(c, next);
      any = true;
      vi += 1;
    }
    if any {
      emit_br(c, done);
      use_block(c, done);
    }
    return;
  }
}

fn retain_which(retain: bool) -> string {
  if retain {
    return "ret";
  }
  return "rel";
}


fn ret_cache() -> *TypeMap2 {
  if g_ret_fns == null {
    g_ret_fns = tm2_new();
  }
  return g_ret_fns;
}

fn rel_cache() -> *TypeMap2 {
  if g_rel_fns == null {
    g_rel_fns = tm2_new();
  }
  return g_rel_fns;
}


fn elem_size(t: *Type) -> i64 {
  if t == null {
    return 8;
  }
  if t.kind == TypeKind.TyI8 || t.kind == TypeKind.TyU8 || t.kind == TypeKind.TyBool {
    return 1;
  }
  if t.kind == TypeKind.TyI16 || t.kind == TypeKind.TyU16 {
    return 2;
  }
  if t.kind == TypeKind.TyI32 || t.kind == TypeKind.TyU32 || t.kind == TypeKind.TyF32 {
    return 4;
  }
  return 8;
}

// ================= layout (LOW-7) ==========================================

fn round_up_i64(v: i64, a: i64) -> i64 {
  return (v + a - 1) / a * a;
}

fn type_align(t: *Type) -> i64 {
  if t == null {
    return 1;
  }
  if t.kind == TypeKind.TyI8 || t.kind == TypeKind.TyU8 || t.kind == TypeKind.TyBool {
    return 1;
  }
  if t.kind == TypeKind.TyI16 || t.kind == TypeKind.TyU16 {
    return 2;
  }
  if t.kind == TypeKind.TyI32 || t.kind == TypeKind.TyU32 || t.kind == TypeKind.TyF32 {
    return 4;
  }
  if t.kind == TypeKind.TyStruct || t.kind == TypeKind.TyEnum {
    layout_rec(t.rec);
    if t.rec.align > 0 {
      return t.rec.align;
    }
    return 8;
  }
  return 8;
}

fn type_size(t: *Type) -> i64 {
  if t == null {
    return 0;
  }
  if t.kind == TypeKind.TyI8 || t.kind == TypeKind.TyU8 || t.kind == TypeKind.TyBool {
    return 1;
  }
  if t.kind == TypeKind.TyI16 || t.kind == TypeKind.TyU16 {
    return 2;
  }
  if t.kind == TypeKind.TyI32 || t.kind == TypeKind.TyU32 || t.kind == TypeKind.TyF32 {
    return 4;
  }
  if t.kind == TypeKind.TyStringK || t.kind == TypeKind.TySlice {
    return 24;
  }
  if t.kind == TypeKind.TyFn {
    return 16; // {code, env}
  }
  if t.kind == TypeKind.TyStruct || t.kind == TypeKind.TyEnum {
    layout_rec(t.rec);
    return t.rec.size;
  }
  if t.kind == TypeKind.TyDyn {
    return 16; // {vtable, obj}
  }
  return 8;
}

fn layout_rec(rec: *RecType) {
  if rec.align != 0 {
    return;
  }
  rec.align = (0 - 1) as i64;
  let d: *Decl = rec.decl;
  let saved_mod: *Module = cur_module;
  if rec.owner_mod != null {
    cur_module = rec.owner_mod;
  }
  let mut size: i64 = 0;
  let mut align: i64 = 1;
  if d.kind == DeclKind.DkStruct {
    struct_field_type(rec, 0);
    let mut i: usize = 0;
    while i < d.fields.n {
      let ft: *Type = rec.field_types[i];
      let fa: i64 = type_align(ft);
      if fa > align {
        align = fa;
      }
      let off: i64 = round_up_i64(size, fa);
      rec.offsets = push_i64(rec.offsets, off);
      size = off + type_size(ft);
      i += 1;
    }
  } else {
    align = 4;
    size = 4;
    let saved_env: *TypeMap = g_tenv;
    g_tenv = rec.env_tenv;
    let mut i: usize = 0;
    while i < d.variants.n {
      let v: *VariantAst = d.variants.items[i];
      let foff: *I64Vec = new I64Vec { items: make([]i64, 0) };
      rec.var_offsets = push_i64vec(rec.var_offsets, foff);
      if v.vkind == VarKind.VarUnit {
        rec.var_poff = push_i64(rec.var_poff, 4);
        i += 1;
        continue;
      }
      let mut nfields: usize = v.types.n;
      if v.vkind == VarKind.VarStruct {
        nfields = v.fields.n;
      }
      let mut off: i64 = 4;
      let mut j: usize = 0;
      while j < nfields {
        let mut fta: *TypeAst = v.types.items[j];
        if v.vkind == VarKind.VarStruct {
          fta = v.fields.items[j].ty;
        }
        let vt: *Type = resolve_type_in_module(cur_module, fta);
        let va: i64 = type_align(vt);
        if va > align {
          align = va;
        }
        off = round_up_i64(off, va);
        foff.items = push_i64(foff.items, off);
        off = off + type_size(vt);
        j += 1;
      }
      let mut poff: i64 = 4;
      if len(foff.items) > 0 {
        poff = foff.items[0];
      }
      rec.var_poff = push_i64(rec.var_poff, poff);
      if off > size {
        size = off;
      }
      i += 1;
    }
    g_tenv = saved_env;
  }
  cur_module = saved_mod;
  rec.align = align;
  rec.size = round_up_i64(size, align);
}

fn push_i64vec(items: []*I64Vec, v: *I64Vec) -> []*I64Vec {
  let out: []*I64Vec = make([]*I64Vec, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

// payload start of one variant of an enum value
fn variant_payload_offset(enum_t: *Type, variant: i32) -> i64 {
  layout_rec(enum_t.rec);
  if variant >= 0 && variant as usize < len(enum_t.rec.var_poff) {
    return enum_t.rec.var_poff[variant];
  }
  return 4;
}

fn variant_field_offset(enum_t: *Type, variant: i32, field: i32) -> i64 {
  layout_rec(enum_t.rec);
  if variant >= 0 && variant as usize < len(enum_t.rec.var_offsets) {
    let foff: []i64 = enum_t.rec.var_offsets[variant].items;
    if field >= 0 && field as usize < len(foff) {
      return foff[field];
    }
  }
  return 4;
}

fn push_i64(items: []i64, v: i64) -> []i64 {
  let out: []i64 = make([]i64, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn struct_field_offset(rec: *RecType, i: usize) -> i64 {
  layout_rec(rec);
  if len(rec.offsets) > i {
    return rec.offsets[i];
  }
  return 0;
}
// ================= lowering (LOW-8): checks, panic, rc runtime ==============

struct CV { ok: bool, is_int: bool, i: u64, f: f64, s: string, b: bool }

// compile-time constant evaluation (statics/consts)
fn const_eval(e: *Expr, m: *Module) -> *CV {
  let r: *CV = new CV { ok: false, is_int: false, i: 0, f: 0.0, s: "", b: false };
  let saved: *Module = cur_module;
  cur_module = m;
  if e.kind == ExprKind.ExInt {
    r.ok = true;
    r.is_int = true;
    r.i = e.iv;
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExFloat {
    r.ok = true;
    r.f = e.fv;
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExStr {
    r.ok = true;
    r.s = e.sv;
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExBool {
    r.ok = true;
    r.b = e.bv;
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExCast {
    let a: *CV = const_eval(e.a, m);
    if !a.ok {
      cur_module = saved;
      return r;
    }
    r.ok = a.is_int;
    r.is_int = a.is_int;
    r.i = a.i;
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExName {
    let mut sym: *Sym = sm_get(m.syms, e.sv);
    if sym == null && prelude_module != null && prelude_module != m {
      sym = sm_get(prelude_module.syms, e.sv);
    }
    if sym != null && (sym.kind == SymKind.SyConst || sym.kind == SymKind.SyStatic) {
      if sym.decl.ceval_ok {
        r.ok = true;
        r.is_int = sym.decl.ceval_is_int;
        r.i = sym.decl.ceval_i;
        r.f = sym.decl.ceval_f;
        cur_module = saved;
        return r;
      }
      let v: *CV = const_eval(sym.decl.init, m);
      sym.decl.ceval_ok = v.ok;
      sym.decl.ceval_is_int = v.is_int;
      sym.decl.ceval_i = v.i;
      sym.decl.ceval_f = v.f;
      r.ok = v.ok;
      r.is_int = v.is_int;
      r.i = v.i;
      r.f = v.f;
      cur_module = saved;
      return r;
    }
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExUn {
    let a: *CV = const_eval(e.a, m);
    if !a.ok {
      cur_module = saved;
      return r;
    }
    r.ok = true;
    if e.unop == Tok.PMinus {
      if a.is_int {
        r.is_int = true;
        r.i = (0 - (a.i as i64)) as u64;
      } else {
        r.f = 0.0 - a.f;
      }
    } else if e.unop == Tok.PTilde && a.is_int {
      r.is_int = true;
      r.i = ~a.i;
    } else if e.unop == Tok.PBang {
      r.b = !a.b;
    } else {
      r.ok = false;
    }
    cur_module = saved;
    return r;
  }
  if e.kind == ExprKind.ExBin {
    let a: *CV = const_eval(e.a, m);
    let b: *CV = const_eval(e.b, m);
    if !a.ok || !b.ok {
      cur_module = saved;
      return r;
    }
    if !a.is_int || !b.is_int {
      cur_module = saved;
      return r; // no float/str const arithmetic
    }
    r.ok = true;
    r.is_int = true;
    let x: u64 = a.i;
    let y: u64 = b.i;
    let op: Tok = e.binop;
    if op == Tok.PPlus { r.i = x + y; }
    else if op == Tok.PMinus { r.i = x - y; }
    else if op == Tok.PStar { r.i = x * y; }
    else if op == Tok.PSlash { if y != 0 { r.i = x / y; } }
    else if op == Tok.PPercent { if y != 0 { r.i = x % y; } }
    else if op == Tok.PAmp { r.i = x & y; }
    else if op == Tok.PPipe { r.i = x | y; }
    else if op == Tok.PCaret { r.i = x ^ y; }
    else if op == Tok.PShl { r.i = x << (y & 63); }
    else if op == Tok.PShr { r.i = x >> (y & 63); }
    else if op == Tok.PEq { r.is_int = false; r.b = x == y; }
    else if op == Tok.PNe { r.is_int = false; r.b = x != y; }
    else if op == Tok.PLt { r.is_int = false; r.b = x < y; }
    else if op == Tok.PGt { r.is_int = false; r.b = x > y; }
    else if op == Tok.PLe { r.is_int = false; r.b = x <= y; }
    else if op == Tok.PGe { r.is_int = false; r.b = x >= y; }
    else if op == Tok.PAndand { r.is_int = false; r.b = x != 0 && y != 0; }
    else if op == Tok.POror { r.is_int = false; r.b = x != 0 || y != 0; }
    else { r.ok = false; }
    cur_module = saved;
    return r;
  }
  cur_module = saved;
  return r;
}

fn ty_is_signed_int(t: IRType) -> bool {
  if t == IRType.ItI8 || t == IRType.ItI16 || t == IRType.ItI32 || t == IRType.ItI64 {
    return true;
  }
  return false;
}

fn ir_type_of(t: *Type) -> IRType {
  if t.kind == TypeKind.TyBool { return IRType.ItU8; }
  if t.kind == TypeKind.TyI8 { return IRType.ItI8; }
  if t.kind == TypeKind.TyI16 { return IRType.ItI16; }
  if t.kind == TypeKind.TyI32 { return IRType.ItI32; }
  if t.kind == TypeKind.TyI64 { return IRType.ItI64; }
  if t.kind == TypeKind.TyU8 { return IRType.ItU8; }
  if t.kind == TypeKind.TyU16 { return IRType.ItU16; }
  if t.kind == TypeKind.TyU32 { return IRType.ItU32; }
  if t.kind == TypeKind.TyU64 { return IRType.ItU64; }
  if t.kind == TypeKind.TyUsize { return IRType.ItUsize; }
  if t.kind == TypeKind.TyIsize { return IRType.ItI64; }
  if t.kind == TypeKind.TyF32 { return IRType.ItF32; }
  if t.kind == TypeKind.TyF64 { return IRType.ItF64; }
  if t.kind == TypeKind.TyIntLit { return IRType.ItI32; }
  if t.kind == TypeKind.TyFloatLit { return IRType.ItF64; }
  return IRType.ItPtr;
}

fn ty_is_aggregate(t: *Type) -> bool {
  if t.kind == TypeKind.TyStruct || t.kind == TypeKind.TyEnum ||
     t.kind == TypeKind.TyArray || t.kind == TypeKind.TySlice ||
     t.kind == TypeKind.TyStringK || t.kind == TypeKind.TyFn ||
     t.kind == TypeKind.TyDyn {
    return true; // TyFn: closure pair {code, env}; TyDyn: {vtable, obj}
  }
  return false;
}

fn push_phi(items: []*IRPhi, p: *IRPhi) -> []*IRPhi {
  let out: []*IRPhi = make([]*IRPhi, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = p;
  return out;
}

// a phi lives in the block whose execution merges: the JOIN block
fn emit_phi_in(c: *LCtx, block: *IRBlock, ty: IRType) -> *IRPhi {
  let saved: *IRBlock = c.f.cur;
  c.f.cur = block;
  let p: *IRPhi = new IRPhi {
    dst: new_vreg(c, ty), args: make([]*IRVreg, 0), preds: make([]*IRBlock, 0),
  };
  block.phis = push_phi(block.phis, p);
  c.f.cur = saved;
  return p;
}

fn phi_add(p: *IRPhi, pred: *IRBlock, v: *IRVreg) {
  p.preds = push_ptr(p.preds, pred);
  p.args = push_vreg(p.args, v);
}

fn push_u8(items: []u8, v: u8) -> []u8 {
  let out: []u8 = make([]u8, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn lit_bytes(c: *LCtx, s: string) -> i32 {
  let mut bytes: []u8 = make([]u8, 0);
  let mut i: usize = 0;
  while i < len(s) {
    bytes = push_u8(bytes, s[i]);
    i += 1;
  }
  bytes = push_u8(bytes, 0); // NUL pad for C interop debugging
  let label: string = cat3("str", itoa(g_lit_counter as i64), "");
  g_lit_counter += 1;
  let l: *IRLit = new IRLit { label: label, bytes: bytes };
  c.f.literals = push_lit(c.f.literals, l);
  return len(c.f.literals) as i32 - 1;
}

fn push_lit(items: []*IRLit, l: *IRLit) -> []*IRLit {
  let out: []*IRLit = make([]*IRLit, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = l;
  return out;
}

// the aggregate-return destination: the out slot holds the caller's buffer
// pointer — load through it, never write into the slot itself
fn ret_dest(c: *LCtx) -> *IRVreg {
  return v_load(c, v_slotaddr(c, c.f.out_slot), IRType.ItPtr);
}

// mangled symbol for a module-level symbol: rho_<path>__<name>
fn sym_symbol(s: *Sym) -> string {
  if s.symbol != "" {
    return s.symbol;
  }
  if s.kind == SymKind.SyExtern {
    return s.name; // C ABI name; emitter adds prefix per target
  }
  let mut path: string = "";
  if s.owner != null {
    path = rho_sanitize(s.owner.path);
  }
  // instantiation markers (`push$u8`) must not fold to the same token as a
  // plain identifier (`push_u8`), so `$` escapes to `_Q_`
  let name: string = rho_sanitize_sym(s.name);
  // methods fold in the receiver name: `to_str` is defined once per type in
  // a module and the bare name would collide
  if s.decl != null && s.decl.is_method && len(s.decl.recv) > 0 {
    s.symbol = cat5("rho_", path, "__", rho_sanitize(s.decl.recv), cat3("_", name, ""));
    return s.symbol;
  }
  let sym: string = cat3("rho_", cat3(path, "__", name), "");
  s.symbol = sym;
  return sym;
}

fn rho_sanitize_sym(s: string) -> string {
  let buf: *Vec[u8] = new Vec[u8] { items: make([]u8, 32), n: 0 };
  let mut i: usize = 0;
  while i < len(s) {
    let c: u8 = s[i];
    let ok: bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
                   (c >= 48 && c <= 57) || c == 95;
    if ok {
      buf.push(c);
    } else if c == 36 {
      buf.push(95);
      buf.push(81);
      buf.push(95);
    } else {
      buf.push(95);
    }
    i += 1;
  }
  return intrinsics.slice_string(buf.items[0..buf.n]);
}

fn prelude_fn(name: string) -> *Sym {
  if prelude_module == null {
    return null;
  }
  return sm_get(prelude_module.syms, name);
}

fn panic_call(c: *LCtx, msg: string) {
  // stamp the function name + a per-site counter into the message: runtime
  // panics from generated checks are otherwise indistinguishable
  let site: i32 = g_panic_site;
  g_panic_site += 1;
  let m: string = cat3("[", cat3(c.f.symbol, "#", cat3(itoa(site as i64), "] ", msg)), "");
  let lit: i32 = lit_bytes(c, m);
  let tmp: *IRSlot = new_slot(c, 24, 8, "panicstr");
  let addr: *IRVreg = v_slotaddr(c, tmp);
  let ptrv: *IRVreg = new_vreg(c, IRType.ItPtr);
  let la: *IRIns = emit(c, IROp.IrLitaddr);
  la.dst = ptrv;
  la.lit = lit;
  let bytes: *IRVreg = v_addi(c, ptrv, 24);
  let addr8: *IRVreg = v_addi(c, addr, 8);
  let addr16: *IRVreg = v_addi(c, addr, 16);
  let lenv: *IRVreg = v_const(c, len(m) as i64, IRType.ItUsize);
  let st1: *IRIns = emit(c, IROp.IrStore);
  st1.addr = addr;
  st1.a = ptrv;
  st1.size = 8;
  let st2: *IRIns = emit(c, IROp.IrStore);
  st2.addr = addr8;
  st2.a = bytes;
  st2.size = 8;
  let st3: *IRIns = emit(c, IROp.IrStore);
  st3.addr = addr16;
  st3.a = lenv;
  st3.size = 8;
  // call prelude panic(msg)
  let panic_fn: *Sym = prelude_fn("panic");
  let call: *IRIns = emit(c, IROp.IrCall);
  call.callee = sym_symbol(panic_fn);
  call.args = push_vreg(call.args, addr);
  // panic never returns; keep the block unsealed — a br follows at call site
}

fn null_check(c: *LCtx, ptr: *IRVreg) -> *IRVreg {
  let ok: *IRBlock = new_block(c);
  let bad: *IRBlock = new_block(c);
  let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, ptr, v_const(c, 0, IRType.ItPtr), false);
  emit_cbr(c, isnull, bad, ok, ok);
  use_block(c, bad);
  panic_call(c, "null dereference");
  emit_br(c, ok); // unreachable, keeps the CFG well-formed
  use_block(c, ok);
  return ptr;
}

// bounds check: idx < len, unsigned
fn bounds_check(c: *LCtx, idx: *IRVreg, len_v: *IRVreg) {
  let ok: *IRBlock = new_block(c);
  let bad: *IRBlock = new_block(c);
  let oob: *IRVreg = v_cmp(c, IRCC.CcGe, idx, len_v, false); // unsigned via emitter flag
  emit_cbr(c, oob, bad, ok, ok);
  use_block(c, bad);
  panic_call(c, "index out of bounds");
  emit_br(c, ok);
  use_block(c, ok);
}

// slice upper bound: hi <= len is legal
fn bounds_check_hi(c: *LCtx, hi: *IRVreg, len_v: *IRVreg) {
  let ok: *IRBlock = new_block(c);
  let bad: *IRBlock = new_block(c);
  let oob: *IRVreg = v_cmp(c, IRCC.CcGt, hi, len_v, false);
  emit_cbr(c, oob, bad, ok, ok);
  use_block(c, bad);
  panic_call(c, "index out of bounds");
  emit_br(c, ok);
  use_block(c, ok);
}

fn call_prelude1(c: *LCtx, name: string, arg0: *IRVreg, ret: IRType) -> *IRVreg {
  let fn_: *Sym = prelude_fn(name);
  let call: *IRIns = emit(c, IROp.IrCall);
  call.callee = sym_symbol(fn_);
  if arg0 != null {
    call.args = push_vreg(call.args, arg0);
  }
  call.dst = new_vreg(c, ret);
  return call.dst;
}

// string equality: both operands lowered as slice addresses; calls prelude
fn call_str_cmp(c: *LCtx, e: *Expr, want_eq: bool) -> *IRVreg {
  let a: *IRVreg = lv_expr(c, e.a);
  let b: *IRVreg = lv_expr(c, e.b);
  let fn_: *Sym = prelude_fn("__streq");
  let call: *IRIns = emit(c, IROp.IrCall);
  call.callee = sym_symbol(fn_);
  call.args = push_vreg(call.args, a);
  call.args = push_vreg(call.args, b);
  call.dst = new_vreg(c, IRType.ItU8);
  if !want_eq {
    let one: *IRVreg = v_const(c, 1, IRType.ItU8);
    // negate via XOR 1
    let x: *IRIns = emit(c, IROp.IrXor);
    x.dst = new_vreg(c, IRType.ItU8);
    x.a = call.dst;
    x.b = one;
    return x.dst;
  }
  return call.dst;
}

// slice expression a[lo..hi]: materialize {buf, ptr+lo, hi-lo} into a temp
fn lower_slice(c: *LCtx, e: *Expr) -> *IRVreg {
  let bt: *Type = e.a.typed;
  let base: *IRVreg = lv_expr(c, e.a); // aggregate: address of slice/array
  let mut lo: *IRVreg = lv_expr(c, e.b);
  let mut hi: *IRVreg = lv_expr(c, e.c);
  if lo.ty != IRType.ItUsize {
    lo = v_cast(c, lo, IRType.ItUsize);
  }
  if hi.ty != IRType.ItUsize {
    hi = v_cast(c, hi, IRType.ItUsize);
  }
  let mut len_v: *IRVreg = null;
  if bt.kind == TypeKind.TyArray {
    len_v = v_const(c, bt.len as i64, IRType.ItUsize);
  } else {
    len_v = v_load(c, v_addi(c, base, 16), IRType.ItUsize);
  }
  bounds_check(c, lo, len_v);
  bounds_check_hi(c, hi, len_v);
  let mut buf: *IRVreg = null;
  let mut ptr: *IRVreg = null;
  if bt.kind == TypeKind.TyArray {
    buf = compute_addr(c, e.a); // array address as buffer
    ptr = buf;
  } else {
    buf = v_load(c, base, IRType.ItPtr);
    ptr = v_load(c, v_addi(c, base, 8), IRType.ItPtr);
  }
  let mut esize: i64 = type_size(bt.elem);
  if bt.kind == TypeKind.TyStringK {
    esize = 1;
  }
  let esz: *IRVreg = v_const(c, esize, IRType.ItUsize);
  let mul: *IRIns = emit(c, IROp.IrMul);
  mul.dst = new_vreg(c, IRType.ItUsize);
  mul.a = lo;
  mul.b = esz;
  let scaled: *IRVreg = mul.dst;
  let pa: *IRIns = emit(c, IROp.IrAdd);
  pa.dst = new_vreg(c, IRType.ItPtr);
  pa.a = ptr;
  pa.b = scaled;
  let sub: *IRIns = emit(c, IROp.IrSub);
  sub.dst = new_vreg(c, IRType.ItUsize);
  sub.a = hi;
  sub.b = lo;
  let nlen: *IRVreg = sub.dst;
  let tmp: *IRSlot = new_slot(c, 24, 8, "sliceval");
  let dest: *IRVreg = v_slotaddr(c, tmp);
  let d8: *IRVreg = v_addi(c, dest, 8);
  let d16: *IRVreg = v_addi(c, dest, 16);
  let s1: *IRIns = emit(c, IROp.IrStore);
  s1.addr = dest;
  s1.a = buf;
  s1.size = 8;
  let s2: *IRIns = emit(c, IROp.IrStore);
  s2.addr = d8;
  s2.a = pa.dst;
  s2.size = 8;
  let s3: *IRIns = emit(c, IROp.IrStore);
  s3.addr = d16;
  s3.a = nlen;
  s3.size = 8;
  return dest;
}

fn scope_pop_l(c: *LCtx) {
  c.scope = c.scope.parent;
}

// ---------------------------------------------------- ownership rules ----
//
// An owning rvalue carries its +1 (new/make/call/closure, and match/if
// results which normalize their arms); everything else borrows. Bindings
// own: a let either takes the +1 or retains a borrowed value; scopes
// release what they own, innermost first, on every exit path.

fn expr_owned(e: *Expr) -> bool {
  if e == null || e.typed == null {
    return false;
  }
  if e.kind == ExprKind.ExNew || e.kind == ExprKind.ExClosure ||
     e.kind == ExprKind.ExDynbox {
    return true;
  }
  if e.kind == ExprKind.ExCall {
    // weak.get() lends the object without taking a count: it is a borrow
    if e.a.kind == ExprKind.ExField && streq(e.a.sv, "get") && e.a.a != null &&
       e.a.a.typed != null && e.a.a.typed.kind == TypeKind.TyWeak {
      return false;
    }
    return ty_is_managed(e.typed);
  }
  if e.kind == ExprKind.ExMake || e.kind == ExprKind.ExMatch || e.kind == ExprKind.ExIf {
    return ty_is_managed(e.typed);
  }
  return false;
}

// release every owned binding from the current scope down to (exclusive)
// `stop` — the rc twin of run_defers
fn release_scopes_to(c: *LCtx, stop: *LScope) {
  let mut s: *LScope = c.scope;
  while s != null && s != stop {
    if !s.is_loop {
      // loop bindings release only at the back edge; unwinding an
      // interrupted iteration would double-release or release junk
      let owned: []*OwnedBind = s.owned;
      let mut k: usize = len(owned);
      while k > 0 {
        let ob: *OwnedBind = owned[k - 1];
        release_addr(c, ob.ty, v_slotaddr(c, ob.slot));
        k -= 1;
      }
    }
    s = s.parent;
  }
}

// retain a produced rvalue: aggregates are value addresses, scalars are
// plain pointer vregs
fn retain_or_inc(c: *LCtx, t: *Type, v: *IRVreg) {
  if ty_is_aggregate(t) {
    retain_addr(c, t, v);
  } else if t.kind == TypeKind.TyPtr {
    rc_inc_v(c, v);
  } else if t.kind == TypeKind.TyWeak {
    rc_call1(c, "rho__rc_winc", v);
  }
}

// a block arm's value is pre-owned when its trailing expression is an
// owning producer (or a nested if, which normalizes itself)
fn arm_value_owned(stmts: *Vec[*Stmt]) -> bool {
  if stmts.n == 0 {
    return true; // void-ish; nothing to normalize
  }
  let last: *Stmt = stmts.items[stmts.n - 1];
  if last.kind != StmtKind.StExpr || !last.tail || last.a == null {
    return true;
  }
  return last.a.kind == ExprKind.ExIf || expr_owned(last.a);
}

// ------------------------------------------------------------ closures ----
//
// A closure value is {code: *fn, env: *u8}. Calling one always passes env as
// the final hidden argument, so closure bodies and shims share one ABI.
// Static fn references materialize as {shim, null}: the shim drops env and
// forwards. Boot-era captures are copies — immutable snapshots.

static mut g_shims: *Vec[string] = 0 as *Vec[string];

fn push_str(items: []string, v: string) -> []string {
  let out: []string = make([]string, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn shim_for(fn_: *Sym) -> string {
  let shim_name: string = cat3("rho__shim_", sym_symbol(fn_), "");
  if g_shims == null {
    g_shims = new Vec[string] { items: make([]string, 64), n: 0 };
  }
  let mut i: usize = 0;
  while i < g_shims.n {
    if streq(g_shims.items[i], shim_name) {
      return shim_name;
    }
    i += 1;
  }
  g_shims.push(shim_name);
  let ft: *Type = fn_.type;
  let ret: *Type = ft.ret;
  let agg_ret: bool = ret != null && ty_is_aggregate(ret);

  let lf: *IRFn = rc_new_fn(shim_name);
  lf.ret = ret;
  let cc: *LCtx = rc_ctx(lf);
  // rc_new_fn already created and selected the entry block; creating
  // another here would leave an empty leading block the emitters emit
  if agg_ret {
    lf.returns_aggregate = true;
    lf.out_slot = new_slot(cc, type_size(ret), type_align(ret), "out");
  }

  let mut args: []*IRVreg = make([]*IRVreg, 0);
  if agg_ret {
    let outp: *IRVreg = v_load(cc, v_slotaddr(cc, lf.out_slot), IRType.ItPtr);
    args = push_vreg(args, outp);
  }
  let mut i2: usize = 0;
  while i2 < len(ft.params) {
    let pt: *Type = ft.params[i2];
    let sl: *IRSlot = new_slot(cc, type_size(pt), type_align(pt), "p");
    lf.params = push_islot(lf.params, sl);
    lf.param_types = push_type(lf.param_types, pt);
    let mut it: IRType = ir_type_of(pt);
    if ty_is_aggregate(pt) {
      it = IRType.ItPtr;
    }
    let pv: *IRVreg = v_load(cc, v_slotaddr(cc, sl), it);
    args = push_vreg(args, pv);
    i2 += 1;
  }
  // the closure-ABI env parameter arrives last and is dropped here
  let env: *IRSlot = new_slot(cc, 8, 8, "env");
  lf.params = push_islot(lf.params, env);
  lf.param_types = push_type(lf.param_types, null);

  let call: *IRIns = emit(cc, IROp.IrCall);
  call.callee = sym_symbol(fn_);
  call.args = args;
  let mut rv: *IRVreg = null;
  if ret != null && !agg_ret && ret.kind != TypeKind.TyVoid {
    call.dst = new_vreg(cc, ir_type_of(ret));
    rv = call.dst;
  }
  emit_ret(cc, rv);
  g_ir_fns.push(lf);


  return shim_name;
}

// ------------------------------------------------------------ dyn ------
//
// A dyn Trait value is {vtable, obj}. Method calls load the slot and use
// the closure ABI with the object as the hidden env; the vtable itself is
// built once per coercion site into an immortal heap block — the same
// stores `new` uses for its header drop glue (boot: dyn_shim_for).

fn dyn_method_on(t_in: *Type, name: string) -> *Sym {
  let mut t: *Type = t_in;
  if t.kind == TypeKind.TyPtr {
    t = t.elem;
  }
  if t == null || (t.kind != TypeKind.TyStruct && t.kind != TypeKind.TyEnum) {
    return null;
  }
  let mut i: usize = 0;
  while i < len(t.rec.methods) {
    let m: *Sym = t.rec.methods[i];
    if streq(m.name, name) {
      return m;
    }
    i += 1;
  }
  return null;
}

static mut g_dyn_shims: *Vec[string] = 0 as *Vec[string];

// the vtable slot for an impl method: signature (args..., env) where env
// arrives as self — a sibling of shim_for with the receiver folded into
// the hidden parameter
fn dyn_shim_for(fn_: *Sym) -> string {
  let shim_name: string = cat3("rho__dshim_", sym_symbol(fn_), "");
  if g_dyn_shims == null {
    g_dyn_shims = new Vec[string] { items: make([]string, 64), n: 0 };
  }
  let mut i: usize = 0;
  while i < g_dyn_shims.n {
    if streq(g_dyn_shims.items[i], shim_name) {
      return shim_name;
    }
    i += 1;
  }
  g_dyn_shims.push(shim_name);
  let ft: *Type = fn_.type; // fn(self, rest...) -> ret
  let ret: *Type = ft.ret;
  let agg_ret: bool = ret != null && ty_is_aggregate(ret);

  let lf: *IRFn = rc_new_fn(shim_name);
  lf.ret = ret;
  let cc: *LCtx = rc_ctx(lf);
  if agg_ret {
    lf.returns_aggregate = true;
    lf.out_slot = new_slot(cc, type_size(ret), type_align(ret), "out");
  }

  let mut args: []*IRVreg = make([]*IRVreg, 0);
  if agg_ret {
    let outp: *IRVreg = v_load(cc, v_slotaddr(cc, lf.out_slot), IRType.ItPtr);
    args = push_vreg(args, outp);
  }
  // the receiver slot: env arrives LAST in the ABI and is forwarded FIRST
  let env: *IRSlot = new_slot(cc, 8, 8, "env");
  lf.params = push_islot(lf.params, env);
  lf.param_types = push_type(lf.param_types, null);
  let envv: *IRVreg = v_load(cc, v_slotaddr(cc, env), IRType.ItPtr);
  let sa: *IRVreg = envv;
  args = push_vreg(args, sa);
  let mut i2: usize = 1;
  while i2 < len(ft.params) {
    let pt: *Type = ft.params[i2];
    let sl: *IRSlot = new_slot(cc, type_size(pt), type_align(pt), "p");
    lf.params = push_islot(lf.params, sl);
    lf.param_types = push_type(lf.param_types, pt);
    let mut it: IRType = ir_type_of(pt);
    if ty_is_aggregate(pt) {
      it = IRType.ItPtr;
    }
    let pv: *IRVreg = v_load(cc, v_slotaddr(cc, sl), it);
    args = push_vreg(args, pv);
    i2 += 1;
  }
  let call: *IRIns = emit(cc, IROp.IrCall);
  call.callee = sym_symbol(fn_);
  call.args = args;
  let mut rv: *IRVreg = null;
  if ret != null && !agg_ret && ret.kind != TypeKind.TyVoid {
    call.dst = new_vreg(cc, ir_type_of(ret));
    rv = call.dst;
  }
  emit_ret(cc, rv);
  g_ir_fns.push(lf);
  return shim_name;
}

// build the vtable inline, in the current block: an immortal heap block
// whose words are the dyn shims (the .bss memoization returns when the
// emitters grow a shape for the null-check diamond)
fn vtable_ensure(c: *LCtx, conc: *Type, tr: *RecType) -> *IRVreg {
  let n: usize = len(tr.methods);
  let sz: *IRVreg = v_const(c, (n * 8 + 24) as i64, IRType.ItUsize);
  let blk: *IRVreg = call_prelude1(c, "__alloc", sz, IRType.ItPtr);
  // operands first, stores second: a value computed inside an assignment
  // to i->a after emit() lands BELOW its use and reads a stale local
  let immortal: *IRVreg = v_const(c, 0 - 9223372036854775807 as i64 - 1, IRType.ItUsize);
  let rc: *IRIns = emit(c, IROp.IrStore);
  rc.addr = blk;
  rc.a = immortal;
  rc.size = 8;
  let h8: *IRVreg = v_addi(c, blk, 8);
  let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
  let wrc: *IRIns = emit(c, IROp.IrStore);
  wrc.addr = h8;
  wrc.a = zero;
  wrc.size = 8;
  let h16: *IRVreg = v_addi(c, blk, 16);
  let nullp: *IRVreg = v_const(c, 0, IRType.ItPtr);
  let dz: *IRIns = emit(c, IROp.IrStore);
  dz.addr = h16;
  dz.a = nullp;
  if g_target_wasm {
    dz.size = 4;
  } else {
    dz.size = 8;
  }
  let mut i: usize = 0;
  while i < n {
    let req: *Sym = tr.methods[i];
    let impl_: *Sym = dyn_method_on(conc, req.name);
    if impl_ == null {
      panic_call(c, "internal: trait method has no impl at vtable build");
    }
    let la: *IRIns = emit(c, IROp.IrAddrc);
    la.dst = new_vreg(c, IRType.ItPtr);
    la.callee = dyn_shim_for(impl_);
    la.lit = 0 - 1;
    let slot_addr: *IRVreg = v_addi(c, blk, 24 + (i as i64) * 8);
    let st: *IRIns = emit(c, IROp.IrStore);
    st.addr = slot_addr;
    st.a = la.dst;
    st.size = 8;
    i += 1;
  }
  return v_addi(c, blk, 24);
}

// load {vtable, obj}, fetch the slot, call through the closure ABI with
// the object as the hidden env (i.e. self). `out` (when given) receives
// an aggregate return directly.
fn is_dyn_virtual_call(e: *Expr) -> bool {
  return e.kind == ExprKind.ExCall && e.a != null && e.a.kind == ExprKind.ExField &&
         e.a.a != null && e.a.a.typed != null &&
         e.a.a.typed.kind == TypeKind.TyDyn &&
         e.a.sym != null && e.a.sym.kind == SymKind.SyTraitMethod;
}

fn dyn_virtual_call(c: *LCtx, e: *Expr, out_given: *IRVreg) -> *IRVreg {
  let recv_t: *Type = e.a.a.typed;
  let csym: *Sym = e.a.sym;
  let fat: *IRVreg = lv_expr(c, e.a.a); // the RECEIVER, not the field node
  let vt: *IRVreg = v_load(c, fat, IRType.ItPtr);
  let obj: *IRVreg = v_load(c, v_addi(c, fat, 8), IRType.ItPtr);
  let mut slot: i32 = 0;
  let mut i: usize = 0;
  while i < len(recv_t.rec.methods) {
    if recv_t.rec.methods[i] == csym {
      slot = i as i32;
      break;
    }
    i += 1;
  }
  let code: *IRVreg = v_load(c, v_addi(c, vt, slot as i64 * 8), IRType.ItPtr);
  let ft: *Type = csym.type; // fn(args...) -> ret — no receiver
  let ret: *Type = ft.ret;
  let agg: bool = ret != null && ty_is_aggregate(ret);
  let mut args: []*IRVreg = make([]*IRVreg, 0);
  let mut out: *IRVreg = out_given;
  if agg {
    if out == null {
      let tmp: *IRSlot = new_slot(c, type_size(ret), type_align(ret), "out");
      out = v_slotaddr(c, tmp);
    }
    args = push_vreg(args, out);
  }
  let mut owned_args: []*Expr = make([]*Expr, 0);
  let mut owned_slots: []usize = make([]usize, 0);
  let mut k: usize = 0;
  while k < e.args.n && k < len(ft.params) {
    let arg: *Expr = e.args.items[k];
    let pt: *Type = ft.params[k];
    args = push_vreg(args, lv_expr(c, arg));
    if pt != null && ty_is_managed(pt) && expr_owned(arg) {
      owned_args = push_expr(owned_args, arg);
      owned_slots = push_usize(owned_slots, len(args) - 1);
    }
    k += 1;
  }
  args = push_vreg(args, obj); // the object rides as env, i.e. self
  let call: *IRIns = emit(c, IROp.IrCall);
  call.callee_vreg = code;
  call.args = args;
  let mut oi: usize = 0;
  while oi < len(owned_args) {
    let arg: *Expr = owned_args[oi];
    let at: *Type = arg.typed;
    let pv: *IRVreg = args[owned_slots[oi]];
    if ty_is_aggregate(at) {
      release_addr(c, at, pv);
    } else {
      rc_dec_v(c, pv);
    }
    oi += 1;
  }
  if agg {
    return out;
  }
  if ret != null && ret.kind != TypeKind.TyVoid {
    call.dst = new_vreg(c, ir_type_of(ret));
    return call.dst;
  }
  return v_const(c, 0, IRType.ItPtr);
}

// a fn value for a named function: {shim, null env}
fn closure_value_for_sym(c: *LCtx, fn_: *Sym) -> *IRVreg {
  let shim: string = shim_for(fn_);
  let la: *IRIns = emit(c, IROp.IrAddrc);
  la.dst = new_vreg(c, IRType.ItPtr);
  la.callee = shim;
  la.lit = -1; // global/fn address form
  let zero: *IRVreg = v_const(c, 0, IRType.ItPtr);
  let tmp: *IRSlot = new_slot(c, 16, 8, "fnval");
  let addr: *IRVreg = v_slotaddr(c, tmp);
  let a8: *IRVreg = v_addi(c, addr, 8);
  let s1: *IRIns = emit(c, IROp.IrStore);
  s1.addr = addr;
  s1.a = la.dst;
  s1.size = 8;
  let s2: *IRIns = emit(c, IROp.IrStore);
  s2.addr = a8;
  s2.a = zero;
  s2.size = 8;
  return addr;
}

// ------------------------------------------------------ rc runtime -------
//
// Every heap object carries {rc: usize, wrc: usize, drop: fn} 24 bytes
// before its data; references point at the data. rc with the top bit set
// marks immortal static data.

fn rc_runtime_build() {
  // count helpers come in two conventions: __rc_inc/__rc_dec take the DATA
  // pointer (header at p-24 — *T values, closure envs), __rc_inch/__rc_dech
  // take the HEADER directly (slice buf fields, which sub-slices share while
  // ptr moves). Both null-check their argument.
  let mut variant: i32 = 0;
  while variant < 4 {
    let retain: bool = (variant & 1) == 0;
    let from_data: bool = (variant & 2) == 0;
    let mut nm: string = "rho__rc_dec";
    if retain {
      nm = "rho__rc_inc";
    }
    if !from_data {
      nm = cat3(nm, "h", "");
    }
    let lf: *IRFn = rc_new_fn(nm);
    let c: *LCtx = rc_ctx(lf);
    let ps: *IRSlot = new_slot(c, 8, 8, "p");
    lf.params = push_islot(lf.params, ps);
    lf.param_types = push_type(lf.param_types, null);
    let p: *IRVreg = v_load(c, v_slotaddr(c, ps), IRType.ItPtr);
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, p, v_const(c, 0, IRType.ItPtr), false);
    let cont: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, cont, done);
    use_block(c, cont);
    let mut h: *IRVreg = p;
    if !from_data {
      h = p;
    } else {
      h = v_addi(c, p, -24);
    }
    let rc: *IRVreg = v_load(c, h, IRType.ItUsize);
    let top: *IRVreg = v_binop(c, IROp.IrShr, rc, v_const(c, 63, IRType.ItUsize), IRType.ItUsize, false);
    let immortal: *IRVreg = v_cmp(c, IRCC.CcNe, top, v_const(c, 0, IRType.ItUsize), false);
    if retain {
      let bump: *IRBlock = new_block(c);
      emit_cbr(c, immortal, done, bump, done);
      use_block(c, bump);
      // same plausibility bound as the release path below: never write a
      // count through a header that does not look like one
      let implausible: *IRVreg = v_cmp_uge(c, rc, v_const(c, 65536, IRType.ItUsize));
      let sane: *IRBlock = new_block(c);
      emit_cbr(c, implausible, done, sane, done);
      use_block(c, sane);
      let rc2: *IRVreg = v_binop(c, IROp.IrAdd, rc, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
      v_store(c, h, rc2);
      emit_br(c, done);
      use_block(c, done);
      finish_fn_c(c);
      variant += 1;
      continue;
    }
    // release: on zero, run header.drop (with the data pointer) and free
    // unless weak refs hold it
    let live: *IRBlock = new_block(c);
    emit_cbr(c, immortal, done, live, done);
    use_block(c, live);
    // a plausible live count is small; a pointer-sized value here means h
    // is not a real header — trap instead of writing the count through it
    let implausible2: *IRVreg = v_cmp_uge(c, rc, v_const(c, 65536, IRType.ItUsize));
    let countsane: *IRBlock = new_block(c);
    emit_cbr(c, implausible2, done, countsane, done);
    use_block(c, countsane);
    let rc3: *IRVreg = v_binop(c, IROp.IrSub, rc, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
    v_store(c, h, rc3);
    let dead: *IRVreg = v_cmp(c, IRCC.CcEq, rc3, v_const(c, 0, IRType.ItUsize), false);
    let maybe_drop: *IRBlock = new_block(c);
    emit_cbr(c, dead, maybe_drop, done, done);
    use_block(c, maybe_drop);
    let dropf: *IRVreg = v_load(c, v_addi(c, h, 16), IRType.ItPtr);
    let nod: *IRVreg = v_cmp(c, IRCC.CcEq, dropf, v_const(c, 0, IRType.ItPtr), false);
    let run_drop: *IRBlock = new_block(c);
    let maybe_free: *IRBlock = new_block(c);
    emit_cbr(c, nod, maybe_free, run_drop, done);
    use_block(c, run_drop);
    let mut darg: *IRVreg = p;
    if !from_data {
      darg = v_addi(c, h, 24);
    }
    let dc: *IRIns = emit(c, IROp.IrCall);
    dc.callee_vreg = dropf;
    dc.args = push_vreg(dc.args, darg);
    emit_br(c, maybe_free);
    use_block(c, maybe_free);
    let wrc: *IRVreg = v_load(c, v_addi(c, h, 8), IRType.ItUsize);
    let noweak: *IRVreg = v_cmp(c, IRCC.CcEq, wrc, v_const(c, 0, IRType.ItUsize), false);
    let freeh: *IRBlock = new_block(c);
    emit_cbr(c, noweak, freeh, done, done);
    use_block(c, freeh);
    let fr: *Sym = prelude_fn("__free");
    let fc: *IRIns = emit(c, IROp.IrCall);
    fc.callee = sym_symbol(fr);
    fc.args = push_vreg(fc.args, h);
    emit_br(c, done);
    use_block(c, done);
    finish_fn_c(c);
    variant += 1;
  }
  // __rc_winc(h) / __rc_wdec(h): weak count up/down; last weak of a dead
  // object frees the storage
  {
    let lf: *IRFn = rc_new_fn("rho__rc_winc");
    let c: *LCtx = rc_ctx(lf);
    let hs: *IRSlot = new_slot(c, 8, 8, "h");
    lf.params = push_islot(lf.params, hs);
    lf.param_types = push_type(lf.param_types, null);
    let h: *IRVreg = v_load(c, v_slotaddr(c, hs), IRType.ItPtr);
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, h, v_const(c, 0, IRType.ItPtr), false);
    let cont: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, cont, done);
    use_block(c, cont);
    let w: *IRVreg = v_load(c, v_addi(c, h, 8), IRType.ItUsize);
    let w2: *IRVreg = v_binop(c, IROp.IrAdd, w, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
    v_store(c, v_addi(c, h, 8), w2);
    emit_br(c, done);
    use_block(c, done);
    finish_fn_c(c);
  }
  {
    let lf: *IRFn = rc_new_fn("rho__rc_wdec");
    let c: *LCtx = rc_ctx(lf);
    let hs: *IRSlot = new_slot(c, 8, 8, "h");
    lf.params = push_islot(lf.params, hs);
    lf.param_types = push_type(lf.param_types, null);
    let h: *IRVreg = v_load(c, v_slotaddr(c, hs), IRType.ItPtr);
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, h, v_const(c, 0, IRType.ItPtr), false);
    let cont: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, cont, done);
    use_block(c, cont);
    let w: *IRVreg = v_load(c, v_addi(c, h, 8), IRType.ItUsize);
    let w2: *IRVreg = v_binop(c, IROp.IrSub, w, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
    v_store(c, v_addi(c, h, 8), w2);
    let last: *IRVreg = v_cmp(c, IRCC.CcEq, w2, v_const(c, 0, IRType.ItUsize), false);
    let chk: *IRBlock = new_block(c);
    emit_cbr(c, last, chk, done, done);
    use_block(c, chk);
    let rc: *IRVreg = v_load(c, h, IRType.ItUsize);
    let deadc: *IRVreg = v_cmp(c, IRCC.CcEq, rc, v_const(c, 0, IRType.ItUsize), false);
    let freeh: *IRBlock = new_block(c);
    emit_cbr(c, deadc, freeh, done, done);
    use_block(c, freeh);
    let fr: *Sym = prelude_fn("__free");
    let fc: *IRIns = emit(c, IROp.IrCall);
    fc.callee = sym_symbol(fr);
    fc.args = push_vreg(fc.args, h);
    emit_br(c, done);
    use_block(c, done);
    finish_fn_c(c);
  }
  // __rc_wref(p) -> header: weak.from on a data pointer
  {
    let lf: *IRFn = rc_new_fn("rho__rc_wref");
    let c: *LCtx = rc_ctx(lf);
    lf.ret = null;
    let ps: *IRSlot = new_slot(c, 8, 8, "p");
    lf.params = push_islot(lf.params, ps);
    lf.param_types = push_type(lf.param_types, null);
    let p: *IRVreg = v_load(c, v_slotaddr(c, ps), IRType.ItPtr);
    let nullv: *IRVreg = v_const(c, 0, IRType.ItPtr); // before the branch: phi edges read it
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, p, nullv, false);
    let cont: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, cont, done);
    use_block(c, cont);
    let h: *IRVreg = v_addi(c, p, -24);
    let w: *IRVreg = v_load(c, v_addi(c, h, 8), IRType.ItUsize);
    let w2: *IRVreg = v_binop(c, IROp.IrAdd, w, v_const(c, 1, IRType.ItUsize), IRType.ItUsize, true);
    v_store(c, v_addi(c, h, 8), w2);
    emit_br(c, done);
    use_block(c, done);
    // phi: null path -> 0, cont path -> h
    let phi: *IRPhi = emit_phi_in(c, done, IRType.ItPtr);
    phi_add(phi, lf.entry, nullv);
    phi_add(phi, cont, h);
    emit_ret(c, phi.dst);
    g_ir_fns.push(lf);
  }
  // __rc_wget(h) -> data pointer or null when dead
  {
    let lf: *IRFn = rc_new_fn("rho__rc_wget");
    let c: *LCtx = rc_ctx(lf);
    let hs: *IRSlot = new_slot(c, 8, 8, "h");
    lf.params = push_islot(lf.params, hs);
    lf.param_types = push_type(lf.param_types, null);
    let h: *IRVreg = v_load(c, v_slotaddr(c, hs), IRType.ItPtr);
    let nullv: *IRVreg = v_const(c, 0, IRType.ItPtr); // before the branch: phi edges read it
    let isnull: *IRVreg = v_cmp(c, IRCC.CcEq, h, nullv, false);
    let live: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, isnull, done, live, done);
    use_block(c, live);
    let rc: *IRVreg = v_load(c, h, IRType.ItUsize);
    let top: *IRVreg = v_binop(c, IROp.IrShr, rc, v_const(c, 63, IRType.ItUsize), IRType.ItUsize, false);
    let immortal: *IRVreg = v_cmp(c, IRCC.CcNe, top, v_const(c, 0, IRType.ItUsize), false);
    let alive2: *IRVreg = v_cmp(c, IRCC.CcNe, rc, v_const(c, 0, IRType.ItUsize), false);
    let alive: *IRVreg = v_binop(c, IROp.IrOr, immortal, alive2, IRType.ItU8, false);
    let yes: *IRBlock = new_block(c);
    emit_cbr(c, alive, yes, done, done);
    use_block(c, yes);
    let data: *IRVreg = v_addi(c, h, 24);
    emit_br(c, done);
    use_block(c, done);
    let phi: *IRPhi = emit_phi_in(c, done, IRType.ItPtr);
    phi_add(phi, lf.entry, nullv);
    phi_add(phi, live, nullv);
    phi_add(phi, yes, data);
    emit_ret(c, phi.dst);
    g_ir_fns.push(lf);
  }
}

// ---- structural equality glue ---------------------------------------------
// rho__eq$<t>(a, b) compares two enum/struct values field by field through a
// result slot (no phis): tags first for enums, then payload/field pairs.

fn eq_fn_for(t: *Type) -> string {
  if t == null || (t.kind != TypeKind.TyEnum && t.kind != TypeKind.TyStruct) {
    return "";
  }
  if g_eq_fns == null {
    g_eq_fns = tm2_new();
  }
  let found: string = tm2_get(g_eq_fns, t.mangled);
  if found != "" {
    return found;
  }
  let sym: string = cat3("rho__eq$", rho_sanitize(t.mangled), "");
  tm2_put(g_eq_fns, t.mangled, sym);
  let lf: *IRFn = rc_new_fn(sym);
  let c: *LCtx = rc_ctx(lf);
  let as_: *IRSlot = new_slot(c, 8, 8, "a");
  let bs: *IRSlot = new_slot(c, 8, 8, "b");
  lf.params = push_islot(lf.params, as_);
  lf.param_types = push_type(lf.param_types, null);
  lf.params = push_islot(lf.params, bs);
  lf.param_types = push_type(lf.param_types, null);
  let pa: *IRVreg = v_load(c, v_slotaddr(c, as_), IRType.ItPtr);
  let pb: *IRVreg = v_load(c, v_slotaddr(c, bs), IRType.ItPtr);
  let rs: *IRSlot = new_slot(c, 8, 8, "eq");
  v_store(c, v_slotaddr(c, rs), v_const(c, 1, IRType.ItU8));
  eq_walk(c, t, pa, pb, rs);
  emit_ret(c, v_load(c, v_slotaddr(c, rs), IRType.ItU8));
  finish_fn_c(c);
  return sym;
}

// AND one field/variant comparison into the result slot
fn eq_and(c: *LCtx, rs: *IRSlot, v: *IRVreg) {
  let cur: *IRVreg = v_load(c, v_slotaddr(c, rs), IRType.ItU8);
  let both: *IRVreg = v_binop(c, IROp.IrAnd, cur, v, IRType.ItU8, false);
  v_store(c, v_slotaddr(c, rs), both);
}

// compare a single non-aggregate field at pa/pb (same offset)
fn eq_field(c: *LCtx, ft: *Type, fa: *IRVreg, fb: *IRVreg, rs: *IRSlot) {
  if ft.kind == TypeKind.TyEnum || ft.kind == TypeKind.TyStruct {
    let fnn: string = eq_fn_for(ft);
    let call: *IRIns = emit(c, IROp.IrCall);
    call.callee = fnn;
    call.args = push_vreg(call.args, fa);
    call.args = push_vreg(call.args, fb);
    call.dst = new_vreg(c, IRType.ItU8);
    eq_and(c, rs, call.dst);
    return;
  }
  let irt: IRType = ir_type_of(ft);
  let va: *IRVreg = v_load(c, fa, irt);
  let vb: *IRVreg = v_load(c, fb, irt);
  let same: *IRVreg = v_cmp(c, IRCC.CcEq, va, vb, ir_is_float_t(irt));
  eq_and(c, rs, same);
}

fn eq_walk(c: *LCtx, t: *Type, pa: *IRVreg, pb: *IRVreg, rs: *IRSlot) {
  if t.kind == TypeKind.TyEnum {
    let d: *Decl = t.rec.decl;
    let tag_a: *IRVreg = v_load(c, pa, IRType.ItI32);
    // tags differ -> false
    let tag_b: *IRVreg = v_load(c, pb, IRType.ItI32);
    let same_tag: *IRVreg = v_cmp(c, IRCC.CcEq, tag_a, tag_b, false);
    let body: *IRBlock = new_block(c);
    let no: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    emit_cbr(c, same_tag, body, no, done);
    use_block(c, no);
    v_store(c, v_slotaddr(c, rs), v_const(c, 0, IRType.ItU8));
    emit_br(c, done);
    use_block(c, body);
    // per variant: only its own fields, gated on the tag
    let mut vi: usize = 0;
    while vi < d.variants.n {
      let v: *VariantAst = d.variants.items[vi];
      let mut nf: usize = 0;
      if v.vkind == VarKind.VarTuple {
        nf = v.types.n;
      } else if v.vkind == VarKind.VarStruct {
        nf = v.fields.n;
      }
      if nf > 0 {
        let mine: *IRBlock = new_block(c);
        let next: *IRBlock = new_block(c);
        let is: *IRVreg = v_cmp(c, IRCC.CcEq, tag_a, v_const(c, v.disc as i64, IRType.ItI32), false);
        emit_cbr(c, is, mine, next, done);
        use_block(c, mine);
        let mut fi: usize = 0;
        while fi < nf {
          let ft: *Type = variant_field_type(t, vi as i32, fi as i32);
          let off: i64 = variant_field_offset(t, vi as i32, fi as i32);
          eq_field(c, ft, v_addi(c, pa, off), v_addi(c, pb, off), rs);
          fi += 1;
        }
        emit_br(c, next);
        use_block(c, next);
      }
      vi += 1;
    }
    emit_br(c, done);
    use_block(c, done);
    return;
  }
  // struct: straight field walk
  let rec: *RecType = t.rec;
  let sd: *Decl = rec.decl;
  let mut i: usize = 0;
  while i < sd.fields.n {
    let ft: *Type = struct_field_type(rec, i);
    let off: i64 = struct_field_offset(rec, i);
    eq_field(c, ft, v_addi(c, pa, off), v_addi(c, pb, off), rs);
    i += 1;
  }
}

// lift a closure literal into a standalone fn + env snapshot layout;
// returns the code symbol, with the env drop glue name in envdrop_out
fn lift_closure(c: *LCtx, e: *Expr, envdrop_out: *Vec[string]) -> string {
  let ft: *Type = e.typed;
  let ret: *Type = ft.ret;
  let agg_ret: bool = ret != null && ty_is_aggregate(ret);
  let clo_id: i32 = g_closure_counter;
  g_closure_counter += 1;
  let sym_name: string = cat3(c.f.symbol, "__clo", cat3(itoa(clo_id as i64), "", ""));
  let lf: *IRFn = rc_new_fn(sym_name);
  lf.ret = ret;
  let cc: *LCtx = rc_ctx(lf);
  if agg_ret {
    lf.returns_aggregate = true;
    lf.out_slot = new_slot(cc, type_size(ret), type_align(ret), "out");
  }
  // rc_new_fn already created the entry block; use it directly (a second
  // block here left an empty B0 first, so lifted closures returned at once)
  scope_push_l(cc);

  let mut i: usize = 0;
  while i < e.params.n {
    let pa: *Param = e.params.items[i];
    let pt: *Type = ft.params[i];
    let slot: *IRSlot = new_slot(cc, type_size(pt), type_align(pt), pa.name);
    lf.params = push_islot(lf.params, slot);
    lf.param_types = push_type(lf.param_types, pt);
    if ty_is_aggregate(pt) {
      let local: *IRSlot = new_slot(cc, type_size(pt), type_align(pt), pa.name);
      let src_addr: *IRVreg = v_slotaddr(cc, slot);
      let src: *IRVreg = v_load(cc, src_addr, IRType.ItPtr);
      let dst: *IRVreg = v_slotaddr(cc, local);
      let cp: *IRIns = emit(cc, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = src;
      cp.size = type_size(pt);
      lbind(cc, pa.name, local);
    } else {
      lbind(cc, pa.name, slot);
    }
    i += 1;
  }
  let env: *IRSlot = new_slot(cc, 8, 8, "env");
  lf.params = push_islot(lf.params, env);
  lf.param_types = push_type(lf.param_types, null);

  // captures materialize into plain slots from the env data pointer
  let mut off: i64 = 0;
  let mut ci: usize = 0;
  while ci < len(e.caps) {
    let cap: *Sym = e.caps[ci];
    let ct: *Type = cap.type;
    let al: i64 = type_align(ct);
    off = round_up_i64(off, al);
    let envp: *IRVreg = v_load(cc, v_slotaddr(cc, env), IRType.ItPtr);
    let srcaddr: *IRVreg = v_addi(cc, envp, off);
    let slot: *IRSlot = new_slot(cc, type_size(ct), type_align(ct), cap.name);
    let dst: *IRVreg = v_slotaddr(cc, slot);
    if ty_is_aggregate(ct) {
      let cp: *IRIns = emit(cc, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = srcaddr;
      cp.size = type_size(ct);
    } else {
      let v: *IRVreg = v_load(cc, srcaddr, ir_type_of(ct));
      v_store(cc, dst, v);
    }
    lbind(cc, cap.name, slot);
    off += type_size(ct);
    ci += 1;
  }

  let mut si: usize = 0;
  while si < e.items.n {
    lv_stmt(cc, e.items.items[si]);
    si += 1;
  }
  if lf.cur.term_op == 0 {
    run_defers(cc, null);
    emit_ret(cc, null);
  }
  scope_pop_l(cc);
  g_ir_fns.push(lf);

  // env drop glue: releases every captured value when the env object dies
  let envdrop: string = cat3("rho__envdrop$", itoa(clo_id as i64), "");
  let df: *IRFn = rc_new_fn(envdrop);
  let dc: *LCtx = rc_ctx(df);
  let das: *IRSlot = new_slot(dc, 8, 8, "addr");
  df.params = push_islot(df.params, das);
  df.param_types = push_type(df.param_types, null);
  let daddr: *IRVreg = v_load(dc, v_slotaddr(dc, das), IRType.ItPtr);
  let mut doff: i64 = 0;
  let mut di: usize = 0;
  while di < len(e.caps) {
    let cap: *Sym = e.caps[di];
    let ct: *Type = cap.type;
    let al: i64 = type_align(ct);
    doff = round_up_i64(doff, al);
    let cap_addr: *IRVreg = v_addi(dc, daddr, doff); // always: keeps vreg numbering
    let fnn: string = value_fn_for(ct, false);
    if fnn != "" {
      rc_call1(dc, fnn, cap_addr);
    }
    doff += type_size(ct);
    di += 1;
  }
  finish_fn_c(dc);
  envdrop_out.items[0] = envdrop;
  return sym_name;
}

// ------------------------------------------------------------- lvalues ----

fn compute_addr(c: *LCtx, e: *Expr) -> *IRVreg {
  if e.kind == ExprKind.ExStr {
    // string literal used in address context: materialize its slice temp
    return lv_expr(c, e);
  }
  if e.kind == ExprKind.ExName {
    let sym: *Sym = e.sym;
    let slot: *IRSlot = lookup_slot(c, e.sv);
    if slot != null {
      return v_slotaddr(c, slot);
    }
    if sym != null && sym.kind == SymKind.SyStatic {
      let i: *IRIns = emit(c, IROp.IrAddrc);
      i.dst = new_vreg(c, IRType.ItPtr);
      i.callee = sym_symbol(sym); // on demand: lower order is map order
      i.lit = -1;                 // marks global-address form
      return i.dst;
    }
    if sym != null && sym.kind == SymKind.SyConst {
      // constants have no storage; caller only hits this for aggregates
      panic_call(c, "internal: constant has no address");
      return v_const(c, 0, IRType.ItPtr);
    }
    panic_call(c, "internal: unbound name");
    return v_const(c, 0, IRType.ItPtr);
  }
  if e.kind == ExprKind.ExField {
    let bt: *Type = e.a.typed;
    // slice/string built-in fields: {buf, ptr, len}
    let mut value_t: *Type = bt;
    let mut through_ptr: bool = false;
    if value_t != null && value_t.kind == TypeKind.TyPtr {
      value_t = value_t.elem;
      through_ptr = true;
    }
    if value_t != null && (value_t.kind == TypeKind.TySlice || value_t.kind == TypeKind.TyStringK) {
      let mut off: i64 = 0;
      if streq(e.sv, "len") {
        off = 16;
      } else if streq(e.sv, "ptr") {
        off = 8;
      } else {
        panic_call(c, "internal: bad slice field");
        return v_const(c, 0, IRType.ItPtr);
      }
      if through_ptr {
        return v_addi(c, null_check(c, lv_expr(c, e.a)), off);
      }
      return v_addi(c, lv_expr(c, e.a), off);
    }
    if bt != null && bt.kind == TypeKind.TyPtr {
      let base: *IRVreg = null_check(c, lv_expr(c, e.a));
      return v_addi(c, base, struct_field_offset(bt.elem.rec, field_index_of(e, bt.elem.rec) as usize));
    }
    let base2: *IRVreg = compute_addr(c, e.a);
    return v_addi(c, base2, struct_field_offset(bt.rec, field_index_of(e, bt.rec) as usize));
  }
  if e.kind == ExprKind.ExIndex {
    let bt: *Type = e.a.typed;
    let idx: *IRVreg = lv_expr(c, e.b);
    let mut baseaddr: *IRVreg = null;
    let mut esize: i64 = type_size(bt.elem);
    if bt.kind == TypeKind.TyStringK {
      esize = 1;
    }
    if bt.kind == TypeKind.TyArray {
      baseaddr = compute_addr(c, e.a);
      bounds_check(c, idx, v_const(c, bt.len as i64, IRType.ItUsize));
    } else {
      // slice: {buf, ptr, len}
      let sliceaddr: *IRVreg = compute_addr(c, e.a);
      let len_v: *IRVreg = v_load(c, v_addi(c, sliceaddr, 16), IRType.ItUsize);
      bounds_check(c, idx, len_v);
      baseaddr = v_load(c, v_addi(c, sliceaddr, 8), IRType.ItPtr);
    }
    let esz: *IRVreg = v_const(c, esize, IRType.ItUsize);
    let mul: *IRIns = emit(c, IROp.IrMul);
    mul.dst = new_vreg(c, IRType.ItUsize);
    mul.a = idx;
    mul.b = esz;
    let add: *IRIns = emit(c, IROp.IrAdd);
    add.dst = new_vreg(c, IRType.ItPtr);
    add.a = baseaddr;
    add.b = mul.dst;
    return add.dst;
  }
  if e.kind == ExprKind.ExUn {
    // *ptr
    return null_check(c, lv_expr(c, e.a));
  }
  panic_call(c, "internal: not an lvalue");
  return v_const(c, 0, IRType.ItPtr);
}

fn field_index_of(e: *Expr, rec: *RecType) -> i32 {
  let d: *Decl = rec.decl;
  let mut i: usize = 0;
  while i < d.fields.n {
    let fa: *FieldAst = d.fields.items[i];
    if streq(fa.name, e.sv) {
      return i as i32;
    }
    i += 1;
  }
  return 0;
}
fn v_cast(c: *LCtx, src: *IRVreg, to: IRType) -> *IRVreg {
  let v: *IRVreg = new_vreg(c, to);
  let i: *IRIns = emit(c, IROp.IrCast);
  i.dst = v;
  i.a = src;
  i.cast_from = src.ty;
  i.cast_to = to;
  // classify
  if ir_is_float_t(src.ty) && ir_is_float_t(to) {
    if src.ty == IRType.ItF32 && to == IRType.ItF64 {
      i.cast = IRCastKind.CastF32F64;
    } else {
      i.cast = IRCastKind.CastF64F32;
    }
  } else if ir_size_of(src.ty) == ir_size_of(to) &&
             ir_is_float_t(src.ty) && !ir_is_float_t(to) &&
             (to == IRType.ItU32 || to == IRType.ItU64) {
    i.cast = IRCastKind.CastReinterp; // exact bit move (f32_bits/f64_bits)
  } else if ir_is_float_t(src.ty) {
    i.cast = IRCastKind.CastF2i;
  } else if ir_is_float_t(to) {
    i.cast = IRCastKind.CastI2f;
  } else if ir_size_of(src.ty) > ir_size_of(to) {
    i.cast = IRCastKind.CastTrunc;
  } else if ir_size_of(src.ty) < ir_size_of(to) {
    if ty_is_signed_int(src.ty) {
      i.cast = IRCastKind.CastSext;
    } else {
      i.cast = IRCastKind.CastZext;
    }
  } else {
    i.cast = IRCastKind.CastBitcopy;
  }
  return v;
}

// ------------------------------------------------------------ expressions --

fn lv_expr(c: *LCtx, e: *Expr) -> *IRVreg {
  let t: *Type = e.typed;
  if e.kind == ExprKind.ExInt {
    return v_const(c, e.iv as i64, ir_type_of(t));
  }
  if e.kind == ExprKind.ExFloat {
    return fconst(c, e.fv, ir_type_of(t));
  }
  if e.kind == ExprKind.ExBool {
    let mut b: i64 = 0;
    if e.bv {
      b = 1;
    }
    return v_const(c, b, IRType.ItU8);
  }
  if e.kind == ExprKind.ExNull {
    return v_const(c, 0, IRType.ItPtr);
  }
  if e.kind == ExprKind.ExName {
    let sym: *Sym = e.sym;
    if sym != null && sym.kind == SymKind.SyConst {
      if sym.decl.ceval_ok && sym.decl.ceval_is_int {
        return v_const(c, sym.decl.ceval_i as i64, ir_type_of(t));
      }
      if sym.decl.ceval_ok && !sym.decl.ceval_is_int && t != null &&
         (t.kind == TypeKind.TyF32 || t.kind == TypeKind.TyF64) {
        return fconst(c, sym.decl.ceval_f, ir_type_of(t));
      }
      if t != null && ty_is_aggregate(t) {
        return compute_addr(c, e);
      }
      return v_const(c, 0, ir_type_of(t));
    }
    if e.fnval && sym != null &&
       (sym.kind == SymKind.SyFn || sym.kind == SymKind.SyExtern) {
      return closure_value_for_sym(c, sym);
    }
    if t != null && ty_is_aggregate(t) {
      return compute_addr(c, e);
    }
    let slot: *IRSlot = lookup_slot(c, e.sv);
    if slot == null {
      if sym != null && sym.kind == SymKind.SyStatic {
        let i: *IRIns = emit(c, IROp.IrAddrc);
        i.dst = new_vreg(c, IRType.ItPtr);
        i.callee = sym_symbol(sym);
        i.lit = -1;
        return v_load(c, i.dst, ir_type_of(t));
      }
      return v_const(c, 0, ir_type_of(t));
    }
    return v_load(c, v_slotaddr(c, slot), ir_type_of(t));
  }
  if e.kind == ExprKind.ExStr {
    // slice value: {lit(header), lit+24(bytes), len} — the literal carries
    // an immortal 24-byte rc header, so count traffic on it is a no-op
    let tmp: *IRSlot = new_slot(c, 24, 8, "strlit");
    let addr: *IRVreg = v_slotaddr(c, tmp);
    let lit: i32 = lit_bytes(c, e.sv);
    let ptrv: *IRVreg = new_vreg(c, IRType.ItPtr);
    let la: *IRIns = emit(c, IROp.IrLitaddr);
    la.dst = ptrv;
    la.lit = lit;
    let bytes: *IRVreg = v_addi(c, ptrv, 24);
    let a8: *IRVreg = v_addi(c, addr, 8);
    let a16: *IRVreg = v_addi(c, addr, 16);
    let lenv: *IRVreg = v_const(c, len(e.sv) as i64, IRType.ItUsize);
    let s1: *IRIns = emit(c, IROp.IrStore);
    s1.addr = addr;
    s1.a = ptrv;
    s1.size = 8;
    let s2: *IRIns = emit(c, IROp.IrStore);
    s2.addr = a8;
    s2.a = bytes;
    s2.size = 8;
    let s3: *IRIns = emit(c, IROp.IrStore);
    s3.addr = a16;
    s3.a = lenv;
    s3.size = 8;
    return addr;
  }
  if e.kind == ExprKind.ExUn {
    if e.unop == Tok.PStar {
      let p: *IRVreg = null_check(c, lv_expr(c, e.a));
      let pointee: *Type = e.typed;
      if pointee != null && ty_is_aggregate(pointee) {
        return p;
      }
      return v_load(c, p, ir_type_of(pointee));
    }
    let ty: IRType = ir_type_of(t);
    // forward the context-adapted node type to a literal operand: the
    // child of `-2.75` in an f32 position must materialize as f32, not as
    // the unadapted FLOAT_LIT default
    if e.unop == Tok.PMinus && (e.a.kind == ExprKind.ExFloat || e.a.kind == ExprKind.ExInt) {
      e.a.typed = t;
    }
    let a: *IRVreg = lv_expr(c, e.a);
    if e.unop == Tok.PBang {
      return v_cmp(c, IRCC.CcEq, a, v_const(c, 0, a.ty), false);
    }
    if e.unop == Tok.PTilde {
      return v_binop(c, IROp.IrXor, a, v_const(c, -1, a.ty), a.ty, false);
    }
    if e.unop == Tok.PMinus {
      if ir_is_float_t(ty) {
        // negate via a float zero (0.0 - x), at the expression's width
        let zero: *IRVreg = fconst(c, 0.0, ty);
        let i: *IRIns = emit(c, IROp.IrSub);
        i.dst = new_vreg(c, ty);
        i.a = zero;
        i.b = a;
        i.is_float = true;
        i.signed_ops = true;
        return i.dst;
      }
      let zero2: *IRVreg = v_const(c, 0, a.ty);
      return v_binop(c, IROp.IrSub, zero2, a, a.ty, true);
    }
    return v_const(c, 0, ty);
  }
  if e.kind == ExprKind.ExCast {
    let src_t: *Type = e.a.typed;
    if src_t.kind == TypeKind.TyEnum {
      let addr: *IRVreg = lv_expr(c, e.a); // aggregate: address
      let tag: *IRVreg = v_load(c, addr, IRType.ItI32);
      return v_cast(c, tag, ir_type_of(t));
    }
    let a: *IRVreg = lv_expr(c, e.a);
    return v_cast(c, a, ir_type_of(t));
  }
  if e.kind == ExprKind.ExBin {
    let op: Tok = e.binop;
    if op == Tok.PAndand || op == Tok.POror {
      let rhs: *IRBlock = new_block(c);
      let join: *IRBlock = new_block(c);
      let phi: *IRPhi = emit_phi_in(c, join, IRType.ItU8);
      let l: *IRVreg = lv_expr(c, e.a);
      let l_as_u8: *IRVreg = v_cast(c, l, IRType.ItU8); // dead but keeps vreg numbering
      // short-circuit consts must precede the branch: phi edges read them
      let sc_zero: *IRVreg = v_const(c, 0, IRType.ItU8);
      let sc_one: *IRVreg = v_const(c, 1, IRType.ItU8);
      // the phi's lhs edge is the block the cbr actually branches from; a
      // nested `||`/`&&` lhs ends in its own join block, not where we started
      let lhs_block: *IRBlock = c.f.cur;
      if op == Tok.PAndand {
        emit_cbr(c, l, rhs, join, join);
      } else {
        emit_cbr(c, l, join, rhs, join);
      }
      use_block(c, rhs);
      let r: *IRVreg = lv_expr(c, e.b);
      let r_as_u8: *IRVreg = v_cast(c, r, IRType.ItU8);
      let rhs_block: *IRBlock = c.f.cur;
      emit_br(c, join);
      use_block(c, join);
      if op == Tok.PAndand {
        phi_add(phi, lhs_block, sc_zero);
      } else {
        phi_add(phi, lhs_block, sc_one);
      }
      phi_add(phi, rhs_block, r_as_u8);
      return phi.dst;
    }
    let mut a: *IRVreg = lv_expr(c, e.a);
    let mut b: *IRVreg = lv_expr(c, e.b);
    let ty: IRType = ir_type_of(t);
    // int arithmetic computes at the consumer-pinned width: TyIntLit
    // operands default to i32, and `let cap: usize = 1 << 16` would
    // otherwise store only 32 bits into the 8-byte slot, leaving the
    // high half as stack garbage (boot's lower.c carries the same fix)
    if ty_is_int(t) && t.kind != TypeKind.TyIntLit {
      if a.ty != ty {
        a = v_cast(c, a, ty);
      }
      if b.ty != ty {
        b = v_cast(c, b, ty);
      }
    }
    let flt: bool = ir_is_float_t(a.ty);
    if op == Tok.PPlus { return v_binop(c, IROp.IrAdd, a, b, a.ty, true); }
    if op == Tok.PMinus { return v_binop(c, IROp.IrSub, a, b, a.ty, true); }
    if op == Tok.PStar { return v_binop(c, IROp.IrMul, a, b, a.ty, flt); }
    if op == Tok.PSlash {
      let mut sgn: bool = flt;
      if ty_is_signed_int(a.ty) {
        sgn = true;
      }
      return v_binop(c, IROp.IrDiv, a, b, a.ty, sgn);
    }
    if op == Tok.PPercent { return v_binop(c, IROp.IrMod, a, b, a.ty, ty_is_signed_int(a.ty)); }
    if op == Tok.PAmp { return v_binop(c, IROp.IrAnd, a, b, a.ty, false); }
    if op == Tok.PPipe { return v_binop(c, IROp.IrOr, a, b, a.ty, false); }
    if op == Tok.PCaret { return v_binop(c, IROp.IrXor, a, b, a.ty, false); }
    if op == Tok.PShl { return v_binop(c, IROp.IrShl, a, b, a.ty, false); }
    if op == Tok.PShr { return v_binop(c, IROp.IrShr, a, b, a.ty, ty_is_signed_int(a.ty)); }
    if op == Tok.PEq || op == Tok.PNe {
      let mut want_eq: bool = false;
      if op == Tok.PEq {
        want_eq = true;
      }
      let lt: *Type = e.a.typed;
      if lt != null && lt.kind == TypeKind.TyStringK {
        return call_str_cmp(c, e, want_eq);
      }
      if lt != null && lt.kind == TypeKind.TyEnum {
        // a and b are aggregate addresses: compare through tags/glue
        let mut payloadful: bool = false;
        let d: *Decl = lt.rec.decl;
        let mut vi: usize = 0;
        while vi < d.variants.n {
          let v: *VariantAst = d.variants.items[vi];
          if v.vkind != VarKind.VarUnit {
            payloadful = true;
          }
          vi += 1;
        }
        if !payloadful {
          let ta: *IRVreg = v_load(c, a, IRType.ItI32);
          let tb: *IRVreg = v_load(c, b, IRType.ItI32);
          let mut cc: IRCC = IRCC.CcNe;
          if want_eq {
            cc = IRCC.CcEq;
          }
          return v_cmp(c, cc, ta, tb, false);
        }
        let fnn: string = eq_fn_for(lt);
        let call: *IRIns = emit(c, IROp.IrCall);
        call.callee = fnn;
        call.args = push_vreg(call.args, a);
        call.args = push_vreg(call.args, b);
        call.dst = new_vreg(c, IRType.ItU8);
        if want_eq {
          return call.dst;
        }
        return v_cmp(c, IRCC.CcEq, call.dst, v_const(c, 0, IRType.ItU8), false);
      }
      if want_eq {
        return v_cmp(c, IRCC.CcEq, a, b, flt);
      }
      return v_cmp(c, IRCC.CcNe, a, b, flt);
    }
    if op == Tok.PLt { return v_cmp(c, IRCC.CcLt, a, b, flt); }
    if op == Tok.PLe { return v_cmp(c, IRCC.CcLe, a, b, flt); }
    if op == Tok.PGt { return v_cmp(c, IRCC.CcGt, a, b, flt); }
    if op == Tok.PGe { return v_cmp(c, IRCC.CcGe, a, b, flt); }
    return v_const(c, 0, ty);
  }
  if e.kind == ExprKind.ExSlice {
    return lower_slice(c, e);
  }
  if e.kind == ExprKind.ExIndex {
    let t2: *Type = e.typed;
    if t2 != null && ty_is_aggregate(t2) {
      return compute_addr(c, e);
    }
    return v_load(c, compute_addr(c, e), ir_type_of(t2));
  }
  if e.kind == ExprKind.ExField {
    let t2: *Type = e.typed;
    let fsym: *Sym = e.sym;
    if e.fnval && fsym != null &&
       (fsym.kind == SymKind.SyFn || fsym.kind == SymKind.SyExtern) {
      return closure_value_for_sym(c, fsym);
    }
    // unit enum variant used as a value: materialize {tag, zeros}
    if e.sym != null && e.sym.kind == SymKind.SyVariant {
      let vs: *Sym = e.sym;
      let ed: *Decl = vs.decl;
      let disc: u64 = ed.variants.items[vs.variant_index].disc;
      let tmp: *IRSlot = new_slot(c, type_size(t2), type_align(t2), "enumval");
      let dest: *IRVreg = v_slotaddr(c, tmp);
      let tagv: *IRVreg = v_const(c, disc as i64, IRType.ItI32);
      let a4: *IRVreg = v_addi(c, dest, 4);
      let mut rest: i64 = type_size(t2) - 4;
      if rest < 0 {
        rest = 0;
      }
      let tag: *IRIns = emit(c, IROp.IrStore);
      tag.addr = dest;
      tag.a = tagv;
      tag.size = 4;
      if rest > 0 {
        let z: *IRIns = emit(c, IROp.IrZero);
        z.addr = a4;
        z.size = rest;
      }
      return dest;
    }
    // module-qualified statics and consts: `mod.ITEM`
    if fsym != null && (fsym.kind == SymKind.SyStatic || fsym.kind == SymKind.SyConst) {
      if fsym.kind == SymKind.SyConst {
        if fsym.decl.ceval_ok && fsym.decl.ceval_is_int {
          return v_const(c, fsym.decl.ceval_i as i64, ir_type_of(t2));
        }
        if fsym.decl.ceval_ok && !fsym.decl.ceval_is_int && t2 != null &&
           (t2.kind == TypeKind.TyF32 || t2.kind == TypeKind.TyF64) {
          return fconst(c, fsym.decl.ceval_f, ir_type_of(t2));
        }
        if t2 != null && ty_is_aggregate(t2) {
          panic_call(c, "internal: constant has no address");
        }
        return v_const(c, 0, ir_type_of(t2));
      }
      let gi: *IRIns = emit(c, IROp.IrAddrc);
      gi.dst = new_vreg(c, IRType.ItPtr);
      gi.callee = sym_symbol(fsym);
      gi.lit = 0 - 1; // global-address form
      if t2 != null && ty_is_aggregate(t2) {
        return gi.dst;
      }
      return v_load(c, gi.dst, ir_type_of(t2));
    }
    if t2 != null && ty_is_aggregate(t2) {
      return compute_addr(c, e);
    }
    return v_load(c, compute_addr(c, e), ir_type_of(t2));
  }
  if e.kind == ExprKind.ExCall {
    if is_make_call(e) {
      return lower_make(c, e, null);
    }
    return compute_call_value(c, e);
  }
  if e.kind == ExprKind.ExDynbox {
    // {vtable, obj} box: obj = the *T value; owned producers hand over
    // their count, borrowed operands get a +1 (boot lv EX_DYNBOX)
    let obj: *IRVreg = lv_expr(c, e.a);
    let owned: bool = expr_owned(e.a);
    let boxed: *Type = e.a.typed; // *T
    let vt: *IRVreg = vtable_ensure(c, boxed.elem, e.typed.rec);
    let tmp: *IRSlot = new_slot(c, 16, 8, "dynval");
    let addr: *IRVreg = v_slotaddr(c, tmp);
    let obj_addr: *IRVreg = v_addi(c, addr, 8); // operands before their stores
    let s1: *IRIns = emit(c, IROp.IrStore);
    s1.addr = addr;
    s1.a = vt;
    s1.size = 8;
    let s2: *IRIns = emit(c, IROp.IrStore);
    s2.addr = obj_addr;
    s2.a = obj;
    s2.size = 8;
    if !owned {
      rc_inc_v(c, obj);
    }
    return addr;
  }
  if e.kind == ExprKind.ExNew {
    return lower_new(c, e);
  }
  if e.kind == ExprKind.ExClosure {
    let envdrop_box: *Vec[string] = new Vec[string] { items: make([]string, 1), n: 1 };
    let sym_name: string = lift_closure(c, e, envdrop_box);
    // env object: header + snapshot of every capture
    let mut esz: i64 = 0;
    let mut ci: usize = 0;
    while ci < len(e.caps) {
      let ct: *Type = e.caps[ci].type;
      let al: i64 = type_align(ct);
      esz = round_up_i64(esz, al) + type_size(ct);
      ci += 1;
    }
    let sz: *IRVreg = v_const(c, esz + 24, IRType.ItUsize);
    let obj: *IRVreg = call_prelude1(c, "__alloc", sz, IRType.ItPtr);
    let obj8: *IRVreg = v_addi(c, obj, 8);
    let obj16: *IRVreg = v_addi(c, obj, 16);
    let rc1: *IRVreg = v_const(c, 1, IRType.ItUsize);
    let rc: *IRIns = emit(c, IROp.IrStore);
    rc.addr = obj;
    rc.a = rc1;
    rc.size = 8;
    let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
    let wrc: *IRIns = emit(c, IROp.IrStore);
    wrc.addr = obj8;
    wrc.a = zero;
    wrc.size = 8;
    let mut dropv: *IRVreg = v_const(c, 0, IRType.ItPtr);
    if len(e.caps) > 0 {
      let ga: *IRIns = emit(c, IROp.IrAddrc);
      ga.dst = new_vreg(c, IRType.ItPtr);
      ga.callee = envdrop_box.items[0];
      ga.lit = -1;
      dropv = ga.dst;
    }
    let dr: *IRIns = emit(c, IROp.IrStore);
    dr.addr = obj16;
    dr.a = dropv;
    if g_target_wasm {
      dr.size = 4;
    } else {
      dr.size = 8;
    }
    let mut off: i64 = 0;
    let mut si: usize = 0;
    while si < len(e.caps) {
      let cap: *Sym = e.caps[si];
      let ct: *Type = cap.type;
      let al: i64 = type_align(ct);
      off = round_up_i64(off, al);
      let daddr: *IRVreg = v_addi(c, obj, 24 + off);
      let srcaddr: *IRVreg = v_slotaddr(c, lookup_slot(c, cap.name));
      if ty_is_aggregate(ct) {
        let cp: *IRIns = emit(c, IROp.IrCopymem);
        cp.addr = daddr;
        cp.a = srcaddr;
        cp.size = type_size(ct);
      } else {
        let v: *IRVreg = v_load(c, srcaddr, ir_type_of(ct));
        v_store(c, daddr, v);
      }
      if ty_is_managed(ct) {
        retain_addr(c, ct, daddr); // the env owns its snapshot
      }
      off += type_size(ct);
      si += 1;
    }
    // the value: {code, env=data pointer}
    let la: *IRIns = emit(c, IROp.IrAddrc);
    la.dst = new_vreg(c, IRType.ItPtr);
    la.callee = sym_name;
    la.lit = -1;
    let envp: *IRVreg = v_addi(c, obj, 24);
    let tmp: *IRSlot = new_slot(c, 16, 8, "cloval");
    let addr: *IRVreg = v_slotaddr(c, tmp);
    let a8: *IRVreg = v_addi(c, addr, 8);
    let s1: *IRIns = emit(c, IROp.IrStore);
    s1.addr = addr;
    s1.a = la.dst;
    s1.size = 8;
    let s2: *IRIns = emit(c, IROp.IrStore);
    s2.addr = a8;
    s2.a = envp;
    s2.size = 8;
    return addr;
  }
  if e.kind == ExprKind.ExMake {
    if t != null && ty_is_aggregate(t) {
      return compute_addr(c, e);
    }
    return compute_call_value(c, e);
  }
  if e.kind == ExprKind.ExIf {
    if t == null || t.kind == TypeKind.TyVoid {
      // statement context: no value to merge
      let then_b: *IRBlock = new_block(c);
      let join: *IRBlock = new_block(c);
      let mut has_else: bool = false;
      if e.items.n > 1 || e.else_if != null {
        has_else = true;
      }
      let mut false_b: *IRBlock = join;
      if has_else {
        false_b = new_block(c);
      }
      let cond: *IRVreg = lv_expr(c, e.a);
      emit_cbr(c, cond, then_b, false_b, join);
      use_block(c, then_b);
      // each arm gets its own scope: a `let` inside an arm must release at
      // the arm's end, not at the enclosing loop's back edge
      scope_push_l(c);
      lv_stmts(c, e.items.items[0].stmts);
      run_defers(c, c.scope.parent);
      scope_pop_release(c);
      emit_br(c, join);
      if has_else {
        use_block(c, false_b);
        if e.else_if != null {
          lv_expr(c, e.else_if);
        } else {
          let els: *Stmt = e.items.items[1];
          scope_push_l(c);
          lv_stmts(c, els.stmts);
          run_defers(c, c.scope.parent);
          scope_pop_release(c);
        }
        emit_br(c, join);
      }
      use_block(c, join);
      return v_const(c, 0, IRType.ItU8);
    }
    let then_b2: *IRBlock = new_block(c);
    let join2: *IRBlock = new_block(c);
    let mut false_b2: *IRBlock = join2;
    if e.items.n > 1 || e.else_if != null {
      false_b2 = new_block(c);
    }
    let phi: *IRPhi = emit_phi_in(c, join2, ir_type_of(t));
    let cond2: *IRVreg = lv_expr(c, e.a);
    emit_cbr(c, cond2, then_b2, false_b2, join2);
    use_block(c, then_b2);
    let then_stmts: *Vec[*Stmt] = e.items.items[0].stmts;
    let tv: *IRVreg = block_value(c, then_stmts, t);
    if ty_is_managed(t) && !arm_value_owned(then_stmts) {
      retain_or_inc(c, t, tv);
    }
    let then_end: *IRBlock = c.f.cur;
    emit_br(c, join2);
    let mut ev: *IRVreg = null;
    let mut else_end: *IRBlock = null;
    if e.items.n > 1 {
      use_block(c, false_b2);
      if e.else_if != null {
        ev = lv_expr(c, e.else_if); // nested ifs normalize their own arms
      } else {
        let els2: *Stmt = e.items.items[1];
        let es: *Vec[*Stmt] = els2.stmts;
        ev = block_value(c, es, t);
        if ty_is_managed(t) && !arm_value_owned(es) {
          retain_or_inc(c, t, ev);
        }
      }
      else_end = c.f.cur;
      emit_br(c, join2);
      use_block(c, join2);
    } else {
      use_block(c, join2);
    }
    phi_add(phi, then_end, tv);
    if e.items.n > 1 {
      phi_add(phi, else_end, ev);
    }
    return phi.dst;
  }
  if e.kind == ExprKind.ExMatch {
    // chain of comparisons; arm values merge at a phi
    let join: *IRBlock = new_block(c);
    let phi: *IRPhi = emit_phi_in(c, join, ir_type_of(t));
    let scrut_t: *Type = e.a.typed;
    let scrut: *IRVreg = lv_expr(c, e.a);
    let mut disc: *IRVreg = null;
    if scrut_t.kind == TypeKind.TyEnum {
      disc = v_load(c, scrut, IRType.ItI32); // scrutinee addr (aggregate)
    }
    let n: usize = e.arms.n;
    let mut i: usize = 0;
    while i < n {
      let arm: *MatchArm = e.arms.items[i];
      let body: *IRBlock = new_block(c);
      let mut next: *IRBlock = join;
      if i + 1 < n {
        next = new_block(c);
      }
      if arm.pk == PatKind.PatWildcard {
        emit_br(c, body);
      } else if scrut_t.kind == TypeKind.TyEnum {
        let is: *IRVreg = v_cmp(c, IRCC.CcEq, disc, v_const(c, arm.disc as i64, IRType.ItI32), false);
        emit_cbr(c, is, body, next, join);
      } else {
        let is2: *IRVreg = v_cmp(c, IRCC.CcEq, scrut, v_const(c, arm.pat_int as i64, scrut.ty), false);
        emit_cbr(c, is2, body, next, join);
      }
      use_block(c, body);
      let bind_scope: bool = len(arm.bind_syms) > 0;
      if bind_scope {
        // payload bindings: slots copied out of the scrutinee's payload area
        scope_push_l(c);
        let mut bi: usize = 0;
        while bi < len(arm.bind_syms) {
          let bs: *Sym = arm.bind_syms[bi];
          if bs != null {
            let ft: *Type = bs.type;
            let mut fidx: i32 = bi as i32;
            if bi < len(arm.bind_fidx) {
              fidx = arm.bind_fidx[bi] as i32;
            }
            let off: i64 = variant_field_offset(scrut_t, arm.variant_index, fidx);
            let faddr: *IRVreg = v_addi(c, scrut, off);
            let slot: *IRSlot = new_slot(c, type_size(ft), type_align(ft), bs.name);
            lbind(c, bs.name, slot);
            let saddr: *IRVreg = v_slotaddr(c, slot);
            if ty_is_aggregate(ft) {
              let cp: *IRIns = emit(c, IROp.IrCopymem);
              cp.addr = saddr;
              cp.a = faddr;
              cp.size = type_size(ft);
            } else {
              v_store(c, saddr, v_load(c, faddr, ir_type_of(ft)));
            }
            if ty_is_managed(ft) {
              retain_addr(c, ft, saddr);
              own_slot(c, slot, ft);
            }
          }
          bi += 1;
        }
      }
      let mut val: *IRVreg = null;
      if arm.body.kind == ExprKind.ExBlock {
        scope_push_l(c);
        val = block_value(c, arm.body.items, t);
        run_defers(c, c.scope.parent);
        scope_pop_release(c);
      } else {
        val = lv_expr(c, arm.body);
      }
      if val == null {
        // a never-returning arm (panic call): the phi still needs an arg,
        // but control never reaches the join from here
        val = v_const(c, 0, ir_type_of(t));
      }
      if t != null && ty_is_managed(t) && !expr_owned(arm.body) {
        retain_or_inc(c, t, val);
      }
      if bind_scope {
        scope_pop_release(c);
      }
      emit_br(c, join);
      phi_add(phi, c.f.cur, val);
      if i + 1 < n {
        use_block(c, next);
      }
      i += 1;
    }
    use_block(c, join);
    return phi.dst;
  }
  if e.kind == ExprKind.ExQmark {
    // `expr?` — on failure, return the whole value unchanged (it already
    // carries the failing tag and payload); on success, yield the payload
    let et: *Type = e.a.typed;
    let val: *IRVreg = lv_expr(c, e.a);
    let tag: *IRVreg = v_load(c, val, IRType.ItI32);
    let okv: *VariantAst = et.rec.decl.variants.items[e.q_ok];
    let is_ok: *IRVreg = v_cmp(c, IRCC.CcEq, tag, v_const(c, okv.disc as i64, IRType.ItI32), false);
    let cont: *IRBlock = new_block(c);
    let prop: *IRBlock = new_block(c);
    emit_cbr(c, is_ok, cont, prop, cont);
    use_block(c, prop);
    run_defers(c, null);
    let dst: *IRVreg = ret_dest(c);
    let cp: *IRIns = emit(c, IROp.IrCopymem);
    cp.addr = dst;
    cp.a = val;
    cp.size = type_size(et);
    if ty_is_managed(et) && !expr_owned(e.a) {
      retain_addr(c, et, dst);
    }
    release_scopes_to(c, null);
    emit_ret(c, null);
    let dead: *IRBlock = new_block(c);
    use_block(c, dead);
    emit_br(c, cont); // unreachable; keeps the CFG well-formed
    use_block(c, cont);
    if ty_is_managed(et) && expr_owned(e.a) {
      release_addr(c, et, val);
    }
    let pt: *Type = e.typed;
    let off: i64 = variant_field_offset(et, e.q_ok, 0);
    if pt != null && ty_is_aggregate(pt) {
      return v_addi(c, val, off);
    }
    return v_load(c, v_addi(c, val, off), ir_type_of(pt));
  }
  if t != null && ty_is_aggregate(t) {
    return compute_addr(c, e);
  }
  panic_call(c, "internal: unlowerable expression");
  return v_const(c, 0, IRType.ItPtr);
}

// ------------------------------------------------------------ calls --------

fn is_make_call(e: *Expr) -> bool {
  return e.kind == ExprKind.ExCall && e.a.kind == ExprKind.ExName &&
         streq(e.a.sv, "make") && e.typed != null &&
         e.typed.kind == TypeKind.TySlice;
}

fn method_receiver(callee: *Expr) -> *Expr {
  if callee.kind != ExprKind.ExField {
    return null;
  }
  let bt: *Type = callee.a.typed;
  let csym: *Sym = callee.sym;
  if bt == null || bt.kind == TypeKind.TyModule || csym == null || csym.decl == null {
    return null;
  }
  if csym.decl.is_method {
    return callee.a;
  }
  return null;
}

fn is_variant_ctor(e: *Expr) -> bool {
  return e.kind == ExprKind.ExCall && e.a.kind == ExprKind.ExField &&
         e.a.sym != null && e.a.sym.kind == SymKind.SyVariant;
}

// make([]T, n): allocate len*esize + header, init slice {buf, ptr, len}
fn lower_make(c: *LCtx, e: *Expr, dest_in: *IRVreg) -> *IRVreg {
  let slice_t: *Type = e.typed;
  let esize: i64 = type_size(slice_t.elem);
  let n: *IRVreg = lv_expr(c, e.args.items[1]);
  let esz: *IRVreg = v_const(c, esize, IRType.ItUsize);
  let hdr: *IRVreg = v_const(c, 24, IRType.ItUsize);
  let mul: *IRIns = emit(c, IROp.IrMul);
  mul.dst = new_vreg(c, IRType.ItUsize);
  mul.a = n;
  mul.b = esz;
  let add: *IRIns = emit(c, IROp.IrAdd);
  add.dst = new_vreg(c, IRType.ItUsize);
  add.a = mul.dst;
  add.b = hdr;
  let obj: *IRVreg = call_prelude1(c, "__alloc", add.dst, IRType.ItPtr);
  // header: {rc=1, wrc=0, drop=null}
  let obj8: *IRVreg = v_addi(c, obj, 8);
  let obj16: *IRVreg = v_addi(c, obj, 16);
  let obj24: *IRVreg = v_addi(c, obj, 24);
  let rc1: *IRVreg = v_const(c, 1, IRType.ItUsize);
  let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
  let rc: *IRIns = emit(c, IROp.IrStore);
  rc.addr = obj;
  rc.a = rc1;
  rc.size = 8;
  let wrc: *IRIns = emit(c, IROp.IrStore);
  wrc.addr = obj8;
  wrc.a = zero;
  wrc.size = 8;
  let drop0: *IRVreg = v_const(c, 0, IRType.ItPtr); // operands before emit: see landmine #1
  let dr: *IRIns = emit(c, IROp.IrStore);
  dr.addr = obj16;
  dr.a = drop0;
  if g_target_wasm {
    dr.size = 4;
  } else {
    dr.size = 8;
  }
  // slice {buf=obj, ptr=obj+24, len=n}
  let mut dest: *IRVreg = dest_in;
  if dest == null {
    let tmp: *IRSlot = new_slot(c, 24, 8, "slice");
    dest = v_slotaddr(c, tmp);
  }
  let d8: *IRVreg = v_addi(c, dest, 8);
  let d16: *IRVreg = v_addi(c, dest, 16);
  let s1: *IRIns = emit(c, IROp.IrStore);
  s1.addr = dest;
  s1.a = obj;
  s1.size = 8;
  let s2: *IRIns = emit(c, IROp.IrStore);
  s2.addr = d8;
  s2.a = obj24;
  s2.size = 8;
  let s3: *IRIns = emit(c, IROp.IrStore);
  s3.addr = d16;
  s3.a = n;
  s3.size = 8;
  return dest;
}

// new T { fields }: allocate, header, init fields, return the pointer
fn lower_new(c: *LCtx, e: *Expr) -> *IRVreg {
  let ptr_t: *Type = e.typed;
  let struct_t: *Type = ptr_t.elem;
  let size: i64 = type_size(struct_t);
  let obj: *IRVreg = call_prelude1(c, "__alloc", v_const(c, size + 24, IRType.ItUsize), IRType.ItPtr);
  let obj8: *IRVreg = v_addi(c, obj, 8);
  let obj16: *IRVreg = v_addi(c, obj, 16);
  let rc1: *IRVreg = v_const(c, 1, IRType.ItUsize);
  let rc: *IRIns = emit(c, IROp.IrStore);
  rc.addr = obj;
  rc.a = rc1;
  rc.size = 8;
  let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
  let wrc: *IRIns = emit(c, IROp.IrStore);
  wrc.addr = obj8;
  wrc.a = zero;
  wrc.size = 8;
  let mut dropv: *IRVreg = v_const(c, 0, IRType.ItPtr);
  let glue: string = value_fn_for(struct_t, false);
  if glue != "" {
    let ga: *IRIns = emit(c, IROp.IrAddrc);
    ga.dst = new_vreg(c, IRType.ItPtr);
    ga.callee = glue;
    ga.lit = -1;
    dropv = ga.dst;
  }
  let dr: *IRIns = emit(c, IROp.IrStore);
  dr.addr = obj16;
  dr.a = dropv;
  if g_target_wasm {
    dr.size = 4;
  } else {
    dr.size = 8;
  }
  // the returned reference points at the DATA, 24 bytes past the header
  let data: *IRVreg = v_addi(c, obj, 24);
  let rec: *RecType = struct_t.rec;
  let sd: *Decl = rec.decl;
  let mut i: usize = 0;
  while i < e.items.n {
    let fa: *FieldAst = new FieldAst { name: e.items.items[i].name, ty: null, file: "", line: 0, col: 0 };
    let init: *Expr = e.args.items[i];
    let mut j: usize = 0;
    while j < sd.fields.n {
      if streq(sd.fields.items[j].name, fa.name) {
        let off: i64 = struct_field_offset(rec, j);
        let ft: *Type = struct_field_type(rec, j);
        let faddr: *IRVreg = v_addi(c, data, off);
        if ty_is_aggregate(ft) {
          lv_agg(c, init, faddr);
          if !expr_owned(init) {
            retain_addr(c, ft, faddr);
          }
        } else {
          let v: *IRVreg = lv_expr(c, init);
          v_store(c, faddr, v);
          // the field owns a reference: borrowed inits hand it a +1; owned
          // producers transfer their single count
          if ty_is_managed(ft) && !expr_owned(init) {
            rc_inc_v(c, v);
          }
        }
        j = sd.fields.n; // break
      } else {
        j += 1;
      }
    }
    i += 1;
  }
  return data;
}

// enum variant construction: write {tag, payload fields} into dest (fresh
// temp when dest is NULL); returns the value's address
fn lower_enum_ctor(c: *LCtx, e: *Expr, dest_in: *IRVreg) -> *IRVreg {
  let vs: *Sym = e.a.sym;
  let et: *Type = e.typed;
  let v: *VariantAst = vs.decl.variants.items[vs.variant_index];
  let mut dest: *IRVreg = dest_in;
  if dest == null {
    let tmp: *IRSlot = new_slot(c, type_size(et), type_align(et), "enumval");
    dest = v_slotaddr(c, tmp);
  }
  let tagv: *IRVreg = v_const(c, v.disc as i64, IRType.ItI32);
  let tag: *IRIns = emit(c, IROp.IrStore);
  tag.addr = dest;
  tag.a = tagv;
  tag.size = 4;
  let size: i64 = type_size(et);
  if size > 4 {
    let rest: *IRVreg = v_addi(c, dest, 4);
    let z: *IRIns = emit(c, IROp.IrZero);
    z.addr = rest;
    z.size = size - 4;
  }
  let mut nfields: usize = 0;
  if v.vkind == VarKind.VarTuple {
    nfields = v.types.n;
  } else if v.vkind == VarKind.VarStruct {
    nfields = v.fields.n;
  }
  let mut i: usize = 0;
  while i < e.args.n && i < nfields {
    let arg: *Expr = e.args.items[i];
    let mut fidx: i32 = i as i32;
    if v.vkind == VarKind.VarStruct {
      let mut nm: string = "";
      if i < e.arg_names.n {
        nm = e.arg_names.items[i];
      }
      fidx = -1;
      let mut j: usize = 0;
      while j < v.fields.n {
        if nm != "" && streq(v.fields.items[j].name, nm) {
          fidx = j as i32;
          j = v.fields.n; // break
        } else {
          j += 1;
        }
      }
      if fidx < 0 {
        i += 1;
        continue;
      }
    }
    let off: i64 = variant_field_offset(et, vs.variant_index, fidx);
    let ft: *Type = arg.typed;
    let faddr: *IRVreg = v_addi(c, dest, off);
    if ft != null && ty_is_aggregate(ft) {
      lv_agg(c, arg, faddr);
      if !expr_owned(arg) {
        retain_addr(c, ft, faddr);
      }
    } else {
      let pv: *IRVreg = lv_expr(c, arg);
      v_store(c, faddr, pv);
      if ft != null && ty_is_managed(ft) && !expr_owned(arg) {
        rc_inc_v(c, pv);
      }
    }
    i += 1;
  }
  return dest;
}

// build a fresh managed slice {buf, ptr, len} of n elements into dest
fn make_slice(c: *LCtx, slice_t: *Type, n: *IRVreg, dest_in: *IRVreg) -> *IRVreg {
  let esize: i64 = type_size(slice_t.elem);
  let esz: *IRVreg = v_const(c, esize, IRType.ItUsize);
  let hdr: *IRVreg = v_const(c, 24, IRType.ItUsize);
  let mul: *IRIns = emit(c, IROp.IrMul);
  mul.dst = new_vreg(c, IRType.ItUsize);
  mul.a = n;
  mul.b = esz;
  let add: *IRIns = emit(c, IROp.IrAdd);
  add.dst = new_vreg(c, IRType.ItUsize);
  add.a = mul.dst;
  add.b = hdr;
  let obj: *IRVreg = call_prelude1(c, "__alloc", add.dst, IRType.ItPtr);
  // header: {rc=1, wrc=0, drop=null}
  let obj8: *IRVreg = v_addi(c, obj, 8);
  let obj16: *IRVreg = v_addi(c, obj, 16);
  let obj24: *IRVreg = v_addi(c, obj, 24);
  let rc1: *IRVreg = v_const(c, 1, IRType.ItUsize);
  let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
  let rc: *IRIns = emit(c, IROp.IrStore);
  rc.addr = obj;
  rc.a = rc1;
  rc.size = 8;
  let wrc: *IRIns = emit(c, IROp.IrStore);
  wrc.addr = obj8;
  wrc.a = zero;
  wrc.size = 8;
  let drop0: *IRVreg = v_const(c, 0, IRType.ItPtr);
  let dr: *IRIns = emit(c, IROp.IrStore);
  dr.addr = obj16;
  dr.a = drop0;
  if g_target_wasm {
    dr.size = 4;
  } else {
    dr.size = 8;
  }
  // slice {buf=obj, ptr=obj+24, len=n}
  let mut dest: *IRVreg = dest_in;
  if dest == null {
    let tmp: *IRSlot = new_slot(c, 24, 8, "slice");
    dest = v_slotaddr(c, tmp);
  }
  let d8: *IRVreg = v_addi(c, dest, 8);
  let d16: *IRVreg = v_addi(c, dest, 16);
  let s1: *IRIns = emit(c, IROp.IrStore);
  s1.addr = dest;
  s1.a = obj;
  s1.size = 8;
  let s2: *IRIns = emit(c, IROp.IrStore);
  s2.addr = d8;
  s2.a = obj24;
  s2.size = 8;
  let s3: *IRIns = emit(c, IROp.IrStore);
  s3.addr = d16;
  s3.a = n;
  s3.size = 8;
  return dest;
}

fn build_call(c: *LCtx, fn_: *Sym, receiver: *Expr, args_exprs: *Vec[*Expr], out: *IRVreg, scalar_dst: *Vec[*IRVreg]) {
  // args: vregs for scalars, addresses for aggregates; the method receiver,
  // when present, is argument 0
  let mut call_args: []*IRVreg = make([]*IRVreg, 0);
  let mut owned_args: []*Expr = make([]*Expr, 0);  // owned rvalues needing a post-call release
  let mut owned_slots: []usize = make([]usize, 0); // index of each owned value inside call_args
  let ret: *Type = fn_.type.ret;
  let agg_ret: bool = ret != null && ty_is_aggregate(ret);
  if agg_ret {
    call_args = push_vreg(call_args, out);
  }
  // variadic callee: the trailing `rest: T...` parameter is a []T the call
  // site builds from the extra arguments (or takes whole from `xs...`)
  let variadic: bool = fn_.kind == SymKind.SyFn && fn_.decl != null &&
                       fn_.decl.kind == DeclKind.DkFn &&
                       fn_.decl.params.n > 0 &&
                       fn_.decl.params.items[fn_.decl.params.n - 1].is_variadic;
  let recv_n: usize = if receiver != null { 1 } else { 0 };
  let nfixed: usize = if variadic {
    len(fn_.type.params) - recv_n - 1
  } else {
    args_exprs.n
  };
  let mut vararg_slice: *IRVreg = null;
  let mut vararg_t: *Type = null;
  let mut param_index: usize = 0;
  if receiver != null {
    let self_t: *Type = fn_.type.params[0];
    call_args = push_vreg(call_args, lv_expr(c, receiver));
    if ty_is_managed(self_t) && expr_owned(receiver) {
      owned_args = push_expr(owned_args, receiver);
      owned_slots = push_usize(owned_slots, len(call_args) - 1);
    }
    param_index = 1;
  }
  let mut i: usize = 0;
  while i < nfixed {
    let arg: *Expr = args_exprs.items[i];
    let mut pt: *Type = arg.typed;
    if param_index + i < len(fn_.type.params) {
      pt = fn_.type.params[param_index + i];
    }
    call_args = push_vreg(call_args, lv_expr(c, arg)); // aggregate rvalue = address of temp
    if pt != null && ty_is_managed(pt) && expr_owned(arg) {
      owned_args = push_expr(owned_args, arg);
      owned_slots = push_usize(owned_slots, len(call_args) - 1);
    }
    i += 1;
  }
  if variadic {
    let slice_t: *Type = fn_.type.params[len(fn_.type.params) - 1];
    let elem_t: *Type = slice_t.elem;
    let n: usize = args_exprs.n - nfixed;
    let last: *Expr = if args_exprs.n > 0 { args_exprs.items[args_exprs.n - 1] } else { null };
    if last != null && last.spread {
      // `xs...`: the slice value passes whole, with normal arg semantics
      call_args = push_vreg(call_args, lv_expr(c, last));
      if ty_is_managed(slice_t) && expr_owned(last) {
        owned_args = push_expr(owned_args, last);
        owned_slots = push_usize(owned_slots, len(call_args) - 1);
      }
    } else {
      let tmp: *IRSlot = new_slot(c, 24, 8, "varargs");
      let slice_addr: *IRVreg = v_slotaddr(c, tmp);
      make_slice(c, slice_t, v_const(c, n as i64, IRType.ItUsize), slice_addr);
      let data: *IRVreg = v_load(c, v_addi(c, slice_addr, 8), IRType.ItPtr);
      let mut j: usize = 0;
      while j < n {
        let arg: *Expr = args_exprs.items[nfixed + j];
        let ea: *IRVreg = v_addi(c, data, j as i64 * type_size(elem_t));
        if ty_is_aggregate(elem_t) {
          lv_agg(c, arg, ea);
          if ty_is_managed(elem_t) && !expr_owned(arg) {
            retain_addr(c, elem_t, ea);
          }
        } else {
          let v: *IRVreg = lv_expr(c, arg);
          let st: *IRIns = emit(c, IROp.IrStore);
          st.addr = ea;
          st.a = v;
          st.size = type_size(elem_t);
          if ty_is_managed(elem_t) && !expr_owned(arg) {
            rc_inc_v(c, v);
          }
        }
        j += 1;
      }
      call_args = push_vreg(call_args, slice_addr);
      vararg_slice = slice_addr;
      vararg_t = slice_t;
    }
  }
  let call: *IRIns = emit(c, IROp.IrCall);
  call.callee = sym_symbol(fn_);
  call.args = call_args;
  if ret != null && !agg_ret && ret.kind != TypeKind.TyVoid {
    call.dst = new_vreg(c, ir_type_of(ret));
  }
  // owned arguments handed their +1 to the callee's param copies
  let mut oi: usize = 0;
  while oi < len(owned_args) {
    let arg: *Expr = owned_args[oi];
    let at: *Type = arg.typed;
    let pv: *IRVreg = call_args[owned_slots[oi]];
    if ty_is_aggregate(at) {
      release_addr(c, at, pv);
    } else {
      rc_dec_v(c, pv);
    }
    oi += 1;
  }
  // the constructed varargs slice was a fresh +1; hand it to the callee's
  // param copy (which retained it on entry and releases it at exit)
  if vararg_slice != null {
    release_addr(c, vararg_t, vararg_slice);
  }
  scalar_dst.items[0] = call.dst;
}

fn push_expr(items: []*Expr, v: *Expr) -> []*Expr {
  let out: []*Expr = make([]*Expr, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn push_usize(items: []usize, v: usize) -> []usize {
  let out: []usize = make([]usize, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = v;
  return out;
}

fn compute_call_value(c: *LCtx, e: *Expr) -> *IRVreg {
  // builtins
  if e.a.kind == ExprKind.ExName && streq(e.a.sv, "len") {
    let arg: *Expr = e.args.items[0];
    let at: *Type = arg.typed;
    if at.kind == TypeKind.TyArray {
      return v_const(c, at.len as i64, IRType.ItUsize);
    }
    let addr: *IRVreg = lv_expr(c, arg); // slice/string aggregate address
    return v_load(c, v_addi(c, addr, 16), IRType.ItUsize);
  }
  // weak.from(p) -> __rc_wref(p): bumps wrc, returns the header handle
  if e.a.kind == ExprKind.ExField && e.a.a.kind == ExprKind.ExName &&
     streq(e.a.a.sv, "weak") && streq(e.a.sv, "from") {
    let p: *IRVreg = lv_expr(c, e.args.items[0]);
    let call: *IRIns = emit(c, IROp.IrCall);
    call.callee = "rho__rc_wref";
    call.args = push_vreg(call.args, p);
    call.dst = new_vreg(c, IRType.ItPtr);
    return call.dst;
  }
  // w.get() -> __rc_wget(w): data pointer or null when the object died
  if e.a.kind == ExprKind.ExField && streq(e.a.sv, "get") &&
     e.a.a.typed != null && e.a.a.typed.kind == TypeKind.TyWeak {
    let w: *IRVreg = lv_expr(c, e.a.a);
    let call: *IRIns = emit(c, IROp.IrCall);
    call.callee = "rho__rc_wget";
    call.args = push_vreg(call.args, w);
    call.dst = new_vreg(c, IRType.ItPtr);
    return call.dst;
  }
  // intrinsics.* — raw-memory kernel (spec §10)
  if e.a.kind == ExprKind.ExField && e.a.a.kind == ExprKind.ExName &&
     streq(e.a.a.sv, "intrinsics") {
    let name: string = e.a.sv;
    if streq(name, "load_u8") || streq(name, "load_u32") ||
       streq(name, "load_u64") || streq(name, "load_i64") {
      let mut it: IRType = IRType.ItI64;
      if streq(name, "load_u8") {
        it = IRType.ItU8;
      } else if streq(name, "load_u32") {
        it = IRType.ItU32;
      } else if streq(name, "load_u64") {
        it = IRType.ItU64;
      }
      let p: *IRVreg = lv_expr(c, e.args.items[0]);
      return v_load(c, p, it);
    }
    if streq(name, "store_u8") || streq(name, "store_u32") ||
       streq(name, "store_u64") || streq(name, "store_i64") {
      let p: *IRVreg = lv_expr(c, e.args.items[0]);
      let v: *IRVreg = lv_expr(c, e.args.items[1]);
      v_store(c, p, v);
      return v_const(c, 0, IRType.ItU8);
    }
    if streq(name, "f64_bits") || streq(name, "f32_bits") {
      let v: *IRVreg = lv_expr(c, e.args.items[0]);
      if streq(name, "f64_bits") {
        return v_cast(c, v, IRType.ItU64);
      }
      return v_cast(c, v, IRType.ItU32);
    }
    if streq(name, "mem_size") {
      let ms: *IRIns = emit(c, IROp.IrMemsize);
      ms.dst = new_vreg(c, IRType.ItUsize);
      return ms.dst;
    }
    if streq(name, "mem_grow") {
      // evaluate the argument BEFORE emitting the intrinsic: emitting
      // first appends the argument's load after the grow in the block,
      // and the grow then reads an uninitialized slot (boot's 0.4.1
      // memgrow trap — grow(0) succeeds silently and the heap runs past
      // the memory end)
      let pages: *IRVreg = lv_expr(c, e.args.items[0]);
      let mg: *IRIns = emit(c, IROp.IrMemgrow);
      mg.a = pages;
      mg.dst = new_vreg(c, IRType.ItUsize);
      return mg.dst;
    }
    if streq(name, "memcpy") {
      let dst: *IRVreg = lv_expr(c, e.args.items[0]);
      let src: *IRVreg = lv_expr(c, e.args.items[1]);
      let cp: *IRIns = emit(c, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = src;
      cp.b = lv_expr(c, e.args.items[2]); // runtime size
      cp.size = -1;
      return v_const(c, 0, IRType.ItU8);
    }
    if streq(name, "slice_string") {
      let base: *IRVreg = lv_expr(c, e.args.items[0]); // []u8 aggregate address
      let len_v: *IRVreg = v_load(c, v_addi(c, base, 16), IRType.ItUsize);
      let ptr: *IRVreg = v_load(c, v_addi(c, base, 8), IRType.ItPtr);
      // obj = __alloc(len + 24): header at obj, data at obj+24 — the same
      // layout make() produces; buf fields hold the header
      let total: *IRVreg = v_binop(c, IROp.IrAdd, len_v, v_const(c, 24, IRType.ItUsize), IRType.ItUsize, false);
      let obj: *IRVreg = call_prelude1(c, "__alloc", total, IRType.ItPtr);
      // header: {rc=1, wrc=0, drop=null}
      let obj8: *IRVreg = v_addi(c, obj, 8);
      let obj16: *IRVreg = v_addi(c, obj, 16);
      let obj24: *IRVreg = v_addi(c, obj, 24);
      let rc1: *IRVreg = v_const(c, 1, IRType.ItUsize);
      let zero: *IRVreg = v_const(c, 0, IRType.ItUsize);
      let rc: *IRIns = emit(c, IROp.IrStore);
      rc.addr = obj;
      rc.a = rc1;
      rc.size = 8;
      let wrc: *IRIns = emit(c, IROp.IrStore);
      wrc.addr = obj8;
      wrc.a = zero;
      wrc.size = 8;
      let drop0: *IRVreg = v_const(c, 0, IRType.ItPtr); // operands before emit: landmine #1
      let dr: *IRIns = emit(c, IROp.IrStore);
      dr.addr = obj16;
      dr.a = drop0;
      if g_target_wasm {
        dr.size = 4;
      } else {
        dr.size = 8;
      }
      let cp: *IRIns = emit(c, IROp.IrCopymem);
      cp.addr = obj24;
      cp.a = ptr;
      cp.b = len_v; // runtime byte count
      cp.size = -1;
      // build {buf=obj (header), ptr=obj+24 (data), len}
      let tmp: *IRSlot = new_slot(c, 24, 8, "strval");
      let dest: *IRVreg = v_slotaddr(c, tmp);
      let d8: *IRVreg = v_addi(c, dest, 8);
      let d16: *IRVreg = v_addi(c, dest, 16);
      let s1: *IRIns = emit(c, IROp.IrStore);
      s1.addr = dest;
      s1.a = obj;
      s1.size = 8;
      let s2: *IRIns = emit(c, IROp.IrStore);
      s2.addr = d8;
      s2.a = obj24;
      s2.size = 8;
      let s3: *IRIns = emit(c, IROp.IrStore);
      s3.addr = d16;
      s3.a = len_v;
      s3.size = 8;
      return dest;
    }
  }
  if is_variant_ctor(e) {
    let et: *Type = e.typed;
    let tmp: *IRSlot = new_slot(c, type_size(et), type_align(et), "enumval");
    return lower_enum_ctor(c, e, v_slotaddr(c, tmp));
  }
  // dyn virtual call: detected by the RECEIVER's type + the requirement
  // sym — the callee field itself carries no type
  if is_dyn_virtual_call(e) {
    return dyn_virtual_call(c, e, null);
  }
  // closure-value call: load {code, env} and call code(args..., env)
  let callee_t: *Type = e.a.typed;
  let csym: *Sym = e.a.sym;
  let mut direct: bool = false;
  if csym != null {
    if csym.kind == SymKind.SyFn || csym.kind == SymKind.SyExtern ||
       csym.kind == SymKind.SyVariant {
      direct = true;
    }
  }
  if callee_t != null && callee_t.kind == TypeKind.TyFn && !direct {
    let val: *IRVreg = lv_expr(c, e.a); // 16-byte value address
    let code: *IRVreg = v_load(c, val, IRType.ItPtr);
    let env: *IRVreg = v_load(c, v_addi(c, val, 8), IRType.ItPtr);
    let ft: *Type = callee_t;
    let ret: *Type = ft.ret;
    let agg: bool = ret != null && ty_is_aggregate(ret);
    let mut args: []*IRVreg = make([]*IRVreg, 0);
    let mut owned_args: []*Expr = make([]*Expr, 0);
    let mut owned_slots: []usize = make([]usize, 0);
    let mut out: *IRVreg = null;
    if agg {
      let tmp: *IRSlot = new_slot(c, type_size(ret), type_align(ret), "out");
      out = v_slotaddr(c, tmp);
      args = push_vreg(args, out);
    }
    let mut i: usize = 0;
    while i < e.args.n && i < len(ft.params) {
      let arg: *Expr = e.args.items[i];
      let pt: *Type = ft.params[i];
      args = push_vreg(args, lv_expr(c, arg));
      if pt != null && ty_is_managed(pt) && expr_owned(arg) {
        owned_args = push_expr(owned_args, arg);
        owned_slots = push_usize(owned_slots, len(args) - 1);
      }
      i += 1;
    }
    args = push_vreg(args, env);
    let call: *IRIns = emit(c, IROp.IrCall);
    call.callee_vreg = code;
    call.args = args;
    // owned arguments handed their +1 to the callee's param copies
    let mut oi: usize = 0;
    while oi < len(owned_args) {
      let arg: *Expr = owned_args[oi];
      let at: *Type = arg.typed;
      let pv: *IRVreg = args[owned_slots[oi]];
      if ty_is_aggregate(at) {
        release_addr(c, at, pv);
      } else {
        rc_dec_v(c, pv);
      }
      oi += 1;
    }
    if agg {
      return out;
    }
    if ret != null && ret.kind != TypeKind.TyVoid {
      call.dst = new_vreg(c, ir_type_of(ret));
      return call.dst;
    }
    return v_const(c, 0, IRType.ItPtr);
  }
  // normal call: callee sym stashed by the checker
  let fn_: *Sym = e.a.sym;
  if fn_ == null {
    panic_call(c, "internal: unresolved callee");
    return v_const(c, 0, IRType.ItPtr);
  }
  let ret: *Type = fn_.type.ret;
  if ret != null && ty_is_aggregate(ret) {
    let tmp: *IRSlot = new_slot(c, type_size(ret), type_align(ret), "ret");
    let out: *IRVreg = v_slotaddr(c, tmp);
    let dst_box: *Vec[*IRVreg] = new Vec[*IRVreg] { items: make([]*IRVreg, 1), n: 1 };
    build_call(c, fn_, method_receiver(e.a), e.args, out, dst_box);
    return out; // value address
  }
  let dst_box2: *Vec[*IRVreg] = new Vec[*IRVreg] { items: make([]*IRVreg, 1), n: 1 };
  build_call(c, fn_, method_receiver(e.a), e.args, null, dst_box2);
  return dst_box2.items[0];
}

// ------------------------------------------------------------ aggregates ---

// write aggregate value `e` into dest (address vreg)
fn lv_agg(c: *LCtx, e: *Expr, dest: *IRVreg) {
  let t: *Type = e.typed;
  if e.kind == ExprKind.ExMake {
    lower_make(c, e, dest);
    return;
  }
  if e.kind == ExprKind.ExStr {
    let addr: *IRVreg = lv_expr(c, e); // lv_expr materializes into a temp
    let cp: *IRIns = emit(c, IROp.IrCopymem);
    cp.addr = dest;
    cp.a = addr;
    cp.size = 24;
    return;
  }
  if e.kind == ExprKind.ExCall {
    if is_make_call(e) {
      lower_make(c, e, dest);
      return;
    }
    if is_variant_ctor(e) {
      lower_enum_ctor(c, e, dest);
      return;
    }
    if is_dyn_virtual_call(e) {
      dyn_virtual_call(c, e, dest); // the string lands directly in dest
      return;
    }
    let fn_: *Sym = e.a.sym;
    if fn_ != null && fn_.type.ret != null && ty_is_aggregate(fn_.type.ret) {
      // call straight into dest — one path for every call (variadic
      // construction and owned-arg releases included)
      let dst_box: *Vec[*IRVreg] = new Vec[*IRVreg] { items: make([]*IRVreg, 1), n: 1 };
      build_call(c, fn_, method_receiver(e.a), e.args, dest, dst_box);
      return;
    }
    let src: *IRVreg = lv_expr(c, e);
    let cp: *IRIns = emit(c, IROp.IrCopymem);
    cp.addr = dest;
    cp.a = src;
    cp.size = type_size(t);
    return;
  }
  if e.kind == ExprKind.ExIf || e.kind == ExprKind.ExMatch {
    panic_call(c, "internal: aggregate-valued if/match arrives in 0.0.5");
    return;
  }
  // default: aggregates evaluate to addresses
  let src2: *IRVreg = lv_expr(c, e);
  let cp2: *IRIns = emit(c, IROp.IrCopymem);
  cp2.addr = dest;
  cp2.a = src2;
  cp2.size = type_size(t);
}

// block statements with a trailing value; returns value vreg (scalars) or
// address (aggregates); NULL when the block produces nothing
fn block_value(c: *LCtx, stmts: *Vec[*Stmt], t: *Type) -> *IRVreg {
  scope_push_l(c);
  let mut tail: *IRVreg = null;
  let mut i: usize = 0;
  while i < stmts.n {
    let s: *Stmt = stmts.items[i];
    lv_stmt(c, s);
    if i + 1 == stmts.n && s.kind == StmtKind.StExpr && s.tail {
      tail = lv_expr(c, s.a);
    }
    i += 1;
  }
  scope_pop_release(c);
  return tail;
}

// ------------------------------------------------------------ statements ---

fn lv_expr_discard(c: *LCtx, e: *Expr) {
  let t: *Type = e.typed;
  if t != null && ty_is_managed(t) && expr_owned(e) {
    let v: *IRVreg = lv_expr(c, e);
    if ty_is_aggregate(t) {
      release_addr(c, t, v);
    } else {
      rc_dec_v(c, v);
    }
    return;
  }
  lv_expr(c, e);
}

fn lv_stmt(c: *LCtx, s: *Stmt) {
  if s.kind == StmtKind.StLet {
    let t: *Type = s.a.typed;
    let slot: *IRSlot = new_slot(c, type_size(t), type_align(t), s.name);
    lbind(c, s.name, slot);
    let addr: *IRVreg = v_slotaddr(c, slot);
    if ty_is_aggregate(t) {
      lv_agg(c, s.a, addr);
    } else {
      let v: *IRVreg = lv_expr(c, s.a);
      v_store(c, addr, v);
    }
    if ty_is_managed(t) {
      if !expr_owned(s.a) {
        retain_addr(c, t, addr);
      }
      own_slot(c, slot, t);
    }
    return;
  }
  if s.kind == StmtKind.StAssign {
    let t: *Type = s.a.typed;
    let addr: *IRVreg = compute_addr(c, s.a);
    if s.assign_op == Tok.PAssign {
      if ty_is_managed(t) {
        // save the old value before the store overwrites it
        let old: *IRSlot = new_slot(c, type_size(t), type_align(t), "oldval");
        let olda: *IRVreg = v_slotaddr(c, old);
        if ty_is_aggregate(t) {
          let cp: *IRIns = emit(c, IROp.IrCopymem);
          cp.addr = olda;
          cp.a = addr;
          cp.size = type_size(t);
        } else {
          v_store(c, olda, v_load(c, addr, ir_type_of(t)));
        }
        if ty_is_aggregate(t) {
          lv_agg(c, s.b, addr);
          if !expr_owned(s.b) {
            retain_addr(c, t, addr);
          }
        } else {
          let v: *IRVreg = lv_expr(c, s.b);
          v_store(c, addr, v);
          if !expr_owned(s.b) {
            rc_inc_v(c, v);
          }
        }
        release_addr(c, t, olda);
        return;
      }
      if ty_is_aggregate(t) {
        lv_agg(c, s.b, addr);
      } else {
        let v2: *IRVreg = lv_expr(c, s.b);
        v_store(c, addr, v2);
      }
      return;
    }
    let vt: IRType = ir_type_of(t);
    let cur: *IRVreg = v_load(c, addr, vt);
    let rhs: *IRVreg = lv_expr(c, s.b);
    let mut res: *IRVreg = cur;
    let flt: bool = ir_is_float_t(vt);
    let op: Tok = s.assign_op;
    if op == Tok.PPluseq { res = v_binop(c, IROp.IrAdd, cur, rhs, vt, true); }
    else if op == Tok.PMinuseq { res = v_binop(c, IROp.IrSub, cur, rhs, vt, true); }
    else if op == Tok.PStareq { res = v_binop(c, IROp.IrMul, cur, rhs, vt, flt); }
    else if op == Tok.PSlasheq {
      let mut sgn: bool = flt;
      if ty_is_signed_int(vt) {
        sgn = true;
      }
      res = v_binop(c, IROp.IrDiv, cur, rhs, vt, sgn);
    }
    else if op == Tok.PPercenteq { res = v_binop(c, IROp.IrMod, cur, rhs, vt, ty_is_signed_int(vt)); }
    else if op == Tok.PAmpeq { res = v_binop(c, IROp.IrAnd, cur, rhs, vt, false); }
    else if op == Tok.PPipeeq { res = v_binop(c, IROp.IrOr, cur, rhs, vt, false); }
    else if op == Tok.PCareteq { res = v_binop(c, IROp.IrXor, cur, rhs, vt, false); }
    else if op == Tok.PShleq { res = v_binop(c, IROp.IrShl, cur, rhs, vt, false); }
    else if op == Tok.PShreq { res = v_binop(c, IROp.IrShr, cur, rhs, vt, ty_is_signed_int(vt)); }
    v_store(c, addr, res);
    return;
  }
  if s.kind == StmtKind.StExpr {
    lv_expr_discard(c, s.a);
    return;
  }
  if s.kind == StmtKind.StReturn {
    let mut t: *Type = null;
    if s.a != null {
      t = s.a.typed;
    }
    if s.a != null && ty_is_aggregate(t) {
      let src: *IRVreg = lv_expr(c, s.a);
      let dst: *IRVreg = ret_dest(c);
      let cp: *IRIns = emit(c, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = src;
      cp.size = type_size(t);
      if ty_is_managed(t) && !expr_owned(s.a) {
        retain_addr(c, t, dst);
      }
      run_defers(c, null);
      release_scopes_to(c, null);
      emit_ret(c, null);
    } else if s.a != null && ty_is_managed(t) {
      let v: *IRVreg = lv_expr(c, s.a);
      if !expr_owned(s.a) {
        rc_inc_v(c, v);
      }
      run_defers(c, null);
      release_scopes_to(c, null);
      emit_ret(c, v);
    } else {
      // evaluate before defers/release: the value may read scope-owned data
      let mut v: *IRVreg = null;
      if s.a != null {
        v = lv_expr(c, s.a);
      }
      run_defers(c, null);
      release_scopes_to(c, null);
      emit_ret(c, v);
    }
    // continuation block for unreachable code after return
    let dead: *IRBlock = new_block(c);
    use_block(c, dead);
    return;
  }
  if s.kind == StmtKind.StBreak || s.kind == StmtKind.StContinue {
    let mut loop_scope: *LScope = null;
    let mut s2: *LScope = c.scope;
    while s2 != null {
      if (s.kind == StmtKind.StBreak && s2.break_to != null) ||
         (s.kind == StmtKind.StContinue && s2.continue_to != null) {
        loop_scope = s2;
        s2 = null;
      } else {
        s2 = s2.parent;
      }
    }
    run_defers(c, loop_scope); // defers inside the loop body, not the loop scope's own
    release_scopes_to(c, loop_scope);
    if s.kind == StmtKind.StBreak {
      emit_br(c, loop_scope.break_to);
    } else {
      emit_br(c, loop_scope.continue_to);
    }
    let dead: *IRBlock = new_block(c);
    use_block(c, dead);
    return;
  }
  if s.kind == StmtKind.StDefer {
    c.scope.defers = push_stmt(c.scope.defers, s);
    return;
  }
  if s.kind == StmtKind.StWhile {
    let header: *IRBlock = new_block(c);
    let body: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    header.loop_header = true;
    header.loop_exit = done;
    emit_br(c, header);
    use_block(c, header);
    let cond: *IRVreg = lv_expr(c, s.cond);
    emit_cbr(c, cond, body, done, done);
    use_block(c, body);
    scope_push_l(c);
    c.scope.is_loop = true;
    c.scope.break_to = done;
    c.scope.continue_to = header;
    let mut i: usize = 0;
    while i < s.body.n {
      lv_stmt(c, s.body.items[i]);
      i += 1;
    }
    run_defers(c, c.scope.parent);
    scope_pop_release(c);
    emit_br(c, header);
    use_block(c, done);
    return;
  }
  if s.kind == StmtKind.StLoop {
    let body: *IRBlock = new_block(c);
    let done: *IRBlock = new_block(c);
    body.loop_header = true;
    body.loop_exit = done;
    emit_br(c, body);
    use_block(c, body);
    scope_push_l(c);
    c.scope.is_loop = true;
    c.scope.break_to = done;
    c.scope.continue_to = body;
    let mut i: usize = 0;
    while i < s.body.n {
      lv_stmt(c, s.body.items[i]);
      i += 1;
    }
    run_defers(c, c.scope.parent);
    scope_pop_release(c);
    emit_br(c, body);
    use_block(c, done);
    return;
  }
  if s.kind == StmtKind.StBlock {
    scope_push_l(c);
    let mut i: usize = 0;
    while i < s.stmts.n {
      lv_stmt(c, s.stmts.items[i]);
      i += 1;
    }
    run_defers(c, c.scope.parent);
    scope_pop_release(c);
    return;
  }
}

fn push_stmt(items: []*Stmt, s: *Stmt) -> []*Stmt {
  let out: []*Stmt = make([]*Stmt, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = s;
  return out;
}

fn lv_stmts(c: *LCtx, stmts: *Vec[*Stmt]) {
  let mut i: usize = 0;
  while i < stmts.n {
    lv_stmt(c, stmts.items[i]);
    i += 1;
  }
}

// run defers innermost-first until (exclusive) scope `stop` (NULL = all)
fn run_defers(c: *LCtx, stop: *LScope) {
  let mut s: *LScope = c.scope;
  while s != null && s != stop {
    let mut i: usize = len(s.defers);
    while i > 0 {
      let d: *Stmt = s.defers[i - 1];
      let mut j: usize = 0;
      while j < d.stmts.n {
        lv_stmt(c, d.stmts.items[j]);
        j += 1;
      }
      i -= 1;
    }
    s = s.parent;
  }
}

// ------------------------------------------------------------ driver -------

fn lower_fn(fn_sym: *Sym) -> *IRFn {
  let d: *Decl = fn_sym.decl;
  let fn_: *IRFn = rc_new_fn(sym_symbol(fn_sym));
  fn_.ret = fn_sym.type.ret;
  if fn_.ret != null && ty_is_aggregate(fn_.ret) {
    fn_.returns_aggregate = true;
    let cc0: *LCtx = rc_ctx(fn_);
    fn_.out_slot = new_slot(cc0, type_size(fn_.ret), type_align(fn_.ret), "out");
  }
  let ctx: *LCtx = rc_ctx(fn_);
  scope_push_l(ctx);
  // rc_new_fn already created the entry block; lower_fn uses it directly
  // (boot's lower_fn arena-allocs the IRFn and creates its own entry —
  // same final shape: exactly one entry block, cur == entry)

  let mut i: usize = 0;
  while i < d.params.n {
    let pa: *Param = d.params.items[i];
    let pt: *Type = fn_sym.type.params[i];
    let slot: *IRSlot = new_slot(ctx, type_size(pt), type_align(pt), pa.name);
    fn_.params = push_islot(fn_.params, slot);
    fn_.param_types = push_type(fn_.param_types, pt);
    if ty_is_aggregate(pt) {
      // the register holds a POINTER to the caller's copy; give the parameter
      // a proper local slot and copy the value through after the spill
      let local: *IRSlot = new_slot(ctx, type_size(pt), type_align(pt), pa.name);
      lbind(ctx, pa.name, local);
      let src_addr: *IRVreg = v_slotaddr(ctx, slot);
      let src: *IRVreg = v_load(ctx, src_addr, IRType.ItPtr);
      let dst: *IRVreg = v_slotaddr(ctx, local);
      let cp: *IRIns = emit(ctx, IROp.IrCopymem);
      cp.addr = dst;
      cp.a = src;
      cp.size = type_size(pt);
      if ty_is_managed(pt) {
        retain_addr(ctx, pt, dst);
        own_slot(ctx, local, pt);
      }
    } else {
      lbind(ctx, pa.name, slot);
      if ty_is_managed(pt) {
        retain_addr(ctx, pt, v_slotaddr(ctx, slot));
        own_slot(ctx, slot, pt);
      }
    }
    i += 1;
  }
  if fn_sym.owner == g_root_module && streq(fn_sym.name, "main") {
    if g_main_cell == null {
      g_main_cell = new Vec[string] { items: make([]string, 1), n: 1 };
    }
    g_main_cell.items[0] = fn_.symbol;
  }

  let mut bi: usize = 0;
  while bi < d.body.n {
    lv_stmt(ctx, d.body.items[bi]);
    bi += 1;
  }

  if fn_.cur.term_op == 0 {
    run_defers(ctx, null);
    release_scopes_to(ctx, null);
    emit_ret(ctx, null);
  }
  scope_pop_l(ctx);
  return fn_;
}

fn lower_static(fn_sym: *Sym) {
  let d: *Decl = fn_sym.decl;
  let t: *Type = fn_sym.type;
  let g: *IRGlobal = new IRGlobal {
    symbol: sym_symbol(fn_sym), size: type_size(t), align: type_align(t),
    init: make([]u8, 0), relocs: make([]string, 0), static_lit: null,
    is_extern: false,
  };
  if d.kind == DeclKind.DkStatic && d.init != null && d.init.kind == ExprKind.ExStr {
    // {buf, ptr, len} with relocations into rodata
    let sv: string = d.init.sv;
    let label: string = cat3(g.symbol, "_str", "");
    let mut bytes: []u8 = make([]u8, 0);
    let mut si: usize = 0;
    while si < len(sv) {
      bytes = push_u8(bytes, sv[si]);
      si += 1;
    }
    bytes = push_u8(bytes, 0);
    let lit: *IRLit = new IRLit { label: label, bytes: bytes };
    // the emitter emits this literal block next to the global's data
    g.relocs = push_str(g.relocs, label);
    g.relocs = push_str(g.relocs, cat3(label, "_b", ""));
    g.relocs = push_str(g.relocs, "");
    let len_v: i64 = len(sv) as i64;
    let mut w: i32 = 0;
    while w < 3 {
      let mut word: i64 = 0;
      if w == 2 {
        word = len_v;
      }
      let mut b: i32 = 0;
      while b < 8 {
        g.init = push_u8(g.init, ((word >> (8 * b)) & 255) as u8);
        b += 1;
      }
      w += 1;
    }
    g.static_lit = lit;
  } else if d.init != null && d.init.typed != null && !ty_is_aggregate(d.init.typed) {
    let mut v: u64 = 0;
    if d.ceval_ok && d.ceval_is_int {
      v = d.ceval_i;
    }
    if d.ceval_ok && !d.ceval_is_int {
      // float initializers take their IEEE-754 bit pattern via the bits
      // intrinsics (boot memcpy's the double). f32 narrows first — an f32
      // static init only exists in principle (no corpus/prelude use)
      if t != null && t.kind == TypeKind.TyF32 {
        v = intrinsics.f32_bits(d.ceval_f as f32) as u64;
      } else {
        v = intrinsics.f64_bits(d.ceval_f);
      }
    }
    let size: i64 = type_size(t);
    let mut b: i64 = 0;
    while b < size {
      g.init = push_u8(g.init, ((v >> (8 * b)) & 255) as u8);
      b += 1;
    }
  }
  g_ir_globals.push(g);
}

fn lower_program() {
  g_ir_fns = new Vec[*IRFn] { items: make([]*IRFn, 1024), n: 0 };
  g_ir_globals = new Vec[*IRGlobal] { items: make([]*IRGlobal, 64), n: 0 };
  if g_main_cell == null {
    g_main_cell = new Vec[string] { items: make([]string, 1), n: 1 };
  }
  g_main_cell.items[0] = "";
  // per-compile caches: stale symbols would point at previous compiles'
  // glue fns (which no longer exist in this module's emission)
  g_ret_fns = tm2_new();
  g_rel_fns = tm2_new();
  g_eq_fns = tm2_new();
  g_panic_site = 0;
  g_lit_counter = 0;
  g_closure_counter = 0;
  g_shims = null;
  rc_runtime_build(); // __rc_inc/dec/w* helpers every managed program needs
  // module order: prelude first, then the user module (C's g_module_order)
  let mut mi: i32 = 0;
  let naux: i32 = if g_aux_modules != null { g_aux_modules.n as i32 } else { 0 };
  while mi < 2 + naux {
    let mut m: *Module = g_root_module;
    if mi == 0 {
      m = prelude_module;
    } else if mi >= 2 {
      m = g_aux_modules.items[mi - 2];
    }
    if m != null {
      let mut k: usize = 0;
      while k < m.syms.n {
        let sym: *Sym = m.syms.items[k].val;
        // lower real definitions only; externs declare without a body and
        // an empty-bodied fn is still callable
        if sym.kind == SymKind.SyFn && sym.decl != null &&
           sym.decl.kind == DeclKind.DkFn && !sym.decl.templated {
          g_ir_fns.push(lower_fn(sym));
        } else if sym.kind == SymKind.SyStatic {
          lower_static(sym);
        }
        k += 1;
      }
    }
    mi += 1;
  }
  lower_drop_unreachable();
}

// ------------------------------------------------------ reachability -----
//
// Post-lowering dead-function elimination (spec §11.3): the prelude carries
// formatting machinery most programs never touch, and lowering emits every
// checked fn. Every cross-function reference in the IR is a `callee` string
// — direct calls, address-taken fn values and globals, shims — so a symbol
// walk over instructions is the whole reference graph. Two classes are kept
// beyond the graph: the entry fn, and the fns backends call by symbol from
// emitted code (__panic_div).
// Emission order is preserved — determinism is untouched.

struct ReachEnt {
  key: string,
  val: *IRFn,
}

struct ReachMap {
  slots: []*ReachEnt,
  cap: usize,
  n: usize,
}

fn rm_put(m: *ReachMap, key: string, val: *IRFn) {
  if m.n * 10 >= m.cap * 7 {
    let ncap: usize = if m.cap == 0 { 64 } else { m.cap * 2 };
    let slots: []*ReachEnt = make([]*ReachEnt, ncap);
    let old: []*ReachEnt = m.slots;
    let oldn: usize = m.cap;
    m.slots = slots;
    m.cap = ncap;
    m.n = 0;
    let mut i: usize = 0;
    while i < oldn {
      if old[i] != null {
        rm_put(m, old[i].key, old[i].val);
      }
      i += 1;
    }
  }
  let mut i: usize = map_hash(key) & (m.cap - 1);
  while m.slots[i] != null {
    if streq(m.slots[i].key, key) {
      m.slots[i].val = val;
      return;
    }
    i = (i + 1) & (m.cap - 1);
  }
  m.slots[i] = new ReachEnt { key: key, val: val };
  m.n += 1;
}

fn rm_get(m: *ReachMap, key: string) -> *IRFn {
  if m.cap == 0 {
    return null;
  }
  let mut i: usize = map_hash(key) & (m.cap - 1);
  while m.slots[i] != null {
    if streq(m.slots[i].key, key) {
      return m.slots[i].val;
    }
    i = (i + 1) & (m.cap - 1);
  }
  return null;
}

static mut g_reach_all: *ReachMap = 0 as *ReachMap;
static mut g_reach_keep: *ReachMap = 0 as *ReachMap;
static mut g_reach_work: *Vec[string] = 0 as *Vec[string];

fn reach_visit(sym: string) {
  let fn_: *IRFn = rm_get(g_reach_all, sym);
  if fn_ != null && rm_get(g_reach_keep, fn_.symbol) == null {
    rm_put(g_reach_keep, fn_.symbol, fn_);
    g_reach_work.push(sym);
  }
}

fn lower_drop_unreachable() {
  if g_ir_fns.n == 0 {
    return;
  }
  g_reach_all = new ReachMap { slots: make([]*ReachEnt, 0), cap: 0, n: 0 };
  let mut i: usize = 0;
  while i < g_ir_fns.n {
    rm_put(g_reach_all, g_ir_fns.items[i].symbol, g_ir_fns.items[i]);
    i += 1;
  }
  // entry point; without a resolvable one (defensive — every real build has
  // main) keep everything rather than guess
  if g_main_cell == null || g_main_cell.items[0] == "" ||
     rm_get(g_reach_all, g_main_cell.items[0]) == null {
    return;
  }
  g_reach_keep = new ReachMap { slots: make([]*ReachEnt, 0), cap: 0, n: 0 };
  g_reach_work = new Vec[string] { items: make([]string, 64), n: 0 };
  reach_visit(g_main_cell.items[0]);
  // the divide-by-zero check every backend emits references by symbol
  reach_visit(prelude_symbol("__panic_div"));
  while g_reach_work.n > 0 {
    let sym: string = g_reach_work.pop();
    let fn_: *IRFn = rm_get(g_reach_all, sym);
    if fn_ == null {
      continue;
    }
    let mut bi: usize = 0;
    while bi < len(fn_.blocks) {
      let b: *IRBlock = fn_.blocks[bi];
      let mut ii: usize = 0;
      while ii < len(b.ins) {
        if b.ins[ii].callee != "" {
          reach_visit(b.ins[ii].callee);
        }
        ii += 1;
      }
      bi += 1;
    }
  }
  // filter in place, preserving emission order
  let mut w: usize = 0;
  i = 0;
  while i < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[i];
    if rm_get(g_reach_keep, fn_.symbol) != null {
      g_ir_fns.items[w] = fn_;
      w += 1;
    }
    i += 1;
  }
  g_ir_fns.n = w;
}


// ================= emit_wasm (LOW-10): wasm32-wasi binary emitter ===========
// Vregs become wasm locals, frame slots live in linear memory at $fb + off,
// the structured CFG is re-nested (if-diamonds close over `block $join`,
// loops become `block $exit loop $h`), and function addresses — closure code
// fields and rc drop glue — are table indices reached through call_indirect.

struct WType {
  params: []i64, // IRType values
  has_ret: bool,
  ret: IRType,
  index: i32,
}

struct WFn {
  fn_: *IRFn,
  index: i32, // function index (after the two wasi imports)
  type_: i32,
}

struct WLabel {
  kind: i32, // 0 block(exit), 1 loop(header), 2 if placeholder
  b: *IRBlock,
}

struct WClaim {
  b: *IRBlock,
  base: i32, // labels.n at claim time: br depth = labels.n - base
}

struct I64Ent { key: string, val: i64 }
struct I64Map { items: []*I64Ent }

fn im_put(m: *I64Map, key: string, val: i64) {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      m.items[i].val = val;
      return;
    }
    i += 1;
  }
  m.items = push_i64ent(m.items, new I64Ent { key: key, val: val });
}

fn push_i64ent(items: []*I64Ent, e: *I64Ent) -> []*I64Ent {
  let out: []*I64Ent = make([]*I64Ent, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = e;
  return out;
}

fn im_get(m: *I64Map, key: string) -> i64 {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return -1;
}

fn im_has(m: *I64Map, key: string) -> bool {
  return im_get(m, key) != -1 || im_has_zero(m, key);
}

fn im_has_zero(m: *I64Map, key: string) -> bool {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      return true;
    }
    i += 1;
  }
  return false;
}

struct WFnEnt { key: string, val: *WFn }
struct WFnMap { items: []*WFnEnt }

fn fm_put(m: *WFnMap, key: string, val: *WFn) {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      m.items[i].val = val;
      return;
    }
    i += 1;
  }
  m.items = push_wfnent(m.items, new WFnEnt { key: key, val: val });
}

fn push_wfnent(items: []*WFnEnt, e: *WFnEnt) -> []*WFnEnt {
  let out: []*WFnEnt = make([]*WFnEnt, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = e;
  return out;
}

fn fm_get(m: *WFnMap, key: string) -> *WFn {
  let mut i: usize = 0;
  while i < len(m.items) {
    if streq(m.items[i].key, key) {
      return m.items[i].val;
    }
    i += 1;
  }
  return null;
}

struct WState {
  fns: []*WFn,
  types: []*WType,
  type_keys: []string, // parallel to types: dedup key per entry
  fn_by_symbol: *WFnMap,
  table_idx: *I64Map,  // symbol -> index+1 (0 = absent)
  table_fns: []string,
  global_addr: *I64Map,
  lit_addr: *I64Map,
  heap_base: i64,
  stack_top: i64,
  data_end: i64,
}

static mut W: *WState = 0 as *WState;

// ---- raw bytes -----------------------------------------------------------------

fn b8(sb: *Vec[u8], b: u8) {
  sb.push(b);
}

fn buleb(sb: *Vec[u8], v: u64) {
  loop {
    let mut b: u8 = (v & 127) as u8;
    let rest: u64 = v >> 7;
    if rest != 0 {
      b = b | 128;
    }
    b8(sb, b);
    if rest == 0 {
      break;
    }
    v = rest;
  }
}

fn bsleb(sb: *Vec[u8], v: i64) {
  let mut more: bool = true;
  let mut x: i64 = v;
  while more {
    let mut b: u8 = (x & 127) as u8;
    x = x >> 7;
    if (x == 0 && (b & 64) == 0) || (x == -1 && (b & 64) != 0) {
      more = false;
    } else {
      b = b | 128;
    }
    b8(sb, b);
  }
}

fn bstr(sb: *Vec[u8], s: string) {
  buleb(sb, len(s) as u64);
  let mut i: usize = 0;
  while i < len(s) {
    b8(sb, s[i]);
    i += 1;
  }
}

fn bsection(out: *Vec[u8], id: u8, body: *Vec[u8]) {
  b8(out, id);
  buleb(out, body.n as u64);
  let mut i: usize = 0;
  while i < body.n {
    b8(out, body.items[i]);
    i += 1;
  }
}

fn bappend(dst: *Vec[u8], src: *Vec[u8]) {
  let mut i: usize = 0;
  while i < src.n {
    b8(dst, src.items[i]);
    i += 1;
  }
}

fn w_vt(t: IRType) -> u8 {
  if t == IRType.ItF32 { return 0x7D; }
  if t == IRType.ItF64 { return 0x7C; }
  if t == IRType.ItI64 || t == IRType.ItU64 || t == IRType.ItUsize { return 0x7E; }
  return 0x7F;
}

fn w_vt_i(t: i64) -> u8 {
  let f32v: i64 = IRType.ItF32 as i64;
  let f64v: i64 = IRType.ItF64 as i64;
  let i64v: i64 = IRType.ItI64 as i64;
  let u64v: i64 = IRType.ItU64 as i64;
  let uszv: i64 = IRType.ItUsize as i64;
  if t == f32v { return 0x7D; }
  if t == f64v { return 0x7C; }
  if t == i64v || t == u64v || t == uszv { return 0x7E; }
  return 0x7F;
}

fn w_is64(t: IRType) -> bool {
  return t == IRType.ItI64 || t == IRType.ItU64 || t == IRType.ItUsize;
}

fn ir_fn_for_symbol(symbol: string) -> *IRFn {
  let mut i: usize = 0;
  while i < g_ir_fns.n {
    if streq(g_ir_fns.items[i].symbol, symbol) {
      return g_ir_fns.items[i];
    }
    i += 1;
  }
  return null;
}

// ---- types ----------------------------------------------------------------------

fn w_type_key(params: []i64, has_ret: bool, ret: IRType) -> string {
  let mut k: string = "";
  let mut i: usize = 0;
  while i < len(params) {
    k = cat3(k, itoa(params[i]), ",");
    i += 1;
  }
  let mut r: i64 = -1;
  if has_ret {
    r = ret as i64;
  }
  return cat3(k, "->", itoa(r));
}

fn w_type_for(params: []i64, has_ret: bool, ret: IRType) -> i32 {
  let k: string = w_type_key(params, has_ret, ret);
  let mut i: usize = 0;
  while i < len(W.type_keys) {
    if streq(W.type_keys[i], k) {
      return W.types[i].index;
    }
    i += 1;
  }
  let t: *WType = new WType {
    params: params, has_ret: has_ret, ret: ret,
    index: len(W.types) as i32,
  };
  W.types = push_wtype(W.types, t);
  W.type_keys = push_str(W.type_keys, k);
  return t.index;
}

fn push_wtype(items: []*WType, t: *WType) -> []*WType {
  let out: []*WType = make([]*WType, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = t;
  return out;
}

fn ty_travels_as_ptr(pt: *Type) -> bool {
  if pt == null {
    return false;
  }
  return pt.kind == TypeKind.TyStruct || pt.kind == TypeKind.TyEnum ||
         pt.kind == TypeKind.TySlice || pt.kind == TypeKind.TyStringK ||
         pt.kind == TypeKind.TyArray || pt.kind == TypeKind.TyFn;
}

// does any RET terminator in fn carry a value?
fn fn_returns_value(fn_: *IRFn) -> bool {
  let mut b: usize = 0;
  while b < len(fn_.blocks) {
    let blk: *IRBlock = fn_.blocks[b];
    if blk.term_op == 102 && blk.ret_val != null {
      return true;
    }
    b += 1;
  }
  return false;
}

fn w_type_of_fn(fn_: *IRFn) -> i32 {
  let mut params: []i64 = make([]i64, 0);
  // agg returns: the hidden out pointer is the FIRST signature param
  if fn_.returns_aggregate {
    params = push_i64(params, IRType.ItPtr as i64);
  }
  let mut i: usize = 0;
  while i < len(fn_.params) {
    let mut pt: *Type = null;
    if i < len(fn_.param_types) {
      pt = fn_.param_types[i];
    }
    // synth (rc) fns carry NULL param types: their params are pointers
    let mut it: IRType = IRType.ItPtr;
    if pt != null && !ty_travels_as_ptr(pt) {
      it = ir_type_of(pt);
    }
    params = push_i64(params, it as i64);
    i += 1;
  }
  // synth (rc) fns carry fn->ret == null whether or not they return — ask
  // the terminators: any RET with a value means the signature needs one
  let no_ret: bool = fn_.returns_aggregate ||
      (fn_.ret != null && fn_.ret.kind == TypeKind.TyVoid) ||
      (fn_.ret == null && !fn_returns_value(fn_));
  if no_ret {
    return w_type_for(params, false, IRType.ItI32);
  }
  let mut ret: IRType = IRType.ItPtr; // synth fns return ptrs
  if fn_.ret != null {
    ret = ir_type_of(fn_.ret);
  }
  return w_type_for(params, true, ret);
}

fn w_type_of_call(i: *IRIns) -> i32 {
  let mut params: []i64 = make([]i64, 0);
  let mut k: usize = 0;
  while k < len(i.args) {
    params = push_i64(params, i.args[k].ty as i64);
    k += 1;
  }
  if i.dst != null {
    return w_type_for(params, true, i.dst.ty);
  }
  return w_type_for(params, false, IRType.ItI32);
}

// ---- data layout ------------------------------------------------------------------
// 1024 | statics | [24B immortal header + bytes] per literal | heap | ... | stack

fn w_layout_data() {
  let mut at: i64 = 1024;
  let mut g: usize = 0;
  while g < g_ir_globals.n {
    let gl: *IRGlobal = g_ir_globals.items[g];
    if !gl.is_extern {
      let al: i64 = if gl.align < 8 { 8 } else { gl.align };
      at = round_up_i64(at, al);
      im_put(W.global_addr, gl.symbol, at);
      at += gl.size;
    }
    g += 1;
  }
  let mut f: usize = 0;
  while f < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[f];
    let mut l: usize = 0;
    while l < len(fn_.literals) {
      let lit: *IRLit = fn_.literals[l];
      at = round_up_i64(at, 8);
      im_put(W.lit_addr, lit.label, at);
      at += 24 + len(lit.bytes) as i64;
      l += 1;
    }
    f += 1;
  }
  // layout law (0.4.1): the SHADOW STACK sits directly above the data
  // image in a fixed 256 MiB slot, and the heap starts at the stack's top
  // and grows UP without bound — the heap can never eat the stack, and a
  // heap-heavy program (this compiler checking its own source churns
  // ~800 MB) grows memory on demand instead of dying at the old 64 MiB
  // ceiling. The engine's wasm stack (max-wasm-stack) is separate and
  // bounds the shadow stack's depth.
  let mut st: i64 = round_up_i64(at, 16);
  st = st + 0x4000000;
  st = st + 0x4000000;
  st = st - 1;
  W.stack_top = st / 0x4000000 * 0x4000000;
  W.heap_base = W.stack_top;
  // the wasi prelude's HEAP static starts allocation above the stack slot
  g = 0;
  while g < g_ir_globals.n {
    let gl: *IRGlobal = g_ir_globals.items[g];
    if !gl.is_extern && len(gl.init) == 8 && len(gl.symbol) >= 5 &&
       streq(slice_str(gl.symbol, len(gl.symbol) - 5, len(gl.symbol)), "_HEAP") {
      let v: u64 = W.heap_base as u64;
      let mut b: i32 = 0;
      while b < 8 {
        gl.init[b] = ((v >> (8 * b)) & 255) as u8;
        b += 1;
      }
    }
    g += 1;
  }
  W.data_end = at;
}

fn slice_str(s: string, lo: usize, hi: usize) -> string {
  return s[lo..hi];
}

// ---- per-function emission ----------------------------------------------------------

struct WFnCtx {
  fn_: *IRFn,
  body: *Vec[u8],
  slot_off: []i64, // slot id -> frame offset (-1 = not yet laid out)
  frame: i64,
  hidden: i32,
  labels: []*WLabel,
  claims: []*WClaim,
}

fn push_claim(items: []*WClaim, c: *WClaim) -> []*WClaim {
  let out: []*WClaim = make([]*WClaim, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = c;
  return out;
}

fn push_label(items: []*WLabel, l: *WLabel) -> []*WLabel {
  let out: []*WLabel = make([]*WLabel, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = l;
  return out;
}

fn slot_offset(c: *WFnCtx, s: *IRSlot) -> i64 {
  while len(c.slot_off) <= s.id as usize {
    c.slot_off = push_i64(c.slot_off, -1);
  }
  let mut off: i64 = c.slot_off[s.id];
  if off >= 0 {
    return off;
  }
  let al: i64 = if s.align > 8 { 8 } else { s.align };
  let sz: i64 = if s.size < 8 { 8 } else { s.size };
  c.frame = round_up_i64(c.frame, al);
  off = c.frame;
  c.frame += sz;
  c.slot_off[s.id] = off;
  return off;
}

// local layout: [hidden out ptr] [declared params] [$fb] [vregs...]
fn fb_local(c: *WFnCtx) -> i64 {
  return len(c.fn_.params) as i64 + c.hidden as i64;
}

fn vreg_local(c: *WFnCtx, v: *IRVreg) -> i64 {
  return len(c.fn_.params) as i64 + c.hidden as i64 + 1 + v.id as i64;
}

fn lget(c: *WFnCtx, v: *IRVreg) {
  b8(c.body, 0x20);
  buleb(c.body, vreg_local(c, v) as u64);
}

fn lset(c: *WFnCtx, v: *IRVreg) {
  b8(c.body, 0x21);
  buleb(c.body, vreg_local(c, v) as u64);
}

fn i32c(c: *WFnCtx, v: i64) {
  b8(c.body, 0x41);
  bsleb(c.body, v);
}

fn emit_load(c: *WFnCtx, i: *IRIns) {
  lget(c, i.addr);
  // op follows the DESTINATION wasm type: pointers are 8 bytes in memory
  // but i32 locals (addresses fit the 32-bit memory space)
  let t: IRType = i.dst.ty;
  if t == IRType.ItF32 {
    b8(c.body, 0x2A);
    buleb(c.body, 2);
  } else if t == IRType.ItF64 {
    b8(c.body, 0x2B);
    buleb(c.body, 3);
  } else if w_is64(t) {
    b8(c.body, 0x29); // i64.load
    buleb(c.body, 3);
  } else {
    let sz: i64 = i.size;
    let sgn: bool = ty_is_signed_int(t);
    let mut op: u8 = 0x28;
    let mut align: u64 = 2;
    if sz == 1 {
      if sgn { op = 0x2C; } else { op = 0x2D; }
      align = 0;
    } else if sz == 2 {
      if sgn { op = 0x2E; } else { op = 0x2F; }
      align = 1;
    }
    b8(c.body, op);
    buleb(c.body, align);
  }
  buleb(c.body, 0);
  lset(c, i.dst);
}

fn emit_store(c: *WFnCtx, i: *IRIns) {
  lget(c, i.addr);
  lget(c, i.a);
  // pointers store as i32 regardless of the 8-byte memory footprint;
  // everything else follows the store SIZE
  let t: IRType = i.a.ty;
  let sz: i64 = i.size;
  if i.is_float {
    if sz == 4 {
      b8(c.body, 0x38);
      buleb(c.body, 2);
    } else {
      b8(c.body, 0x39);
      buleb(c.body, 3);
    }
  } else if t == IRType.ItPtr {
    b8(c.body, 0x36); // i32.store
    buleb(c.body, 2);
  } else {
    // the size is authoritative: a narrow-typed value (e.g. a cast the
    // checker adapted at the assignment) stored into an 8-byte field must
    // reach i64, and a wide value into a narrow field must wrap
    if sz == 8 && !w_is64(t) {
      b8(c.body, 0xAD); // i64.extend_i32_u
    } else if sz < 8 && w_is64(t) {
      b8(c.body, 0xA7); // i32.wrap_i64
    }
    let mut op: u8 = 0x37;
    let mut align: u64 = 3;
    if sz == 1 { op = 0x3A; align = 0; }
    else if sz == 2 { op = 0x3B; align = 1; }
    else if sz == 4 { op = 0x36; align = 2; }
    b8(c.body, op);
    buleb(c.body, align);
  }
  buleb(c.body, 0);
}

fn arith_op(op: IROp, ty: IRType, sgn: bool, flt: bool) -> u8 {
  let is64: bool = w_is64(ty);
  if op == IROp.IrAdd {
    if flt {
      if ty == IRType.ItF32 { return 0x92; }
      return 0xA0;
    }
    if is64 { return 0x7C; }
    return 0x6A;
  }
  if op == IROp.IrSub {
    if flt {
      if ty == IRType.ItF32 { return 0x93; }
      return 0xA1;
    }
    if is64 { return 0x7D; }
    return 0x6B;
  }
  if op == IROp.IrMul {
    if flt {
      if ty == IRType.ItF32 { return 0x94; }
      return 0xA2;
    }
    if is64 { return 0x7E; }
    return 0x6C;
  }
  if op == IROp.IrDiv {
    if flt {
      if ty == IRType.ItF32 { return 0x95; }
      return 0xA3;
    }
    if is64 {
      if sgn { return 0x7F; }
      return 0x80;
    }
    if sgn { return 0x6D; }
    return 0x6E;
  }
  if op == IROp.IrMod {
    if is64 {
      if sgn { return 0x81; }
      return 0x82;
    }
    if sgn { return 0x6F; }
    return 0x70;
  }
  if op == IROp.IrAnd { if is64 { return 0x83; } return 0x71; }
  if op == IROp.IrOr { if is64 { return 0x84; } return 0x72; }
  if op == IROp.IrXor { if is64 { return 0x85; } return 0x73; }
  if op == IROp.IrShl { if is64 { return 0x86; } return 0x74; }
  if op == IROp.IrShr {
    if is64 {
      if sgn { return 0x87; }
      return 0x88;
    }
    if sgn { return 0x75; }
    return 0x76;
  }
  return 0x6A;
}

fn emit_cmp(c: *WFnCtx, i: *IRIns) {
  lget(c, i.a);
  lget(c, i.b);
  if i.is_float {
    // eq ne lt gt le ge — f32 0x5B.., f64 0x61..
    let mut idx: i32 = 5;
    if i.cc == IRCC.CcEq { idx = 0; }
    else if i.cc == IRCC.CcNe { idx = 1; }
    else if i.cc == IRCC.CcLt { idx = 2; }
    else if i.cc == IRCC.CcGt { idx = 3; }
    else if i.cc == IRCC.CcLe { idx = 4; }
    let f32ops: []u8 = make([]u8, 6);
    f32ops[0] = 0x5B; f32ops[1] = 0x5C; f32ops[2] = 0x5D;
    f32ops[3] = 0x5E; f32ops[4] = 0x5F; f32ops[5] = 0x60;
    let f64ops: []u8 = make([]u8, 6);
    f64ops[0] = 0x61; f64ops[1] = 0x62; f64ops[2] = 0x63;
    f64ops[3] = 0x64; f64ops[4] = 0x65; f64ops[5] = 0x66;
    if i.a.ty == IRType.ItF32 {
      b8(c.body, f32ops[idx]);
    } else {
      b8(c.body, f64ops[idx]);
    }
  } else {
    let is64: bool = w_is64(i.a.ty);
    // pointer(+/-)usize comparisons mix i32 and i64 on wasm32: unify to
    // the a-side's width, same contract as the ADD/SUB family
    if is64 && !w_is64(i.b.ty) {
      b8(c.body, 0xAD); // i64.extend_i32_u
    } else if !is64 && w_is64(i.b.ty) {
      b8(c.body, 0xA7); // i32.wrap_i64
    }
    let mut base: i32 = 0x46;
    if is64 {
      base = 0x51;
    }
    let mut idx: i32 = 0;
    if i.cc == IRCC.CcEq { idx = 0; }
    else if i.cc == IRCC.CcNe { idx = 1; }
    else if i.cc == IRCC.CcLt { if i.signed_ops { idx = 2; } else { idx = 3; } }
    else if i.cc == IRCC.CcLe { if i.signed_ops { idx = 6; } else { idx = 7; } }
    else if i.cc == IRCC.CcGt { if i.signed_ops { idx = 4; } else { idx = 5; } }
    else if i.cc == IRCC.CcGe { if i.signed_ops { idx = 8; } else { idx = 9; } }
    b8(c.body, (base + idx) as u8);
  }
  lset(c, i.dst);
}

fn prelude_symbol(name: string) -> string {
  let fn_: *Sym = prelude_fn(name);
  if fn_ != null {
    return sym_symbol(fn_);
  }
  return name;
}

// integer div/mod with the zero and MIN/-1 guards the spec promises:
// divisor == 0 -> __panic_div; signed divisor == -1 -> 0 - a (wraps)
fn emit_int_divmod(c: *WFnCtx, i: *IRIns) {
  let is64: bool = w_is64(i.a.ty);
  lget(c, i.b);
  if is64 { b8(c.body, 0x50); } else { b8(c.body, 0x45); } // eqz
  b8(c.body, 0x04); // if void
  b8(c.body, 0x40);
  {
    let sym: string = prelude_symbol("__panic_div");
    let t: *WFn = fm_get(W.fn_by_symbol, sym);
    if t != null {
      b8(c.body, 0x10); // call
      buleb(c.body, t.index as u64);
    }
    b8(c.body, 0x00); // unreachable — panic never returns
  }
  b8(c.body, 0x05); // else
  if i.signed_ops {
    lget(c, i.b);
    if is64 {
      b8(c.body, 0x42); // i64.const -1
      bsleb(c.body, -1);
      b8(c.body, 0x51); // i64.eq
    } else {
      b8(c.body, 0x41); // i32.const -1
      bsleb(c.body, -1);
      b8(c.body, 0x46); // i32.eq
    }
    b8(c.body, 0x04); // if void
    b8(c.body, 0x40);
    // dst = 0 - a (wraps: MIN / -1 -> MIN)
    if is64 {
      b8(c.body, 0x42);
      bsleb(c.body, 0);
    } else {
      b8(c.body, 0x41);
      bsleb(c.body, 0);
    }
    lget(c, i.a);
    if is64 { b8(c.body, 0x7D); } else { b8(c.body, 0x6B); } // sub
    lset(c, i.dst);
    b8(c.body, 0x05); // else
    lget(c, i.a);
    lget(c, i.b);
    b8(c.body, arith_op(i.op, i.a.ty, i.signed_ops, false));
    lset(c, i.dst);
    b8(c.body, 0x0B); // end
  } else {
    lget(c, i.a);
    lget(c, i.b);
    b8(c.body, arith_op(i.op, i.a.ty, i.signed_ops, false));
    lset(c, i.dst);
  }
  b8(c.body, 0x0B); // end if
}

fn table_index_of(symbol: string) {
  if im_has(W.table_idx, symbol) {
    return;
  }
  W.table_fns = push_str(W.table_fns, symbol);
  im_put(W.table_idx, symbol, len(W.table_fns) as i64);
}

// wasi_snapshot_preview1 imports this emitter wires into every module.
// The array order IS the import index order used by the call mapping in
// emit_ins (IR_CALL with one of these callees emits call <array index>).
struct WasiImport {
  name: string,
  params: []IRType,
  has_ret: bool,
  ret: IRType,
}

static mut g_wasi_imports: *Vec[*WasiImport] = 0 as *Vec[*WasiImport];

fn wasi_i32s(n: usize) -> []IRType {
  let out: []IRType = make([]IRType, n);
  let mut i: usize = 0;
  while i < n {
    out[i] = IRType.ItI32;
    i += 1;
  }
  return out;
}

fn wasi_import_n() -> i32 {
  return wasi_imports().n as i32;
}

fn wasi_imports() -> *Vec[*WasiImport] {
  if g_wasi_imports == null {
    let v: *Vec[*WasiImport] = new Vec[*WasiImport] { items: make([]*WasiImport, 8), n: 0 };
    v.push(new WasiImport { name: "fd_write", params: wasi_i32s(4), has_ret: true, ret: IRType.ItI32 });
    v.push(new WasiImport { name: "proc_exit", params: wasi_i32s(1), has_ret: false, ret: IRType.ItI32 });
    v.push(new WasiImport { name: "args_sizes_get", params: wasi_i32s(2), has_ret: true, ret: IRType.ItI32 });
    v.push(new WasiImport { name: "args_get", params: wasi_i32s(2), has_ret: true, ret: IRType.ItI32 });
    let po: []IRType = make([]IRType, 9);
    po[0] = IRType.ItI32;
    po[1] = IRType.ItI32;
    po[2] = IRType.ItI32;
    po[3] = IRType.ItI32;
    po[4] = IRType.ItI32;
    po[5] = IRType.ItI64;
    po[6] = IRType.ItI64;
    po[7] = IRType.ItI32;
    po[8] = IRType.ItI32;
    v.push(new WasiImport { name: "path_open", params: po, has_ret: true, ret: IRType.ItI32 });
    v.push(new WasiImport { name: "fd_read", params: wasi_i32s(4), has_ret: true, ret: IRType.ItI32 });
    v.push(new WasiImport { name: "fd_close", params: wasi_i32s(1), has_ret: true, ret: IRType.ItI32 });
    v.push(new WasiImport { name: "path_rename", params: wasi_i32s(6), has_ret: true, ret: IRType.ItI32 });
    g_wasi_imports = v;
  }
  return g_wasi_imports;
}

fn wasi_import_of(name: string) -> i64 {
  let tab: *Vec[*WasiImport] = wasi_imports();
  let mut k: usize = 0;
  while k < tab.n {
    if streq(tab.items[k].name, name) {
      return k as i64;
    }
    k += 1;
  }
  return (0 - 1) as i64;
}

fn intrinsics_f32_bits(x: f64) -> u32 {
  return intrinsics.f32_bits(x as f32);
}

fn intrinsics_f64_bits(x: f64) -> u64 {
  return intrinsics.f64_bits(x);
}

fn emit_ins(c: *WFnCtx, i: *IRIns) {
  if i.op == IROp.IrMemsize {
    // memory.size (pages) -> usize local; the wasi prelude scales to bytes
    b8(c.body, 0x3F);
    b8(c.body, 0x00);
    b8(c.body, 0xAD); // i64.extend_i32_u (usize vregs are i64 on wasm32)
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrMemgrow {
    lget(c, i.a);
    b8(c.body, 0xA7); // i32.wrap_i64 (pages arg is i32 to the engine)
    b8(c.body, 0x40); // memory.grow
    b8(c.body, 0x00);
    b8(c.body, 0xAD); // i64.extend_i32_u (old pages / 0xFFFFFFFF)
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrConst {
    if w_is64(i.dst.ty) {
      b8(c.body, 0x42);
      bsleb(c.body, i.imm);
    } else {
      b8(c.body, 0x41);
      bsleb(c.body, i.imm as i32 as i64);
    }
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrFconst {
    if i.dst.ty == IRType.ItF32 {
      let bits: u32 = intrinsics_f32_bits(i.fimm);
      b8(c.body, 0x43);
      let mut k: i32 = 0;
      while k < 4 {
        b8(c.body, ((bits >> (8 * k)) & 255) as u8);
        k += 1;
      }
    } else {
      let bits: u64 = intrinsics_f64_bits(i.fimm);
      b8(c.body, 0x44);
      let mut k: i32 = 0;
      while k < 8 {
        b8(c.body, ((bits >> (8 * k)) & 255) as u8);
        k += 1;
      }
    }
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrDiv || i.op == IROp.IrMod {
    if !i.is_float {
      emit_int_divmod(c, i);
      return;
    }
    // fall through to the float path
  }
  if i.op == IROp.IrAdd || i.op == IROp.IrSub || i.op == IROp.IrMul ||
     i.op == IROp.IrDiv || i.op == IROp.IrMod || i.op == IROp.IrAnd ||
     i.op == IROp.IrOr || i.op == IROp.IrXor || i.op == IROp.IrShl ||
     i.op == IROp.IrShr {
    lget(c, i.a);
    lget(c, i.b);
    // pointer(+/-)usize mixes i32 and i64 on wasm32: narrow the wide side
    // (wrap semantics; addresses live in the 32-bit memory space)
    if !w_is64(i.a.ty) && w_is64(i.b.ty) && !i.is_float {
      b8(c.body, 0xA7); // i32.wrap_i64
    } else if w_is64(i.a.ty) && !w_is64(i.b.ty) && !i.is_float {
      b8(c.body, 0xAD); // i64.extend_i32_u — zero-extend the narrow side
    }
    b8(c.body, arith_op(i.op, i.a.ty, i.signed_ops, i.is_float));
    // the value must land at the DST's declared width — locals are typed
    // by dst->ty, so an add whose operands narrowed under a wide dst (or
    // widened under a narrow one) reconciles here
    if !i.is_float {
      if w_is64(i.dst.ty) && !w_is64(i.a.ty) {
        b8(c.body, 0xAD); // i64.extend_i32_u
      } else if !w_is64(i.dst.ty) && w_is64(i.a.ty) {
        b8(c.body, 0xA7); // i32.wrap_i64
      }
    }
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrCmp {
    emit_cmp(c, i);
    return;
  }
  if i.op == IROp.IrLoad {
    emit_load(c, i);
    return;
  }
  if i.op == IROp.IrStore {
    emit_store(c, i);
    return;
  }
  if i.op == IROp.IrAddrc {
    if i.lit == -1 && i.callee != "" {
      if ir_fn_for_symbol(i.callee) != null {
        table_index_of(i.callee);
        i32c(c, im_get(W.table_idx, i.callee) - 1);
      } else {
        i32c(c, im_get(W.global_addr, i.callee));
      }
      lset(c, i.dst);
    } else {
      // frame slot address: $fb + off
      b8(c.body, 0x20);
      buleb(c.body, fb_local(c) as u64);
      i32c(c, slot_offset(c, i.slot));
      b8(c.body, 0x6A);
      lset(c, i.dst);
    }
    return;
  }
  if i.op == IROp.IrLitaddr {
    let lit: *IRLit = c.fn_.literals[i.lit];
    i32c(c, im_get(W.lit_addr, lit.label));
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrAddi {
    lget(c, i.a);
    i32c(c, i.imm);
    b8(c.body, 0x6A);
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrCall {
    if i.callee != "" {
      // resolve first: a body-less rho fn (empty {}) is a no-op, and its
      // arg drops must not follow an already-emitted call opcode
      let import: i64 = wasi_import_of(i.callee);
      let mut t: *WFn = null;
      if import < 0 {
        t = fm_get(W.fn_by_symbol, i.callee);
        if t == null {
          // args are never evaluated on this path (their vregs simply go
          // unconsumed), so only an expected result needs synthesizing
          if i.dst != null {
            if i.dst.ty == IRType.ItF32 || i.dst.ty == IRType.ItF64 {
              if i.dst.ty == IRType.ItF32 {
                b8(c.body, 0x43);
              } else {
                b8(c.body, 0x44);
              }
              let mut z: i32 = 0;
              let mut zb: i32 = 8;
              if i.dst.ty == IRType.ItF32 {
                zb = 4;
              }
              while z < zb {
                b8(c.body, 0);
                z += 1;
              }
            } else {
              if w_is64(i.dst.ty) {
                b8(c.body, 0x42);
              } else {
                b8(c.body, 0x41);
              }
              b8(c.body, 0x00);
            }
            lset(c, i.dst);
          }
          return;
        }
      }
      let mut k: usize = 0;
      while k < len(i.args) {
        lget(c, i.args[k]);
        k += 1;
      }
      b8(c.body, 0x10);
      if import >= 0 {
        buleb(c.body, import as u64);
      } else {
        buleb(c.body, t.index as u64);
      }
    } else {
      let mut k: usize = 0;
      while k < len(i.args) {
        lget(c, i.args[k]);
        k += 1;
      }
      lget(c, i.callee_vreg);
      b8(c.body, 0x11); // call_indirect
      buleb(c.body, w_type_of_call(i) as u64);
      buleb(c.body, 0);
    }
    if i.dst != null {
      lset(c, i.dst);
    }
    return;
  }
  if i.op == IROp.IrCast {
    lget(c, i.a);
    let from: IRType = i.cast_from;
    let to: IRType = i.cast_to;
    let sgn: bool = ty_is_signed_int(from);
    if i.cast == IRCastKind.CastTrunc {
      if w_is64(from) && !w_is64(to) {
        b8(c.body, 0xA7); // i32.wrap_i64
      }
    } else if i.cast == IRCastKind.CastSext {
      if !w_is64(from) && w_is64(to) {
        b8(c.body, 0xAC);
      }
    } else if i.cast == IRCastKind.CastZext {
      if !w_is64(from) && w_is64(to) {
        b8(c.body, 0xAD);
      }
    } else if i.cast == IRCastKind.CastI2f {
      // f32.convert_i32_s/u=0xB2/B3, f32.convert_i64_s/u=0xB4/B5,
      // f64.convert_i32_s/u=0xB7/B8, f64.convert_i64_s/u=0xB9/0xBA
      if to == IRType.ItF32 {
        if w_is64(from) {
          if sgn { b8(c.body, 0xB4); } else { b8(c.body, 0xB5); }
        } else {
          if sgn { b8(c.body, 0xB2); } else { b8(c.body, 0xB3); }
        }
      } else {
        if w_is64(from) {
          if sgn { b8(c.body, 0xB9); } else { b8(c.body, 0xBA); }
        } else {
          if sgn { b8(c.body, 0xB7); } else { b8(c.body, 0xB8); }
        }
      }
    } else if i.cast == IRCastKind.CastF2i {
      // saturating truncation (spec: out-of-range saturates)
      let sgn_to: bool = ty_is_signed_int(to);
      let mut op: i32 = 0;
      if w_is64(to) {
        op = (if from == IRType.ItF32 { 0x04 } else { 0x06 }) + (if sgn_to { 0 } else { 1 });
      } else {
        op = (if from == IRType.ItF32 { 0x00 } else { 0x02 }) + (if sgn_to { 0 } else { 1 });
      }
      b8(c.body, 0xFC);
      b8(c.body, op as u8);
    } else if i.cast == IRCastKind.CastF32F64 {
      b8(c.body, 0xBB); // f64.promote_f32
    } else if i.cast == IRCastKind.CastF64F32 {
      b8(c.body, 0xB6); // f32.demote_f64
    } else if i.cast == IRCastKind.CastReinterp {
      // i32.reinterpret_f32=0xBC, i64.reinterpret_f64=0xBD
      if from == IRType.ItF32 {
        b8(c.body, 0xBC);
      } else {
        b8(c.body, 0xBD);
      }
    } else if i.cast == IRCastKind.CastBitcopy {
      // same-memory-size reinterpretations; across the wasm32 split the
      // pointer half is i32, so 64-bit ints need a width hop
      if from == IRType.ItF32 && to == IRType.ItI32 {
        b8(c.body, 0xBC);
      } else if from == IRType.ItF64 && (to == IRType.ItI64 || to == IRType.ItUsize) {
        b8(c.body, 0xBD);
      } else if from == IRType.ItI32 && to == IRType.ItF32 {
        b8(c.body, 0xBE);
      } else if (from == IRType.ItI64 || from == IRType.ItUsize) && to == IRType.ItF64 {
        b8(c.body, 0xBF);
      } else if from == IRType.ItPtr && w_is64(to) {
        b8(c.body, 0xAD); // i64.extend_i32_u
      } else if w_is64(from) && to == IRType.ItPtr {
        b8(c.body, 0xA7); // i32.wrap_i64
      }
    }
    lset(c, i.dst);
    return;
  }
  if i.op == IROp.IrCopymem {
    lget(c, i.addr);
    lget(c, i.a);
    if i.size < 0 {
      lget(c, i.b); // runtime byte count
      // usize travels as an i64 local on this target, but memory.copy
      // takes i32 lengths
      if w_is64(i.b.ty) {
        b8(c.body, 0xA7); // i32.wrap_i64
      }
    } else {
      i32c(c, i.size);
    }
    b8(c.body, 0xFC);
    b8(c.body, 0x0A); // memory.copy
    buleb(c.body, 0);
    buleb(c.body, 0);
    return;
  }
  if i.op == IROp.IrZero {
    lget(c, i.addr);
    i32c(c, 0);
    i32c(c, i.size);
    b8(c.body, 0xFC);
    b8(c.body, 0x0B); // memory.fill
    buleb(c.body, 0);
    return;
  }
}
// ---- structured control flow -----------------------------------------------------
// Each branch/join gets exactly ONE label for its lifetime: the first diamond
// that targets it pushes it, arms br to it, and its code is emitted once after
// the outermost construct that referenced it. Loop headers carry explicit
// flags from the lowering (structural guessing mis-fires on rc glue CFGs).

fn pred_count(c: *WFnCtx, t: *IRBlock) -> i32 {
  let mut n: i32 = 0;
  let mut i: usize = 0;
  while i < len(c.fn_.blocks) {
    let b: *IRBlock = c.fn_.blocks[i];
    if b.term_op == 100 && b.br_true == t {
      n += 1;
    } else if b.term_op == 101 {
      if b.br_true == t {
        n += 1;
      }
      if b.br_false == t {
        n += 1;
      }
    }
    i += 1;
  }
  return n;
}

fn has_claim(c: *WFnCtx, b: *IRBlock) -> bool {
  if b == null {
    return false;
  }
  let mut i: usize = 0;
  while i < len(c.claims) {
    if c.claims[i].b == b {
      return true;
    }
    i += 1;
  }
  return false;
}

fn has_label(c: *WFnCtx, b: *IRBlock) -> bool {
  if b == null {
    return false;
  }
  let mut i: usize = 0;
  while i < len(c.labels) {
    if c.labels[i].b == b {
      return true;
    }
    i += 1;
  }
  return false;
}

fn has_target(c: *WFnCtx, b: *IRBlock) -> bool {
  return has_claim(c, b) || has_label(c, b);
}

fn inlineable(c: *WFnCtx, b: *IRBlock) -> bool {
  return !b.loop_header && !has_target(c, b) && !b.emitted && pred_count(c, b) == 1;
}

// can block `target` be reached from `from` following terminators through
// unlabeled, single-pred blocks? (small CFGs; bounded walk)
fn reaches(c: *WFnCtx, from: *IRBlock, target: *IRBlock, depth: i32) -> bool {
  if from == null || depth > 32 {
    return false;
  }
  let mut cur: *IRBlock = from;
  while cur != null {
    if cur == target {
      return true;
    }
    if cur.term_op == 0 {
      return false;
    }
    if cur.term_op == 100 {
      cur = cur.br_true;
    } else if cur.term_op == 102 {
      return false;
    } else {
      return reaches(c, cur.br_true, target, depth + 1) ||
             reaches(c, cur.br_false, target, depth + 1);
    }
  }
  return false;
}

// terminal br target of the chain starting at b (peek only), NULL on return
fn chain_terminal(c: *WFnCtx, b: *IRBlock) -> *IRBlock {
  let mut cur: *IRBlock = b;
  while cur != null {
    if !inlineable(c, cur) {
      return cur; // join, loop header, or labeled target
    }
    if cur.term_op == 0 {
      return null;
    }
    if cur.term_op == 100 {
      let t: *IRBlock = cur.br_true;
      if inlineable(c, t) {
        cur = t;
      } else {
        return t;
      }
    } else if cur.term_op == 102 {
      return cur; // a shared RET block is a join like any other
    } else {
      let r1: *IRBlock = chain_terminal(c, cur.br_true);
      let r2: *IRBlock = chain_terminal(c, cur.br_false);
      if r1 == r2 {
        return r1;
      }
      if r1 != null && r2 != null {
        // the arms' terminals differ: the true join is the deeper one the
        // other side eventually reaches
        let f12: bool = reaches(c, r1, r2, 0);
        let f21: bool = reaches(c, r2, r1, 0);
        if f12 {
          return r2;
        }
        if f21 {
          return r1;
        }
      }
      if r1 != null {
        return r1;
      }
      return r2;
    }
  }
  return null;
}

fn push_label_n(c: *WFnCtx, kind: i32, b: *IRBlock) {
  c.labels = push_label(c.labels, new WLabel { kind: kind, b: b });
}

fn pop_label(c: *WFnCtx) {
  let out: []*WLabel = make([]*WLabel, len(c.labels) - 1);
  let mut i: usize = 0;
  while i < len(c.labels) - 1 {
    out[i] = c.labels[i];
    i += 1;
  }
  c.labels = out;
}

fn pop_claim(c: *WFnCtx) {
  let out: []*WClaim = make([]*WClaim, len(c.claims) - 1);
  let mut i: usize = 0;
  while i < len(c.claims) - 1 {
    out[i] = c.claims[i];
    i += 1;
  }
  c.claims = out;
}

fn br_depth(c: *WFnCtx, t: *IRBlock) -> i32 {
  // claims first: br lands on the claiming diamond's own if — the last
  // construct opened since the claim — one below the raw count
  let mut i: usize = len(c.claims);
  while i > 0 {
    let cl: *WClaim = c.claims[i - 1];
    if cl.b == t {
      return len(c.labels) as i32 - cl.base - 1;
    }
    i -= 1;
  }
  i = len(c.labels);
  while i > 0 {
    if c.labels[i - 1].b == t {
      return len(c.labels) as i32 - i as i32;
    }
    i -= 1;
  }
  return -1;
}

fn edge_copies(c: *WFnCtx, from: *IRBlock, t: *IRBlock) {
  let mut p: usize = 0;
  while p < len(t.phis) {
    let phi: *IRPhi = t.phis[p];
    let mut k: usize = 0;
    while k < len(phi.preds) {
      if phi.preds[k] == from {
        let arg: *IRVreg = phi.args[k];
        lget(c, arg);
        // an argument may ride at a different width than the phi's own
        // declared type (a literal feeds its default i32 into a usize
        // phi): reconcile so the spill local's type matches
        if !ir_is_float_t(phi.dst.ty) {
          if w_is64(phi.dst.ty) && !w_is64(arg.ty) {
            b8(c.body, 0xAD); // i64.extend_i32_u
          } else if !w_is64(phi.dst.ty) && w_is64(arg.ty) {
            b8(c.body, 0xA7); // i32.wrap_i64
          }
        }
        lset(c, phi.dst);
      }
      k += 1;
    }
    p += 1;
  }
}

fn wasm_br(c: *WFnCtx, from: *IRBlock, t: *IRBlock) {
  edge_copies(c, from, t);
  let mut d: i32 = br_depth(c, t);
  if d < 0 {
    d = 0;
  }
  b8(c.body, 0x0C);
  buleb(c.body, d as u64);
}

// emits blocks from `b` (reached from `from`) until the region branches
// out or returns; returns the block the region branched to, or NULL.
fn emit_region_run(c: *WFnCtx, b_in: *IRBlock, from_in: *IRBlock) {
  let mut b: *IRBlock = b_in;
  let mut from: *IRBlock = from_in;
  let mut guard: i32 = 0;
  let mut ran: bool = false;
  while b != null && !b.emitted && !has_target(c, b) && guard < 4096 {
    guard += 1;
    ran = true;
    let next: *IRBlock = emit_region(c, b, from);
    from = b;
    b = next;
  }
  // an arm that BEGINS at an owned block (the short-circuit false edge
  // straight into the claimed join) used to fall through silently — the
  // position was right, but the br's phi edge copies never happened, so
  // `&&` results went stale across loop iterations. Branch explicitly.
  if !ran && b != null && (b.emitted || has_target(c, b)) {
    wasm_br(c, from, b);
  }
}

fn emit_region(c: *WFnCtx, b_in: *IRBlock, from_in: *IRBlock) -> *IRBlock {
  let mut started_loop: bool = false; // this invocation opened the loop labels
  let mut my_header: *IRBlock = null;
  let mut my_exit: *IRBlock = null;
  let mut from: *IRBlock = from_in;
  let mut b: *IRBlock = b_in;
  while b != null {
    if b.emitted || has_target(c, b) {
      if started_loop && (b == my_header || b == my_exit) {
        // a child region already br'd to our header (back edge — the body
        // is complete) or to our exit (break out of both loops): the br is
        // out; close the loop and continue with the exit's code here
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
        if my_exit == null {
          return null;
        }
        from = b;
        b = my_exit;
        started_loop = false;
        my_header = null;
        my_exit = null;
        continue;
      }
      wasm_br(c, from, b);
      return b;
    }
    if b.loop_header {
      // block $exit { loop $h { <body>; } } — the header's own term is
      // dispatched generically below; the body's terminal br back to the
      // header closes the loop, br to the exit breaks out
      my_exit = b.loop_exit;
      my_header = b;
      push_label_n(c, 0, my_exit); // block $exit
      push_label_n(c, 1, my_header); // loop $h
      b8(c.body, 0x02); // block
      b8(c.body, 0x40);
      b8(c.body, 0x03); // loop
      b8(c.body, 0x40);
      started_loop = true;
    }
    b.emitted = true;
    let mut k: usize = 0;
    while k < len(b.ins) {
      emit_ins(c, b.ins[k]);
      k += 1;
    }
    if b.term_op == 0 {
      if started_loop {
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
      }
      return null;
    }
    if b.term_op == 100 {
      let t: *IRBlock = b.br_true;
      // forward entry into a not-yet-emitted loop becomes the construct.
      // If this frame already owns an open loop, the new loop is NESTED
      // inside our body: recurse so a child frame owns its labels — the
      // old flatten-in-place walk overwrote my_header/my_exit, so when the
      // nested loops closed, a back edge to OUR header hit the generic
      // br path and returned with `block $exit { loop $h {` never closed
      // (and the exit block never emitted).
      if t.loop_header && !t.emitted {
        if started_loop {
          let stop: *IRBlock = emit_region(c, t, b);
          from = b;
          b = stop;
          continue;
        }
        from = b;
        b = t;
        continue;
      }
      if t == my_header && started_loop {
        // back edge: repeat the loop
        wasm_br(c, b, t);
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
        if my_exit == null {
          return null;
        }
        from = b;
        b = my_exit;
        started_loop = false;
        my_header = null;
        my_exit = null;
        continue;
      }
      if inlineable(c, t) {
        from = b;
        b = t;
        continue;
      }
      wasm_br(c, b, t);
      if started_loop && t == my_exit {
        // break: leave the loop, the exit's code follows in the caller
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
        return t;
      }
      return t;
    }
    if b.term_op == 102 {
      // restore the shadow stack to the caller's base ($fb + frame), then
      // return (value stays on the stack)
      b8(c.body, 0x20);
      buleb(c.body, fb_local(c) as u64);
      i32c(c, c.frame);
      b8(c.body, 0x6A); // i32.add — $fb + frame = caller's base
      b8(c.body, 0x24); // global.set 0 ($sp)
      buleb(c.body, 0);
      if b.ret_val != null {
        lget(c, b.ret_val);
      } else if c.fn_.ret != null && c.fn_.ret.kind != TypeKind.TyVoid &&
                !c.fn_.returns_aggregate {
        // an unreachable exit can lower as a valueless ret; wasm needs the
        // operand — supply the zero of the fn's return type
        let rt: IRType = ir_type_of(c.fn_.ret);
        if rt == IRType.ItF32 || rt == IRType.ItF64 {
          if rt == IRType.ItF32 {
            b8(c.body, 0x43);
          } else {
            b8(c.body, 0x44);
          }
          let mut z: i32 = 0;
          let zb: i32 = if rt == IRType.ItF32 { 4 } else { 8 };
          while z < zb {
            b8(c.body, 0);
            z += 1;
          }
        } else {
          if w_is64(rt) {
            b8(c.body, 0x42);
          } else {
            b8(c.body, 0x41);
          }
          b8(c.body, 0x00);
        }
      }
      b8(c.body, 0x0F); // return
      if started_loop {
        b8(c.body, 0x0B); // end loop (lexically required)
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
      }
      return null;
    }
    // cbr: if { then } else { else }; both arms land on the join via br,
    // whose label/code lives with the first diamond that claimed it.
    let t2: *IRBlock = b.br_true;
    let f2: *IRBlock = b.br_false;
    let mut join: *IRBlock = null;
    if b.join_hint != null {
      join = b.join_hint;
    } else {
      join = chain_terminal(c, t2);
      let join2: *IRBlock = chain_terminal(c, f2);
      if join != join2 {
        // the true join is the deeper terminal the other side reaches
        if join != null && join2 != null && reaches(c, join, join2, 0) {
          join = join2;
        } else {
          if join == null {
            join = join2;
          }
        }
      }
    }
    let mut claimed: bool = false;
    if join != null && !has_target(c, join) && !join.emitted {
      c.claims = push_claim(c.claims, new WClaim { b: join, base: len(c.labels) as i32 });
      claimed = true;
    }
    push_label_n(c, 2, null); // the anonymous if occupies a br depth
    lget(c, b.cbr_cond);
    b8(c.body, 0x04); // if
    b8(c.body, 0x40); // void blocktype
    emit_region_run(c, t2, b);
    b8(c.body, 0x05); // else
    emit_region_run(c, f2, b);
    b8(c.body, 0x0B); // end if
    pop_label(c);     // drop the if placeholder
    if join == null {
      if started_loop {
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
      }
      return null; // both arms returned
    }
    if join.emitted {
      if claimed {
        pop_claim(c); // ours went stale the moment it was emitted
      }
      if started_loop && join == my_exit {
        // a break-if: both arms already br'd; close the loop, emit exit
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
        started_loop = false;
        my_header = null;
        my_exit = null;
        from = b;
        b = join;
        continue;
      }
      return join; // an earlier construct emitted it
    }
    if !claimed {
      if started_loop && join == my_exit {
        // break-if against this loop's exit: close and continue at exit
        b8(c.body, 0x0B); // end loop
        b8(c.body, 0x0B); // end block
        pop_label(c);
        pop_label(c);
        started_loop = false;
        my_header = null;
        my_exit = null;
        from = b;
        b = join;
        continue;
      }
      return join; // an enclosing construct owns the join and its code
    }
    pop_claim(c); // our claim: the join's code follows right here
    from = b;
    b = join;
  }
  return null;
}

// collect each vreg's IRType: one def instruction, or a block phi
fn vreg_type(fn_: *IRFn, id: i32) -> IRType {
  let mut b: usize = 0;
  while b < len(fn_.blocks) {
    let blk: *IRBlock = fn_.blocks[b];
    let mut p: usize = 0;
    while p < len(blk.phis) {
      let phi: *IRPhi = blk.phis[p];
      if phi.dst.id == id {
        return phi.dst.ty;
      }
      p += 1;
    }
    let mut k: usize = 0;
    while k < len(blk.ins) {
      let i: *IRIns = blk.ins[k];
      if i.dst != null && i.dst.id == id {
        return i.dst.ty;
      }
      k += 1;
    }
    // (no terminator handling: terminators live in term_op/br_true fields,
    // never in ins — boot's own scan skips OP_BR/CBR/RET for the same
    // reason: its pre-fix aliasing once typed an i64 vreg's local IT_I8
    // and wasmtime rejected the module)
    b += 1;
  }
  return IRType.ItI32;
}

static mut fb_ctx: *WFnCtx = 0 as *WFnCtx;

fn emit_fn_body(wf: *WFn) -> *Vec[u8] {
  let fn_: *IRFn = wf.fn_;
  let c: *WFnCtx = new WFnCtx {
    fn_: fn_, body: new Vec[u8] { items: make([]u8, 4096), n: 0 },
    slot_off: make([]i64, 0), frame: 0, hidden: 0,
    labels: make([]*WLabel, 0), claims: make([]*WClaim, 0),
  };
  fb_ctx = c;

  // frame layout first (slots), then locals for every vreg
  let mut i: usize = 0;
  while i < len(fn_.slots) {
    slot_offset(c, fn_.slots[i]);
    i += 1;
  }

  if fn_.returns_aggregate {
    c.hidden = 1;
  }
  // prologue: $sp -= frame; $fb = $sp — slots live at $fb + off inside
  // [fb, fb+frame), safely below every live caller frame
  b8(c.body, 0x23); // global.get 0 ($sp)
  buleb(c.body, 0);
  i32c(c, c.frame);
  b8(c.body, 0x6B); // i32.sub
  b8(c.body, 0x22); // local.tee $fb — set it AND keep the value for $sp
  buleb(c.body, (len(fn_.params) as i64 + c.hidden as i64) as u64);
  b8(c.body, 0x24); // global.set 0 ($sp)
  buleb(c.body, 0);
  // the hidden out pointer (agg returns): save signature local 0 (the out
  // ptr) into the frame's out slot — wasm stores take address FIRST
  if c.hidden != 0 {
    b8(c.body, 0x20); // local.get $fb
    buleb(c.body, (len(fn_.params) as i64 + c.hidden as i64) as u64);
    i32c(c, slot_offset(c, fn_.out_slot));
    b8(c.body, 0x6A); // i32.add — address = $fb + off
    b8(c.body, 0x20); // local.get 0 (out ptr) — value second
    buleb(c.body, 0);
    b8(c.body, 0x36); // i32.store
    buleb(c.body, 2);
    buleb(c.body, 0);
  }

  // incoming params: store each wasm param local into its frame slot
  i = 0;
  while i < len(fn_.params) {
    let ps: *IRSlot = fn_.params[i];
    let mut pt: *Type = null;
    if i < len(fn_.param_types) {
      pt = fn_.param_types[i];
    }
    let agg: bool = ty_travels_as_ptr(pt);
    // wasm store operand order: address first, value second
    b8(c.body, 0x20); // local.get $fb
    buleb(c.body, (len(fn_.params) as i64 + c.hidden as i64) as u64);
    i32c(c, slot_offset(c, ps));
    b8(c.body, 0x6A); // i32.add — address = $fb + off
    b8(c.body, 0x20);
    buleb(c.body, (i as i64 + c.hidden as i64) as u64); // local.get <param i>
    // the pointer/aggregate handle itself lives in the slot
    let mut it: IRType = IRType.ItPtr;
    if !agg && pt != null {
      it = ir_type_of(pt);
    }
    if it == IRType.ItF64 {
      b8(c.body, 0x39);
      buleb(c.body, 3);
    } else if it == IRType.ItF32 {
      b8(c.body, 0x38);
      buleb(c.body, 2);
    } else if w_is64(it) {
      b8(c.body, 0x37);
      buleb(c.body, 3);
    } else {
      b8(c.body, 0x36); // i32.store (also pointers)
      buleb(c.body, 2);
    }
    buleb(c.body, 0);
    i += 1;
  }

  emit_region_run(c, fn_.entry, fn_.entry);
  b8(c.body, 0x0B); // end function body
  return c.body;
}

fn emit_wasm() -> []u8 {
  let out: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 16), n: 0 };
  if g_ir_fns.n == 0 {
    return out.items;
  }

  W = new WState {
    fns: make([]*WFn, 0), types: make([]*WType, 0), type_keys: make([]string, 0),
    fn_by_symbol: new WFnMap { items: make([]*WFnEnt, 0) },
    table_idx: new I64Map { items: make([]*I64Ent, 0) },
    table_fns: make([]string, 0),
    global_addr: new I64Map { items: make([]*I64Ent, 0) },
    lit_addr: new I64Map { items: make([]*I64Ent, 0) },
    heap_base: 0, stack_top: 0, data_end: 0,
  };

  // register the import signatures FIRST: sections are serialized in
  // order, so anything w_type_for adds during import assembly would land
  // past the already-written type section
  {
    let tab: *Vec[*WasiImport] = wasi_imports();
    let mut k: usize = 0;
    while k < tab.n {
      let imp: *WasiImport = tab.items[k];
      let mut p: []i64 = make([]i64, 0);
      let mut q: usize = 0;
      while q < len(imp.params) {
        p = push_i64(p, imp.params[q] as i64);
        q += 1;
      }
      w_type_for(p, imp.has_ret, imp.ret);
      k += 1;
    }
  }

  // function table (indices 0..6 are the wasi imports)
  let mut i: usize = 0;
  while i < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[i];
    fn_.uid = i as i32;
    let wf: *WFn = new WFn {
      fn_: fn_, index: (wasi_import_n() as usize + i) as i32, type_: w_type_of_fn(fn_),
    };
    W.fns = push_wfn(W.fns, wf);
    fm_put(W.fn_by_symbol, fn_.symbol, wf);
    i += 1;
  }
  w_layout_data();

  // address-taken functions need table entries: scan every instruction
  i = 0;
  while i < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[i];
    let mut b: usize = 0;
    while b < len(fn_.blocks) {
      let blk: *IRBlock = fn_.blocks[b];
      let mut k: usize = 0;
      while k < len(blk.ins) {
        let ins: *IRIns = blk.ins[k];
        if ins.op == IROp.IrAddrc && ins.lit == -1 && ins.callee != "" &&
           ir_fn_for_symbol(ins.callee) != null {
          table_index_of(ins.callee);
        }
        k += 1;
      }
      b += 1;
    }
    i += 1;
  }

  // ---- assemble the module ----
  let typesec: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
  let importsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
  let funcsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 1024), n: 0 };
  let tablesec: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
  let memsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
  let globsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
  let exportsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 64), n: 0 };
  let elemsec: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
  let codesec: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 16), n: 0 };
  let datasec: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 12), n: 0 };

  // type section
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
    buleb(body, len(W.types) as u64);
    let mut ti: usize = 0;
    while ti < len(W.types) {
      let t: *WType = W.types[ti];
      b8(body, 0x60);
      buleb(body, len(t.params) as u64);
      let mut k2: usize = 0;
      while k2 < len(t.params) {
        b8(body, w_vt_i(t.params[k2]));
        k2 += 1;
      }
      if t.has_ret {
        buleb(body, 1);
        b8(body, w_vt_i(t.ret as i64));
      } else {
        buleb(body, 0);
      }
      ti += 1;
    }
    bsection(typesec, 1, body);
  }

  // import section: the wasi_snapshot_preview1 set
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 128), n: 0 };
    buleb(body, wasi_import_n() as u64);
    let tab: *Vec[*WasiImport] = wasi_imports();
    let mut k: usize = 0;
    while k < tab.n {
      let imp: *WasiImport = tab.items[k];
      bstr(body, "wasi_snapshot_preview1");
      bstr(body, imp.name);
      b8(body, 0x00); // func
      let mut p: []i64 = make([]i64, 0);
      let mut q: usize = 0;
      while q < len(imp.params) {
        p = push_i64(p, imp.params[q] as i64);
        q += 1;
      }
      buleb(body, w_type_for(p, imp.has_ret, imp.ret) as u64);
      k += 1;
    }
    bsection(importsec, 2, body);
  }

  // function section
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 4096), n: 0 };
    buleb(body, (len(W.fns) + 1) as u64); // + _start
    let mut fi: usize = 0;
    while fi < len(W.fns) {
      buleb(body, W.fns[fi].type_ as u64);
      fi += 1;
    }
    // _start: () -> ()
    {
      let p: []i64 = make([]i64, 0);
      buleb(body, w_type_for(p, false, IRType.ItI32) as u64);
    }
    bsection(funcsec, 3, body);
  }

  // table section: always present — rc_dec's drop-glue call_indirect needs
  // table 0 to exist even in programs that never take a function address
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
    buleb(body, 1);
    b8(body, 0x70); // funcref
    b8(body, 0x00); // min only
    let mut n: u64 = 1;
    if len(W.table_fns) > 0 {
      n = len(W.table_fns) as u64;
    }
    buleb(body, n);
    bsection(tablesec, 4, body);
  }

  // memory section
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
    let min_pages: u64 = ((W.stack_top + 0xFFFF) / 0x10000 + 1) as u64;
    buleb(body, 1);
    b8(body, 0x00);
    buleb(body, min_pages);
    bsection(memsec, 5, body);
  }

  // global section: $sp (mut i32) = stack top
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 16), n: 0 };
    buleb(body, 1);
    b8(body, 0x7F); // i32
    b8(body, 0x01); // mutable
    b8(body, 0x41); // i32.const
    bsleb(body, W.stack_top);
    b8(body, 0x0B); // end
    bsection(globsec, 6, body);
  }

  // export section: memory + _start
  let start_index: i64 = wasi_import_n() as i64 + len(W.fns) as i64;
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 64), n: 0 };
    buleb(body, 2);
    bstr(body, "memory");
    b8(body, 0x02); // memory
    buleb(body, 0);
    bstr(body, "_start");
    b8(body, 0x00); // func
    buleb(body, start_index as u64);
    bsection(exportsec, 7, body);
  }

  // element section
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 256), n: 0 };
    buleb(body, 1);
    buleb(body, 0); // table 0
    b8(body, 0x41); // i32.const 0
    bsleb(body, 0);
    b8(body, 0x0B);
    buleb(body, len(W.table_fns) as u64);
    let mut ei: usize = 0;
    while ei < len(W.table_fns) {
      let sym: string = W.table_fns[ei];
      let t: *WFn = fm_get(W.fn_by_symbol, sym);
      let mut idx: u64 = 0;
      if t != null {
        idx = t.index as u64;
      }
      buleb(body, idx);
      ei += 1;
    }
    bsection(elemsec, 9, body);
  }

  // code section: [locals decl][body] per function, size-prefixed
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 16), n: 0 };
    buleb(body, (len(W.fns) + 1) as u64);
    let mut ci: usize = 0;
    while ci < len(W.fns) {
      let wf: *WFn = W.fns[ci];
      let fn_: *IRFn = wf.fn_;
      let code: *Vec[u8] = emit_fn_body(wf);
      // locals: one group per local so indices stay params, $fb, then
      // vregs in id order. The signature carries the declared params (plus
      // the hidden out ptr FIRST for agg returns); this decl covers $fb
      // and the vregs only.
      let entry: *Vec[u8] = new Vec[u8] { items: make([]u8, 1024), n: 0 };
      buleb(entry, (1 + fn_.next_vreg) as u64);
      buleb(entry, 1);
      b8(entry, 0x7F); // $fb
      let mut v: i32 = 0;
      while v < fn_.next_vreg {
        buleb(entry, 1);
        b8(entry, w_vt(vreg_type(fn_, v)));
        v += 1;
      }
      bappend(entry, code);
      buleb(body, entry.n as u64);
      bappend(body, entry);
      ci += 1;
    }
    // _start: call main; exit status & 0xFF (POSIX truncation, so main
    // returning 1111 exits 87 exactly like a native process); proc_exit
    {
      let entry: *Vec[u8] = new Vec[u8] { items: make([]u8, 32), n: 0 };
      buleb(entry, 0); // no locals
      let mainf: *WFn = fm_get(W.fn_by_symbol, g_main_cell.items[0]);
      b8(entry, 0x10);
      let mut midx: u64 = 0;
      if mainf != null {
        midx = mainf.index as u64;
      }
      buleb(entry, midx);
      // only a scalar-returning main leaves a status on the stack; a void
      // or aggregate main contributes no value, so exit status 0
      let mut scalar_main: bool = false;
      if mainf != null && mainf.fn_.ret != null &&
         mainf.fn_.ret.kind != TypeKind.TyVoid && !mainf.fn_.returns_aggregate {
        scalar_main = true;
      }
      if scalar_main {
        b8(entry, 0x41); // i32.const 255
        b8(entry, 0xFF);
        b8(entry, 0x01);
        b8(entry, 0x71); // i32.and
      } else {
        b8(entry, 0x41); // i32.const 0
        b8(entry, 0x00);
      }
      b8(entry, 0x10);
      buleb(entry, 1); // proc_exit
      b8(entry, 0x0B); // (unreachable after proc_exit, but valid)
      buleb(body, entry.n as u64);
      bappend(body, entry);
    }
    bsection(codesec, 10, body);
  }

  // data section: statics + literals (24B immortal header + bytes)
  {
    let body: *Vec[u8] = new Vec[u8] { items: make([]u8, 1 << 12), n: 0 };
    let mut count: u64 = 0;
    let mut g: usize = 0;
    while g < g_ir_globals.n {
      let gl: *IRGlobal = g_ir_globals.items[g];
      if !gl.is_extern && len(gl.init) > 0 {
        count += 1;
      }
      g += 1;
    }
    let mut f2: usize = 0;
    while f2 < g_ir_fns.n {
      count += len(g_ir_fns.items[f2].literals) as u64;
      f2 += 1;
    }
    buleb(body, count);
    g = 0;
    while g < g_ir_globals.n {
      let gl: *IRGlobal = g_ir_globals.items[g];
      if gl.is_extern || len(gl.init) == 0 {
        g += 1;
        continue;
      }
      buleb(body, 0); // memory 0
      b8(body, 0x41);
      bsleb(body, im_get(W.global_addr, gl.symbol));
      b8(body, 0x0B);
      buleb(body, len(gl.init) as u64);
      let mut bi: usize = 0;
      while bi < len(gl.init) {
        b8(body, gl.init[bi]);
        bi += 1;
      }
      g += 1;
    }
    f2 = 0;
    while f2 < g_ir_fns.n {
      let fn_: *IRFn = g_ir_fns.items[f2];
      let mut l: usize = 0;
      while l < len(fn_.literals) {
        let lit: *IRLit = fn_.literals[l];
        buleb(body, 0);
        b8(body, 0x41);
        bsleb(body, im_get(W.lit_addr, lit.label));
        b8(body, 0x0B);
        buleb(body, (24 + len(lit.bytes)) as u64);
        // 24-byte immortal rc header: {sentinel, 0, 0}
        let mut k4: i32 = 0;
        while k4 < 24 {
          if k4 == 7 {
            b8(body, 0x80); // little-endian sentinel top byte
          } else {
            b8(body, 0);
          }
          k4 += 1;
        }
        let mut byi: usize = 0;
        while byi < len(lit.bytes) {
          b8(body, lit.bytes[byi]);
          byi += 1;
        }
        l += 1;
      }
      f2 += 1;
    }
    bsection(datasec, 11, body);
  }

  // module header + sections in order
  b8(out, 0);
  b8(out, 0x61); // 'a'
  b8(out, 0x73); // 's'
  b8(out, 0x6D); // 'm'
  b8(out, 1);
  b8(out, 0);
  b8(out, 0);
  b8(out, 0);
  bappend(out, typesec);
  bappend(out, importsec);
  bappend(out, funcsec);
  bappend(out, tablesec);
  bappend(out, memsec);
  bappend(out, globsec);
  bappend(out, exportsec);
  bappend(out, elemsec);
  bappend(out, codesec);
  bappend(out, datasec);
  return out.items[0..out.n];
}

fn push_wfn(items: []*WFn, w: *WFn) -> []*WFn {
  let out: []*WFn = make([]*WFn, len(items) + 1);
  let mut i: usize = 0;
  while i < len(items) {
    out[i] = items[i];
    i += 1;
  }
  out[len(items)] = w;
  return out;
}

// ============================ native emitters ==============================
// ports of boot emit_arm64.c / emit_amd64.c — spill-everything assembly
// text; the driver writes <out>.s and runs cc exactly like boot's main.

fn char_str(b: u8) -> string {
  let buf: []u8 = make([]u8, 1);
  buf[0] = b;
  return bytes_as_string(buf);
}

fn cat4(a: string, b: string, c: string, d: string) -> string {
  return cat3(a, cat3(b, c, ""), d);
}

fn cat5(a: string, b: string, c: string, d: string, e2: string) -> string {
  return cat3(a, cat3(b, cat3(c, d, ""), ""), e2);
}

// decimal u64 (bit patterns exceed i64 range; itoa would print them signed)
fn utoa(v: u64) -> string {
  if v == 0 {
    return "0";
  }
  let buf: []u8 = make([]u8, 24);
  let mut n: usize = 24;
  let mut x: u64 = v;
  while x > 0 {
    n -= 1;
    buf[n] = 48 + (x % 10) as u8;
    x /= 10;
  }
  return intrinsics.slice_string(buf[n..24]);
}

fn oct3(ch: u8) -> string {
  let d0: u8 = 48 + ((ch >> 6) & 7) as u8;
  let d1: u8 = 48 + ((ch >> 3) & 7) as u8;
  let d2: u8 = 48 + (ch & 7) as u8;
  return cat3(char_str(d0), cat3(char_str(d1), char_str(d2), ""), "");
}

fn bs(sb: *Vec[u8], s: string) {
  let mut i: usize = 0;
  while i < len(s) {
    b8(sb, s[i] as u8);
    i += 1;
  }
}

// ---- arm64 (Apple Silicon) ------------------------------------------------
// x12 is the dedicated address scratch; every vreg lives in a stack slot
// addressed off the frame pointer (x29).

struct ACtx {
  out: *Vec[u8],
  fn_: *IRFn,
  offs: []i64, // slot id -> negative offset from x29; vregs at slots.n + id
  frame: i64,
  is_mac: bool, // mac images prefix every symbol with `_`; ELF uses the plain name
}

// mac64 images prefix every symbol with `_` (Mach-O convention); ELF
// targets use the plain name
fn ac_sym(e: *ACtx, s: string) -> string {
  if e.is_mac {
    return cat3("_", s, "");
  }
  return s;
}

static mut g_label64: i32 = 0;

fn ac_slot_off(e: *ACtx, s: *IRSlot) -> i64 {
  if s.id < len(e.offs) as i32 {
    // 0 = not laid out yet (a real slot offset is always negative): the
    // table is pre-sized by ac_layout, so the length check alone can no
    // longer tell "cached" from "never filled"
    let cached: i64 = e.offs[s.id as usize];
    if cached != 0 {
      return cached;
    }
  }
  if s.id < 0 {
    // TEMP diagnostics: a negative slot id is dangling-IR garbage — the
    // lazy growth below cannot serve it. The DEAD stamp in the rc slot
    // would prove the block was freed and reused under a live pointer.
    let hdr: u64 = intrinsics.load_u64(s as usize as *u8);
    eprintf("{}", cat5("SLOT-GARBAGE fn=", e.fn_.symbol, " id=", itoa(s.id as i64), " "));
    eprintf("{}", cat3("rc=", cat3(itoa(hdr as i64), " align=", cat3(itoa(s.align as i64), " size=", cat3(itoa(s.size as i64), "\n", ""))), ""));
    return -8;
  }
  let mut off: i64 = e.frame;
  let al: i64 = if s.align > 8 { 8 } else { s.align };
  off = (off + al - 1) / al * al;
  off += s.size;
  e.frame = off;
  while (len(e.offs) as i32) <= s.id {
    e.offs = push_i64(e.offs, 0);
  }
  e.offs[s.id as usize] = -off;
  return -off;
}

fn ac_vreg_off(e: *ACtx, v: *IRVreg) -> i64 {
  let idx: usize = len(e.fn_.slots) + v.id as usize;
  while len(e.offs) <= idx {
    e.offs = push_i64(e.offs, 0);
  }
  return e.offs[idx];
}

fn ac_layout(e: *ACtx) {
  // pre-size the whole table: push_i64 grows by full copy per call, so the
  // lazy fill was O(n^2) — the giant functions (4K+ slots and vregs) burned
  // gigabytes of never-recycled intermediates before the fill even ran
  e.offs = make([]i64, len(e.fn_.slots) + e.fn_.next_vreg as usize);
  e.frame = 0;
  let mut i: usize = 0;
  while i < len(e.fn_.slots) {
    ac_slot_off(e, e.fn_.slots[i]);
    i += 1;
  }
  let mut v: i32 = 0;
  while v < e.fn_.next_vreg {
    e.frame += 8;
    e.offs[len(e.fn_.slots) + v as usize] = -e.frame;
    v += 1;
  }
  e.frame = (e.frame + 15) / 16 * 16 + 16;
}

// imm12 caps at 4095; big frames walk the offset in 4080-sized steps through
// x12 (x29 stays intact — the epilogue restores sp from it)
fn ac_addr_into(e: *ACtx, off: i64) {
  let mut left: i64 = if off < 0 { 0 - off } else { off };
  let op: string = ac_addop(off);
  let mut base: string = "x29";
  while left > 4095 {
    bs(e.out, cat5("  ", op, " x12, ", base, ", #4080\n"));
    base = "x12";
    left -= 4080;
  }
  bs(e.out, cat5("  ", op, " x12, ", base, cat3(", #", cat3(itoa(left), "\n", ""), "")));
}

fn ac_ld(e: *ACtx, off: i64, size: i64, flt: bool, reg: string) {
  ac_addr_into(e, off);
  if flt {
    bs(e.out, cat4("  ldr ", reg, ", [x12]\n", ""));
    return;
  }
  if size == 1 {
    bs(e.out, cat4("  ldrsb ", reg, ", [x12]\n", ""));
  } else if size == 2 {
    bs(e.out, cat4("  ldrsh ", reg, ", [x12]\n", ""));
  } else if size == 4 {
    bs(e.out, cat4("  ldrsw ", reg, ", [x12]\n", ""));
  } else {
    bs(e.out, cat4("  ldr ", reg, ", [x12]\n", ""));
  }
}

// the spill registers are a closed set (x8..x11, x0); map the x-form to the
// w-form for narrow stores
fn ac_wname(reg: string) -> string {
  if streq(reg, "x8") { return "w8"; }
  if streq(reg, "x9") { return "w9"; }
  if streq(reg, "x10") { return "w10"; }
  if streq(reg, "x11") { return "w11"; }
  if streq(reg, "x0") { return "w0"; }
  return reg;
}

fn ac_st(e: *ACtx, off: i64, size: i64, flt: bool, reg: string) {
  ac_addr_into(e, off);
  if flt {
    bs(e.out, cat4("  str ", reg, ", [x12]\n", ""));
    return;
  }
  if size == 1 {
    bs(e.out, cat4("  strb ", ac_wname(reg), ", [x12]\n", ""));
  } else if size == 2 {
    bs(e.out, cat4("  strh ", ac_wname(reg), ", [x12]\n", ""));
  } else if size == 4 {
    bs(e.out, cat4("  str ", ac_wname(reg), ", [x12]\n", ""));
  } else {
    bs(e.out, cat4("  str ", reg, ", [x12]\n", ""));
  }
}

fn ac_cmp(e: *ACtx, i: *IRIns) {
  let ao: i64 = ac_vreg_off(e, i.a);
  let bo: i64 = ac_vreg_off(e, i.b);
  let dof: i64 = ac_vreg_off(e, i.dst);
  if !i.is_float {
    let u: bool = !i.signed_ops;
    let cc: string = ac_icc(i.cc, u);
    ac_ld(e, ao, 8, false, "x8");
    ac_ld(e, bo, 8, false, "x9");
    bs(e.out, cat4("  cmp x8, x9\n  cset x8, ", cat3(cc, "\n", ""), "", ""));
    ac_addr_into(e, dof);
    // full-width store: cmp results flow through 8-byte spill moves and
    // returns, and stale high bytes would poison them
    bs(e.out, "  str x8, [x12]\n");
    return;
  }
  let s64: bool = i.size == 8;
  let areg: string = ac_dreg(s64, true);
  let breg: string = ac_dreg(s64, false);
  ac_ld(e, ao, if s64 { 8 } else { 4 }, true, areg);
  ac_ld(e, bo, if s64 { 8 } else { 4 }, true, breg);
  bs(e.out, cat5("  fcmp ", areg, ", ", breg, "\n"));
  if i.cc == IRCC.CcEq {
    // eq & !vs
    bs(e.out, "  cset x8, eq\n  cset x9, vs\n  eor x8, x8, x9\n");
  } else if i.cc == IRCC.CcNe {
    // ne | vs
    bs(e.out, "  cset x8, ne\n  cset x9, vs\n  orr x8, x8, x9\n");
  } else if i.cc == IRCC.CcLt {
    // mi is NaN-false on unordered
    bs(e.out, "  cset x8, mi\n");
  } else if i.cc == IRCC.CcLe {
    // le & !vs
    bs(e.out, "  cset x8, le\n  cset x9, vs\n  eor x8, x8, x9\n");
  } else if i.cc == IRCC.CcGt {
    // gt is NaN-false
    bs(e.out, "  cset x8, gt\n");
  } else {
    // ge is NaN-false
    bs(e.out, "  cset x8, ge\n");
  }
  ac_addr_into(e, dof);
  bs(e.out, "  strb w8, [x12]\n");
}

fn ac_divmod(e: *ACtx, i: *IRIns, is_mod: bool) {
  let ao: i64 = ac_vreg_off(e, i.a);
  let bo: i64 = ac_vreg_off(e, i.b);
  let dof: i64 = ac_vreg_off(e, i.dst);
  if i.is_float {
    let r0: string = ac_cvt_dreg(i.dst.ty == IRType.ItF32);
    let mut r1: string = "d1";
    if i.dst.ty == IRType.ItF32 {
      r1 = "s1";
    }
    let fw: i64 = if i.dst.ty == IRType.ItF32 { 4 } else { 8 };
    ac_ld(e, ao, fw, true, r0);
    ac_ld(e, bo, fw, true, r1);
    bs(e.out, cat5("  fdiv ", r0, ", ", r0, cat3(", ", r1, "\n")));
    ac_st(e, dof, fw, true, r0);
    return;
  }
  let lbl: i32 = g_label64;
  g_label64 += 1;
  ac_ld(e, bo, 8, false, "x9");
  bs(e.out, cat4("  cbnz x9, Ldz", cat3(itoa(lbl as i64), "\n", ""), "", ""));
  bs(e.out, cat4("  bl ", cat3(ac_sym(e, prelude_symbol("__panic_div")), "\n", ""), "", ""));
  bs(e.out, cat4("Ldz", cat3(itoa(lbl as i64), ":\n", ""), "", ""));
  if i.signed_ops {
    bs(e.out, cat4("  cmp x9, #-1\n  b.ne Lmin", cat3(itoa(lbl as i64), "\n", ""), "", ""));
    ac_ld(e, ao, 8, false, "x8");
    bs(e.out, cat4("  neg x8, x8\n  mov x9, #0\n  b Ldone", cat3(itoa(lbl as i64), "\n", ""), "", ""));
    bs(e.out, cat4("Lmin", cat3(itoa(lbl as i64), ":\n", ""), "", ""));
  }
  ac_ld(e, ao, 8, false, "x10");
  let mn: string = ac_divmn(i.signed_ops);
  bs(e.out, cat5("  ", mn, " x8, x10, x9\n", "", ""));
  if is_mod {
    bs(e.out, "  msub x8, x8, x9, x10\n");
  }
  bs(e.out, cat4("Ldone", cat3(itoa(lbl as i64), ":\n", ""), "", ""));
  ac_st(e, dof, 8, false, "x8");
}

fn ac_xreg(n: i32) -> string {
  if n == 0 { return "x0"; }
  if n == 1 { return "x1"; }
  if n == 2 { return "x2"; }
  if n == 3 { return "x3"; }
  if n == 4 { return "x4"; }
  if n == 5 { return "x5"; }
  if n == 6 { return "x6"; }
  return "x7";
}

fn ac_freg(n: i32) -> string {
  if n == 0 { return "d0"; }
  if n == 1 { return "d1"; }
  if n == 2 { return "d2"; }
  if n == 3 { return "d3"; }
  if n == 4 { return "d4"; }
  if n == 5 { return "d5"; }
  if n == 6 { return "d6"; }
  return "d7";
}

fn ac_sreg(n: i32) -> string {
  if n == 0 { return "s0"; }
  if n == 1 { return "s1"; }
  if n == 2 { return "s2"; }
  if n == 3 { return "s3"; }
  if n == 4 { return "s4"; }
  if n == 5 { return "s5"; }
  if n == 6 { return "s6"; }
  return "s7";
}

fn ac_call(e: *ACtx, i: *IRIns) {
  let mut ri: i32 = 0;
  let mut fi: i32 = 0;
  if i.callee_vreg != null {
    // indirect target in x17, outside the arg regs
    ac_addr_into(e, ac_vreg_off(e, i.callee_vreg));
    bs(e.out, "  ldr x17, [x12]\n");
  }
  let mut k: usize = 0;
  while k < len(i.args) {
    let a: *IRVreg = i.args[k];
    let isf: bool = a.ty == IRType.ItF32 || a.ty == IRType.ItF64;
    let off: i64 = ac_vreg_off(e, a);
    if isf && fi < 8 {
      // f32 args ride the low lane: ldr sN, never the 8-byte dN form
      ac_addr_into(e, off);
      if a.ty == IRType.ItF32 {
        bs(e.out, cat5("  ldr ", ac_sreg(fi), ", [x12]\n", "", ""));
      } else {
        bs(e.out, cat5("  ldr ", ac_freg(fi), ", [x12]\n", "", ""));
      }
      fi += 1;
    } else if !isf && ri < 8 {
      ac_addr_into(e, off);
      bs(e.out, cat5("  ldr ", ac_xreg(ri), ", [x12]\n", "", ""));
      ri += 1;
    } else {
      ac_addr_into(e, off);
      bs(e.out, cat4("  ldr x10, [x12]\n  str x10, [sp, #", cat3(itoa((ri * 8) as i64), "]\n", ""), "", ""));
    }
    k += 1;
  }
  if i.callee_vreg != null {
    bs(e.out, "  blr x17\n");
  } else {
    bs(e.out, cat4("  bl ", cat3(ac_sym(e, i.callee), "\n", ""), "", ""));
  }
  if i.dst != null {
    let f: bool = ir_is_float_t(i.dst.ty);
    if f {
      ac_st(e, ac_vreg_off(e, i.dst), if i.dst.ty == IRType.ItF32 { 4 } else { 8 }, true,
            ac_cvt_dreg(i.dst.ty == IRType.ItF32));
    } else {
      ac_st(e, ac_vreg_off(e, i.dst), 8, false, "x0");
    }
  }
}

// after a narrow-width 64-bit arith result, canonicalize the value to the
// operand's width (wrap semantics) — sign/zero-extend from the low part
fn ac_canon(e: *ACtx, dof: i64, t: IRType) {
  let w: i64 = ir_size_of(t);
  if w < 8 {
    let sgn: bool = ty_is_signed_int(t);
    if w == 4 {
      if sgn { bs(e.out, "  sxtw x8, w8\n"); } else { bs(e.out, "  mov w8, w8\n"); }
    } else if w == 2 {
      if sgn { bs(e.out, "  sxth x8, w8\n"); } else { bs(e.out, "  uxth x8, w8\n"); }
    } else {
      if sgn { bs(e.out, "  sxtb x8, w8\n"); } else { bs(e.out, "  uxtb x8, w8\n"); }
    }
  }
}

fn m_canon(e: *MCtx, dof: i64, t: IRType) {
  let w: i64 = ir_size_of(t);
  if w < 8 {
    let sgn: bool = ty_is_signed_int(t);
    if w == 4 {
      if sgn { bs(e.out, "  movslq %eax, %rax\n"); } else { bs(e.out, "  movl %eax, %eax\n"); }
    } else if w == 2 {
      if sgn { bs(e.out, "  movswq %ax, %rax\n"); } else { bs(e.out, "  movzwq %ax, %rax\n"); }
    } else {
      if sgn { bs(e.out, "  movsbq %al, %rax\n"); } else { bs(e.out, "  movzbq %al, %rax\n"); }
    }
  }
}

fn ac_ins(e: *ACtx, i: *IRIns) {
  if i.op == IROp.IrMemsize || i.op == IROp.IrMemgrow {
    eprintf("{}", "rho: mem_size/mem_grow are wasm-only intrinsics\n");
    __exit(70);
  }
  if i.op == IROp.IrConst {
    let dof: i64 = ac_vreg_off(e, i.dst);
    let v: u64 = i.imm as u64;
    if v <= 65535 {
      bs(e.out, cat4("  mov x8, #", cat3(utoa(v), "\n", ""), "", ""));
    } else {
      bs(e.out, cat4("  movz x8, #", cat3(utoa(v & 65535), "\n", ""), "", ""));
      bs(e.out, cat4("  movk x8, #", cat3(utoa((v >> 16) & 65535), ", lsl 16\n", ""), "", ""));
      bs(e.out, cat4("  movk x8, #", cat3(utoa((v >> 32) & 65535), ", lsl 32\n", ""), "", ""));
      bs(e.out, cat4("  movk x8, #", cat3(utoa((v >> 48) & 65535), ", lsl 48\n", ""), "", ""));
    }
    ac_st(e, dof, 8, false, "x8");
    return;
  }
  if i.op == IROp.IrFconst {
    // materialize the IEEE-754 bit pattern, then move into the float reg;
    // f32 constants carry the FLOAT pattern (the double's low half is not
    // the f32 encoding — 0.5 would become +0.0)
    let dof: i64 = ac_vreg_off(e, i.dst);
    if i.dst.ty == IRType.ItF32 {
      let bits32: u32 = intrinsics.f32_bits(i.fimm as f32);
      bs(e.out, cat4("  movz w8, #", cat3(utoa((bits32 & 65535) as u64), "\n", ""), "", ""));
      bs(e.out, cat4("  movk w8, #", cat3(utoa(((bits32 >> 16) & 65535) as u64), ", lsl 16\n", ""), "", ""));
      bs(e.out, "  fmov s0, w8\n");
      ac_st(e, dof, 4, true, "s0");
    } else {
      let bits: u64 = intrinsics.f64_bits(i.fimm);
      bs(e.out, cat4("  movz x8, #", cat3(utoa(bits & 65535), "\n", ""), "", ""));
      bs(e.out, cat4("  movk x8, #", cat3(utoa((bits >> 16) & 65535), ", lsl 16\n", ""), "", ""));
      bs(e.out, cat4("  movk x8, #", cat3(utoa((bits >> 32) & 65535), ", lsl 32\n", ""), "", ""));
      bs(e.out, cat4("  movk x8, #", cat3(utoa((bits >> 48) & 65535), ", lsl 48\n", ""), "", ""));
      bs(e.out, "  fmov d0, x8\n");
      ac_st(e, dof, 8, true, "d0");
    }
    return;
  }
  if i.op == IROp.IrAdd || i.op == IROp.IrSub || i.op == IROp.IrMul ||
     i.op == IROp.IrAnd || i.op == IROp.IrOr || i.op == IROp.IrXor {
    let dof: i64 = ac_vreg_off(e, i.dst);
    if i.is_float {
      // f32 arithmetic rides the s registers (low lane); touching d0 here
      // smears the spill slot's high half into the value
      let mn: string = ac_fmn(i.op);
      let r0: string = ac_cvt_dreg(i.dst.ty == IRType.ItF32);
      let mut r1: string = "d1";
    if i.dst.ty == IRType.ItF32 {
      r1 = "s1";
    }
      let fw: i64 = if i.dst.ty == IRType.ItF32 { 4 } else { 8 };
      ac_ld(e, ac_vreg_off(e, i.a), fw, true, r0);
      ac_ld(e, ac_vreg_off(e, i.b), fw, true, r1);
      bs(e.out, cat5("  ", mn, " ", r0, cat3(", ", r0, cat3(", ", r1, "\n"))));
      ac_st(e, dof, fw, true, r0);
      return;
    }
    let mn: string = ac_imn(i.op);
    ac_ld(e, ac_vreg_off(e, i.a), 8, false, "x8");
    ac_ld(e, ac_vreg_off(e, i.b), 8, false, "x9");
    bs(e.out, cat4("  ", cat3(mn, " x8, x8, x9\n", ""), "", ""));
    ac_canon(e, dof, i.a.ty);
    ac_st(e, dof, 8, false, "x8");
    return;
  }
  if i.op == IROp.IrDiv || i.op == IROp.IrMod {
    ac_divmod(e, i, i.op == IROp.IrMod);
    return;
  }
  if i.op == IROp.IrShl || i.op == IROp.IrShr {
    let dof: i64 = ac_vreg_off(e, i.dst);
    ac_ld(e, ac_vreg_off(e, i.a), 8, false, "x8");
    ac_ld(e, ac_vreg_off(e, i.b), 8, false, "x9");
    let mn: string = ac_shmn(i.op, i.signed_ops);
    bs(e.out, cat4("  ", cat3(mn, " x8, x8, x9\n", ""), "", ""));
    if i.op == IROp.IrShl {
      ac_canon(e, dof, i.a.ty);
    }
    ac_st(e, dof, 8, false, "x8");
    return;
  }
  if i.op == IROp.IrCmp {
    ac_cmp(e, i);
    return;
  }
  if i.op == IROp.IrLoad {
    let dof: i64 = ac_vreg_off(e, i.dst);
    ac_ld(e, ac_vreg_off(e, i.addr), 8, false, "x8");
    if i.is_float {
      let fr: string = ac_fld(i.size);
      bs(e.out, cat4("  ldr ", cat3(fr, ", [x8]\n", ""), "", ""));
      ac_st(e, dof, i.size, true, fr);
    } else {
      let op: string = ac_ldop(i.size, ty_is_signed_int(i.dst.ty));
      bs(e.out, cat4("  ", cat3(op, "\n", ""), "", ""));
      ac_st(e, dof, 8, false, "x8");
    }
    return;
  }
  if i.op == IROp.IrStore {
    ac_ld(e, ac_vreg_off(e, i.addr), 8, false, "x8");
    if i.is_float {
      let fr: string = ac_fld(i.size);
      ac_ld(e, ac_vreg_off(e, i.a), i.size, true, fr);
      bs(e.out, cat4("  str ", cat3(fr, ", [x8]\n", ""), "", ""));
    } else {
      ac_ld(e, ac_vreg_off(e, i.a), i.size, false, "x9");
      if i.size == 1 {
        bs(e.out, "  strb w9, [x8]\n");
      } else if i.size == 2 {
        bs(e.out, "  strh w9, [x8]\n");
      } else if i.size == 4 {
        bs(e.out, "  str w9, [x8]\n");
      } else {
        bs(e.out, "  str x9, [x8]\n");
      }
    }
    return;
  }
  if i.op == IROp.IrAddrc {
    let dof: i64 = ac_vreg_off(e, i.dst);
    if i.lit == -1 {
      let gs: string = ac_sym(e, i.callee);
      bs(e.out, cat5("  adrp x8, ", gs, "@PAGE\n  add x8, x8, ", cat3(gs, "@PAGEOFF\n", ""), ""));
    } else {
      ac_addr_into(e, ac_slot_off(e, i.slot));
      bs(e.out, "  mov x8, x12\n");
    }
    ac_st(e, dof, 8, false, "x8");
    return;
  }
  if i.op == IROp.IrAddi {
    let dof: i64 = ac_vreg_off(e, i.dst);
    ac_ld(e, ac_vreg_off(e, i.a), 8, false, "x8");
    bs(e.out, cat4("  add x8, x8, #", cat3(itoa(i.imm), "\n", ""), "", ""));
    ac_st(e, dof, 8, false, "x8");
    return;
  }
  if i.op == IROp.IrCast {
    let sof: i64 = ac_vreg_off(e, i.a);
    let dof: i64 = ac_vreg_off(e, i.dst);
    if i.cast == IRCastKind.CastTrunc {
      // store full width: spill-slot readers reload 8 bytes
      ac_ld(e, sof, ir_size_of(i.cast_from), false, "x8");
      ac_st(e, dof, 8, false, "x8");
    } else if i.cast == IRCastKind.CastSext {
      ac_ld(e, sof, ir_size_of(i.cast_from), false, "x8");
      ac_st(e, dof, 8, false, "x8");
    } else if i.cast == IRCastKind.CastZext {
      // zero-extend from the source width: the w-form loads zero their
      // upper half; uxtw then lifts to 64 (a no-op after ldr w8)
      ac_addr_into(e, sof);
      if ir_size_of(i.cast_from) == 1 {
        bs(e.out, "  ldrb w8, [x12]\n");
      } else if ir_size_of(i.cast_from) == 2 {
        bs(e.out, "  ldrh w8, [x12]\n");
      } else {
        bs(e.out, "  ldr w8, [x12]\n");
      }
      bs(e.out, "  uxtw x8, w8\n");
      ac_st(e, dof, 8, false, "x8");
    } else if i.cast == IRCastKind.CastI2f {
      // narrow ints load sign/zero-extended per their own type, then
      // convert; unsigned 64-bit needs ucvtf (scvtf reads it as i64)
      let fw: i64 = ir_size_of(i.cast_from);
      let sgn: bool = ty_is_signed_int(i.cast_from);
      ac_addr_into(e, sof);
      if fw == 1 {
        if sgn { bs(e.out, "  ldrsb x8, [x12]\n"); } else { bs(e.out, "  ldrb w8, [x12]\n"); }
      } else if fw == 2 {
        if sgn { bs(e.out, "  ldrsh x8, [x12]\n"); } else { bs(e.out, "  ldrh w8, [x12]\n"); }
      } else if fw == 4 {
        if sgn { bs(e.out, "  ldrsw x8, [x12]\n"); } else { bs(e.out, "  ldr w8, [x12]\n"); }
      } else {
        bs(e.out, "  ldr x8, [x12]\n");
      }
      if fw == 1 || fw == 2 {
        bs(e.out, "  uxtw x8, w8\n");
      }
      let dst: string = ac_cvt_dreg(i.cast_to == IRType.ItF32);
      if sgn {
        bs(e.out, cat4("  scvtf ", cat3(dst, ", x8\n", ""), "", ""));
      } else {
        bs(e.out, cat4("  ucvtf ", cat3(dst, ", x8\n", ""), "", ""));
      }
      ac_st(e, dof, if i.cast_to == IRType.ItF32 { 4 } else { 8 }, true, dst);
    } else if i.cast == IRCastKind.CastF2i {
      // fcvtzs saturates (spec: out-of-range float→int saturates)
      let src: string = ac_cvt_dreg(i.cast_from == IRType.ItF32);
      let sw: i64 = if i.cast_from == IRType.ItF32 { 4 } else { 8 };
      ac_ld(e, sof, sw, true, src);
      if i.cast_to == IRType.ItI64 || i.cast_to == IRType.ItU64 {
        bs(e.out, cat4("  fcvtzs x8, ", cat3(src, "\n", ""), "", ""));
      } else {
        bs(e.out, cat4("  fcvtzs w8, ", cat3(src, "\n", ""), "", ""));
      }
      ac_st(e, dof, 8, false, "x8");
    } else if i.cast == IRCastKind.CastF32F64 {
      ac_ld(e, sof, 4, true, "s0");
      bs(e.out, "  fcvt d0, s0\n");
      ac_st(e, dof, 8, true, "d0");
    } else if i.cast == IRCastKind.CastF64F32 {
      ac_ld(e, sof, 8, true, "d0");
      bs(e.out, "  fcvt s0, d0\n");
      ac_st(e, dof, 4, true, "s0");
    } else if i.cast == IRCastKind.CastReinterp {
      // fmov gpr, fpr — exact bit move (f32_bits/f64_bits)
      if i.cast_from == IRType.ItF32 {
        ac_ld(e, sof, 4, true, "s0");
        bs(e.out, "  fmov w8, s0\n");
      } else {
        ac_ld(e, sof, 8, true, "d0");
        bs(e.out, "  fmov x8, d0\n");
      }
      ac_st(e, dof, if i.cast_from == IRType.ItF32 { 4 } else { 8 }, false, "x8");
    } else {
      // CastBitcopy
      ac_ld(e, sof, 8, false, "x8");
      ac_st(e, dof, 8, false, "x8");
    }
    return;
  }
  if i.op == IROp.IrCopymem {
    ac_ld(e, ac_vreg_off(e, i.addr), 8, false, "x8");
    ac_ld(e, ac_vreg_off(e, i.a), 8, false, "x9");
    if i.size < 0 {
      // runtime byte count
      ac_ld(e, ac_vreg_off(e, i.b), 8, false, "x10");
    } else {
      bs(e.out, cat4("  mov x10, #", cat3(itoa(i.size), "\n", ""), "", ""));
    }
    let lbl: i32 = g_label64;
    g_label64 += 1;
    // count==0 must not enter the loop: subs-first would wrap to -1 and
    // copy for 2^64 iterations (empty slice_string is the everyday case)
    bs(e.out, cat4("  cbz x10, Lcpyd", cat3(itoa(lbl as i64), "\n", ""), "", ""));
    bs(e.out, cat4("Lcpy", cat3(itoa(lbl as i64),
        ":\n  ldrb w11, [x9]\n  strb w11, [x8]\n  add x8, x8, #1\n  add x9, x9, #1\n  subs x10, x10, #1\n  b.ne Lcpy",
        cat3(itoa(lbl as i64), "\n", "")), "", ""));
    bs(e.out, cat4("Lcpyd", cat3(itoa(lbl as i64), ":\n", ""), "", ""));
    return;
  }
  if i.op == IROp.IrZero {
    ac_ld(e, ac_vreg_off(e, i.addr), 8, false, "x8");
    bs(e.out, cat4("  mov x10, #", cat3(itoa(i.size), "\n  mov w11, #0\n", ""), "", ""));
    let lbl: i32 = g_label64;
    g_label64 += 1;
    bs(e.out, cat4("Lzro", cat3(itoa(lbl as i64),
        ":\n  strb w11, [x8]\n  add x8, x8, #1\n  subs x10, x10, #1\n  b.ne Lzro",
        cat3(itoa(lbl as i64), "\n", "")), "", ""));
    return;
  }
  if i.op == IROp.IrLitaddr {
    let dof: i64 = ac_vreg_off(e, i.dst);
    let l: *IRLit = e.fn_.literals[i.lit as usize];
    bs(e.out, cat4("  adrp x8, L", l.label, "@PAGE\n  add x8, x8, L", cat3(l.label, "@PAGEOFF\n", "")));
    ac_st(e, dof, 8, false, "x8");
    return;
  }
  if i.op == IROp.IrCall {
    ac_call(e, i);
    return;
  }
}

fn ac_edge(e: *ACtx, succ: *IRBlock) {
  let mut p: usize = 0;
  while p < len(succ.phis) {
    let phi: *IRPhi = succ.phis[p];
    let mut k: usize = 0;
    while k < len(phi.preds) {
      if phi.preds[k] == e.fn_.cur {
        let val: *IRVreg = phi.args[k];
        if val != null && phi.dst != null {
          let d: i64 = ac_vreg_off(e, phi.dst);
          let s: i64 = ac_vreg_off(e, val);
          ac_ld(e, s, 8, false, "x8");
          ac_st(e, d, 8, false, "x8");
        }
        k = len(phi.preds);
      }
      k += 1;
    }
    p += 1;
  }
}

fn ac_term(e: *ACtx) {
  let fn_: *IRFn = e.fn_;
  if fn_.cur.term_op == 100 {
    let to: *IRBlock = fn_.cur.br_true;
    ac_edge(e, to);
    bs(e.out, cat5("  b L", itoa(fn_.uid as i64), "_", itoa(to.id as i64), "\n"));
  } else if fn_.cur.term_op == 101 {
    let tt: *IRBlock = fn_.cur.br_true;
    let ff: *IRBlock = fn_.cur.br_false;
    let cof: i64 = ac_vreg_off(e, fn_.cur.cbr_cond);
    let lbl: i32 = g_label64;
    g_label64 += 1;
    ac_ld(e, cof, 1, false, "x8");
    bs(e.out, cat4("  cbz x8, Lcbf", cat3(itoa(lbl as i64), "\n", ""), "", ""));
    // phi edge copies match preds against cur, which must stay the
    // branching block for both arms (mirrors emit_amd64)
    ac_edge(e, tt);
    bs(e.out, cat5("  b L", itoa(fn_.uid as i64), "_", itoa(tt.id as i64), "\n"));
    bs(e.out, cat4("Lcbf", cat3(itoa(lbl as i64), ":\n", ""), "", ""));
    ac_edge(e, ff);
    bs(e.out, cat5("  b L", itoa(fn_.uid as i64), "_", itoa(ff.id as i64), "\n"));
  } else if fn_.cur.term_op == 102 {
    if fn_.cur.ret_val != null {
      let f: bool = ir_is_float_t(fn_.cur.ret_val.ty);
      if f {
        // f32 returns ride the low lane at 4 bytes
        let fr: string = ac_cvt_dreg(fn_.cur.ret_val.ty == IRType.ItF32);
        ac_ld(e, ac_vreg_off(e, fn_.cur.ret_val),
              if fn_.cur.ret_val.ty == IRType.ItF32 { 4 } else { 8 }, true, fr);
      } else {
        ac_ld(e, ac_vreg_off(e, fn_.cur.ret_val), 8, false, "x0");
      }
    }
    bs(e.out, "  mov sp, x29\n  ldp x29, x30, [sp], #16\n  ret\n");
  } else {
    bs(e.out, "  mov sp, x29\n  ldp x29, x30, [sp], #16\n  ret\n");
  }
}

static mut g_uid64: i32 = 0;

fn ac_fn(e: *ACtx, fn_: *IRFn) {
  e.fn_ = fn_;
  fn_.uid = g_uid64;
  g_uid64 += 1;
  eprintf("{}", cat3("AFN ", fn_.symbol, "\n"));
  ac_layout(e);
  let fs: string = ac_sym(e, fn_.symbol);
  bs(e.out, cat5("\n  .globl ", fs, "\n", fs, ":\n"));
  bs(e.out, "  stp x29, x30, [sp, #-16]!\n  mov x29, sp\n");
  if e.frame != 0 {
    // the sub sp immediate is 12 bits; the epilogue restores sp from x29,
    // so big frames just reserve in chunks
    let mut left: i64 = e.frame;
    while left > 0 {
      let chunk: i64 = if left > 4080 { 4080 } else { left };
      bs(e.out, cat4("  sub sp, sp, #", cat3(itoa(chunk), "\n", ""), "", ""));
      left -= chunk;
    }
  }
  let mut ri: i32 = 0;
  let mut fi: i32 = 0;
  if fn_.returns_aggregate {
    ri += 1;
    ac_addr_into(e, ac_slot_off(e, fn_.out_slot));
    bs(e.out, "  str x0, [x12]\n");
  }
  let mut p: usize = 0;
  while p < len(fn_.params) {
    let slot: *IRSlot = fn_.params[p];
    let mut pt: *Type = null;
    if p < len(fn_.param_types) {
      pt = fn_.param_types[p];
    }
    let isf: bool = pt != null && (pt.kind == TypeKind.TyF32 || pt.kind == TypeKind.TyF64);
    if isf && fi < 8 {
      ac_addr_into(e, ac_slot_off(e, slot));
      // f32 params arrive in the s registers (low lane)
      if pt.kind == TypeKind.TyF32 {
        bs(e.out, cat4("  str ", cat3(ac_sreg(fi), ", [x12]\n", ""), "", ""));
      } else {
        bs(e.out, cat4("  str ", cat3(ac_freg(fi), ", [x12]\n", ""), "", ""));
      }
      fi += 1;
    } else if !isf && ri < 8 {
      ac_addr_into(e, ac_slot_off(e, slot));
      bs(e.out, cat4("  str ", cat3(ac_xreg(ri), ", [x12]\n", ""), "", ""));
      ri += 1;
    }
    p += 1;
  }
  let mut bi: usize = 0;
  while bi < len(fn_.blocks) {
    let b: *IRBlock = fn_.blocks[bi];
    e.fn_.cur = b;
    bs(e.out, cat5("L", itoa(fn_.uid as i64), "_", itoa(b.id as i64), ":\n"));
    let mut ii: usize = 0;
    while ii < len(b.ins) {
      ac_ins(e, b.ins[ii]);
      ii += 1;
    }
    ac_term(e);
    bi += 1;
  }
}

fn emit_arm64_text(target: i32) -> []u8 {
  let out: *Vec[u8] = new Vec[u8] { items: make([]u8, 1024), n: 0 };
  let is_mac: bool = target == 2;
  let e: *ACtx = new ACtx { out: out, fn_: null, offs: make([]i64, 0), frame: 0, is_mac: is_mac };
  // mach-o carves the image into typed sections; ELF targets use the three
  // plain names the in-tree arm64 assembler maps (strings fold into text)
  if is_mac {
    bs(out, ".section __TEXT,__text,regular,pure_instructions\n");
    bs(out, ".build_version macos, 13, 0\n");
  } else {
    bs(out, ".text\n");
  }
  let mut i: usize = 0;
  while i < g_ir_fns.n {
    if i % 25 == 0 {
      let p1: string = cat5("E@fn", itoa(i as i64), " heap=", itoa(__heap_ptr() as i64), " free=");
      eprintf("{}", cat3(p1, itoa(__alloc_dbg() as i64), "\n"));
    }
    ac_fn(e, g_ir_fns.items[i]);
    i += 1;
  }
  // rc-headed literals must live in a non-merging section: ld64 folds and
  // reorders __cstring literals, which would break the buf/+24 pairing
  if is_mac {
    bs(out, ".section __TEXT,__rhostr,regular\n");
  } else {
    bs(out, ".section .rodata\n");
  }
  i = 0;
  while i < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[i];
    let mut j: usize = 0;
    while j < len(fn_.literals) {
      let l: *IRLit = fn_.literals[j];
      bs(out, cat5("  .p2align 3\nL", l.label, ":\n  .quad 0x8000000000000000\n  .quad 0\n  .quad 0\nL", l.label, "_b:\n  .ascii \""));
      let mut k: usize = 0;
      while k < len(l.bytes) {
        let ch: u8 = l.bytes[k];
        if ch >= 0x20 && ch < 0x7F && ch != 34 && ch != 92 {
          b8(out, ch);
        } else {
          bs(out, cat3("\\", oct3(ch), ""));
        }
        k += 1;
      }
      bs(out, "\"\n");
      j += 1;
    }
    i += 1;
  }
  // static string initializers: their rodata blocks belong to the global,
  // not to any fn — without this the L<sym>_str relocs dangle (fixup 6)
  i = 0;
  while i < g_ir_globals.n {
    let g: *IRGlobal = g_ir_globals.items[i];
    if g.static_lit != null {
      let l: *IRLit = g.static_lit;
      bs(out, cat5("  .p2align 3\nL", l.label, ":\n  .quad 0x8000000000000000\n  .quad 0\n  .quad 0\nL", l.label, "_b:\n  .ascii \""));
      let mut k: usize = 0;
      while k < len(l.bytes) {
        let ch: u8 = l.bytes[k];
        if ch >= 0x20 && ch < 0x7F && ch != 34 && ch != 92 {
          b8(out, ch);
        } else {
          bs(out, cat3("\\", oct3(ch), ""));
        }
        k += 1;
      }
      bs(out, "\"\n");
    }
    i += 1;
  }
  i = 0;
  while i < g_ir_globals.n {
    let g: *IRGlobal = g_ir_globals.items[i];
    let gs: string = ac_sym(e, g.symbol);
    bs(out, cat5("\n  .globl ", gs, "\n", "", ""));
    if is_mac {
      bs(out, ".section __DATA,__data\n");
    } else {
      bs(out, ".section .data\n");
    }
    bs(out, cat5("  .p2align ", itoa(glob_p2align(g.align)), "\n", "", ""));
    bs(out, cat5(gs, ":\n", "", "", ""));
    emit_glob_data(out, g, "L");
    i += 1;
  }
  if g_main_cell != null && g_main_cell.items[0] != "" {
    if is_mac {
      bs(out, ".section __TEXT,__text,regular,pure_instructions\n");
    } else {
      bs(out, ".text\n");
    }
    // the string pool may end mid-word: every arm64 instruction boundary
    // (and the labels branches target) needs 4-byte alignment
    bs(out, cat5("\n  .p2align 2\n  .globl ", ac_sym(e, "main"), "\n", ac_sym(e, "main"), ":\n"));
    bs(out, "  stp x29, x30, [sp, #-16]!\n  mov x29, sp\n");
    bs(out, cat4("  bl ", cat3(ac_sym(e, g_main_cell.items[0]), "\n", ""), "", ""));
    bs(out, "  ldp x29, x30, [sp], #16\n  ret\n");
  }
  return out.items[0..out.n];
}

fn glob_p2align(align: i64) -> i64 {
  if align >= 8 { return 3; }
  if align >= 4 { return 2; }
  if align >= 2 { return 1; }
  return 0;
}

// globals init data: three relocated words (string literals) or raw bytes;
// lab_prefix is "L" (mach-o) or "." (elf)
fn emit_glob_data(out: *Vec[u8], g: *IRGlobal, lab_prefix: string) {
  let mut word: usize = 0;
  if len(g.relocs) > 0 {
    let mut w: i32 = 0;
    while w < 3 {
      let wi: usize = w as usize;
      if wi < len(g.relocs) && g.relocs[wi] != "" {
        bs(out, cat4("  .quad ", lab_prefix, g.relocs[wi], "\n"));
      } else {
        let mut v: u64 = 0;
        let mut b: i32 = 0;
        while b < 8 {
          v = v | ((g.init[word * 8 + b as usize] as u64) << (8 * b));
          b += 1;
        }
        bs(out, cat4("  .quad ", utoa(v), "\n", ""));
      }
      word += 1;
      w += 1;
    }
  } else if len(g.init) > 0 {
    let mut b: usize = 0;
    while b < len(g.init) {
      bs(out, cat4("  .byte ", cat3(itoa(g.init[b] as i64), "\n", ""), "", ""));
      b += 1;
    }
    if g.size as usize > len(g.init) {
      bs(out, cat4("  .zero ", cat3(itoa(g.size - len(g.init) as i64), "\n", ""), "", ""));
    }
  } else {
    bs(out, cat4("  .zero ", cat3(itoa(g.size), "\n", ""), "", ""));
  }
}

// ---- amd64 System V --------------------------------------------------------
// spill-everything: every vreg owns a frame slot, instructions reload
// operands into scratch registers.

struct MCtx {
  out: *Vec[u8],
  fn_: *IRFn,
  offs: []i64, // slot id -> negative offset from rbp; vregs at slots.n + id
  frame: i64,
  is_mac: bool,
}

static mut g_label_amd: i32 = 0;

fn m_sym(e: *MCtx, s: string) -> string {
  if e.is_mac {
    return cat3("_", s, "");
  }
  return s;
}

fn m_lit(e: *MCtx, l: string) -> string {
  if e.is_mac {
    return cat3("L", l, "");
  }
  return cat3(".", l, "");
}

fn m_slot_off(e: *MCtx, s: *IRSlot) -> i64 {
  if s.id < len(e.offs) as i32 {
    // 0 = not laid out yet (see ac_slot_off)
    let cached: i64 = e.offs[s.id as usize];
    if cached != 0 {
      return cached;
    }
  }
  let mut off: i64 = e.frame;
  let al: i64 = if s.align > 8 { 8 } else { s.align };
  off = (off + al - 1) / al * al;
  off += s.size;
  e.frame = off;
  while (len(e.offs) as i32) <= s.id {
    e.offs = push_i64(e.offs, 0);
  }
  e.offs[s.id as usize] = -off;
  return -off;
}

fn m_layout(e: *MCtx) {
  // pre-size: see ac_layout (the lazy push_i64 fill was O(n^2))
  e.offs = make([]i64, len(e.fn_.slots) + e.fn_.next_vreg as usize);
  e.frame = 0;
  let mut i: usize = 0;
  while i < len(e.fn_.slots) {
    m_slot_off(e, e.fn_.slots[i]);
    i += 1;
  }
  let mut v: i32 = 0;
  while v < e.fn_.next_vreg {
    e.frame += 8;
    e.offs[len(e.fn_.slots) + v as usize] = -e.frame;
    v += 1;
  }
  e.frame = (e.frame + 15) / 16 * 16 + 16;
}

fn m_vreg_off(e: *MCtx, v: *IRVreg) -> i64 {
  let idx: usize = len(e.fn_.slots) + v.id as usize;
  while len(e.offs) <= idx {
    e.offs = push_i64(e.offs, 0);
  }
  return e.offs[idx];
}

// load from slot into reg; a float picks its width (movsd/movss) — an
// 8-byte move on an f32 slot smears the neighboring bytes into the value
fn m_ld(e: *MCtx, off: i64, size: i64, flt: bool, reg: string) {
  if flt {
    if size == 4 {
      bs(e.out, cat5("  movss ", itoa(off), "(%rbp), ", reg, "\n"));
    } else {
      bs(e.out, cat5("  movsd ", itoa(off), "(%rbp), ", reg, "\n"));
    }
  } else if size == 1 {
    bs(e.out, cat5("  movsbq ", itoa(off), "(%rbp), ", reg, "\n"));
  } else if size == 2 {
    bs(e.out, cat5("  movswq ", itoa(off), "(%rbp), ", reg, "\n"));
  } else if size == 4 {
    bs(e.out, cat5("  movslq ", itoa(off), "(%rbp), ", reg, "\n"));
  } else {
    bs(e.out, cat5("  movq ", itoa(off), "(%rbp), ", reg, "\n"));
  }
}

// store reg into slot
fn m_st(e: *MCtx, off: i64, size: i64, flt: bool, reg: string) {
  if flt {
    if size == 4 {
      bs(e.out, cat5("  movss ", reg, ", ", itoa(off), "(%rbp)\n"));
    } else {
      bs(e.out, cat5("  movsd ", reg, ", ", itoa(off), "(%rbp)\n"));
    }
  } else if size == 1 {
    bs(e.out, cat5("  movb ", reg, ", ", itoa(off), "(%rbp)\n"));
  } else if size == 2 {
    bs(e.out, cat5("  movw ", reg, ", ", itoa(off), "(%rbp)\n"));
  } else if size == 4 {
    bs(e.out, cat5("  movl ", reg, ", ", itoa(off), "(%rbp)\n"));
  } else {
    bs(e.out, cat5("  movq ", reg, ", ", itoa(off), "(%rbp)\n"));
  }
}

fn m_cc(cc: IRCC, is_float: bool, is_unsigned: bool) -> string {
  if is_float {
    if cc == IRCC.CcEq { return "eq"; }
    if cc == IRCC.CcNe { return "ne"; }
    if cc == IRCC.CcLt { return "b"; }
    if cc == IRCC.CcLe { return "be"; }
    if cc == IRCC.CcGt { return "a"; }
    return "ae";
  }
  if cc == IRCC.CcEq { return "e"; }
  if cc == IRCC.CcNe { return "ne"; }
  if cc == IRCC.CcLt { return if is_unsigned { "b" } else { "l" }; }
  if cc == IRCC.CcLe { return if is_unsigned { "be" } else { "le" }; }
  if cc == IRCC.CcGt { return if is_unsigned { "a" } else { "g" }; }
  return if is_unsigned { "ae" } else { "ge" };
}

fn m_cmp(e: *MCtx, i: *IRIns) {
  let ao: i64 = m_vreg_off(e, i.a);
  let bo: i64 = m_vreg_off(e, i.b);
  let dof: i64 = m_vreg_off(e, i.dst);
  if !i.is_float {
    let u: bool = !i.signed_ops;
    m_ld(e, ao, i.size, false, "%rax");
    m_ld(e, bo, i.size, false, "%rcx");
    bs(e.out, "  cmpq %rcx, %rax\n");
    bs(e.out, cat4("  set", cat3(m_cc(i.cc, false, u), " %al\n", ""), "", ""));
    bs(e.out, "  movzbq %al, %rax\n");
    bs(e.out, cat4("  movq %rax, ", cat3(itoa(dof), "(%rbp)\n", ""), "", ""));
    return;
  }
  // floats: NaN-safe comparisons — the width rides the OPERAND type
  // (a CMP instruction carries no meaningful i->size)
  let size64: bool = i.a.ty == IRType.ItF64;
  let sfx: string = m_sfx(size64);
  m_ld(e, ao, if size64 { 8 } else { 4 }, true, "%xmm0");
  m_ld(e, bo, if size64 { 8 } else { 4 }, true, "%xmm1");
  bs(e.out, cat5("  ucomi", sfx, " %xmm1, %xmm0\n", "", ""));
  let cc: string = m_cc(i.cc, true, false);
  if streq(cc, "e") {
    // eq = ZF && !PF
    bs(e.out, "  sete %al\n  setnp %cl\n  andb %cl, %al\n");
  } else if streq(cc, "ne") {
    bs(e.out, "  setne %al\n  setp %cl\n  orb %cl, %al\n");
  } else if streq(cc, "b") {
    // lt = CF && !PF
    bs(e.out, "  setb %al\n  setnp %cl\n  andb %cl, %al\n");
  } else if streq(cc, "be") {
    bs(e.out, "  setbe %al\n  setnp %cl\n  andb %cl, %al\n");
  } else if streq(cc, "a") {
    bs(e.out, "  seta %al\n  setnp %cl\n  andb %cl, %al\n");
  } else {
    bs(e.out, "  setae %al\n  setnp %cl\n  andb %cl, %al\n");
  }
  bs(e.out, "  movzbq %al, %rax\n");
  bs(e.out, cat4("  movq %rax, ", cat3(itoa(dof), "(%rbp)\n", ""), "", ""));
}

fn m_divmod(e: *MCtx, i: *IRIns, is_mod: bool) {
  let ao: i64 = m_vreg_off(e, i.a);
  let bo: i64 = m_vreg_off(e, i.b);
  let dof: i64 = m_vreg_off(e, i.dst);
  let lbl: i32 = g_label_amd;
  g_label_amd += 1;
  let l: string = itoa(lbl as i64);
  if i.is_float {
    let fw: i64 = if i.dst.ty == IRType.ItF32 { 4 } else { 8 };
    let mut sfx: string = "sd";
    if fw == 4 {
      sfx = "ss";
    }
    m_ld(e, ao, fw, true, "%xmm0");
    m_ld(e, bo, fw, true, "%xmm1");
    bs(e.out, cat5("  div", sfx, " %xmm1, %xmm0\n", "", ""));
    m_st(e, dof, fw, true, "%xmm0");
    return;
  }
  let ext: string = m_ext(i.signed_ops);
  bs(e.out, cat4("Ldiv", cat3(l, "_guard:\n", ""), "", ""));
  m_ld(e, bo, i.size, false, "%rcx");
  bs(e.out, "  testq %rcx, %rcx\n");
  bs(e.out, cat4("  jne Ldiv", cat3(l, "_nz\n", ""), "", ""));
  bs(e.out, cat4("  movq ", cat3(itoa(ao), "(%rbp), %rdi\n", ""), "", ""));
  bs(e.out, cat4("  jmp Ldiv", cat3(l, "_neg\n", ""), "", ""));
  bs(e.out, cat4("Ldiv", cat3(l, "_neg:\n", ""), "", ""));
  bs(e.out, cat4("  call ", cat3(m_sym(e, prelude_symbol("__panic_div")), "\n", ""), "", ""));
  bs(e.out, cat4("Ldiv", cat3(l, "_nz:\n", ""), "", ""));
  if i.signed_ops {
    // MIN / -1 wraps to MIN: special-case divisor == -1
    bs(e.out, "  cmpq $-1, %rcx\n");
    bs(e.out, cat4("  jne Ldiv", cat3(l, "_ok\n", ""), "", ""));
    m_ld(e, ao, i.size, false, "%rax");
    bs(e.out, "  negq %rax\n");
    if is_mod {
      bs(e.out, "  xorq %rdx, %rdx\n");
    }
    bs(e.out, cat4("  jmp Ldiv", cat3(l, "_done\n", ""), "", ""));
    bs(e.out, cat4("Ldiv", cat3(l, "_ok:\n", ""), "", ""));
  }
  m_ld(e, ao, i.size, false, "%rax");
  bs(e.out, cat4("  ", cat3(ext, "\n", ""), "", ""));
  bs(e.out, cat4("  ", cat3(m_divmn(i.signed_ops), " %rcx\n", ""), "", ""));
  bs(e.out, cat4("Ldiv", cat3(l, "_done:\n", ""), "", ""));
  if is_mod {
    m_st(e, dof, 8, false, "%rdx");
  } else {
    m_st(e, dof, 8, false, "%rax");
  }
}

// parallel copies for phis on the edge out of the current block
fn m_edge(e: *MCtx, succ: *IRBlock) {
  let mut dsts: []i64 = make([]i64, 0);
  let mut srcs: []i64 = make([]i64, 0);
  let mut p: usize = 0;
  while p < len(succ.phis) {
    let phi: *IRPhi = succ.phis[p];
    let cur: *IRBlock = e.fn_.cur;
    let mut k: usize = 0;
    while k < len(phi.preds) {
      if phi.preds[k] == cur {
        let val: *IRVreg = phi.args[k];
        dsts = push_i64(dsts, m_vreg_off(e, phi.dst));
        srcs = push_i64(srcs, m_vreg_off(e, val));
        k = len(phi.preds);
      }
      k += 1;
    }
    p += 1;
  }
  while len(dsts) > 0 {
    // find a copy whose dst is not any remaining src (a safe copy)
    let mut done_at: i64 = -1;
    let mut i: usize = 0;
    while (i as i64) < len(dsts) as i64 && i < len(dsts) {
      let d: i64 = dsts[i];
      let mut is_src: bool = false;
      let mut j: usize = 0;
      while j < len(srcs) {
        if srcs[j] == d {
          is_src = true;
        }
        j += 1;
      }
      if !is_src {
        done_at = i as i64;
        i = len(dsts);
      }
      i += 1;
    }
    let pick: usize = if done_at >= 0 { done_at as usize } else { 0 };
    let d: i64 = dsts[pick];
    let s: i64 = srcs[pick];
    if done_at < 0 {
      // cycle: break it through the temp slot at -frame-8
      bs(e.out, cat4("  movq ", cat3(itoa(s), "(%rbp), %rax\n", ""), "", ""));
      bs(e.out, cat4("  movq %rax, -", cat3(itoa(e.frame - 8), "(%rbp)\n", ""), "", ""));
      dsts[pick] = s; // copy temp -> dst next round
      srcs[pick] = -(e.frame - 8);
      continue;
    }
    bs(e.out, cat4("  movq ", cat3(itoa(s), "(%rbp), %rax\n", ""), "", ""));
    bs(e.out, cat4("  movq %rax, ", cat3(itoa(d), "(%rbp)\n", ""), "", ""));
    // remove pick from both
    let mut j: usize = pick;
    while j + 1 < len(dsts) {
      dsts[j] = dsts[j + 1];
      srcs[j] = srcs[j + 1];
      j += 1;
    }
    dsts = dsts[0..len(dsts) - 1];
    srcs = srcs[0..len(srcs) - 1];
  }
}

fn m_call(e: *MCtx, i: *IRIns) {
  let mut ri: i32 = 0;
  let mut fi: i32 = 0;
  if i.callee_vreg != null {
    // indirect target rides in r10, outside the arg regs
    bs(e.out, cat4("  movq ", cat3(itoa(m_vreg_off(e, i.callee_vreg)), "(%rbp), %r10\n", ""), "", ""));
  }
  let mut k: usize = 0;
  while k < len(i.args) {
    let a: *IRVreg = i.args[k];
    let is_float_arg: bool = a.ty == IRType.ItF32 || a.ty == IRType.ItF64;
    let off: i64 = m_vreg_off(e, a);
    if is_float_arg && fi < 8 {
      // f32 args ride the low lane: movss, never the 8-byte movsd form
      if a.ty == IRType.ItF32 {
        bs(e.out, cat4("  movss ", cat3(itoa(off), "(%rbp), %xmm", ""), cat3(itoa(fi as i64), "\n", ""), ""));
      } else {
        bs(e.out, cat4("  movsd ", cat3(itoa(off), "(%rbp), %xmm", ""), cat3(itoa(fi as i64), "\n", ""), ""));
      }
      fi += 1;
    } else if !is_float_arg && ri < 6 {
      bs(e.out, cat4("  movq ", cat3(itoa(off), "(%rbp), ", ""), cat3(m_intreg(ri), "\n", ""), ""));
      ri += 1;
    } else {
      // stack arg (rare): push
      bs(e.out, cat4("  movq ", cat3(itoa(off), "(%rbp), %rax\n  pushq %rax\n", ""), "", ""));
    }
    k += 1;
  }
  if i.callee_vreg != null {
    bs(e.out, "  call *%r10\n");
  } else {
    bs(e.out, cat4("  call ", cat3(m_sym(e, i.callee), "\n", ""), "", ""));
  }
  if i.dst != null {
    let f: bool = ir_is_float_t(i.dst.ty);
    m_st(e, m_vreg_off(e, i.dst), if f { if i.dst.ty == IRType.ItF32 { 4 } else { 8 } } else { 8 }, f,
         m_retreg(f));
  }
}

fn m_intreg(n: i32) -> string {
  if n == 0 { return "%rdi"; }
  if n == 1 { return "%rsi"; }
  if n == 2 { return "%rdx"; }
  if n == 3 { return "%rcx"; }
  if n == 4 { return "%r8"; }
  return "%r9";
}

struct FConstNote {
  lbl: i32,
  v: f64,
  f32_: bool,
}

static mut g_fconsts: *Vec[*FConstNote] = 0 as *Vec[*FConstNote];

fn m_ins(e: *MCtx, i: *IRIns) {
  if i.op == IROp.IrMemsize || i.op == IROp.IrMemgrow {
    eprintf("{}", "rho: mem_size/mem_grow are wasm-only intrinsics\n");
    __exit(70);
  }
  if i.op == IROp.IrConst {
    let dof: i64 = m_vreg_off(e, i.dst);
    if i.imm >= -2147483648 && i.imm <= 2147483647 {
      bs(e.out, cat5("  movq $", itoa(i.imm), ", ", itoa(dof), "(%rbp)\n"));
    } else {
      bs(e.out, cat5("  movabsq $", itoa(i.imm), ", %rax\n  movq %rax, ", itoa(dof), "(%rbp)\n"));
    }
    return;
  }
  if i.op == IROp.IrFconst {
    // materialize via a rodata literal at the constant's own width: an f32
    // constant holds the FLOAT bits (the double's low half is not the f32
    // encoding — 0.5 would become +0.0)
    let lbl: i32 = g_label_amd;
    g_label_amd += 1;
    if i.dst.ty == IRType.ItF32 {
      bs(e.out, cat4("  movss Lfconst", cat3(itoa(lbl as i64), "(%rip), %xmm0\n", ""), "", ""));
      m_st(e, m_vreg_off(e, i.dst), 4, true, "%xmm0");
    } else {
      bs(e.out, cat4("  movsd Lfconst", cat3(itoa(lbl as i64), "(%rip), %xmm0\n", ""), "", ""));
      m_st(e, m_vreg_off(e, i.dst), 8, true, "%xmm0");
    }
    if g_fconsts == null {
      g_fconsts = new Vec[*FConstNote] { items: make([]*FConstNote, 8), n: 0 };
    }
    g_fconsts.push(new FConstNote { lbl: lbl, v: i.fimm, f32_: i.dst.ty == IRType.ItF32 });
    return;
  }
  if i.op == IROp.IrAdd || i.op == IROp.IrSub || i.op == IROp.IrMul ||
     i.op == IROp.IrAnd || i.op == IROp.IrOr || i.op == IROp.IrXor {
    let ao: i64 = m_vreg_off(e, i.a);
    let bo: i64 = m_vreg_off(e, i.b);
    let dof: i64 = m_vreg_off(e, i.dst);
    if i.is_float {
      // f32 arithmetic in the ss forms; the sd forms read 8 bytes off the
      // spill slot and corrupt f32 values
      let fw: i64 = if i.dst.ty == IRType.ItF32 { 4 } else { 8 };
      let mut sfx: string = "sd";
    if fw == 4 {
      sfx = "ss";
    }
      m_ld(e, ao, fw, true, "%xmm0");
      m_ld(e, bo, fw, true, "%xmm1");
      let fmn: string = m_fmn(i.op);
      bs(e.out, cat5("  ", fmn, sfx, " %xmm1, %xmm0\n", ""));
      m_st(e, dof, fw, true, "%xmm0");
      return;
    }
    let mn: string = m_imn(i.op);
    m_ld(e, ao, 8, false, "%rax");
    m_ld(e, bo, 8, false, "%rcx");
    bs(e.out, cat5("  ", mn, " %rcx, %rax\n", "", ""));
    m_canon(e, dof, i.a.ty);
    m_st(e, dof, 8, false, "%rax");
    return;
  }
  if i.op == IROp.IrDiv || i.op == IROp.IrMod {
    m_divmod(e, i, i.op == IROp.IrMod);
    return;
  }
  if i.op == IROp.IrShl || i.op == IROp.IrShr {
    let ao: i64 = m_vreg_off(e, i.a);
    let bo: i64 = m_vreg_off(e, i.b);
    let dof: i64 = m_vreg_off(e, i.dst);
    m_ld(e, ao, 8, false, "%rax");
    m_ld(e, bo, 8, false, "%rcx");
    let mn: string = m_shmn(i.op, i.signed_ops);
    bs(e.out, cat5("  ", mn, " %cl, %rax\n", "", ""));
    if i.op == IROp.IrShl {
      m_canon(e, dof, i.a.ty);
    }
    m_st(e, dof, 8, false, "%rax");
    return;
  }
  if i.op == IROp.IrCmp {
    m_cmp(e, i);
    return;
  }
  if i.op == IROp.IrLoad {
    let dof: i64 = m_vreg_off(e, i.dst);
    m_ld(e, m_vreg_off(e, i.addr), 8, false, "%rax");
    if i.is_float {
      bs(e.out, cat4("  ", cat3(m_ldf(i.size), " (%rax), %xmm0\n", ""), "", ""));
    } else if i.size == 1 {
      if ty_is_signed_int(i.dst.ty) { bs(e.out, "  movsbq (%rax), %rax\n"); } else { bs(e.out, "  movzbq (%rax), %rax\n"); }
    } else if i.size == 2 {
      if ty_is_signed_int(i.dst.ty) { bs(e.out, "  movswq (%rax), %rax\n"); } else { bs(e.out, "  movzwq (%rax), %rax\n"); }
    } else if i.size == 4 {
      if ty_is_signed_int(i.dst.ty) { bs(e.out, "  movslq (%rax), %rax\n"); } else { bs(e.out, "  movl (%rax), %eax\n"); }
    } else {
      bs(e.out, "  movq (%rax), %rax\n");
    }
    if i.is_float {
      m_st(e, dof, i.size, true, "%xmm0");
    } else {
      m_st(e, dof, 8, false, "%rax");
    }
    return;
  }
  if i.op == IROp.IrStore {
    m_ld(e, m_vreg_off(e, i.addr), 8, false, "%rax");
    m_ld(e, m_vreg_off(e, i.a), i.size, i.is_float, if i.is_float { "%xmm0" } else { "%rcx" });
    if i.is_float {
      bs(e.out, cat4("  ", cat3(m_ldf(i.size), " %xmm0, (%rax)\n", ""), "", ""));
    } else if i.size == 1 {
      bs(e.out, "  movb %cl, (%rax)\n");
    } else if i.size == 2 {
      bs(e.out, "  movw %cx, (%rax)\n");
    } else if i.size == 4 {
      bs(e.out, "  movl %ecx, (%rax)\n");
    } else {
      bs(e.out, "  movq %rcx, (%rax)\n");
    }
    return;
  }
  if i.op == IROp.IrAddrc {
    let dof: i64 = m_vreg_off(e, i.dst);
    if i.lit == -1 {
      // global symbol address
      bs(e.out, cat5("  leaq ", m_sym(e, i.callee), "(%rip), %rax\n", "", ""));
    } else {
      bs(e.out, cat5("  leaq ", itoa(m_slot_off(e, i.slot)), "(%rbp), %rax\n", "", ""));
    }
    bs(e.out, cat5("  movq %rax, ", itoa(dof), "(%rbp)\n", "", ""));
    return;
  }
  if i.op == IROp.IrAddi {
    let dof: i64 = m_vreg_off(e, i.dst);
    m_ld(e, m_vreg_off(e, i.a), 8, false, "%rax");
    bs(e.out, cat5("  addq $", itoa(i.imm), ", %rax\n", "", ""));
    bs(e.out, cat5("  movq %rax, ", itoa(dof), "(%rbp)\n", "", ""));
    return;
  }
  if i.op == IROp.IrCast {
    let sof: i64 = m_vreg_off(e, i.a);
    let dof: i64 = m_vreg_off(e, i.dst);
    if i.cast == IRCastKind.CastTrunc {
      m_ld(e, sof, 8, false, "%rax");
      m_st(e, dof, 8, false, "%rax");
    } else if i.cast == IRCastKind.CastSext {
      m_ld(e, sof, ir_size_of(i.cast_from), false, "%rax");
      m_st(e, dof, 8, false, "%rax");
    } else if i.cast == IRCastKind.CastZext {
      m_ld(e, sof, ir_size_of(i.cast_from), false, "%rax");
      if ir_size_of(i.cast_from) == 1 {
        bs(e.out, "  movzbq %al, %rax\n");
      } else if ir_size_of(i.cast_from) == 2 {
        bs(e.out, "  movzwq %ax, %rax\n");
      } else if ir_size_of(i.cast_from) == 4 {
        bs(e.out, "  movl %eax, %eax\n");
      }
      m_st(e, dof, 8, false, "%rax");
    } else if i.cast == IRCastKind.CastI2f {
      // narrow ints load sign/zero-extended at their own width; a u64
      // source needs the unsigned convert sequence (cvtsi2sd reads rax as
      // i64 and would mangle values >= 2^63)
      let fw: i64 = ir_size_of(i.cast_from);
      let sgn: bool = ty_is_signed_int(i.cast_from);
      let mut ld1: string = "movzbq";
      let mut ld2: string = "movzwq";
      let mut ld4: string = "movl";
      if sgn {
        ld1 = "movsbq";
        ld2 = "movswq";
        ld4 = "movslq";
      }
      let tail: string = cat3(itoa(sof), "(%rbp), %rax\n", "");
      if fw == 1 {
        bs(e.out, cat5("  ", ld1, " ", tail, ""));
      } else if fw == 2 {
        bs(e.out, cat5("  ", ld2, " ", tail, ""));
      } else if fw == 4 {
        bs(e.out, cat5("  ", ld4, " ", tail, ""));
      } else {
        bs(e.out, cat5("  movq ", itoa(sof), "(%rbp), %rax\n", "", ""));
      }
      let cvt: string = m_cvt_i2f(i.cast_to == IRType.ItF32);
      let lbl: i32 = g_label_amd;
      g_label_amd += 1;
      if !sgn && fw == 8 {
        let l: string = itoa(lbl as i64);
        bs(e.out, "  testq %rax, %rax\n");
        bs(e.out, cat3("  js Li2f", l, "_hi\n"));
        bs(e.out, cat5("  ", cvt, " %rax, %xmm0\n  jmp Li2f", cat3(l, "_done\n", ""), ""));
        bs(e.out, cat3("Li2f", l, "_hi:\n"));
        bs(e.out, "  movq %rax, %rcx\n  shrq $1, %rcx\n  andq $1, %rax\n  orq %rcx, %rax\n");
        bs(e.out, cat5("  ", cvt, " %rax, %xmm0\n", "", ""));
        bs(e.out, cat5("  add", if i.cast_to == IRType.ItF32 { "ss" } else { "sd" }, " %xmm0, %xmm0\n", "", ""));
        bs(e.out, cat3("Li2f", l, "_done:\n"));
      } else {
        bs(e.out, cat5("  ", cvt, " %rax, %xmm0\n", "", ""));
      }
      m_st(e, dof, if i.cast_to == IRType.ItF32 { 4 } else { 8 }, true, "%xmm0");
    } else if i.cast == IRCastKind.CastF2i {
      m_ld(e, sof, if i.cast_from == IRType.ItF32 { 4 } else { 8 }, true, "%xmm0");
      let to32: bool = !(i.cast_to == IRType.ItI64 || i.cast_to == IRType.ItU64);
      // the 32-bit form saturates at the 32-bit bounds (spec §4.2)
      if to32 {
        bs(e.out, cat5("  ", m_cvt_f2i(i.cast_from == IRType.ItF32), "l %xmm0, %eax\n", "", ""));
        bs(e.out, "  movslq %eax, %rax\n");
      } else {
        bs(e.out, cat5("  ", m_cvt_f2i(i.cast_from == IRType.ItF32), "q %xmm0, %rax\n", "", ""));
      }
      m_st(e, dof, 8, false, "%rax");
    } else if i.cast == IRCastKind.CastF32F64 {
      m_ld(e, sof, 4, true, "%xmm0");
      bs(e.out, "  cvtss2sd %xmm0, %xmm0\n");
      m_st(e, dof, 8, true, "%xmm0");
    } else if i.cast == IRCastKind.CastF64F32 {
      m_ld(e, sof, 8, true, "%xmm0");
      bs(e.out, "  cvtsd2ss %xmm0, %xmm0\n");
      m_st(e, dof, 4, true, "%xmm0");
    } else if i.cast == IRCastKind.CastReinterp {
      // exact bit move xmm <- slot, gpr <- xmm (f32_bits/f64_bits)
      if i.cast_from == IRType.ItF32 {
        bs(e.out, cat4("  movss ", cat3(itoa(sof), "(%rbp), %xmm0\n", ""), "", ""));
        bs(e.out, "  movd %xmm0, %eax\n");
        m_st(e, dof, 4, false, "%rax");
      } else {
        bs(e.out, cat4("  movsd ", cat3(itoa(sof), "(%rbp), %xmm0\n", ""), "", ""));
        bs(e.out, "  movq %xmm0, %rax\n");
        m_st(e, dof, 8, false, "%rax");
      }
    } else {
      // CastBitcopy
      m_ld(e, sof, 8, false, "%rax");
      m_st(e, dof, 8, false, "%rax");
    }
    return;
  }
  if i.op == IROp.IrCopymem {
    m_ld(e, m_vreg_off(e, i.addr), 8, false, "%rdi");
    m_ld(e, m_vreg_off(e, i.a), 8, false, "%rsi");
    if i.size < 0 {
      m_ld(e, m_vreg_off(e, i.b), 8, false, "%rcx"); // runtime count
    } else {
      bs(e.out, cat4("  movq $", cat3(itoa(i.size), ", %rcx\n", ""), "", ""));
    }
    bs(e.out, "  cld\n  rep movsb\n");
    return;
  }
  if i.op == IROp.IrZero {
    m_ld(e, m_vreg_off(e, i.addr), 8, false, "%rax");
    bs(e.out, cat4("  movq $", cat3(itoa(i.size), ", %rcx\n  movq $0, %rdx\n", ""), "", ""));
    let lbl: i32 = g_label_amd;
    g_label_amd += 1;
    let l: string = itoa(lbl as i64);
    bs(e.out, cat4("Lzero", cat3(l, ":\n  testq %rcx, %rcx\n  jz Lzero", cat3(l, "_end\n", "")), "", ""));
    bs(e.out, cat4("  movb %dl, (%rax)\n  incq %rax\n  decq %rcx\n  jnz Lzero", cat3(l, "\n", ""), "", ""));
    bs(e.out, cat3("Lzero", cat3(l, "_end:\n", ""), ""));
    return;
  }
  if i.op == IROp.IrLitaddr {
    let dof: i64 = m_vreg_off(e, i.dst);
    let lit: *IRLit = e.fn_.literals[i.lit as usize];
    bs(e.out, cat5("  leaq ", m_lit(e, lit.label), "(%rip), %rax\n", "", ""));
    bs(e.out, cat5("  movq %rax, ", itoa(dof), "(%rbp)\n", "", ""));
    return;
  }
  if i.op == IROp.IrCall {
    m_call(e, i);
    return;
  }
}

fn m_term(e: *MCtx) {
  let fn_: *IRFn = e.fn_;
  if fn_.cur.term_op == 100 {
    let to: *IRBlock = fn_.cur.br_true;
    m_edge(e, to);
    bs(e.out, cat5("  jmp L", itoa(fn_.uid as i64), "_", itoa(to.id as i64), "\n"));
  } else if fn_.cur.term_op == 101 {
    let tt: *IRBlock = fn_.cur.br_true;
    let ff: *IRBlock = fn_.cur.br_false;
    let cof: i64 = m_vreg_off(e, fn_.cur.cbr_cond);
    bs(e.out, cat5("  cmpb $0, ", itoa(cof), "(%rbp)\n", "", ""));
    bs(e.out, cat5("  je Lcbf", itoa(g_label_amd as i64), "\n", "", ""));
    m_edge(e, tt);
    bs(e.out, cat5("  jmp L", itoa(fn_.uid as i64), "_", itoa(tt.id as i64), "\n"));
    bs(e.out, cat5("Lcbf", itoa(g_label_amd as i64), ":\n", "", ""));
    m_edge(e, ff);
    bs(e.out, cat5("  jmp L", itoa(fn_.uid as i64), "_", itoa(ff.id as i64), "\n"));
    g_label_amd += 1;
  } else if fn_.cur.term_op == 102 {
    if fn_.cur.ret_val != null {
      let f: bool = ir_is_float_t(fn_.cur.ret_val.ty);
      // f32 returns ride the low lane at 4 bytes
      m_ld(e, m_vreg_off(e, fn_.cur.ret_val),
           if f { if fn_.cur.ret_val.ty == IRType.ItF32 { 4 } else { 8 } } else { 8 },
           f, m_retreg(f));
    }
    bs(e.out, "  movq %rbp, %rsp\n  popq %rbp\n  ret\n");
  } else {
    bs(e.out, "  movq %rbp, %rsp\n  popq %rbp\n  ret\n");
  }
}

static mut g_fn_uid: i32 = 0;

fn m_fn(e: *MCtx, fn_: *IRFn) {
  e.fn_ = fn_;
  fn_.uid = g_fn_uid;
  g_fn_uid += 1;
  m_layout(e);
  let s: string = m_sym(e, fn_.symbol);
  bs(e.out, cat5("\n  ", s, ":\n", "", ""));
  bs(e.out, "  pushq %rbp\n  movq %rsp, %rbp\n");
  if e.frame != 0 {
    bs(e.out, cat5("  subq $", itoa(e.frame), ", %rsp\n", "", ""));
  }
  // spill register params into their slots
  let mut ri: i32 = 0;
  let mut fi: i32 = 0;
  if fn_.returns_aggregate {
    ri += 1; // rdi carries the out pointer
    bs(e.out, cat5("  movq %rdi, ", itoa(m_slot_off(e, fn_.out_slot)), "(%rbp)\n", "", ""));
  }
  let mut p: usize = 0;
  while p < len(fn_.params) {
    let slot: *IRSlot = fn_.params[p];
    let mut pt: *Type = null;
    if p < len(fn_.param_types) {
      pt = fn_.param_types[p];
    }
    let isf: bool = pt != null && (pt.kind == TypeKind.TyF32 || pt.kind == TypeKind.TyF64);
    if isf && fi < 8 {
      // f32 params arrive in the low lane (movss); movsd would read 8 bytes
      if pt.kind == TypeKind.TyF32 {
        bs(e.out, cat5("  movss %xmm", itoa(fi as i64), ", ", itoa(m_slot_off(e, slot)), "(%rbp)\n"));
      } else {
        bs(e.out, cat5("  movsd %xmm", itoa(fi as i64), ", ", itoa(m_slot_off(e, slot)), "(%rbp)\n"));
      }
      fi += 1;
    } else if !isf && ri < 6 {
      bs(e.out, cat5("  movq ", m_intreg(ri), ", ", itoa(m_slot_off(e, slot)), "(%rbp)\n"));
      ri += 1;
    } else {
      // stack param: above the saved rbp and return address
      let stack_index: i32 = (if isf { fi } else { ri }) + p as i32;
      let over: i32 = if stack_index - 6 > 0 { stack_index - 6 } else { 0 };
      bs(e.out, cat5("  movq ", itoa((16 + 8 * over) as i64), "(%rbp), %rax\n", "", ""));
      bs(e.out, cat5("  movq %rax, ", itoa(m_slot_off(e, slot)), "(%rbp)\n", "", ""));
    }
    p += 1;
  }
  let mut bi: usize = 0;
  while bi < len(fn_.blocks) {
    let b: *IRBlock = fn_.blocks[bi];
    e.fn_.cur = b;
    bs(e.out, cat5("L", itoa(e.fn_.uid as i64), "_", itoa(b.id as i64), ":\n"));
    let mut ii: usize = 0;
    while ii < len(b.ins) {
      m_ins(e, b.ins[ii]);
      ii += 1;
    }
    m_term(e);
    bi += 1;
  }
}

fn emit_amd64_text(target: i32) -> []u8 {
  let out: *Vec[u8] = new Vec[u8] { items: make([]u8, 1024), n: 0 };
  let e: *MCtx = new MCtx {
    out: out, fn_: null, offs: make([]i64, 0), frame: 0,
    is_mac: target == 1 || target == 2,
  };
  if e.is_mac {
    bs(out, ".section __TEXT,__text,regular,pure_instructions\n");
    bs(out, ".build_version macos, 13, 0\n");
  } else {
    bs(out, ".text\n");
  }
  let mut i: usize = 0;
  while i < g_ir_fns.n {
    m_fn(e, g_ir_fns.items[i]);
    i += 1;
  }
  // string literals + float consts in rodata; every literal carries an
  // immortal rc header {sentinel, 0, null} so slice traffic no-ops on it
  if e.is_mac {
    bs(out, ".section __TEXT,__rhostr,regular\n");
  } else {
    bs(out, ".section .rodata\n");
  }
  i = 0;
  while i < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[i];
    let mut j: usize = 0;
    while j < len(fn_.literals) {
      let l: *IRLit = fn_.literals[j];
      bs(out, cat5("  .p2align 3\n", m_lit(e, l.label), ":\n  .quad 0x8000000000000000\n  .quad 0\n  .quad 0\n", m_lit(e, cat3(l.label, "_b", "")), ":\n  .ascii \""));
      let mut k: usize = 0;
      while k < len(l.bytes) {
        let ch: u8 = l.bytes[k];
        if ch >= 0x20 && ch < 0x7F && ch != 34 && ch != 92 {
          b8(out, ch);
        } else {
          bs(out, cat3("\\", oct3(ch), ""));
        }
        k += 1;
      }
      bs(out, "\"\n");
      j += 1;
    }
    i += 1;
  }
  // static string initializers: their rodata blocks belong to the global,
  // not to any fn — without this the reloc labels dangle at assembly
  i = 0;
  while i < g_ir_globals.n {
    let g: *IRGlobal = g_ir_globals.items[i];
    if g.static_lit != null {
      let l: *IRLit = g.static_lit;
      bs(out, cat5("  .p2align 3\n", m_lit(e, l.label), ":\n  .quad 0x8000000000000000\n  .quad 0\n  .quad 0\n", m_lit(e, cat3(l.label, "_b", "")), ":\n  .ascii \""));
      let mut k: usize = 0;
      while k < len(l.bytes) {
        let ch: u8 = l.bytes[k];
        if ch >= 0x20 && ch < 0x7F && ch != 34 && ch != 92 {
          b8(out, ch);
        } else {
          bs(out, cat3("\\", oct3(ch), ""));
        }
        k += 1;
      }
      bs(out, "\"\n");
    }
    i += 1;
  }
  if g_fconsts != null {
    let mut n: usize = 0;
    while n < g_fconsts.n {
      let fc: *FConstNote = g_fconsts.items[n];
      if fc.f32_ {
        // .long with the FLOAT bits — a .quad of the double's bits would
        // hand movss 8 wrong bytes
        let bits32: u32 = intrinsics.f32_bits(fc.v as f32);
        bs(out, cat5("  .p2align 2\nLfconst", itoa(fc.lbl as i64), ":\n  .long ", utoa(bits32 as u64), "\n"));
      } else {
        let bits: u64 = intrinsics.f64_bits(fc.v);
        bs(out, cat5("  .p2align 3\nLfconst", itoa(fc.lbl as i64), ":\n  .quad ", utoa(bits), "\n"));
      }
      n += 1;
    }
  }
  i = 0;
  while i < g_ir_globals.n {
    let g: *IRGlobal = g_ir_globals.items[i];
    bs(out, cat5("\n  .globl ", m_sym(e, g.symbol), "\n", "", ""));
    if e.is_mac {
      bs(out, ".section __DATA,__data\n");
    } else {
      bs(out, ".section .data\n");
    }
    bs(out, cat5("  .p2align ", itoa(glob_p2align(g.align)), "\n", "", ""));
    bs(out, cat5(m_sym(e, g.symbol), ":\n", "", "", ""));
    emit_glob_data(out, g, m_globpre(e.is_mac));
    i += 1;
  }
  // C entry: call the root module's main
  if g_main_cell != null && g_main_cell.items[0] != "" {
    if e.is_mac {
      bs(out, ".section __TEXT,__text,regular,pure_instructions\n");
    } else {
      bs(out, ".text\n");
    }
    bs(out, cat5("\n  .globl ", m_sym(e, "main"), "\n", "", ""));
    bs(out, cat5(m_sym(e, "main"), ":\n", "", "", ""));
    bs(out, "  pushq %rbp\n  movq %rsp, %rbp\n");
    bs(out, cat5("  call ", m_sym(e, g_main_cell.items[0]), "\n", "", ""));
    bs(out, "  movq %rbp, %rsp\n  popq %rbp\n  ret\n");
  }
  return out.items[0..out.n];
}

// string-valued if-expressions are not lowerable in 0.0.5 (aggregate arms);
// the emitters pick mnemonics through these helpers instead
fn ac_addop(off: i64) -> string {
  if off < 0 { return "sub"; }
  return "add";
}

fn ac_icc(cc: IRCC, u: bool) -> string {
  if cc == IRCC.CcEq { return "eq"; }
  if cc == IRCC.CcNe { return "ne"; }
  if cc == IRCC.CcLt { if u { return "lo"; } return "lt"; }
  if cc == IRCC.CcLe { if u { return "ls"; } return "le"; }
  if cc == IRCC.CcGt { if u { return "hi"; } return "gt"; }
  if u { return "hs"; }
  return "ge";
}

fn ac_dreg(s64: bool, zero: bool) -> string {
  if s64 {
    if zero { return "d0"; }
    return "d1";
  }
  if zero { return "s0"; }
  return "s1";
}

fn ac_divmn(signed: bool) -> string {
  if signed { return "sdiv"; }
  return "udiv";
}

fn ac_fmn(op: IROp) -> string {
  if op == IROp.IrAdd { return "fadd"; }
  if op == IROp.IrSub { return "fsub"; }
  return "fmul";
}

fn ac_imn(op: IROp) -> string {
  if op == IROp.IrAdd { return "add"; }
  if op == IROp.IrSub { return "sub"; }
  if op == IROp.IrMul { return "mul"; }
  if op == IROp.IrAnd { return "and"; }
  if op == IROp.IrOr { return "orr"; }
  return "eor";
}

fn ac_shmn(op: IROp, signed: bool) -> string {
  if op == IROp.IrShl { return "lslv"; }
  if signed { return "asrv"; }
  return "lsrv";
}

fn ac_fld(size: i64) -> string {
  if size == 8 { return "d0"; }
  return "s0";
}

fn ac_ldop(size: i64, sgn: bool) -> string {
  // zero-extend unsigned loads (spill slots hold 8 bytes)
  if size == 1 { if sgn { return "ldrsb x8, [x8]"; } return "ldrb w8, [x8]"; }
  if size == 2 { if sgn { return "ldrsh x8, [x8]"; } return "ldrh w8, [x8]"; }
  if size == 4 { if sgn { return "ldrsw x8, [x8]"; } return "ldr w8, [x8]"; }
  return "ldr x8, [x8]";
}

fn ac_streg(flt: bool) -> string {
  if flt { return "d0"; }
  return "x9";
}

fn ac_cvt_dreg(f32: bool) -> string {
  if f32 { return "s0"; }
  return "d0";
}

fn ac_retreg(flt: bool) -> string {
  if flt { return "d0"; }
  return "x0";
}

fn m_ext(signed: bool) -> string {
  if signed { return "cqo"; }
  return "xorl %edx, %edx";
}

fn m_divmn(signed: bool) -> string {
  if signed { return "idivq"; }
  return "divq";
}

fn m_sfx(size64: bool) -> string {
  if size64 { return "sd"; }
  return "ss";
}

fn m_imn(op: IROp) -> string {
  if op == IROp.IrAdd { return "add"; }
  if op == IROp.IrSub { return "sub"; }
  if op == IROp.IrMul { return "imul"; }
  if op == IROp.IrAnd { return "and"; }
  if op == IROp.IrOr { return "or"; }
  return "xor";
}

fn m_fmn(op: IROp) -> string {
  // width suffix appended by the caller (ss for f32, sd for f64)
  if op == IROp.IrAdd { return "add"; }
  if op == IROp.IrSub { return "sub"; }
  return "mul";
}

fn m_shmn(op: IROp, signed: bool) -> string {
  if op == IROp.IrShl { return "salq"; }
  if signed { return "sarq"; }
  return "shrq";
}

fn m_ldf(size: i64) -> string {
  if size == 8 { return "movsd"; }
  return "movss";
}

fn m_cvt_i2f(f32: bool) -> string {
  if f32 { return "cvtsi2ss"; }
  return "cvtsi2sd";
}

fn m_cvt_f2i(f32: bool) -> string {
  if f32 { return "cvttss2si"; }
  return "cvttsd2si";
}

fn m_retreg(flt: bool) -> string {
  if flt { return "%xmm0"; }
  return "%rax";
}

fn m_globpre(is_mac: bool) -> string {
  if is_mac { return "L"; }
  return ".";
}

fn bytes_as_string(b: []u8) -> string {
  return intrinsics.slice_string(b);
}

// debug: dump IR fns (mirrors boot's RHO_DUMP_IR shape, keys off --dump-ir)
static mut g_dump_ir: bool = false;

fn op_name(op: i32) -> string {
  if op == 100 { return "br"; }
  if op == 101 { return "cbr"; }
  if op == 102 { return "ret"; }
  if op == 0 { return "const"; }
  if op == 1 { return "fconst"; }
  if op == 2 { return "add"; }
  if op == 3 { return "sub"; }
  if op == 4 { return "mul"; }
  if op == 5 { return "div"; }
  if op == 6 { return "mod"; }
  if op == 7 { return "and"; }
  if op == 8 { return "or"; }
  if op == 9 { return "xor"; }
  if op == 10 { return "shl"; }
  if op == 11 { return "shr"; }
  if op == 12 { return "cmp"; }
  if op == 13 { return "load"; }
  if op == 14 { return "store"; }
  if op == 15 { return "addrc"; }
  if op == 16 { return "addi"; }
  if op == 17 { return "call"; }
  if op == 18 { return "cast"; }
  if op == 19 { return "copymem"; }
  if op == 20 { return "zero"; }
  if op == 21 { return "litaddr"; }
  return "?";
}

fn lower_dump_ir() {
  let mut i: usize = 0;
  while i < g_ir_fns.n {
    let fn_: *IRFn = g_ir_fns.items[i];
    eprintf("{}", "fn ");
    eprintf("{}", fn_.symbol);
    eprintf("{}", "\n");
    let mut si: usize = 0;
    while si < len(fn_.slots) {
      eprintf("{}", "  slot ");
      eprintf("{}", itoa(fn_.slots[si].id as i64));
      eprintf("{}", " size=");
      eprintf("{}", itoa(fn_.slots[si].size));
      eprintf("{}", " name=");
      eprintf("{}", fn_.slots[si].name);
      eprintf("{}", "\n");
      si += 1;
    }
    let mut b: usize = 0;
    while b < len(fn_.blocks) {
      let blk: *IRBlock = fn_.blocks[b];
      eprintf("{}", " block ");
      eprintf("{}", itoa(blk.id as i64));
      eprintf("{}", "\n");
      let mut p: usize = 0;
      while p < len(blk.phis) {
        let phi: *IRPhi = blk.phis[p];
        eprintf("{}", "  phi v");
        eprintf("{}", itoa(phi.dst.id as i64));
        eprintf("{}", " nargs=");
        eprintf("{}", itoa(len(phi.args) as i64));
        eprintf("{}", "\n");
        p += 1;
      }
      let mut k: usize = 0;
      while k < len(blk.ins) {
        let ins: *IRIns = blk.ins[k];
        eprintf("{}", "  ");
        eprintf("{}", op_name(ins.op as i32));
        if ins.dst != null {
          eprintf("{}", " d=");
          eprintf("{}", itoa(ins.dst.id as i64));
        }
        if ins.a != null {
          eprintf("{}", " a=");
          eprintf("{}", itoa(ins.a.id as i64));
        }
        if ins.b != null {
          eprintf("{}", " b=");
          eprintf("{}", itoa(ins.b.id as i64));
        }
        if ins.addr != null {
          eprintf("{}", " @");
          eprintf("{}", itoa(ins.addr.id as i64));
        }
        if ins.slot != null {
          eprintf("{}", " s");
          eprintf("{}", itoa(ins.slot.id as i64));
        }
        if ins.callee != "" {
          eprintf("{}", " call=");
          eprintf("{}", ins.callee);
        }
        if ins.op == IROp.IrConst || ins.op == IROp.IrAddi {
          eprintf("{}", " imm=");
          eprintf("{}", itoa(ins.imm));
        }
        if ins.size != 0 {
          eprintf("{}", " sz=");
          eprintf("{}", itoa(ins.size));
        }
        eprintf("{}", "\n");
        k += 1;
      }
      if blk.term_op != 0 {
        eprintf("{}", "  term ");
        eprintf("{}", op_name(blk.term_op));
        if blk.term_op == 101 {
          eprintf("{}", " cond=v");
          eprintf("{}", itoa(blk.cbr_cond.id as i64));
          eprintf("{}", " then=B");
          eprintf("{}", itoa(blk.br_true.id as i64));
          eprintf("{}", " else=B");
          eprintf("{}", itoa(blk.br_false.id as i64));
        }
        if blk.term_op == 100 {
          eprintf("{}", " to=B");
          eprintf("{}", itoa(blk.br_true.id as i64));
        }
        if blk.term_op == 102 && blk.ret_val != null {
          eprintf("{}", " v=");
          eprintf("{}", itoa(blk.ret_val.id as i64));
        }
        eprintf("{}", "\n");
      }
      b += 1;
    }
    i += 1;
  }
}

// ============== 0.3.2 image layer ==========================================
// rho's own assemblers (asm64 for arm64, asm86 for amd64 AT&T), the ELF64
// and Mach-O image writers, the in-tree SHA-256 for the ad-hoc code
// signature, and the per-target runtime blobs. Nothing here or downstream
// shells out to an external assembler or linker.

// ---- runtime blobs (byte-identical to boot's main.c) ----------------------

fn rt_arm64() -> string { return """.section __TEXT,__text,regular,pure_instructions
.globl _rho_rt_start
_rho_rt_start:
  adrp x8, _rho_rt_argc@PAGE
  add x8, x8, _rho_rt_argc@PAGEOFF
  str w0, [x8]
  adrp x8, _rho_rt_argv@PAGE
  add x8, x8, _rho_rt_argv@PAGEOFF
  str x1, [x8]
  adrp x8, _rho_rt_heap@PAGE
  add x8, x8, _rho_rt_heap@PAGEOFF
  adrp x9, _rho__prelude___HEAP@PAGE
  add x9, x9, _rho__prelude___HEAP@PAGEOFF
  str x8, [x9]
  bl _main
  mov x16, #1
  movk x16, #32, lsl 16
  svc #0x80
.globl _write
_write:
  mov x16, #4
  movk x16, #32, lsl 16
  svc #0x80
  b.cs L_write_e
  ret
L_write_e:
  neg x0, x0
  ret
.globl _exit
_exit:
  mov x16, #1
  movk x16, #32, lsl 16
  svc #0x80
.globl _open
_open:
  mov x16, #5
  svc #0x80
  b.cs L_open_e
  ret
L_open_e:
  neg x0, x0
  ret
.globl _read
_read:
  mov x16, #3
  svc #0x80
  b.cs L_read_e
  ret
L_read_e:
  neg x0, x0
  ret
.globl _close
_close:
  mov x16, #6
  svc #0x80
  b.cs L_close_e
  ret
L_close_e:
  neg x0, x0
  ret
.globl _rename
_rename:
  mov x16, #128
  movk x16, #32, lsl 16
  svc #0x80
  b.cs L_rename_e
  ret
L_rename_e:
  neg x0, x0
  ret
.globl __NSGetArgc
__NSGetArgc:
  adrp x0, _rho_rt_argc@PAGE
  add x0, x0, _rho_rt_argc@PAGEOFF
  ret
.globl __NSGetArgv
__NSGetArgv:
  adrp x0, _rho_rt_argv@PAGE
  add x0, x0, _rho_rt_argv@PAGEOFF
  ret
.data
.globl _rho_rt_argc
_rho_rt_argc:
  .long 0
  .long 0
.globl _rho_rt_argv
_rho_rt_argv:
  .quad 0
"""; }

fn rt_amd64_linux() -> string { return """.text
rho_rt_start:
  movq (%rsp), %rax
  leaq rho_rt_argc(%rip), %rcx
  movl %eax, (%rcx)
  leaq 8(%rsp), %rax
  leaq rho_rt_argv(%rip), %rcx
  movq %rax, (%rcx)
  leaq _rho_rt_heap(%rip), %rax
  leaq rho__prelude___HEAP(%rip), %rcx
  movq %rax, (%rcx)
  call main
  movl %eax, %edi
  movl $60, %eax
  syscall
write:
  movl $1, %eax
  syscall
  ret
exit:
  movl $60, %eax
  syscall
read:
  movl $0, %eax
  syscall
  ret
open:
  movl $2, %eax
  syscall
  ret
close:
  movl $3, %eax
  syscall
  ret
rename:
  movl $82, %eax
  syscall
  ret
_NSGetArgc:
  leaq rho_rt_argc(%rip), %rax
  ret
_NSGetArgv:
  leaq rho_rt_argv(%rip), %rax
  ret
.data
rho_rt_argc:
  .long 0
  .long 0
rho_rt_argv:
  .quad 0
"""; }

fn rt_arm64_linux() -> string { return """.text
rho_rt_start:
  ldr x10, [sp]
  adrp x8, rho_rt_argc@PAGE
  add x8, x8, rho_rt_argc@PAGEOFF
  str w10, [x8]
  add x10, sp, #8
  adrp x8, rho_rt_argv@PAGE
  add x8, x8, rho_rt_argv@PAGEOFF
  str x10, [x8]
  adrp x8, _rho_rt_heap@PAGE
  add x8, x8, _rho_rt_heap@PAGEOFF
  adrp x9, rho__prelude___HEAP@PAGE
  add x9, x9, rho__prelude___HEAP@PAGEOFF
  str x8, [x9]
  bl main
  mov x8, #93
  svc #0
.globl write
write:
  mov x8, #64
  svc #0
  ret
.globl exit
exit:
  mov x8, #93
  svc #0
.globl read
read:
  mov x8, #63
