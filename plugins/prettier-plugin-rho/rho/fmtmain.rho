// fmtmain.rho — the fmt wasm's root (prettier-plugin-rho).
//
// The formatting truth is libs/compiler's fmt pipeline, used verbatim:
// lex → parse → fmt_prog. Only the entry differs from the compiler's
// own main.rho: the source text arrives at RUNTIME instead of riding
// the SRC build parameter, because the kernel imports just fd_write +
// proc_exit (no args, no stdin) — a wasm cannot read a channel today.
//
// The runtime bridge: INPUT is a const string whose bytes live at a
// deterministic data-segment offset. The host writes the source bytes
// plus one NUL terminator into linear memory at that offset (pinned in
// assets/generation.json at artifact-build time) before calling
// _start. This root scans to the NUL, takes a view of the input, and
// formats it. A raw NUL byte cannot appear in valid rho source (the
// escape spelling \0 is two ASCII bytes), so the terminator is safe.
//
// Built by boot (the seed compiler) over the vendored libs/compiler
// modules — see tools/build-fmt.mjs for the exact chain.
use lex;
use parse;
use fmt;

// The input slot: one 64 KiB buffer. FILL folds into INPUT at compile
// time (§7: const initializers fold; literal concatenation folds), so
// the data segment carries one contiguous literal whose 'A' run is the
// marker the packaging tool locates (tools/build-fmt.mjs).
const FILL: string = "";
const INPUT: string = "RHO_FMT_INPUT_SLOT_" + FILL + FILL + FILL + FILL + FILL + FILL + FILL + FILL + FILL + FILL + FILL + FILL + FILL + FILL + FILL + FILL;

fn main() -> i32 {
  // scan to the NUL the host wrote (the buffer's tail is filled with
  // the sentinel's own 'A' fill at build time, so a missing terminator
  // scans to the full capacity and formats garbage — the host always
  // terminates, and a mismatched generation is a packaging bug)
  let mut n: usize = 0;
  while n < len(INPUT) {
    if INPUT[n] == 0 {
      break;
    }
    n += 1;
  }
  let src: string = INPUT[0..n];
  // the FMT face lexes through scan(): the formatter replays the
  // file's comments, so the Prog must carry the comment tables
  let lx = lex.scan(src);
  let mut prog: *Prog = parse.parse_full(lx.toks, src, lx.ctexts,
                                         lx.clines);
  if prog.perrs > 0 {
    eprintf("parse: {} unresolved form(s)\n", prog.perrs);
    return 1;
  }
  let text: string = fmt.fmt_prog(prog);
  // stream in slices: the format scratch is bounded, programs are not
  let mut off: usize = 0;
  while off < len(text) {
    let mut end: usize = off + 512;
    if end > len(text) {
      end = len(text);
    }
    printf("{}", text[off..end]);
    off = end;
  }
  return 0;
}
