  (data (i32.const 738624) "\0astruct Dec {\0a  limbs: []i64,\0a  used: i64,\0a}\0a\0afn __dec_new() -> *Dec {\0a  return new Dec { limbs: make([]i64, 96), used: 1 };\0a}\0a\0afn __dec_trim(d: *Dec) {\0a  while d.used > 1 && d.limbs[d.used - 1] == 0 {\0a    d.used = d.used - 1;\0a  }\0a  return;\0a}\0a\0afn __dec_set(d: *Dec, v: u64) {\0a  d.limbs[0] = (v % 1000000000) as i64;\0a  d.limbs[1] = ((v / 1000000000) % 1000000000) as i64;\0a  d.limbs[2] = (v / 1000000000000000000) as i64;\0a  d.used = 3;\0a  __dec_trim(d);\0a  return;\0a}\0a\0afn __dec_mul_small(d: *Dec, m: i64) {\0a  let mut carry: u64 = 0;\0a  let mut i: i64 = 0;\0a  while i < d.used {\0a    let cur: u64 = (d.limbs[i] as u64) * (m as u64) + carry;\0a    d.limbs[i] = (cur % 1000000000) as i64;\0a    carry = cur / 1000000000;\0a    i = i + 1;\0a  }\0a  while carry > 0 {\0a    d.limbs[d.used] = (carry % 1000000000) as i64;\0a    carry = carry / 1000000000;\0a    d.used = d.used + 1;\0a  }\0a  return;\0a}\0a\0afn __dec_to_u64(d: *Dec) -> u64 {\0a  let mut v: u64 = 0;\0a  let mut i: i64 = d.used;\0a  while i > 0 {\0a    i = i - 1;\0a    v = v * 1000000000 + (d.limbs[i] as u64);\0a  }\0a  return v;\0a}\0a\0afn __dec_bump(d: *Dec) {\0a  let mut i: i64 = 0;\0a  loop {\0a    if i >= d.used {\0a      d.limbs[i] = 1;\0a      d.used = d.used + 1;\0a      return;\0a    }\0a    if d.limbs[i] + 1 < 1000000000 {\0a      d.limbs[i] = d.limbs[i] + 1;\0a      return;\0a    }\0a    d.limbs[i] = 0;\0a    i = i + 1;\0a  }\0a}\0a\0afn __dec_cmp(a: *Dec, b: *Dec) -> i32 {\0a  if a.used != b.used {\0a    if a.used < b.used {\0a      return 0 - 1;\0a    }\0a    return 1;\0a  }\0a  let mut i: i64 = a.used;\0a  while i > 0 {\0a    i = i - 1;\0a    if a.limbs[i] != b.limbs[i] {\0a      if a.limbs[i] < b.limbs[i] {\0a        return 0 - 1;\0a      }\0a      return 1;\0a    }\0a  }\0a  return 0;\0a}\0a\0afn __pow10(k: i64) -> u64 {\0a  let mut v: u64 = 1;\0a  let mut i: i64 = 0;\0a  while i < k {\0a    v = v * 10;\0a    i = i + 1;\0a  }\0a  return v;\0a}\0a\0afn __pow2s(k: i64) -> i64 {\0a  let mut v: i64 = 1;\0a  let mut i: i64 = 0;\0a  while i < k {\0a    v = v * 2;\0a    i = i + 1;\0a  }\0a  return v;\0a}\0a\0afn __pow5s(k: i64) -> i64 {\0a  let mut v: i64 = 1;\0a  let mut i: i64 = 0;\0a  while i < k {\0a    v = v * 5;\0a    i = i + 1;\0a  }\0a  return v;\0a}\0a\0afn __dec_top_digits(d: *Dec) -> i64 {\0a  let mut x: i64 = d.limbs[d.used - 1];\0a  let mut n: i64 = 1;\0a  while x >= 10 {\0a    x = x / 10;\0a    n = n + 1;\0a  }\0a  return n;\0a}\0a\0a// 5\c2\b710^(cut-1): half of the divisor 10^cut\0afn __dec_half_of(cut: i64) -> *Dec {\0a  let h: *Dec = __dec_new();\0a  let pos: i64 = cut - 1;\0a  let mut l: i64 = pos / 9;\0a  let r: i64 = pos % 9;\0a  h.limbs[l] = (5 * __pow10(r)) as i64;\0a  h.used = l + 1;\0a  return h;\0a}\0a\0a// q = d div 10^cut (returned); d keeps d mod 10^cut\0afn __dec_split(d: *Dec, cut: i64) -> *Dec {\0a  let mut l: i64 = cut / 9;\0a  let r: i64 = cut % 9;\0a  let q: *Dec = __dec_new();\0a  if d.used <= l {\0a    return q;\0a  }\0a  let qn: i64 = d.used - l;\0a  let mut p: u64 = __pow10(r);\0a  let mut rem: u64 = 0;\0a  let mut i: i64 = qn;\0a  while i > 0 {\0a    i = i - 1;\0a    let cur: u64 = rem * 1000000000 + (d.limbs[l + i] as u64);\0a    q.limbs[i] = (cur / p) as i64;\0a    rem = cur % p;\0a  }\0a  q.used = qn;\0a  __dec_trim(q);\0a  if r > 0 {\0a    d.limbs[l] = rem as i64;\0a    d.used = l + 1;\0a  } else {\0a    d.used = l;\0a  }\0a  if d.used == 0 {\0a    d.limbs[0] = 0;\0a    d.used = 1;\0a  }\0a  __dec_trim(d);\0a  return q;\0a}\0a\0afn __drop_zeros(s: string) -> string {\0a  let mut k: i64 = len(s);\0a  while k > 0 && s[k - 1] == 48 {\0a    k = k - 1;\0a  }\0a  return s[0..k];\0a}\0a\0afn __sgn(neg: bool, body: string) -> string {\0a  if neg {\0a    return \22-\22 + body;\0a  }\0a  return body;\0a}\0a\0afn __dec_text(bits: u64, prec: i64) -> string {\0a  let neg: bool = (bits >> 63) == 1;\0a  let mag: u64 = bits & 9223372036854775807;\0a  let biased: u64 = (mag >> 52) & 2047;\0a  if biased == 2047 {\0a    if (mag & 4503599627370495) == 0 {\0a      return __sgn(neg, \22inf\22);\0a    }\0a    return \22nan\22;\0a  }\0a  if (mag << 1) == 0 {\0a    return __sgn(neg, \220.0\22);\0a  }\0a  let mut m: u64 = 0;\0a  let mut e: i64 = 0;\0a  if biased == 0 {\0a    m = mag & 4503599627370495;\0a    e = 0 - 1074;\0a  } else {\0a    m = (mag & 4503599627370495) | 4503599627370496;\0a    e = (biased as i64) - 1075;\0a  }\0a  let mut d: *Dec = __dec_new();\0a  __dec_set(d, m);\0a  let mut sc: i64 = 0;\0a  if e >= 0 {\0a    let mut k: i64 = e;\0a    while k >= 29 {\0a      __dec_mul_small(d, 536870912);\0a      k = k - 29;\0a    }\0a    if k > 0 {\0a      __dec_mul_small(d, __pow2s(k));\0a    }\0a  } else {\0a    let mut k: i64 = 0 - e;\0a    while k >= 12 {\0a      __dec_mul_small(d, 244140625);\0a      sc = sc + 12;\0a      k = k - 12;\0a    }\0a    if k > 0 {\0a      __dec_mul_small(d, __pow5s(k));\0a      sc = sc + k;\0a    }\0a  }\0a  let topd: i64 = __dec_top_digits(d);\0a  let mut n: i64 = (d.used - 1) * 9 + topd - sc;\0a  let cut: i64 = sc + n - prec;\0a  let mut qv: u64 = 0;\0a  if cut > 0 {\0a    let q: *Dec = __dec_split(d, cut);\0a    let mut c: i64 = __dec_cmp(d, __dec_half_of(cut));\0a    if c > 0 || (c == 0 && (q.limbs[0] & 1) == 1) {\0a      __dec_bump(q);\0a    }\0a    qv = __dec_to_u64(q);\0a  } else {\0a    if cut == 0 {\0a      qv = __dec_to_u64(d);\0a    } else {\0a      let mut k: i64 = 0 - cut;\0a      while k >= 9 {\0a        __dec_mul_small(d, 1000000000);\0a        k = k - 9;\0a      }\0a      if k > 0 {\0a        __dec_mul_small(d, __pow10(k) as i64);\0a      }\0a      qv = __dec_to_u64(d);\0a    }\0a  }\0a  let mut ds: string = format(\22{}\22, qv);\0a  if qv >= __pow10(prec) {\0a    qv = qv / 10;\0a    n = n + 1;\0a    ds = format(\22{}\22, qv);\0a  }\0a  let e10: i64 = n - 1;\0a  if e10 >= 0 - 4 && e10 < prec {\0a    if e10 >= 0 {\0a      let ip: i64 = e10 + 1;\0a      let frac: string = __drop_zeros(ds[ip..prec]);\0a      if len(frac) == 0 {\0a        return __sgn(neg, ds[0..ip]);\0a      }\0a      return __sgn(neg, ds[0..ip] + \22.\22 + frac);\0a    }\0a    let all: string = __drop_zeros(ds);\0a    if len(all) == 0 {\0a      return __sgn(neg, \220\22);\0a    }\0a    let mut pre: string = \220.\22;\0a    let mut j: i64 = (0 - e10) - 1;\0a    while j > 0 {\0a      pre = pre + \220\22;\0a      j = j - 1;\0a    }\0a    return __sgn(neg, pre + all);\0a  }\0a  let mut out: string = ds[0..1];\0a  let frac: string = __drop_zeros(ds[1..prec]);\0a  if len(frac) > 0 {\0a    out = out + \22.\22 + frac;\0a  }\0a  let mut ae: i64 = e10;\0a  if ae < 0 {\0a    ae = 0 - ae;\0a  }\0a  let mut es: string = format(\22{}\22, ae);\0a  if ae < 10 {\0a    es = \220\22 + es;\0a  }\0a  if e10 < 0 {\0a    return __sgn(neg, out + \22e-\22 + es);\0a  }\0a  return __sgn(neg, out + \22e+\22 + es);\0a}\0a\0a// integral floats keep a visible fraction (\224\22 reads as \224.0\22)\0afn __with_frac(s: string) -> string {\0a  if s == \22inf\22 || s == \22nan\22 || s == \22-inf\22 {\0a    return s;\0a  }\0a  let mut i: i64 = 0;\0a  while i < len(s) {\0a    if s[i] == 46 || s[i] == 101 {\0a      return s;\0a    }\0a    i = i + 1;\0a  }\0a  return s + \22.0\22;\0a}\0a\0afn __f64_text(bits: u64) -> string {\0a  return __with_frac(__dec_text(bits, 17));\0a}\0a\0afn __f32_text(bits: u64) -> string {\0a  return __with_frac(__dec_text(bits, 9));\0a}\0a")
  (data (i32.const 745296) "\0a  (func $w_alloc (param $n i32) (result i32)\0a    (local $p i32) (local $k i32) (local $old i32) (local $g i32)\0a    (if (i32.gt_u\0a          (i32.mul (i32.add (local.get $n) (i32.const 2))\0a                   (i32.const 8))\0a          (i32.sub (global.get $w_alloc_top) (global.get $w_floor)))\0a      (then\0a        ;; the request exceeds the room: grow, then carve ONLY the\0a        ;; fresh pages (the floor rises to the old end \e2\80\94 a downward\0a        ;; march from the new top must never reenter lived-in pages).\0a        ;; The room is judged as a DISTANCE \e2\80\94 testing the wrapped top\0a        ;; after the subtract once read a huge unsigned and skipped the\0a        ;; grow (the 4GiB-wrap class boot fixed in 0.4.1)\0a        (local.set $old (memory.size))\0a        (local.set $k\0a          (i32.add\0a            (i32.div_u\0a              (i32.add (i32.mul (i32.add (local.get $n) (i32.const 2))\0a                                (i32.const 8))\0a                       (i32.const 65536))\0a              (i32.const 65536))\0a            (i32.const 1)))\0a        ;; a refused grow (-1) must trap loudly: re-carving lived-in\0a        ;; pages would alias the heap and corrupt the data segments\0a        (local.set $g (memory.grow (local.get $k)))\0a        (if (i32.eq (local.get $g) (i32.const -1))\0a          (then unreachable))\0a        (global.set $w_floor\0a          (i32.mul (local.get $old) (i32.const 65536)))\0a        (global.set $w_alloc_top\0a          (i32.sub (i32.mul (memory.size) (i32.const 65536))\0a                   (i32.mul (i32.add (local.get $n) (i32.const 2))\0a                            (i32.const 8)))))\0a      (else\0a        (global.set $w_alloc_top\0a          (i32.sub (global.get $w_alloc_top)\0a                   (i32.mul (i32.add (local.get $n) (i32.const 2))\0a                            (i32.const 8))))))\0a    (local.set $p (global.get $w_alloc_top))\0a    ;; the two header slots sit before the returned pointer: the rc\0a    ;; stays at ptr-8 (every scope-exit release thunk and $w_retain\0a    ;; decrement that slot \e2\80\94 the counting law), the capacity in bytes\0a    ;; rides the new ptr-16 slot ($w_app's in-place-versus-fresh read)\0a    (i64.store (i32.add (local.get $p) (i32.const 8)) (i64.const 1))\0a    (i64.store (local.get $p)\0a               (i64.extend_i32_u\0a                 (i32.mul (local.get $n) (i32.const 8))))\0a    (local.set $k (i32.const 0))\0a    (loop $z\0a      (if (i32.lt_u (local.get $k) (local.get $n))\0a        (then\0a          (i64.store\0a            (i32.add (local.get $p)\0a                     (i32.mul (i32.add (local.get $k) (i32.const 2))\0a                              (i32.const 8)))\0a            (i64.const 0))\0a          (local.set $k (i32.add (local.get $k) (i32.const 1)))\0a          (br $z))))\0a    (i32.add (local.get $p) (i32.const 16))\0a  )\0a")
  (data (i32.const 748064) "\0a  (func $w_retain (param $p i64)\0a    ;; statics (data literals below the heap floor) are immortal \e2\80\94\0a    ;; the data region spans megabytes when the program is large\0a    ;; (the self-host chain was the witness: a blind rc bump wrote\0a    ;; into the preceding literal and the source pool rotted). The\0a    ;; line is $w_base \e2\80\94 the INITIAL floor \e2\80\94 never $w_floor: the\0a    ;; allocator's stop-line rises at every grow, and a guard on it\0a    ;; would immortalize every block below the new end (one n13\0a    ;; churn node survived exactly that way)\0a    (if (i64.ge_u (local.get $p)\0a                  (i64.extend_i32_u (global.get $w_base)))\0a      (then\0a        (if (i64.ne (local.get $p) (i64.const 0))\0a          (then\0a            (i64.store (i32.sub (i32.wrap_i64 (local.get $p)) (i32.const 8))\0a                       (i64.add\0a                         (i64.load (i32.sub (i32.wrap_i64 (local.get $p))\0a                                            (i32.const 8)))\0a                         (i64.const 1)))))))\0a  )\0a")
  (data (i32.const 749088) "\0a  (func $w_alive (param $p i64) (result i32)\0a    (if (i64.ne (local.get $p) (i64.const 0))\0a      (then\0a        (return (i32.wrap_i64\0a          (i64.load (i32.sub (i32.wrap_i64 (local.get $p))\0a                             (i32.const 8))))))\0a      (else (return (i32.const 0))))\0a    (i32.const 0)\0a  )\0a")
  (data (i32.const 749392) "\0a  ;; the amortized append (boot's rho_app law): x = x + t rides this \e2\80\94\0a  ;; in place when the block is unaliased (rc == 1), lives on the heap\0a  ;; (never a rodata literal: those sit below the floor) and its\0a  ;; capacity takes the tail; bytes beyond the old length are written,\0a  ;; so views into [0, len) stay verbatim. Otherwise a fresh\0a  ;; half-again block (geometric growth bounds a builder's total\0a  ;; allocation at ~3x its final size). Appends own no old ref: in\0a  ;; place the value grew, fresh the old block simply ages out.\0a  (func $w_app (param $ap i64) (param $al i64) (param $bp i64)\0a                (param $bl i64) (result i64) (result i64)\0a    (local $p i32) (local $i i64) (local $n i64)\0a    (if (i32.and\0a          (i64.ge_u (local.get $ap)\0a                    (i64.extend_i32_u (global.get $w_base)))\0a          (i32.and\0a            (i64.eq (i64.load (i32.sub (i32.wrap_i64 (local.get $ap))\0a                                       (i32.const 8)))\0a                    (i64.const 1))\0a            (i64.le_u (i64.add (local.get $al) (local.get $bl))\0a                      (i64.load (i32.sub (i32.wrap_i64 (local.get $ap))\0a                                         (i32.const 16))))))\0a      (then\0a        (local.set $i (i64.const 0))\0a        (loop $a1\0a          (if (i64.lt_u (local.get $i) (local.get $bl))\0a            (then\0a              (i32.store8\0a                (i32.add (i32.wrap_i64 (i64.add (local.get $ap)\0a                                                (local.get $al)))\0a                         (i32.wrap_i64 (local.get $i)))\0a                (i32.load8_u (i32.wrap_i64 (i64.add (local.get $bp)\0a                                                    (local.get $i)))))\0a              (local.set $i (i64.add (local.get $i) (i64.const 1)))\0a              (br $a1))))\0a        (local.get $ap)\0a        (local.get $al)\0a        (local.get $bl)\0a        (i64.add)\0a        (return)))\0a    (local.set $n (i64.add (local.get $al) (local.get $bl)))\0a    (local.set $p\0a      (call $w_alloc\0a        (i32.wrap_i64\0a          (i64.div_u\0a            (i64.add\0a              (i64.add (local.get $n)\0a                       (i64.div_u (local.get $n) (i64.const 2)))\0a              (i64.const 7))\0a            (i64.const 8)))))\0a    (local.set $i (i64.const 0))\0a    (loop $a2\0a      (if (i64.lt_u (local.get $i) (local.get $al))\0a        (then\0a          (i32.store8\0a            (i32.add (local.get $p) (i32.wrap_i64 (local.get $i)))\0a            (i32.load8_u (i32.wrap_i64 (i64.add (local.get $ap)\0a                                                (local.get $i)))))\0a          (local.set $i (i64.add (local.get $i) (i64.const 1)))\0a          (br $a2))))\0a    (local.set $i (i64.const 0))\0a    (loop $a3\0a      (if (i64.lt_u (local.get $i) (local.get $bl))\0a        (then\0a          (i32.store8\0a            (i32.add (i32.add (local.get $p)\0a                              (i32.wrap_i64 (local.get $al)))\0a                     (i32.wrap_i64 (local.get $i)))\0a            (i32.load8_u (i32.wrap_i64 (i64.add (local.get $bp)\0a                                                (local.get $i)))))\0a          (local.set $i (i64.add (local.get $i) (i64.const 1)))\0a          (br $a3))))\0a    (i64.extend_i32_u (local.get $p))\0a    (local.get $n)\0a  )\0a")
  (data (i32.const 752608) "\0a  (func $w_panic (param $m i32) (param $l i32)\0a    ;; the kernel law: \22panic: <msg>\5cn\22 to stderr, exit 101 \e2\80\94 three\0a    ;; one-iovec writes (wasmtime 40 drops trailing iovs); the prefix\0a    ;; is store8'd into scratch so the data section stays pool-owned\0a    (i32.store8 (i32.const 128) (i32.const 112))\0a    (i32.store8 (i32.const 129) (i32.const 97))\0a    (i32.store8 (i32.const 130) (i32.const 110))\0a    (i32.store8 (i32.const 131) (i32.const 105))\0a    (i32.store8 (i32.const 132) (i32.const 99))\0a    (i32.store8 (i32.const 133) (i32.const 58))\0a    (i32.store8 (i32.const 134) (i32.const 32))\0a    (i32.store (i32.const 64) (i32.const 128))\0a    (i32.store (i32.const 68) (i32.const 7))\0a    (drop (call $fd_write (i32.const 2) (i32.const 64)\0a                          (i32.const 1) (i32.const 96)))\0a    (i32.store (i32.const 64) (local.get $m))\0a    (i32.store (i32.const 68) (local.get $l))\0a    (drop (call $fd_write (i32.const 2) (i32.const 64)\0a                          (i32.const 1) (i32.const 96)))\0a    (i32.store8 (i32.const 135) (i32.const 10))\0a    (i32.store (i32.const 64) (i32.const 135))\0a    (i32.store (i32.const 68) (i32.const 1))\0a    (drop (call $fd_write (i32.const 2) (i32.const 64)\0a                          (i32.const 1) (i32.const 96)))\0a    (call $proc_exit (i32.const 101))\0a  )\0a")
