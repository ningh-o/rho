arse.lit(0);\0a          match a0.rhs {\0a            Option.Some(i6) => {\0a              idx6 = i6;\0a            },\0a            Option.None => {},\0a          }\0a          out6 = out6 + emit_expr(mut pool, idx6, mut env, mut prog,\0a                                  mut nl);\0a          out6 = out6 + \22    (local.set $t)\5cn\22;\0a          out6 = out6 + oob6;\0a          out6 = out6 + \22    (i64.load (i32.add (i32.add (i32.wrap_i64 \22 +\0a                 \22(local.get \22 + blk6.to_str() + \22))\5cn\22;\0a          out6 = out6 +\0a                 \22                     (i32.mul (i32.wrap_i64 (local.get \22 +\0a                 \22$t)) (i32.const 16))) (i32.const 8)))\5cn\22;\0a          return out6;\0a        }\0a      }\0a    }\0a    // len(p.field): a slice-typed struct field rides the pair\0a    // (addr, len) at consecutive slots \e2\80\94 the len load is the read\0a    if a0.tag == parse.EX_FIELD && a0.lhs != Option.None {\0a      let mut base: *Expr = parse.lit(0);\0a      match a0.lhs {\0a        Option.Some(b4) => {\0a          base = b4;\0a        },\0a        Option.None => {},\0a      }\0a      let bt4: string = field_base_type(base, env, mut prog);\0a      if len(bt4) > 0 {\0a        let si4: i64 = st_index(mut prog, st_name_of(bt4));\0a        let fi4: i64 = st_field_index(prog, si4, a0.name);\0a        if fi4 >= 0 {\0a          let fty4: string = prog.structs[si4 as usize].types[fi4 as usize];\0a          if len(fty4) >= 2 && fty4[0] == 91 && fty4[1] == 93 {\0a            let foff4: i64 = st_field_off(mut prog, si4, fi4);\0a            let bslot4: i64 = nl.v;\0a            nl.v = nl.v + 1;\0a            let mut out4: string = emit_expr(mut pool, base, mut env,\0a                                             mut prog, mut nl);\0a            out4 = out4 + \22    (local.set \22 + bslot4.to_str() + \22)\5cn\22 +\0a                   \22    (i64.load (i32.add (i32.wrap_i64 (local.get \22 +\0a                   bslot4.to_str() + \22)) (i32.const 