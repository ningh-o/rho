  (data (i32.const 760848) "\0a  ;; open under the preopen: the new fd, or -errno. Rights ride the\0a  ;; mode: READ (bit 1) or WRITE (bit 6); oflags CREAT|TRUNC (9) on\0a  ;; the write side.\0a  (func $w_path_open (param $pp i32) (param $pl i32) (param $mode i32)\0a    (result i32)\0a    (local $err i32) (local $oflags i32) (local $rights i64)\0a    (if (i32.eqz (local.get $mode))\0a      (then\0a        (local.set $oflags (i32.const 0))\0a        (local.set $rights (i64.const 2)))\0a      (else\0a        (local.set $oflags (i32.const 9))\0a        (local.set $rights (i64.const 64))))\0a    (local.set $err (call $path_open\0a      (i32.const 3) (i32.const 0)\0a      (local.get $pp) (local.get $pl)\0a      (local.get $oflags)\0a      (local.get $rights) (local.get $rights)\0a      (i32.const 0) (i32.const 8)))\0a    (if (i32.ne (local.get $err) (i32.const 0))\0a      (then (return (i32.sub (i32.const 0) (local.get $err)))))\0a    (i32.load (i32.const 8)))\0a")
