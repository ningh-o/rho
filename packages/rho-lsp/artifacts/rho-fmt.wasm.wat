, bx, mut env, mut prog,\0a                                   mut nl, as_expr, as_pair, optpt, scen);\0a  return chain_alts(mut pool, alts, 0, a, bx, mut env, mut prog, mut nl,\0a                    as_expr, as_pair, optpt, scen, rest);\0a}\0a\0a// one arm's alternatives folded into nested ifs: alternative j's test\0a// gates its binds and its body, its else carries the next\0a// alternative, and the last alternative's else carries the next arm\0a// (rest). A bare candidate resolves against the scrutinee's enum\0a// (\c2\a719) \e2\80\94 a name that is not a variant stays a binder taking the\0a// whole subject.\0afn chain_alts(mut pool: *Pool, alts: []*Pat, j: usize, a: *MatchArm,\0a              bx: i64, mut env: *Env, mut prog: *Prog, mut nl: *NextLocal,\0a              as_expr: bool, as_pair: bool, optpt: string, scen: string,\0a              rest: string) -> string {\0a  if j >= len(alts) {\0a    return rest;\0a  }\0a  let mut alt: *Pat = alts[j];\0a  let mut is_var: bool = false;\0a  let mut ename: string = \22\22;\0a  let mut vname: string = \22\22;\0a  let mut binder_subject: bool = false;\0a  if alt.kind == 2 {\0a    is_var = true;\0a    ename = alt.ename;\0a    vname = alt.vname;\0a    if len(ename) == 0 {\0a      ename = scen;\0a    }\0a  } else {\0a    if alt.kind == 3 {\0a      if len(scen) > 0 && scen_variant_tag(mut prog, scen, alt.name) >= 0 {\0a        is_var = true;\0a        ename = scen;\0a        vname = alt.name;\0a      } else {\0a        binder_subject = true;\0a      }\0a    }\0a  }\0a  let mut cond: string = \22\22;\0a  if alt.kind == 1 {\0a    cond = \22(i64.eq (local.get $d) (i64.const \22 + alt.lit.to_str() + \22))\22;\0a  } else {\0a    if is_var {\0a      cond = var_tag_cond(ename, vname, mut prog);\0a    }\0a  }\0a  // the payload types: Option/Result ride the runtime's\0a  // single-payload convention (the sbind law keys on ename/vname/\0a  // optpt \e2\80\94 Err's string error is the idiom its boxes carry); user\0a  // enums read the variant's declared payload types\0a  let mut ptys: []string = make([]string, 0);\0a  if is_var {\0a    if ename == \22Option\22 || ename == \22Result\22 {\0a      ptys = make([]string, 1);\0a      ptys[0] = \22\22;\0a    } else {\0a      ptys = enum_variant_ptys(mut prog, ename, vname);\0a    }\0a  }\0a  // the arm's code: binders load from the box (a *T payload binds as\0a  // a struct pointer \e2\80\94 its fields stay reachable); a literal payload\0a  // pins the value, not just the tag (the first Some(3) arm once\0a  // swallowed its tag-mates on the tag-only test); a nested variant\0a  // digs into the inner box\0a  let mut armcode: string = \22\22;\0a  let mut pin: string = \22\22;\0a  if is_var {\0a    let bp = bind_payload(mut pool, alt.subs, alt.vop, alt.fnames, ptys,\0a                          ename, vname, optpt,\0a                          \22(local.get \22 + bx.to_str() + \22)\22, 1,\0a                          mut env, mut prog, mut nl);\0a    armcode = bp.code;\0a    pin = bp.pin;\0a  } else {\0a    if binder_subject {\0a      // a bare binder takes the whole subject (boot's NT_PBIND): the\0a      // box address for enum-ish scrutinees, the value for scalars \e2\80\94\0a      // the env lanes follow the scrutinee's shape\0a      if len(scen) > 0 {\0a        env_bind_enum(mut env, alt.name, bx, scen);\0a        if len(optpt) > 0 {\0a          env_bind_sliceelem(mut env, alt.name, optpt);\0a        }\0a      } else {\0a        env_bind(mut env, alt.name, bx);\0a      }\0a    }\0a  }\0a  if len(pin) > 0 {\0a    if len(cond) > 0 {\0a      cond = \22(i32.and \22 + cond + \22 \22 + pin + \22)\22;\0a    } else {\0a      cond = pin;\0a    }\0a  }\0a  let nextalt: string = chain_alts(mut pool, alts, j + 1, a, bx, mut env,\0a                                   mut prog, mut nl, as_expr, as_pair,\0a                                   optpt, scen, rest);\0a  let bodytext: string = arm_body(mut pool, a, mut env, mut prog, mut nl,\0a                                  as_expr, as_pair);\0a  let mut drops: string = \22\22;\0a  if !as_expr {\0a    drops = \22    drop\5cn\22;\0a    if as_pair {\0a      drops = \22    drop\5cn    drop\5cn\22;\0a    }\0a  }\0a  let mut res: string = \22\22;\0a  if as_expr {\0a    if as_pair {\0a      res = \22(result i64) (result i64) \22;\0a    } else {\0a      res = \22(result i64) \22;\0a    }\0a  }\0a  // the \c2\a719 guard: evaluated after the pattern matches, in scope of\0a  // its bindings; a failed guard falls through to the next\0a  // alternative or arm (boot's matched-flag semantics ride the else)\0a  let mut guardpart: string = \22\22;\0a  match a.guard {\0a    Option.Some(g) => {\0a      let gres: string = emit_expr(mut pool, g, mut env, mut prog, mut nl) +\0a                         \22    (i32.wrap_i64)\5cn\22;\0a      guardpart = gres + \22    (if \22 + res + \22(then\5cn\22 + bodytext + drops +\0a                  \22      )\5cn      (else\5cn\22 + nextalt + \22      ))\5cn\22;\0a    },\0a    Option.None => {},\0a  }\0a  if len(cond) == 0 {\0a    // the wildcard / binder-subject arm closes the chain \e2\80\94 except a\0a    // guard keeps the fall-through alive\0a    if len(guardpart) > 0 {\0a      return armcode + guardpart;\0a    }\0a    return armcode + bodytext + drops;\0a  }\0a  if len(guardpart) > 0 {\0a    return \22    (if \22 + res + cond + \22\5cn\22 +\0a           \22      (then\5cn\22 + armcode + guardpart + \22      )\5cn\22 +\0a           \22      (else\5cn\22 + nextalt + \22      ))\5cn\22;\0a  }\0a  if as_expr {\0a    return \22    (if \22 + res + cond + \22\5cn\22 +\0a           \22      (then\5cn\22 + armcode + bodytext + \22      )\5cn\22 +\0a           \22      (else\5cn\22 + nextalt + \22      ))\5cn\22;\0a  }\0a  return \22    (if \22 + cond + \22\5cn\22 +\0a         \22      (then\5cn\22 + armcode + bodytext + drops + \22      )\5cn\22 +\0a         \22      (else\5cn\22 + nextalt + \22      ))\5cn\22;\0a}\0a\0a// the arm's statements plus its tail expression (an expression match\0a// rides the tail; the statement form keeps the tail's effects and the\0a// caller drops its value)\0afn arm_body(mut pool: *Pool, a: *MatchArm, mut env: *Env, mut prog: *Prog,\0a            mut nl: *NextLocal, as_expr: bool, as_pair: bool) -> string {\0a  let mut t: string = emit_stmts(a.body, mut pool, mut env, mut nl, env.infn,\0a                                 env.retslot, mut prog, mut env.loops,mut \0a                                 env.dstack, env.tfd);\0a  let mut tail: string = \22    (i64.const 0)\5cn\22;\0a  if as_pair {\0a    tail = \22    (i64.const 0)\5cn    (i64.const 0)\5cn\22;\0a  }\0a  match a.val {\0a    Option.Some(v) => {\0a      if as_pair {\0a        // a pair tail builds through the full pair machinery \e2\80\94 a\0a        // format call or a concat is as arm-worthy as a literal\0a        let spt2 = build_string_pair(v, mut pool, mut env, mut prog, mut nl);\0a        if spt2.ok {\0a          tail = spt2.text +\0a                 \22    (local.get \22 + spt2.a.to_str() + \22)\5cn\22 +\0a                 \22    (local.get \22 + spt2.l.to_str() + \22)\5cn\22;\0a        } else {\0a          tail = push_string(mut pool, v, mut env, mut prog, mut nl);\0a        }\0a      } else {\0a        tail = emit_expr(mut pool, v, mut env, mut prog, mut nl);\0a      }\0a    },\0a    Option.None => {},\0a  }\0a  return t + tail;\0a}\0a\0a// one payload sub-pattern layer: binders load from the box slots (the\0a// registration cascade keyed on the payload type), literals pin the\0a// slot's value, a nested variant digs into the inner box. base = the\0a// i64 address expression the slots read; sl0 = the slot cursor (the\0a// tag rides slot 0). Returns the accumulated bind code and pin.\0afn bind_payload(mut pool: *Pool, subs: []*Pat, vop: i32, fnames: []string,\0a                ptys: []string, ename: string, vname: string, optpt: string,\0a                base: string, sl0: i64, mut env: *Env, mut prog: *Prog,\0a                mut nl: *NextLocal) -> *BindOut {\0a  let mut out = new BindOut { code: \22\22, pin: \22\22 };\0a  // the struct-payload field order: subs ride the source's field\0a  // names \e2\80\94 map each to its position in the variant's declared fields\0a  // (vnpool, 8 slots per variant) so `{ h: hh, w: ww }` reads the\0a  // right slots\0a  let mut ei: i64 = 0 - 1;\0a  let mut vi: i64 = 0 - 1;\0a  if vop == 2 && len(prog.enums) > 0 {\0a    ei = en_index(mut prog, ename);\0a    if ei >= 0 {\0a      vi = en_vtag(prog, ei, vname);\0a    }\0a  }\0a  let mut sl: i64 = sl0;\0a  let mut k: usize = 0;\0a  while k < len(subs) {\0a    let mut pty: string = \22\22;\0a    if k < len(ptys) {\0a      pty = ptys[k];\0a    }\0a    if vop == 2 && vi >= 0 && k < len(fnames) {\0a      let mut f: usize = 0;\0a      while f < 8 {\0a        let fnm: string =\0a            prog.enums[(ei as usize)].vnpool[((vi as usize) * 8) + f];\0a        if len(fnm) == 0 {\0a          break;\0a        }\0a        if fnm == fnames[k] {\0a          let pj: usize = ((vi as usize) * 8) + f;\0a          let vb: usize = (vi as usize) * 8;\0a          if pj - vb < len(ptys) {\0a            pty = ptys[pj - vb];\0a          }\0a          break;\0a        }\0a        f = f + 1;\0a      }\0a    }\0a    let sub = subs[k];\0a    let mut w: i64 = 1;\0a    let sbind: bool = pty == \22string\22 ||\0a        (ename == \22Result\22 && vname == \22Err\22) ||\0a        ((ename == \22Option\22 || ename == \22Result\22) && optpt == \22string\22);\0a    if sbind {\0a      w = 2;\0a    }\0a    if sub.kind == 0 {\0a      sl = sl + w;\0a      k = k + 1;\0a      continue;\0a    }\0a    if sub.kind == 1 {\0a      // a literal payload pins the value, not just the tag\0a      let sv: string = \22(i64.load (i32.add (i32.wrap_i64 \22 + base +\0a                       \22) (i32.const \22 + (sl * 8).to_str() + \22)))\22;\0a      let mut pw: string = \22\22;\0a      if sub.lop == 0 {\0a        pw = \22(i64.eq \22 + sv + \22 (i64.const \22 + sub.lit.to_str() + \22))\22;\0a      } else {\0a        if sub.lop == 2 {\0a          // the bool words spell the lane (bval marks it); the VALUE\0a          // rides lit 0/1 \e2\80\94 reading bval here once pinned both arms\0a          // to 1 and the first Some(bool) arm swallowed its tag-mate\0a          // (n26's law, reborn through the rewrite)\0a          pw = \22(i64.eq \22 + sv + \22 (i64.const \22 + sub.lit.to_str() + \22))\22;\0a        } else {\0a          if sub.lop == 3 && sbind {\0a            // the string pair rides slots sl (addr) and sl+1 (len);\0a            // the literal interns into the data image once\0a            let di: i64 = pool_intern(mut pool, sub.sval);\0a            let dl: i64 = pool_len(pool, sub.sval);\0a            pw = \22(i32.and (i64.eq \22 + sv + \22 (i64.const \22 +\0a                 di.to_str() + \22)) (i64.eq (i64.load (i32.add \22 +\0a                 \22(i32.wrap_i64 \22 + base + \22) (i32.const \22 +\0a                 ((sl + 1) * 8).to_str() + \22))) (i64.const \22 +\0a                 dl.to_str() + \22)))\22;\0a          } else {\0a            if sub.lop == 1 {\0a              pw = \22(f64.eq (f64.reinterpret_i64 \22 + sv +\0a                   \22) (f64.const \22 + sub.ftext + \22))\22;\0a            } else {\0a              // a string literal over a non-pair payload cannot match\0a              pw = \22(i32.const 0)\22;\0a            }\0a          }\0a        }\0a      }\0a      if len(out.pin) > 0 {\0a        out.pin = \22(i32.and \22 + out.pin + \22 \22 + pw + \22)\22;\0a      } else {\0a        out.pin = pw;\0a      }\0a      sl = sl + w;\0a      k = k + 1;\0a      continue;\0a    }\0a    if sub.kind == 3 {\0a      // a binder: load the slot, register the env lanes by type\0a      if sbind {\0a        let ba: i64 = nl.v;\0a        let bl: i64 = nl.v + 1;\0a        nl.v = nl.v + 2;\0a        out.code = out.code + \22    (i64.load (i32.add (i32.wrap_i64 \22 +\0a                   base + \22) (i32.const \22 + (sl * 8).to_str() + \22)))\5cn\22;\0a        out.code = out.code + \22    (local.set \22 + ba.to_str() + \22)\5cn\22;\0a        out.code = out.code + \22    (i64.load (i32.add (i32.wrap_i64 \22 +\0a                   base + \22) (i32.const \22 + ((sl + 1) * 8).to_str() +\0a                   \22)))\5cn\22;\0a        out.code = out.code + \22    (local.set \22 + bl.to_str() + \22)\5cn\22;\0a        env_str_bind_runtime(mut env, sub.name, ba, bl, 1);\0a      } else {\0a        let bslot: i64 = nl.v;\0a        nl.v = nl.v + 1;\0a        out.code = out.code + \22    (i64.load (i32.add (i32.wrap_i64 \22 +\0a                   base + \22) (i32.const \22 + (sl * 8).to_str() + \22)))\5cn\22;\0a        out.code = out.code + \22    (local.set \22 + bslot.to_str() + \22)\5cn\22;\0a        let ptgt: string = type_ptr_target(pty);\0a        if len(ptgt) > 0 && st_index(mut prog, ptgt) >= 0 {\0a          env_bind_ptr(mut env, sub.name, bslot, ptgt);\0a        } else {\0a          if pty == \22f64\22 || pty == \22f32\22 {\0a            let mut fk2: i64 = 1;\0a            if pty == \22f32\22 {\0a              fk2 = 2;\0a            }\0a            env_bind_f(mut env, sub.name, bslot, fk2);\0a          } else {\0a            if (ename == \22Option\22 || ename == \22Result\22) &&\0a                len(optpt) > 0 &&\0a                st_index(mut prog, st_name_of(optpt)) >= 0 {\0a              // a Some/Ok binder over a *T element: the pointer lane\0a              // keeps its fields reachable\0a              env_bind_ptr(mut env, sub.name, bslot, optpt);\0a            } else {\0a              // an enum-ish builtin payload \e2\80\94 ?T sugar over a\0a              // non-struct, or a spelled Option/Result: the binder\0a              // holds the option box's address, so its enum name AND\0a              // payload text must register or the inner match reads\0a              // the address as the tag\0a              if (ename == \22Option\22 || ename == \22Result\22) &&\0a                  len(optpt) > 0 &&\0a                  st_index(mut prog, st_name_of(optpt)) < 0 &&\0a                  (optpt[0] == 63 || starts_open(optpt, \22Option\22) ||\0a                   starts_open(optpt, \22Result\22)) {\0a                let mut ben: string = \22Option\22;\0a                if optpt[0] != 63 && starts_open(optpt, \22Result\22) {\0a                  ben = \22Result\22;\0a                }\0a                env_bind_enum(mut env, sub.name, bslot, ben);\0a                let mut bpay: string = optpt[1..len(optpt)];\0a                if optpt[0] != 63 {\0a                  let ob2: i64 = open_bracket(optpt);\0a                  if ob2 >= 0 {\0a                    let tas2: []string = split_type_args(\0a                        optpt[((ob2 as usize) + 1)..(len(optpt) - 1)]);\0a                    if len(tas2) > 0 {\0a                      bpay = tas2[0];\0a                    }\0a                  }\0a                }\0a                if len(bpay) > 0 {\0a                  env_bind_sliceelem(mut env, sub.name, bpay);\0a                }\0a              } else {\0a                if optpt == \22bool\22 {\0a                  // a bool payload binder records its type \e2\80\94 the hole\0a                  // classifiers read it to spell true/false\0a                  env_bool_bind(mut env, sub.name);\0a                }\0a                env_bind(mut env, sub.name, bslot);\0a              }\0a            }\0a          }\0a        }\0a      }\0a      sl = sl + w;\0a      k = k + 1;\0a      continue;\0a    }\0a    if sub.kind == 2 {\0a      // a nested variant digs into the inner box: an enum-typed\0a      // payload slot holds the inner box's address, the pin tests its\0a      // tag word, the subs recurse against the inner payload types\0a      let mut sub_en: string = sub.ename;\0a      if len(sub_en) == 0 {\0a        if len(pty) > 0 && pty[0] == 63 {\0a          sub_en = \22Option\22;\0a        } else {\0a          if starts_open(pty, \22Option\22) || starts_open(pty, \22Result\22) {\0a            let ob3: i64 = open_bracket(pty);\0a            if ob3 > 0 {\0a              sub_en = pty[0..(ob3 as usize)];\0a            }\0a          } else {\0a            sub_en = pty;\0a          }\0a        }\0a      }\0a      let stag: i64 = scen_variant_tag(mut prog, sub_en, sub.vname);\0a      if stag >= 0 {\0a        let sv2: string = \22(i64.load (i32.add (i32.wrap_i64 \22 + base +\0a                          \22) (i32.const \22 + (sl * 8).to_str() + \22)))\22;\0a        let pw2: string = \22(i64.eq (i64.load (i32.wrap_i64 \22 + sv2 +\0a                          \22)) (i64.const \22 + stag.to_str() + \22))\22;\0a        if len(out.pin) > 0 {\0a          out.pin = \22(i32.and \22 + out.pin + \22 \22 + pw2 + \22)\22;\0a        } else {\0a          out.pin = pw2;\0a        }\0a        let sptys: []string = enum_variant_ptys(mut prog, sub_en, sub.vname);\0a        let inner = bind_payload(mut pool, sub.subs, sub.vop, sub.fnames,\0a                                 sptys, sub_en, sub.vname, \22\22, sv2, 1,\0a                                 mut env, mut prog, mut nl);\0a        out.code = out.code + inner.code;\0a        if len(inner.pin) > 0 {\0a          out.pin = \22(i32.and \22 + out.pin + \22 \22 + inner.pin + \22)\22;\0a        }\0a      }\0a      sl = sl + w;\0a      k = k + 1;\0a      continue;\0a    }\0a    sl = sl + w;\0a    k = k + 1;\0a  }\0a  return out;\0a}\0a\0a// the scrutinee's variant tag for a bare name (\c2\a719's resolution\0a// table): Option/Result ride the runtime's own tags, user enums their\0a// declared order; -1 = not a variant of this enum\0afn scen_variant_tag(mut prog: *Prog, scen: string, name: string) -> i64 {\0a  if scen == \22Option\22 {\0a    if name == \22Some\22 {\0a      return 1;\0a    }\0a    if name == \22None\22 {\0a      return 0;\0a    }\0a    return 0 - 1;\0a  }\0a  if scen == \22Result\22 {\0a    if name == \22Ok\22 {\0a      return 1;\0a    }\0a    if name == \22Err\22 {\0a      return 2;\0a    }\0a    return 0 - 1;\0a  }\0a  let ei: i64 = en_index(mut prog, scen);\0a  if ei < 0 {\0a    return 0 - 1;\0a  }\0a  return en_vtag(prog, ei, name);\0a}\0a\0a// a qualified const's folded value, -1 when absent (tags are >= 0,\0a// so -1 reads as \22this arm can never match\22)\0afn const_i64(mut prog: *Prog, qname: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < prog.nconsts {\0a    if prog.consts[i] == qname {\0a      return prog.cvals[i];\0a    }\0a    i = i + 1;\0a  }\0a  return 0 - 1;\0a}\0a\0a// one resolved variant alternative's discriminator condition text:\0a// the tag local rides $d for enum scrutinees, the value itself for\0a// scalars. A qualified const's folded value rides the consts table\0a// (-1 reads as \22this arm can never match\22).\0afn var_tag_cond(ename: string, vname: string, mut prog: *Prog) -> string {\0a  let mut tag: i64 = 0;\0a  if ename == \22Option\22 || ename == \22Result\22 {\0a    if vname == \22Some\22 || vname == \22Ok\22 {\0a      tag = 1;\0a    } else {\0a      if ename == \22Result\22 {\0a        tag = 2;\0a      } else {\0a        tag = 0;\0a      }\0a    }\0a  } else {\0a    let ei: i64 = en_index(mut prog, ename);\0a    if ei >= 0 {\0a      tag = en_vtag(prog, ei, vname);\0a    } else {\0a      // a module-qualified CONST pattern (match e.tag {\0a      // parse.EX_VAR => ... }): the comparison constant rides the\0a      // consts table's qualified entry \e2\80\94 en_index(\22parse\22) is -1 and\0a      // the tag once folded to -1, killing every arm after it\0a      tag = const_i64(mut prog, ename + \22.\22 + vname);\0a    }\0a  }\0a  return \22(i64.eq (local.get $d) (i64.const \22 + tag.to_str() + \22))\22;\0a}\0a\0a// a fresh slice literal: n zeroed slots, each element stored in\0a\0a// a fresh slice literal: n zeroed slots, each element stored in\0a// order \e2\80\94 leaves the {addr, len} pair on the stack\0afn emit_array(mut pool: *Pool, e: *Expr, mut env: *Env, mut prog: *Prog,\0a              mut nl: *NextLocal) -> string {\0a  // the element stride: a string element rides its pair at 16 bytes;\0a  // scalars and pointers stay at 8\0a  let mut sarr: bool = false;\0a  let mut k0: usize = 0;\0a  while k0 < len(e.args) {\0a    if is_stringy(e.args[k0], env, mut prog) {\0a      sarr = true;\0a    }\0a    k0 = k0 + 1;\0a  }\0a  let mut esz: i64 = 8;\0a  if sarr {\0a    esz = 16;\0a  }\0a  let a_slot: i64 = nl.v;\0a  let l_slot: i64 = nl.v + 1;\0a  nl.v = nl.v + 2;\0a  let mut out: string = \22    (i64.extend_i32_u (call $w_alloc (i32.const \22 +\0a         ((len(e.args) as i64) * esz / 8).to_str() + \22)))\5cn\22 +\0a         \22    (local.set \22 + a_slot.to_str() + \22)\5cn\22 +\0a         \22    (i64.const \22 + (len(e.args) as i64).to_str() + \22)\5cn\22 +\0a         \22    (local.set \22 + l_slot.to_str() + \22)\5cn\22;\0a  let mut k: usize = 0;\0a  while k < len(e.args) {\0a    if sarr {\0a      // the element's pair stores slot-by-slot (addr at k*16, its\0a      // length at k*16 + 8)\0a      let sp2 = build_string_pair(e.args[k], mut pool, mut env,\0a                                  mut prog, mut nl);\0a      if sp2.ok {\0a        out = out + sp2.text;\0a        out = out + \22    (i64.store (i32.add (i32.wrap_i64 (local.get \22;\0a        out = out + a_slot.to_str();\0a        out = out + \22)) (i32.const \22;\0a        out = out + ((k as i64) * 16).to_str();\0a        out = out + \22)) (local.get \22;\0a        out = out + sp2.a.to_str();\0a        out = out + \22))\5cn\22;\0a        out = out + \22    (i64.store (i32.add (i32.add (i32.wrap_i64 \22;\0a        out = out + \22(local.get \22;\0a        out = out + a_slot.to_str();\0a        out = out + \22)) (i32.const \22;\0a        out = out + ((k as i64) * 16).to_str();\0a        out = out + \22)) (i32.const 8)) (local.get \22;\0a        out = out + sp2.l.to_str();\0a        out = out + \22))\5cn\22;\0a      }\0a    } else {\0a      let tv: i64 = nl.v;\0a      nl.v = nl.v + 1;\0a      out = out + emit_expr(mut pool, e.args[k], mut env, mut prog, mut nl);\0a      out = out + \22    (local.set \22;\0a      out = out + tv.to_str();\0a      out = out + \22)\5cn\22;\0a      out = out + \22    (i64.store (i32.add (i32.wrap_i64 (local.get \22;\0a      out = out + a_slot.to_str();\0a      out = out + \22)) (i32.const \22;\0a      out = out + (k * 8).to_str();\0a      out = out + \22)) (local.get \22;\0a      out = out + tv.to_str();\0a      out = out + \22))\5cn\22;\0a    }\0a    k = k + 1;\0a  }\0a  out = out + \22    (local.get \22;\0a  out = out + a_slot.to_str();\0a  out = out + \22)\5cn\22;\0a  out = out + \22    (local.get \22;\0a  out = out + l_slot.to_str();\0a  out = out + \22)\5cn\22;\0a  return out;\0a}\0a\0a// the defer context: one frame per open scope, texts collected as\0a// the walk meets them; exits run them innermost-first (LIFO)\0astruct DStack {\0a  texts: []string, // the flat pool\0a  starts: []usize, // frame boundaries\0a  n: usize,        // open frames\0a  cursor: usize,   // texts used\0a  rtexts: []string, // scope-exit release texts (parallel pool)\0a  rnames: []string, // the binding each release owns (a return skips it)\0a  rstart: usize,    // the release pool's cursor\0a  rframe: []usize,  // release-pool frame boundaries\0a}\0a\0afn dstack_new() -> *DStack {\0a  return new DStack { texts: make([]string, 256), starts: make([]usize, 64),\0a                      n: 0, cursor: 0,\0a                      rtexts: make([]string, 128),\0a                      rnames: make([]string, 128), rstart: 0,\0a                      rframe: make([]usize, 64) };\0a}\0a\0afn dpush(mut d: *DStack) {\0a  d.starts[d.n] = d.cursor;\0a  d.rframe[d.n] = d.rstart;\0a  d.n = d.n + 1;\0a}\0a\0a// register a scope-owned binding's release (emitted at scope exit in\0a// registration order \e2\80\94 inner lets die after outer materializations)\0afn drel_push(mut d: *DStack, name: string, text: string) {\0a  if d.rstart < len(d.rtexts) {\0a    d.rtexts[d.rstart] = text;\0a    d.rnames[d.rstart] = name;\0a    d.rstart = d.rstart + 1;\0a  }\0a}\0a\0a// the scope's releases, then its defers LIFO, then the frame closes\0afn dpop_emit(mut d: *DStack) -> string {\0a  let mut out: string = \22\22;\0a  if d.n == 0 {\0a    return out; // a return already unwound every frame\0a  }\0a  let rbase: usize = d.rframe[d.n - 1];\0a  while d.rstart > rbase {\0a    d.rstart = d.rstart - 1;\0a    out = out + d.rtexts[d.rstart];\0a  }\0a  let base: usize = d.starts[d.n - 1];\0a  while d.cursor > base {\0a    d.cursor = d.cursor - 1;\0a    out = out + d.texts[d.cursor];\0a  }\0a  d.n = d.n - 1;\0a  return out;\0a}\0a\0a// a break/continue exits every frame down to (and including) the\0a// loop's body frame: emit those texts WITHOUT consuming \e2\80\94 the normal\0a// exit path still runs the frame-end copies\0afn dpeek_emit_to(d: *DStack, n_from: usize) -> string {\0a  let mut out: string = \22\22;\0a  if n_from >= d.n {\0a    return out;\0a  }\0a  // the releases ride with the defers: each frame's releases then its\0a  // defer texts, all WITHOUT consuming (the normal exit path still\0a  // runs them)\0a  let mut f: usize = d.n;\0a  while f > n_from {\0a    let rbase: usize = d.rframe[f - 1];\0a    let mut r: usize = d.rstart;\0a    while r > rbase {\0a      r = r - 1;\0a      out = out + d.rtexts[r];\0a    }\0a    let base: usize = d.starts[f - 1];\0a    let mut c: usize = d.cursor;\0a    if f == d.n {\0a      c = d.cursor;\0a    } else {\0a      c = d.starts[f];\0a    }\0a    while c > base {\0a      c = c - 1;\0a      out = out + d.texts[c];\0a    }\0a    f = f - 1;\0a  }\0a  return out;\0a}\0a\0a// a return unwinds every open frame of the function, LIFO across\0a// all; the returned binding's own release is skipped (the value\0a// moves out with its count intact)\0afn dunwind_emit_skip(mut d: *DStack, skip: string) -> string {\0a  let mut out: string = \22\22;\0a  while d.n > 0 {\0a    let rbase: usize = d.rframe[d.n - 1];\0a    while d.rstart > rbase {\0a      d.rstart = d.rstart - 1;\0a      if d.rnames[d.rstart] != skip {\0a        out = out + d.rtexts[d.rstart];\0a      }\0a    }\0a    let base: usize = d.starts[d.n - 1];\0a    while d.cursor > base {\0a      d.cursor = d.cursor - 1;\0a      out = out + d.texts[d.cursor];\0a    }\0a    d.n = d.n - 1;\0a  }\0a  return out;\0a}\0a\0afn dunwind_emit(mut d: *DStack) -> string {\0a  return dunwind_emit_skip(mut d, \22 \22);\0a}\0a\0a// the loop-label context: every loop gets unique wasm labels; the\0a// stack holds the enclosing loops so plain jumps hit the innermost\0a// and named jumps resolve to their labeled loop\0astruct Loops {\0a  names: []string,\0a  bks: []string,\0a  ws: []string,\0a  ddepths: []usize, // the dstack depth at each loop statement\0a  n: usize,\0a  next_id: i64,\0a}\0a\0afn loops_new() -> *Loops {\0a  return new Loops { names: make([]string, 32), bks: make([]string, 32),\0a                     ws: make([]string, 32), ddepths: make([]usize, 32),\0a                     n: 0, next_id: 0 };\0a}\0a\0afn loops_push_with(mut l: *Loops, name: string, bk: string, w: string,\0a                   d: *DStack) {\0a  l.names[l.n] = name;\0a  l.bks[l.n] = bk;\0a  l.ws[l.n] = w;\0a  l.ddepths[l.n] = d.n; // frames above this base exit at a jump\0a  l.n = l.n + 1;\0a}\0a\0afn loops_pop(mut l: *Loops) {\0a  if l.n > 0 {\0a    l.n = l.n - 1;\0a  }\0a}\0a\0a// the loop-stack index a jump targets (innermost when unnamed)\0afn loops_index(l: *Loops, name: string) -> usize {\0a  if len(name) == 0 {\0a    if l.n == 0 {\0a      return 32; // out of range: no enclosing loop\0a    }\0a    return l.n - 1;\0a  }\0a  let mut i: usize = l.n;\0a  while i > 0 {\0a    if l.names[i - 1] == name {\0a      return i - 1;\0a    }\0a    i = i - 1;\0a  }\0a  return 32;\0a}\0a\0a// the break (block) label for a jump: named resolves to the labeled\0a// loop, plain to the innermost\0afn loops_break(l: *Loops, name: string) -> string {\0a  if len(name) == 0 {\0a    return l.bks[l.n - 1];\0a  }\0a  let mut i: usize = l.n;\0a  while i > 0 {\0a    if l.names[i - 1] == name {\0a      return l.bks[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return \22$b?\22;\0a}\0a\0afn loops_cont(l: *Loops, name: string) -> string {\0a  if len(name) == 0 {\0a    return l.ws[l.n - 1];\0a  }\0a  let mut i: usize = l.n;\0a  while i > 0 {\0a    if l.names[i - 1] == name {\0a      return l.ws[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return \22$w?\22;\0a}\0a\0a// a built string pair: code text plus the two fresh locals holding\0a// {addr, len}; ok=false when the expression is not string-buildable\0astruct SPair {\0a  ok: bool,\0a  text: string,\0a  a: i64,\0a  l: i64,\0a}\0a\0afn user_fn_exists(prog: *Prog, name: string) -> bool {\0a  let mut i: usize = 0;\0a  while i < len(prog.fns) {\0a    if prog.fns[i].name == name {\0a      return true;\0a    }\0a    i = i + 1;\0a  }\0a  return false;\0a}\0a\0afn rtype_is_pair(rt: string) -> bool {\0a  if rt == \22string\22 || (len(rt) >= 2 && rt[0] == 91 && rt[1] == 93) {\0a    return true;\0a  }\0a  // a fn-typed return rides its (idx, box) pair\0a  return len(rt) >= 2 && rt[0] == 102 && rt[1] == 110;\0a}\0a\0afn build_string_pair(e: *Expr, mut pool: *Pool, mut env: *Env, mut prog: *Prog,\0a                     mut nl: *NextLocal) -> *SPair {\0a  let mut bad = new SPair { ok: false, text: \22\22, a: 0, l: 0 };\0a  if e.tag == parse.EX_CALL && e.name == \22__string_from\22 &&\0a      len(e.args) == 2 {\0a    // std.io's window-to-string builtin: the pair face parks the\0a    // fresh block's (addr,len) \e2\80\94 the string-let path binds it, the\0a    // scalar lane rides the address alone\0a    pool.has_io = true;\0a    let nsl: i64 = nl.v;\0a    nl.v = nl.v + 1;\0a    let sfa: i64 = nl.v;\0a    let sfl: i64 = nl.v + 1;\0a    nl.v = nl.v + 2;\0a    let mut tio: string = \22\22;\0a    let bp = build_string_pair(e.args[0], mut pool, mut env, mut prog,\0a                               mut nl);\0a    tio = tio + bp.text;\0a    tio = tio + emit_expr(m