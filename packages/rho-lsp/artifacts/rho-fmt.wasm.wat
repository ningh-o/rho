g.name);\0a    vbox = (0 - a0) - 1;\0a    obj = env_str_len_slot(env, arg.name);\0a  } else {\0a    if arg.tag == parse.EX_MCALL {\0a      // a method call on a dyn receiver: the dispatch's own result\0a      // is the hole's value (string rides its parked pair; a scalar\0a      // renders through the int/bool text)\0a      let mut rv9: *Expr = parse.lit(0);\0a      match arg.lhs {\0a        Option.Some(r9b) => {\0a          rv9 = r9b;\0a        },\0a        Option.None => {},\0a      }\0a      let mut recv_dyn: bool = false;\0a      if rv9.tag == parse.EX_VAR &&\0a          is_dyn_type(env_slice_elemtext(env, rv9.name)) {\0a        recv_dyn = true;\0a        trt = dyn_trait(env_slice_elemtext(env, rv9.name));\0a      }\0a      if !recv_dyn &&\0a          (rv9.tag == parse.EX_FIELD || rv9.tag == parse.EX_IDX) {\0a        // the receiver itself is a dyn field read or element read:\0a        // load the fat pair, then dispatch through it\0a        let vt9: string = dyn_recv_trait(rv9, mut env, mut prog);\0a        if len(vt9) > 0 {\0a          let ld9: string = dyn_pair_load(rv9, mut pool, mut env, mut prog, mut nl);\0a          if len(ld9) > 0 {\0a            trt = vt9;\0a            vbox = nl.v - 2;\0a            obj = nl.v - 1;\0a            pre = pre + ld9;\0a            loaded = true;\0a          }\0a        }\0a      }\0a      if len(trt) > 0 {\0a        // the declared return picks the rendering shape\0a        let mut rtype9: string = \22i64\22;\0a        let mut t9: usize = 0;\0a        while t9 < prog.ntraits {\0a          if prog.traits[t9].name == trt {\0a            let mut m9: usize = 0;\0a            while m9 < prog.traits[t9].nmethods {\0a              if prog.traits[t9].methods[m9] == arg.name &&\0a                  m9 < len(prog.traits[t9].rtypes) {\0a                rtype9 = prog.traits[t9].rtypes[m9];\0a              }\0a              m9 = m9 + 1;\0a            }\0a          }\0a          t9 = t9 + 1;\0a        }\0a        if loaded {\0a          // dispatch arg.name through the loaded fat pair, rendering\0a          // by the declared return shape\0a          let ord9: i64 = trait_ordinal(prog, trt, arg.name);\0a          if ord9 < 0 {\0a            return false;\0a          }\0a          if rtype9 == \22string\22 {\0a            let ta9: i64 = nl.v;\0a            let tl9: i64 = nl.v + 1;\0a            nl.v = nl.v + 2;\0a            pre = pre + \22    (local.get \22;\0a            pre = pre + obj.to_str();\0a            pre = pre + \22)\5cn\22;\0a            pre = pre + \22    (i64.load (i32.add (i32.wrap_i64 \22;\0a            pre = pre + \22(local.get \22;\0a            pre = pre + vbox.to_str();\0a            pre = pre + \22)) (i32.const \22;\0a            pre = pre + (ord9 * 8).to_str();\0a            pre = pre + \22)))\5cn\22;\0a            pre = pre + \22    (i32.wrap_i64)\5cn\22;\0a            pre = pre + \22    call_indirect (type $clp1)\5cn\22;\0a            pre = pre + \22    (local.set \22;\0a            pre = pre + tl9.to_str();\0a            pre = pre + \22)\5cn\22;\0a            pre = pre + \22    (local.set \22;\0a            pre = pre + ta9.to_str();\0a            pre = pre + \22)\5cn\22;\0a            DYN_TEXT = pre;\0a            DYN_A = ta9;\0a            DYN_L = tl9;\0a            return true;\0a          }\0a          let tb9: i64 = nl.v;\0a          nl.v = nl.v + 1;\0a          let ta9: i64 = nl.v;\0a          let tl9: i64 = nl.v + 1;\0a          nl.v = nl.v + 2;\0a          pre = pre + \22    (local.get \22;\0a          pre = pre + obj.to_str();\0a          pre = pre + \22)\5cn\22;\0a          pre = pre + \22    (i64.load (i32.add (i32.wrap_i64 \22;\0a          pre = pre + \22(local.get \22;\0a          pre = pre + vbox.to_str();\0a          pre = pre + \22)) (i32.const \22;\0a          pre = pre + (ord9 * 8).to_str();\0a          pre = pre + \22)))\5cn\22;\0a          pre = pre + \22    (i32.wrap_i64)\5cn\22;\0a          pre = pre + \22    call_indirect (type $cl1)\5cn\22;\0a          pre = pre + \22    (local.set \22;\0a          pre = pre + tb9.to_str();\0a          pre = pre + \22)\5cn\22;\0a          pre = pre + \22    (local.get \22;\0a          pre = pre + tb9.to_str();\0a          pre = pre + \22)\5cn\22;\0a          if rtype9 == \22bool\22 {\0a            pre = pre + \22    call $w_bool\5cn\22;\0a            pre = pre + \22    (local.set $l)\5cn\22;\0a            pre = pre + \22    (i64.extend_i32_u)\5cn\22;\0a            pre = pre + \22    (local.set \22;\0a            pre = pre + ta9.to_str();\0a            pre = pre + \22)\5cn\22;\0a            pre = pre + \22    (i64.extend_i32_u (local.get $l))\5cn\22;\0a            pre = pre + \22    (local.set \22;\0a            pre = pre + tl9.to_str();\0a            pre = pre + \22)\5cn\22;\0a          } else {\0a            pre = pre + \22    call $w_itoa\5cn\22;\0a            pre = pre + \22    (local.set \22;\0a            pre = pre + tl9.to_str();\0a            pre = pre + \22)\5cn\22;\0a            pre = pre + \22    (local.set \22;\0a            pre = pre + ta9.to_str();\0a            pre = pre + \22)\5cn\22;\0a          }\0a          DYN_TEXT = pre;\0a          DYN_A = ta9;\0a          DYN_L = tl9;\0a          return true;\0a        }\0a        if rtype9 == \22string\22 {\0a            // the dispatch reserves its pair first \e2\80\94 base9 holds it\0a            let base9: i64 = nl.v;\0a            let t9s: string = emit_expr(mut pool, arg, mut env, mut prog, mut nl);\0a            DYN_TEXT = t9s + \22    drop\5cn\22;\0a            DYN_A = base9;\0a            DYN_L = base9 + 1;\0a            return true;\0a          }\0a          // a scalar result: dispatch, then render through the\0a          // value's own text (ints the decimal printer, bools the\0a          // word, floats the exact-decimal cluster)\0a          let tb9: i64 = nl.v;\0a          nl.v = nl.v + 1;\0a          let ta9: i64 = nl.v;\0a          let tl9: i64 = nl.v + 1;\0a          nl.v = nl.v + 2;\0a          let mut t9b: string = emit_expr(mut pool, arg, mut env, mut prog, mut nl);\0a          t9b = t9b + \22    (local.set \22;\0a          t9b = t9b + tb9.to_str();\0a          t9b = t9b + \22)\5cn\22;\0a          t9b = t9b + \22    (local.get \22;\0a          t9b = t9b + tb9.to_str();\0a          t9b = t9b + \22)\5cn\22;\0a          if rtype9 == \22bool\22 {\0a            t9b = t9b + \22    call $w_bool\5cn\22;\0a            t9b = t9b + \22    (local.set $l)\5cn\22;\0a            t9b = t9b + \22    (i64.extend_i32_u)\5cn\22;\0a            t9b = t9b + \22    (local.set \22;\0a            t9b = t9b + ta9.to_str();\0a            t9b = t9b + \22)\5cn\22;\0a            t9b = t9b + \22    (i64.extend_i32_u (local.get $l))\5cn\22;\0a            t9b = t9b + \22    (local.set \22;\0a            t9b = t9b + tl9.to_str();\0a            t9b = t9b + \22)\5cn\22;\0a          } else {\0a            if rtype9 == \22f64\22 || rtype9 == \22f32\22 {\0a              FLOAT_WANTED = 1;\0a              if rtype9 == \22f32\22 {\0a                t9b = t9b + \22    (f64.reinterpret_i64)\5cn\22;\0a                t9b = t9b + \22    (f32.demote_f64)\5cn\22;\0a                t9b = t9b + \22    (f64.promote_f32)\5cn\22;\0a                t9b = t9b + \22    (i64.reinterpret_f64)\5cn\22;\0a                t9b = t9b + \22    call $u___f32_text\5cn\22;\0a              } else {\0a                t9b = t9b + \22    call $u___f64_text\5cn\22;\0a              }\0a            } else {\0a              t9b = t9b + \22    call $w_itoa\5cn\22;\0a              t9b = t9b + \22    (local.set \22;\0a              t9b = t9b + tl9.to_str();\0a              t9b = t9b + \22)\5cn\22;\0a              t9b = t9b + \22    (local.set \22;\0a              t9b = t9b + ta9.to_str();\0a              t9b = t9b + \22)\5cn\22;\0a            }\0a          }\0a          if rtype9 == \22f64\22 || rtype9 == \22f32\22 {\0a            t9b = t9b + \22    (local.set \22;\0a            t9b = t9b + tl9.to_str();\0a            t9b = t9b + \22)\5cn\22;\0a            t9b = t9b + \22    (local.set \22;\0a            t9b = t9b + ta9.to_str();\0a            t9b = t9b + \22)\5cn\22;\0a          }\0a          DYN_TEXT = t9b;\0a          DYN_A = ta9;\0a          DYN_L = tl9;\0a          return true;\0a        }\0a        return false;\0a    } else {\0a      if arg.tag == parse.EX_FIELD || arg.tag == parse.EX_IDX {\0a        // a dyn field read or element read: load the fat pair, then\0a        // dispatch to_str through it\0a        let vt2: string = dyn_recv_trait(arg, mut env, mut prog);\0a        if len(vt2) == 0 {\0a          return false;\0a        }\0a        let ld2: string = dyn_pair_load(arg, mut pool, mut env, mut prog, mut nl);\0a        if len(ld2) == 0 {\0a          return false;\0a        }\0a        trt = vt2;\0a        vbox = nl.v - 2;\0a        obj = nl.v - 1;\0a        pre = pre + ld2;\0a        loaded = true;\0a      } else {\0a        return false;\0a      }\0a    }\0a  }\0a  let ord: i64 = trait_ordinal(prog, trt, \22to_str\22);\0a  if ord < 0 {\0a    return false;\0a  }\0a  let ta: i64 = nl.v;\0a  let tl: i64 = nl.v + 1;\0a  nl.v = nl.v + 2;\0a  pre = pre + \22    (local.get \22;\0a  pre = pre + obj.to_str();\0a  pre = pre + \22)\5cn\22;\0a  pre = pre + \22    (i64.load (i32.add (i32.wrap_i64 (local.get \22;\0a  pre = pre + vbox.to_str();\0a  pre = pre + \22)) (i32.const \22;\0a  pre = pre + (ord * 8).to_str();\0a  pre = pre + \22)))\5cn\22;\0a  pre = pre + \22    (i32.wrap_i64)\5cn\22;\0a  pre = pre + \22    call_indirect (type $clp1)\5cn\22;\0a  pre = pre + \22    (local.set \22;\0a  pre = pre + tl.to_str();\0a  pre = pre + \22)\5cn\22;\0a  pre = pre + \22    (local.set \22;\0a  pre = pre + ta.to_str();\0a  pre = pre + \22)\5cn\22;\0a  DYN_TEXT = pre;\0a  DYN_A = ta;\0a  DYN_L = tl;\0a  return true;\0a}\0a\0a// the trait of a dyn-valued FIELD or ELEMENT read (the written type\0a// at the location), \22\22 when the location is not dyn-typed\0afn dyn_recv_trait(e: *Expr, mut env: *Env, mut prog: *Prog) -> string {\0a  if e.tag == parse.EX_FIELD {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    let bt: string = field_base_type(base, env, mut prog);\0a    if len(bt) > 0 {\0a      let si: i64 = st_index(mut prog, st_name_of(bt));\0a      let fi: i64 = st_field_index(prog, si, e.name);\0a      if fi >= 0 {\0a        let fty: string =\0a            prog.structs[si as usize].types[fi as usize];\0a        if is_dyn_type(fty) {\0a          return dyn_trait(fty);\0a        }\0a      }\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_IDX {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    if base.tag == parse.EX_VAR &&\0a        is_dyn_type(env_slice_elemtext(env, base.name)) {\0a      return dyn_trait(env_slice_elemtext(env, base.name));\0a    }\0a  }\0a  return \22\22;\0a}\0a\0a// ---- dyn: fat {vtable, obj} pairs, dispatch through the fn table ----\0a\0a// is a type text the fat-dispatch type?\0afn is_dyn_type(ty: string) -> bool {\0a  return len(ty) >= 4 && ty[0] == 100 && ty[1] == 121 &&\0a      ty[2] == 110 && ty[3] == 32;\0a}\0a\0a// the trait name inside \22dyn Trait\22\0afn dyn_trait(ty: string) -> string {\0a  if is_dyn_type(ty) {\0a    return ty[4..len(ty)];\0a  }\0a  return \22\22;\0a}\0a\0a// a trait's method count (the vtable's release slot sits at\0a// nmethods \e2\80\94 the +1 the box allocates)\0afn trait_method_count(prog: *Prog, trt: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < prog.ntraits {\0a    if prog.traits[i].name == trt {\0a      return prog.traits[i].nmethods as i64;\0a    }\0a    i = i + 1;\0a  }\0a  return 0;\0a}\0a\0a// a trait method's ordinal (the vtable slot), -1 when absent\0afn trait_ordinal(prog: *Prog, trt: string,\0a                 method: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < prog.ntraits {\0a    if prog.traits[i].name == trt {\0a      let mut k: usize = 0;\0a      while k < prog.traits[i].nmethods {\0a        if prog.traits[i].methods[k] == method {\0a          return k as i64;\0a        }\0a        k = k + 1;\0a      }\0a      return 0 - 1;\0a    }\0a    i = i + 1;\0a  }\0a  return 0 - 1;\0a}\0a\0a// the table index of a plain method (registering it once); -1 when\0a// the method does not exist\0afn method_table_idx(mut pool: *Pool, prog: *Prog, tname: string,\0a                    mname: string) -> i64 {\0a  if !user_fn_exists(prog, tname + \22.\22 + mname) {\0a    return 0 - 1;\0a  }\0a  let full: string = \22$u_\22 + sym_name(tname + \22_\22 + mname);\0a  let mut i: usize = 0;\0a  while i < pool.gi.cfn {\0a    if pool.gi.clo_wasms[i] == full {\0a      return i as i64;\0a    }\0a    i = i + 1;\0a  }\0a  if pool.gi.cfn >= len(pool.gi.clo_wasms) {\0a    return 0 - 1;\0a  }\0a  pool.gi.clo_wasms[pool.gi.cfn] = full;\0a  // the arity the dispatch will use: receiver + args (bounded 3)\0a  let fdm2: *FnDef = fn_def_of(prog, tname + \22.\22 + mname);\0a  let ari: i64 = 1 + (len(fdm2.params) as i64) - 1;\0a  clo_ty_need(mut pool.gi, ari, 1);\0a  pool.gi.cfn = pool.gi.cfn + 1;\0a  return (pool.gi.cfn as i64) - 1;\0a}\0a\0a// the table index of a type's release walker (registering it once);\0a// -1 when the type owns nothing\0afn rel_table_idx(mut pool: *Pool, mut prog: *Prog, tname: string) -> i64 {\0a  let relnm: string = rel_callee(mut pool, mut prog, \22*\22 + tname);\0a  if len(relnm) == 0 {\0a    return 0 - 1;\0a  }\0a  let mut i: usize = 0;\0a  while i < pool.gi.cfn {\0a    if pool.gi.clo_wasms[i] == relnm {\0a      return i as i64;\0a    }\0a    i = i + 1;\0a  }\0a  if pool.gi.cfn >= len(pool.gi.clo_wasms) {\0a    return 0 - 1;\0a  }\0a  pool.gi.clo_wasms[pool.gi.cfn] = relnm;\0a  clo_ty_need(mut pool.gi, 1, 1);\0a  pool.gi.cfn = pool.gi.cfn + 1;\0a  return (pool.gi.cfn as i64) - 1;\0a}\0a\0a// the vtable box for (trait, type): slot k holds the table index of\0a// the type's method k (built once per pair, cached by name)\0afn dyn_vtable(mut pool: *Pool, mut prog: *Prog, trt: string,\0a              tname: string) -> string {\0a  // the emitted text leaves the box address on the stack\0a  let vtkey: string = \22vt:\22 + trt + \22:\22 + tname;\0a  let mut i: usize = 0;\0a  while i < pool.gi.n {\0a    if pool.gi.bases[i] == vtkey {\0a      return pool.gi.keys[i];\0a    }\0a    i = i + 1;\0a  }\0a  let mut td_i: i64 = 0 - 1;\0a  let mut ti: usize = 0;\0a  while ti < prog.ntraits {\0a    if prog.traits[ti].name == trt {\0a      td_i = ti as i64;\0a    }\0a    ti = ti + 1;\0a  }\0a  if td_i < 0 {\0a    return \22\22;\0a  }\0a  let td = prog.traits[td_i as usize];\0a  let mut text: string =\0a      \22    (i64.extend_i32_u (call $w_alloc (i32.const \22 +\0a      (td.nmethods + 1).to_str() + \22)))\5cn\22 +\0a      \22    (local.set $r)\5cn\22;\0a  let mut k: usize = 0;\0a  while k < td.nmethods {\0a    let midx: i64 = method_table_idx(mut pool, prog, tname,\0a                                     td.methods[k]);\0a    if midx < 0 {\0a      return \22\22;\0a    }\0a    text = text + \22    (i64.store (i32.add (i32.wrap_i64 \22;\0a    text = text + \22(local.get $r)) (i32.const \22;\0a    text = text + (k * 8).to_str();\0a    text = text + \22)) (i64.const \22;\0a    text = text + midx.to_str();\0a    text = text + \22))\5cn\22;\0a    k = k + 1;\0a  }\0a  // slot nmethods: the release walker \e2\80\94 a dyn's death dispatches\0a  // through the vtable (the mirror of boot's header drop slot)\0a  let ridx: i64 = rel_table_idx(mut pool, mut prog, tname);\0a  if ridx >= 0 {\0a    text = text + \22    (i64.store (i32.add (i32.wrap_i64 \22;\0a    text = text + \22(local.get $r)) (i32.const \22;\0a    text = text + ((td.nmethods as i64) * 8).to_str();\0a    text = text + \22)) (i64.const \22;\0a    text = text + ridx.to_str();\0a    text = text + \22))\5cn\22;\0a  }\0a  text = text + \22    (local.get $r)\5cn\22;\0a  // cache: bases carries the key, keys carries the emitted text\0a  if pool.gi.n >= len(pool.gi.bases) {\0a    return text;\0a  }\0a  pool.gi.bases[pool.gi.n] = vtkey;\0a  pool.gi.keys[pool.gi.n] = text;\0a  pool.gi.sufs[pool.gi.n] = \22\22;\0a  pool.gi.fds[pool.gi.n] = prog.fns[0];\0a  pool.gi.n = pool.gi.n + 1;\0a  return text;\0a}\0a\0a// a wasm-safe symbol: '.' can't ride an id (Type.method \e2\86\92 Type_method)\0afn sym_name(name: string) -> string {\0a  let mut out: string = \22\22;\0a  let mut i: usize = 0;\0a  while i < len(name) {\0a    if name[i] == 46 {\0a      out = out + \22_\22;\0a    } else {\0a      if name[i] == 91 || name[i] == 93 {\0a        // generic-instantiation brackets are not wasm symbol\0a        // characters (Vec[i32]_push once assembled into nothing)\0a        out = out + \22_\22;\0a      } else {\0a        out = out + name[i..(i + 1)];\0a      }\0a    }\0a    i = i + 1;\0a  }\0a  return out;\0a}\0a\0a// wrap the stack's i64 to the width: two's complement makes\0a// wrap-after-op equal the width-native op on the sign-/zero-extended\0a// representation\0afn wrap_snippet(w: i64) -> string {\0a  if w == 0 {\0a    return \22\22;\0a  }\0a  let mut bits: i64 = w;\0a  if bits < 0 {\0a    bits = 0 - bits;\0a  }\0a  if bits >= 64 {\0a    return \22\22; // the full lane already\0a  }\0a  if bits >= 32 {\0a    if w < 0 {\0a      return \22    (i32.wrap_i64)\5cn    (i64.extend_i32_u)\5cn\22;\0a    }\0a    return \22    (i32.wrap_i64)\5cn    (i64.extend_i32_s)\5cn\22;\0a  }\0a  let sh: i64 = 32 - bits;\0a  let mask: i64 = (1 << bits) - 1;\0a  if w < 0 {\0a    return \22    (i32.wrap_i64)\5cn    (i32.and (i32.const \22 +\0a           mask.to_str() + \22))\5cn    (i64.extend_i32_u)\5cn\22;\0a  }\0a  return \22    (i32.wrap_i64)\5cn    (i32.shl (i32.const \22 + sh.to_str() +\0a         \22))\5cn    (i32.shr_s (i32.const \22 + sh.to_str() +\0a         \22))\5cn    (i64.extend_i32_s)\5cn\22;\0a}\0a\0a// a module-level name's global form, \22\22 when absent\0afn static_global(prog: *Prog, name: string) -> string {\0a  let mut i: usize = 0;\0a  while i < prog.nconsts {\0a    if prog.consts[i] == name && prog.cstatic[i] {\0a      return \22$g_\22 + name;\0a    }\0a    i = i + 1;\0a  }\0a  return \22\22;\0a}\0a\0a// a static of string type: its pair rides the two globals\0a// $g_NAME / $g_NAME_l\0afn str_static_is(prog: *Prog, name: string) -> bool {\0a  let mut i: usize = 0;\0a  while i < prog.nconsts {\0a    if prog.consts[i] == name && prog.cstatic[i] &&\0a        prog.ctypes[i] == \22string\22 {\0a      return true;\0a    }\0a    i = i + 1;\0a  }\0a  return false;\0a}\0a\0afn const_value(prog: *Prog, name: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < prog.nconsts {\0a    if prog.consts[i] == name && !prog.cstatic[i] {\0a      return prog.cvals[i];\0a    }\0a    i = i + 1;\0a  }\0a  return 0;\0a}\0a\0afn name_is_const(prog: *Prog, name: string) -> bool {\0a  let mut i: usize = 0;\0a  while i < prog.nconsts {\0a    if prog.consts[i] == name && !prog.cstatic[i] {\0a      return true;\0a    }\0a    i = i + 1;\0a  }\0a  return false;\0a}\0a\0a// a const's written type, \22\22 when the name is no const\0afn const_type(prog: *Prog, name: string) -> string {\0a  let mut i: usize = 0;\0a  while i < prog.nconsts {\0a    if prog.consts[i] == name && !prog.cstatic[i] {\0a      return prog.ctypes[i];\0a    }\0a    i = i + 1;\0a  }\0a  return \22\22;\0a}\0a\0a// one comptime int operand: the folded value, \22\22 when the operand is\0a// not a numeric literal or an int/bool const name\0afn comptime_int(prog: *Prog, e: *Expr) -> ?i64 {\0a  if e.tag == parse.EX_LIT {\0a    if e.name == \22true\22 || e.name == \22false\22 {\0a      return Option.None;\0a    }\0a    return Option.Some(e.lit);\0a  }\0a  if e.tag == parse.EX_VAR && name_is_const(prog, e.name) {\0a    let ty: string = const_type(prog, e.name);\0a    if ty == \22string\22 {\0a      return Option.None;\0a    }\0a    return Option.Some(const_value(prog, e.name));\0a  }\0a  return Option.None;\0a}\0a\0a// wrap a literal into an operand width like the runtime lane: signed\0a// widths sign-extend, unsigned widths zero-extend (the n25 law \e2\80\94 the\0a// fold wraps AND sign-extends at the operand width)\0afn lit_at_width(lit: i64, w: i64) -> i64 {\0a  if w == 0 || w >= 64 || w <= 0 - 64 {\0a    return lit;\0a  }\0a  if w < 0 {\0a    let bits: i64 = 0 - w;\0a    let mask: i64 = (1 << bits) - 1;\0a    return lit & mask;\0a  }\0a  let sh: i64 = 64 - w;\0a  return (lit << sh) >> sh;\0a}\0a\0a// the comptime bool of a condition (the fold's safe faces only: bool\0a// literals, bool consts, and ==/!= over folded ints \e2\80\94 no arithmetic\0a// nests, no short-circuits), None when the condition does not fold\0afn comptime_cond(prog: *Prog, e: *Expr) -> ?bool {\0a  if e.tag == parse.EX_LIT {\0a    if e.name == \22true\22 {\0a      return Option.Some(true);\0a    }\0a    if e.name == \22false\22 {\0a      return Option.Some(false);\0a    }\0a    return Option.None;\0a  }\0a  if e.tag == parse.EX_VAR && name_is_const(prog, e.name) {\0a    if const_type(prog, e.name) == \22bool\22 {\0a      return Option.Some(const_value(prog, e.name) != 0);\0a    }\0a    return Option.None;\0a  }\0a  if e.tag == parse.EX_BIN && (e.op == 9 || e.op == 12 || e.op == 10) {\0a    let mut lv: ?i64 = Option.None;\0a    match e.lhs {\0a      Option.Some(l) => {\0a        lv = comptime_int(prog, l);\0a      },\0a      Option.None => {},\0a    }\0a    let mut rv: ?i64 = Option.None;\0a    match e.rhs {\0a      Option.Some(r) => {\0a        rv = comptime_int(prog, r);\0a      },\0a      Option.None => {},\0a    }\0a    match lv {\0a      Option.Some(l2) => {\0a        match rv {\0a          Option.Some(r2) => {\0a            // a const operand wraps the literal at its own width\0a            // (the runtime loads the literal at the bin width)\0a            let mut lw: i64 = 0;\0a            let mut rw2: i64 = 0;\0a            match e.lhs {\0a              Option.Some(l) => {\0a                if l.tag == parse.EX_VAR && name_is_const(prog, l.name) {\0a                  lw = type_width(const_type(prog, l.name));\0a                }\0a              },\0a              Option.None => {},\0a            }\0a            match e.rhs {\0a              Option.Some(r) => {\0a                if r.tag == parse.EX_VAR && name_is_const(prog, r.name) {\0a                  rw2 = type_width(const_type(prog, r.name));\0a                }\0a              },\0a              Option.None => {},\0a            }\0a            let l3: i64 = lit_at_width(l2, rw2);\0a            let r3: i64 = lit_at_width(r2, lw);\0a            if e.op == 10 {\0a              return Option.Some(l3 != r3);\0a            }\0a            return Option.Some(l3 == r3);\0a          },\0a          Option.None => {},\0a        }\0a      },\0a      Option.None => {},\0a    }\0a  }\0a  return Option.None;\0a}\0a\0a// a const/static's float kind by its written type, 0 when not float\0afn const_fkind(prog: *Prog, name: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < prog.nconsts {\0a    if prog.consts[i] == name {\0a      if prog.ctypes[i] == \22f64\22 {\0a        return 1;\0a      }\0a      if prog.ctypes[i] == \22f32\22 {\0a        return 2;\0a      }\0a      return 0;\0a    }\0a    i = i + 1;\0a  }\0a  return 0;\0a}\0a\0a// a const/static's initializer expression (every const has one; a\0a// missing name yields the harmless 0 literal)\0afn const_init_expr(prog: *Prog, name: string) -> *Expr {\0a  let mut i: usize = 0;\0a  while i < prog.nconsts {\0a    if prog.consts[i] == name {\0a      return prog.cexprs[i];\0a    }\0a    i = i + 1;\0a  }\0a  return parse.lit(0);\0a}\0a\0a// the wat operator for an op code\0afn wat_op(op: i64) -> string {\0a  if op == 0 {\0a    return \22i64.add\22;\0a  }\0a  if op == 1 {\0a    return \22i64.sub\22;\0a  }\0a  if op == 2 {\0a    return \22i64.mul\22;\0a  }\0a  if op == 3 {\0a    return \22i64.div_s\22;\0a  }\0a  if op == 4 {\0a    return \22i64.rem_s\22;\0a  }\0a  if op == 5 {\0a    return \22i64.lt_s\22;\0a  }\0a  if op == 6 {\0a    return \22i64.gt_s\22;\0a  }\0a  if op == 7 {\0a    return \22i64.le_s\22;\0a  }\0a  if op == 8 {\0a    return \22i64.ge_s\22;\0a  }\0a  if op == 9 {\0a    return \22i64.eq\22;\0a  }\0a  if op == 11 {\0a    return \22i32.wrap_i64\22;\0a  }\0a  if op == 12 {\0a    return \22i64.eq\22;\0a  }\0a  if op == 15 {\0a    return \22i64.and\22;\0a  }\0a  if op == 16 {\0a    return \22i64.or\22;\0a  }\0a  if op == 17 {\0a    return \22i64.xor\22;\0a  }\0a  if op == 18 {\0a    return \22i64.shl\22;\0a  }\0a  if op == 19 {\0a    return \22i64.shr_s\22;\0a  }\0a  return \22i64.ne\22;\0a}\0a\0a// the raw text when an expr is a string literal, a string variable,\0a// or a + concatenation of those; absent otherwise\0afn fold_string(e: *Expr, env: *Env) -> ?string {\0a  if e.tag == parse.EX_STR {\0a    return Option.Some(e.name);\0a  }\0a  if e.tag == parse.EX_VAR {\0a    return env_str_raw(env, e.name);\0a  }\0a  if e.tag == parse.EX_BIN && e.op == 0 {\0a    let mut lraw: string = \22\22;\0a    let mut have: bool = false;\0a    match e.lhs {\0a      Option.Some(l) => {\0a        match fold_string(l, env) {\0a          Option.Some(ls) => {\0a            lraw = ls;\0a            have = true;\0a          },\0a          Option.None => {},\0a        }\0a      },\0a      Option.None => {},\0a    }\0a    if !have {\0a      return Option.None;\0a    }\0a    let mut rraw: string = \22\22;\0a    match e.rhs {\0a      Option.Some(r) => {\0a        match fold_string(r, env) {\0a          Option.Some(rs) => {\0a            rraw = rs;\0a          },\0a          Option.None => {\0a            return Option.None;\0a          },\0a        }\0a      },\0a      Option.None => {\0a        return Option.None;\0a      },\0a    }\0a    return Option.Some(lraw + rraw);\0a  }\0a  return Option.None;\0a}\0a\0a// a slice-typed field: the pair rides the field's two slots exactly\0a// like a string field's (arguments and pair builds read both halves)\0afn field_is_slice(e: *Expr, env: *Env, mut prog: *Prog) -> bool {\0a  if e.tag != parse.EX_FIELD {\0a    return false;\0a  }\0a  let mut base: *Expr = parse.lit(0);\0a  match e.lhs {\0a    Option.Some(b) => {\0a      base = b;\0a    },\0a    Option.None => {},\0a  }\0a  let bt: string = field_base_type(base, env, mut prog);\0a  if len(bt) > 0 {\0a    let si: i64 = st_index(mut prog, st_name_of(bt));\0a    let fi: i64 = st_field_index(prog, si, e.name);\0a    if fi >= 0 {\0a      return type_kind(prog.structs[si as usize].types[fi as usize]) == 2;\0a    }\0a  }\0a  return false;\0a}\0a\0afn is_stringy(e: *Expr, env: *Env, mut prog: *Prog) -> bool {\0a  if e.tag == parse.EX_STR {\0a    return true;\0a  }\0a  if e.tag == parse.EX_CALL {\0a    // format builds a string; so does any call with a string return\0a    if e.name == \22format\22 {\0a      return true;\0a    }\0a    return call_fn_rtype(prog, e, env) == \22string\22;\0a  }\0a  if e.tag == parse.EX_VAR {\0a    if str_static_is(prog, e.name) {\0a      return true;\0a    }\0a    return env_str_is_runtime(env, e.name) &&\0a           env_kind_of(env, e.name) == 1;\0a  }\0a  if e.tag == parse.EX_IDX {\0a    // a string element's pair loads at the 16-byte stride\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    if base.tag == parse.EX_VAR {\0a      return env_kind_of(env, base.name) == 2 &&\0a             env_slice_elemtext(env, base.name) == \22string\22;\0a    }\0a    return false;\0a  }\0a  if e.tag == parse.EX_FIELD {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    let bt: string = field_base_type(base, env, mut prog);\0a    if len(bt) > 0 {\0a      let si: i64 = st_index(mut prog, st_name_of(bt));\0a      let fi: i64 = st_field_index(prog, si, e.name);\0a      if fi >= 0 {\0a        return type_kind(prog.structs[si as usize].types[fi as usize]) == 1;\0a      }\0a    }\0a    return false;\0a  }\0a  if e.tag == parse.EX_MCALL {\0a    // to_str IS the string conversion face \e2\80\94 every type's to_str\0a    // returns string by law (an enum-payload binder's to_str rode\0a    // non-stringy once and its concat arm collapsed the whole match\0a    // out of the pair lanes); any other method rides its declared\0a    // return through the receiver's instantiation\0a    if e.name == \22to_str\22 {\0a      return true;\0a    }\0a    match e.lhs {\0a      Option.Some(r14) => {\0a        let rt14: string = method_rtype(mut prog,\0a                                        expr_ptr_type(r14, env, mut prog),\0a                                        e.name);\0a        return rt14 == \22string\22;\0a      },\0a      Option.None => {},\0a    }\0a    return false;\0a  }\0a  return false;\0a}\0a\0a// an Option scrutinee's payload pointer target: a binding's recorded\0a// text, a slice element's, or a struct-field slice's (one field step)\0afn optpt_of_scrutinee(sc: *Expr, mut env: *Env, mut prog: *Prog) -> string {\0a  if sc.tag == parse.EX_VAR {\0a    // the pointer target; a string payload rides its raw text (the\0a    // binder walk keys on \22string\22)\0a    let pt: string = env_slicept_of(env, sc.name);\0a    if len(pt) > 0 {\0a      return pt;\0a    }\0a    return env_slice_elemtext(env, sc.name);\0a  }\0a  if sc.tag == parse.EX_IDX {\0a    let mut b: *Expr = parse.lit(0);\0a    match sc.lhs {\0a      Option.Some(bb) => {\0a        b = bb;\0a      },\0a      Option.None => {},\0a    }\0a    if b.tag == parse.EX_VAR {\0a      return env_slicept_of(env, b.name);\0a    }\0a    // any other slice-typed base: the element text rides the owner's\0a    // declared field type (a string payload rides its raw text)\0a    let oet: string = expr_slice_elemtext(b, env, mut prog);\0a    if len(oet) >= 1 && (oet[0] == 63 || oet[0] == 42) {\0a      return type_ptr_target(oet);\0a    }\0a    return oet;\0a  }\0a  if sc.tag == parse.EX_CALL {\0a    // a ?T-returning call: the payload text rides the rtype's tail;\0a    // a Result[T, E]-returning call rides its first bracket arg (the\0a    // Ok payload \e2\80\94 read_file's string payload rode scalar once and\0a    // every binder over it collapsed the pair lanes)\0a    let rt3: string = fn_rtype_of(prog, sc.name);\0a    if len(rt3) >= 2 && rt3[0] == 63 {\0a      return rt3[1..len(rt3)];\0a    }\0a    // Option[T] / Result[T, E] spelled in full: the payload is the\0a    // first bracket arg (norm_enum collapses the spelling downstream,\0a    // so the payload text must come off HERE, before it \e2\80\94 maybe()'s\0a    // Option[string] and read_file's Result[string] payloads rode\0a    // scalar once and every binder over them collapsed the pair\0a    // lanes)\0a    if starts_open(rt3, \22Option\22) || starts_open(rt3, \22Result\22) {\0a      let ob: i64 = open_bracket(rt3);\0a      if ob >= 0 {\0a        let tas: []string = split_type_args(\0a            rt3[((ob as usize) + 1)..(len(rt3) - 1)]);\0a        if len(tas) > 0 {\0a          return tas[0];\0a        }\0a      }\0a    }\0a  }\0a  if sc.tag == parse.EX_MCALL {\0a    let mut recv3: *Expr = parse.lit(0);\0a    match sc.lhs {\0a      Option.Some(r3) => {\0a        recv3 = r3;\0a      },\0a      Option.None => {},\0a    }\0a    let bt3: string = expr_ptr_type(recv3, env, mut prog);\0a    if len(bt3) > 0 {\0a      let rt4: string = method_rtype(mut prog, bt3, sc.name);\0a      if len(rt4) >= 2 && rt4[0] == 63 {\0a        return rt4[1..len(rt4)];\0a      }\0a    }\0a  }\0a  if sc.tag == parse.EX_FIELD {\0a    // a ?*T field over a typed base: the payload's target is the\0a    // binder's pointer lane\0a    let mut fb: *Expr = parse.lit(0);\0a    match sc.lhs {\0a      Option.Some(f2) => {\0a        fb = f2;\0a      },\0a      Option.None => {},\0a    }\0a    let bt2: string = field_base_type(fb, env, mut prog);\0a    let mut fty2: string = \22\22;\0a    if len(bt2) > 0 {\0a      let si2: i64 = st_index(mut prog, st_name_of(bt2));\0a      let fi2: i64 = st_field_index(prog, si2, sc.name);\0a      if fi2 >= 0 {\0a        fty2 = prog.structs[si2 as usize].types[fi2 as usize];\0a      }\0a    }\0a    if len(fty2) >= 1 && fty2[0] == 63 {\0a      return type_ptr_target(fty2);\0a    }\0a    if fty2 == \22string\22 {\0a      return \22string\22;\0a    }\0a    return \22\22;\0a  }\0a  if sc.tag == parse.EX_CALL {\0a    // a call scrutinee: the declared return's payload text drives the\0a    // binder's lane (?string binds its pair, ?*T the pointer lane)\0a    let rt: string = call_fn_rtype(prog, sc, env);\0a    if rt == \22?string\22 {\0a      return \22string\22;\0a    }\0a    if len(rt) >= 2 && rt[0] == 63 && rt[1] == 42 {\0a      return rt[2..len(rt)];\0a    }\0a    return \22\22;\0a  }\0a  return \22\22;\0a}\0a\0afn both_stringy(e: *Expr, env: *Env, mut prog: *Prog) -> bool {\0a  let mut l: bool = false;\0a  match e.lhs {\0a    Option.Some(x) => {\0a      l = is_stringy(x, env, mut prog);\0a    },\0a    Option.None => {},\0a  }\0a  if !l {\0a    return false;\0a  }\0a  match e.rhs {\0a    Option.Some(y) => {\0a      return is_stringy(y, env, mut prog);\0a    },\0a    Option.None => {\0a      return false;\0a    },\0a  }\0a}\0a\0a// compile an expression: lines that leave one i64 on the stack\0afn emit_expr(mut pool: *Pool, e: *Expr, mut env: *Env, mut prog: *Prog,\0a             mut nl: *NextLocal) -> string {\0a  if e.tag == parse.EX_LIT {\0a    return \22    (i64.const \22 + e.lit.to_str() + \22)\5cn\22;\0a  }\0a  if e.tag == parse.EX_MAKE {\0a    // a make in a scalar lane parks its {addr, count} pair and rides\0a    // the address (the EX_SLICE2 convention); pair-shaped consumers\0a    // go through build_string_pair / emit_arg, which park the whole\0a    // pair \e2\80\94 the bare node used to fall through into the BIN\0a    // template and render as a lone (i64.add)\0a    return emit_make(mut pool, e, mut env, mut prog, mut nl) +\0a           \22    (local.set $t)\5cn\22;\0a  }\0a  if e.tag == parse.EX_ARR {\0a    // a slice literal in a scalar lane parks and rides the same way\0a    return emit_array(mut pool, e, mut env, mut prog, mut nl) +\0a           \22    (local.set $t)\5cn\22;\0a  }\0a  if e.tag == parse.EX_VAR {\0a    let slot: i64 = env_look(env, e.name);\0a    if slot < 0 {\0a      if name_is_const(prog, e.name) {\0a        // a float-typed const's bits come from its literal's raw text\0a        // (wat2wasm does the strtod, exactly like an EX_FLIT)\0a        let ck: i64 = const_fkind(prog, e.name);\0a        let ie: *Expr = const_init_expr(prog, e.name);\0a        if ck == 2 && ie.tag == parse.EX_FLIT {\0a          return \22    (i64.reinterpret_f64 (f64.promote_f32 \22 +\0a                 \22(f32.demote_f64 (f64.const \22 + ie.name + \22))))\5cn\22;\0a        }\0a        if ck == 1 && ie.tag == parse.EX_FLIT {\0a          return \22    (i64.reinterpret_f64 (f64.const \22 + ie.name +\0a                 \22))\5cn\22;\0a        }\0a        return \22    (i64.const \22 + const_value(prog, e.name).to_str() +\0a               \22)\5cn\22;\0a      }\0a      if len(static_global(prog, e.name)) > 0 {\0a        return \22    (global.get \22 + static_global(prog, e.name) + \22)\5cn\22;\0a      }\0a      return \22    (i64.const 0)\5cn\22;\0a    }\0a    return \22    (local.get \22 + slot.to_str() + \22)\5cn\22;\0a  }\0a  if e.tag == parse.EX_CALL && e.name == \22len\22 && len(e.args) == 1 {\0a    let a0 = e.args[0];\0a    if a0.tag == parse.EX_VAR && env_str_is_runtime(env, a0.name) {\0a      return \22    (local.get \22 +\0a             env_str_len_slot(env, a0.name).to_str() + \22)\5cn\22;\0a    }\0a    if a0.tag == parse.EX_VAR && str_static_is(prog, a0.name) {\0a      return \22    (global.get $g_\22 + a0.name + \22_l)\5cn\22;\0a    }\0a    match fold_string(a0, env) {\0a      Option.Some(raw) => {\0a        return \22    (i64.const \22 + decoded_len(raw).to_str() + \22)\5cn\22;\0a      },\0a      Option.None => {},\0a    }\0a    // a slice operand: the pair's length slot rides the binding\0a    // (kind 2) \e2\80\94 len(toks), len(args), the self-compile's own bread\0a    // and butter; the old fall-through called an undefined $u_len\0a    if a0.tag == parse.EX_VAR && env_kind_of(env, a0.name) == 2 {\0a      return \22    (local.get \22 + env_str_len_slot(env, a0.name).to_str() +\0a             \22)\5cn\22;\0a    }\0a    // a string- or slice-typed FIELD: the pair rides the field's two\0a    // slots \e2\80\94 read the length half back (len(st.fmt), len(st.args),\0a    // len(fdef.params): the emitter's own loops over statement fields)\0a    if a0.tag == parse.EX_FIELD &&\0a        (is_stringy(a0, env, mut prog) || field_is_slice(a0, env,\0a                                                         mut prog)) {\0a      let fa6: i64 = nl.v;\0a      let fl6: i64 = nl.v + 1;\0a      nl.v = nl.v + 2;\0a      let t6: string = push_string(mut pool, a0, mut env, mut prog,\0a                                   mut nl);\0a      return t6 + \22    (local.set \22 + fl6.to_str() + \22)\5cn\22 +\0a             \22    (local.set \22 + fa6.to_str() + \22)\5cn\22 +\0a             \22    (local.get \22 + fl6.to_str() + \22)\5cn\22;\0a    }\0a    // an unregistered variable: no lane claims its pair (a let over a\0a    // call init inside a branch the env missed). Zero is the honest\0a    // answer \e2\80\94 the one consumer (the disabled dyn-coercion guard)\0a    // treats 0 as skip \e2\80\94 and dropping through used to emit a call to\0a    // an undefined $u_len, refusing the child at wat2wasm\0a    if a0.tag == parse.EX_VAR {\0a      return \22    (i64.const 0)\5cn\22;\0a    }\0a    // len(f(...)): a call returning a pair parks (addr, len) \e2\80\94 read\0a    // the length back. The pair must come from build_string_pair:\0a    // emit_expr collapses a pair-returning call onto its address lane\0a    // (the sret branch below), which stranded this template's second\0a    // pop on an empty stack.\0a    if a0.tag == parse.EX_CALL {\0a      let rt5: string = call_fn_rtype(prog, a0, env);\0a      if rtype_is_pair(rt5) && !is_fn_type(rt5) {\0a        let sp5 = build_string_pair(a0, mut pool, mut env, mut prog,\0a                                    mut nl);\0a        if sp5.ok {\0a          return sp5.text + \22    (local.get \22 + sp5.l.to_str() + \22)\5cn\22;\0a        }\0a      }\0a    }\0a    // len(xs[i]): an element of a slice-of-slices rides the pair at\0a    // the computed element address \e2\80\94 len loads at +8\0a    if a0.tag == parse.EX_IDX {\0a      let mut base6: *Expr = parse.lit(0);\0a      match a0.lhs {\0a        Option.Some(b6) => {\0a          base6 = b6;\0a        },\0a        Option.None => {},\0a      }\0a      let et6: string = expr_slice_elemtext(base6, env, mut prog);\0a      if len(et6) >= 2 && et6[0] == 91 && et6[1] == 93 {\0a        let la6: i64 = nl.v;\0a        nl.v = nl.v + 1;\0a        let mut out6: string = emit_expr(mut pool, a0, mut env,\0a                                         mut prog, mut nl);\0a        out6 = out6 + \22    (local.set \22 + la6.to_str() + \22)\5cn\22 +\0a               \22    (i64.load (i32.add (i32.wrap_i64 (local.get \22 +\0a               la6.to_str() + \22)) (i32.const 8)))\5cn\22;\0a        return out6;\0a      }\0a      // a STRING element rides its pair at the 16-byte stride \e2\80\94 the\0a      // length is the element's second slot, not the string's bytes\0a      if et6 == \22string\22 {\0a        let blk6: i64 = nl.v;\0a        nl.v = nl.v + 1;\0a        let mut out6: string = \22\22;\0a        let mut oob6: string = \22\22;\0a        let mut boff6: i64 = 0 - 1;\0a        let mut bvar6: bool = false;\0a        if base6.tag == parse.EX_VAR &&\0a            env_kind_of(env, base6.name) == 2 {\0a          let va6: i64 = env_str_look(env, base6.name);\0a          out