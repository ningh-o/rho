  (data (i32.const 4624) "/main.rho")
  (data (i32.const 4640) "// main.rho \e2\80\94 the self-hosted compiler's root (T2.1 skeleton, growing).\0a// Source arrives as the SRC build parameter (\c2\a77: root consts are\0a// ordinary consts; --set overrides any text-formed type); the WAT\0a// goes to stdout:\0a//   rho build libs/compiler/main.rho -o rho.wasm --set SRC='\e2\80\a6'\0a//   wasmtime rho.wasm | wat2wasm -o out.wasm -\0a// Subset today: fn main + user fns (i64 params/returns \e2\80\94 string\0a// parameters need a pair-passing ABI, next), printf over folded\0a// strings and integer expressions, let/assignment (i64 + folded\0a// strings), while/if/else-if, comparisons, len() over strings.\0ause lex;\0ause parse;\0ause check;\0ause emit;\0ause fmt;\0ause std.io;\0a\0aconst SRC: string = \22fn main() -> i32 { printf(\5c\22hello, self\5c\5cn\5c\22); return 0; }\22;\0aconst MODS: string = \22\22; // the module tree: \22@MOD@ <path>\5cn<text>\22 blocks\0aconst FMT: i64 = 0; // 1 = print the canonical formatting instead\0a// the app face's module tree (the site's artifact bakes the std tree\0a// here; the chain's own build leaves it empty)\0aconst MODS_APP: string = \22\22;\0a\0a// the app face (the site's playground and corpus): the host writes\0a// the source to /main.rho and the verb to /mode (\22build\22 default,\0a// \22check\22, \22fmt\22); the module tree rides MODS_APP. Absent files \e2\86\92\0a// the baked self-compile path (\c2\a77's chain law stays untouched).\0afn app_compile(src: string) -> i32 {\0a  let mut mode: string = \22build\22;\0a  match io.read_file(\22/mode\22) {\0a    Result.Ok(m) => {\0a      mode = m;\0a    },\0a    Result.Err(_) => {},\0a  }\0a  let lx = lex.scan(src);\0a  let mut prog: *Prog = parse.parse_full(lx.toks, src, lx.ctexts,\0a                                         lx.clines);\0a  if prog.perrs > 0 {\0a    eprintf(\22parse: {} unresolved form(s)\5cn\22, prog.perrs);\0a    return 1;\0a  }\0a  // fmt is syntax-level law: it formats whatever parses, no semantic\0a  // checks, and it renders before any module load touches the tables\0a  // (the file alone \e2\80\94 the module tree is not the file's text). build\0a  // and check run the checker.\0a  if mode == \22fmt\22 {\0a    let text: string = fmt.fmt_prog(prog);\0a    let mut off0: usize = 0;\0a    while off0 < len(text) {\0a      let mut end0: usize = off0 + 512;\0a      if end0 > len(text) {\0a        end0 = len(text);\0a      }\0a      printf(\22{}\22, text[off0..end0]);\0a      off0 = end0;\0a    }\0a    return 0;\0a  }\0a  // the runtime module channel: /mods carries the user's module tree\0a  // in the @MOD@ format \e2\80\94 the host writes it when the program's use\0a  // lines reach past the baked std tree (the vite plugin's multi-\0a  // module face). One load pass carries both trees \e2\80\94 the user's ride\0a  // ahead of the baked std tree, so each use resolves exactly once\0a  // and a user spelling shadows std on a path collision. Absent\0a  // /mods \e2\86\92 the baked std tree alone.\0a  let mut tree: string = MODS_APP;\0a  match io.read_file(\22/mods\22) {\0a    Result.Ok(mt) => {\0a      tree = mt + MODS_APP;\0a    },\0a    Result.Err(_) => {},\0a  }\0a  if len(tree) > 0 && !parse.load_mods(mut prog, tree) {\0a    eprintf(\22mods: unresolved module path(s)\5cn\22);\0a    return 1;\0a  }\0a  if prog.perrs > 0 {\0a    eprintf(\22parse: {} unresolved form(s)\5cn\22, prog.perrs);\0a    return 1;\0a  }\0a  let mut errs: i64 = check.check(prog);\0a  if errs > 0 {\0a    eprintf(\22check: {} error(s)\5cn\22, errs);\0a    return 1;\0a  }\0a  if mode == \22check\22 {\0a    return 0;\0a  }\0a  let mut text: string = emit.emit(mut prog);\0a  let mut off: usize = 0;\0a  while off < len(text) {\0a    let mut end: usize = off + 512;\0a    if end > len(text) {\0a      end = len(text);\0a    }\0a    printf(\22{}\22, text[off..end]);\0a    off = end;\0a  }\0a  return 0;\0a}\0a\0afn main() -> i32 {\0a  // the app face: the host's /main.rho wins; absent \e2\86\92 the baked\0a  // self-compile\0a  match io.read_file(\22/main.rho\22) {\0a    Result.Ok(src) => {\0a      return app_compile(src);\0a    },\0a    Result.Err(_) => {},\0a  }\0a  // the FMT face lexes through scan(): the formatter replays the\0a  // file's comments, so the Prog must carry the comment tables\0a  let lx = lex.scan(SRC);\0a  let mut prog: *Prog = parse.parse_full(lx.toks, SRC, lx.ctexts,\0a                                         lx.clines);\0a  if prog.perrs > 0 {\0a    eprintf(\22parse: {} unresolved form(s)\5cn\22, prog.perrs);\0a    return 1;\0a  }\0a  // the chain law: our own root consts ride the same parameters into\0a  // the compiled program \e2\80\94 the child's SRC/MODS are ours (\c2\a77)\0a  parse.override_root_str(mut prog, \22SRC\22, SRC);\0a  parse.override_root_str(mut prog, \22MODS\22, MODS);\0a  // fmt is syntax-level law here too (boot's fmt checks nothing), and\0a  // it renders before any module load touches the tables \e2\80\94 the file\0a  // alone, module tree or not\0a  if FMT == 1 {\0a    let text: string = fmt.fmt_prog(prog);\0a    let mut off0: usize = 0;\0a    while off0 < len(text) {\0a      let mut end0: usize = off0 + 512;\0a      if end0 > len(text) {\0a        end0 = len(text);\0a      }\0a      printf(\22{}\22, text[off0..end0]);\0a      off0 = end0;\0a    }\0a    return 0;\0a  }\0a  if !parse.load_mods(mut prog, MODS) {\0a    eprintf(\22mods: unresolved module path(s)\5cn\22);\0a    return 1;\0a  }\0a  if prog.perrs > 0 {\0a    eprintf(\22parse: {} unresolved form(s)\5cn\22, prog.perrs);\0a    return 1;\0a  }\0a  let mut errs: i64 = check.check(prog);\0a  if errs > 0 {\0a    eprintf(\22check: {} error(s)\5cn\22, errs);\0a    return 1;\0a  }\0a  let wat: string = emit.emit(mut prog);\0a  // stream in slices: the format scratch is bounded, programs are not\0a  let mut off: usize = 0;\0a  while off < len(wat) {\0a    let mut end: usize = off + 512;\0a    if end > len(wat) {\0a      end = len(wat);\0a    }\0a    printf(\22{}\22, wat[off..end]);\0a    off = end;\0a  }\0a  return 0;\0a}\0a")
  (data (i32.const 10128) "SRC")
  (data (i32.const 10144) "MODS")
  (data (i32.const 10160) "@MOD@ check.rho\0a// check.rho \e2\80\94 the self-hosted compiler's checker seed (T2.2 growth).\0a// The full type layer grows here; today it walks the fn table and\0a// the statements proving every CALLED name has a definition and every\0a// variable reference is bound \e2\80\94 unknown names are errors (exit 1)\0a// before emission runs.\0ause parse;\0a\0apub fn name_known(prog: *Prog, name: string) -> bool {\0a  if name == \22len\22 || name == \22assert\22 || name == \22format\22 ||\0a      name == \22assert_eq\22 || name == \22printf\22 || name == \22eprintf\22 ||\0a      name == \22panic\22 {\0a    return true;\0a  }\0a  if name == \22__fd_read_packed\22 || name == \22__fd_write\22 ||\0a      name == \22__fd_close\22 || name == \22__path_open\22 ||\0a      name == \22__string_from\22 {\0a    // std.io's raw window: the kernel's wasi tail, lowered by the\0a    // emitter (the __ face is never user-callable by law, but the\0a    // names anchor here like printf's do)\0a    return true;\0a  }\0a  if name == \22weak\22 {\0a    // the weak namespace's only member: weak.from(p) \e2\80\94 the identity\0a    return true;\0a  }\0a  let mut i: usize = 0;\0a  while i < len(prog.fns) {\0a    if prog.fns[i].name == name {\0a      return true;\0a    }\0a    i = i + 1;\0a  }\0a  // name[T1, T2] \e2\80\94 a generic fn named with explicit type arguments\0a  // (the wall lift: callers name generic types): the base must be a\0a  // fn and the argument count must match its declaration (the emitter\0a  // instantiates from the folded spelling)\0a  if parse.has_targs(name) {\0a    let base: string = parse.targs_base(name);\0a    let mut j: usize = 0;\0a    while j < len(prog.fns) {\0a      if prog.fns[j].name == base && len(prog.fns[j].tparams) > 0 {\0a        let mut ob: usize = 0;\0a        while ob < len(name) {\0a          if name[ob] == 91 {\0a            break;\0a          }\0a          ob = ob + 1;\0a        }\0a        return targs_arg_count(name, ob) ==\0a            (len(prog.fns[j].tparams) as i64);\0a      }\0a      j = j + 1;\0a    }\0a  }\0a  return false;\0a}\0a\0a// depth-0 commas inside name[(ob+1)..len-1], plus one \e2\80\94 the folded\0a// type-argument count\0afn targs_arg_count(name: string, ob: usize) -> i64 {\0a  let mut n: i64 = 1;\0a  let mut depth: i64 = 0;\0a  let mut i: usize = ob + 1;\0a  while i + 1 < len(name) {\0a    if name[i] == 91 {\0a      depth = depth + 1;\0a    }\0a    if name[i] == 93 {\0a      depth = depth - 1;\0a    }\0a    if name[i] == 44 && depth == 0 {\0a      n = n + 1;\0a    }\0a    i = i + 1;\0a  }\0a  return n;\0a}\0a\0apub fn enum_known(prog: *Prog, name: string) -> bool {\0a  let mut i: usize = 0;\0a  while i < prog.nenums {\0a    if prog.enums[i].name == name {\0a      return true;\0a    }\0a    i = i + 1;\0a  }\0a  return false;\0a}\0a\0a// the variant's tag, -1 when the enum or variant is unknown\0apub fn enum_variant(prog: *Prog, ename: string,\0a                    vname: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < prog.nenums {\0a    if prog.enums[i].name == ename {\0a      let mut k: usize = 0;\0a      while k < prog.enums[i].nv {\0a        if prog.enums[i].vnames[k] == vname {\0a          return k as i64;\0a        }\0a        k = k + 1;\0a      }\0a      return 0 - 1;\0a    }\0a    i = i + 1;\0a  }\0a  return 0 - 1;\0a}\0a\0apub fn struct_known(prog: *Prog, name: string) -> bool {\0a  let mut i: usize = 0;\0a  while i < prog.nstructs {\0a    if prog.structs[i].name == name {\0a      return true;\0a    }\0a    i = i + 1;\0a  }\0a  // Name[args] \e2\80\94 the base must be a generic struct and the argument\0a  // count must match its declaration (the emitter instantiates)\0a  let ob: i64 = bracket_at(name);\0a  if ob >= 0 && name[len(name) - 1..len(name)] == \22]\22 {\0a    let base: string = name[0..(ob as usize)];\0a    let mut j: usize = 0;\0a    while j < prog.nstructs {\0a      if prog.structs[j].name == base &&\0a          len(prog.structs[j].tparams) > 0 {\0a        return arg_count(name, ob) ==\0a            (len(prog.structs[j].tparams) as i64);\0a      }\0a      j = j + 1;\0a    }\0a  }\0a  return false;\0a}\0a\0a// the index of the first '[' in a text, -1 when none\0afn bracket_at(s: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < len(s) {\0a    if s[i] == 91 {\0a      return i as i64;\0a    }\0a    i = i + 1;\0a  }\0a  return 0 - 1;\0a}\0a\0a// depth-0 commas inside name[(ob+1)..len-1], plus one\0afn arg_count(name: string, ob: i64) -> i64 {\0a  let mut n: i64 = 1;\0a  let mut depth: i64 = 0;\0a  let mut i: usize = (ob as usize) + 1;\0a  while i < len(name) - 1 {\0a    let mut b: u8 = name[i];\0a    if b == 91 {\0a      depth = depth + 1;\0a    }\0a    if b == 93 {\0a      depth = depth - 1;\0a    }\0a    if b == 44 && depth == 0 {\0a      n = n + 1;\0a    }\0a    i = i + 1;\0a  }\0a  return n;\0a}\0a\0afn fn_named(prog: *Prog, name: string) -> bool {\0a  let mut i: usize = 0;\0a  while i < len(prog.fns) {\0a    if prog.fns[i].name == name {\0a      return true;\0a    }\0a    i = i + 1;\0a  }\0a  return false;\0a}\0a\0a// some Type.method exists (the receiver's own type is beyond the\0a// name-level checker \e2\80\94 suffix match keeps the refusal honest)\0afn method_known(prog: *Prog, mname: string) -> bool {\0a  if mname == \22get\22 {\0a    // weak.get() \e2\80\94 the absence probe over the header's rc\0a    return true;\0a  }\0a  if mname == \22is_some\22 || mname == \22is_none\22 || mname == \22is_ok\22 ||\0a      mname == \22is_err\22 {\0a    // the absence faces over Option/Result boxes \e2\80\94 the emitter reads\0a    // the tag slot natively (the boot prelude's match arms, twinned)\0a    return true;\0a  }\0a  let mut i: usize = 0;\0a  while i < len(prog.fns) {\0a    let n: string = prog.fns[i].name;\0a    if len(n) > len(mname) + 1 &&\0a       n[len(n) - len(mname) - 1] == 46 {\0a      let mut k: usize = 0;\0a      let mut hit: bool = true;\0a      while k < len(mname) {\0a        if n[len(n) - len(mname) + k] != mname[k] {\0a          hit = false;\0a        }\0a        k = k + 1;\0a      }\0a      if hit {\0a        return true;\0a      }\0a    }\0a    i = i + 1;\0a  }\0a  return false;\0a}\0a\0afn expr_walk(e: *Expr, prog: *Prog, mut bound: []string, mut muts: []bool,\0a             nb: usize, mut errs: *ErrBox) {\0a  if e.tag == parse.EX_MAKE {\0a    let mut k: usize = 0;\0a    while k < len(e.args) {\0a      expr_walk(e.args[k], prog, mut bound, mut muts, nb, mut errs);\0a      k = k + 1;\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_IDX {\0a    match e.lhs {\0a      Option.Some(b) => {\0a        expr_walk(b, prog, mut bound, mut muts, nb, mut errs);\0a      },\0a      Option.None => {},\0a    }\0a    match e.rhs {\0a      Option.Some(i) => {\0a        expr_walk(i, prog, mut bound, mut muts, nb, mut errs);\0a      },\0a      Option.None => {},\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_SLICE2 {\0a    match e.lhs {\0a      Option.Some(b) => {\0a        expr_walk(b, prog, mut bound, mut muts, nb, mut errs);\0a      },\0a      Option.None => {},\0a    }\0a    let mut k: usize = 0;\0a    while k < len(e.args) {\0a      expr_walk(e.args[k], prog, mut bound, mut muts, nb, mut errs);\0a      k = k + 1;\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_NEW {\0a    if !struct_known(prog, e.name) {\0a      eprintf(\22check: unknown struct '{}'\5cn\22, e.name);\0a      errs.n = errs.n + 1;\0a    }\0a    let mut k: usize = 0;\0a    while k < len(e.args) {\0a      expr_walk(e.args[k], prog, mut bound, mut muts, nb, mut errs);\0a      k = k + 1;\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_FIELD || e.tag == parse.EX_DEREF {\0a    // Enum.Var without call parens \e2\80\94 the unit-variant constructor\0a    if e.tag == parse.EX_FIELD {\0a      match e.lhs {\0a        Option.Some(b) => {\0a          if b.tag == parse.EX_VAR && (enum_known(prog, b.name) ||\0a              b.name == \22Option\22 || b.name == \22Result\22) {\0a            if enum_variant(prog, b.name, e.name) < 0 &&\0a                !(b.name == \22Option\22 || b.name == \22Result\22) {\0a              eprintf(\22check: unknown variant '{}.{}'\5cn\22, b.name, e.name);\0a              errs.n = errs.n + 1;\0a            }\0a            return;\0a          }\0a        },\0a        Option.None => {},\0a      }\0a    }\0a    match e.lhs {\0a      Option.Some(b) => {\0a        expr_walk(b, prog, mut bound, mut muts, nb, mut errs);\0a      },\0a      Option.None => {},\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_Q {\0a    match e.lhs {\0a      Option.Some(inner) => {\0a        expr_walk(inner, prog, mut bound, mut muts, nb, mut errs);\0a      },\0a      Option.None => {},\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_MATCH {\0a    match e.lhs {\0a      Option.Some(sc) => {\0a        expr_walk(sc, prog, mut bound, mut muts, nb, mut errs);\0a      },\0a      Option.None => {},\0a    }\0a    let mut k: usize = 0;\0a    while k < len(e.marms) {\0a      walk_arm(e.marms[k], prog, mut bound, mut muts, nb, mut errs);\0a      k = k + 1;\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_MCALL {\0a    let mut assoc: bool = false;\0a    // \c2\a718: markers pair on real methods and associated fns only \e2\80\94\0a    // enum constructors, weak.from, and the zero-arg builtin faces\0a    // never pair in boot\0a    let mut pair: bool = false;\0a    match e.lhs {\0a      Option.Some(r) => {\0a        if r.tag == parse.EX_VAR && (enum_known(prog, r.name) ||\0a            r.name == \22Option\22 || r.name == \22Result\22) {\0a          // Enum.Var / Enum.Var(args) \e2\80\94 the constructor call (the\0a          // two builtins ride the same path)\0a          assoc = true;\0a          if enum_variant(prog, r.name, e.name) < 0 &&\0a              !(r.name == \22Option\22 || r.name == \22Result\22) {\0a            eprintf(\22check: unknown variant '{}.{}'\5cn\22, r.name, e.name);\0a            errs.n = errs.n + 1;\0a          }\0a        } else {\0a        if e.name == \22to_str\22 {\0a          // the prelude's to_str rides every primitive\0a          let mut ka: usize = 0;\0a          while ka < len(e.args) {\0a            expr_walk(e.args[ka], prog, mut bound, mut muts, nb, mut errs);\0a            ka = ka + 1;\0a          }\0a          return;\0a        }\0a        if r.tag == parse.EX_VAR && r.name == \22weak\22 {\0a          // weak.from(p) \e2\80\94 the namespace's one builtin (get() rides\0a          // the method surface below)\0a          if e.name != \22from\22 {\0a            eprintf(\22check: unknown fn 'weak.{}'\5cn\22, e.name);\0a            errs.n = errs.n + 1;\0a          }\0a        } else {\0a        if r.tag == parse.EX_VAR && struct_known(prog, r.name) {\0a          // Type.name(args) \e2\80\94 the associated-fn call; the type itself\0a          // is not a variable reference\0a          assoc = true;\0a          if !fn_named(prog, r.name + \22.\22 + e.name) {\0a            eprintf(\22check: unknown fn '{}.{}'\5cn\22, r.name, e.name);\0a            errs.n = errs.n + 1;\0a          }\0a          pair = true;\0a        } else {\0a          expr_walk(r, prog, mut bound, mut muts, nb, mut errs);\0a          if !method_known(prog, e.name) {\0a            eprintf(\22check: unknown method '{}'\5cn\22, e.name);\0a            errs.n = errs.n + 1;\0a          }\0a          if e.name != \22get\22 && e.name != \22is_some\22 &&\0a              e.name != \22is_none\22 && e.name != \22is_ok\22 &&\0a              e.name != \22is_err\22 {\0a            pair = true;\0a          }\0a        }\0a        }\0a        }\0a      },\0a      Option.None => {},\0a    }\0a    let mut k: usize = 0;\0a    while k < len(e.args) {\0a      if pair {\0a        marker_law(e.args[k], bound, muts, nb, mut errs);\0a      }\0a      expr_walk(e.args[k], prog, mut bound, mut muts, nb, mut errs);\0a      k = k + 1;\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_CLO {\0a    // a closure literal: its body binds its own params and captures\0a    // (the emitter resolves captures against the enclosing env)\0a    return;\0a  }\0a  if e.tag == parse.EX_CALL {\0a    // call-on-call: the callee is an expression, not a name \e2\80\94 walk it\0a    if len(e.name) == 0 {\0a      match e.lhs {\0a        Option.Some(callee) => {\0a          expr_walk(callee, prog, mut bound, mut muts, nb, mut errs);\0a        },\0a        Option.None => {},\0a      }\0a      let mut k3: usize = 0;\0a      while k3 < len(e.args) {\0a        // \c2\a718: boot pairs markers against the fn-value signature \e2\80\94\0a        // the root-binding tail rides here\0a        marker_law(e.args[k3], bound, muts, nb, mut errs);\0a        expr_walk(e.args[k3], prog, mut bound, mut muts, nb, mut errs);\0a        k3 = k3 + 1;\0a      }\0a      return;\0a    }\0a    // a locally-bound name (a closure value) is callable\0a    let mut isbound: bool = false;\0a    let mut b: usize = 0;\0a    while b < nb {\0a      if bound[b] == e.name {\0a        isbound = true;\0a      }\0a      b = b + 1;\0a    }\0a    if !isbound && !name_known(prog, e.name) {\0a      eprintf(\22check: unknown fn '{}'\5cn\22, e.name);\0a      errs.n = errs.n + 1;\0a    }\0a    // \c2\a718: markers pair against a DECLARED fn's signature (builtins\0a    // and fn values never pair in boot) \e2\80\94 the root-binding tail\0a    if !isbound && user_fn_named(prog, e.name) {\0a      let mut kp: usize = 0;\0a      while kp < len(e.args) {\0a        marker_law(e.args[kp], bound, muts, nb, mut errs);\0a        kp = kp + 1;\0a      }\0a    }\0a    let mut k: usize = 0;\0a    while k < len(e.args) {\0a      expr_walk(e.args[k], prog, mut bound, mut muts, nb, mut errs);\0a      k = k + 1;\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_VAR {\0a    let mut hit: bool = false;\0a    let mut k: usize = 0;\0a    while k < nb {\0a      if bound[k] == e.name {\0a        hit = true;\0a      }\0a      k = k + 1;\0a    }\0a    let mut g: usize = 0;\0a    while g < prog.nconsts {\0a      if prog.consts[g] == e.name {\0a        hit = true;\0a      }\0a      g = g + 1;\0a    }\0a    if !hit && !name_known(prog, e.name) {\0a      // a plain fn's name is a value (the trampoline pair)\0a      eprintf(\22check: unknown name '{}'\5cn\22, e.name);\0a      errs.n = errs.n + 1;\0a    }\0a    return;\0a  }\0a  match e.lhs {\0a    Option.Some(l) => {\0a      expr_walk(l, prog, mut bound, mut muts, nb, mut errs);\0a    },\0a    Option.None => {},\0a  }\0a  match e.rhs {\0a    Option.Some(r) => {\0a      expr_walk(r, prog, mut bound, mut muts, nb, mut errs);\0a    },\0a    Option.None => {},\0a  }\0a}\0a\0a// a pattern's binder-name collector: the walker threads it by\0a// pointer, growing the table on demand (a fixed cap was the same\0a// out-of-bounds class the param and arg tables held before it)\0astruct NameBox {\0a  names: []string,\0a  n: usize,\0a}\0a\0a// one pattern's binder names, in order (nested payloads recurse; an\0a// or-pattern's alternatives ride the identical-binder law and then\0a// all collect \e2\80\94 duplicate names in the scope are harmless lookups)\0afn pat_binders_into(p: *Pat, mut b: *NameBox) {\0a  if p.kind == 3 {\0a    if b.n >= len(b.names) {\0a      let mut big: []string = make([]string, len(b.names) * 2);\0a      let mut i: usize = 0;\0a      while i < len(b.names) {\0a        big[i] = b.names[i];\0a        i = i + 1;\0a      }\0a      b.names = big;\0a    }\0a    b.names[b.n] = p.name;\0a    b.n = b.n + 1;\0a    return;\0a  }\0a  if p.kind == 4 {\0a    let mut a: usize = 0;\0a    while a < len(p.alts) {\0a      pat_binders_into(p.alts[a], mut b);\0a      a = a + 1;\0a    }\0a    return;\0a  }\0a  if p.kind == 2 {\0a    let mut k: usize = 0;\0a    while k < len(p.subs) {\0a      pat_binders_into(p.subs[k], mut b);\0a      k = k + 1;\0a    }\0a    return;\0a  }\0a}\0a\0afn walk_arm(a: *MatchArm, prog: *Prog, mut bound: []string,\0a            mut muts: []bool, nb0: usize, mut errs: *ErrBox) {\0a  let mut nb: usize = nb0;\0a  // the outer slot the binders are about to take may hold a live\0a  // outer name \e2\80\94 put it back when the arm's scope closes\0a  let mut save_n: string = \22\22;\0a  let mut save_m: bool = false;\0a  if nb < len(bound) {\0a    save_n = bound[nb];\0a    save_m = muts[nb];\0a  }\0a  // \c2\a719's identical-binder law: every or-alternative binds the same\0a  // name set \e2\80\94 count and membership \e2\80\94 else the checker refuses\0a  if a.pat.kind == 4 && len(a.pat.alts) > 1 {\0a    let mut b0 = new NameBox { names: make([]string, 8), n: 0 };\0a    pat_binders_into(a.pat.alts[0], mut b0);\0a    let mut ai: usize = 1;\0a    while ai < len(a.pat.alts) {\0a      let mut bi = new NameBox { names: make([]string, 8), n: 0 };\0a      pat_binders_into(a.pat.alts[ai], mut bi);\0a      if bi.n != b0.n {\0a        eprintf(\22check: or-pattern alternatives bind different names\5cn\22);\0a        errs.n = errs.n + 1;\0a      } else {\0a        let mut x: usize = 0;\0a        while x < bi.n {\0a          let mut hit: bool = false;\0a          let mut y: usize = 0;\0a          while y < b0.n {\0a            if b0.names[y] == bi.names[x] {\0a              hit = true;\0a            }\0a            y = y + 1;\0a          }\0a          if !hit {\0a            eprintf(\22check: or-pattern alternatives bind different names\5cn\22);\0a            errs.n = errs.n + 1;\0a          }\0a          x = x + 1;\0a        }\0a      }\0a      ai = ai + 1;\0a    }\0a  }\0a  let mut nb_all = new NameBox { names: make([]string, 8), n: 0 };\0a  pat_binders_into(a.pat, mut nb_all);\0a  let mut k: usize = 0;\0a  while k < nb_all.n {\0a    if nb < len(bound) {\0a      bound[nb] = nb_all.names[k];\0a      muts[nb] = false; // a binder is a let without mut\0a      nb = nb + 1;\0a    }\0a    k = k + 1;\0a  }\0a  match a.guard {\0a    Option.Some(gd) => {\0a      // the \c2\a719 guard evaluates after the pattern matches, in scope\0a      // of its bindings: the guard's names resolve against the\0a      // pattern's binders\0a      expr_walk(gd, prog, mut bound, mut muts, nb, mut errs);\0a    },\0a    Option.None => {},\0a  }\0a  // the block arm's statements walk with the binders in scope, the\0a  // tail expression riding as a final statement (its names resolve\0a  // against the block's own lets)\0a  match a.val {\0a    Option.Some(v) => {\0a      let mut all: []*Stmt = make([]*Stmt, len(a.body) + 1);\0a      let mut q: usize = 0;\0a      while q < len(a.body) {\0a        all[q] = a.body[q];\0a        q = q + 1;\0a      }\0a      all[q] = parse.wrap_expr_stmt(v);\0a      stmts_walk(all, prog, mut bound, mut muts, nb,\0a                 mut make([]string, 32), 0, mut errs);\0a    },\0a    Option.None => {\0a      stmts_walk(a.body, prog, mut bound, mut muts, nb,\0a                 mut make([]string, 32), 0, mut errs);\0a    },\0a  }\0a  if nb0 < len(bound) {\0a    bound[nb0] = save_n;\0a    muts[nb0] = save_m;\0a  }\0a}\0a\0a// The assignment law (\c2\a718): every write target must be a mut binding.\0a// A let without mut, a non-mut parameter, or a match binder refuses\0a// with boot's exact diagnostic, pointed at the lvalue; a const refuses\0a// its own way; a static mut is the law's one global write target.\0a// Returns whether the name is known at all (bound, const, or static).\0afn assign_law(prog: *Prog, name: string, line: i32, col: i32,\0a              bound: []string, muts: []bool, nb: usize,\0a              mut errs: *ErrBox) -> bool {\0a  let mut k: usize = 0;\0a  let mut hit: bool = false;\0a  let mut m: bool = false;\0a  while k < nb {\0a    if bound[k] == name {\0a      hit = true;\0a      m = muts[k];\0a    }\0a    k = k + 1;\0a  }\0a  if hit {\0a    if !m {\0a      eprintf(\22main.rho:{}:{}: error: '{}' is immutable (declare with let mut)\5cn\22,\0a              line as i64, col as i64, name);\0a      errs.n = errs.n + 1;\0a    }\0a    return true;\0a  }\0a  let mut ci: usize = 0;\0a  while ci < prog.nconsts {\0a    if prog.consts[ci] == name {\0a      if !prog.cstatic[ci] {\0a        eprintf(\22main.rho:{}:{}: error: cannot assign to const '{}'\5cn\22,\0a                line as i64, col as i64, name);\0a        errs.n = errs.n + 1;\0a      }\0a      return true;\0a    }\0a    ci = ci + 1;\0a  }\0a  return false;\0a}\0a\0a// a fn the PROGRAM declares \e2\80\94 plain or name[..](\e2\80\a6) targs spelling.\0a// Boot pairs call-site markers against a DECLARED fn's signature;\0a// builtins and fn values never pair, so the marker law stays off\0a// their faces\0afn user_fn_named(prog: *Prog, name: string) -> bool {\0a  if fn_named(prog, name) {\0a    return true;\0a  }\0a  if parse.has_targs(name) {\0a    return fn_named(prog, parse.targs_base(name));\0a  }\0a  return false;\0a}\0a\0a// the mut-ness of the root binding a marked argument's view hangs\0a// from (\c2\a718) \e2\80\94 the name-level twin of boot's root_binding_mut: paths\0a// resolve through the muts table (last hit wins, the innermost\0a// scope); an unbound name is a const, a static, or unknown (their\0a// own laws govern, never this one)\0afn root_mut(name: string, bound: []string, muts: []bool,\0a            nb: usize) -> bool {\0a  let mut k: usize = 0;\0a  let mut hit: bool = false;\0a  let mut m: bool = true;\0a  while k < nb {\0a    if bound[k] == name {\0a      hit = true;\0a      m = muts[k];\0a    }\0a    k = k + 1;\0a  }\0a  if hit {\0a    return m;\0a  }\0a  return true;\0a}\0a\0a// \c2\a718 at the call site: a marked argument's root binding must be mut\0a// (boot's pair_arg_markers tail \e2\80\94 the view would let the callee store\0a// through a binding the caller itself cannot store through). The root\0a// walk follows field/index chains to the path; a deref or a temporary\0a// is its own (mut) root, exactly like boot's root_binding_mut. The\0a// diagnostic anchors at the token after the argument, boot-exact.\0afn marker_law(e: *Expr, bound: []string, muts: []bool, nb: usize,\0a              mut errs: *ErrBox) {\0a  if !e.amut {\0a    return;\0a  }\0a  let mut root: *Expr = e;\0a  let mut guard: usize = 0;\0a  while guard < 64 {\0a    if root.tag == parse.EX_FIELD || root.tag == parse.EX_IDX {\0a      match root.lhs {\0a        Option.Some(b) => {\0a          root = b;\0a        },\0a        Option.None => {\0a          return;\0a        },\0a      }\0a    } else {\0a      break;\0a    }\0a    guard = guard + 1;\0a  }\0a  if root.tag != parse.EX_VAR {\0a    return;\0a  }\0a  if !root_mut(root.name, bound, muts, nb) {\0a    eprintf(\22main.rho:{}:{}: error: the marked argument needs a mut root binding (declare the binding with let mut)\5cn\22,\0a            e.aline as i64, e.acol as i64);\0a    errs.n = errs.n + 1;\0a  }\0a}\0a\0afn label_known(labels: []string, nl: usize, name: string) -> bool {\0a  let mut k: usize = 0;\0a  while k < nl {\0a    if labels[k] == name {\0a      return true;\0a    }\0a    k = k + 1;\0a  }\0a  return false;\0a}\0a\0afn stmts_walk(nodes: []*Stmt, prog: *Prog, mut bound: []string,\0a              mut muts: []bool, nb0: usize, mut labels: []string, nl0: usize,\0a              mut errs: *ErrBox) {\0a  let mut nb: usize = nb0;\0a  let mut nl: usize = nl0;\0a  let mut i: usize = 0;\0a  while i < len(nodes) {\0a    let mut st = nodes[i];\0a    // the assignment law runs before anything else about the stmt\0a    if st.tag == parse.ST_SET || st.tag == parse.ST_ISTORE ||\0a        st.tag == parse.ST_FSTORE {\0a      if !assign_law(prog, st.name, st.line, st.col, bound, muts, nb,\0a                     mut errs) {\0a        eprintf(\22check: unknown name '{}'\5cn\22, st.name);\0a        errs.n = errs.n + 1;\0a      }\0a    }\0a    if st.tag == parse.ST_LET || st.tag == parse.ST_SET ||\0a        st.tag == parse.ST_CALL || st.tag == parse.ST_RET ||\0a        st.tag == parse.ST_FSTORE {\0a      match st.val {\0a        Option.Some(e) => {\0a          expr_walk(e, prog, mut bound, mut muts, nb, mut errs);\0a        },\0a        Option.None => {},\0a      }\0a      if st.tag == parse.ST_LET {\0a        // the literal lanes: a string literal cannot initialize a\0a        // non-string binding, a bool literal a non-bool one \e2\80\94 the\0a        // boot-exact primary diagnostic, pointed at the value\0a        match st.val {\0a          Option.Some(e2) => {\0a            let ty: string = st.fmt;\0a            if len(ty) > 0 && e2.tag == parse.EX_STR && ty != \22string\22 {\0a              eprintf(\22main.rho:{}:{}: error: expected {}, found string\5cn\22,\0a                      st.init_line as i64, st.init_col as i64, ty);\0a              errs.n = errs.n + 1;\0a            }\0a            if len(ty) > 0 && e2.tag == parse.EX_LIT &&\0a                (e2.name == \22true\22 || e2.name == \22false\22) && ty != \22bool\22 {\0a              eprintf(\22main.rho:{}:{}: error: expected {}, found bool\5cn\22,\0a                      st.init_line as i64, st.init_col as i64, ty);\0a              errs.n = errs.n + 1;\0a            }\0a          },\0a          Option.None => {},\0a        }\0a      }\0a      if st.tag == parse.ST_LET {\0a        // a let introduces the binding; an assignment (ST_SET) binds\0a        // nothing \e2\80\94 the law reads the binding it already finds\0a        if nb < len(bound) {\0a          bound[nb] = st.name;\0a          muts[nb] = st.ret == 1; // the mut flag rides the ret slot\0a          nb = nb + 1;\0a        }\0a      }\0a      if st.tag == parse.ST_FSTORE {\0a        // the base's law ran at the head (assignment law + unknown\0a        // name); what remains is the store's own operands\0a        let mut q: usize = 0;\0a        while q < len(st.args) {\0a          expr_walk(st.args[q], prog, mut bound, mut muts, nb, mut errs);\0a          q = q + 1;\0a        }\0a      }\0a    }\0a    if st.tag == parse.ST_PF {\0a      let mut k: usize = 0;\0a      while k < len(st.args) {\0a        expr_walk(st.args[k], prog, mut bound, mut muts, nb, mut errs);\0a        k = k + 1;\0a      }\0a    }\0a    if st.tag == parse.ST_MATCH {\0a      match st.val {\0a        Option.Some(sc) => {\0a          expr_walk(sc, prog, mut bound, mut muts, nb, mut errs);\0a        },\0a        Option.None => {},\0a      }\0a      let mut k: usize = 0;\0a      while k < len(st.marms) {\0a        walk_arm(st.marms[k], prog, mut bound, mut muts, nb, mut errs);\0a        k = k + 1;\0a      }\0a    }\0a    if st.tag == parse.ST_DEFER {\0a      match st.sub {\0a        Option.Some(inner) => {\0a          // the deferred scope: slot nb may hold a live outer name\0a          let mut save_n: string = \22\22;\0a          let mut save_m: bool = false;\0a          if nb < len(bound) {\0a            save_n = bound[nb];\0a            save_m = muts[nb];\0a          }\0a          let mut one: []*Stmt = make([]*Stmt, 1);\0a          one[0] = inner;\0a          stmts_walk(one, prog, mut bound, mut muts, nb, mut labels, nl, mut errs);\0a          if nb < len(bound) {\0a            bound[nb] = save_n;\0a            muts[nb] = save_m;\0a          }\0a        },\0a        Option.None => {},\0a      }\0a    }\0a    if st.tag == parse.ST_ISTORE {\0a      let mut k: usize = 0;\0a      while k < len(st.args) {\0a        expr_walk(st.args[k], prog, mut bound, mut muts, nb, mut errs);\0a        k = k + 1;\0a      }\0a      match st.val {\0a        Option.Some(e) => {\0a          expr_walk(e, prog, mut bound, mut muts, nb, mut errs);\0a        },\0a        Option.None => {},\0a      }\0a    }\0a    if st.tag == parse.ST_IF {\0a      match st.val {\0a        Option.Some(e) => {\0a          expr_walk(e, prog, mut bound, mut muts, nb, mut errs);\0a        },\0a        Option.None => {},\0a      }\0a      // each branch scope: put back the outer slot the branch may take\0a      let mut save_n: string = \22\22;\0a      let mut save_m: bool = false;\0a      if nb < len(bound) {\0a        save_n = bound[nb];\0a        save_m = muts[nb];\0a      }\0a      stmts_walk(st.body, prog, mut bound, mut muts, nb, mut labels, nl, mut errs);\0a      if nb < len(bound) {\0a        bound[nb] = save_n;\0a        muts[nb] = save_m;\0a      }\0a      stmts_walk(st.body2, prog, mut bound, mut muts, nb, mut labels, nl, mut errs);\0a      if nb < len(bound) {\0a        bound[nb] = save_n;\0a        muts[nb] = save_m;\0a      }\0a    }\0a    if st.tag == parse.ST_WHILE {\0a      match st.val {\0a        Option.Some(e) => {\0a          expr_walk(e, prog, mut bound, mut muts, nb, mut errs);\0a        },\0a        Option.None => {},\0a      }\0a      if len(st.name) > 0 {\0a        if nl < len(labels) {\0a          labels[nl] = st.name;\0a          nl = nl + 1;\0a        }\0a      }\0a      let mut save_n: string = \22\22;\0a      let mut save_m: bool = false;\0a      if nb < len(bound) {\0a        save_n = bound[nb];\0a        save_m = muts[nb];\0a      }\0a      stmts_walk(st.body, prog, mut bound, mut muts, nb, mut labels, nl, mut errs);\0a      if nb < len(bound) {\0a        bound[nb] = save_n;\0a        muts[nb] = save_m;\0a      }\0a    }\0a    if st.tag == parse.ST_LOOP {\0a      if len(st.name) > 0 {\0a        if nl < len(labels) {\0a          labels[nl] = st.name;\0a          nl = nl + 1;\0a        }\0a      }\0a      let mut save_n: string = \22\22;\0a      let mut save_m: bool = false;\0a      if nb < len(bound) {\0a        save_n = bound[nb];\0a        save_m = muts[nb];\0a      }\0a      stmts_walk(st.body, prog, mut bound, mut muts, nb, mut labels, nl, mut errs);\0a      if nb < len(bound) {\0a        bound[nb] = save_n;\0a        muts[nb] = save_m;\0a      }\0a    }\0a    // break/continue bind no names; a named jump must target an\0a    // enclosing label (the stack holds exactly the enclosing ones)\0a    if (st.tag == parse.ST_BREAK || st.tag == parse.ST_CONT) &&\0a        len(st.name) > 0 {\0a      if !label_known(labels, nl, st.name) {\0a        eprintf(\22check: unknown label '{}'\5cn\22, st.name);\0a        errs.n = errs.n + 1;\0a      }\0a    }\0a    i = i + 1;\0a  }\0a}\0a\0a// returns the error count; zero = clean\0apub fn check(prog: *Prog) -> i64 {\0a  let mut errs_box = new_errbox();\0a  let mut nf: usize = 0;\0a  while nf < len(prog.fns) {\0a    let fd0: *FnDef = prog.fns[nf];\0a    let mut bound: []string = make([]string, 64);\0a    let mut muts: []bool = make([]bool, 64);\0a    let mut k: usize = 0;\0a    while k < len(fd0.params) {\0a      bound[k] = fd0.params[k];\0a      muts[k] = fd0.pmut[k]; // a mut view grants the writes (\c2\a718)\0a      k = k + 1;\0a    }\0a    let mut labels: []string = make([]string, 32);\0a    stmts_walk(fd0.body, prog, mut bound, mut muts, k, mut labels, 0, mut errs_box);\0a    nf = nf + 1;\0a  }\0a  let mut bound: []string = make([]string, 64);\0a  let mut muts: []bool = make([]bool, 64);\0a  let mut labels: []string = make([]string, 32);\0a  stmts_walk(prog.main, prog, mut bound, mut muts, 0, mut labels, 0, mut errs_box);\0a  return errs_box.n;\0a}\0a\0astruct ErrBox {\0a  n: i64,\0a}\0a\0apub fn new_errbox() -> *ErrBox {\0a  return new ErrBox { n: 0 };\0a}\0a\0a@MOD@ emit.rho\0a// emit.rho \e2\80\94 the self-hosted compiler's wasm emitter (T2.2 growth).\0a// Statements: printf pieces ride a string pool, integer expressions\0a// compile to i64 stack code into _start locals (let bindings get one\0a// local each), and the generated module carries the decimal runtime.\0ause parse;\0ause lex;\0a\0apub struct Pool {\0a  segs: []string, // raw spans (escapes still encoded)\0a  lens: []i64,    // decoded byte lengths\0a  addrs: []i64,\0a  n: usize,\0a  next: i64,\0a  gi: *GenInsts, // the generic-instantiation worklist (set by emit)\0a  rel_names: []string, // release-thunk registry (per managed type)\0a  rel_texts: []string, // their emitted WAT\0a  rel_n: usize,\0a  has_io: bool, // the program touched the __ face: emit the io tail\0a}\0a\0a// generic instantiation registry: each distinct (fn, type key) pair\0a// clones the fn with its type parameters bound; the worklist drains\0a// after the user's fns (an instantiation may call more generics).\0a// Closure entries ride here too: bases \22clo:<wat>\22 with the body,\0a// captures, and params in the parallel arrays, emitted by\0a// emit_closure_fn instead of emit_fn\0astruct GenInsts {\0a  bases: []string, // the generic fn's name (or \22clo:<wat name>\22)\0a  keys: []string,  // the mangled type key\0a  sufs: []string,  // the wasm suffix riding the fn name\0a  fds: []*FnDef,   // the substituted clones (closure entries: none)\0a  clo_fds: []*FnDef, // closure carriers: .body holds the literal's\0a                     // statements (a field assign, not an index)\0a  clo_caps: []string,  // closure capture names (8 per entry, base idx*8)\0a  clo_params: []string, // closure param names (8 per entry)\0a  ids: []i64,        // per entry: the closure's table idx (0 generic)\0a  n: usize,\0a  cfn: usize,      // closure table entries (names in clo_wasms)\0a  clo_wasms: []string,\0a  clo_ty: []i64,   // indirect-call arity flags: +1 scalar result,\0a                   // +2 pair result \e2\80\94 [1]=fn(), [2]=fn(x), [3]=fn(x,y)\0a}\0a\0afn clo_ty_need(mut gi: *GenInsts, ari: i64, kind: i64) {\0a  if ari < 1 || ari > 3 {\0a    return;\0a  }\0a  let old: i64 = gi.clo_ty[ari as usize];\0a  if kind == 1 {\0a    if old == 0 || old == 2 {\0a      gi.clo_ty[ari as usize] = old + 1;\0a    }\0a  } else {\0a    if old == 0 || old == 1 {\0a      gi.clo_ty[ari as usize] = old + 2;\0a    }\0a  }\0a}\0a\0afn ginsts_new() -> *GenInsts {\0a  return new GenInsts { bases: make([]string, 512), keys: make([]string, 512),\0a                        sufs: make([]string, 512), fds: make([]*FnDef, 512),\0a                        clo_fds: make([]*FnDef, 512),\0a                        clo_caps: make([]string, 4096),\0a                        clo_params: make([]string, 4096),\0a                        ids: make([]i64, 512),\0a                        n: 0, cfn: 0,\0a                        clo_wasms: make([]string, 512),\0a                        clo_ty: make([]i64, 4) };\0a}\0a\0apub fn new_pool() -> *Pool {\0a  return new Pool { segs: make([]string, 2048), lens: make([]i64, 2048),\0a                    addrs: make([]i64, 2048), n: 0, next: 4104,\0a                    gi: ginsts_new(),\0a                    rel_names: make([]string, 2048),\0a                    rel_texts: make([]string, 2048), rel_n: 0,\0a                    has_io: false };\0a}\0a\0a// a hex digit's value, -1 when not hex\0afn hex_val(b: u8) -> i64 {\0a  if b >= 48 && b <= 57 {\0a    return (b as i64) - 48;\0a  }\0a  if b >= 97 && b <= 102 {\0a    return (b as i64) - 87;\0a  }\0a  if b >= 65 && b <= 70 {\0a    return (b as i64) - 55;\0a  }\0a  return 0 - 1;\0a}\0a\0a// the utf-8 byte length of a code point\0afn utf8_len(cp: i64) -> i64 {\0a  if cp < 128 {\0a    return 1;\0a  }\0a  if cp < 2048 {\0a    return 2;\0a  }\0a  if cp < 65536 {\0a    return 3;\0a  }\0a  return 4;\0a}\0a\0a// decoded byte count of a raw span (the full escape law: \5cn \5cr \5ct\0a// \5c\5c \5c\22 \5c0 \5cxHH \5cu{\e2\80\a6})\0afn decoded_len(raw: string) -> i64 {\0a  let mut n: i64 = 0;\0a  let mut i: usize = 0;\0a  while i < len(raw) {\0a    if raw[i] == 92 && i + 1 < len(raw) {\0a      let mut e: u8 = raw[i + 1];\0a      if e == 120 && i + 3 < len(raw) {\0a        i = i + 4; // \5cxHH\0a      } else {\0a        if e == 117 {\0a          // \5cu{hex\e2\80\a6}\0a          let mut j: usize = i + 3;\0a          let mut cp: i64 = 0;\0a          while j < len(raw) && raw[j] != 125 {\0a            let h: i64 = hex_val(raw[j]);\0a            if h < 0 {\0a              break;\0a            }\0a            cp = cp * 16 + h;\0a            j = j + 1;\0a          }\0a          n = n + utf8_len(cp) - 1;\0a          i = j + 1;\0a          n = n + 1;\0a          continue;\0a        } else {\0a          i = i + 2;\0a        }\0a      }\0a    } else {\0a      i = i + 1;\0a    }\0a    n = n + 1;\0a  }\0a  return n;\0a}\0a\0a// the decoded bytes of a raw span (escapes resolved to their bytes) \e2\80\94\0a// the pool's dedup key beyond the raw spelling itself\0afn decode_raw(raw: string) -> string {\0a  let mut out: string = \22\22;\0a  let mut i: usize = 0;\0a  while i < len(raw) {\0a    if raw[i] == 92 && i + 1 < len(raw) {\0a      let mut e: u8 = raw[i + 1];\0a      if e == 120 && i + 3 < len(raw) {\0a        let hi: i64 = hex_val(raw[i + 2]);\0a        let lo: i64 = hex_val(raw[i + 3]);\0a        out = out + byte_escape(((hi * 16 + lo) as u8));\0a        i = i + 4;\0a        continue;\0a      }\0a      if e == 117 {\0a        let mut j: usize = i + 3;\0a        let mut cp: i64 = 0;\0a        while j < len(raw) && raw[j] != 125 {\0a          let h: i64 = hex_val(raw[j]);\0a          if h < 0 {\0a            break;\0a          }\0a          cp = cp * 16 + h;\0a          j = j + 1;\0a        }\0a        out = out + utf8_escape(cp);\0a        i = j + 1;\0a        continue;\0a      }\0a      e = match e {\0a        110 => 10,\0a        116 => 9,\0a        114 => 13,\0a        48 => 0,\0a        92 => 92,\0a        34 => 34,\0a        _ => e,\0a      };\0a      out = out + byte_escape(e);\0a      i = i + 2;\0a      continue;\0a    }\0a    out = out + byte_escape(raw[i]);\0a    i = i + 1;\0a  }\0a  return out;\0a}\0a\0a// the pool tables grow on demand \e2\80\94 the fixed 2048 was an\0a// out-of-bounds write the day the source's distinct string literals\0a// crossed the cap (the writes clobbered arena neighbors: AST nodes\0a// read back with corrupted tags and the chain's determinism leg\0a// caught the divergence)\0afn pool_grow(mut p: *Pool) {\0a  if p.n < len(p.segs) {\0a    return;\0a  }\0a  let mut ns: []string = make([]string, len(p.segs) * 2);\0a  let mut nl: []i64 = make([]i64, len(p.lens) * 2);\0a  let mut na: []i64 = make([]i64, len(p.addrs) * 2);\0a  let mut i: usize = 0;\0a  while i < len(p.segs) {\0a    ns[i] = p.segs[i];\0a    nl[i] = p.lens[i];\0a    na[i] = p.addrs[i];\0a    i = i + 1;\0a  }\0a  p.segs = ns;\0a  p.lens = nl;\0a  p.addrs = na;\0a}\0a\0apub fn pool_intern(mut p: *Pool, raw: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < p.n {\0a    if p.segs[i] == raw {\0a      return p.addrs[i];\0a    }\0a    i = i + 1;\0a  }\0a  // the same string under another spelling (\22A\22 vs \22\5cx41\22) shares one\0a  // segment: the pool's key is the DECODED content\0a  let dl: i64 = decoded_len(raw);\0a  i = 0;\0a  while i < p.n {\0a    if p.lens[i] == dl && p.segs[i] != raw &&\0a        decode_raw(p.segs[i]) == decode_raw(raw) {\0a      return p.addrs[i];\0a    }\0a    i = i + 1;\0a  }\0a  pool_grow(mut p);\0a  p.segs[p.n] = raw;\0a  p.lens[p.n] = dl;\0a  p.addrs[p.n] = p.next;\0a  p.n = p.n + 1;\0a  p.next = p.next + p.lens[p.n - 1] + 1;\0a  return p.addrs[p.n - 1];\0a}\0a\0apub fn pool_len(p: *Pool, raw: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < p.n {\0a    if p.segs[i] == raw {\0a      return p.lens[i];\0a    }\0a    i = i + 1;\0a  }\0a  // a spelling deduped into another segment: its decoded length is the\0a  // shared segment's length by construction\0a  return decoded_len(raw);\0a}\0a\0a// the WAT data-segment body for a raw span: escapes decoded, every\0a// byte spelled \5cxx (wasm data escapes)\0afn hex_digit(v: u8) -> string {\0a  let s: string = \220123456789abcdef\22;\0a  return s[(v as usize)..((v as usize) + 1)];\0a}\0a\0afn byte_escape(b: u8) -> string {\0a  return \22\5c\5c\22 + hex_digit(b >> 4) + hex_digit(b & 15);\0a}\0a\0a// one code point's utf-8 bytes as \5c\5cxx escapes\0afn utf8_escape(cp: i64) -> string {\0a  let mut out: string = \22\22;\0a  if cp < 128 {\0a    return byte_escape((cp as u8));\0a  }\0a  if cp < 2048 {\0a    return byte_escape(((((cp >> 6) as u64) as u8)) | 192) +\0a           byte_escape(((cp & 63) as u8) | 128);\0a  }\0a  if cp < 65536 {\0a    return byte_escape(((cp >> 12) as u8) | 224) +\0a           byte_escape((((cp >> 6) & 63) as u8) | 128) +\0a           byte_escape(((cp & 63) as u8) | 128);\0a  }\0a  return byte_escape(((cp >> 18) as u8) | 240) +\0a         byte_escape((((cp >> 12) & 63) as u8) | 128) +\0a         byte_escape((((cp >> 6) & 63) as u8) | 128) +\0a         byte_escape(((cp & 63) as u8) | 128);\0a}\0a\0apub fn wat_data_body(raw: string) -> string {\0a  let mut out: string = \22\22;\0a  let mut i: usize = 0;\0a  while i < len(raw) {\0a    let mut b: u8 = raw[i];\0a    if b == 92 && i + 1 < len(raw) {\0a      let mut e: u8 = raw[i + 1];\0a      if e == 114 {\0a        out = out + byte_escape(13); // \5cr\0a        i = i + 2;\0a        continue;\0a      }\0a      if e == 48 {\0a        out = out + byte_escape(0); // \5c0\0a        i = i + 2;\0a        continue;\0a      }\0a      if e == 120 && i + 3 < len(raw) {\0a        let hi: i64 = hex_val(raw[i + 2]);\0a        let lo: i64 = hex_val(raw[i + 3]);\0a        let v: i64 = hi * 16 + lo;\0a        out = out + byte_escape((v as u8)); // \5cxHH\0a        i = i + 4;\0a        continue;\0a      }\0a      if e == 117 {\0a        let mut j: usize = i + 3;\0a        let mut cp: i64 = 0;\0a        while j < len(raw) && raw[j] != 125 {\0a          let h: i64 = hex_val(raw[j]);\0a          if h < 0 {\0a            break;\0a          }\0a          cp = cp * 16 + h;\0a          j = j + 1;\0a        }\0a        out = out + utf8_escape(cp); // \5cu{\e2\80\a6}\0a        i = j + 1;\0a        continue;\0a      }\0a      let v: u8 = match e {\0a        110 => 10,\0a        116 => 9,\0a        92 => 92,\0a        34 => 34,\0a        _ => e,\0a      };\0a      out = out + byte_escape(v);\0a      i = i + 2;\0a      continue;\0a    }\0a    out = out + byte_escape(b);\0a    i = i + 1;\0a  }\0a  return out;\0a}\0a\0a// the decimal runtime the generated module carries: $w_i64 writes\0a// |v|'s digits backward into [2048, 4096) and returns {addr, len}.\0a// Each runtime fn rides its own const (P1): only fns some kept code\0a// calls ride the module \e2\80\94 the reachability filter includes them.\0aconst W_BOOL: string = \22\22\22\0a  (func $w_bool (param