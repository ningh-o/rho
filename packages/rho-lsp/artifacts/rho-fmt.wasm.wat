 emit_expr(mut pool, cond, mut env, mut prog, mut nl);\0a          body = body + \22    (i32.wrap_i64)\5cn    if\5cn\22;\0a          // the body's bindings die with the body (boot's scope law)\0a          let mut wh_mark: usize = env.n;\0a          body = body + emit_stmts(st.body, mut pool, mut env, mut nl, in_fn, ret_slot, mut prog, mut loops, mut dstack, tfd);\0a          env.n = wh_mark;\0a          body = body + \22      (br \22;\0a          body = body + w;\0a          body = body + \22)\5cn\22;\0a          body = body + \22    end\5cn\22;\0a          body = body + \22    )\5cn\22;\0a          body = body + \22    )\5cn\22;\0a          loops_pop(mut loops);\0a            },\0a          }\0a        },\0a        Option.None => {},\0a      }\0a    }\0a    if env.n == senv && env.sn == ssn && env.sel_n == ssel &&\0a        dstack.cursor == sdc {\0a      if nl.v > nl.hi {\0a        nl.hi = nl.v;\0a      }\0a      nl.v = sw;\0a    }\0a    i = i + 1;\0a  }\0a  body = body + dpop_emit(mut dstack);\0a  return body;\0a}\0a\0a// the next-local counter threads through the recursion\0astruct NextLocal {\0a  v: i64,\0a  hi: i64, // the high-water mark: the resets lower v, the prologue\0a           // sizes from the maximum any kept text ever touched\0a}\0a\0a// one user fn: params as i64 locals, an i64 result. wname overrides\0a// the wasm name (overloads ride their signature key); \22\22 derives it\0afn capture_at_after(fd: *FnDef) -> i64 {\0a  let mut n: i64 = 0;\0a  let mut k: usize = 0;\0a  while k < len(fd.params) {\0a    if k < len(fd.pstr) && fd.pstr[k] {\0a      n = n + 2;\0a    } else {\0a      if k < len(fd.ptypes) && is_fn_type(fd.ptypes[k]) {\0a        // a fn-typed param rides its (idx, box) pair\0a        n = n + 2;\0a      } else {\0a        n = n + 1;\0a      }\0a    }\0a    k = k + 1;\0a  }\0a  return n;\0a}\0a\0afn emit_fn(fd: *FnDef, mut pool: *Pool, mut prog: *Prog,\0a           wname: string) -> string {\0a  let mut env = env_new(1024);\0a  env_bind_consts(mut env, prog, mut pool);\0a  let mut nl = new NextLocal { v: 0, hi: 0 };\0a  let param_slots: i64 = capture_at_after(fd);\0a  let mut nparams: i64 = 0;\0a  let mut k0: usize = 0;\0a  while k0 < len(fd.params) {\0a    if k0 < len(fd.pstr) && fd.pstr[k0] {\0a      nparams = nparams + 2;\0a    } else {\0a      nparams = nparams + 1;\0a    }\0a    k0 = k0 + 1;\0a  }\0a  let mut k: usize = 0;\0a  let mut pre: string = \22\22;\0a  // by-value struct params record here; their frames allocate after\0a  // the $a..$d reservation (fresh locals start past it)\0a  let mut svp_names: []string = make([]string, 8);\0a  let mut svp_types: []string = make([]string, 8);\0a  let mut svp_srcs: []i64 = make([]i64, 8);\0a  let mut svp_n: usize = 0;\0a  while k < len(fd.params) {\0a    if k < len(fd.ptypes) && is_fn_type(fd.ptypes[k]) {\0a      // a closure-typed param: (idx, box) slots, kind 3\0a      env_str_bind_runtime(mut env, fd.params[k], nl.v, nl.v + 1, 3);\0a      nl.v = nl.v + 2;\0a    } else {\0a    if k < len(fd.pstr) && fd.pstr[k] {\0a      let mut kind: i64 = 1;\0a      if k < len(fd.pslc) && fd.pslc[k] {\0a        kind = 2;\0a      }\0a      env_str_bind_runtime(mut env, fd.params[k], nl.v,\0a                           nl.v + 1, kind);\0a      // a slice param carries its element text ([]string and the\0a      // variadic rest alike \e2\80\94 element reads key on it)\0a      if kind == 2 && k < len(fd.ptypes) {\0a        let pt2: string = fd.ptypes[k];\0a        if len(pt2) >= 2 && pt2[0] == 91 && pt2[1] == 93 {\0a          env_bind_sliceelem(mut env, fd.params[k], pt2[2..len(pt2)]);\0a        }\0a      }\0a      nl.v = nl.v + 2;\0a    } else {\0a      let mut pw: i64 = 0;\0a      if k < len(fd.ptypes) {\0a        pw = type_width(fd.ptypes[k]);\0a      }\0a      // a *T param binds as a struct pointer (methods' self rides it);\0a      // an enum-typed param (or ?T / Option[..]) binds the enum lane\0a      let mut pt: string = \22\22;\0a      if k < len(fd.ptypes) {\0a        pt = fd.ptypes[k];\0a      }\0a      let target: string = type_ptr_target(pt);\0a      if is_weak_type(pt) {\0a        // a weak[T] param rides the pointer lane uncounted\0a        env_bind_ptr(mut env, fd.params[k], nl.v,\0a                     \22weak:\22 + weak_target(pt));\0a      } else if len(pt) >= 1 && pt[0] == 63 {\0a        // a ?X param is the option lane (the payload text rides the\0a        // slice-elem table for Some binders)\0a        env_bind_enum(mut env, fd.params[k], nl.v, \22Option\22);\0a        env_bind_sliceelem(mut env, fd.params[k],\0a                           type_ptr_target(pt));\0a      } else if is_ginst_ptr(mut prog, pt) {\0a        // a generic-struct instantiation param (self: *StringMap[string])\0a        // binds with its FULL text \e2\80\94 and BEFORE the value-struct face:\0a        // with st_index resolving starred spellings, a pointer to an\0a        // instantiation once matched the by-value arm and the clone\0a        // copied the whole struct into a scratch frame (self.n += 1\0a        // advanced the copy; the caller's container never grew)\0a        env_bind_ptr(mut env, fd.params[k], nl.v, pt);\0a      } else if len(pt) > 0 && pt[0] != 42 &&\0a          st_index(mut prog, pt) >= 0 && svp_n < 8 {\0a        // a by-value struct param: the lane carries the source's\0a        // address; the prologue (emitted past the $a..$d reservation)\0a        // copies the slots into a fresh frame the binding reads\0a        // (the loop tail advances the lane)\0a        svp_names[svp_n] = fd.params[k];\0a        svp_types[svp_n] = pt;\0a        svp_srcs[svp_n] = nl.v;\0a        svp_n = svp_n + 1;\0a      } else if len(target) > 0 && st_index(mut prog, target) >= 0 {\0a        if fd.params[k] == \22self\22 {\0a        }\0a        env_bind_ptr(mut env, fd.params[k], nl.v, target);\0a      } else {\0a        if pt == \22f64\22 || pt == \22f32\22 {\0a          let mut fk1: i64 = 1;\0a          if pt == \22f32\22 {\0a            fk