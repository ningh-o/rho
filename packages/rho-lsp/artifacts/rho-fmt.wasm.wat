l $w_streq\5cn\22;\0a    out = out + \22    (i32.wrap_i64)\5cn\22;\0a  } else {\0a    out = out + emit_expr(mut pool, a, mut env, mut prog, mut nl);\0a    out = out + emit_expr(mut pool, b, mut env, mut prog, mut nl);\0a    out = out + \22    (i64.eq)\5cn\22;\0a  }\0a  let msg_addr: i64 = pool_intern(mut pool, \22assert_eq failed\22);\0a  out = out + \22    (i32.eqz)\5cn    if\5cn\22;\0a  out = out + \22      (call $w_panic (i32.const \22;\0a  out = out + msg_addr.to_str();\0a  out = out + \22) (i32.const 16))\5cn\22;\0a  out = out + \22    end\5cn\22;\0a  return out;\0a}\0a\0a// panic(msg): the message rides its pool pair straight into the\0a// fatal exit (process-fatal, no recover \e2\80\94 \c2\a74)\0afn emit_panic(mut pool: *Pool, call: *Expr) -> string {\0a  let mut msg: string = \22panic\22;\0a  if len(call.args) >= 1 && call.args[0].tag == parse.EX_STR {\0a    msg = call.args[0].name;\0a  }\0a  let ma: i64 = pool_intern(mut pool, msg);\0a  return \22    (call $w_panic (i32.const \22 + ma.to_str() +\0a         \22) (i32.const \22 + pool_len(pool, msg).to_str() + \22))\5cn\22;\0a}\0a\0a// the assert builtin: a false condition panics with the message\0afn emit_assert(mut pool: *Pool, call: *Expr, mut env: *Env,\0a               mut prog: *Prog, mut nl: *NextLocal) -> string {\0a  let mut cond: *Expr = parse.lit(1);\0a  let mut msg: *Expr = parse.strlit(\22assertion failed\22);\0a  if len(call.args) > 0 {\0a    cond = call.args[0];\0a  }\0a  if len(call.args) > 1 {\0a    msg = call.args[1];\0a  }\0a  let mut out: string = emit_expr(mut pool, cond, mut env, mut prog, mut nl);\0a  // panic when the condition is FALSE\0a  out = out + \22    (i32.wrap_i64)\5cn    (i32.eqz)\5cn    if\5cn\22;\0a  match fold_string(msg, env) {\0a    Option.Some(raw) => {\0a      let addr: i64 = pool_intern(mut pool, raw);\0a      out = out + \22      (call $w_panic (i32.const \22;\0a      out = out + addr.to_str();\0a      out = out + \22) (i32.const \22;\0a      out = out + pool_len(pool, raw).to_str();\0a      out = out + \22))\5cn\22;\0a    },\0a    Option.None => {\0a      out = out + \22      (call $w_panic (i32.const 0) (i32.const 0))\5cn\22;\0a    },\0a  }\0a  out = out + \22    end\5cn\22;\0a  return out;\0a}\0a\0a// printf's hole emission (the statement form and the expression\0a// form share it): EVERY argument evaluates before the first byte\0a// writes (an oob in a later hole must not leave a half line), then\0a// the pieces intern and the holes render by kind\0afn emit_printf(mut pool: *Pool, fmt: string, args: []*Expr, mut env: *Env,\0a               mut prog: *Prog, mut nl: *NextLocal) -> string {\0a  return emit_print_fd(mut pool, fmt, args, mut env, mut prog, mut nl, 1);\0a}\0a\0a// the stderr twin (eprintf): the same walk, fd 2\0afn emit_eprintf(mut pool: *Pool, fmt: string, args: []*Expr, mut env: *Env,\0a                mut prog: *Prog, mut nl: *NextLocal) -> string {\0a  return emit_print_fd(mut pool, fmt, args, mut env, mut prog, mut nl, 2);\0a}\0a\0a// a print/format hole holding a bool prints its word: comparisons and\0a// logicals (incl. the ! desugar's eq-0, op 12), vars bound from one,\0a// bool consts/statics by their written type, and the literals\0a// a match over a ?bool/Result-bool scrutinee (Vec.pop()'s binders):\0a// its value is the payload itself, not a string build\0afn match_is_bool_payload(sc: *Expr, env: *Env, mut prog: *Prog) -> bool {\0a  if sc.tag != parse.EX_MCALL {\0a    return false;\0a  }\0a  let et3: string = expr_enum_type(sc, env, mut prog);\0a  if et3 != \22Option\22 && et3 != \22Result\22 {\0a    return false;\0a  }\0a  let mut rc3: *Expr = parse.lit(0);\0a  match sc.lhs {\0a    Option.Some(r3c) => {\0a      rc3 = r3c;\0a    },\0a    Option.None => {},\0a  }\0a  let rt3: string = method_rtype(mut prog,\0a                                 expr_ptr_type(rc3, env, mut prog),\0a                                 sc.name);\0a  return opt_payload(rt3) == \22bool\22;\0a}\0a\0afn hole_boolish(arg: *Expr, env: *Env, mut prog: *Prog) -> bool {\0a  if arg.tag == parse.EX_BIN &&\0a      ((arg.op >= 5 && arg.op <= 10) || arg.op == 12 ||\0a       arg.op == 13 || arg.op == 14) {\0a    return true;\0a  }\0a  if arg.tag == parse.EX_VAR {\0a    if env_bool_is(env, arg.name) {\0a      return true;\0a    }\0a    let mut i: usize = 0;\0a    while i < prog.nconsts {\0a      if prog.consts[i] == arg.name && prog.ctypes[i] == \22bool\22 {\0a        return true;\0a      }\0a      i = i + 1;\0a    }\0a    return false;\0a  }\0a  if arg.tag == parse.EX_FIELD {\0a    // a field read prints its DECLARED field type: a bool field\0a    // spells the word (box_of(true).v \e2\80\94 the inferred generic's\0a    // payload printed 1/0 once, the bare-tag law again)\0a    let mut b5: *Expr = parse.lit(0);\0a    match arg.lhs {\0a      Option.Some(b6) => {\0a        b5 = b6;\0a      },\0a      Option.None => {},\0a    }\0a    let bt5: string = field_base_type(b5, env, mut prog);\0a    if len(bt5) > 0 {\0a      let si5: i64 = st_index(mut prog, st_name_of(bt5));\0a      if si5 >= 0 {\0a        let fi5: i64 = st_field_index(prog, si5, arg.name);\0a        if fi5 >= 0 {\0a          return prog.structs[si5 as usize].types[fi5 as usize] ==\0a              \22bool\22;\0a        }\0a      }\0a    }\0a    return false;\0a  }\0a  if arg.tag == parse.EX_MCALL {\0a    // the absence faces spell their word; so does any user method\0a    // whose declared return is bool\0a    if arg.name == \22is_some\22 || arg.name == \22is_none\22 ||\0a        arg.name == \22is_ok\22 || arg.name == \22is_err\22 {\0a      return true;\0a    }\0a    match arg.lhs {\0a      Option.Some(r13) => {\0a        let bt13: string = expr_ptr_type(r13, env, mut prog);\0a        if len(bt13) > 0 {\0a          let rt13: string = method_rtype(mut prog, bt13, arg.name);\0a          return rt13 == \22bool\22;\0a        }\0a      },\0a      Option.None => {},\0a    }\0a    return false;\0a  }\0a  if arg.tag == parse.EX_LIT &&\0a      (arg.name == \22true\22 || arg.name == \22false\22) {\0a    return true;\0a  }\0a  if arg.tag == parse.EX_MATCH {\0a    // a match whose every arm spells a bool word prints its word; a\0a    // match on a ?bool scrutinee is bool even when the arms are bare\0a    // binders (the arm tail IS the payload \e2\80\94 Vec.pop()'s binder)\0a    match arg.lhs {\0a      Option.Some(sc2) => {\0a        if match_is_bool_payload(sc2, env, mut prog) {\0a          return true;\0a        }\0a      },\0a      Option.None => {},\0a    }\0a    let mut allb: bool = len(arg.marms) > 0;\0a    let mut k3: usize = 0;\0a    while k3 < len(arg.marms) {\0a      match arg.marms[k3].val {\0a        Option.Some(av3) => {\0a          if !hole_boolish(av3, env, mut prog) {\0a            allb = false;\0a          }\0a        },\0a        Option.None => {\0a          allb = false;\0a        },\0a      }\0a      k3 = k3 + 1;\0a    }\0a    return allb;\0a  }\0a  return false;\0a}\0a\0a// ---- generic instantiation: bind T, clone the body ----\0a\0a// a width value's type name (type_width's inverse for the scalars)\0afn width_name(w: i64) -> string {\0a  if w == 8 {\0a    return \22i8\22;\0a  }\0a  if w == 16 {\0a    return \22i16\22;\0a  }\0a  if w == 32 {\0a    return \22i32\22;\0a  }\0a  if w == 64 {\0a    return \22i64\22;\0a  }\0a  if w == 0 - 8 {\0a    return \22u8\22;\0a  }\0a  if w == 0 - 16 {\0a    return \22u16\22;\0a  }\0a  if w == 0 - 32 {\0a    return \22u32\22;\0a  }\0a  if w == 0 - 64 {\0a    return \22u64\22;\0a  }\0a  return \22i64\22;\0a}\0a\0a// a type text's identifier-safe spelling for wasm names\0afn mangle_type(t: string) -> string {\0a  if len(t) >= 1 && t[0] == 42 {\0a    return \22p\22 + mangle_type(t[1..len(t)]);\0a  }\0a  if len(t) >= 2 && t[0] == 91 && t[1] == 93 {\0a    return \22s\22 + mangle_type(t[2..len(t)]);\0a  }\0a  if len(t) >= 1 && t[0] == 63 {\0a    return \22o\22 + mangle_type(t[1..len(t)]);\0a  }\0a  // Name[a,b] \e2\80\94 the instantiation's args ride in the mangle too\0a  let ob: i64 = open_bracket(t);\0a  if ob >= 0 && t[len(t) - 1..len(t)] == \22]\22 {\0a    let base: string = t[0..(ob as usize)];\0a    let mut parts: []string = split_type_args(\0a        t[((ob as usize) + 1)..(len(t) - 1)]);\0a    let mut out: string = mangle_type(base) + \22x\22;\0a    let mut k: usize = 0;\0a    while k < len(parts) {\0a      if k > 0 {\0a        out = out + \22y\22;\0a      }\0a      out = out + mangle_type(parts[k]);\0a      k = k + 1;\0a    }\0a    return out + \22z\22;\0a  }\0a  return t;\0a}\0a\0afn is_tparam(t: string, tps: []string) -> bool {\0a  let mut k: usize = 0;\0a  while k < len(tps) {\0a    if tps[k] == t {\0a      return true;\0a    }\0a    k = k + 1;\0a  }\0a  return false;\0a}\0a\0afn tsub_type(t: string, tps: []string, tys: []string) -> string {\0a  if is_tparam(t, tps) {\0a    let mut k: usize = 0;\0a    while k < len(tps) {\0a      if tps[k] == t {\0a        if k < len(tys) {\0a          return tys[k];\0a        }\0a      }\0a      k = k + 1;\0a    }\0a  }\0a  // the substitution rides inside prefixes (*T, ?T, []T) and bracket\0a  // args (Name[a,b]) alike\0a  if len(t) >= 2 && t[0] == 91 && t[1] == 93 {\0a    return \22[]\22 + tsub_type(t[2..len(t)], tps, tys);\0a  }\0a  if len(t) >= 1 && (t[0] == 42 || t[0] == 63) {\0a    return t[0..1] + tsub_type(t[1..len(t)], tps, tys);\0a  }\0a  // Name[a1,a2] \e2\80\94 the substitution rides inside the brackets\0a  let ob: i64 = open_bracket(t);\0a  if ob >= 0 && len(t) > 0 && t[len(t) - 1] == 93 {\0a    let base: string = t[0..(ob as usize)];\0a    let inner: string = t[((ob as usize) + 1)..(len(t) - 1)];\0a    let mut parts: []string = split_type_args(inner);\0a    let mut outp: string = \22\22;\0a    let mut k2: usize = 0;\0a    while k2 < len(parts) {\0a      if k2 > 0 {\0a        outp = outp + \22, \22;\0a      }\0a      outp = outp + tsub_type(parts[k2], tps, tys);\0a      k2 = k2 + 1;\0a    }\0a    return tsub_type(base, tps, tys) + \22[\22 + outp + \22]\22;\0a  }\0a  return t;\0a}\0a\0a// the index of the FIRST '[' in a type text, -1 when none\0afn open_bracket(t: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < len(t) {\0a    if t[i] == 91 {\0a      return i as i64;\0a    }\0a    if t[i] == 93 {\0a      return 0 - 1;\0a    }\0a    i = i + 1;\0a  }\0a  return 0 - 1;\0a}\0a\0a// split \22a,b,c\22 at depth-0 commas (bracketed args nest)\0afn split_type_args(s: string) -> []string {\0a  let mut parts: []string = make([]string, 8);\0a  let mut n: usize = 0;\0a  let mut depth: i64 = 0;\0a  let mut cur: string = \22\22;\0a  let mut i: usize = 0;\0a  while i < len(s) {\0a    let mut b: u8 = s[i];\0a    if b == 91 {\0a      depth = depth + 1;\0a    }\0a    if b == 93 {\0a      depth = depth - 1;\0a    }\0a    if b == 44 && depth == 0 && n < 7 {\0a      parts[n] = cur;\0a      n = n + 1;\0a      cur = \22\22;\0a      i = i + 1;\0a      while i < len(s) && s[i] == 32 {\0a        i = i + 1;\0a      }\0a      continue;\0a    }\0a    cur = cur + s[i..(i + 1)];\0a    i = i + 1;\0a  }\0a  if len(cur) > 0 || n > 0 {\0a    if n < 8 {\0a      parts[n] = cur;\0a      n = n + 1;\0a    }\0a  }\0a  return parts[0..n];\0a}\0a\0a// the base name of a type text (everything before the first '[')\0afn type_base(t: string) -> string {\0a  let ob: i64 = open_bracket(t);\0a  if ob >= 0 {\0a    return t[0..(ob as usize)];\0a  }\0a  return t;\0a}\0a\0a// unify a written param type with an argument's type, recording each\0a// type-parameter binding (\22*Pair[A,B]\22 against \22*Pair[i32,i64]\22 binds\0a// A=i32 B=i64; \22?*T\22 against \22?*Node\22 binds T=Node)\0afn unify_type_bind(want: string, got: string, tps: []string,\0a                   mut tys: []string) {\0a  if is_tparam(want, tps) {\0a    let mut k: usize = 0;\0a    while k < len(tps) {\0a      if tps[k] == want && k < len(tys) {\0a        tys[k] = got;\0a      }\0a      k = k + 1;\0a    }\0a    return;\0a  }\0a  let ow: i64 = open_bracket(want);\0a  let og: i64 = open_bracket(got);\0a  if ow >= 0 && og >= 0 && want[len(want) - 1..len(want)] == \22]\22 &&\0a      got[len(got) - 1..len(got)] == \22]\22 {\0a    let bw: string = want[0..(ow as usize)];\0a    let bg: string = got[0..(og as usize)];\0a    if bw == bg {\0a      let pw: []string = split_type_args(\0a          want[((ow as usize) + 1)..(len(want) - 1)]);\0a      let pg: []string = split_type_args(\0a          got[((og as usize) + 1)..(len(got) - 1)]);\0a      let mut k2: usize = 0;\0a      while k2 < len(pw) && k2 < len(pg) {\0a        unify_type_bind(pw[k2], pg[k2], tps, mut tys);\0a        k2 = k2 + 1;\0a      }\0a      return;\0a    }\0a  }\0a  // prefix peeling: *T/?T one char, []T two\0a  if len(want) >= 2 && len(got) >= 2 && want[0] == 91 &&\0a      want[1] == 93 && got[0] == 91 && got[1] == 93 {\0a    unify_type_bind(want[2..len(want)], got[2..len(got)], tps, mut tys);\0a    return;\0a  }\0a  if len(want) >= 1 && len(got) >= 1 && want[0] == got[0] &&\0a      (want[0] == 42 || want[0] == 63) {\0a    unify_type_bind(want[1..len(want)], got[1..len(got)], tps, mut tys);\0a  }\0a}\0a\0a// an expression's canonical type (best effort, exactly what binding\0a// T needs): the scalar names, string, bool, the float kinds, pointers\0a// as *T, enums by name, calls by their written return\0afn expr_type(e: *Expr, env: *Env, prog: *Prog) -> string {\0a  if e.tag == parse.EX_STR {\0a    return \22string\22;\0a  }\0a  if e.tag == parse.EX_FLIT {\0a    return \22f64\22;\0a  }\0a  if e.tag == parse.EX_LIT {\0a    if e.name == \22true\22 || e.name == \22false\22 {\0a      return \22bool\22;\0a    }\0a    return \22i32\22;\0a  }\0a  if e.tag == parse.EX_VAR {\0a    if str_static_is(prog, e.name) {\0a      return \22string\22;\0a    }\0a    let vt: string = env_val_of(env, e.name);\0a    if len(vt) > 0 {\0a      return vt;\0a    }\0a    let pt: string = env_ptr_of(env, e.name);\0a    if len(pt) > 0 {\0a      return \22*\22 + pt;\0a    }\0a    let en2: string = env_enum_of(env, e.name);\0a    if len(en2) > 0 {\0a      return en2;\0a    }\0a    let sk: i64 = env_kind_of(env, e.name);\0a    if sk == 1 {\0a      return \22string\22;\0a    }\0a    if sk == 2 {\0a      // a slice binding types by its element text ([]*Pt and the\0a      // string/slice pairs alike)\0a      let et2: string = env_slice_elemtext(env, e.name);\0a      if len(et2) > 0 {\0a        return \22[]\22 + et2;\0a      }\0a      return \22[]i64\22;\0a    }\0a    if env_fkind_of(env, e.name) == 1 {\0a      return \22f64\22;\0a    }\0a    if env_fkind_of(env, e.name) == 2 {\0a      return \22f32\22;\0a    }\0a    let mut g: usize = 0;\0a    while g < prog.nconsts {\0a      if prog.consts[g] == e.name {\0a        return prog.ctypes[g];\0a      }\0a      g = g + 1;\0a    }\0a    return width_name(env_width_of(env, e.name));\0a  }\0a  if e.tag == parse.EX_BIN && e.op == 11 {\0a    return e.name;\0a  }\0a  if e.tag == parse.EX_NEW {\0a    return \22*\22 + e.name;\0a  }\0a  if e.tag == parse.EX_CALL {\0a    return call_fn_rtype(prog, e, env);\0a  }\0a  if e.tag == parse.EX_BIN {\0a    if e.op >= 5 && e.op <= 14 {\0a      return \22bool\22;\0a    }\0a    let mut lt: string = \22\22;\0a    match e.lhs {\0a      Option.Some(l10) => {\0a        lt = expr_type(l10, env, prog);\0a      },\0a      Option.None => {},\0a    }\0a    if len(lt) > 0 {\0a      return lt;\0a    }\0a    match e.rhs {\0a      Option.Some(r10) => {\0a        return expr_type(r10, env, prog);\0a      },\0a      Option.None => {},\0a    }\0a  }\0a  return \22\22;\0a}\0a\0afn subst_in_expr(mut e: *Expr, tps: []string, tys: []string) {\0a  if e.tag == parse.EX_BIN && e.op == 11 {\0a    e.name = tsub_type(e.name, tps, tys);\0a  }\0a  if e.tag == parse.EX_NEW {\0a    // new Pair[T,T] \e2\80\94 the instantiation's args substitute\0a    e.name = tsub_type(e.name, tps, tys);\0a  }\0a  if e.tag == parse.EX_MAKE {\0a    // make([]T, n) \e2\80\94 the element type rides the name; a cloned\0a    // generic body allocates the CONCRETE element (the wall lift's\0a    // collapse law: the concrete push/insert sets retired the day\0a    // this line landed)\0a    e.name = tsub_type(e.name, tps, tys);\0a  }\0a  match e.lhs {\0a    Option.Some(l11) => {\0a      let mut l11R = l11;\0a      subst_in_expr(mut l11R, tps, tys);\0a    },\0a    Option.None => {},\0a  }\0a  match e.rhs {\0a    Option.Some(r11) => {\0a      let mut r11R = r11;\0a      subst_in_expr(mut r11R, tps, tys);\0a    },\0a    Option.None => {},\0a  }\0a  let mut k: usize = 0;\0a  while k < len(e.args) {\0a    subst_in_expr(mut e.args[k], tps, tys);\0a    k = k + 1;\0a  }\0a  let mut m: usize = 0;\0a  while m < len(e.marms) {\0a    let mut arm = e.marms[m];\0a    let mut q: usize = 0;\0a    while q < len(arm.body) {\0a      subst_in_stmt(mut arm.body[q], tps, tys);\0a      q = q + 1;\0a    }\0a    match arm.val {\0a      Option.Some(av) => {\0a        let mut avR = av;\0a        subst_in_expr(mut avR, tps, tys);\0a      },\0a      Option.None => {},\0a    }\0a    m = m + 1;\0a  }\0a}\0a\0afn subst_in_stmt(mut st: *Stmt, tps: []string, tys: []string) {\0a  st.fmt = tsub_type(st.fmt, tps, tys);\0a  let mut k: usize = 0;\0a  while k < len(st.args) {\0a    subst_in_expr(mut st.args[k], tps, tys);\0a    k = k + 1;\0a  }\0a  match st.val {\0a    Option.Some(v11) => {\0a      let mut v11R = v11;\0a      subst_in_expr(mut v11R, tps, tys);\0a    },\0a    Option.None => {},\0a  }\0a  match st.sub {\0a    Option.Some(s11) => {\0a      let mut s11R = s11;\0a      subst_in_stmt(mut s11R, tps, tys);\0a    },\0a    Option.None => {},\0a  }\0a  let mut b: usize = 0;\0a  while b < len(st.body) {\0a    subst_in_stmt(mut st.body[b], tps, tys);\0a    b = b + 1;\0a  }\0a  let mut b2: usize = 0;\0a  while b2 < len(st.body2) {\0a    subst_in_stmt(mut st.body2[b2], tps, tys);\0a    b2 = b2 + 1;\0a  }\0a}\0a\0afn fn_def_of(prog: *Prog, name: string) -> *FnDef {\0a  let mut i: usize = 0;\0a  while i < len(prog.fns) {\0a    if prog.fns[i].name == name {\0a      return prog.fns[i];\0a    }\0a    i = i + 1;\0a  }\0a  return prog.fns[0];\0a}\0a\0a// ---- overloads: one name, many signatures; exact-match-unique ----\0a\0afn fn_overload_count(prog: *Prog, name: string) -> i64 {\0a  let mut n: i64 = 0;\0a  let mut i: usize = 0;\0a  while i < len(prog.fns) {\0a    if prog.fns[i].name == name {\0a      n = n + 1;\0a    }\0a    i = i + 1;\0a  }\0a  return n;\0a}\0a\0a// a fn's wasm name: alone under its own name; beside its siblings\0a// under the signature key when overloads share the name\0afn wasm_fn_name(prog: *Prog, fd: *FnDef) -> string {\0a  if fn_overload_count(prog, fd.name) <= 1 {\0a    return \22$u_\22 + sym_name(fd.name);\0a  }\0a  let mut key: string = \22\22;\0a  let mut k: usize = 0;\0a  while k < len(fd.ptypes) {\0a    if k > 0 {\0a      key = key + \22_\22;\0a    }\0a    let mut pt: string = fd.ptypes[k];\0a    if len(pt) == 0 {\0a      pt = \22i64\22;\0a    }\0a    key = key + mangle_type(pt);\0a    k = k + 1;\0a  }\0a  return \22$u_\22 + sym_name(fd.name) + \22__\22 + key;\0a}\0a\0a// does an unadapted literal ride into this parameter kind (int lit \e2\86\92\0a// int param of any width, float lit \e2\86\92 float param)?\0afn lit_adapts_into(arg: *Expr, ptype: string) -> bool {\0a  let mut pt: string = ptype;\0a  if len(pt) == 0 {\0a    pt = \22i64\22;\0a  }\0a  if arg.tag == parse.EX_LIT &&\0a      (arg.name == \22true\22 || arg.name == \22false\22) {\0a    return pt == \22bool\22;\0a  }\0a  if arg.tag == parse.EX_LIT {\0a    return type_width(pt) != 0;\0a  }\0a  if arg.tag == parse.EX_FLIT {\0a    return pt == \22f64\22 || pt == \22f32\22;\0a  }\0a  return false;\0a}\0a\0a// resolve a call against the candidate chain: exact param types win,\0a// a literal adapts into any width of its own class; the unique\0a// survivor is the callee (zero or many would be the checker's error \e2\80\94\0a// boot refused nothing here, so the corpus never asks)\0afn resolve_call_fd(prog: *Prog, e: *Expr, env: *Env) -> *FnDef {\0a  if fn_overload_count(prog, e.name) <= 1 {\0a    return fn_def_of(prog, e.name);\0a  }\0a  let mut best: i64 = 0 - 1;\0a  let mut best_exact: bool = false;\0a  let mut i: usize = 0;\0a  while i < len(prog.fns) {\0a    if prog.fns[i].name != e.name ||\0a        len(prog.fns[i].params) != len(e.args) {\0a      i = i + 1;\0a      continue;\0a    }\0a    let fd2: *FnDef = prog.fns[i];\0a    let mut allok: bool = true;\0a    let mut alexact: bool = true;\0a    let mut k: usize = 0;\0a    while k < len(e.args) {\0a      let at: string = expr_type(e.args[k], env, prog);\0a      let mut pt: string = \22\22;\0a      if k < len(fd2.ptypes) {\0a        pt = fd2.ptypes[k];\0a      }\0a      if len(at) > 0 && at == pt {\0a        k = k + 1;\0a        continue;\0a      }\0a      if lit_adapts_into(e.args[k], pt) {\0a        alexact = false;\0a      } else {\0a        allok = false;\0a      }\0a      k = k + 1;\0a    }\0a    if !allok {\0a      i = i + 1;\0a      continue;\0a    }\0a    if best < 0 || (alexact && !best_exact) {\0a      best = i as i64;\0a      best_exact = alexact;\0a    }\0a    i = i + 1;\0a  }\0a  if best < 0 {\0a    return fn_def_of(prog, e.name);\0a  }\0a  return prog.fns[best as usize];\0a}\0a\0a// a generic fn's type bindings from its call's arguments: directly\0a// when a param IS the parameter, structurally when the param mentions\0a// it (*Pair[A,B] against *Pair[i32,i64])\0afn ginst_bind_tys(fd: *FnDef, e: *Expr, env: *Env,\0a                  prog: *Prog) -> []string {\0a  let nt: usize = len(fd.tparams);\0a  let mut tys: []string = make([]string, nt);\0a  let mut ti: usize = 0;\0a  while ti < nt {\0a    tys[ti] = \22i64\22;\0a    ti = ti + 1;\0a  }\0a  let mut pk: usize = 0;\0a  while pk < len(fd.params) {\0a    if pk < len(fd.ptypes) && pk < len(e.args) {\0a      let pt3: string = fd.ptypes[pk];\0a      let at2: string = expr_type(e.args[pk], env, prog);\0a      if len(at2) > 0 {\0a        if is_tparam(pt3, fd.tparams) {\0a          let mut wi: usize = 0;\0a          while wi < nt {\0a            if fd.tparams[wi] == pt3 {\0a              tys[wi] = at2;\0a            }\0a            wi = wi + 1;\0a          }\0a        } else {\0a          unify_type_bind(pt3, at2, fd.tparams, mut tys);\0a        }\0a      }\0a    }\0a    pk = pk + 1;\0a  }\0a  return tys;\0a}\0a\0a// a call's return type, overload-aware; an explicitly-typed call\0a// (name[T1, T2], the wall lift) substitutes its return from the\0a// folded spelling \e2\80\94 a factory's T appears only here\0afn call_fn_rtype(prog: *Prog, e: *Expr, env: *Env) -> string {\0a  let mut cname: string = e.name;\0a  let mut explicit: []string = make([]string, 0);\0a  if parse.has_targs(cname) {\0a    explicit = parse.targs_args(cname);\0a    cname = parse.targs_base(cname);\0a  }\0a  if fn_overload_count(prog, cname) > 1 {\0a    // the overload chain resolves on the bare name (the targs ride\0a    // outside matching)\0a    let fd3: *FnDef = call_fd_explicit(prog, e, env);\0a    if len(fd3.rtype) > 0 {\0a      return fd3.rtype;\0a    }\0a  }\0a  if user_fn_exists(prog, cname) {\0a    // a user fn; a generic's return rides its instantiation's bind\0a    let fd0: *FnDef = fn_def_of(prog, cname);\0a    if len(fd0.tparams) > 0 {\0a      let mut tys: []string = ginst_bind_tys(fd0, e, env, prog);\0a      if len(explicit) > 0 {\0a        tys = explicit;\0a      }\0a      return tsub_type(fd0.rtype, fd0.tparams, tys);\0a    }\0a  }\0a  return fn_rtype_of(prog, cname);\0a}\0a\0a// the call's resolved fn def, on the bare name for explicitly-typed\0a// calls (the targs ride outside overload resolution; a bracketed name\0a// must never reach the fn-table lookup \e2\80\94 the miss indexes prog.fns\0a// with best = -1)\0afn call_fd_explicit(prog: *Prog, e: *Expr, env: *Env) -> *FnDef {\0a  if parse.has_targs(e.name) {\0a    let mut e2: *Expr = parse.call(parse.targs_base(e.name), e.args);\0a    return resolve_call_fd(prog, e2, env);\0a  }\0a  return resolve_call_fd(prog, e, env);\0a}\0a\0a// the wasm callee for a call: a plain user fn emits under its own\0a// name; a generic fn instantiates per distinct type binding (the\0a// argument types bind T in declaration order) and emits the clone.\0a// Explicit type arguments folded into the name (name[T1, T2], the\0a// wall lift) bind directly \e2\80\94 a factory's T rides only its return\0a// type, so argument inference can never bind it\0afn ginst_call_name(mut pool: *Pool, prog: *Prog, e: *Expr,\0a                   env: *Env) -> string {\0a  let mut cname: string = e.name;\0a  let mut explicit: []string = make([]string, 0);\0a  if parse.has_targs(cname) {\0a    explicit = parse.targs_args(cname);\0a    cname = parse.targs_base(cname);\0a  }\0a  if !user_fn_exists(prog, cname) {\0a    return \22$u_\22 + sym_name(cname);\0a  }\0a  let mut fd: *FnDef = call_fd_explicit(prog, e, env);\0a  if len(explicit) > 0 && len(fd.tparams) != len(explicit) {\0a    panic(\22type-argument arity\22);\0a  }\0a  let nt: usize = len(fd.tparams);\0a  if nt == 0 {\0a    return wasm_fn_name(prog, fd);\0a  }\0a  // bind each T from the call's arguments\0a  let mut tys: []string = ginst_bind_tys(fd, e, env, prog);\0a  if len(explicit) > 0 {\0a    tys = explicit;\0a  }\0a  let mut key: string = \22\22;\0a  let mut ki: usize = 0;\0a  while ki < nt {\0a    key = key + \22_\22;\0a    key = key + mangle_type(tys[ki]);\0a    ki = ki + 1;\0a  }\0a  let mut i: usize = 0;\0a  while i < pool.gi.n {\0a    if pool.gi.bases[i] == cname && pool.gi.keys[i] == key {\0a      return \22$u_\22 + sym_name(cname) + pool.gi.sufs[i];\0a    }\0a    i = i + 1;\0a  }\0a  // clone with the binding and enqueue\0a  let mut clone = parse.clone_fndef(fd);\0a  clone.name = cname + key;\0a  let npt: usize = len(fd.ptypes);\0a  let mut ntypes: []string = make([]string, npt);\0a  let mut npstr: []bool = make([]bool, npt);\0a  let mut npslc: []bool = make([]bool, npt);\0a  let mut pi: usize = 0;\0a  while pi < npt {\0a    let subbed: string = tsub_type(fd.ptypes[pi], fd.tparams, tys);\0a    ntypes[pi] = subbed;\0a    // the substituted kind rewrites the ABI flags: a T bound to\0a    // string rides its pair, a []T as a slice pair\0a    npstr[pi] = subbed == \22string\22 ||\0a        (len(subbed) >= 2 && subbed[0] == 91 && subbed[1] == 93);\0a    npslc[pi] = len(subbed) >= 2 && subbed[0] == 91 &&\0a        subbed[1] == 93;\0a    pi = pi + 1;\0a  }\0a  clone.ptypes = ntypes;\0a  clone.pstr = npstr;\0a  clone.pslc = npslc;\0a  clone.rtype = tsub_type(fd.rtype, fd.tparams, tys);\0a  clone.tparams = fd.tparams[0..0];\0a  let nb2: usize = len(clone.body);\0a  let mut ci: usize = 0;\0a  while ci < nb2 {\0a    subst_in_stmt(mut clone.body[ci], fd.tparams, tys);\0a    ci = ci + 1;\0a  }\0a  pool.gi.bases[pool.gi.n] = cname;\0a  pool.gi.keys[pool.gi.n] = key;\0a  pool.gi.sufs[pool.gi.n] = key;\0a  pool.gi.fds[pool.gi.n] = clone;\0a  pool.gi.n = pool.gi.n + 1;\0a  return \22$u_\22 + sym_name(cname) + key;\0a}\0a\0a// a method on a generic type instantiates per receiver binding: the\0a// type's declared params ride implicitly, bound from the receiver's\0a// bracket args (boot's law); the receiver param's written type takes\0a// the full instantiated text so field reads key on true layouts\0a// a method of a GENERIC struct is a template: boot never emits it\0a// (only per-instantiation clones run \e2\80\94 ginst_method_target clones on\0a// demand); emitting the template once baked its unbound calls\0a// (StringMap.get's self.lower stayed $u_StringMap_lower, no body)\0a// *Base[a, b] whose Base is a generic struct with matching arity \e2\80\94\0a// the instantiation spellings bind (and read back) with their full\0a// text, brackets and all\0afn is_ginst_ptr(mut prog: *Prog, pt: string) -> bool {\0a  if len(pt) < 3 || pt[0] != 42 {\0a    return false;\0a  }\0a  let t: string = pt[1..len(pt)];\0a  let ob: i64 = open_bracket(t);\0a  if ob < 0 {\0a    return false;\0a  }\0a  if t[len(t) - 1..len(t)] != \22]\22 {\0a    return false;\0a  }\0a  let base: string = t[0..(ob as usize)];\0a  let si: i64 = st_index(mut prog, base);\0a  if si < 0 {\0a    return false;\0a  }\0a  let gtps: []string = prog.structs[si as usize].tparams;\0a  if len(gtps) == 0 {\0a    return false;\0a  }\0a  let tys: []string = split_type_args(\0a      t[((ob as usize) + 1)..(len(t) - 1)]);\0a  return len(tys) == len(gtps);\0a}\0a\0afn gstruct_method_skip(mut prog: *Prog, fd: *FnDef) -> bool {\0a  // the qualified name reads canon.Struct.method \e2\80\94 the struct is the\0a  // SECOND-TO-LAST segment (std.collections.map.StringMap.get)\0a  let mut lastdot: i64 = 0 - 1;\0a  let mut prevdot: i64 = 0 - 1;\0a  let mut i9: usize = 0;\0a  while i9 < len(fd.name) {\0a    if fd.name[i9] == 46 {\0a      prevdot = lastdot;\0a      lastdot = i9 as i64;\0a    }\0a    i9 = i9 + 1;\0a  }\0a  if lastdot <= 0 || prevdot < 0 {\0a    return false;\0a  }\0a  let base: string = fd.name[((prevdot as usize) + 1)..(lastdot as usize)];\0a  let si: i64 = st_index(mut prog, base);\0a  if si < 0 {\0a    return false;\0a  }\0a  return len(prog.structs[si as usize].tparams) > 0;\0a}\0a\0afn ginst_method_target(mut pool: *Pool, mut prog: *Prog, rtype: string,\0a                       mname: string) -> string {\0a  // the receiver text may arrive pointer-spelled (a clone's self\0a  // binding does) \e2\80\94 the base lookup wants the bare struct name\0a  let mut rt: string = rtype;\0a  if len(rt) > 0 && rt[0] == 42 {\0a    rt = rt[1..len(rt)];\0a  }\0a  let base: string = type_base(rt);\0a  let ob: i64 = open_bracket(rt);\0a  if ob < 0 {\0a    return \22\22;\0a  }\0a  let mut gtps: []string = make([]string, 0);\0a  let si: i64 = st_index(mut prog, base);\0a  if si >= 0 && len(prog.structs[si as usize].tparams) > 0 {\0a    gtps = prog.structs[si as usize].tparams;\0a  } else {\0a    let ei: i64 = en_index(mut prog, base);\0a    if ei >= 0 && len(prog.enums[ei as usize].tparams) > 0 {\0a      gtps = prog.enums[ei as usize].tparams;\0a    }\0a  }\0a  if len(gtps) == 0 {\0a    return \22\22;\0a  }\0a  let mfull: string = base + \22.\22 + mname;\0a  // the method may ride module-qualified (std.collections.vec.Vec.push\0a  // ends with Vec.push) \e2\80\94 the suffix match finds it; registration\0a  // stays keyed on the bare mfull so every call site agrees\0a  let mut dfull: string = mfull;\0a  if !user_fn_exists(prog, mfull) {\0a    let mut hit: i64 = 0 - 1;\0a    let mut fi3: usize = 0;\0a    while fi3 < len(prog.fns) {\0a      let nm3: string = prog.fns[fi3].name;\0a      let nl3: i64 = len(nm3) as i64;\0a      let ml3: i64 = len(mfull) as i64;\0a      if nl3 > ml3 {\0a        if nm3[((nl3 - ml3 - 1) as usize)..(nl3 as usize)] ==\0a            \22.\22 + mfull {\0a          hit = fi3 as i64;\0a        }\0a      }\0a      fi3 = fi3 + 1;\0a    }\0a    if hit < 0 {\0a      return \22\22;\0a    }\0a    dfull = prog.fns[hit as usize].name;\0a  }\0a  let mut tys: []string = split_type_args(\0a      rt[((ob as usize) + 1)..(len(rt) - 1)]);\0a  let mut key: string = \22\22;\0a  let mut ki: usize = 0;\0a  while ki < len(gtps) {\0a    key = key + \22_\22;\0a    key = key + mangle_type(tys[ki]);\0a    ki = ki + 1;\0a  }\0a  let mut i: usize = 0;\0a  while i < pool.gi.n {\0a    if pool.gi.bases[i] == mfull && pool.gi.keys[i] == key {\0a      return \22$u_\22 + sym_name(mfull) + pool.gi.sufs[i];\0a    }\0a    i = i + 1;\0a  }\0a  // the overload whose receiver instantiation matches the call's:\0a  // the concrete per-value-type overloads share the name, and the\0a  // first match once cloned the [string] body for an [i32] call\0a  // (the pair lanes of the wrong value type \e2\80\94 5 params vs 4)\0a  let args0: string = rt[((ob as usize) + 1)..(len(rt) - 1)];\0a  let mut fdm: *FnDef = fn_def_of(prog, dfull);\0a  let mut fi4: usize = 0;\0a  while fi4 < len(prog.fns) {\0a    let cand: *FnDef = prog.fns[fi4];\0a    let cn: string = cand.name;\0a    let cok: bool = cn == mfull ||\0a        (len(cn) > len(mfull) &&\0a         cn[((len(cn) - len(mfull) - 1) as usize)..len(cn)] ==\0a             \22.\22 + mfull);\0a    if cok && len(cand.ptypes) > 0 {\0a      let rcp: string = cand.ptypes[0];\0a      let rob: i64 = open_bracket(rcp);\0a      if rob >= 0 {\0a        let rargs: string = rcp[((rob as usize) + 1)..(len(rcp) - 1)];\0a        if rargs == args0 {\0a          fdm = cand;\0a        }\0a      }\0a    }\0a    fi4 = fi4 + 1;\0a  }\0a  let mut clone = parse.clone_fndef(fdm);\0a  clone.name = mfull + key;\0a  let npt: usize = len(fdm.ptypes);\0a  let mut ntypes: []string = make([]string, npt);\0a  let mut npstr: []bool = make([]bool, npt);\0a  let mut npslc: []bool = make([]bool, npt);\0a  let mut pi: usize = 0;\0a  while pi < npt {\0a    let mut pt4: string = tsub_type(fdm.ptypes[pi], gtps, tys);\0a    if len(pt4) > 0 {\0a      // the receiver's bare base becomes the full instantiation\0a      let pb: string = type_base(pt4);\0a      // the base comparison must be star-blind: type_base keeps the\0a      // star (\22*StringMap\22), so a template receiver (*StringMap) once\0a      // matched the value arm and the clone's self lost its star \e2\80\94\0a      // every method call inside the clone then read the wrong\0a      // receiver (StringMap_lower went bare)\0a      let mut pb2: string = pb;\0a      let mut star: bool = false;\0a      if len(pb2) > 0 && pb2[0] == 42 {\0a        star = true;\0a        pb2 = pb2[1..len(pb2)];\0a      }\0a      if pb2 == base && (pt4 == pb2 || pt4 == \22*\22 + pb2) {\0a        pt4 = rtype;\0a        if star && len(pt4) > 0 && pt4[0] != 42 {\0a          pt4 = \22*\22 + pt4;\0a        }\0a        if !star && len(pt4) > 0 && pt4[0] == 42 {\0a          pt4 = pt4[1..len(pt4)];\0a        }\0a      } else {\0a        if pb2 == base && pt4 == \22?\22 + pb2 {\0a          pt4 = \22?\22 + rtype;\0a        }\0a      }\0a    }\0a    ntypes[pi] = pt4;\0a    npstr[pi] = pt4 == \22string\22 ||\0a        (len(pt4) >= 2 && pt4[0] == 91 && pt4[1] == 93);\0a    npslc[pi] = len(pt4) >= 2 && pt4[0] == 91 && pt4[1] == 93;\0a    pi = pi + 1;\0a  }\0a  clone.ptypes = ntypes;\0a  clone.pstr = npstr;\0a  clone.pslc = npslc;\0a  clone.rtype = tsub_type(fdm.rtype, gtps, tys);\0a  clone.tparams = fdm.tparams[0..0];\0a  let nb3: usize = len(clone.body);\0a  let mut ci: usize = 0;\0a  while ci < nb3 {\0a    subst_in_stmt(mut clone.body[ci], gtps, tys);\0a    ci = ci + 1;\0a  }\0a  pool.gi.bases[pool.gi.n] = mfull;\0a  pool.gi.keys[pool.gi.n] = key;\0a  pool.gi.sufs[pool.gi.n] = key;\0a  pool.gi.fds[pool.gi.n] = clone;\0a  pool.gi.n = pool.gi.n + 1;\0a  return \22$u_\22 + sym_name(mfull) + key;\0a}\0a\0a// a value whose type owns a to_str method prints through it (the\0a// Show surface: struct pointers, struct values, enum boxes); the\0a// pair parks in fresh slots, \22\22 when no method exists\0afn to_str_pair(e: *Expr, mut pool: *Pool, mut env: *Env, mut prog: *Prog,\0a               mut nl: *NextLocal) -> *SPair {\0a  let mut bad = new SPair { ok: false, text: \22\22, a: 0, l: 0 };\0a  let mut tname: string = \22\22;\0a  if e.tag == parse.EX_VAR {\0a    let vt: string = env_val_of(env, e.name);\0a    if len(vt) > 0 {\0a      tname = vt;\0a    } else {\0a      let pt4: string = env_ptr_of(env, e.name);\0a      if len(pt4) > 0 {\0a        tname = pt4;\0a      } else {\0a        tname = env_enum_of(env, e.name);\0a      }\0a    }\0a  } else {\0a    let et4: string = expr_enum_type(e, env, mut prog);\0a    if len(et4) > 0 {\0a      tname = et4;\0a    } else {\0a      tname = expr_ptr_type(e, env, mut prog);\0a    }\0a  }\0a  if len(tname) == 0 {\0a    return bad;\0a  }\0a  if !user_fn_exists(prog, tname + \22.to_str\22) {\0a    return bad;\0a  }\0a  if !rtype_is_pair(fn_rtype_of(prog, tname + \22.to_str\22)) {\0a    return bad;\0a  }\0a  let text: string = emit_expr(mut pool, e, mut env, mut prog, mut nl) +\0a         \22    call $u_\22 + tname + \22_to_str\5cn\22 +\0a         \22    (local.set \22 + (nl.v + 1).to_str() + \22)\5cn\22 +\0a         \22    (local.set \22 + nl.v.to_str() + \22)\5cn\22;\0a  let spt = new SPair { ok: true, text: text, a: nl.v,\0a                        l: nl.v + 1 };\0a  nl.v = nl.v + 2;\0a  return spt;\0a}\0a\0a// ---- variadics: rest: T... materializes at the call ----\0a\0a// the rest parameter's index, -1 when the fn is not variadic\0afn fn_variadic_at(fd: *FnDef) -> i64 {\0a  let mut k: usize = 0;\0a  while k < len(fd.pvar) {\0a    if fd.pvar[k] {\0a      return k as i64;\0a    }\0a    k = k + 1;\0a  }\0a  return 0 - 1;\0a}\0a\0a// a call's arguments: fixed params in order, then the rest tail \e2\80\94 a\0a// lone spread rides its pair whole, anything else materializes a\0a// fresh zeroed slice (string elements take two slots each)\0afn emit_call_args(mut pool: *Pool, mut prog: *Prog, fd: *FnDef, e: *Expr,\0a                  mut env: *Env, mut nl: *NextLocal) -> string {\0a  let vp: i64 = fn_variadic_at(fd);\0a  let mut out: string = \22\22;\0a  if vp < 0 {\0a    let mut k: usize = 0;\0a    while k < len(e.args) {\0a      if k < len(fd.ptypes) &&\0a          st_index(mut prog, fd.ptypes[k]) >= 0 {\0a        // a by-value struct param: the argument rides its address\0a        out = out + struct_addr_of(mut pool, e.args[k], mut env, mut prog, mut nl);\0a      } else {\0a        out = out + emit_arg(mut pool, e.args[k], mut env, mut prog, mut nl);\0a      }\0a      k = k + 1;\0a    }\0a    return out;\0a  }\0a  let mut elem: string = \22\22;\0a  if (vp as usize) < len(fd.ptypes) {\0a    elem = fd.ptypes[vp as usize];\0a  }\0a  let et: string = elem[2..len(elem)];\0a  let sstr: bool = et == \22string\22;\0a  let mut esz: i64 = 1;\0a  if sstr {\0a    esz = 2;\0a  }\0a  let mut k: usize = 0;\0a  while (k as i64) < vp && k < len(e.args) {\0a    if k < len(fd.ptypes) &&\0a        st_index(mut prog, fd.ptypes[k]) >= 0 {\0a      // a by-value struct param: the argument rides its address\0a      out = out + struct_addr_of(mut pool, e.args[k], mut env, mut prog, mut nl);\0a    } else {\0a      out = out + emit_arg(mut pool, e.args[k], mut env, mut prog, mut nl);\0a    }\0a    k = k + 1;\0a  }\0a  let rest: i64 = (len(e.args) as i64) - vp;\0a  if rest <= 0 {\0a    // an empty rest: a zero-count allocation still lands the pair\0a    out = out + \22    (i64.extend_i32_u (call $w_alloc (i32.const 0)))\22 +\0a           \22\5cn    (local.set \22 + nl.v.to_str() + \22)\5cn\22 +\0a           \22    (i64.const 0)\5cn    (local.set \22 +\0a           (nl.v + 1).to_str() + \22)\5cn\22 +\0a           \22    (local.get \22 + nl.v.to_str() + \22)\5cn\22 +\0a           \22    (local.get \22 + (nl.v + 1).to_str() + \22)\5cn\22;\0a    nl.v = nl.v + 2;\0a    return out;\0a  }\0a  let lasti: usize = len(e.args) - 1;\0a  let lastarg: *Expr = e.args[lasti];\0a  if lastarg.lit == 0 - 99 && (lasti as i64) == vp {\0a    // a lone spread rides its pair whole\0a    out = out + emit_arg(mut pool, lastarg, mut env, mut prog, mut nl);\0a    return out;\0a  }\0a  // a fresh slice of the rest values\0a  let a_slot: i64 = nl.v;\0a  let l_slot: i64 = nl.v + 1;\0a  nl.v = nl.v + 2;\0a  out = out + \22    (i64.extend_i32_u (call $w_alloc (i32.const \22;\0a  out = out + (rest * esz).to_str();\0a  out = out + \22)))\5cn\22;\0a  out = out + \22    (local.set \22;\0a  out = out + a_slot.to_str();\0a  out = out + \22)\5cn\22;\0a  out = out + \22    (i64.const \22;\0a  out = out + rest.to_str();\0a  out = out + \22)\5cn\22;\0a  out = out + \22    (local.set \22;\0a  out = out + l_slot.to_str();\0a  out = out + \22)\5cn\22;\0a  let mut j: usize = vp as usize;\0a  let mut sl: i64 = 0;\0a  while j < len(e.args) {\0a    let av: *Expr = e.args[j];\0a    if sstr {\0a      let spv2 = build_string_pair(av, mut pool, mut env, mut prog, mut nl);\0a      out = out + spv2.text;\0a      out = out + \22    (i64.store (i32.add (i32.wrap_i64 (local.get \22;\0a      out = out + a_slot.to_str();\0a      out = out + \22)) (i32.mul (i32.const \22;\0a      out = out + sl.to_str();\0a      out = out + \22) (i32.const 8))) (local.get \22;\0a      out = out + spv2.a.to_str();\0a      out = out + \22))\5cn\22;\0a      out = out + \22    (i64.store (i32.add (i32.add (i32.wrap_i64 (local.get \22;\0a      out = out + a_slot.to_str();\0a      out = out + \22)) (i32.mul (i32.const \22;\0a      out = out + sl.to_str();\0a      out = out + \22) (i32.const 8))) (i32.const 8)) \22;\0a      out = out + \22(local.get \22;\0a      out = out + spv2.l.to_str();\0a      out = out + \22))\5cn\22;\0a      sl = sl + 2;\0a    } else {\0a      let tv2: i64 = nl.v;\0a      nl.v = nl.v + 1;\0a      out = out + emit_expr(mut pool, av, mut env, mut prog, mut nl);\0a      out = out + \22    (local.set \22;\0a      out = out + tv2.to_str();\0a      out = out + \22)\5cn\22;\0a      out = out + \22    (i64.store (i32.add (i32.wrap_i64 (local.get \22;\0a      out = out + a_slot.to_str();\0a      out = out + \22)) (i32.mul (i32.const \22;\0a      out = out + sl.to_str();\0a      out = out + \22) (i32.const 8))) (local.get \22;\0a      out = out + tv2.to_str();\0a      out = out + \22))\5cn\22;\0a      sl = sl + 1;\0a    }\0a    j = j + 1;\0a  }\0a  out = out + \22    (local.get \22;\0a  out = out + a_slot.to_str();\0a  out = out + \22)\5cn\22;\0a  out = out + \22    (local.get \22;\0a  out = out + l_slot.to_str();\0a  out = out + \22)\5cn\22;\0a  return out;\0a}\0a\0a// ---- closures: capture boxes + an indirect-call table ----\0a\0afn is_fn_type(t: string) -> bool {\0a  return len(t) >= 2 && t[0] == 102 && t[1] == 110;\0a}\0a\0a// the capture-name accumulator\0astruct CapList {\0a  names: []string,\0a  n: usize,\0a}\0a\0afn cap_add(mut caps: *CapList, name: string) {\0a  let mut i: usize = 0;\0a  while i < caps.n {\0a    if caps.names[i] == name {\0a      return;\0a    }\0a    i = i + 1;\0a  }\0a  if caps.n < len(caps.names) {\0a    caps.names[caps.n] = name;\0a    caps.n = caps.n + 1;\0a  }\0a}\0a\0afn cap_expr(e: *Expr, env: *Env, prog: *Prog, skip: []string,\0a            nskip: usize, mut caps: *CapList) {\0a  if e.tag == parse.EX_CLO {\0a    // a nested literal: its own params are its own\0a    let mut b: usize = 0;\0a    while b < nskip {\0a      b = b + 1;\0a    }\0a    let mut m: usize = 0;\0a    while m < len(e.marms) {\0a      cap_stmts(e.marms[m].body, env, prog, e.fnames, mut caps);\0a      m = m + 1;\0a    }\0a    return;\0a  }\0a  if e.tag == parse.EX_VAR {\0a    if env_look(env, e.name) >= 0 && !name_is_const(prog, e.name) &&\0a        len(static_global(prog, e.name)) == 0 {\0a      let mut hit: bool = false;\0a      let mut k: usize = 0;\0a      while k < nskip {\0a        if skip[k] == e.name {\0a          hit = true;\0a        }\0a        k = k + 1;\0a      }\0a      if !hit {\0a        cap_add(mut caps, e.name);\0a      }\0a    }\0a  }\0a  match e.lhs {\0a    Option.Some(l15) => {\0a      cap_expr(l15, env, prog, skip, nskip, mut caps);\0a    },\0a    Option.None => {},\0a  }\0a  match e.rhs {\0a    Option.Some(r15) => {\0a      cap_expr(r15, env, prog, skip, nskip, mut caps);\0a    },\0a    Option.None => {},\0a  }\0a  let mut k: usize = 0;\0a  while k < len(e.args) {\0a    cap_expr(e.args[k], env, prog, skip, nskip, mut caps);\0a    k = k + 1;\0a  }\0a}\0a\0afn cap_stmts(nodes: []*Stmt, env: *Env, prog: *Prog,\0a             skip: []string, mut caps: *CapList) {\0a  let nskip: usize = len(skip);\0a  let mut i: usize = 0;\0a  while i < len(nodes) {\0a    let mut st = nodes[i];\0a    match st.val {\0a      Option.Some(v15) => {\0a        cap_expr(v15, env, prog, skip, nskip, mut caps);\0a      },\0a      Option.None => {},\0a    }\0a    let mut a: usize = 0;\0a    while a < len(st.args) {\0a      cap_expr(st.args[a], env, prog, skip, nskip, mut caps);\0a      a = a + 1;\0a    }\0a    cap_stmts(st.body, env, prog, skip, mut caps);\0a    cap_stmts(st.body2, env, prog, skip, mut caps);\0a    i = i + 1;\0a  }\0a}\0a\0a// a closure literal's value: the capture box (a copy of each free\0a// local), plus the (table idx, box) pair on the lane\0afn emit_closure_value(e: *Expr, mut pool: *Pool, env: *Env,\0a                      prog: *Prog, mut nl: *NextLocal) -> string {\0a  let mut caps = new CapList { names: make([]string, 32), n: 0 };\0a  let mut m: usize = 0;\0a  while m < len(e.marms) {\0a    cap_stmts(e.marms[m].body, env, prog, e.fnames, mut caps);\0a    m = m + 1;\0a  }\0a  // the box: [pad][cap0][cap1]...\0a  let b_slot: i64 = nl.v;\0a  nl.v = nl.v + 1;\0a  let mut out: string = \22    (i64.extend_i32_u (call $w_alloc (i32.const \22 +\0a         ((caps.n + 1) as i64).to_str() + \22)))\5cn\22 +\0a         \22    (local.set \22 + b_slot.to_str() + \22)\5cn\22;\0a  let mut ci: usize = 0;\0a  while ci < caps.n {\0a    let cslot: i64 = env_look(env, caps.names[ci]);\0a    out = out + \22    (i64.store (i32.add (i32.wrap_i64 (local.get \22;\0a    out = out + b_slot.to_str();\0a    out = out + \22)) (i32.const \22;\0a    out = out + ((ci + 1) * 8).to_str();\0a    out = out + \22)) (local.get \22;\0a    out = out + cslot.to_str();\0a    out = out + \22))\5cn\22;\0a    ci = ci + 1;\0a  }\0a  // register the body + its table slot\0a  let wat: string = \22$u___clo\22 + pool.gi.cfn.to_str();\0a  let gi_n: usize = pool.gi.n;\0a  pool.gi.bases[gi_n] = \22clo:\22 + wat;\0a  pool.gi.keys[gi_n] = \22\22;\0a  pool.gi.sufs[gi_n] = \22\22;\0a  // the carrier needs only its body \e2\80\94 a synthetic FnDef. The old\0a  // clone_fndef(prog.fns[0]) crashed on a program with no non-main\0a  // fns (prog.fns empty: main rides prog.main) and deep-copied a body\0a  // that the very next line overwrote anyway.\0a  let carrier = parse.new_fndef(e.marms[0].body);\0a  pool.gi.clo_fds[gi_n] = carrier;\0a  let idx: i64 = pool.gi.cfn as i64;\0a  pool.gi.ids[gi_n] = idx;\0a  let capbase: usize = (idx as usize) * 8;\0a  let mut pi2: usize = 0;\0a  while pi2 < len(e.fnames) && pi2 < 8 {\0a    pool.gi.clo_params[capbase + pi2] = e.fnames[pi2];\0a    pi2 = pi2 + 1;\0a  }\0a  let mut cj: usize = 0;\0a  while cj < caps.n && cj < 8 {\0a    let cname: string = caps.names[cj];\0a    let cty: string = env_ptr_of(env, cname);\0a    if len(cty) > 0 {\0a      pool.gi.clo_caps[capbase + cj] = cname + \22:\22 + cty;\0a    } else {\0a      pool.gi.clo_caps[capbase + cj] = cname;\0a    }\0a    cj = cj + 1;\0a  }\0a  pool.gi.n = pool.gi.n + 1;\0a  pool.gi.clo_wasms[pool.gi.cfn] = wat;\0a  pool.gi.cfn = pool.gi.cfn + 1;\0a  // the arity the body's calls will use (box + params)\0a  let ari: i64 = 1 + (len(e.fnames) as i64);\0a  clo_ty_need(mut pool.gi, ari, 1);\0a  out = out + \22    (i64.const \22;\0a  out = out + idx.to_str();\0a  out = out + \22)\5cn\22;\0a  out = out + \22    (local.get \22;\0a  out = out + b_slot.to_str();\0a  out = out + \22)\5cn\22;\0a  return out;\0a}\0a\0a// one closure's fn: param 0 the capture box, captures load from its\0a// slots, the literal's params follow \e2\80\94 the body emits as statements\0afn emit_closure_fn(wat: string, caps: []string,\0a                   captypes: []string, ncaps: usize,\0a                   params: []string, body: []*Stmt, mut pool: *Pool,\0a                   mut prog: *Prog) -> string {\0a  let mut env = env_new(1024);\0a  env_bind_consts(mut env, prog, mut pool);\0a  let nparams: i64 = 1 + (len(params) as i64);\0a  let mut nl = new NextLocal { v: nparams + 7, hi: nparams + 7 };\0a  let mut loops = loops_new();\0a  let mut dstack = dstack_new();\0a  let mut text: string = \22\22;\0a  let mut ci: usize = 0;\0a  while ci < ncaps {\0a    let cslot: i64 = nl.v;\0a    nl.v = nl.v + 1;\0a    text = text + \22    (i64.load (i32.add (i32.wrap_i64 \22;\0a    text = text + \22(local.get 0)) (i32.const \22;\0a    text = text + ((ci + 1) * 8).to_str();\0a    text = text + \22)))\5cn\22;\0a    text = text + \22    (local.set \22;\0a    text = text + cslot.to_str();\0a    text = text + \22)\5cn\22;\0a    let mut cty2: string = \22\22;\0a    if ci < len(captypes) {\0a      cty2 = captypes[ci];\0a    }\0a    if len(cty2) > 0 && st_index(mut prog, cty2) >= 0 {\0a      env_bind_ptr(mut env, caps[ci], cslot, cty2);\0a    } else {\0a      env_bind(mut env, caps[ci], cslot);\0a    }\0a    ci = ci + 1;\0a  }\0a  let mut pi: usize = 0;\0a  while pi < len(params) {\0a    env_bind(mut env, params[pi], (pi as i64) + 1);\0a    pi = pi + 1;\0a  }\0a  text = text + emit_stmts(body, mut pool, mut env, mut nl, true, 0 - 1, mut prog,mut \0a                           loops, mut dstack, Option.None);\0a  let mut out: string = \22  (func \22 + wat;\0a  let mut q: i64 = 0;\0a  while q < nparams {\0a    out = out + \22 (param i64)\22;\0a    q = q + 1;\0a  }\0a  out = out + \22 (result i64)\5cn\22;\0a  out = out + \22    (local $a i32) (local $l i32) (local $t i64)\22;\0a  out = out + \22 (local $r i64) (local $d i64)\22;\0a  out = out + \22 (local $sfa i32) (local $sfl i32)\5cn\22;\0a  let mut nltop2: i64 = nl.v;\0a  if nl.hi > nltop2 {\0a    nltop2 = nl.hi;\0a  }\0a  q = nparams + 7;\0a  while q < nltop2 {\0a    out = out + \22    (local i64)\5cn\22;\0a    q = q + 1;\0a  }\0a  out = out + text;\0a  out = out + \22    (i64.const 0)\5cn  )\5cn\22;\0a  return out;\0a}\0a\0a// the first ':' in a name:type capture record, 0 when bare\0afn find_colon(s: string) -> usize {\0a  let mut i: usize = 0;\0a  while i < len(s) {\0a    if s[i] == 58 {\0a      return i;\0a    }\0a    i = i + 1;\0a  }\0a  return 0;\0a}\0a\0a// an Option-typed annotation's payload text ('?*Node' -> '*Node'),\0a// \22\22 when the annotation names none\0afn opt_payload(fmt: string) -> string {\0a  if len(fmt) >= 1 && fmt[0] == 63 {\0a    return fmt[1..len(fmt)];\0a  }\0a  // Option[..] / Result[T, E]: the payload is the FIRST bracket arg\0a  // \e2\80\94 the matching-bracket law split_type_args reads (a first-']'\0a  // scan once returned the whole \22?string, IoError\22 tail for a\0a  // two-arg Result)\0a  if starts_open(fmt, \22Option\22) || starts_open(fmt, \22Result\22) {\0a    let ob: i64 = open_bracket(fmt);\0a    if ob >= 0 {\0a      let tas: []string = split_type_args(\0a          fmt[((ob as usize) + 1)..(len(fmt) - 1)]);\0a      if len(tas) > 0 {\0a        return tas[0];\0a      }\0a    }\0a  }\0a  return \22\22;\0a}\0a\0afn emit_print_fd(mut pool: *Pool, fmt: string, args: []*Expr, mut env: *Env,\0a                 mut prog: *Prog, mut nl: *NextLocal, fd: i64) -> string {\0a  let pieces: []string = parse.fmt_pieces(fmt);\0a  // pass 1: evaluate each hole into temps (folded strings skip the\0a  // temps \e2\80\94 their pool consts are side-effect free)\0a  let mut nhol: usize = len(pieces) - 1;\0a  if nhol > len(args) {\0a    nhol = len(args);\0a  }\0a  let mut t_a: []i64 = make([]i64, len(args) + 1);\0a  let mut t_l: []i64 = make([]i64, len(args) + 1);\0a  let mut kinds: []i64 = make([]i64, len(args) + 1); // 0 int 1 uint 2 bool\0a                                             // 3 folded str 4 live pair\0a  let mut pre: string = \22\22;\0a  let mut q: usize = 0;\0a  while q < nhol {\0a    let arg: *Expr = args[q];\0a    match fold_string(arg, env) {\0a      Option.Some(raw) => {\0a        let saddr: i64 = pool_intern(mut pool, raw);\0a        t_a[q] = saddr;\0a        t_l[q] = pool_len(pool, raw);\0a        kinds[q] = 3;\0a      },\0a      Option.None => {\0a        let fk: i64 = expr_fkind(arg, env, mut prog);\0a        if fk > 0 {\0a          // a float hole prints through the exact-decimal text: the\0a          // lane's bits ride the printer (f32 rounds through demote\0a          // first, so a non-f32 literal narrows honestly)\0a          FLOAT_WANTED = 1;\0a          pre = pre + emit_expr(mut pool, arg, mut env, mut prog, mut nl);\0a          let tb: i64 = nl.v;\0a          nl.v = nl.v + 1;\0a          pre = pre + \22    (local.set \22;\0a          pre = pre + tb.to_str();\0a          pre = pre + \22)\5cn\22;\0a          pre = pre + \22    (local.get \22;\0a          pre = pre + tb.to_str();\0a          pre = pre + \22)\5cn\22;\0a          if fk == 2 {\0a            pre = pre + \22    (f64.reinterpret_i64)\5cn\22;\0a            pre = pre + \22    (f32.demote_f64)\5cn    (f64.promote_f32)\5cn\22;\0a            pre = pre + \22    (i64.reinterpret_f64)\5cn\22;\0a            pre = pre + \22    call $u___f32_text\5cn\22;\0a          } else {\0a            pre = pre + \22    call $u___f64_text\5cn\22;\0a          }\0a          t_a[q] = nl.v;\0a          t_l[q] = nl.v + 1;\0a          nl.v = nl.v + 2;\0a          pre = pre + \22    (local.set \22;\0a          pre = pre + t_l[q].to_str();\0a          pre = pre + \22)\5cn\22;\0a          pre = pre + \22    (local.set \22;\0a          pre = pre + t_a[q].to_str();\0a          pre = pre + \22)\5cn\22;\0a          kinds[q] = 4;\0a        } else {\0a        let dyn_pair: bool =\0a            dyn_hole_dispatch(arg, mut pool, mut env, mut prog, mut nl);\0a        if dyn_pair {\0a          t_a[q] = DYN_A;\0a          t_l[q] = DYN_L;\0a          kinds[q] = 4;\0a          pre = pre + DYN_TEXT;\0a          DYN_TEXT = \22\22;\0a        } else {\0a        let spt = to_str_pair(arg, mut pool, mut env, mut prog, mut nl);\0a        if spt.ok {\0a          // a value whose type owns to_str prints through it\0a          pre = pre + spt.text;\0a          t_a[q] = spt.a;\0a          t_l[q] = spt.l;\0a          kinds[q] = 4;\0a        } else {\0a        let sp = build_string_pair(arg, mut pool, mut env, mut prog, mut nl);\0a        if sp.ok {\0a          pre = pre + sp.text;\0a          t_a[q] = sp.a;\0a          t_l[q] = sp.l;\0a          kinds[q] = 4;\0a        } else {\0a          if hole_boolish(arg, env, mut prog) {\0a            // a comparison or logical \e2\80\94 or a var bound from one \e2\80\94\0a            // prints its spelled word\0a            pre = pre + emit_expr(mut pool, arg, mut env, mut prog, mut nl);\0a            t_a[q] = nl.v;\0a            nl.v = nl.v + 1;\0a            pre = pre + \22    (local.set \22;\0a            pre = pre + t_a[q].to_str();\0a            pre = pre + \22)\5cn\22;\0a            kinds[q] = 2;\0a          } else {\0a            let mut boolish: bool = false;\0a            if arg.tag == parse.EX_CALL {\0a              boolish = call_fn_rtype(prog, arg, env) == \22bool\22;\0a            }\0a            if arg.tag == parse.EX_MCALL {\0a              let mut recv0: *Expr = parse.lit(0);\0a              match arg.lhs {\0a                Option.Some(r4) => {\0a                  recv0 = r4;\0a                },\0a                Option.None => {},\0a              }\0a              if recv0.tag == parse.EX_VAR {\0a                boolish = method_rtype(mut prog,\0a                                       expr_ptr_type(recv0, env, mut prog),\0a                                       arg.name) == \22bool\22;\0a              }\0a            }\0a            pre = pre + emit_expr(mut pool, arg, mut env, mut prog, mut nl);\0a            t_a[q] = nl.v;\0a            nl.v = nl.v + 1;\0a            pre = pre + \22    (local.set \22;\0a            pre = pre + t_a[q].to_str();\0a            pre = pre + \22)\5cn\22;\0a            if boolish {\0a              kinds[q] = 2;\0a            } else {\0a              if expr_width(arg, env, mut prog) < 0 {\0a                kinds[q] = 1;\0a              } else {\0a                kinds[q] = 0;\0a              }\0a            }\0a          }\0a        }\0a        }\0a        }\0a        }\0a      },\0a    }\0a    q = q + 1;\0a  }\0a  // pass 2: the writes, left to right, reading the temps\0a  let mut out: string = pre;\0a  let mut pi: usize = 0;\0a  while pi < len(pieces) {\0a    if len(pieces[pi]) > 0 {\0a      let addr: i64 = pool_intern(mut pool, pieces[pi]);\0a      out = out + write_fd(addr, pool_len(pool, pieces[pi]), fd);\0a    }\0a    if pi + 1 < len(pieces) && pi < nhol {\0a      let h: usize = pi;\0a      if kinds[h] == 3 {\0a        out = out + write_fd(t_a[h], t_l[h], fd);\0a      } else {\0a        if kinds[h] == 4 {\0a          out = out + \22    (local.get \22;\0a          out = out + t_a[h].to_str();\0a          out = out + \22)\5cn    (i32.wrap_i64)\5cn    (local.set $a)\5cn\22;\0a          out = out + \22    (local.get \22;\0a          out = out + t_l[h].to_str();\0a          out = out + \22)\5cn    (i32.wrap_i64)\5cn    (local.set $l)\5cn\22;\0a          out = out + \22    (i32.store (i32.const 64) (local.get $a))\5cn\22;\0a          out = out + \22    (i32.store (i32.const 68) (local.get $l))\5cn\22;\0a          out = out + \22    (drop (call $fd_write (i32.const \22;\0a          out = out + fd.to_str();\0a          out = out + \22) \22;\0a          out = out + \22(i32.const 64) (i32.const 1) (i32.const 96)))\5cn\22;\0a        } else {\0a          if kinds[h] == 2 {\0a            out = out + \22    (local.get \22;\0a            out = out + t_a[h].to_str();\0a            out = out + \22)\5cn    call $w_bool\5cn\22;\0a            out = out + \22    (local.set $l)\5cn    (local.set $a)\5cn\22;\0a            out = out + \22    (i32.store (i32.const 64) (local.get $a))\5cn\22;\0a            out = out + \22    (i32.store (i32.const 68) (local.get $l))\5cn\22;\0a            out = out + \22    (drop (call $fd_write (i32.const \22;\0a            out = out + fd.to_str();\0a            out = out + \22) \22;\0a            out = out + \22(i32.const 64) (i32.const 1) (i32.const 96)))\5cn\22;\0a          } else {\0a            out = out + \22    (local.get \22;\0a            out = out + t_a[h].to_str();\0a            out = out + \22)\5cn\22;\0a            if kinds[h] == 1 {\0a              out = out + \22    call $w_u64\5cn\22;\0a            } else {\0a              out = out + \22    call $w_i64\5cn\22;\0a            }\0a            out = out + \22    (local.set $l)\5cn    (local.set $a)\5cn\22;\0a            out = out + \22    (i32.store (i32.const 64) (local.get $a))\5cn\22;\0a            out = out + \22    (i32.store (i32.const 68) (local.get $l))\5cn\22;\0a            out = out + \22    (drop (call $fd_write (i32.const \22;\0a            out = out + fd.to_str();\0a            out = out + \22) \22;\0a            out = out + \22(i32.const 64) (i32.const 1) (i32.const 96)))\5cn\22;\0a          }\0a        }\0a      }\0a    }\0a    pi = pi + 1;\0a  }\0a  return out;\0a}\0a\0afn emit_stmts(nodes: []*Stmt, mut pool: *Pool, mut env: *Env,\0a               mut nl: *NextLocal, in_fn: bool, ret_slot: i64,\0a               mut prog: *Prog, mut loops: *Loops, mut dstack: *DStack,\0a               tfd: ?*FnDef) -> string {\0a  env.infn = in_fn;\0a  env.retslot = ret_slot;\0a  env.loops = loops;\0a  env.dstack = dstack;\0a  env.tfd = tfd;\0a  dpush(mut dstack);\0a  let mut body: string = \22\22;\0a  let mut i: usize = 0;\0a  while i < len(nodes) {\0a    let mut st = nodes[i];\0a    body = body + \22    (;st\22 + st.tag.to_str() + \22;)\5cn\22;\0a    // P6's live-range law: a statement that binds no name and defers\0a    // no fn leaves its temporary slots dead at its end \e2\80\94 the next\0a    // statement reuses them, so the module's local count tracks live\0a    // ranges instead of statement count. Bindings veto the reset \e2\80\94\0a    // scalar binds ride env.n, string/slice pair binds ride env.sn\0a    // (their element texts on sel_n) \e2\80\94 and defers (dstack.cursor)\0a    // veto too: their texts outlive the statement.\0a    let sw: i64 = nl.v;\0a    let senv: usize = env.n;\0a    let ssn: usize = env.sn;\0a    let ssel: usize = env.sel_n;\0a    let sdc: usize = dstack.cursor;\0a    if st.tag == parse.ST_RET && in_fn {\0a      // a fn's return: the value parks in $r while the open scopes'\0a      // defers unwind (LIFO), then rides home \e2\80\94 unless the value is a\0a      // direct self tail call, which becomes the loop rewrite (args\0a      // land in the param slots, br re-enters the fn-top loop)\0a      let mut is_tail: bool = false;\0a      match tfd {\0a        Option.Some(fdef) => {\0a          match st.val {\0a            Option.Some(rv) => {\0a              if rv.tag == parse.EX_CALL && rv.name == fdef.name {\0a                is_tail = true;\0a              }\0a            },\0a            Option.None => {},\0a          }\0a        },\0a        Option.None => {},\0a      }\0a      // a string fn's return rides its pair (else-chained, never a\0a      // match-arm continue \e2\80\94 boot's match continue does not skip the\0a      // enclosing loop's tail and the old path would append junk)\0a      let mut sret: bool = false;\0a      if !is_tail {\0a        match tfd {\0a          Option.Some(fdef) => {\0a            if rtype_is_pair(fdef.rtype) {\0a              sret = true;\0a            }\0a          },\0a          Option.None => {},\0a        }\0a      }\0a      let mut sret_done: bool = false;\0a      if sret {\0a        match st.val {\0a          Option.Some(rv) => {\0a            let sp = build_string_pair(rv, mut pool, mut env, mut prog,mut \0a                                       nl);\0a            if sp.ok {\0a              body = body + sp.text;\0a              body = body + dunwind_emit(mut dstack);\0a              body = body + \22    (local.get \22;\0a              body = body + sp.a.to_str();\0a              body = body + \22)\5cn    (local.get \22;\0a              body = body + sp.l.to_str();\0a              body = body + \22)\5cn    return\5cn\22;\0a              sret_done = true;\0a            }\0a          },\0a          Option.None => {},\0a        }\0a      }\0a      if !sret_done {\0a      if is_tail {\0a        match st.val {\0a          Option.Some(rv) => {\0a            let mut k: usize = 0;\0a            while k < len(rv.args) {\0a              body = body + emit_arg(mut pool, rv.args[k], mut env, mut prog, mut nl);\0a              k = k + 1;\0a            }\0a            // pop into the param slots, last arg first (a pair param\0a            // takes two consecutive sets)\0a            match tfd {\0a              Option.Some(fdef) => {\0a                let mut j: usize = len(fdef.params);\0a                while j > 0 {\0a                  let q: i64 = (j as i64) - 1;\0a                  if j - 1 < len(fdef.pstr) && fdef.pstr[j - 1] {\0a           