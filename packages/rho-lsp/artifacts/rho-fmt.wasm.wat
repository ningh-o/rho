(the generic IDX path parks its index in a real slot \e2\80\94 a nested\0a// base chain would clobber $t before the check runs)\0afn oob_check_idx(mut pool: *Pool, idx_text: string, len_text: string) -> string {\0a  let msg_addr: i64 = pool_intern(mut pool, \22index out of bounds\22);\0a  return \22    (if (i64.ge_u \22 + idx_text + \22 \22 + len_text + \22)\5cn\22 +\0a         \22      (then (call $w_panic (i32.const \22 + msg_addr.to_str() +\0a         \22) (i32.const 19))))\5cn\22;\0a}\0a\0afn write_fd(addr: i64, nbytes: i64, fd: i64) -> string {\0a  let mut out: string = \22    (i32.store (i32.const 64) (i32.const \22 +\0a                    addr.to_str() + \22))\5cn\22 +\0a                    \22    (i32.store (i32.const 68) (i32.const \22 +\0a                    nbytes.to_str() + \22))\5cn\22 +\0a                    \22    (drop (call $fd_write (i32.const \22 + fd.to_str() +\0a                    \22) \22 +\0a                    \22(i32.const 64) (i32.const 1) (i32.const 96)))\5cn\22;\0a  return out;\0a}\0a\0a// the let environment: names to _start local slots, plus a string\0a// table (immutable strings pool; a binding remembers addr and len)\0astruct Env {\0a  names: []string,\0a  slots: []i64,\0a  vwidths: []i64, // per local: 0 lane-wide, else \c2\b18/\c2\b116/\c2\b132 (neg = unsigned)\0a  sptr: []string, // the struct name where the binding holds a *T\0a  senum: []string, // the enum name where the binding holds a value\0a  sval: []string, // the struct name where the binding holds a VALUE\0a  vbases: []i64,  // the value frame's base local slot\0a  n: usize,\0a  snames: []string,\0a  saddrs: []i64,\0a  slens: []i64,\0a  sraws: []string,\0a  skinds: []i64, // 0 folded string, 1 runtime string pair, 2 slice pair\0a  sn: usize,\0a  fkind: []i64,     // per binding: 0 int, 1 f64, 2 f32\0a  selnames: []string, // slice bindings' element texts (a small stack)\0a  selvals: []string,  // the element's type text\0a  sel_n: usize,       // the slice-element stack depth\0a  // the enclosing fn context (an expression-position match emits\0a  // statement-bearing arm bodies through it)\0a  infn: bool,\0a  retslot: i64,\0a  loops: *Loops,\0a  dstack: *DStack,\0a  tfd: ?*FnDef,\0a}\0a\0afn env_bool_bind(mut e: *Env, name: string) {\0a  e.snames[e.sn] = name + \22#b\22;\0a  e.saddrs[e.sn] = 0 - 1000; // bool marker\0a  e.slens[e.sn] = 0;\0a  e.sraws[e.sn] = \22\22;\0a  e.skinds[e.sn] = 0 - 1;\0a  e.sn = e.sn + 1;\0a}\0a\0afn env_bool_is(e: *Env, name: string) -> bool {\0a  let want: string = name + \22#b\22;\0a  let mut i: usize = 0;\0a  while i < e.sn {\0a    if e.snames[i] == want {\0a      return true;\0a    }\0a    i = i + 1;\0a  }\0a  return false;\0a}\0a\0afn env_new(cap: usize) -> *Env {\0a  return new Env { names: make([]string, cap), slots: make([]i64, cap),\0a                   vwidths: make([]i64, cap),\0a                   sptr: make([]string, cap),\0a                   senum: make([]string, cap),\0a                   sval: make([]string, cap),\0a                   vbases: make([]i64, cap),\0a                   n: 0, snames: make([]string, cap),\0a                   saddrs: make([]i64, cap), slens: make([]i64, cap),\0a                   sraws: make([]string, cap),\0a                   skinds: make([]i64, cap), sn: 0,\0a                   fkind: make([]i64, cap),\0a                   selnames: make([]string, 512),\0a                   selvals: make([]string, 512),\0a                   sel_n: 0,\0a                   infn: false, retslot: 0 - 1,\0a                   loops: loops_new(), dstack: dstack_new(),\0a                   tfd: Option.None };\0a}\0a\0afn env_str_look(e: *Env, name: string) -> i64 {\0a  let mut i: usize = e.sn;\0a  while i > 0 {\0a    if e.snames[i - 1] == name {\0a      return e.saddrs[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return 0 - 1;\0a}\0a\0a// a runtime pair binding (a string or a slice): addr/len ride a\0a// LOCAL PAIR (slots are negative markers: the pair starts at\0a// -1 - addr); kind tells strings from slices at index time\0afn env_str_bind_runtime(mut e: *Env, name: string, addr_slot: i64,\0a                        len_slot: i64, kind: i64) {\0a  e.snames[e.sn] = name;\0a  e.saddrs[e.sn] = (0 - addr_slot) - 1; // negative: runtime pair\0a  e.slens[e.sn] = len_slot;\0a  e.sraws[e.sn] = \22\22;\0a  e.skinds[e.sn] = kind;\0a  e.sn = e.sn + 1;\0a}\0a\0afn env_str_is_runtime(e: *Env, name: string) -> bool {\0a  let mut i: usize = e.sn;\0a  while i > 0 {\0a    if e.snames[i - 1] == name {\0a      return e.saddrs[i - 1] < 0; // negative marker = runtime pair\0a    }\0a    i = i - 1;\0a  }\0a  return false; // not a string at all\0a}\0a\0a// push a string expression's {addr, len} pair onto the i64 stack:\0a// folded literals become constants; runtime vars local.get the pair\0afn push_string(mut pool: *Pool, e: *Expr, mut env: *Env, mut prog: *Prog,\0a                mut nl: *NextLocal) -> string {\0a  // a string ELEMENT: the pair loads at the slice's 16-byte stride\0a  // (bounds-checked like every element read)\0a  if e.tag == parse.EX_IDX {\0a    let spx = build_string_pair(e, mut pool, mut env, mut prog, mut nl);\0a    if spx.ok {\0a      return spx.text + \22    (local.get \22 + spx.a.to_str() +\0a             \22)\5cn    (local.get \22 + spx.l.to_str() + \22)\5cn\22;\0a    }\0a    return \22    (i64.const 0)\5cn    (i64.const 0)\5cn\22;\0a  }\0a  // a string FIELD: the pair rides the value frame or the heap\0a  if e.tag == parse.EX_FIELD {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    let bt: string = field_base_type(base, env, mut prog);\0a    if len(bt) > 0 {\0a      let si: i64 = st_index(mut prog, st_name_of(bt));\0a      let fi: i64 = st_field_index(prog, si, e.name);\0a      if fi >= 0 &&\0a          (type_kind(prog.structs[si as usize].types[fi as usize]) == 1 ||\0a           type_kind(prog.structs[si as usize].types[fi as usize]) == 2) {\0a        let off: i64 = st_field_off(mut prog, si, fi) * 8;\0a        if base.tag == parse.EX_VAR && len(env_val_of(env, base.name)) > 0 {\0a          let b0: i64 = env_val_base(env, base.name);\0a          return \22    (local.get \22 + (b0 + off / 8).to_str() + \22)\5cn\22 +\0a                 \22    (local.get \22 + (b0 + off / 8 + 1).to_str() + \22)\5cn\22;\0a        }\0a        let t0: i64 = nl.v;\0a        nl.v = nl.v + 1;\0a        let mut out: string = emit_expr(mut pool, base, mut env, mut prog, mut nl);\0a        out = out + \22    (local.set \22;\0a        out = out + t0.to_str();\0a        out = out + \22)\5cn\22;\0a        out = out + \22    (i64.load (i32.add (i32.wrap_i64 (local.get \22;\0a        out = out + t0.to_str();\0a        out = out + \22)) (i32.const \22;\0a        out = out + off.to_str();\0a        out = out + \22)))\5cn\22;\0a        out = out + \22    (i64.load (i32.add (i32.wrap_i64 (local.get \22;\0a        out = out + t0.to_str();\0a        out = out + \22)) (i32.const \22;\0a        out = out + (off + 8).to_str();\0a        out = out + \22)))\5cn\22;\0a        return out;\0a      }\0a    }\0a    return \22    (i64.const 0)\5cn    (i64.const 0)\5cn\22;\0a  }\0a  // a string-returning call: the call rides, its parked pair pushes\0a  // (the stringiness of f(...) == \22string\22 comparisons died without\0a  // this \e2\80\94 the pair degraded to a const-0 stub, always false)\0a  if e.tag == parse.EX_CALL {\0a    let spc = build_string_pair(e, mut pool, mut env, mut prog, mut nl);\0a    if spc.ok {\0a      return spc.text + \22    (local.get \22 + spc.a.to_str() + \22)\5cn\22 +\0a             \22    (local.get \22 + spc.l.to_str() + \22)\5cn\22;\0a    }\0a  }\0a  match fold_string(e, env) {\0a    Option.Some(raw) => {\0a      let saddr: i64 = pool_intern(mut pool, raw);\0a      return \22    (i64.const \22 + saddr.to_str() + \22)\5cn\22 +\0a             \22    (i64.const \22 + pool_len(pool, raw).to_str() + \22)\5cn\22;\0a    },\0a    Option.None => {\0a      if e.tag == parse.EX_VAR && str_static_is(prog, e.name) {\0a        // a string static reads its global pair\0a        return \22    (global.get $g_\22 + e.name + \22)\5cn\22 +\0a               \22    (global.get $g_\22 + e.name + \22_l)\5cn\22;\0a      }\0a      let mut a: i64 = env_str_look(env, e.name);\0a      if a < 0 {\0a        let lslot: i64 = env_str_len_slot(env, e.name);\0a        return \22    (local.get \22 + ((0 - a) - 1).to_str() + \22)\5cn\22 +\0a               \22    (local.get \22 + lslot.to_str() + \22)\5cn\22;\0a      }\0a      return \22    (i64.const 0)\5cn    (i64.const 0)\5cn\22;\0a    },\0a  }\0a}\0a\0a// a fresh make: count in $t, zeroed alloc sized by the element width\0a// (string and dyn elements ride 16-byte pairs, a struct its slot\0a// block), the shared None box fills a ?T element; the value is the\0a// {addr,count} pair. Hosted here so BOTH call sites share it \e2\80\94 the\0a// bare node used to fall through emit_expr into the BIN template and\0a// render as a lone (i64.add) \e2\80\94 make's op is 0, the add opcode\0afn emit_make(mut pool: *Pool, e: *Expr, mut env: *Env, mut prog: *Prog,\0a             mut nl: *NextLocal) -> string {\0a  let mut cnt0: *Expr = parse.lit(0);\0a  if len(e.args) > 0 {\0a    cnt0 = e.args[0];\0a  }\0a  let optelem: bool = len(e.name) >= 1 &&\0a      (e.name[0] == 63 || e.name[0] == 79);\0a  let stelem: i64 = st_index(mut prog, e.name);\0a  let mut esz: i64 = 1;\0a  if stelem >= 0 {\0a    esz = st_nslots(mut prog, stelem);\0a  } else {\0a    if e.name == \22string\22 || is_dyn_type(e.name) {\0a      esz = 2;\0a    }\0a  }\0a  let aslot: i64 = nl.v;\0a  nl.v = nl.v + 1;\0a  let mut out: string = emit_expr(mut pool, cnt0, mut env, mut prog,\0a                                  mut nl);\0a  out = out + \22    (local.set $t)\5cn\22;\0a  if esz != 1 {\0a    out = out + \22    (i64.extend_i32_u (call $w_alloc \22 +\0a        \22(i32.wrap_i64 (i64.mul (local.get $t) (i64.const \22 +\0a        esz.to_str() + \22)))))\5cn\22;\0a  } else {\0a    out = out + \22    (i64.extend_i32_u (call $w_alloc \22 +\0a        \22(i32.wrap_i64 (local.get $t))))\5cn\22;\0a  }\0a  out = out + \22    (local.set \22 + aslot.to_str() + \22)\5cn\22;\0a  if optelem {\0a    let fi: i64 = nl.v;\0a    nl.v = nl.v + 1;\0a    out = out + \22    (i64.const 0)\5cn\22;\0a    out = out + \22    (local.set \22 + fi.to_str() + \22)\5cn\22;\0a    out = out + \22    (loop $ma\22 + fi.to_str() + \22\5cn\22;\0a    out = out + \22    (if (i64.lt_u (local.get \22 + fi.to_str() +\0a        \22) (local.get $t))\5cn\22;\0a    out = out + \22      (then (i64.store (i32.add (i32.wrap_i64 \22 +\0a        \22(local.get \22 + aslot.to_str() + \22))\5cn\22;\0a    out = out + \22                     (i32.mul (i32.wrap_i64 \22 +\0a        \22(local.get \22 + fi.to_str() + \22)) (i32.const 8)))\5cn\22;\0a    out = out + \22                     (global.get $w_none_box))\5cn\22;\0a    out = out + \22            (local.set \22 + fi.to_str() +\0a        \22 (i64.add (local.get \22 + fi.to_str() + \22) (i64.const 1)))\5cn\22;\0a    out = out + \22            (br $ma\22 + fi.to_str() + \22))))\5cn\22;\0a  }\0a  out = out + \22    (local.get \22 + aslot.to_str() + \22)\5cn\22;\0a  out = out + \22    (local.get $t)\5cn\22;\0a  return out;\0a}\0a\0a// one call argument: a string/slice-valued expression takes the\0a// {addr,len} pair; everything else is the plain i64 expression (an\0a// integer variable or an int + must NOT ride the pair path \e2\80\94 the\0a// old router sent every variable and every + through push_string,\0a// and its not-found fallback spelled a bogus local.get 0 pair)\0afn emit_arg(mut pool: *Pool, e: *Expr, mut env: *Env, mut prog: *Prog,\0a            mut nl: *NextLocal) -> string {\0a  if e.tag == parse.EX_ARR {\0a    return emit_array(mut pool, e, mut env, mut prog, mut nl);\0a  }\0a  if e.tag == parse.EX_MAKE {\0a    return emit_make(mut pool, e, mut env, mut prog, mut nl);\0a  }\0a  if e.tag == parse.EX_VAR && env_kind_of(env, e.name) < 0 &&\0a      env_look(env, e.name) < 0 && !name_is_const(prog, e.name) &&\0a      len(static_global(prog, e.name)) == 0 &&\0a      user_fn_exists(prog, e.name) && e.lit != 0 - 99 {\0a    // a plain fn referenced as a VALUE: a trampoline wraps the box\0a    // param around the call, the value is (idx, null box)\0a    let tfd: *FnDef = fn_def_of(prog, e.name);\0a    let tname: string = \22__tr_\22 + e.name;\0a    let mut already: i64 = 0 - 1;\0a    let mut ti: usize = 0;\0a    while ti < pool.gi.n {\0a      if pool.gi.sufs[ti] == tname {\0a        already = pool.gi.ids[ti];\0a      }\0a      ti = ti + 1;\0a    }\0a    if already < 0 {\0a      let mut tparams: []string = make([]string, 9);\0a      let mut tptypes: []string = make([]string, 9);\0a      tparams[0] = \22__b\22;\0a      tptypes[0] = \22i64\22;\0a      let mut cargs: []*Expr = make([]*Expr, 8);\0a      let mut pk: usize = 0;\0a      while pk < len(tfd.params) && pk < 8 {\0a        tparams[pk + 1] = tfd.params[pk];\0a        if pk < len(tfd.ptypes) {\0a          tptypes[pk + 1] = tfd.ptypes[pk];\0a        } else {\0a          tptypes[pk + 1] = \22\22;\0a        }\0a        cargs[pk] = parse.var(tfd.params[pk]);\0a        pk = pk + 1;\0a      }\0a      let callx = parse.call(e.name, cargs[0..len(tfd.params)]);\0a      let rstmt = parse.ret_stmt(callx);\0a      let mut tbd: []*Stmt = make([]*Stmt, 1);\0a      tbd[0] = rstmt;\0a      let mut tramp = parse.clone_fndef(tfd);\0a      tramp.name = tname;\0a      tramp.params = tparams[0..(len(tfd.params) + 1)];\0a      tramp.ptypes = tptypes[0..(len(tfd.params) + 1)];\0a      tramp.pstr = make([]bool, 0);\0a      tramp.pslc = make([]bool, 0);\0a      tramp.pvar = make([]bool, 0);\0a      tramp.tparams = make([]string, 0);\0a      tramp.body = tbd;\0a      let gi_t: usize = pool.gi.n;\0a      pool.gi.bases[gi_t] = e.name;\0a      pool.gi.keys[gi_t] = \22\22;\0a      pool.gi.sufs[gi_t] = tname;\0a      pool.gi.fds[gi_t] = tramp;\0a      pool.gi.ids[gi_t] = pool.gi.cfn as i64;\0a      pool.gi.n = pool.gi.n + 1;\0a      pool.gi.clo_wasms[pool.gi.cfn] = \22$u_\22 + tname;\0a      pool.gi.cfn = pool.gi.cfn + 1;\0a      let tari: i64 = 1 + (len(tfd.params) as i64);\0a      clo_ty_need(mut pool.gi, tari, 1);\0a      already = pool.gi.cfn as i64 - 1;\0a    }\0a    return \22    (i64.const \22 + already.to_str() + \22)\5cn\22 +\0a           \22    (i64.const 0)\5cn\22;\0a  }\0a  if e.tag == parse.EX_STR {\0a    return push_string(mut pool, e, mut env, mut prog, mut nl);\0a  }\0a  if e.tag == parse.EX_VAR && env_kind_of(env, e.name) >= 0 {\0a    return push_string(mut pool, e, mut env, mut prog, mut nl);\0a  }\0a  // any other string-buildable expression \e2\80\94 a slice view, a runtime\0a  // concat, a string-returning call \e2\80\94 rides its built pair; ints and\0a  // pointers refuse the build cleanly and fall to the scalar lane\0a  let sps = build_string_pair(e, mut pool, mut env, mut prog, mut nl);\0a  if sps.ok {\0a    return sps.text + \22    (local.get \22 + sps.a.to_str() +\0a           \22)\5cn    (local.get \22 + sps.l.to_str() + \22)\5cn\22;\0a  }\0a  if e.tag == parse.EX_BIN && e.op == 0 {\0a    match fold_string(e, env) {\0a      Option.Some(raw) => {\0a        let saddr: i64 = pool_intern(mut pool, raw);\0a        return \22    (i64.const \22 + saddr.to_str() + \22)\5cn\22 +\0a               \22    (i64.const \22 + pool_len(pool, raw).to_str() + \22)\5cn\22;\0a      },\0a      Option.None => {},\0a    }\0a  }\0a  return emit_expr(mut pool, e, mut env, mut prog, mut nl);\0a}\0a\0afn env_str_len_slot(e: *Env, name: string) -> i64 {\0a  let mut i: usize = e.sn;\0a  while i > 0 {\0a    if e.snames[i - 1] == name {\0a      return e.slens[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return 0;\0a}\0a\0afn env_str_len(e: *Env, name: string) -> i64 {\0a  let mut i: usize = e.sn;\0a  while i > 0 {\0a    if e.snames[i - 1] == name {\0a      return e.slens[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return 0;\0a}\0a\0afn env_str_raw(e: *Env, name: string) -> ?string {\0a  let mut i: usize = e.sn;\0a  while i > 0 {\0a    if e.snames[i - 1] == name {\0a      if e.saddrs[i - 1] < 0 {\0a        return Option.None; // runtime pair: no folded text exists\0a      }\0a      return Option.Some(e.sraws[i - 1]);\0a    }\0a    i = i - 1;\0a  }\0a  return Option.None;\0a}\0a\0afn env_str_bind(mut e: *Env, name: string, addr: i64, ln: i64, raw: string) {\0a  e.snames[e.sn] = name;\0a  e.saddrs[e.sn] = addr;\0a  e.slens[e.sn] = ln;\0a  e.sraws[e.sn] = raw;\0a  e.skinds[e.sn] = 0;\0a  e.sn = e.sn + 1;\0a}\0a\0a// the kind of a name's string-table entry, -1 when absent\0afn env_kind_of(e: *Env, name: string) -> i64 {\0a  let mut i: usize = e.sn;\0a  while i > 0 {\0a    if e.snames[i - 1] == name {\0a      return e.skinds[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return 0 - 1;\0a}\0a\0afn env_look(e: *Env, name: string) -> i64 {\0a  let mut i: usize = e.n;\0a  while i > 0 {\0a    if e.names[i - 1] == name {\0a      return e.slots[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return 0 - 1;\0a}\0a\0afn env_bind(mut e: *Env, name: string, slot: i64) {\0a  e.names[e.n] = name;\0a  e.slots[e.n] = slot;\0a  e.vwidths[e.n] = 0;\0a  e.sptr[e.n] = \22\22;\0a  e.senum[e.n] = \22\22;\0a  e.sval[e.n] = \22\22;\0a  e.vbases[e.n] = 0;\0a  e.fkind[e.n] = 0;\0a  e.n = e.n + 1;\0a}\0a\0a// a float binding: kind 1 f64, 2 f32 (f32 rides f64 storage with\0a// demote-after-op rounding \e2\80\94 the exact f32 semantics)\0afn env_bind_f(mut e: *Env, name: string, slot: i64, kind: i64) {\0a  e.names[e.n] = name;\0a  e.slots[e.n] = slot;\0a  e.vwidths[e.n] = 0;\0a  e.sptr[e.n] = \22\22;\0a  e.senum[e.n] = \22\22;\0a  e.sval[e.n] = \22\22;\0a  e.vbases[e.n] = 0;\0a  e.fkind[e.n] = kind;\0a  e.n = e.n + 1;\0a}\0a\0afn env_fkind_of(e: *Env, name: string) -> i64 {\0a  let mut i: usize = e.n;\0a  while i > 0 {\0a    if e.names[i - 1] == name {\0a      return e.fkind[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return 0;\0a}\0a\0a// a value binding: the fields live in a consecutive local frame\0afn env_bind_val(mut e: *Env, name: string, base: i64, sname: string) {\0a  e.names[e.n] = name;\0a  e.slots[e.n] = base;\0a  e.vwidths[e.n] = 0;\0a  e.sptr[e.n] = \22\22;\0a  e.senum[e.n] = \22\22;\0a  e.sval[e.n] = sname;\0a  e.vbases[e.n] = base;\0a    e.fkind[e.n] = 0;\0ae.n = e.n + 1;\0a}\0a\0afn env_bind_w(mut e: *Env, name: string, slot: i64, w: i64) {\0a  e.names[e.n] = name;\0a  e.slots[e.n] = slot;\0a  e.vwidths[e.n] = w;\0a  e.sptr[e.n] = \22\22;\0a  e.senum[e.n] = \22\22;\0a  e.sval[e.n] = \22\22;\0a  e.vbases[e.n] = 0;\0a    e.fkind[e.n] = 0;\0ae.n = e.n + 1;\0a}\0a\0a// a pointer binding: the slot holds a *SName heap address\0afn env_bind_ptr(mut e: *Env, name: string, slot: i64, sname: string) {\0a  e.names[e.n] = name;\0a  e.slots[e.n] = slot;\0a  e.vwidths[e.n] = 0;\0a  e.sptr[e.n] = sname;\0a  e.senum[e.n] = \22\22;\0a  e.sval[e.n] = \22\22;\0a  e.vbases[e.n] = 0;\0a    e.fkind[e.n] = 0;\0ae.n = e.n + 1;\0a}\0a\0a// an enum-value binding: the slot holds the box address\0afn env_bind_enum(mut e: *Env, name: string, slot: i64, ename: string) {\0a  e.names[e.n] = name;\0a  e.slots[e.n] = slot;\0a  e.vwidths[e.n] = 0;\0a  e.sptr[e.n] = \22\22;\0a  e.senum[e.n] = ename;\0a  e.sval[e.n] = \22\22;\0a  e.vbases[e.n] = 0;\0a    e.fkind[e.n] = 0;\0ae.n = e.n + 1;\0a}\0a\0afn env_enum_of(e: *Env, name: string) -> string {\0a  let mut i: usize = e.n;\0a  while i > 0 {\0a    if e.names[i - 1] == name {\0a      return e.senum[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return \22\22;\0a}\0a\0afn env_bind_sliceelem(mut e: *Env, name: string, etext: string) {\0a  // a small stack: later bindings shadow, but a second slice in the\0a  // same scope never clobbers the first's element text (selnames[0]\0a  // alone died the day two slices shared a fn)\0a  let mut i: usize = 0;\0a  while i < e.sel_n {\0a    if e.selnames[i] == name {\0a      e.selvals[i] = etext;\0a      return;\0a    }\0a    i = i + 1;\0a  }\0a  if e.sel_n < len(e.selnames) {\0a    e.selnames[e.sel_n] = name;\0a    e.selvals[e.sel_n] = etext;\0a    e.sel_n = e.sel_n + 1;\0a  }\0a}\0a\0a// the element text's pointer target \e2\80\94 Some/Ok binder type\0afn env_slicept_of(e: *Env, name: string) -> string {\0a  let mut i: usize = e.sel_n;\0a  while i > 0 {\0a    if e.selnames[i - 1] == name {\0a      return type_ptr_target(e.selvals[i - 1]);\0a    }\0a    i = i - 1;\0a  }\0a  return \22\22;\0a}\0a\0afn env_sliceelem_of(e: *Env, name: string, mut prog: *Prog) -> string {\0a  let mut i: usize = e.sel_n;\0a  while i > 0 {\0a    if e.selnames[i - 1] == name {\0a      let t: string = e.selvals[i - 1];\0a      if len(t) >= 1 && (t[0] == 63 || t[0] == 79) {\0a        return \22Option\22;\0a      }\0a      if en_index(mut prog, t) >= 0 {\0a        return t;\0a      }\0a      return \22\22;\0a    }\0a    i = i - 1;\0a  }\0a  return \22\22;\0a}\0a\0a// the element text of a slice binding, \22\22 when unbound\0afn env_slice_elemtext(e: *Env, name: string) -> string {\0a  let mut i: usize = e.sel_n;\0a  while i > 0 {\0a    if e.selnames[i - 1] == name {\0a      return e.selvals[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return \22\22;\0a}\0a\0a// the element text of ANY slice-typed expression \e2\80\94 a binding's own\0a// table, a struct field's declared type (through its owner), a\0a// view's base, a call's declared return; \22\22 when unresolvable\0afn expr_slice_elemtext(e: *Expr, env: *Env, mut prog: *Prog) -> string {\0a  if e.tag == parse.EX_VAR {\0a    return env_slice_elemtext(env, e.name);\0a  }\0a  if e.tag == parse.EX_FIELD {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    let bt: string = field_base_type(base, env, mut prog);\0a    if len(bt) > 0 {\0a      let si: i64 = st_index(mut prog, st_name_of(bt));\0a      let fi: i64 = st_field_index(prog, si, e.name);\0a      if fi >= 0 {\0a        let fty: string =\0a            prog.structs[si as usize].types[fi as usize];\0a        if len(fty) >= 2 && fty[0] == 91 && fty[1] == 93 {\0a          return fty[2..len(fty)];\0a        }\0a      }\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_SLICE2 {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    return expr_slice_elemtext(base, env, mut prog);\0a  }\0a  if e.tag == parse.EX_CALL {\0a    let rt: string = call_fn_rtype(prog, e, env);\0a    if len(rt) >= 2 && rt[0] == 91 && rt[1] == 93 {\0a      return rt[2..len(rt)];\0a    }\0a    return \22\22;\0a  }\0a  return \22\22;\0a}\0a\0afn env_val_of(e: *Env, name: string) -> string {\0a  let mut i: usize = e.n;\0a  while i > 0 {\0a    if e.names[i - 1] == name {\0a      return e.sval[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return \22\22;\0a}\0a\0afn env_val_base(e: *Env, name: string) -> i64 {\0a  let mut i: usize = e.n;\0a  while i > 0 {\0a    if e.names[i - 1] == name {\0a      return e.vbases[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return 0 - 1;\0a}\0a\0afn env_ptr_of(e: *Env, name: string) -> string {\0a  let mut i: usize = e.n;\0a  while i > 0 {\0a    if e.names[i - 1] == name {\0a      return e.sptr[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return \22\22;\0a}\0a\0a// an operand's width: a var by its binding, an as-cast by its target\0a// type, a bare literal by the fixed default i32 (\c2\a73.1) \e2\80\94 and the\0a// width PROPAGATES through arithmetic (one64 << 63 is still i64)\0afn expr_width(e: *Expr, env: *Env, mut prog: *Prog) -> i64 {\0a  if e.tag == parse.EX_VAR {\0a    return env_width_of(env, e.name);\0a  }\0a  if e.tag == parse.EX_BIN && e.op == 11 {\0a    return type_width(e.name);\0a  }\0a  if e.tag == parse.EX_FIELD {\0a    // the field's own written type declares the width\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    let bt: string = expr_ptr_type(base, env, mut prog);\0a    if len(bt) > 0 {\0a      let si: i64 = st_index(mut prog, st_name_of(bt));\0a      let fi: i64 = st_field_index(prog, si, e.name);\0a      if fi >= 0 {\0a        return type_width(prog.structs[si as usize].types[fi as usize]);\0a      }\0a    }\0a    return 0;\0a  }\0a  if e.tag == parse.EX_LIT {\0a    return 32;\0a  }\0a  if e.tag == parse.EX_BIN {\0a    return bin_width(e, env, mut prog);\0a  }\0a  return 0;\0a}\0a\0a// a binary's width: the DECLARING operand wins (vars and casts), a\0a// literal adapts \e2\80\94 so 0 - m8 takes m8's width, not the literal's\0a// default\0afn bin_width(e: *Expr, env: *Env, mut prog: *Prog) -> i64 {\0a  let mut lhs_lit: bool = false;\0a  match e.lhs {\0a    Option.Some(l) => {\0a      lhs_lit = l.tag == parse.EX_LIT;\0a    },\0a    Option.None => {},\0a  }\0a  if !lhs_lit {\0a    match e.lhs {\0a      Option.Some(l) => {\0a        let w: i64 = expr_width(l, env, mut prog);\0a        if w != 0 {\0a          return w;\0a        }\0a      },\0a      Option.None => {},\0a    }\0a  }\0a  match e.rhs {\0a    Option.Some(r) => {\0a      let w: i64 = expr_width(r, env, mut prog);\0a      if w != 0 {\0a        return w;\0a      }\0a    },\0a    Option.None => {},\0a  }\0a  if lhs_lit {\0a    return 32; // both literals: the i32 default\0a  }\0a  return 0;\0a}\0a\0afn env_width_of(e: *Env, name: string) -> i64 {\0a  let mut i: usize = e.n;\0a  while i > 0 {\0a    if e.names[i - 1] == name {\0a      return e.vwidths[i - 1];\0a    }\0a    i = i - 1;\0a  }\0a  return 0;\0a}\0a\0a// the annotation's width code: \c2\b18/\c2\b116/\c2\b132 (negative = unsigned),\0a// 0 = the full lane\0afn type_width(tyname: string) -> i64 {\0a  if tyname == \22i8\22 { return 8; }\0a  if tyname == \22i16\22 { return 16; }\0a  if tyname == \22i32\22 { return 32; }\0a  if tyname == \22i64\22 { return 64; }\0a  if tyname == \22u8\22 { return 0 - 8; }\0a  if tyname == \22u16\22 { return 0 - 16; }\0a  if tyname == \22u32\22 { return 0 - 32; }\0a  if tyname == \22u64\22 { return 0 - 64; }\0a  if tyname == \22usize\22 { return 0 - 32; } // \c2\a73: the address width (wasm32), T3.6's lane\0a  return 0;\0a}\0a\0a// ---- the struct table ----\0a\0a// a field type's slot count: string and slice fields ride pairs; a\0a// by-value struct field inlines the nested struct's own slots (a\0a// depth cap keeps a self-referential declaration from looping \e2\80\94 boot's\0a// checker rejects those, the corpus never carries one)\0afn type_slots_d(mut prog: *Prog, ty: string, depth: i64) -> i64 {\0a  if len(ty) >= 2 && ty[0] == 91 && ty[1] == 93 {\0a    return 2;\0a  }\0a  if ty == \22string\22 {\0a    return 2;\0a  }\0a  if is_dyn_type(ty) {\0a    return 2;\0a  }\0a  if depth < 8 {\0a    let si: i64 = st_index(mut prog, ty);\0a    if si >= 0 {\0a      return st_nslots_d(mut prog, si, depth + 1);\0a    }\0a  }\0a  return 1;\0a}\0a\0afn type_slots(mut prog: *Prog, ty: string) -> i64 {\0a  return type_slots_d(mut prog, ty, 0);\0a}\0a\0a// a field type's kind: 0 scalar, 1 string, 2 slice, 3 pointer\0afn type_kind(ty: string) -> i64 {\0a  if len(ty) >= 2 && ty[0] == 91 && ty[1] == 93 {\0a    return 2;\0a  }\0a  if ty == \22string\22 {\0a    return 1;\0a  }\0a  if len(ty) >= 1 && ty[0] == 42 {\0a    return 3;\0a  }\0a  if len(ty) >= 2 && ty[0] == 63 && ty[1] == 42 {\0a    return 3;\0a  }\0a  return 0;\0a}\0a\0a// the pointer target when a type text is *T or ?*T, \22\22 otherwise\0afn type_ptr_target(ty: string) -> string {\0a  if len(ty) >= 2 && ty[0] == 63 && ty[1] == 42 {\0a    return ty[2..len(ty)];\0a  }\0a  if len(ty) >= 2 && ty[0] == 42 {\0a    return ty[1..len(ty)];\0a  }\0a  return \22\22;\0a}\0a\0a// the struct-table name for a type text: pointer spellings resolve\0a// to their target (field_base_type/expr_ptr_type feed the struct\0a// lookups, and a pointer binding's text spells \22*Name\22 \e2\80\94 a lookup\0a// on the star misses and the field silently vanishes; e.args views\0a// were the witness)\0afn st_name_of(ty: string) -> string {\0a  let t: string = type_ptr_target(ty);\0a  if len(t) > 0 {\0a    return t;\0a  }\0a  return ty;\0a}\0a\0a// weak[T] \e2\80\94 the handle type (rides the pointer lane, never counted)\0afn is_weak_type(ty: string) -> bool {\0a  return len(ty) >= 6 && ty[0] == 119 && ty[1] == 101 &&\0a      ty[2] == 97 && ty[3] == 107 && ty[4] == 91;\0a}\0a\0a// the T inside weak[T] (or a weak:-prefixed binding text), \22\22 else\0afn weak_target(ty: string) -> string {\0a  if is_weak_type(ty) {\0a    return ty[5..(len(ty) - 1)];\0a  }\0a  if len(ty) >= 6 && ty[0] == 119 && ty[1] == 101 && ty[2] == 97 &&\0a      ty[3] == 107 && ty[4] == 58 {\0a    return ty[5..len(ty)];\0a  }\0a  return \22\22;\0a}\0a\0apub fn st_index(mut prog: *Prog, name: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < prog.nstructs {\0a    if prog.structs[i].name == name {\0a      return i as i64;\0a    }\0a    i = i + 1;\0a  }\0a  // Name[a1,a2] \e2\80\94 instantiate the generic declaration under the full\0a  // text (idempotent: the scan above finds it on later calls)\0a  let ob: i64 = open_bracket(name);\0a  if ob >= 0 && name[(len(name) - 1)..len(name)] == \22]\22 {\0a    let mut base: string = name[0..(ob as usize)];\0a    // a receiver spelling carries the pointer star (*Vec[i32]) \e2\80\94 the\0a    // instantiation is of the bare declaration (the star once left\0a    // the clone's field stores nothing to write through)\0a    if len(base) > 0 && base[0] == 42 {\0a      base = base[1..len(base)];\0a    }\0a    let inner: string = name[((ob as usize) + 1)..(len(name) - 1)];\0a    let bi: i64 = st_index(mut prog, base);\0a    if bi >= 0 && len(prog.structs[bi as usize].tparams) > 0 {\0a      let sd = prog.structs[bi as usize];\0a      let mut tys: []string = split_type_args(inner);\0a      let nf: usize = len(sd.types);\0a      let mut ntypes: []string = make([]string, nf);\0a      let mut j: usize = 0;\0a      while j < nf {\0a        ntypes[j] = tsub_type(sd.types[j], sd.tparams, tys);\0a        j = j + 1;\0a      }\0a      let inst = parse.mk_structdef(name, sd.fields, ntypes,\0a                                    make([]string, 0), sd.line);\0a      return parse.reg_struct_inst(mut prog, inst);\0a    }\0a  }\0a  return 0 - 1;\0a}\0a\0afn st_field_index(prog: *Prog, si: i64, fname: string) -> i64 {\0a  if si < 0 {\0a    return 0 - 1;\0a  }\0a  let mut k: usize = 0;\0a  while k < len(prog.structs[si as usize].fields) {\0a    if prog.structs[si as usize].fields[k] == fname {\0a      return k as i64;\0a    }\0a    k = k + 1;\0a  }\0a  return 0 - 1;\0a}\0a\0a// a struct field's float kind by its written type, 0 when not float\0afn st_field_fkind(prog: *Prog, si: i64, fname: string) -> i64 {\0a  let k: i64 = st_field_index(prog, si, fname);\0a  if k >= 0 {\0a    let ft: string = prog.structs[si as usize].types[k as usize];\0a    if ft == \22f64\22 {\0a      return 1;\0a    }\0a    if ft == \22f32\22 {\0a      return 2;\0a    }\0a  }\0a  return 0;\0a}\0a\0a// the slot offset of field k (a pair field takes two, an inlined\0a// struct as many as it owns)\0afn st_field_off(mut prog: *Prog, si: i64, k: i64) -> i64 {\0a  let mut off: i64 = 0;\0a  let mut j: i64 = 0;\0a  while j < k {\0a    off = off + type_slots(mut prog,\0a                           prog.structs[si as usize].types[j as usize]);\0a    j = j + 1;\0a  }\0a  return off;\0a}\0a\0afn st_nslots_d(mut prog: *Prog, si: i64, depth: i64) -> i64 {\0a  let mut off: i64 = 0;\0a  let mut j: usize = 0;\0a  while j < len(prog.structs[si as usize].types) {\0a    off = off + type_slots_d(mut prog,\0a                             prog.structs[si as usize].types[j as usize],\0a                             depth);\0a    j = j + 1;\0a  }\0a  return off;\0a}\0a\0afn st_nslots(mut prog: *Prog, si: i64) -> i64 {\0a  return st_nslots_d(mut prog, si, 0);\0a}\0a\0apub fn en_index(mut prog: *Prog, name: string) -> i64 {\0a  let mut i: usize = 0;\0a  while i < prog.nenums {\0a    if prog.enums[i].name == name {\0a      return i as i64;\0a    }\0a    i = i + 1;\0a  }\0a  // Enum[T1,T2] \e2\80\94 instantiate the generic declaration (payload types\0a  // substitute; the box slots recompute over them)\0a  let ob: i64 = open_bracket(name);\0a  if ob >= 0 && name[(len(name) - 1)..len(name)] == \22]\22 {\0a    let base: string = name[0..(ob as usize)];\0a    let inner: string = name[((ob as usize) + 1)..(len(name) - 1)];\0a    let bi: i64 = en_index(mut prog, base);\0a    if bi >= 0 && len(prog.enums[bi as usize].tparams) > 0 {\0a      let ed = prog.enums[bi as usize];\0a      let mut tys: []string = split_type_args(inner);\0a      let pooln: usize = len(ed.vtpool);\0a      let mut npool: []string = make([]string, pooln);\0a      let mut j: usize = 0;\0a      while j < pooln {\0a        npool[j] = tsub_type(ed.vtpool[j], ed.tparams, tys);\0a        j = j + 1;\0a      }\0a      // recompute each variant's slot count over substituted payloads\0a      let nv: usize = ed.nv;\0a      let mut nslots: []i64 = make([]i64, nv);\0a      let mut v: usize = 0;\0a      while v < nv {\0a        let mut sl: i64 = 0;\0a        let mut p: usize = 0;\0a        while p < (ed.vslots[v] as usize) &&\0a            (v * 8 + p) < pooln {\0a          sl = sl + type_slots(mut prog, npool[v * 8 + p]);\0a          p = p + 1;\0a        }\0a        nslots[v] = sl;\0a        v = v + 1;\0a      }\0a      let inst = parse.mk_enumdef(name, ed.vnames, nslots, npool,\0a                                  ed.vnpool, nv, make([]string, 0));\0a      return parse.reg_enum_inst(mut prog, inst);\0a    }\0a  }\0a  return 0 - 1;\0a}\0a\0afn en_vtag(prog: *Prog, ei: i64, vname: string) -> i64 {\0a  // an unknown enum (ei = -1) reads as tag -1: the arm can never\0a  // match, which degrades honestly \e2\80\94 the bounds check once panicked\0a  // the child's self-compile mid-emission instead\0a  if ei < 0 {\0a    return 0 - 1;\0a  }\0a  let mut k: usize = 0;\0a  while k < prog.enums[ei as usize].nv {\0a    if prog.enums[ei as usize].vnames[k] == vname {\0a      return k as i64;\0a    }\0a    k = k + 1;\0a  }\0a  return 0 - 1;\0a}\0a\0a// a variant's declared payload types, empty for the builtins and\0a// unknown variants\0afn enum_variant_ptys(mut prog: *Prog, ename: string,\0a                     vname: string) -> []string {\0a  let ei: i64 = en_index(mut prog, ename);\0a  if ei < 0 {\0a    return make([]string, 0);\0a  }\0a  let vi: i64 = en_vtag(prog, ei, vname);\0a  if vi < 0 {\0a    return make([]string, 0);\0a  }\0a  let vb: usize = (vi as usize) * 8;\0a  let mut vend: usize = vb;\0a  while vend < len(prog.enums[ei as usize].vtpool) &&\0a      vend < vb + 8 {\0a    if len(prog.enums[ei as usize].vtpool[vend]) == 0 {\0a      break;\0a    }\0a    vend = vend + 1;\0a  }\0a  return prog.enums[ei as usize].vtpool[vb..vend];\0a}\0a\0a// an enum box: [tag][payload slots...] sized by the widest variant \e2\80\94\0a// a string payload rides a pair, two slots\0afn en_nslots(mut prog: *Prog, ei: i64) -> i64 {\0a  if ei < 0 {\0a    return 0;\0a  }\0a  let mut mx: i64 = 0;\0a  let mut k: usize = 0;\0a  while k < prog.enums[ei as usize].nv {\0a    let ptys: []string = enum_variant_ptys(mut prog,\0a        prog.enums[ei as usize].name,\0a        prog.enums[ei as usize].vnames[k]);\0a    let mut ns: i64 = 0;\0a    let mut j: usize = 0;\0a    while j < len(ptys) {\0a      if ptys[j] == \22string\22 {\0a        ns = ns + 2;\0a      } else {\0a        ns = ns + 1;\0a      }\0a      j = j + 1;\0a    }\0a    if ns > mx {\0a      mx = ns;\0a    }\0a    k = k + 1;\0a  }\0a  return mx + 1;\0a}\0a\0afn en_vslots(prog: *Prog, ei: i64, vname: string) -> i64 {\0a  if ei < 0 {\0a    return 0;\0a  }\0a  let mut k: usize = 0;\0a  while k < prog.enums[ei as usize].nv {\0a    if prog.enums[ei as usize].vnames[k] == vname {\0a      return prog.enums[ei as usize].vslots[k];\0a    }\0a    k = k + 1;\0a  }\0a  return 0;\0a}\0a\0a// Option[..]/Result[..] collapse to the builtin name \e2\80\94 the EXACT\0a// builtin or its bracketed form; a user enum (Opt[i32]) never\0afn norm_enum(rt: string) -> string {\0a  if rt == \22Option\22 || starts_open(rt, \22Option\22) {\0a    return \22Option\22;\0a  }\0a  if rt == \22Result\22 || starts_open(rt, \22Result\22) {\0a    return \22Result\22;\0a  }\0a  return rt;\0a}\0a\0a// text == prefix, or text = prefix + \22[\22 + args (and nothing between)\0afn starts_open(t: string, prefix: string) -> bool {\0a  if len(t) < len(prefix) + 2 {\0a    return false;\0a  }\0a  let mut i: usize = 0;\0a  while i < len(prefix) {\0a    if t[i] != prefix[i] {\0a      return false;\0a    }\0a    i = i + 1;\0a  }\0a  return t[len(prefix)] == 91 && t[len(t) - 1] == 93;\0a}\0a\0a// the float kind of an expression: 0 int, 1 f64, 2 f32\0a//\0a// the value law: a comparison (op 5..10) is never float-valued \e2\80\94 its\0a// RESULT is bool whatever the operands' width. Consumers that need the\0a// operands' execution width (the float op emission itself) call\0a// expr_exec_fkind; everything classifying a value (let inference,\0a// print holes, casts) sees the bool here (`let t: bool = (0.1 ==\0a// 1.5)` once bound a float lane and printed 0.0 \e2\80\94 the fuzz\0a// differential caught it).\0afn expr_fkind(e: *Expr, env: *Env, mut prog: *Prog) -> i64 {\0a  if e.tag == parse.EX_BIN && e.op >= 5 && e.op <= 10 {\0a    return 0;\0a  }\0a  return expr_exec_fkind(e, env, mut prog);\0a}\0a\0a// the execution width of an expression: the float kind its operands\0a// make the op run at (comparisons included \e2\80\94 a float compare runs the\0a// float path and still yields a bool)\0afn expr_exec_fkind(e: *Expr, env: *Env, mut prog: *Prog) -> i64 {\0a  if e.tag == parse.EX_FLIT {\0a    return 1;\0a  }\0a  if e.tag == parse.EX_VAR {\0a    let k: i64 = env_fkind_of(env, e.name);\0a    if k > 0 {\0a      return k;\0a    }\0a    // consts and statics carry their written type\0a    let mut i: usize = 0;\0a    while i < prog.nconsts {\0a      if prog.consts[i] == e.name {\0a        if prog.ctypes[i] == \22f64\22 {\0a          return 1;\0a        }\0a        if prog.ctypes[i] == \22f32\22 {\0a          return 2;\0a        }\0a        return 0;\0a      }\0a      i = i + 1;\0a    }\0a    return 0;\0a  }\0a  if e.tag == parse.EX_FIELD {\0a    // a struct field's own width decides (Pair.a: f64 \e2\80\a6)\0a    match e.lhs {\0a      Option.Some(b) => {\0a        let bt: string = field_base_type(b, env, mut prog);\0a        if len(bt) > 0 {\0a          let si: i64 = st_index(mut prog, st_name_of(bt));\0a          if si >= 0 {\0a            let fk: i64 = st_field_fkind(prog, si, e.name);\0a            if fk > 0 {\0a              return fk;\0a            }\0a          }\0a        }\0a      },\0a      Option.None => {},\0a    }\0a    return 0;\0a  }\0a  if e.tag == parse.EX_BIN && e.op == 11 {\0a    if e.name == \22f64\22 {\0a      return 1;\0a    }\0a    if e.name == \22f32\22 {\0a      return 2;\0a    }\0a    return 0;\0a  }\0a  if e.tag == parse.EX_BIN {\0a    let mut lf: i64 = 0;\0a    let mut rf: i64 = 0;\0a    match e.lhs {\0a      Option.Some(l7) => {\0a        lf = expr_fkind(l7, env, mut prog);\0a      },\0a      Option.None => {},\0a    }\0a    match e.rhs {\0a      Option.Some(r7) => {\0a        rf = expr_fkind(r7, env, mut prog);\0a      },\0a      Option.None => {},\0a    }\0a    if lf > 0 {\0a      return lf;\0a    }\0a    if rf > 0 {\0a      return rf;\0a    }\0a  }\0a  if e.tag == parse.EX_CALL {\0a    let rt: string = call_fn_rtype(prog, e, env);\0a    if rt == \22f64\22 {\0a      return 1;\0a    }\0a    if rt == \22f32\22 {\0a      return 2;\0a    }\0a  }\0a  if e.tag == parse.EX_MCALL {\0a    // a method result's declared width decides (a.dist2(b) \e2\80\94 the\0a    // field lanes alone once read the 3-4-5 triangle as raw bits)\0a    match e.lhs {\0a      Option.Some(r9) => {\0a        let bt9: string = expr_ptr_type(r9, env, mut prog);\0a        if len(bt9) > 0 {\0a          let rt9: string = method_rtype(mut prog, bt9, e.name);\0a          if rt9 == \22f64\22 {\0a            return 1;\0a          }\0a          if rt9 == \22f32\22 {\0a            return 2;\0a          }\0a        }\0a      },\0a      Option.None => {},\0a    }\0a  }\0a  if e.tag == parse.EX_MATCH {\0a    // a match whose every arm spells the same float width rides it\0a    let mut allf: i64 = 0;\0a    let mut mixed: bool = false;\0a    let mut k8: usize = 0;\0a    while k8 < len(e.marms) {\0a      match e.marms[k8].val {\0a        Option.Some(av8) => {\0a          let af8: i64 = expr_fkind(av8, env, mut prog);\0a          if af8 == 0 {\0a            mixed = true;\0a          } else {\0a            if allf == 0 {\0a              allf = af8;\0a            } else {\0a              if af8 != allf {\0a                mixed = true;\0a              }\0a            }\0a          }\0a        },\0a        Option.None => {\0a          mixed = true;\0a        },\0a      }\0a      k8 = k8 + 1;\0a    }\0a    if !mixed && allf > 0 {\0a      return allf;\0a    }\0a  }\0a  return 0;\0a}\0a\0a// the enum an expression's value belongs to, \22\22 when none\0a// an option-typed scrutinee shares the enum box ABI: the match\0a// dispatch reads the box's tag slot, not the raw pointer. Enums\0a// resolve through expr_enum_type; a ?T-returning call/method does\0a// not (its rtype texts as \22?T\22), so the rtype's own '?' decides.\0a// a method's return type with the receiver's type text: the exact\0a// spelling first, then through a generic instantiation \e2\80\94 the receiver\0a// may spell *StringMap[string] whose methods register under the\0a// qualified template's name (m.remove's ?V once read as a raw\0a// pointer and every Some arm matched None)\0afn method_rtype(mut prog: *Prog, bt: string, mname: string) -> string {\0a  let r1: string = fn_rtype_of(prog, bt + \22.\22 + mname);\0a  if len(r1) > 0 {\0a    return r1;\0a  }\0a  // a dyn receiver: the declared return rides the trait table (the\0a  // dispatch itself resolves there \e2\80\94 a dyn-typed method result once\0a  // read as \22\22 and every f64 hole printed its raw bits)\0a  if is_dyn_type(bt) {\0a    let trt: string = dyn_trait(bt);\0a    let mut t9: usize = 0;\0a    while t9 < prog.ntraits {\0a      if prog.traits[t9].name == trt {\0a        let mut m9: usize = 0;\0a        while m9 < prog.traits[t9].nmethods {\0a          if prog.traits[t9].methods[m9] == mname &&\0a              m9 < len(prog.traits[t9].rtypes) {\0a            return prog.traits[t9].rtypes[m9];\0a          }\0a          m9 = m9 + 1;\0a        }\0a      }\0a      t9 = t9 + 1;\0a    }\0a    return \22\22;\0a  }\0a  let mut rt: string = bt;\0a  if len(rt) > 0 && rt[0] == 42 {\0a    rt = rt[1..len(rt)];\0a  }\0a  let ob: i64 = open_bracket(rt);\0a  if ob < 0 {\0a    return \22\22;\0a  }\0a  let base: string = rt[0..(ob as usize)];\0a  let si: i64 = st_index(mut prog, base);\0a  if si < 0 {\0a    return \22\22;\0a  }\0a  let gtps: []string = prog.structs[si as usize].tparams;\0a  if len(gtps) == 0 {\0a    return \22\22;\0a  }\0a  let mfull: string = base + \22.\22 + mname;\0a  let mut hit: i64 = 0 - 1;\0a  let mut fi3: usize = 0;\0a  while fi3 < len(prog.fns) {\0a    let nm3: string = prog.fns[fi3].name;\0a    let nl3: i64 = len(nm3) as i64;\0a    let ml3: i64 = len(mfull) as i64;\0a    if nm3 == mfull {\0a      // bare registration (the concrete per-value-type overloads in\0a      // std/collections ride their bare dotted names) \e2\80\94 without this\0a      // arm the scan only saw module-qualified spellings and every\0a      // ?V these methods returned went unseen\0a      hit = fi3 as i64;\0a    } else {\0a      if nl3 > ml3 {\0a        if nm3[((nl3 - ml3 - 1) as usize)..(nl3 as usize)] == \22.\22 + mfull {\0a          hit = fi3 as i64;\0a        }\0a      }\0a    }\0a    fi3 = fi3 + 1;\0a  }\0a  if hit < 0 {\0a    return \22\22;\0a  }\0a  let tys: []string = split_type_args(\0a      rt[((ob as usize) + 1)..(len(rt) - 1)]);\0a  return tsub_type(prog.fns[hit as usize].rtype, gtps, tys);\0a}\0a\0afn scrutinee_boxes(sc: *Expr, env: *Env, mut prog: *Prog) -> bool {\0a  if len(expr_enum_type(sc, env, mut prog)) > 0 {\0a    return true;\0a  }\0a  if sc.tag == parse.EX_CALL {\0a    let rt: string = fn_rtype_of(prog, sc.name);\0a    if len(rt) >= 1 && rt[0] == 63 {\0a      return true;\0a    }\0a  }\0a  if sc.tag == parse.EX_MCALL {\0a    let mut recv: *Expr = parse.lit(0);\0a    match sc.lhs {\0a      Option.Some(r) => {\0a        recv = r;\0a      },\0a      Option.None => {},\0a    }\0a    let bt: string = expr_ptr_type(recv, env, mut prog);\0a    if len(bt) > 0 {\0a      let rt2: string = method_rtype(mut prog, bt, sc.name);\0a      if len(rt2) >= 1 && rt2[0] == 63 {\0a        return true;\0a      }\0a    }\0a  }\0a  return false;\0a}\0a\0afn expr_enum_type(e: *Expr, env: *Env, mut prog: *Prog) -> string {\0a  if e.tag == parse.EX_VAR {\0a    return env_enum_of(env, e.name);\0a  }\0a  if e.tag == parse.EX_MCALL {\0a    let mut recv: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(r) => {\0a        recv = r;\0a      },\0a      Option.None => {},\0a    }\0a    if recv.tag == parse.EX_VAR && en_index(mut prog, recv.name) >= 0 {\0a      return recv.name;\0a    }\0a    if recv.tag == parse.EX_VAR && recv.name == \22Option\22 {\0a      return \22Option\22;\0a    }\0a    // w.get() \e2\80\94 the absence probe yields an Option box\0a    if recv.tag == parse.EX_VAR && e.name == \22get\22 &&\0a        len(weak_target(env_ptr_of(env, recv.name))) > 0 {\0a      return \22Option\22;\0a    }\0a    let bt: string = expr_ptr_type(recv, env, mut prog);\0a    if len(bt) > 0 {\0a      // the declared return resolves through the instantiation (the\0a      // method_rtype law) \e2\80\94 the star-blind dotted lookup once hid\0a      // every ?V a clone method returned, and a let bound from it\0a      // fell to the scalar lane (its match then matched nothing)\0a      let rt: string = norm_enum(method_rtype(mut prog, bt, e.name));\0a      if len(rt) > 0 && (en_index(mut prog, rt) >= 0 || rt == \22Option\22 ||\0a          rt == \22Result\22) {\0a        return rt;\0a      }\0a      if len(rt) > 1 && rt[0] == 63 {\0a        // ?T is Option sugar (type-system \c2\a79) \e2\80\94 the option-box face\0a        return \22Option\22;\0a      }\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_CALL {\0a    let rt: string = norm_enum(fn_rtype_of(prog, e.name));\0a    if len(rt) > 0 && (en_index(mut prog, rt) >= 0 || rt == \22Option\22 ||\0a        rt == \22Result\22) {\0a      return rt;\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_IDX {\0a    // an enum-element slice's indexing yields the element's enum \e2\80\94\0a    // through a binding or a struct-field slice (one field step)\0a    let mut b5: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(x5) => {\0a        b5 = x5;\0a      },\0a      Option.None => {},\0a    }\0a    if b5.tag == parse.EX_VAR {\0a      return env_sliceelem_of(env, b5.name, mut prog);\0a    }\0a    if b5.tag == parse.EX_FIELD {\0a      let mut ow5: *Expr = parse.lit(0);\0a      match b5.lhs {\0a        Option.Some(o5) => {\0a          ow5 = o5;\0a        },\0a        Option.None => {},\0a      }\0a      let bt5: string = field_base_type(ow5, env, mut prog);\0a      if len(bt5) > 0 {\0a        let si5: i64 = st_index(mut prog, st_name_of(bt5));\0a        let fi5: i64 = st_field_index(prog, si5, b5.name);\0a        if fi5 >= 0 {\0a          let fty5: string =\0a              prog.structs[si5 as usize].types[fi5 as usize];\0a          if len(fty5) >= 4 && fty5[0] == 91 && fty5[1] == 93 &&\0a              (fty5[2] == 63 || fty5[2] == 79) {\0a            return \22Option\22;\0a          }\0a          if en_index(mut prog, fty5[2..len(fty5)]) >= 0 {\0a            return fty5[2..len(fty5)];\0a          }\0a        }\0a      }\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_FIELD {\0a    let mut b0: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(x) => {\0a        b0 = x;\0a      },\0a      Option.None => {},\0a    }\0a    if b0.tag == parse.EX_VAR &&\0a        (en_index(mut prog, b0.name) >= 0 || b0.name == \22Option\22) {\0a      return b0.name;\0a    }\0a    // a struct field's declared type names the enum the scrutinee\0a    // rides: a ?T field is an Option box (the tag test used to read\0a    // the box POINTER \e2\80\94 a fresh Some compared against 1 failed and\0a    // the match fell through every arm), a named field its enum\0a    let bt0: string = field_base_type(b0, env, mut prog);\0a    if len(bt0) > 0 {\0a      let si0: i64 = st_index(mut prog, st_name_of(bt0));\0a      let fi0: i64 = st_field_index(prog, si0, e.name);\0a      if fi0 >= 0 {\0a        let fty0: string =\0a            prog.structs[si0 as usize].types[fi0 as usize];\0a        if len(fty0) >= 1 && fty0[0] == 63 {\0a          return \22Option\22;\0a        }\0a        if en_index(mut prog, fty0) >= 0 || fty0 == \22Option\22 ||\0a            fty0 == \22Result\22 {\0a          return fty0;\0a        }\0a      }\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_MATCH {\0a    return \22\22;\0a  }\0a  return \22\22;\0a}\0a\0afn fn_rtype_of(prog: *Prog, name: string) -> string {\0a  let mut i: usize = 0;\0a  while i < len(prog.fns) {\0a    if prog.fns[i].name == name {\0a      return prog.fns[i].rtype;\0a    }\0a    i = i + 1;\0a  }\0a  return \22\22;\0a}\0a\0a// the struct owning a field access: a pointer receiver by its\0a// target, a value receiver by its frame\0afn field_base_type(e: *Expr, env: *Env, mut prog: *Prog) -> string {\0a  if e.tag == parse.EX_VAR {\0a    let vt: string = env_val_of(env, e.name);\0a    if len(vt) > 0 {\0a      return vt;\0a    }\0a    let pt: string = env_ptr_of(env, e.name);\0a    return pt;\0a  }\0a  return expr_ptr_type(e, env, mut prog);\0a}\0a\0a// a by-value struct expression's own struct name, \22\22 when the\0a// expression is not struct-typed\0afn struct_type_of(e: *Expr, env: *Env, mut prog: *Prog) -> string {\0a  if e.tag == parse.EX_VAR {\0a    return env_val_of(env, e.name);\0a  }\0a  if e.tag == parse.EX_DEREF {\0a    let mut inner: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(x) => {\0a        inner = x;\0a      },\0a      Option.None => {},\0a    }\0a    let it: string = expr_ptr_type(inner, env, mut prog);\0a    if st_index(mut prog, st_name_of(it)) >= 0 {\0a      return it;\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_NEW {\0a    return e.name;\0a  }\0a  if e.tag == parse.EX_FIELD {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    let bt: string = field_base_type(base, env, mut prog);\0a    if len(bt) > 0 {\0a      let si: i64 = st_index(mut prog, st_name_of(bt));\0a      let fi: i64 = st_field_index(prog, si, e.name);\0a      if fi >= 0 {\0a        let fty: string = prog.structs[si as usize].types[fi as usize];\0a        if st_index(mut prog, fty) >= 0 {\0a          return fty;\0a        }\0a      }\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_IDX {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    if base.tag == parse.EX_VAR {\0a      let et: string = env_slice_elemtext(env, base.name);\0a      if st_index(mut prog, et) >= 0 {\0a        return et;\0a      }\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_CALL {\0a    let rt: string = call_fn_rtype(prog, e, env);\0a    if st_index(mut prog, rt) >= 0 {\0a      return rt;\0a    }\0a  }\0a  return \22\22;\0a}\0a\0a// a struct-typed expression's frame base when the whole chain is\0a// frame-resident (a value binding root, struct-typed fields within);\0a// -1 when the value lives behind an address\0afn val_chain_slot(e: *Expr, env: *Env, mut prog: *Prog) -> i64 {\0a  if e.tag == parse.EX_VAR {\0a    if len(env_val_of(env, e.name)) > 0 {\0a      return env_val_base(env, e.name);\0a    }\0a    return 0 - 1;\0a  }\0a  if e.tag == parse.EX_FIELD {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    let root: i64 = val_chain_slot(base, env, mut prog);\0a    if root < 0 {\0a      return 0 - 1;\0a    }\0a    let bt: string = field_base_type(base, env, mut prog);\0a    if len(bt) == 0 {\0a      return 0 - 1;\0a    }\0a    let si: i64 = st_index(mut prog, st_name_of(bt));\0a    let fi: i64 = st_field_index(prog, si, e.name);\0a    if fi < 0 {\0a      return 0 - 1;\0a    }\0a    // only a by-value struct field continues the frame chain; a\0a    // pointer field holds an address \e2\80\94 the chain leaves the frame\0a    // and the generic path loads through it\0a    let fty: string = prog.structs[si as usize].types[fi as usize];\0a    if st_index(mut prog, fty) < 0 {\0a      return 0 - 1;\0a    }\0a    return root + st_field_off(mut prog, si, fi);\0a  }\0a  if e.tag == parse.EX_IDX {\0a    // a slice's elements live in the slice's own storage \e2\80\94 behind\0a    // its address, never in the frame\0a    return 0 - 1;\0a  }\0a  return 0 - 1;\0a}\0a\0a// a by-value struct expression evaluates to an address: heap\0a// expressions already are one; a frame-resident chain copies into a\0a// fresh zeroed box first (a wasm local frame has no address to borrow)\0afn struct_addr_of(mut pool: *Pool, e: *Expr, mut env: *Env, mut prog: *Prog,\0a                  mut nl: *NextLocal) -> string {\0a  let sname: string = struct_type_of(e, env, mut prog);\0a  if len(sname) == 0 {\0a    return emit_expr(mut pool, e, mut env, mut prog, mut nl);\0a  }\0a  let si: i64 = st_index(mut prog, sname);\0a  let vn: i64 = st_nslots(mut prog, si);\0a  let fb: i64 = val_chain_slot(e, env, mut prog);\0a  if fb >= 0 {\0a    let mut b: i64 = nl.v;\0a    nl.v = nl.v + 1;\0a    let mut out: string = \22    (i64.extend_i32_u (call $w_alloc (i32.const \22 +\0a           vn.to_str() + \22)))\5cn\22 +\0a           \22    (local.set \22 + b.to_str() + \22)\5cn\22;\0a    let mut j: i64 = 0;\0a    while j < vn {\0a      out = out + \22    (i64.store (i32.add (i32.wrap_i64 (local.get \22;\0a      out = out + b.to_str();\0a      out = out + \22)) (i32.const \22;\0a      out = out + (j * 8).to_str();\0a      out = out + \22)) (local.get \22;\0a      out = out + (fb + j).to_str();\0a      out = out + \22))\5cn\22;\0a      j = j + 1;\0a    }\0a    return out + \22    (local.get \22 + b.to_str() + \22)\5cn\22;\0a  }\0a  return emit_expr(mut pool, e, mut env, mut prog, mut nl);\0a}\0a\0a// the struct a pointer-valued expression references, \22\22 when none:\0a// vars by their binding, new by its name, calls and methods by the\0a// written return type, fields by the field's own type\0afn expr_ptr_type(e: *Expr, env: *Env, mut prog: *Prog) -> string {\0a  if e.tag == parse.EX_VAR {\0a    return env_ptr_of(env, e.name);\0a  }\0a  if e.tag == parse.EX_NEW {\0a    return e.name;\0a  }\0a  if e.tag == parse.EX_IDX {\0a    // a struct-element slice's indexing: the element's struct \e2\80\94 a\0a    // pointer element's target when the elements are pointers\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b12) => {\0a        base = b12;\0a      },\0a      Option.None => {},\0a    }\0a    if base.tag == parse.EX_VAR {\0a      let mut et: string = env_slice_elemtext(env, base.name);\0a      if len(et) >= 1 && et[0] == 42 {\0a        et = type_ptr_target(et);\0a      }\0a      if st_index(mut prog, et) >= 0 {\0a        return et;\0a      }\0a      // a dyn-typed element: its methods resolve through the trait\0a      // table (method_rtype's dyn arm) \e2\80\94 a struct-only law once left\0a      // every dyn method result untyped and the f64 holes raw\0a      if is_dyn_type(et) {\0a        return et;\0a      }\0a    }\0a    // an indexed field (p.tbl[i]): the element text rides the\0a    // owner's declared field type \e2\80\94 a pointer element's target is\0a    // the struct the read yields, a value-struct element is itself\0a    // (the var-base branch's law; the let over p.enums[i] used to\0a    // miss the pointer bind and every field read off it died)\0a    let et9: string = expr_slice_elemtext(base, env, mut prog);\0a    if len(et9) >= 1 && et9[0] == 42 {\0a      let tt9: string = type_ptr_target(et9);\0a      if st_index(mut prog, tt9) >= 0 {\0a        return tt9;\0a      }\0a    }\0a    if st_index(mut prog, et9) >= 0 {\0a      return et9;\0a    }\0a    if is_dyn_type(et9) {\0a      return et9;\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_CALL {\0a    // the CALL's own type: a generic's return rides its\0a    // instantiation's bind (the declared *Pair[T,T] never substitutes)\0a    return type_ptr_target(call_fn_rtype(prog, e, env));\0a  }\0a  if e.tag == parse.EX_MCALL {\0a    let mut recv: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(r) => {\0a        recv = r;\0a      },\0a      Option.None => {},\0a    }\0a    if recv.tag == parse.EX_VAR && st_index(mut prog, recv.name) >= 0 {\0a      return type_ptr_target(fn_rtype_of(prog, recv.name + \22.\22 + e.name));\0a    }\0a    // an enum-typed receiver: the method's return substitutes the\0a    // enum's own type parameters from the receiver's instantiation\0a    let et15: string = expr_enum_type(recv, env, mut prog);\0a    if len(et15) > 0 {\0a      let eb: i64 = open_bracket(et15);\0a      if eb >= 0 {\0a        let ei15: i64 = en_index(mut prog, et15[0..(eb as usize)]);\0a        if ei15 >= 0 &&\0a            len(prog.enums[ei15 as usize].tparams) > 0 {\0a          let rt15: string = fn_rtype_of(prog,\0a              et15[0..(eb as usize)] + \22.\22 + e.name);\0a          let tys15: []string = split_type_args(\0a              et15[((eb as usize) + 1)..(len(et15) - 1)]);\0a          return type_ptr_target(tsub_type(rt15,\0a              prog.enums[ei15 as usize].tparams, tys15));\0a        }\0a      }\0a      return type_ptr_target(fn_rtype_of(prog,\0a          type_base(et15) + \22.\22 + e.name));\0a    }\0a    let bt: string = expr_ptr_type(recv, env, mut prog);\0a    if len(bt) > 0 {\0a      // the method's return substitutes through the receiver's\0a      // instantiation (a bare fn_rtype_of lookup returns the raw\0a      // template text \e2\80\94 Vec.get's `T` \e2\80\94 and every field read off the\0a      // call collapsed to constant 0; method_rtype is the wave-2\0a      // resolver that binds T from the receiver's bracket args)\0a      return type_ptr_target(method_rtype(mut prog, bt, e.name));\0a    }\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_Q {\0a    // e? unwraps \e2\80\94 the payload's type is the raw value\0a    return \22\22;\0a  }\0a  if e.tag == parse.EX_FIELD {\0a    let mut base: *Expr = parse.lit(0);\0a    match e.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    let bt: string = field_base_type(base, env, mut prog);\0a    if len(bt) > 0 {\0a      let si: i64 = st_index(mut prog, st_name_of(bt));\0a      let fi: i64 = st_field_index(prog, si, e.name);\0a      if fi >= 0 {\0a        let fty: string = prog.structs[si as usize].types[fi as usize];\0a        // a by-value struct field continues the chain under its own\0a        // name; everything else resolves through its pointer target\0a        if st_index(mut prog, fty) >= 0 {\0a          return fty;\0a        }\0a        return type_ptr_target(fty);\0a      }\0a    }\0a    return \22\22;\0a  }\0a  return \22\22;\0a}\0a\0a// ---- the rc law's release thunks (one per managed type) ----\0a// Every box carries its rc in the slot before the payload pointer.\0a// A release decrements; at zero the type's thunk walks the owned\0a// payloads (struct fields, enum payloads by tag, slice elements).\0a// Weaks never count; strings and scalars release nothing (their\0a// deaths are unobservable in the corpus's lifetime probes).\0a\0a// the release callee for a written type, \22\22 when nothing is counted\0afn rel_callee(mut pool: *Pool, mut prog: *Prog, ty: string) -> string {\0a  if len(ty) == 0 || is_weak_type(ty) || ty == \22string\22 {\0a    return \22\22;\0a  }\0a  if len(weak_target(ty)) > 0 {\0a    return \22\22;\0a  }\0a  // *S \e2\80\94 the struct-box thunk\0a  if len(ty) >= 1 && ty[0] == 42 {\0a    let s: string = ty[1..len(ty)];\0a    if st_index(mut prog, s) >= 0 {\0a      return rel_struct_thunk(mut pool, mut prog, s);\0a    }\0a    return \22\22;\0a  }\0a  // ?X \e2\80\94 the option-box thunk walking the payload\0a  if len(ty) >= 1 && ty[0] == 63 {\0a    return rel_opt_thunk(mut pool, mut prog, ty[1..len(ty)]);\0a  }\0a  if ty == \22Option\22 || ty == \22Result\22 {\0a    // a binding's option without a recorded payload: the box counts,\0a    // nothing inside walks (the payload text rides the binding)\0a    return rel_opt_thunk(mut pool, mut prog, \22\22);\0a  }\0a  // []T \e2\80\94 the slice thunk over managed elements\0a  if len(ty) >= 2 && ty[0] == 91 && ty[1] == 93 {\0a    return rel_slice_thunk(mut pool, mut prog, ty[2..len(ty)]);\0a  }\0a  // a user enum value \e2\80\94 the enum thunk\0a  if en_index(mut prog, ty) >= 0 {\0a    return rel_enum_thunk(mut pool, mut prog, ty);\0a  }\0a  return \22\22;\0a}\0a\0afn rel_register(mut pool: *Pool, name: string, text: string) -> string {\0a  let mut i: usize = 0;\0a  while i < pool.rel_n {\0a    if pool.rel_names[i] == name {\0a      return name;\0a    }\0a    i = i + 1;\0a  }\0a  if pool.rel_n >= len(pool.rel_names) {\0a    return name; // registry full: the release degrades to none\0a  }\0a  pool.rel_names[pool.rel_n] = name;\0a  pool.rel_texts[pool.rel_n] = text;\0a  pool.rel_n = pool.rel_n + 1;\0a  return name;\0a}\0a\0a// the rc-decrement preamble every thunk shares; the walk lands inside\0a// the (then) \e2\80\94 walk_text may be empty. Statics (data literals below\0a// the heap floor) are immortal: a release of a folded-literal\0a// binding must never rc-decrement into the preceding pool bytes. The\0a// line is $w_base \e2\80\94 the INITIAL floor: $w_floor is the allocator's\0a// grow stop-line and rises at every grow, which would immortalize\0a// every block below the new end (one n13 churn node died that way)\0afn rel_body(p: string, walk_text: string) -> string {\0a  let mut out: string = \22\22;\0a  out = out + \22  (func \22;\0a  out = out + p;\0a  out = out + \22 (param $p i64)\5cn\22;\0a  out = out + \22    (local $c i64)\5cn\22;\0a  out = out + \22    (if (i64.ge_u (local.get $p)\5cn\22;\0a  out = out + \22          (i64.extend_i32_u (global.get $w_base)))\5cn\22;\0a  out = out + \22      (then\5cn\22;\0a  out = out + \22        (if (i64.ne (local.get $p) (i64.const 0))\5cn\22;\0a  out = out + \22          (then\5cn\22;\0a  out = out + \22            (local.set $c (i64.sub (i64.load (i32.sub \22;\0a  out = out + \22(i32.wrap_i64 (local.get $p)) (i32.const 8))) (i64.const 1)))\5cn\22;\0a  out = out + \22            (i64.store (i32.sub (i32.wrap_i64 (local.get $p))\22;\0a  out = out + \22 (i32.const 8)) (local.get $c))\5cn\22;\0a  out = out + \22            (if (i64.eq (local.get $c) (i64.const 0))\5cn\22;\0a  out = out + \22              (then\5cn\22;\0a  out = out + walk_text;\0a  out = out + \22              )\5cn\22;\0a  out = out + \22            )\5cn\22;\0a  out = out + \22          )\5cn\22;\0a  out = out + \22        )\5cn\22;\0a  out = out + \22      )\5cn\22;\0a  out = out + \22    )\5cn\22;\0a  out = out + \22  )\5cn\22;\0a  return out;\0a}\0a\0a// the field-walk text of a struct's managed fields (the death walk:\0a// each owned field releases through its own thunk)\0afn rel_field_walk(mut pool: *Pool, mut prog: *Prog, si: i64) -> string {\0a  let mut walk: string = \22\22;\0a  let nf: usize = len(prog.structs[si as usize].types);\0a  let mut j: usize = 0;\0a  while j < nf {\0a    let fty: string = prog.structs[si as usize].types[j as usize];\0a    let off: i64 = st_field_off(mut prog, si, j as i64) * 8;\0a    if is_dyn_type(fty) {\0a      // a dyn field releases its obj through the field's own vtable\0a      // slot (nmethods = the release thunk's index)\0a      let dtr: string = dyn_trait(fty);\0a      let dnm: i64 = trait_method_count(prog, dtr);\0a      walk = walk + \22            (i64.load (i32.add (i32.wrap_i64 \22;\0a      walk = walk + \22(local.get $p)) (i32.const \22;\0a      walk = walk + (off + 8).to_str();\0a      walk = walk + \22)))\5cn\22;\0a      walk = walk + \22            (i64.load (i32.add (i32.wrap_i64 \22;\0a      walk = walk + \22(i64.load (i32.add (i32.wrap_i64 (local.get $p)) \22;\0a      walk = walk + \22(i32.const \22;\0a      walk = walk + off.to_str();\0a      walk = walk + \22)))) (i32.const \22;\0a      walk = walk + (dnm * 8).to_str();\0a      walk = walk + \22)))\5cn\22;\0a      walk = walk + \22            (i32.wrap_i64)\5cn\22;\0a      walk = walk + \22            call_indirect (type $clv1)\5cn\22;\0a      j = j + 1;\0a      continue;\0a    }\0a    let fc: string = rel_callee(mut pool, mut prog, fty);\0a    if len(fc) > 0 {\0a      walk = walk + \22            (i64.load (i32.add (i32.wrap_i64 \22;\0a      walk = walk + \22(local.get $p)) (i32.const \22;\0a      walk = walk + off.to_str();\0a      walk = walk + \22)))\5cn\22;\0a      if len(fty) >= 2 && fty[0] == 91 && fty[1] == 93 {\0a        // a slice field: the walker takes the pair (addr, len)\0a        walk = walk + \22            (i64.load (i32.add (i32.wrap_i64 \22 +\0a               \22(local.get $p)) (i32.const \22 + (off + 8).to_str() +\0a               \22)))\5cn\22;\0a      }\0a      walk = walk + \22            call \22;\0a      walk = walk + fc;\0a      walk = walk + \22\5cn\22;\0a    }\0a    j = j + 1;\0a  }\0a  return walk;\0a}\0a\0afn rel_struct_thunk(mut pool: *Pool, mut prog: *Prog, sname: string) -> string {\0a  let nm: string = \22$w_rel_\22 + sym_name(mangle_type(sname));\0a  // register first (empty) so recursive types stop here, then fill\0a  let si: i64 = st_index(mut prog, sname);\0a  if si < 0 {\0a    return \22\22;\0a  }\0a  let mut i: usize = 0;\0a  let mut known: bool = false;\0a  while i < pool.rel_n {\0a    if pool.rel_names[i] == nm {\0a      known = true;\0a    }\0a    i = i + 1;\0a  }\0a  if known {\0a    return nm;\0a  }\0a  rel_register(mut pool, nm, \22\22);\0a  let walk: string = rel_field_walk(mut pool, mut prog, si);\0a  // overwrite the placeholder with the real body\0a  let mut k: usize = 0;\0a  while k < pool.rel_n {\0a    if pool.rel_names[k] == nm {\0a      pool.rel_texts[k] = rel_body(nm, walk);\0a    }\0a    k = k + 1;\0a  }\0a  return nm;\0a}\0a\0a// an option/result box: at tag 1 (Some/Ok) the payload releases\0afn rel_opt_thunk(mut pool: *Pool, mut prog: *Prog, payload: string) -> string {\0a  let nm: string = \22$w_relopt_\22 + sym_name(mangle_type(payload));\0a  let mut i: usize = 0;\0a  while i < pool.rel_n {\0a    if pool.rel_names[i] == nm {\0a      return nm;\0a    }\0a    i = i + 1;\0a  }\0a  let pc: string = rel_callee(mut pool, mut prog, payload);\0a  let mut walk: string = \22\22;\0a  if len(pc) > 0 {\0a    walk = \22            (if (i64.eq (i64.load (i32.wrap_i64 \22 +\0a           \22(local.get $p))) (i64.const 1))\5cn\22 +\0a           \22              (then\5cn\22 +\0a           \22                (i64.load (i32.add (i32.wrap_i64 \22 +\0a           \22(local.get $p)) (i32.const 8)))\5cn\22 +\0a           \22                call \22 + pc + \22\5cn\22 +\0a           \22              )\5cn\22 +\0a           \22            )\5cn\22;\0a  }\0a  rel_register(mut pool, nm, rel_body(nm, walk));\0a  return nm;\0a}\0a\0a// a user enum box: the variant's payload slots walk by tag\0afn rel_enum_thunk(mut pool: *Pool, mut prog: *Prog, ename: string) -> string {\0a  let nm: string = \22$w_relenum_\22 + sym_name(mangle_type(ename));\0a  let mut i: usize = 0;\0a  while i < pool.rel_n {\0a    if pool.rel_names[i] == nm {\0a      return nm;\0a    }\0a    i = i + 1;\0a  }\0a  let ei: i64 = en_index(mut prog, ename);\0a  if ei < 0 {\0a    return \22\22;\0a  }\0a  let mut walk: string = \22\22;\0a  let nv: usize = prog.enums[ei as usize].nv;\0a  let mut v: usize = 0;\0a  while v < nv {\0a    let nsl: i64 = prog.enums[ei as usize].vslots[v];\0a    let mut p: usize = 0;\0a    let mut slot: i64 = 1;\0a    while p < (nsl as usize) &&\0a        (v * 8 + p) < len(prog.enums[ei as usize].vtpool) {\0a      let pty: string =\0a          prog.enums[ei as usize].vtpool[v * 8 + p];\0a      let pc2: string = rel_callee(mut pool, mut prog, pty);\0a      if len(pc2) > 0 {\0a        walk = walk + \22            (if (i64.eq (i64.load (i32.wrap_i64 \22;\0a        walk = walk + \22(local.get $p))) (i64.const \22;\0a        walk = walk + (v as i64).to_str();\0a        walk = walk + \22))\5cn\22;\0a        walk = walk + \22              (then\5cn\22;\0a        walk = walk + \22                (i64.load (i32.add (i32.wrap_i64 \22;\0a        walk = walk + \22(local.get $p)) (i32.const \22;\0a        walk = walk + (slot * 8).to_str();\0a        walk = walk + \22)))\5cn\22;\0a        walk = walk + \22                call \22;\0a        walk = walk + pc2;\0a        walk = walk + \22\5cn\22;\0a        walk = walk + \22              )\5cn\22;\0a        walk = walk + \22            )\5cn\22;\0a      }\0a      slot = slot + type_slots(mut prog, pty);\0a      p = p + 1;\0a    }\0a    v = v + 1;\0a  }\0a  rel_register(mut pool, nm, rel_body(nm, walk));\0a  return nm;\0a}\0a\0a// a slice: each element releases (the elements' storage, not the\0a// slice's own box \e2\80\94 the pair rides two params)\0afn rel_slice_thunk(mut pool: *Pool, mut prog: *Prog, elem: string) -> string {\0a  let nm: string = \22$w_relsl_\22 + sym_name(mangle_type(elem));\0a  let ec: string = rel_callee(mut pool, mut prog, elem);\0a  if len(ec) == 0 {\0a    return \22\22;\0a  }\0a  let mut i: usize = 0;\0a  while i < pool.rel_n {\0a    if pool.rel_names[i] == nm {\0a      return nm;\0a    }\0a    i = i + 1;\0a  }\0a  let mut esz: i64 = 1;\0a  if elem == \22string\22 {\0a    esz = 2;\0a  } else {\0a    let ei2: i64 = st_index(mut prog, elem);\0a    if ei2 >= 0 {\0a      esz = st_nslots(mut prog, ei2);\0a    }\0a  }\0a  let mut out: string = \22\22;\0a  out = out + \22  (func \22;\0a  out = out + nm;\0a  out = out + \22 (param $a i64) (param $l i64)\5cn\22;\0a  out = out + \22    (local $i i64)\5cn\22;\0a  out = out + \22    (loop $w\5cn\22;\0a  out = out + \22      (if (i64.lt_u (local.get $i) (local.get $l))\5cn\22;\0a  out = out + \22        (then\5cn\22;\0a  out = out + \22          (i64.load (i32.add (i32.wrap_i64 (local.get $a))\22;\0a  out = out + \22 (i32.mul (i32.wrap_i64 (local.get $i)) (i32.const \22;\0a  out = out + (esz * 8).to_str();\0a  out = out + \22))))\5cn\22;\0a  out = out + \22          call \22;\0a  out = out + ec;\0a  out = out + \22\5cn\22;\0a  out = out + \22          (local.set $i (i64.add (local.get $i) \22;\0a  out = out + \22(i64.const 1)))\5cn\22;\0a  out = out + \22          (br $w)\5cn\22;\0a  out = out + \22        )\5cn\22;\0a  out = out + \22      )\5cn\22;\0a  out = out + \22    )\5cn\22;\0a  out = out + \22  )\5cn\22;\0a  rel_register(mut pool, nm, out);\0a  return nm;\0a}\0a\0a// a fresh expression transfers ownership (no retain): new, enum\0a// constructors, make, slice literals, calls (returns move), format,\0a// get()'s box, weak.from's identity\0afn expr_is_fresh(e: *Expr) -> bool {\0a  if e.tag == parse.EX_NEW || e.tag == parse.EX_MAKE ||\0a      e.tag == parse.EX_ARR || e.tag == parse.EX_CALL {\0a    return true;\0a  }\0a  if e.tag == parse.EX_MCALL {\0a    return true;\0a  }\0a  if e.tag == parse.EX_FIELD {\0a    // Enum.Var without parens \e2\80\94 the unit-variant constructor\0a    return true;\0a  }\0a  return false;\0a}\0a\0a// retain a slot's value when the init was not fresh\0a// the escape law's immortal face: a string literal's address is\0a// rodata \e2\80\94 strictly below \5c$w_base, where \5c$w_retain's guard never\0a// bumps (and strings take no scope-exit release). The retain call for\0a// such an init is a proven no-op; emitting it is pure waste.\0afn retain_is_dead(e: *Expr) -> bool {\0a  if e.tag == parse.EX_STR {\0a    return true;\0a  }\0a  return expr_is_fresh(e);\0a}\0a\0afn retain_if_shared(e: *Expr, slot: i64) -> string {\0a  if retain_is_dead(e) {\0a    return \22\22;\0a  }\0a  return \22    (local.get \22 + slot.to_str() + \22)\5cn\22 +\0a         \22    call $w_retain\5cn\22;\0a}\0a\0a// retain the named $t temp when the init was not fresh\0afn retain_t(e: *Expr) -> string {\0a  if retain_is_dead(e) {\0a    return \22\22;\0a  }\0a  return \22    (local.get $t)\5cn\22 +\0a         \22    call $w_retain\5cn\22;\0a}\0a\0a// a binding's managed type text (what its scope-exit releases), \22\22\0a// when nothing is counted: pointers by target, enums by name (the\0a// option payload rides the slice-elem table), slices by element\0afn managed_type_of_binding(env: *Env, name: string) -> string {\0a  let pt: string = env_ptr_of(env, name);\0a  if len(pt) > 0 {\0a    if len(weak_target(pt)) > 0 {\0a      return \22\22;\0a    }\0a    return \22*\22 + pt;\0a  }\0a  let en: string = env_enum_of(env, name);\0a  if len(en) > 0 {\0a    if en == \22Option\22 || en == \22Result\22 {\0a      let pay: string = env_slice_elemtext(env, name);\0a      if len(pay) > 0 {\0a        return \22?\22 + pay;\0a      }\0a      return en;\0a    }\0a    return en;\0a  }\0a  if env_kind_of(env, name) == 2 {\0a    let et: string = env_slice_elemtext(env, name);\0a    if len(et) > 0 {\0a      return \22[]\22 + et;\0a    }\0a  }\0a  return \22\22;\0a}\0a\0a// the dyn hole's dispatch text and parked pair (a dyn value's\0a// to_str rides its vtable slot at the trait's declared ordinal)\0astatic mut DYN_TEXT: string = \22\22;\0astatic mut DYN_A: i64 = 0;\0astatic mut DYN_L: i64 = 0;\0a\0a// a struct field's or slice element's dyn pair loads into fresh\0a// (vtable, obj) slots; \22\22 text when the location is not one. The\0a// struct base rides $r; the element read is bounds-checked\0afn dyn_pair_load(arg: *Expr, mut pool: *Pool, mut env: *Env, mut prog: *Prog,\0a                 mut nl: *NextLocal) -> string {\0a  let vbox: i64 = nl.v;\0a  let obj: i64 = nl.v + 1;\0a  nl.v = nl.v + 2;\0a  if arg.tag == parse.EX_FIELD {\0a    let mut base: *Expr = parse.lit(0);\0a    match arg.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    let bt: string = field_base_type(base, env, mut prog);\0a    if len(bt) > 0 {\0a      let si: i64 = st_index(mut prog, st_name_of(bt));\0a      let fi: i64 = st_field_index(prog, si, arg.name);\0a      if fi >= 0 &&\0a          is_dyn_type(prog.structs[si as usize].types[fi as usize]) {\0a        let off: i64 = st_field_off(mut prog, si, fi) * 8;\0a        let mut out: string = emit_expr(mut pool, base, mut env, mut prog, mut nl) +\0a               \22    (local.set $r)\5cn\22 +\0a               \22    (i64.load (i32.add (i32.wrap_i64 (local.get $r))\22 +\0a               \22 (i32.const \22 + off.to_str() + \22)))\5cn\22 +\0a               \22    (local.set \22 + vbox.to_str() + \22)\5cn\22 +\0a               \22    (i64.load (i32.add (i32.wrap_i64 (local.get $r))\22 +\0a               \22 (i32.const \22 + (off + 8).to_str() + \22)))\5cn\22 +\0a               \22    (local.set \22 + obj.to_str() + \22)\5cn\22;\0a        return out;\0a      }\0a    }\0a    return \22\22;\0a  }\0a  if arg.tag == parse.EX_IDX {\0a    let mut base: *Expr = parse.lit(0);\0a    match arg.lhs {\0a      Option.Some(b) => {\0a        base = b;\0a      },\0a      Option.None => {},\0a    }\0a    if base.tag == parse.EX_VAR && env_kind_of(env, base.name) == 2 &&\0a        is_dy